                        (uint64_t)worker->trace_current.compact_window_claim_group_run_near64,
                        (uint64_t)worker->trace_current.compact_window_claim_group_run_near512,
                        (uint64_t)worker->trace_current.compact_window_claim_group_run_max_consecutive,
                        (uint64_t)worker->trace_current.compact_window_claim_group_run_stealable,
                        (uint64_t)worker->trace_current.compact_window_claim_group_run_max_stealable,
                        (uint64_t)worker->trace_current.compact_window_claim_group_run_unreserved_near64,
                        (uint64_t)worker->trace_current.compact_window_delayed_output_skips,
                        (uint64_t)worker->trace_current.compact_window_delayed_output_replays,
                        (uint64_t)worker->trace_current.compact_window_delayed_output_deps,
                        (uint64_t)worker->trace_current.compact_window_delayed_output_entries,
                        (uint64_t)worker->trace_current.compact_window_delayed_output_scan_entries,
                        (uint64_t)worker->trace_current.compact_window_delayed_output_seek_skips,
                        (uint64_t)worker->trace_current.compact_window_delayed_group_replay_surfaces,
                        (uint64_t)worker->trace_current.compact_window_delayed_group_replay_states,
                        (uint64_t)worker->trace_current.compact_window_delayed_group_replay_deps,
                        (uint64_t)worker->trace_current.compact_window_delayed_group_replay_unique_deps,
                        (uint64_t)worker->trace_current.compact_window_delayed_group_replay_duplicate_deps,
                        (uint64_t)worker->trace_current.compact_window_delayed_group_replay_scan_entries,
                        (uint64_t)worker->trace_current.compact_window_delayed_group_replay_group_scan_entries,
                        (uint64_t)worker->trace_current.compact_window_claim_group_output_surfaces,
                        (uint64_t)worker->trace_current.compact_window_claim_group_output_states,
                        (uint64_t)worker->trace_current.compact_window_claim_group_output_deps,
                        (uint64_t)worker->trace_current.compact_window_claim_group_output_unique_deps,
                        (uint64_t)worker->trace_current.compact_window_claim_group_output_duplicate_deps,
                        (uint64_t)worker->trace_current.compact_window_claim_group_output_scan_entries,
                        (uint64_t)worker->trace_current.compact_window_claim_group_output_group_scan_entries,
                        (uint64_t)worker->trace_current.compact_window_probes,
                        (uint64_t)worker->trace_current.compact_window_batches,
                        (uint64_t)worker->trace_current.compact_window_stream_u_entries,
                        (uint64_t)worker->trace_current.compact_window_targets,
                        (uint64_t)worker->trace_current.compact_window_target_u_entries,
                        (uint64_t)worker->trace_current.compact_window_state_rows,
                        (uint64_t)worker->trace_current.compact_window_unique_state_rows,
                        (uint64_t)worker->trace_current.compact_window_union_batches,
                        (uint64_t)worker->trace_current.compact_window_union_targets,
                        (uint64_t)worker->trace_current.compact_window_union_cols,
                        (uint64_t)worker->trace_current.compact_window_union_values,
                        (uint64_t)worker->trace_current.compact_window_union_skips,
                        (uint64_t)worker->trace_current.compact_window_union_skip_targets,
                        (uint64_t)worker->trace_current.compact_window_union_skip_cols,
                        (uint64_t)worker->trace_current.compact_window_union_skip_values,
                        (uint64_t)worker->trace_current.compact_window_union_skip_sparse_values,
                        (uint64_t)worker->trace_current.compact_window_group_steps,
                        (uint64_t)worker->trace_current.compact_window_group_targets,
                        (uint64_t)worker->trace_current.compact_window_group_cols,
                        (uint64_t)worker->trace_current.compact_window_group_values,
                        (uint64_t)worker->trace_current.compact_window_group_merges,
                        (uint64_t)worker->trace_current.compact_window_group_merge_targets,
                        (uint64_t)worker->trace_current.compact_window_group_merge_cols,
                        (uint64_t)worker->trace_current.compact_window_group_merge_values,
                        (uint64_t)worker->trace_current.owner_surface_probes,
                        (uint64_t)worker->trace_current.owner_surface_probe_u_entries,
                        (uint64_t)worker->trace_current.owner_surface_scanned_rows,
                        (uint64_t)worker->trace_current.owner_surface_targets,
                        (uint64_t)worker->trace_current.owner_surface_target_u_entries,
                        (uint64_t)worker->trace_current.owner_surface_scanned_input_entries,
                        (uint64_t)worker->trace_current.owner_surface_target_input_entries,
                        (uint64_t)worker->trace_current.owner_surface_max_targets,
                        (uint64_t)worker->trace_current.owner_surface_max_target_input_entries,
                        (uint64_t)worker->trace_current.producer_probe_workers,
                        (uint64_t)worker->trace_current.producer_probe_lookahead,
                        (uint64_t)worker->trace_current.producer_probe_ready_roots,
                        (uint64_t)worker->trace_current.producer_probe_underfilled,
                        (uint64_t)worker->trace_current.producer_probe_underfilled_targets,
                        (uint64_t)worker->trace_current.producer_probe_low_saved_stream,
                        (uint64_t)worker->trace_current.producer_reject_bad_state,
                        (uint64_t)worker->trace_current.producer_reject_epoch,
                        (uint64_t)worker->trace_current.producer_reject_claimed,
                        (uint64_t)worker->trace_current.producer_reject_dep_absent,
                        (uint64_t)worker->trace_current.producer_reject_not_root,
                        (uint64_t)worker->trace_current.producer_reject_not_ready,
                        (uint64_t)worker->trace_current.producer_reject_supernode,
                        (uint64_t)worker->trace_current.producer_reject_cached_panel,
                        (uint64_t)worker->trace_current.panel_update_groups,
                        (uint64_t)worker->trace_current.panel_update_rows,
                        (uint64_t)worker->trace_current.panel_update_entries,
                        (uint64_t)worker->l_entries.count,
                        (uint64_t)worker->u_entries.count,
                        (uint64_t)state.pattern_count,
                        (uint64_t)state.dep_heap_size,
                        pivoted, (uint64_t)selected_col);
              }
              if (shared->trace_enabled) {
                kls_row_first_pipeline_collect_worker_storage_trace(worker);
                kls_row_first_pipeline_trace_add(
                  &shared->trace_committed, &worker->trace_current);
                memset(&worker->trace_current, 0,
                       sizeof(worker->trace_current));
                if (((shared->completed_pos - shared->begin) %
                       KLS_ROW_FIRST_PIPELINE_TRACE_INTERVAL) == 0u ||
                    shared->completed_pos == shared->end) {
                  kls_row_first_pipeline_trace_print(shared, "progress");
                }
              }
            }
          }
        }
        pthread_cond_broadcast(&shared->cond);
      }
      const int failed = shared->failed;
      worker->active_state = NULL;
      worker->active_order_epoch = 0u;
      pthread_mutex_unlock(&shared->lock);
      kls_row_first_partial_row_clear(&state, &worker->workspace);
      if (failed) {
        stop_worker = 1;
        break;
      }
    }
    if (stop_worker) {
      break;
    }
  }
  return NULL;
}

static int kls_row_first_run_parallel_pipeline_phase(
  const kls_row_first_block_context *ctx,
  const UF_long *row_order,
  const UF_long *active_rank,
  UF_long begin,
  UF_long end,
  UF_long supernode_valid_begin,
  int thread_count,
  kls_row_first_workspace *workspace,
  kls_row_first_entries *l_entries,
  kls_row_first_entries *u_entries,
  double *udiag_values,
  unsigned char *row_done,
  kls_row_first_row_stats *stats,
  UF_long *pipeline_rows_out,
  UF_long *thread_rows_out,
  UF_long *partial_rows_out,
  UF_long *wait_partial_rows_out,
  UF_long *wait_partial_deps_out,
  UF_long *supernode_update_groups_out,
  UF_long *supernode_update_rows_out,
  UF_long *supernode_panel_update_groups_out,
  UF_long *supernode_panel_update_rows_out,
  UF_long *completed_pos_out,
  int *pivot_tail_ready_out,
  UF_long *pivot_tail_rows_out,
  UF_long *pivot_restarts_out) {
  if (completed_pos_out != NULL) {
    *completed_pos_out = begin;
  }
  if (pivot_tail_ready_out != NULL) {
    *pivot_tail_ready_out = 0;
  }
  if (pivot_tail_rows_out != NULL) {
    *pivot_tail_rows_out = 0;
  }
  if (pivot_restarts_out != NULL) {
    *pivot_restarts_out = 0;
  }
  if (supernode_panel_update_groups_out != NULL) {
    *supernode_panel_update_groups_out = 0;
  }
  if (supernode_panel_update_rows_out != NULL) {
    *supernode_panel_update_rows_out = 0;
  }
  if (ctx == NULL || row_order == NULL || begin >= end ||
      thread_count <= 1 || workspace == NULL || l_entries == NULL ||
      u_entries == NULL || udiag_values == NULL || row_done == NULL) {
    return 0;
  }
  const UF_long pipeline_rows = end - begin;
  int worker_count = thread_count;
  if ((UF_long)worker_count > pipeline_rows) {
    worker_count = (int)pipeline_rows;
  }
  if (worker_count <= 0) {
    return 0;
  }

  pthread_t *threads =
    (pthread_t *)calloc((size_t)worker_count, sizeof(*threads));
  kls_row_first_pipeline_worker *workers =
    (kls_row_first_pipeline_worker *)
      calloc((size_t)worker_count, sizeof(*workers));
  const UF_long requested_lookahead =
    kls_row_pipeline_lookahead_slots_env();
  const int pivot_lookahead_requested =
    kls_row_pipeline_pivot_lookahead_env_enabled();
  UF_long requested_pivot_lookahead =
    kls_row_pipeline_pivot_lookahead_slots_env();
  if (pivot_lookahead_requested && requested_pivot_lookahead == 0u) {
    requested_pivot_lookahead = (UF_long)worker_count;
  }
  UF_long effective_lookahead = requested_lookahead;
  if (effective_lookahead < requested_pivot_lookahead) {
    effective_lookahead = requested_pivot_lookahead;
  }
  int lookahead_count = (int)effective_lookahead;
  if ((UF_long)lookahead_count > pipeline_rows) {
    lookahead_count = (int)pipeline_rows;
  }
  const int compact_window_execute_requested =
    kls_row_pipeline_compact_window_exec_env_enabled();
  const int compact_window_delay_output_requested =
    compact_window_execute_requested &&
    kls_row_pipeline_compact_delay_output_env_enabled();
  UF_long requested_compact_window =
    kls_row_pipeline_compact_window_slots_env();
  if (requested_compact_window > pipeline_rows) {
    requested_compact_window = pipeline_rows;
  }
  int compact_window_count = (int)requested_compact_window;
  kls_row_first_pipeline_worker *lookahead_states =
    lookahead_count > 0
      ? (kls_row_first_pipeline_worker *)
          calloc((size_t)lookahead_count, sizeof(*lookahead_states))
      : NULL;
  kls_row_first_compact_window_state *compact_window_states =
    compact_window_count > 0
      ? (kls_row_first_compact_window_state *)
          calloc((size_t)compact_window_count,
                 sizeof(*compact_window_states))
      : NULL;
  kls_row_first_compact_batch_target *compact_batch_targets =
    compact_window_count > 0
      ? (kls_row_first_compact_batch_target *)
          calloc((size_t)compact_window_count,
                 sizeof(*compact_batch_targets))
      : NULL;
  unsigned char *compact_replay_state_touched =
    compact_window_count > 0
      ? (unsigned char *)calloc((size_t)compact_window_count,
                                sizeof(*compact_replay_state_touched))
      : NULL;
  UF_long *compact_union_pos =
    compact_window_count > 0 &&
        ctx->nk <= (UF_long)(SIZE_MAX / sizeof(*compact_union_pos))
      ? (UF_long *)malloc((size_t)ctx->nk * sizeof(*compact_union_pos))
      : NULL;
  unsigned int *compact_union_mark =
    compact_window_count > 0 &&
        ctx->nk <= (UF_long)(SIZE_MAX / sizeof(*compact_union_mark))
      ? (unsigned int *)calloc((size_t)ctx->nk,
                               sizeof(*compact_union_mark))
      : NULL;
  int *compact_group_slots =
    compact_window_count > 0 && compact_window_execute_requested
      ? (int *)malloc((size_t)compact_window_count *
                      sizeof(*compact_group_slots))
      : NULL;
  UF_long *compact_group_pos =
    compact_window_count > 0 && compact_window_execute_requested &&
        ctx->nk <= (UF_long)(SIZE_MAX / sizeof(*compact_group_pos))
      ? (UF_long *)malloc((size_t)ctx->nk * sizeof(*compact_group_pos))
      : NULL;
  unsigned int *compact_group_mark =
    compact_window_count > 0 && compact_window_execute_requested &&
        ctx->nk <= (UF_long)(SIZE_MAX / sizeof(*compact_group_mark))
      ? (unsigned int *)calloc((size_t)ctx->nk,
                               sizeof(*compact_group_mark))
      : NULL;
  int *compact_root_heads =
    compact_window_count > 0 && compact_window_execute_requested &&
        ctx->nk <= (UF_long)(SIZE_MAX / sizeof(int))
      ? (int *)malloc((size_t)ctx->nk * sizeof(*compact_root_heads))
      : NULL;
  int *compact_pos_slots =
    compact_window_count > 0 &&
        ctx->nk <= (UF_long)(SIZE_MAX / sizeof(*compact_pos_slots))
      ? (int *)malloc((size_t)ctx->nk * sizeof(*compact_pos_slots))
      : NULL;
  const int batch_target_capacity = worker_count + lookahead_count;
  kls_row_first_pipeline_batch_target *batch_targets =
    (kls_row_first_pipeline_batch_target *)
      calloc((size_t)batch_target_capacity, sizeof(*batch_targets));
  kls_row_first_entries private_u_entries;
  memset(&private_u_entries, 0, sizeof(private_u_entries));
  UF_long *private_u_row_ptr =
    (UF_long *)malloc((size_t)ctx->nk * sizeof(*private_u_row_ptr));
  UF_long *private_u_row_end =
    (UF_long *)malloc((size_t)ctx->nk * sizeof(*private_u_row_end));
  UF_long *supernode_start =
    (UF_long *)malloc((size_t)ctx->nk * sizeof(*supernode_start));
  UF_long *supernode_end =
    (UF_long *)malloc((size_t)ctx->nk * sizeof(*supernode_end));
  if (threads == NULL || workers == NULL || batch_targets == NULL ||
      (lookahead_count > 0 && lookahead_states == NULL) ||
      (compact_window_count > 0 && compact_window_states == NULL) ||
      (compact_window_count > 0 && compact_batch_targets == NULL) ||
      (compact_window_count > 0 && compact_replay_state_touched == NULL) ||
      (compact_window_count > 0 && compact_window_execute_requested &&
       compact_group_slots == NULL) ||
      (compact_window_count > 0 && compact_window_execute_requested &&
       compact_group_pos == NULL) ||
      (compact_window_count > 0 && compact_window_execute_requested &&
       compact_group_mark == NULL) ||
      (compact_window_count > 0 && compact_window_execute_requested &&
       compact_root_heads == NULL) ||
      (compact_window_count > 0 && compact_pos_slots == NULL)) {
    free(threads);
    free(workers);
    free(lookahead_states);
    free(compact_window_states);
    free(compact_batch_targets);
    free(compact_replay_state_touched);
    free(compact_union_pos);
    free(compact_union_mark);
    free(compact_group_slots);
    free(compact_group_pos);
    free(compact_group_mark);
    free(compact_root_heads);
    free(compact_pos_slots);
    free(batch_targets);
    free(private_u_row_ptr);
    free(private_u_row_end);
    free(supernode_start);
    free(supernode_end);
    return 0;
  }
  if (private_u_row_ptr == NULL || private_u_row_end == NULL ||
      supernode_start == NULL || supernode_end == NULL ||
      !kls_row_first_append_entries(&private_u_entries, u_entries)) {
    free(threads);
    free(workers);
    free(lookahead_states);
    free(compact_window_states);
    free(compact_batch_targets);
    free(compact_replay_state_touched);
    free(compact_union_pos);
    free(compact_union_mark);
    free(compact_group_slots);
    free(compact_group_pos);
    free(compact_group_mark);
    free(compact_root_heads);
    free(compact_pos_slots);
    free(batch_targets);
    kls_row_first_entries_free(&private_u_entries);
    free(private_u_row_ptr);
    free(private_u_row_end);
    free(supernode_start);
    free(supernode_end);
    return 0;
  }
  memcpy(private_u_row_ptr, workspace->u_row_ptr,
         (size_t)ctx->nk * sizeof(*private_u_row_ptr));
  memcpy(private_u_row_end, workspace->u_row_end,
         (size_t)ctx->nk * sizeof(*private_u_row_end));
  kls_row_first_supernode_panel_cache private_supernode_panel_cache;
  memset(&private_supernode_panel_cache, 0,
         sizeof(private_supernode_panel_cache));
  if (active_rank != NULL) {
    kls_row_first_supernodes_reset(
      &private_u_entries, private_u_row_ptr, private_u_row_end, row_done,
      ctx->nk, ctx->nk, supernode_start, supernode_end);
    (void)kls_row_first_supernode_panel_cache_build(
      &private_supernode_panel_cache, &private_u_entries, private_u_row_ptr,
      private_u_row_end, udiag_values, row_done, supernode_start,
      supernode_end, ctx->nk, ctx->nk, stats);
  } else {
    kls_row_first_supernodes_reset_prefix(
      &private_u_entries, private_u_row_ptr, private_u_row_end, row_done,
      ctx->nk, begin, supernode_start, supernode_end);
    (void)kls_row_first_supernode_panel_cache_build(
      &private_supernode_panel_cache, &private_u_entries, private_u_row_ptr,
      private_u_row_end, udiag_values, row_done, supernode_start,
      supernode_end, ctx->nk, begin, stats);
  }

  kls_row_first_pipeline_shared shared;
  memset(&shared, 0, sizeof(shared));
  shared.ctx = ctx;
  shared.row_order = row_order;
  shared.active_rank = active_rank;
  shared.begin = begin;
  shared.end = end;
  shared.workspace = workspace;
  shared.l_entries = l_entries;
  shared.u_entries = u_entries;
  shared.private_u_entries = &private_u_entries;
  shared.private_u_row_ptr = private_u_row_ptr;
  shared.private_u_row_end = private_u_row_end;
  shared.supernode_start = supernode_start;
  shared.supernode_end = supernode_end;
  shared.supernode_valid_begin =
    supernode_valid_begin <= ctx->nk ? supernode_valid_begin : ctx->nk;
  shared.private_supernode_panel_cache =
    private_supernode_panel_cache.panel_id_by_row != NULL
      ? &private_supernode_panel_cache : NULL;
  shared.open_panel_start = KLS_KLU_EMPTY;
  shared.open_panel_end = KLS_KLU_EMPTY;
  shared.udiag_values = udiag_values;
  shared.row_done = row_done;
  shared.stats = stats;
  shared.completed_pos = begin;
  shared.lookahead_next_pos = begin;
  shared.order_epoch = 0;
  shared.owner_surface_trace_enabled =
    kls_row_pipeline_owner_surface_trace_env_enabled();
  shared.trace_enabled =
    kls_row_pipeline_trace_env_enabled() ||
    shared.owner_surface_trace_enabled;
  if (shared.trace_enabled &&
      ctx->nk <=
        (UF_long)(SIZE_MAX / sizeof(*shared.trace_state_union_mark))) {
    shared.trace_state_union_mark =
      (unsigned int *)calloc((size_t)ctx->nk,
                             sizeof(*shared.trace_state_union_mark));
  }
  shared.workers = workers;
  shared.lookahead_states = lookahead_states;
  shared.batch_targets = batch_targets;
  shared.compact_batch_targets = compact_batch_targets;
  shared.compact_window_states = compact_window_states;
  shared.compact_replay_state_touched = compact_replay_state_touched;
  shared.compact_union_pos = compact_union_pos;
  shared.compact_union_mark = compact_union_mark;
  shared.compact_group_slots = compact_group_slots;
  shared.compact_group_pos = compact_group_pos;
  shared.compact_group_mark = compact_group_mark;
  shared.compact_root_heads = compact_root_heads;
  shared.compact_pos_slots = compact_pos_slots;
  shared.worker_count = worker_count;
  shared.lookahead_count = lookahead_count;
  shared.compact_window_count = compact_window_count;
  shared.batch_target_capacity = batch_target_capacity;
  shared.compact_batch_target_capacity = compact_window_count;
  shared.producer_batch_enabled =
    !kls_row_pipeline_producer_batch_env_disabled();
  shared.active_catchup_batch_enabled =
    shared.producer_batch_enabled &&
    kls_row_pipeline_active_catchup_env_enabled();
  shared.lookahead_fill_enabled = requested_lookahead > 0u;
  shared.pivot_lookahead_enabled =
    requested_pivot_lookahead > 0u && shared.producer_batch_enabled;
  shared.pivot_supernode_rebase_enabled =
    !kls_row_pipeline_pivot_supernode_rebase_env_disabled();
  shared.supernode_producer_batch_enabled =
    shared.producer_batch_enabled &&
    kls_row_pipeline_supernode_producer_batch_env_enabled();
  shared.lookahead_max_inputs =
    kls_row_pipeline_lookahead_max_inputs_env();
  shared.compact_window_execute_enabled = compact_window_execute_requested;
  shared.compact_window_delay_output_enabled =
    compact_window_delay_output_requested;
  shared.compact_group_sparse_enabled =
    shared.compact_window_execute_enabled &&
    kls_row_pipeline_compact_sparse_group_env_enabled();
  shared.compact_group_replay_enabled =
    shared.compact_group_sparse_enabled &&
    shared.compact_window_delay_output_enabled &&
    kls_row_pipeline_compact_group_replay_env_enabled();
  shared.compact_claim_run_max_rows =
    kls_row_pipeline_compact_claim_run_max_rows_env();
  shared.compact_span_owner_rows =
    kls_row_pipeline_compact_span_owner_rows_env();
  shared.compact_span_owner_min_rows =
    kls_row_pipeline_compact_span_owner_min_rows_env();
  shared.compact_span_owner_min_entries_per_scan =
    kls_row_pipeline_compact_span_owner_min_entries_per_scan_env();
  shared.compact_span_owner_max_slots =
    kls_row_pipeline_compact_span_owner_max_slots_env();
  shared.compact_span_owner_max_links =
    kls_row_pipeline_compact_span_owner_max_links_env();
  shared.compact_span_owner_max_scan_entries =
    kls_row_pipeline_compact_span_owner_max_scan_entries_env();
  shared.compact_span_shared_owner_scan_rows =
    kls_row_pipeline_compact_span_shared_owner_scan_rows_env();
  shared.compact_claim_stream_owner_max_slots =
    kls_row_pipeline_compact_claim_stream_owner_max_slots_env();
  shared.compact_span_owner_allow_holes =
    kls_row_pipeline_compact_span_owner_allow_holes_env_enabled();
  shared.compact_span_owner_allow_prefix =
    kls_row_pipeline_compact_span_owner_allow_prefix_env_enabled();
  shared.compact_span_shared_owner_enabled =
    shared.compact_group_sparse_enabled &&
    shared.compact_window_delay_output_enabled &&
    kls_row_pipeline_compact_span_owner_shared_env_enabled() &&
    shared.compact_span_owner_rows >= 2u &&
    shared.compact_span_owner_max_slots > 0u &&
    shared.compact_span_owner_max_links > 0u &&
    shared.compact_span_owner_max_scan_entries > 0u;
  if (shared.compact_claim_run_max_rows >
      (UF_long)shared.compact_window_count) {
    shared.compact_claim_run_max_rows =
      (UF_long)shared.compact_window_count;
  }
  if (shared.compact_span_owner_rows >
      (UF_long)shared.compact_window_count) {
    shared.compact_span_owner_rows =
      (UF_long)shared.compact_window_count;
  }
  if (shared.compact_span_owner_min_rows >
      shared.compact_span_owner_rows) {
    shared.compact_span_owner_min_rows = shared.compact_span_owner_rows;
  }
  if (shared.compact_span_shared_owner_scan_rows == 0u ||
      shared.compact_span_shared_owner_scan_rows <
        shared.compact_span_owner_rows) {
    shared.compact_span_shared_owner_scan_rows =
      shared.compact_span_owner_rows;
  }
  if (shared.compact_span_shared_owner_scan_rows >
      (UF_long)shared.compact_window_count) {
    shared.compact_span_shared_owner_scan_rows =
      (UF_long)shared.compact_window_count;
  }
  shared.compact_claim_run_enabled =
    shared.compact_group_sparse_enabled &&
    shared.compact_claim_run_max_rows >= 2u;
  shared.compact_claim_stream_owner_enabled =
    shared.compact_claim_run_enabled &&
    shared.compact_window_delay_output_enabled &&
    kls_row_pipeline_compact_claim_stream_owner_env_enabled() &&
    shared.compact_claim_stream_owner_max_slots >=
      KLS_ROW_FIRST_COMPACT_CLAIM_STREAM_OWNER_DEFAULT_MAX_SLOTS &&
    shared.compact_claim_stream_owner_max_slots >=
      shared.compact_claim_run_max_rows;
  shared.compact_span_owner_enabled =
    shared.compact_group_sparse_enabled &&
    shared.compact_window_delay_output_enabled &&
    shared.compact_span_owner_rows >= 2u &&
    shared.compact_span_owner_max_slots > 0u &&
    shared.compact_span_owner_max_links > 0u &&
    shared.compact_span_owner_max_scan_entries > 0u;
  shared.compact_span_shared_owner_enabled =
    shared.compact_span_shared_owner_enabled &&
    shared.compact_span_owner_rows >= 2u &&
    shared.compact_span_owner_rows <= (UF_long)shared.compact_window_count;
  shared.compact_span_shared_owner_dep_limit =
    shared.compact_span_shared_owner_enabled
      ? kls_row_pipeline_compact_span_shared_owner_dep_limit_env() : 0u;
  if (shared.compact_span_shared_owner_enabled &&
      kls_row_pipeline_compact_span_shared_owner_single_dep_env_enabled()) {
    shared.compact_span_shared_owner_dep_limit = 1u;
  }
  shared.compact_span_shared_owner_nonprefix_enabled =
    shared.compact_span_shared_owner_enabled &&
    shared.compact_span_shared_owner_dep_limit > 0u &&
    kls_row_pipeline_compact_span_shared_owner_nonprefix_env_enabled();
  shared.compact_span_shared_owner_nonprefix_retain_enabled =
    shared.compact_span_shared_owner_nonprefix_enabled &&
    kls_row_pipeline_compact_span_shared_owner_nonprefix_retain_env_enabled();
  shared.compact_span_shared_owner_nonprefix_work_weight_enabled =
    shared.compact_span_shared_owner_nonprefix_enabled &&
    kls_row_pipeline_compact_span_shared_owner_nonprefix_work_weight_env_enabled();
  shared.compact_span_shared_owner_sparse_values_enabled =
    shared.compact_span_shared_owner_enabled &&
    kls_row_pipeline_compact_span_shared_owner_sparse_values_env_enabled();
  shared.compact_span_shared_owner_nonprefix_retain_min_rows =
    shared.compact_span_shared_owner_nonprefix_retain_enabled
      ? kls_row_pipeline_compact_span_shared_owner_nonprefix_retain_min_rows_env()
      : 0u;
  if (shared.compact_span_shared_owner_nonprefix_retain_min_rows >
      shared.compact_span_owner_rows) {
    shared.compact_span_shared_owner_nonprefix_retain_min_rows =
      shared.compact_span_owner_rows;
  }
  shared.compact_claim_span_trace_rows =
    shared.trace_enabled
      ? kls_row_pipeline_compact_claim_span_trace_rows_env() : 0u;
  shared.compact_window_enabled =
    (shared.trace_enabled &&
     kls_row_pipeline_compact_window_trace_env_enabled()) ||
    shared.compact_window_execute_enabled;
  shared.compact_window_max_entries =
    kls_row_pipeline_compact_window_max_entries_env();
  shared.compact_deferred_output_max_entries =
    kls_row_pipeline_compact_deferred_output_max_entries_env();
  shared.compact_deferred_output_min_u_entries =
    kls_row_pipeline_compact_deferred_output_min_u_entries_env();
  shared.compact_group_output_max_slots =
    kls_row_pipeline_compact_group_output_max_slots_env();
  shared.compact_group_output_min_u_entries =
    kls_row_pipeline_compact_group_output_min_u_entries_env();
  shared.compact_deferred_output_cache_enabled =
    shared.compact_window_execute_enabled &&
    shared.compact_window_delay_output_enabled &&
    shared.compact_deferred_output_max_entries > 0u &&
    kls_row_pipeline_compact_deferred_output_cache_env_enabled();
  shared.compact_group_output_cache_enabled =
    shared.compact_group_sparse_enabled &&
    shared.compact_window_delay_output_enabled &&
    shared.compact_group_output_max_slots > 0u &&
    kls_row_pipeline_compact_group_output_cache_env_enabled();
  shared.owner_surface_window =
    shared.owner_surface_trace_enabled
      ? kls_row_pipeline_owner_surface_window_env() : 0u;
  shared.owner_surface_interval =
    shared.owner_surface_trace_enabled
      ? kls_row_pipeline_owner_surface_interval_env() : 0u;
  shared.compact_window_next_pos = begin;
  shared.compact_window_evict_pos = begin;
  shared.compact_window_scan_slot = 0;
  shared.compact_group_dep = KLS_KLU_EMPTY;
  shared.long_row_trace_threshold =
    shared.trace_enabled ? kls_row_pipeline_long_row_trace_threshold() : 0u;
  if (compact_root_heads != NULL) {
    for (UF_long dep = 0; dep < ctx->nk; ++dep) {
      compact_root_heads[dep] = -1;
    }
  }
  if (compact_pos_slots != NULL) {
    for (UF_long pos = 0; pos < ctx->nk; ++pos) {
      compact_pos_slots[pos] = -1;
    }
  }
  if (compact_group_slots != NULL) {
    for (int slot = 0; slot < compact_window_count; ++slot) {
      compact_group_slots[slot] = -1;
    }
  }
  for (int slot = 0; slot < compact_window_count; ++slot) {
    compact_window_states[slot].bucket_slot = slot;
    compact_window_states[slot].bucket_next = -1;
    compact_window_states[slot].bucket_dep = KLS_KLU_EMPTY;
  }
  atomic_init(&shared.next_pos, (unsigned long)begin);
  if (pthread_mutex_init(&shared.lock, NULL) != 0) {
    kls_row_first_supernode_panel_cache_free(
      &private_supernode_panel_cache);
    free(threads);
    free(workers);
    free(lookahead_states);
    free(compact_window_states);
    free(compact_batch_targets);
    free(compact_root_heads);
    free(batch_targets);
    kls_row_first_entries_free(&private_u_entries);
    free(private_u_row_ptr);
    free(private_u_row_end);
    free(supernode_start);
    free(supernode_end);
    free(shared.compact_batch_positions);
    free(shared.compact_union_cols);
    free(shared.compact_union_pos);
    free(shared.compact_union_mark);
    free(shared.compact_union_values);
    free(shared.compact_union_flags);
    free(shared.compact_replay_min_rows);
    free(shared.compact_replay_next);
    free(shared.compact_replay_lpos);
    free(shared.compact_replay_slots);
    free(shared.compact_replay_touched);
    free(shared.compact_replay_state_touched);
    free(shared.compact_group_slots);
    free(shared.compact_group_cols);
    free(shared.compact_group_pos);
    free(shared.compact_group_mark);
    free(shared.compact_group_values);
    free(shared.compact_group_flags);
    free(shared.compact_span_shared_owner_cols);
    free(shared.compact_span_shared_owner_deps);
    free(shared.compact_span_shared_owner_sparse_row_ptr);
    free(shared.compact_span_shared_owner_sparse_cols);
    free(shared.compact_span_shared_owner_values);
    free(shared.compact_span_shared_owner_sparse_values);
    free(shared.compact_span_shared_owner_mask);
    free(shared.compact_span_shared_owner_replay_entries);
    free(shared.compact_pos_slots);
    free(shared.trace_state_union_mark);
    return 0;
  }
  if (pthread_cond_init(&shared.cond, NULL) != 0) {
    pthread_mutex_destroy(&shared.lock);
    kls_row_first_supernode_panel_cache_free(
      &private_supernode_panel_cache);
    free(threads);
    free(workers);
    free(lookahead_states);
    free(compact_window_states);
    free(compact_batch_targets);
    free(compact_root_heads);
    free(batch_targets);
    kls_row_first_entries_free(&private_u_entries);
    free(private_u_row_ptr);
    free(private_u_row_end);
    free(supernode_start);
    free(supernode_end);
    free(shared.compact_batch_positions);
    free(shared.compact_union_cols);
    free(shared.compact_union_pos);
    free(shared.compact_union_mark);
    free(shared.compact_union_values);
    free(shared.compact_union_flags);
    free(shared.compact_replay_min_rows);
    free(shared.compact_replay_next);
    free(shared.compact_replay_lpos);
    free(shared.compact_replay_slots);
    free(shared.compact_replay_touched);
    free(shared.compact_replay_state_touched);
    free(shared.compact_group_slots);
    free(shared.compact_group_cols);
    free(shared.compact_group_pos);
    free(shared.compact_group_mark);
    free(shared.compact_group_values);
    free(shared.compact_group_flags);
    free(shared.compact_span_shared_owner_cols);
    free(shared.compact_span_shared_owner_deps);
    free(shared.compact_span_shared_owner_sparse_row_ptr);
    free(shared.compact_span_shared_owner_sparse_cols);
    free(shared.compact_span_shared_owner_values);
    free(shared.compact_span_shared_owner_sparse_values);
    free(shared.compact_span_shared_owner_mask);
    free(shared.compact_span_shared_owner_replay_entries);
    free(shared.compact_pos_slots);
    free(shared.trace_state_union_mark);
    return 0;
  }
  int lookahead_ready = 1;
  for (int slot = 0; slot < shared.lookahead_count; ++slot) {
    lookahead_states[slot].shared = &shared;
    lookahead_states[slot].state_storage.row = UF_long_max;
    lookahead_states[slot].lookahead_pos = KLS_KLU_EMPTY;
    lookahead_states[slot].lookahead_row = KLS_KLU_EMPTY;
    if (!kls_row_first_workspace_init(&lookahead_states[slot].workspace,
                                      ctx->nk)) {
      lookahead_ready = 0;
      break;
    }
    lookahead_states[slot].workspace.supernode_panel_cache =
      shared.private_supernode_panel_cache;
  }
  if (!lookahead_ready) {
    for (int slot = 0; slot < shared.lookahead_count; ++slot) {
      kls_row_first_pipeline_worker_free(lookahead_states + slot);
    }
    free(lookahead_states);
    lookahead_states = NULL;
    shared.lookahead_states = NULL;
    shared.lookahead_count = 0;
  }
  kls_row_first_pipeline_trace_print(&shared, "start");

  int created = 0;
  for (int tid = 0; tid < worker_count; ++tid) {
    workers[tid].shared = &shared;
    if (pthread_create(&threads[tid], NULL,
                       kls_row_first_pipeline_worker_main,
                       workers + tid) != 0) {
      pthread_mutex_lock(&shared.lock);
      shared.failed = 1;
      pthread_cond_broadcast(&shared.cond);
      pthread_mutex_unlock(&shared.lock);
      break;
    }
    created++;
  }
  for (int tid = 0; tid < created; ++tid) {
    (void)pthread_join(threads[tid], NULL);
  }

  UF_long processed_rows = 0;
  UF_long partial_rows = 0;
  UF_long wait_partial_rows = 0;
  UF_long wait_partial_deps = 0;
  UF_long supernode_update_groups = 0;
  UF_long supernode_update_rows = 0;
  UF_long supernode_panel_update_groups = 0;
  UF_long supernode_panel_update_rows = 0;
  UF_long active_threads = 0;
  for (int tid = 0; tid < created; ++tid) {
    processed_rows += workers[tid].rows;
    partial_rows += workers[tid].partial_rows;
    wait_partial_rows += workers[tid].pipeline_wait_partial_rows;
    wait_partial_deps += workers[tid].pipeline_wait_partial_deps;
    supernode_update_groups +=
      workers[tid].pipeline_supernode_update_groups;
    supernode_update_rows += workers[tid].pipeline_supernode_update_rows;
    supernode_panel_update_groups +=
      workers[tid].pipeline_supernode_panel_update_groups;
    supernode_panel_update_rows +=
      workers[tid].pipeline_supernode_panel_update_rows;
    if (workers[tid].rows > 0u) {
      active_threads++;
    }
  }
  const int ok = created == worker_count && !shared.failed &&
    shared.completed_pos == end && processed_rows == pipeline_rows;
  const int pivot_tail_ready = created == worker_count && shared.failed &&
    shared.failure_reason == KLS_ROW_FIRST_PIPELINE_FAIL_PIVOT &&
    shared.completed_pos >= begin &&
    shared.completed_pos < end &&
    processed_rows == shared.completed_pos - begin;
  if (shared.trace_enabled) {
    kls_row_first_pipeline_trace_print(
      &shared, ok ? "done" : (pivot_tail_ready ? "pivot-tail" : "failed"));
  }
  if (completed_pos_out != NULL) {
    *completed_pos_out = shared.completed_pos;
  }
  if (pivot_tail_ready_out != NULL) {
    *pivot_tail_ready_out = pivot_tail_ready ? 1 : 0;
  }
  if ((ok || pivot_tail_ready) && pipeline_rows_out != NULL) {
    *pipeline_rows_out = processed_rows;
  }
  if ((ok || pivot_tail_ready) && thread_rows_out != NULL) {
    *thread_rows_out = active_threads;
  }
  if ((ok || pivot_tail_ready) && partial_rows_out != NULL) {
    *partial_rows_out = partial_rows;
  }
  if ((ok || pivot_tail_ready) && wait_partial_rows_out != NULL) {
    *wait_partial_rows_out = wait_partial_rows;
  }
  if ((ok || pivot_tail_ready) && wait_partial_deps_out != NULL) {
    *wait_partial_deps_out = wait_partial_deps;
  }
  if ((ok || pivot_tail_ready) && supernode_update_groups_out != NULL) {
    *supernode_update_groups_out = supernode_update_groups;
  }
  if ((ok || pivot_tail_ready) && supernode_update_rows_out != NULL) {
    *supernode_update_rows_out = supernode_update_rows;
  }
  if ((ok || pivot_tail_ready) &&
      supernode_panel_update_groups_out != NULL) {
    *supernode_panel_update_groups_out = supernode_panel_update_groups;
  }
  if ((ok || pivot_tail_ready) &&
      supernode_panel_update_rows_out != NULL) {
    *supernode_panel_update_rows_out = supernode_panel_update_rows;
  }
  if ((ok || pivot_tail_ready) && pivot_tail_rows_out != NULL) {
    *pivot_tail_rows_out = shared.pivot_tail_rows;
  }
  if ((ok || pivot_tail_ready) && pivot_restarts_out != NULL) {
    *pivot_restarts_out = shared.pivot_restarts;
  }

  pthread_cond_destroy(&shared.cond);
  pthread_mutex_destroy(&shared.lock);
  for (int tid = 0; tid < worker_count; ++tid) {
    kls_row_first_pipeline_worker_free(workers + tid);
  }
  for (int slot = 0; slot < shared.lookahead_count; ++slot) {
    kls_row_first_pipeline_worker_free(lookahead_states + slot);
  }
  for (int slot = 0; slot < shared.compact_window_count; ++slot) {
    kls_row_first_compact_window_state_free(
      compact_window_states + slot);
  }
  kls_row_first_supernode_panel_cache_free(&private_supernode_panel_cache);
  kls_row_first_entries_free(&private_u_entries);
  free(private_u_row_ptr);
  free(private_u_row_end);
  free(supernode_start);
  free(supernode_end);
  free(threads);
  free(workers);
  free(lookahead_states);
  free(compact_window_states);
  free(compact_batch_targets);
  free(shared.compact_batch_positions);
  free(shared.compact_union_cols);
  free(shared.compact_union_pos);
  free(shared.compact_union_mark);
  free(shared.compact_union_values);
  free(shared.compact_union_flags);
  free(shared.compact_replay_min_rows);
  free(shared.compact_replay_next);
  free(shared.compact_replay_lpos);
  free(shared.compact_replay_slots);
  free(shared.compact_replay_touched);
  free(shared.compact_replay_state_touched);
  free(shared.compact_group_slots);
  free(shared.compact_group_cols);
  free(shared.compact_group_pos);
  free(shared.compact_group_mark);
  free(shared.compact_group_values);
  free(shared.compact_group_flags);
  free(shared.compact_span_shared_owner_cols);
  free(shared.compact_span_shared_owner_deps);
  free(shared.compact_span_shared_owner_sparse_row_ptr);
  free(shared.compact_span_shared_owner_sparse_cols);
  free(shared.compact_span_shared_owner_values);
  free(shared.compact_span_shared_owner_sparse_values);
  free(shared.compact_span_shared_owner_mask);
  free(shared.compact_span_shared_owner_replay_entries);
  free(shared.compact_pos_slots);
  free(compact_root_heads);
  free(batch_targets);
  free(shared.trace_state_union_mark);
  return ok;
}

static int kls_row_first_run_restartable_pipeline_suffix(
  const kls_row_first_block_context *ctx,
  const UF_long *row_order,
  const UF_long *active_rank,
  UF_long begin,
  UF_long end,
  int thread_count,
  kls_row_first_workspace *workspace,
  kls_row_first_entries *l_entries,
  kls_row_first_entries *u_entries,
  double *udiag_values,
  unsigned char *row_done,
  kls_row_first_row_stats *stats,
  UF_long *pipeline_rows_out,
  UF_long *thread_rows_out,
  UF_long *partial_rows_out,
  UF_long *wait_partial_rows_out,
  UF_long *wait_partial_deps_out,
  UF_long *supernode_update_groups_out,
  UF_long *supernode_update_rows_out,
  UF_long *supernode_panel_update_groups_out,
  UF_long *supernode_panel_update_rows_out,
  UF_long *pivot_tail_rows_out,
  UF_long *pivot_restarts_out,
  UF_long *pivot_serial_rows_out,
  kls_row_first_supernode_panel_cache *pivot_serial_panel_cache,
  UF_long *pivot_serial_open_panel_start_io,
  UF_long *pivot_serial_open_panel_end_io) {
  if (pipeline_rows_out != NULL) {
    *pipeline_rows_out = 0;
  }
  if (thread_rows_out != NULL) {
    *thread_rows_out = 0;
  }
  if (partial_rows_out != NULL) {
    *partial_rows_out = 0;
  }
  if (wait_partial_rows_out != NULL) {
    *wait_partial_rows_out = 0;
  }
  if (wait_partial_deps_out != NULL) {
    *wait_partial_deps_out = 0;
  }
  if (supernode_update_groups_out != NULL) {
    *supernode_update_groups_out = 0;
  }
  if (supernode_update_rows_out != NULL) {
    *supernode_update_rows_out = 0;
  }
  if (supernode_panel_update_groups_out != NULL) {
    *supernode_panel_update_groups_out = 0;
  }
  if (supernode_panel_update_rows_out != NULL) {
    *supernode_panel_update_rows_out = 0;
  }
  if (pivot_tail_rows_out != NULL) {
    *pivot_tail_rows_out = 0;
  }
  if (pivot_restarts_out != NULL) {
    *pivot_restarts_out = 0;
  }
  if (pivot_serial_rows_out != NULL) {
    *pivot_serial_rows_out = 0;
  }
  if (ctx == NULL || row_order == NULL || begin > end ||
      thread_count <= 1 || workspace == NULL || l_entries == NULL ||
      u_entries == NULL || udiag_values == NULL || row_done == NULL) {
    return 0;
  }
  if (begin == end) {
    return 1;
  }

  UF_long cursor = begin;
  UF_long pipeline_rows = 0;
  UF_long max_threads = 0;
  UF_long partial_rows = 0;
  UF_long wait_partial_rows = 0;
  UF_long wait_partial_deps = 0;
  UF_long supernode_update_groups = 0;
  UF_long supernode_update_rows = 0;
  UF_long supernode_panel_update_groups = 0;
  UF_long supernode_panel_update_rows = 0;
  UF_long pivot_tail_rows = 0;
  UF_long pivot_restarts = 0;
  UF_long pivot_serial_rows = 0;
  UF_long supernode_valid_begin = 0u;
  while (cursor < end) {
    UF_long phase_rows = 0;
    UF_long phase_threads = 0;
    UF_long phase_partial_rows = 0;
    UF_long phase_wait_partial_rows = 0;
    UF_long phase_wait_partial_deps = 0;
    UF_long phase_supernode_groups = 0;
    UF_long phase_supernode_rows = 0;
    UF_long phase_supernode_panel_groups = 0;
    UF_long phase_supernode_panel_rows = 0;
    UF_long phase_pivot_tail_rows = 0;
    UF_long phase_pivot_restarts = 0;
    UF_long completed_pos = cursor;
    int pivot_tail_ready = 0;
    if (kls_row_first_run_parallel_pipeline_phase(
          ctx, row_order, active_rank, cursor, end, supernode_valid_begin,
          thread_count, workspace, l_entries, u_entries, udiag_values,
          row_done, stats, &phase_rows, &phase_threads,
          &phase_partial_rows, &phase_wait_partial_rows,
          &phase_wait_partial_deps, &phase_supernode_groups,
          &phase_supernode_rows, &phase_supernode_panel_groups,
          &phase_supernode_panel_rows, &completed_pos,
          &pivot_tail_ready, &phase_pivot_tail_rows,
          &phase_pivot_restarts)) {
      pipeline_rows += phase_rows;
      if (phase_threads > max_threads) {
        max_threads = phase_threads;
      }
      partial_rows += phase_partial_rows;
      wait_partial_rows += phase_wait_partial_rows;
      wait_partial_deps += phase_wait_partial_deps;
      supernode_update_groups += phase_supernode_groups;
      supernode_update_rows += phase_supernode_rows;
      supernode_panel_update_groups += phase_supernode_panel_groups;
      supernode_panel_update_rows += phase_supernode_panel_rows;
      pivot_tail_rows += phase_pivot_tail_rows;
      pivot_restarts += phase_pivot_restarts;
      cursor = end;
      break;
    }
    if (!pivot_tail_ready || completed_pos < cursor ||
        completed_pos >= end) {
      return 0;
    }
    pipeline_rows += phase_rows;
    if (phase_threads > max_threads) {
      max_threads = phase_threads;
    }
    partial_rows += phase_partial_rows;
    wait_partial_rows += phase_wait_partial_rows;
    wait_partial_deps += phase_wait_partial_deps;
    supernode_update_groups += phase_supernode_groups;
    supernode_update_rows += phase_supernode_rows;
    supernode_panel_update_groups += phase_supernode_panel_groups;
    supernode_panel_update_rows += phase_supernode_panel_rows;
    pivot_tail_rows += phase_pivot_tail_rows;
    pivot_restarts += phase_pivot_restarts;
    pivot_tail_rows += end - completed_pos;
    pivot_restarts++;
    const UF_long pivot_row = row_order[completed_pos];
    const UF_long pivots_before =
      stats != NULL ? stats->dynamic_column_pivots : 0u;
    kls_row_first_factor_row_failure_info pivot_failure;
    kls_row_first_factor_row_failure_clear(&pivot_failure, pivot_row, -1);
    if (pivot_row >= ctx->nk ||
        !kls_row_first_factor_one_row(
          ctx, workspace, l_entries, u_entries, udiag_values, pivot_row,
          NULL, -1, row_done, stats, &pivot_failure)) {
      if (kls_first_factor_trace_env_enabled()) {
        fprintf(stderr,
                "KLS first-factor row-pipeline pivot-tail failure:"
                " pos=%" PRIu64 " row=%" PRIu64
                " reason=%s related_col=%" PRIu64
                " actual_owner=%d active_rank=%d\n",
                (uint64_t)completed_pos, (uint64_t)pivot_row,
                kls_row_first_factor_row_failure_name(pivot_failure.reason),
                (uint64_t)pivot_failure.related_col,
                pivot_failure.actual_owner, active_rank != NULL ? 1 : 0);
      }
      return 0;
    }
    if (stats != NULL && stats->dynamic_column_pivots != pivots_before) {
      const UF_long floor =
        pivot_row >= ctx->nk ? ctx->nk : pivot_row + 1u;
      if (floor > supernode_valid_begin) {
        supernode_valid_begin = floor;
      }
      kls_row_first_supernode_panel_cache_reset_active(
        pivot_serial_panel_cache, workspace, ctx->nk,
        pivot_serial_open_panel_start_io,
        pivot_serial_open_panel_end_io);
    }
    kls_row_first_supernode_panel_cache_publish_completed(
      workspace->supernode_panel_cache != NULL
        ? pivot_serial_panel_cache : NULL,
      u_entries, workspace->u_row_ptr, workspace->u_row_end,
      udiag_values, ctx->nk, stats, pivot_serial_open_panel_start_io,
      pivot_serial_open_panel_end_io, pivot_row);
    pivot_serial_rows++;
    cursor = completed_pos + 1u;
  }

  if (pipeline_rows_out != NULL) {
    *pipeline_rows_out = pipeline_rows;
  }
  if (thread_rows_out != NULL) {
    *thread_rows_out = max_threads;
  }
  if (partial_rows_out != NULL) {
    *partial_rows_out = partial_rows;
  }
  if (wait_partial_rows_out != NULL) {
    *wait_partial_rows_out = wait_partial_rows;
  }
  if (wait_partial_deps_out != NULL) {
    *wait_partial_deps_out = wait_partial_deps;
  }
  if (supernode_update_groups_out != NULL) {
    *supernode_update_groups_out = supernode_update_groups;
  }
  if (supernode_update_rows_out != NULL) {
    *supernode_update_rows_out = supernode_update_rows;
  }
  if (supernode_panel_update_groups_out != NULL) {
    *supernode_panel_update_groups_out = supernode_panel_update_groups;
  }
  if (supernode_panel_update_rows_out != NULL) {
    *supernode_panel_update_rows_out = supernode_panel_update_rows;
  }
  if (pivot_tail_rows_out != NULL) {
    *pivot_tail_rows_out = pivot_tail_rows;
  }
  if (pivot_restarts_out != NULL) {
    *pivot_restarts_out = pivot_restarts;
  }
  if (pivot_serial_rows_out != NULL) {
    *pivot_serial_rows_out = pivot_serial_rows;
  }
  return 1;
}

static int kls_row_first_run_etree_prefactor_tail_phase(
  const kls_row_first_block_context *ctx,
  const UF_long *row_order,
  const unsigned char *active_mask,
  const UF_long *tail_parent,
  UF_long active_rows,
  UF_long supernode_valid_begin,
  int thread_count,
  kls_row_first_workspace *workspace,
  kls_row_first_entries *l_entries,
  kls_row_first_entries *u_entries,
  double *udiag_values,
  unsigned char *row_done,
  kls_row_first_row_stats *stats,
  UF_long *thread_rows_out,
  UF_long *prefactor_rows_out,
  UF_long *wait_partial_rows_out,
  UF_long *wait_partial_deps_out,
  UF_long *supernode_update_groups_out,
  UF_long *supernode_update_rows_out,
  UF_long *supernode_panel_update_groups_out,
  UF_long *supernode_panel_update_rows_out,
  UF_long *pivot_tail_rows_out,
  UF_long *pivot_restarts_out) {
  if (thread_rows_out != NULL) {
    *thread_rows_out = 0;
  }
  if (prefactor_rows_out != NULL) {
    *prefactor_rows_out = 0;
  }
  if (wait_partial_rows_out != NULL) {
    *wait_partial_rows_out = 0;
  }
  if (wait_partial_deps_out != NULL) {
    *wait_partial_deps_out = 0;
  }
  if (supernode_update_groups_out != NULL) {
    *supernode_update_groups_out = 0;
  }
  if (supernode_update_rows_out != NULL) {
    *supernode_update_rows_out = 0;
  }
  if (supernode_panel_update_groups_out != NULL) {
    *supernode_panel_update_groups_out = 0;
  }
  if (supernode_panel_update_rows_out != NULL) {
    *supernode_panel_update_rows_out = 0;
  }
  if (pivot_tail_rows_out != NULL) {
    *pivot_tail_rows_out = 0;
  }
  if (pivot_restarts_out != NULL) {
    *pivot_restarts_out = 0;
  }
  if (ctx == NULL || row_order == NULL || active_mask == NULL ||
      tail_parent == NULL ||
      active_rows == 0u || thread_count <= 1 || workspace == NULL ||
      l_entries == NULL || u_entries == NULL || udiag_values == NULL ||
      row_done == NULL || workspace->u_row_ptr == NULL ||
      workspace->u_row_end == NULL) {
    return 0;
  }

  UF_long *active_rank =
    (UF_long *)malloc((size_t)ctx->nk * sizeof(*active_rank));
  if (active_rank == NULL) {
    return 0;
  }
  for (UF_long row = 0; row < ctx->nk; ++row) {
    active_rank[row] = KLS_KLU_EMPTY;
  }
  for (UF_long pos = 0; pos < active_rows; ++pos) {
    const UF_long row = row_order[pos];
    if (row >= ctx->nk || active_mask[row] == 0u ||
        active_rank[row] != KLS_KLU_EMPTY) {
      free(active_rank);
      return 0;
    }
    active_rank[row] = pos;
  }
  int active_tail_is_chain = 1;
  for (UF_long pos = 0; pos < active_rows; ++pos) {
    const UF_long row = row_order[pos];
    const UF_long parent = tail_parent[row];
    if (parent == row) {
      free(active_rank);
      return 0;
    }
    if (parent >= 0 && parent < ctx->nk && active_mask[parent] != 0u) {
      const UF_long parent_rank = active_rank[parent];
      if (parent_rank == KLS_KLU_EMPTY || parent_rank <= pos) {
        free(active_rank);
        return 0;
      }
      if (parent_rank != pos + 1u) {
        active_tail_is_chain = 0;
      }
    } else if (pos + 1u < active_rows) {
      active_tail_is_chain = 0;
    }
  }

  /* A width-one affected subtree has no exploitable row concurrency.  The
     direct topological walk avoids ready-queue, worker, and speculative-state
     machinery; the force switch is useful for new-architecture experiments,
     while the default gate is the exact structural certificate. */
  const int serial_etree_tail =
    getenv("KLS_ENABLE_FAST_REJECT_SERIAL_ETREE_TAIL") != NULL ||
    (getenv("KLS_DISABLE_FAST_REJECT_SERIAL_ETREE_TAIL") == NULL &&
     active_tail_is_chain);
  if (serial_etree_tail) {
    UF_long open_panel_start = KLS_KLU_EMPTY;
    UF_long open_panel_end = KLS_KLU_EMPTY;
    for (UF_long pos = 0; pos < active_rows; ++pos) {
      const UF_long row = row_order[pos];
      const UF_long pivots_before =
        stats != NULL ? stats->dynamic_column_pivots : 0u;
      if (row >= ctx->nk ||
          !kls_row_first_factor_one_row(
            ctx, workspace, l_entries, u_entries, udiag_values, row,
            NULL, -1, row_done, stats, NULL)) {
        free(active_rank);
        return 0;
      }
      if (stats != NULL && stats->dynamic_column_pivots != pivots_before) {
        const UF_long floor = row >= ctx->nk ? ctx->nk : row + 1u;
        if (floor > supernode_valid_begin) {
          supernode_valid_begin = floor;
        }
        if (workspace->supernode_panel_cache != NULL) {
          kls_row_first_supernode_panel_cache_reset_active(
            workspace->supernode_panel_cache, workspace, ctx->nk,
            &open_panel_start, &open_panel_end);
        }
      }
      kls_row_first_supernode_panel_cache_publish_completed(
        workspace->supernode_panel_cache, u_entries,
        workspace->u_row_ptr, workspace->u_row_end, udiag_values,
        ctx->nk, stats, &open_panel_start, &open_panel_end, row);
    }
    if (thread_rows_out != NULL) {
      *thread_rows_out = 1u;
    }
    if (prefactor_rows_out != NULL) {
      *prefactor_rows_out = active_rows;
    }
    free(active_rank);
    return 1;
  }

  UF_long cursor = 0;
  UF_long max_threads = 0;
  UF_long prefactor_rows = 0;
  UF_long wait_partial_rows = 0;
  UF_long wait_partial_deps = 0;
  UF_long supernode_update_groups = 0;
  UF_long supernode_update_rows = 0;
  UF_long supernode_panel_update_groups = 0;
  UF_long supernode_panel_update_rows = 0;
  UF_long pivot_tail_rows = 0;
  UF_long pivot_restarts = 0;
  UF_long open_panel_start = KLS_KLU_EMPTY;
  UF_long open_panel_end = KLS_KLU_EMPTY;
  while (cursor < active_rows) {
    UF_long phase_pipeline_rows = 0;
    UF_long phase_threads = 0;
    UF_long phase_prefactor_rows = 0;
    UF_long phase_wait_partial_rows = 0;
    UF_long phase_wait_partial_deps = 0;
    UF_long phase_supernode_update_groups = 0;
    UF_long phase_supernode_update_rows = 0;
    UF_long phase_supernode_panel_update_groups = 0;
    UF_long phase_supernode_panel_update_rows = 0;
    UF_long phase_pivot_tail_rows = 0;
    UF_long phase_pivot_restarts = 0;
    UF_long completed_pos = cursor;
    int pivot_tail_ready = 0;
    if (kls_row_first_run_parallel_pipeline_phase(
          ctx, row_order, active_rank, cursor, active_rows,
          supernode_valid_begin, thread_count, workspace, l_entries,
          u_entries, udiag_values, row_done, stats, &phase_pipeline_rows,
          &phase_threads, &phase_prefactor_rows, &phase_wait_partial_rows,
          &phase_wait_partial_deps, &phase_supernode_update_groups,
          &phase_supernode_update_rows, &phase_supernode_panel_update_groups,
          &phase_supernode_panel_update_rows, &completed_pos,
          &pivot_tail_ready, &phase_pivot_tail_rows,
          &phase_pivot_restarts)) {
      (void)phase_pipeline_rows;
      if (phase_threads > max_threads) {
        max_threads = phase_threads;
      }
      prefactor_rows += phase_prefactor_rows;
      wait_partial_rows += phase_wait_partial_rows;
      wait_partial_deps += phase_wait_partial_deps;
      supernode_update_groups += phase_supernode_update_groups;
      supernode_update_rows += phase_supernode_update_rows;
      supernode_panel_update_groups +=
        phase_supernode_panel_update_groups;
      supernode_panel_update_rows += phase_supernode_panel_update_rows;
      pivot_tail_rows += phase_pivot_tail_rows;
      pivot_restarts += phase_pivot_restarts;
      cursor = active_rows;
      break;
    }
    if (!pivot_tail_ready || completed_pos < cursor ||
        completed_pos >= active_rows) {
      free(active_rank);
      return 0;
    }
    (void)phase_pipeline_rows;
    if (phase_threads > max_threads) {
      max_threads = phase_threads;
    }
    prefactor_rows += phase_prefactor_rows;
    wait_partial_rows += phase_wait_partial_rows;
    wait_partial_deps += phase_wait_partial_deps;
    supernode_update_groups += phase_supernode_update_groups;
    supernode_update_rows += phase_supernode_update_rows;
    supernode_panel_update_groups +=
      phase_supernode_panel_update_groups;
    supernode_panel_update_rows += phase_supernode_panel_update_rows;
    pivot_tail_rows += phase_pivot_tail_rows;
    pivot_restarts += phase_pivot_restarts;
    pivot_tail_rows += active_rows - completed_pos;
    pivot_restarts++;

    const UF_long pivot_row = row_order[completed_pos];
    const UF_long pivots_before =
      stats != NULL ? stats->dynamic_column_pivots : 0u;
    if (pivot_row >= ctx->nk ||
        !kls_row_first_factor_one_row(
          ctx, workspace, l_entries, u_entries, udiag_values, pivot_row,
          NULL, -1, row_done, stats, NULL)) {
      free(active_rank);
      return 0;
    }
    if (stats != NULL && stats->dynamic_column_pivots != pivots_before) {
      const UF_long floor =
        pivot_row >= ctx->nk ? ctx->nk : pivot_row + 1u;
      if (floor > supernode_valid_begin) {
        supernode_valid_begin = floor;
      }
      if (workspace->supernode_panel_cache != NULL) {
        kls_row_first_supernode_panel_cache_reset_active(
          workspace->supernode_panel_cache, workspace, ctx->nk,
          &open_panel_start, &open_panel_end);
      }
    }
    kls_row_first_supernode_panel_cache_publish_completed(
      workspace->supernode_panel_cache, u_entries, workspace->u_row_ptr,
      workspace->u_row_end, udiag_values, ctx->nk, stats, &open_panel_start,
      &open_panel_end, pivot_row);
    cursor = completed_pos + 1u;
  }
  if (thread_rows_out != NULL) {
    *thread_rows_out = max_threads;
  }
  if (prefactor_rows_out != NULL) {
    *prefactor_rows_out = prefactor_rows;
  }
  if (wait_partial_rows_out != NULL) {
    *wait_partial_rows_out = wait_partial_rows;
  }
  if (wait_partial_deps_out != NULL) {
    *wait_partial_deps_out = wait_partial_deps;
  }
  if (supernode_update_groups_out != NULL) {
    *supernode_update_groups_out = supernode_update_groups;
  }
  if (supernode_update_rows_out != NULL) {
    *supernode_update_rows_out = supernode_update_rows;
  }
  if (supernode_panel_update_groups_out != NULL) {
    *supernode_panel_update_groups_out = supernode_panel_update_groups;
  }
  if (supernode_panel_update_rows_out != NULL) {
    *supernode_panel_update_rows_out = supernode_panel_update_rows;
  }
  if (pivot_tail_rows_out != NULL) {
    *pivot_tail_rows_out = pivot_tail_rows;
  }
  if (pivot_restarts_out != NULL) {
    *pivot_restarts_out = pivot_restarts;
  }
  free(active_rank);
  return 1;
}

static void kls_row_first_lu_seed_free(kls_row_first_lu_seed *seed) {
  if (seed == NULL) {
    return;
  }
  free(seed->row);
  free(seed->col);
  free(seed->numeric_value);
  free(seed->value);
  memset(seed, 0, sizeof(*seed));
}

static void kls_row_first_input_seed_free(kls_row_first_input_seed *seed) {
  if (seed == NULL) {
    return;
  }
  free(seed->row);
  free(seed->col);
  free(seed->pos);
  memset(seed, 0, sizeof(*seed));
}

static void kls_row_first_refactor_seed_clear(
  kls_row_first_refactor_seed *seed) {
  if (seed == NULL) {
    return;
  }
  kls_row_first_lu_seed_free(&seed->l);
  kls_row_first_lu_seed_free(&seed->u);
  kls_row_first_input_seed_free(&seed->input);
  seed->n = 0;
  seed->enabled = 0;
}

static int kls_row_first_refactor_seed_init(
  kls_row_first_refactor_seed *seed,
  UF_long n) {
  if (seed == NULL) {
    return 0;
  }
  memset(seed, 0, sizeof(*seed));
  seed->n = n;
  seed->enabled = 1;
  return 1;
}

static int kls_row_first_lu_seed_reserve(kls_row_first_lu_seed *seed,
                                         UF_long extra) {
  if (seed == NULL || extra == 0u) {
    return seed != NULL;
  }
  if (extra > UF_long_max - seed->count) {
    return 0;
  }
  const UF_long needed = seed->count + extra;
  if (needed <= seed->capacity) {
    return 1;
  }
  UF_long capacity = seed->capacity == 0u ? 64u : seed->capacity;
  while (capacity < needed) {
    const UF_long grown = 2u * capacity;
    if (grown <= capacity) {
      capacity = needed;
      break;
    }
    capacity = grown;
  }
  if (capacity > (UF_long)(SIZE_MAX / sizeof(*seed->row)) ||
      capacity > (UF_long)(SIZE_MAX / sizeof(*seed->numeric_value)) ||
      capacity > (UF_long)(SIZE_MAX / sizeof(*seed->value))) {
    return 0;
  }
  UF_long *row =
    (UF_long *)realloc(seed->row, (size_t)capacity * sizeof(*row));
  if (row == NULL) {
    return 0;
  }
  seed->row = row;
  UF_long *col =
    (UF_long *)realloc(seed->col, (size_t)capacity * sizeof(*col));
  if (col == NULL) {
    return 0;
  }
  seed->col = col;
  double **numeric_value =
    (double **)realloc(seed->numeric_value,
                       (size_t)capacity * sizeof(*numeric_value));
  if (numeric_value == NULL) {
    return 0;
  }
  seed->numeric_value = numeric_value;
  double *value =
    (double *)realloc(seed->value, (size_t)capacity * sizeof(*value));
  if (value == NULL) {
    return 0;
  }
  seed->value = value;
  seed->capacity = capacity;
  return 1;
}

static int kls_row_first_input_seed_reserve(kls_row_first_input_seed *seed,
                                            UF_long extra) {
  if (seed == NULL || extra == 0u) {
    return seed != NULL;
  }
  if (extra > UF_long_max - seed->count) {
    return 0;
  }
  const UF_long needed = seed->count + extra;
  if (needed <= seed->capacity) {
    return 1;
  }
  UF_long capacity = seed->capacity == 0u ? 64u : seed->capacity;
  while (capacity < needed) {
    const UF_long grown = 2u * capacity;
    if (grown <= capacity) {
      capacity = needed;
      break;
    }
    capacity = grown;
  }
  if (capacity > (UF_long)(SIZE_MAX / sizeof(*seed->row))) {
    return 0;
  }
  UF_long *row =
    (UF_long *)realloc(seed->row, (size_t)capacity * sizeof(*row));
  if (row == NULL) {
    return 0;
  }
  seed->row = row;
  UF_long *col =
    (UF_long *)realloc(seed->col, (size_t)capacity * sizeof(*col));
  if (col == NULL) {
    return 0;
  }
  seed->col = col;
  UF_long *pos =
    (UF_long *)realloc(seed->pos, (size_t)capacity * sizeof(*pos));
  if (pos == NULL) {
    return 0;
  }
  seed->pos = pos;
  seed->capacity = capacity;
  return 1;
}

static int kls_row_first_lu_seed_append(kls_row_first_lu_seed *seed,
                                        UF_long row,
                                        UF_long col,
                                        double *numeric_value,
                                        double value) {
  if (seed == NULL || numeric_value == NULL ||
      !kls_row_first_lu_seed_reserve(seed, 1u)) {
    return 0;
  }
  const UF_long p = seed->count++;
  seed->row[p] = row;
  seed->col[p] = col;
  seed->numeric_value[p] = numeric_value;
  seed->value[p] = value;
  return 1;
}

static int kls_row_first_input_seed_append(kls_row_first_input_seed *seed,
                                           UF_long row,
                                           UF_long col,
                                           UF_long pos) {
  if (seed == NULL || !kls_row_first_input_seed_reserve(seed, 1u)) {
    return 0;
  }
  const UF_long p = seed->count++;
  seed->row[p] = row;
  seed->col[p] = col;
  seed->pos[p] = pos;
  return 1;
}

static int kls_row_first_refactor_seed_capture_block(
  kls_row_first_refactor_seed *seed,
  const kls_solver *solver,
  const trilinos_klu_l_numeric *numeric,
  UF_long block,
  UF_long k1,
  UF_long nk,
  const UF_long *row_ptr,
  const UF_long *row_cols,
  const UF_long *row_input_pos,
  const UF_long *col_pos,
  const kls_row_first_entries *l_entries,
  const kls_row_first_entries *u_entries) {
  if (seed == NULL || !seed->enabled) {
    return 1;
  }
  if (solver == NULL || numeric == NULL || row_ptr == NULL ||
      (row_ptr[nk] > 0u && (row_cols == NULL || row_input_pos == NULL)) ||
      col_pos == NULL || l_entries == NULL || u_entries == NULL ||
      numeric->LUbx == NULL || numeric->Lip == NULL ||
      numeric->Llen == NULL || numeric->Uip == NULL ||
      numeric->Ulen == NULL || block >= solver->symbolic->nblocks ||
      k1 > seed->n || nk > seed->n - k1) {
    return 0;
  }

  Unit *lu = numeric->LUbx[block];
  if (lu == NULL) {
    return 0;
  }

  for (UF_long row = 0; row < nk; ++row) {
    for (UF_long p = row_ptr[row]; p < row_ptr[row + 1u]; ++p) {
      const UF_long oldcol = row_cols[p];
      if (oldcol >= seed->n || col_pos[oldcol] >= nk ||
          row_input_pos[p] >= solver->nnz) {
        return 0;
      }
      if (!kls_row_first_input_seed_append(&seed->input, k1 + row,
                                           k1 + col_pos[oldcol],
                                           row_input_pos[p])) {
        return 0;
      }
    }
  }

  UF_long *l_write =
    nk > 0u ? (UF_long *)calloc((size_t)nk, sizeof(*l_write)) : NULL;
  UF_long *u_write =
    nk > 0u ? (UF_long *)calloc((size_t)nk, sizeof(*u_write)) : NULL;
  if ((nk > 0u && l_write == NULL) || (nk > 0u && u_write == NULL)) {
    free(l_write);
    free(u_write);
    return 0;
  }

  for (UF_long p = 0; p < l_entries->count; ++p) {
    const UF_long row = l_entries->row[p];
    const UF_long col = l_entries->col[p];
    if (row >= nk || col >= nk || row <= col) {
      free(l_write);
      free(u_write);
      return 0;
    }
    const UF_long len = numeric->Llen[k1 + col];
    const UF_long offset = l_write[col]++;
    if (offset >= len) {
      free(l_write);
      free(u_write);
      return 0;
    }
    double *lx =
      (double *)(lu + numeric->Lip[k1 + col] +
                 kls_klu_units_for_indices(len));
    if (!kls_row_first_lu_seed_append(&seed->l, k1 + row, k1 + col,
                                      lx + offset, l_entries->value[p])) {
      free(l_write);
      free(u_write);
      return 0;
    }
  }

  for (UF_long p = 0; p < u_entries->count; ++p) {
    const UF_long row = u_entries->row[p];
    const UF_long col = u_entries->col[p];
    if (row >= nk || col >= nk || col <= row) {
      free(l_write);
      free(u_write);
      return 0;
    }
    const UF_long len = numeric->Ulen[k1 + col];
    const UF_long offset = u_write[col]++;
    if (offset >= len) {
      free(l_write);
      free(u_write);
      return 0;
    }
    double *ux =
      (double *)(lu + numeric->Uip[k1 + col] +
                 kls_klu_units_for_indices(len));
    if (!kls_row_first_lu_seed_append(&seed->u, k1 + row, k1 + col,
                                      ux + offset, u_entries->value[p])) {
      free(l_write);
      free(u_write);
      return 0;
    }
  }

  free(l_write);
  free(u_write);
  return 1;
}

static int kls_row_first_refactor_seed_install(
  kls_solver *solver,
  kls_row_first_refactor_seed *seed) {
  if (solver == NULL || seed == NULL || !seed->enabled ||
      seed->n != solver->n) {
    kls_row_first_refactor_seed_clear(seed);
    return 0;
  }
  const UF_long n = seed->n;
  UF_long *l_ptr = (UF_long *)calloc((size_t)n + 1u, sizeof(*l_ptr));
  UF_long *u_ptr = (UF_long *)calloc((size_t)n + 1u, sizeof(*u_ptr));
  UF_long *input_ptr =
    (UF_long *)calloc((size_t)n + 1u, sizeof(*input_ptr));
  if (l_ptr == NULL || u_ptr == NULL || input_ptr == NULL) {
    free(l_ptr);
    free(u_ptr);
    free(input_ptr);
    kls_row_first_refactor_seed_clear(seed);
    return 0;
  }

  for (UF_long p = 0; p < seed->l.count; ++p) {
    if (seed->l.row[p] >= n || seed->l.col[p] >= seed->l.row[p]) {
      free(l_ptr);
      free(u_ptr);
      free(input_ptr);
      kls_row_first_refactor_seed_clear(seed);
      return 0;
    }
    l_ptr[seed->l.row[p] + 1u]++;
  }
  for (UF_long p = 0; p < seed->u.count; ++p) {
    if (seed->u.row[p] >= n || seed->u.col[p] <= seed->u.row[p] ||
        seed->u.col[p] >= n) {
      free(l_ptr);
      free(u_ptr);
      free(input_ptr);
      kls_row_first_refactor_seed_clear(seed);
      return 0;
    }
    u_ptr[seed->u.row[p] + 1u]++;
  }
  for (UF_long p = 0; p < seed->input.count; ++p) {
    if (seed->input.row[p] >= n || seed->input.col[p] >= n ||
        seed->input.pos[p] >= solver->nnz) {
      free(l_ptr);
      free(u_ptr);
      free(input_ptr);
      kls_row_first_refactor_seed_clear(seed);
      return 0;
    }
    input_ptr[seed->input.row[p] + 1u]++;
  }
  for (UF_long row = 0; row < n; ++row) {
    l_ptr[row + 1u] += l_ptr[row];
    u_ptr[row + 1u] += u_ptr[row];
    input_ptr[row + 1u] += input_ptr[row];
  }

  const UF_long l_nnz = l_ptr[n];
  const UF_long u_nnz = u_ptr[n];
  const UF_long input_nnz = input_ptr[n];
  UF_long *l_cols = l_nnz > 0u
    ? (UF_long *)malloc((size_t)l_nnz * sizeof(*l_cols)) : NULL;
  double **l_values = l_nnz > 0u
    ? (double **)malloc((size_t)l_nnz * sizeof(*l_values)) : NULL;
  double *l_row_values = l_nnz > 0u
    ? (double *)malloc((size_t)l_nnz * sizeof(*l_row_values)) : NULL;
  UF_long *u_cols = u_nnz > 0u
    ? (UF_long *)malloc((size_t)u_nnz * sizeof(*u_cols)) : NULL;
  double **u_values = u_nnz > 0u
    ? (double **)malloc((size_t)u_nnz * sizeof(*u_values)) : NULL;
  double *u_row_values = kls_aligned_double_values(u_nnz);
  UF_long *input_cols = input_nnz > 0u
    ? (UF_long *)malloc((size_t)input_nnz * sizeof(*input_cols)) : NULL;
  UF_long *input_pos = input_nnz > 0u
    ? (UF_long *)malloc((size_t)input_nnz * sizeof(*input_pos)) : NULL;
  UF_long *next = n > 0u ? (UF_long *)malloc((size_t)n * sizeof(*next))
                         : NULL;
  if ((l_nnz > 0u &&
       (l_cols == NULL || l_values == NULL || l_row_values == NULL)) ||
      (u_nnz > 0u &&
       (u_cols == NULL || u_values == NULL || u_row_values == NULL)) ||
      (input_nnz > 0u && (input_cols == NULL || input_pos == NULL)) ||
      (n > 0u && next == NULL)) {
    free(l_ptr);
    free(u_ptr);
    free(input_ptr);
    free(l_cols);
    free(l_values);
    free(l_row_values);
    free(u_cols);
    free(u_values);
    free(u_row_values);
    free(input_cols);
    free(input_pos);
    free(next);
    kls_row_first_refactor_seed_clear(seed);
    return 0;
  }

  if (n > 0u) {
    memcpy(next, l_ptr, (size_t)n * sizeof(*next));
  }
  for (UF_long p = 0; p < seed->l.count; ++p) {
    const UF_long row = seed->l.row[p];
    const UF_long dst = next[row]++;
    l_cols[dst] = seed->l.col[p];
    l_values[dst] = seed->l.numeric_value[p];
    l_row_values[dst] = seed->l.value[p];
  }
  if (n > 0u) {
    memcpy(next, u_ptr, (size_t)n * sizeof(*next));
  }
  for (UF_long p = 0; p < seed->u.count; ++p) {
    const UF_long row = seed->u.row[p];
    const UF_long dst = next[row]++;
    u_cols[dst] = seed->u.col[p];
    u_values[dst] = seed->u.numeric_value[p];
    u_row_values[dst] = seed->u.value[p];
  }
  if (n > 0u) {
    memcpy(next, input_ptr, (size_t)n * sizeof(*next));
  }
  for (UF_long p = 0; p < seed->input.count; ++p) {
    const UF_long row = seed->input.row[p];
    const UF_long dst = next[row]++;
    input_cols[dst] = seed->input.col[p];
    input_pos[dst] = seed->input.pos[p];
  }

  kls_row_first_refactor_seed_clear(seed);
  free_row_refactor_pattern(solver);
  if (!kls_finish_row_refactor_pattern_from_arrays(
        solver, l_ptr, l_cols, l_values, l_row_values,
        u_ptr, u_cols, u_values, u_row_values,
        input_ptr, input_cols, input_pos, next)) {
    return 0;
  }
  solver->row_refactor_values_ready = 1;
  solver->row_refactor_values_dirty = 0;
  solver->row_refactor_solve_direct_ready = 0;
  solver->row_refactor_solve_validated = 0;
  solver->kls_first_last_row_refactor_seeded_rows = n;
  solver->kls_first_row_refactor_seeded_row_count += n;
  return 1;
}

