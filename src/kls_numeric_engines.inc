static int kls_row_first_pipeline_compact_group_grow_stride(
  kls_row_first_pipeline_shared *shared,
  UF_long target_count,
  UF_long old_stride,
  UF_long new_stride) {
  if (shared == NULL || new_stride < old_stride) {
    return 0;
  }
  if (new_stride == old_stride) {
    return 1;
  }
  if (target_count != 0u && new_stride > UF_long_max / target_count) {
    return 0;
  }
  if (!kls_row_first_pipeline_reserve_compact_group_matrix(
        shared, target_count * new_stride)) {
    return 0;
  }
  for (UF_long t = target_count; t-- > 0u;) {
    double *value_dst = shared->compact_group_values + t * new_stride;
    double *value_src = shared->compact_group_values + t * old_stride;
    unsigned char *flag_dst = shared->compact_group_flags + t * new_stride;
    unsigned char *flag_src = shared->compact_group_flags + t * old_stride;
    if (old_stride > 0u) {
      memmove(value_dst, value_src,
              (size_t)old_stride * sizeof(*shared->compact_group_values));
      memmove(flag_dst, flag_src,
              (size_t)old_stride * sizeof(*shared->compact_group_flags));
    }
    memset(value_dst + old_stride, 0,
           (size_t)(new_stride - old_stride) *
             sizeof(*shared->compact_group_values));
    memset(flag_dst + old_stride, 0,
           (size_t)(new_stride - old_stride) *
             sizeof(*shared->compact_group_flags));
  }
  shared->compact_group_stride = new_stride;
  return 1;
}

static int kls_row_first_compact_group_add_col(
  kls_row_first_pipeline_shared *shared,
  UF_long col,
  UF_long *union_count_io) {
  if (shared == NULL || union_count_io == NULL ||
      shared->compact_group_mark == NULL ||
      shared->compact_group_pos == NULL ||
      col >= shared->ctx->nk) {
    return 0;
  }
  if (shared->compact_group_mark[col] ==
      shared->compact_group_generation) {
    return 1;
  }
  const UF_long pos = *union_count_io;
  if (pos == UF_long_max ||
      !kls_row_first_pipeline_reserve_compact_group_cols(shared,
                                                         pos + 1u)) {
    return 0;
  }
  shared->compact_group_mark[col] = shared->compact_group_generation;
  shared->compact_group_pos[col] = pos;
  shared->compact_group_cols[pos] = col;
  *union_count_io = pos + 1u;
  return 1;
}

static int kls_row_first_pipeline_compact_group_ensure_col(
  kls_row_first_pipeline_shared *shared,
  UF_long col) {
  if (shared == NULL || shared->ctx == NULL ||
      shared->compact_group_mark == NULL ||
      shared->compact_group_pos == NULL ||
      shared->compact_group_generation == 0u ||
      col >= shared->ctx->nk) {
    return 0;
  }
  if (shared->compact_group_mark[col] ==
      shared->compact_group_generation) {
    return 1;
  }
  if (shared->compact_group_union_count >=
      shared->compact_group_stride) {
    UF_long grown = shared->compact_group_stride == 0u
      ? 16u : shared->compact_group_stride;
    while (grown <= shared->compact_group_union_count) {
      if (grown > UF_long_max / 2u) {
        grown = shared->compact_group_union_count + 1u;
        break;
      }
      grown *= 2u;
    }
    if (!kls_row_first_pipeline_compact_group_grow_stride(
          shared, shared->compact_group_target_count,
          shared->compact_group_stride, grown)) {
      return 0;
    }
  }
  return kls_row_first_compact_group_add_col(
    shared, col, &shared->compact_group_union_count);
}

static void kls_row_first_pipeline_clear_sparse_group_output_cache(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  int overflow) {
  if (shared == NULL || !shared->compact_group_output_cache_active) {
    return;
  }
  if (shared->compact_group_slots != NULL &&
      shared->compact_window_states != NULL) {
    for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
      const int slot = shared->compact_group_slots[g];
      if (slot < 0 || slot >= shared->compact_window_count) {
        continue;
      }
      kls_row_first_compact_window_state *state =
        shared->compact_window_states + slot;
      if (state == NULL || !state->active || !state->grouped) {
        continue;
      }
      kls_row_first_compact_window_deferred_output_reset(state);
      (void)kls_row_first_compact_window_deferred_output_bump_generation(
        state);
    }
  }
  shared->compact_group_output_cache_active = 0;
  shared->compact_group_union_count = 0u;
  shared->compact_group_stride = 0u;
  if (trace != NULL) {
    kls_row_first_stats_add(
      &trace->compact_window_group_output_cache_disables, 1u);
    if (overflow) {
      kls_row_first_stats_add(
        &trace->compact_window_group_output_cache_overflows, 1u);
    }
  }
}

static int kls_row_first_pipeline_start_sparse_group_output_cache(
  kls_row_first_pipeline_shared *shared) {
  if (shared == NULL || !shared->compact_group_output_cache_enabled ||
      !shared->compact_group_sparse || !shared->compact_group_active ||
      shared->compact_group_target_count == 0u ||
      shared->compact_group_slots == NULL ||
      shared->compact_window_states == NULL ||
      shared->compact_group_mark == NULL ||
      shared->compact_group_pos == NULL ||
      shared->ctx == NULL) {
    return 0;
  }
  unsigned int generation = shared->compact_group_generation + 1u;
  if (generation == 0u) {
    memset(shared->compact_group_mark, 0,
           (size_t)shared->ctx->nk *
             sizeof(*shared->compact_group_mark));
    generation = 1u;
  }
  shared->compact_group_generation = generation;
  shared->compact_group_union_count = 0u;
  shared->compact_group_stride = 0u;
  shared->compact_group_output_cache_active = 1;
  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    const int slot = shared->compact_group_slots[g];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (state == NULL || !state->active || !state->grouped) {
      continue;
    }
    kls_row_first_compact_window_deferred_output_reset(state);
    (void)kls_row_first_compact_window_deferred_output_bump_generation(
      state);
  }
  return 1;
}

static int kls_row_first_pipeline_sparse_group_output_cache_ensure_col(
  kls_row_first_pipeline_shared *shared,
  UF_long col,
  kls_row_first_pipeline_trace *trace) {
  if (shared == NULL || !shared->compact_group_output_cache_active ||
      shared->compact_group_target_count == 0u ||
      shared->ctx == NULL ||
      col >= shared->ctx->nk) {
    return 0;
  }
  if (shared->compact_group_mark[col] ==
      shared->compact_group_generation) {
    return 1;
  }
  if (shared->compact_group_union_count == UF_long_max ||
      shared->compact_group_target_count >
        shared->compact_group_output_max_slots /
          (shared->compact_group_union_count + 1u)) {
    kls_row_first_pipeline_clear_sparse_group_output_cache(
      shared, trace, 1);
    return 0;
  }
  const UF_long old_union_count = shared->compact_group_union_count;
  if (!kls_row_first_pipeline_compact_group_ensure_col(shared, col)) {
    kls_row_first_pipeline_clear_sparse_group_output_cache(
      shared, trace, 1);
    return 0;
  }
  if (shared->compact_group_union_count != old_union_count + 1u) {
    return 1;
  }
  const UF_long pos = old_union_count;
  if (pos >= shared->compact_group_stride) {
    kls_row_first_pipeline_clear_sparse_group_output_cache(
      shared, trace, 1);
    return 0;
  }
  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    const UF_long at = g * shared->compact_group_stride + pos;
    if (at >= shared->compact_group_matrix_capacity) {
      kls_row_first_pipeline_clear_sparse_group_output_cache(
        shared, trace, 1);
      return 0;
    }
    shared->compact_group_values[at] = 0.0;
    shared->compact_group_flags[at] = 0u;
  }
  return 1;
}

static int kls_row_first_pipeline_sparse_group_output_cache_store(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long group_slot,
  UF_long col,
  double delta) {
  if (shared == NULL || !shared->compact_group_output_cache_active ||
      group_slot >= shared->compact_group_target_count) {
    return 0;
  }
  if (!kls_row_first_pipeline_sparse_group_output_cache_ensure_col(
        shared, col, trace) ||
      !shared->compact_group_output_cache_active ||
      shared->compact_group_stride == 0u) {
    return 0;
  }
  const UF_long pos = shared->compact_group_pos[col];
  if (pos >= shared->compact_group_union_count ||
      group_slot > UF_long_max / shared->compact_group_stride) {
    kls_row_first_pipeline_clear_sparse_group_output_cache(
      shared, trace, 1);
    return 0;
  }
  const UF_long at = group_slot * shared->compact_group_stride + pos;
  if (at >= shared->compact_group_matrix_capacity) {
    kls_row_first_pipeline_clear_sparse_group_output_cache(
      shared, trace, 1);
    return 0;
  }
  shared->compact_group_values[at] += delta;
  shared->compact_group_flags[at] = 1u;
  if (trace != NULL) {
    kls_row_first_stats_add(
      &trace->compact_window_group_output_cache_stores, 1u);
  }
  return 1;
}

static void kls_row_first_pipeline_sparse_group_output_cache_clear_state(
  kls_row_first_compact_window_state *state) {
  if (state == NULL) {
    return;
  }
  kls_row_first_compact_window_deferred_output_reset(state);
  (void)kls_row_first_compact_window_deferred_output_bump_generation(state);
}

static int kls_row_first_pipeline_sparse_group_output_cache_zero_row(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long group_slot) {
  if (shared == NULL || !shared->compact_group_output_cache_active ||
      shared->compact_group_stride == 0u) {
    return 1;
  }
  if (group_slot > UF_long_max / shared->compact_group_stride) {
    kls_row_first_pipeline_clear_sparse_group_output_cache(
      shared, trace, 1);
    return 0;
  }
  const UF_long row_begin = group_slot * shared->compact_group_stride;
  const UF_long row_end = row_begin + shared->compact_group_stride;
  if (row_end < row_begin ||
      !kls_row_first_pipeline_reserve_compact_group_matrix(
        shared, row_end)) {
    kls_row_first_pipeline_clear_sparse_group_output_cache(
      shared, trace, 1);
    return 0;
  }
  memset(shared->compact_group_values + row_begin, 0,
         (size_t)shared->compact_group_stride *
           sizeof(*shared->compact_group_values));
  memset(shared->compact_group_flags + row_begin, 0,
         (size_t)shared->compact_group_stride *
           sizeof(*shared->compact_group_flags));
  return 1;
}

static int kls_row_first_pipeline_sparse_group_output_cache_copy_row(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long dst,
  UF_long src) {
  if (shared == NULL || !shared->compact_group_output_cache_active ||
      shared->compact_group_stride == 0u || dst == src) {
    return 1;
  }
  if (dst > UF_long_max / shared->compact_group_stride ||
      src > UF_long_max / shared->compact_group_stride) {
    kls_row_first_pipeline_clear_sparse_group_output_cache(
      shared, trace, 1);
    return 0;
  }
  const UF_long dst_begin = dst * shared->compact_group_stride;
  const UF_long src_begin = src * shared->compact_group_stride;
  const UF_long needed =
    (dst > src ? dst : src) + 1u;
  if (needed == 0u ||
      needed > UF_long_max / shared->compact_group_stride ||
      !kls_row_first_pipeline_reserve_compact_group_matrix(
        shared, needed * shared->compact_group_stride)) {
    kls_row_first_pipeline_clear_sparse_group_output_cache(
      shared, trace, 1);
    return 0;
  }
  memmove(shared->compact_group_values + dst_begin,
          shared->compact_group_values + src_begin,
          (size_t)shared->compact_group_stride *
            sizeof(*shared->compact_group_values));
  memmove(shared->compact_group_flags + dst_begin,
          shared->compact_group_flags + src_begin,
          (size_t)shared->compact_group_stride *
            sizeof(*shared->compact_group_flags));
  return 1;
}

static int kls_row_first_pipeline_sparse_group_output_cache_remove_row(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long group_slot,
  UF_long old_count) {
  if (shared == NULL || !shared->compact_group_output_cache_active ||
      shared->compact_group_stride == 0u) {
    return 1;
  }
  if (group_slot >= old_count) {
    kls_row_first_pipeline_clear_sparse_group_output_cache(
      shared, trace, 1);
    return 0;
  }
  for (UF_long g = group_slot + 1u; g < old_count; ++g) {
    if (!kls_row_first_pipeline_sparse_group_output_cache_copy_row(
          shared, trace, g - 1u, g)) {
      return 0;
    }
  }
  return kls_row_first_pipeline_sparse_group_output_cache_zero_row(
    shared, trace, old_count - 1u);
}

static int kls_row_first_pipeline_materialize_sparse_group_output_cache_row(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long group_slot,
  kls_row_first_compact_window_state *state) {
  if (shared == NULL || state == NULL ||
      !shared->compact_group_output_cache_active ||
      !state->deferred_output_valid ||
      state->deferred_output_disabled ||
      group_slot >= shared->compact_group_target_count ||
      shared->compact_group_stride == 0u) {
    return 1;
  }
  const UF_long start_l_count = state->deferred_output_start_l_count;
  const UF_long end_l_count = state->deferred_output_l_count;
  kls_row_first_compact_window_deferred_output_reset(state);
  if (!kls_row_first_compact_window_deferred_output_bump_generation(state)) {
    return 0;
  }
  state->deferred_output_start_l_count = start_l_count;
  state->deferred_output_l_count = end_l_count;
  state->deferred_output_valid = 1;
  UF_long entries = 0u;
  for (UF_long u = 0; u < shared->compact_group_union_count; ++u) {
    const UF_long at = group_slot * shared->compact_group_stride + u;
    if (at >= shared->compact_group_matrix_capacity) {
      kls_row_first_pipeline_sparse_group_output_cache_clear_state(state);
      return 0;
    }
    if ((shared->compact_group_flags[at] & 1u) == 0u) {
      continue;
    }
    const UF_long col = shared->compact_group_cols[u];
    if (col < state->row || col >= shared->ctx->nk ||
        !kls_row_first_compact_window_deferred_output_insert(
          state, col, shared->compact_group_values[at],
          shared->compact_group_output_max_slots, NULL)) {
      kls_row_first_pipeline_sparse_group_output_cache_clear_state(state);
      return 0;
    }
    entries++;
  }
  if (trace != NULL) {
    kls_row_first_stats_add(
      &trace->compact_window_group_output_cache_applies, 1u);
    kls_row_first_stats_add(
      &trace->compact_window_group_output_cache_l_entries,
      end_l_count >= start_l_count ? end_l_count - start_l_count : 0u);
    kls_row_first_stats_add(
      &trace->compact_window_group_output_cache_entries, entries);
    kls_row_first_stats_add(
      &trace->compact_window_group_output_cache_cols,
      shared->compact_group_union_count);
  }
  return 1;
}

static UF_long kls_row_first_compact_dense_min_dep(
  const UF_long *cols,
  const unsigned char *flags,
  UF_long union_count,
  UF_long row) {
  if (cols == NULL || flags == NULL) {
    return KLS_KLU_EMPTY;
  }
  UF_long best = KLS_KLU_EMPTY;
  for (UF_long u = 0; u < union_count; ++u) {
    const UF_long col = cols[u];
    if ((flags[u] & 2u) != 0u && col < row &&
        (best == KLS_KLU_EMPTY || col < best)) {
      best = col;
    }
  }
  return best;
}

static int kls_row_first_pipeline_scatter_compact_dense_row(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  kls_row_first_compact_window_state *state,
  const UF_long *cols,
  const unsigned char *flags,
  const double *values,
  UF_long union_count) {
  if (shared == NULL || state == NULL || !state->active ||
      cols == NULL || flags == NULL || values == NULL) {
    return 1;
  }
  UF_long member_count = 0u;
  for (UF_long u = 0; u < union_count; ++u) {
    if ((flags[u] & 1u) != 0u) {
      member_count++;
    }
  }
  if (member_count > shared->compact_window_max_entries ||
      !kls_row_first_compact_window_reserve(
        state, member_count, shared->compact_window_max_entries)) {
    kls_row_first_pipeline_clear_compact_window_state(shared, state);
    if (trace != NULL) {
      kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
    }
    return 0;
  }

  state->pattern_count = 0u;
  state->heap_size = 0u;
  unsigned int index_generation = state->index_generation + 1u;
  if (index_generation == 0u) {
    if (state->index_mark != NULL && state->index_capacity > 0u) {
      memset(state->index_mark, 0,
             (size_t)state->index_capacity *
               sizeof(*state->index_mark));
    }
    index_generation = 1u;
  }
  state->index_generation = index_generation;
  for (UF_long u = 0; u < union_count; ++u) {
    if ((flags[u] & 1u) == 0u) {
      continue;
    }
    const UF_long col = cols[u];
    int found = 0;
    const UF_long slot =
      kls_row_first_compact_window_index_slot(state, col, &found);
    if (slot == KLS_KLU_EMPTY || found ||
        state->pattern_count >= state->pattern_capacity) {
      kls_row_first_pipeline_clear_compact_window_state(shared, state);
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
      return 0;
    }
    const UF_long at = state->pattern_count++;
    state->pattern[at] = col;
    state->values[at] = values[u];
    state->index_keys[slot] = col;
    state->index_pos[slot] = at;
    state->index_mark[slot] = state->index_generation;
    if ((flags[u] & 2u) != 0u && col < state->row) {
      kls_row_first_heap_push(state->heap, &state->heap_size, col);
    }
  }
  state->grouped = 0;
  state->group_member_count = 0u;
  if (state->active &&
      !kls_row_first_pipeline_register_compact_window_state(
        shared, state)) {
    if (trace != NULL) {
      kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
    }
    return 0;
  }
  return 1;
}

static int kls_row_first_pipeline_sparse_group_state_keeps_root(
  const kls_row_first_compact_window_state *state,
  UF_long root_dep) {
  return root_dep != KLS_KLU_EMPTY &&
         state != NULL && state->active && state->grouped &&
         state->heap_size > 0u &&
         state->heap[0] == root_dep &&
         state->heap[0] < state->row;
}

static void kls_row_first_pipeline_trace_delayed_group_surface(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long keep_root,
  int trace_nonmatching_only,
  int claim_surface) {
  if (shared == NULL || !shared->compact_group_active ||
      !shared->compact_group_sparse ||
      !shared->compact_window_delay_output_enabled ||
      shared->compact_group_slots == NULL ||
      shared->compact_window_states == NULL ||
      shared->ctx == NULL || shared->workspace == NULL ||
      shared->u_entries == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL ||
      shared->compact_union_mark == NULL ||
      shared->compact_union_pos == NULL) {
    return;
  }
  kls_row_first_pipeline_trace *target =
    trace != NULL ? trace
                  : (shared->trace_enabled ? &shared->trace_committed : NULL);
  if (target == NULL) {
    return;
  }

  unsigned int generation = shared->compact_union_generation + 1u;
  if (generation == 0u) {
    memset(shared->compact_union_mark, 0,
           (size_t)shared->ctx->nk *
             sizeof(*shared->compact_union_mark));
    generation = 1u;
  }
  shared->compact_union_generation = generation;

  UF_long states = 0u;
  UF_long deps = 0u;
  UF_long unique_deps = 0u;
  UF_long scan_entries = 0u;
  const UF_long nk = shared->ctx->nk;
  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    const int slot = shared->compact_group_slots[g];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (state == NULL || !state->active || !state->grouped ||
        state->row >= nk) {
      continue;
    }
    const int keeps_root =
      kls_row_first_pipeline_sparse_group_state_keeps_root(
        state, keep_root);
    if (trace_nonmatching_only && keeps_root) {
      continue;
    }
    if (state->delayed_output_replayed_l_count > state->l_count) {
      continue;
    }
    states++;
    for (UF_long lp = state->delayed_output_replayed_l_count;
         lp < state->l_count; ++lp) {
      const UF_long dep = state->l_cols[lp];
      if (dep >= state->row || dep >= nk) {
        continue;
      }
      const UF_long row_begin = shared->workspace->u_row_ptr[dep];
      const UF_long row_end = shared->workspace->u_row_end[dep];
      if (row_begin > row_end || row_end > shared->u_entries->count) {
        continue;
      }
      deps++;
      UF_long scan_begin = row_begin;
      if (shared->order_epoch == 0u) {
        scan_begin = kls_row_first_entries_lower_bound_col(
          shared->u_entries, row_begin, row_end, state->row);
      }
      if (row_end >= scan_begin) {
        kls_row_first_stats_add(&scan_entries, row_end - scan_begin);
      }
      if (shared->compact_union_mark[dep] != generation) {
        if (!kls_row_first_pipeline_reserve_compact_union_cols(
              shared, unique_deps + 1u)) {
          return;
        }
        shared->compact_union_mark[dep] = generation;
        shared->compact_union_pos[dep] = state->row;
        shared->compact_union_cols[unique_deps] = dep;
        unique_deps++;
      } else if (state->row < shared->compact_union_pos[dep]) {
        shared->compact_union_pos[dep] = state->row;
      }
    }
  }
  if (states == 0u || deps == 0u) {
    return;
  }

  UF_long group_scan_entries = 0u;
  for (UF_long p = 0; p < unique_deps; ++p) {
    const UF_long dep = shared->compact_union_cols[p];
    if (dep >= nk) {
      continue;
    }
    const UF_long row_begin = shared->workspace->u_row_ptr[dep];
    const UF_long row_end = shared->workspace->u_row_end[dep];
    if (row_begin > row_end || row_end > shared->u_entries->count) {
      continue;
    }
    UF_long scan_begin = row_begin;
    if (shared->order_epoch == 0u) {
      scan_begin = kls_row_first_entries_lower_bound_col(
        shared->u_entries, row_begin, row_end,
        shared->compact_union_pos[dep]);
    }
    if (row_end >= scan_begin) {
      kls_row_first_stats_add(&group_scan_entries, row_end - scan_begin);
    }
  }

  if (claim_surface) {
    kls_row_first_stats_add(
      &target->compact_window_claim_group_output_surfaces, 1u);
    kls_row_first_stats_add(
      &target->compact_window_claim_group_output_states, states);
    kls_row_first_stats_add(
      &target->compact_window_claim_group_output_deps, deps);
    kls_row_first_stats_add(
      &target->compact_window_claim_group_output_unique_deps, unique_deps);
    kls_row_first_stats_add(
      &target->compact_window_claim_group_output_duplicate_deps,
      deps >= unique_deps ? deps - unique_deps : 0u);
    kls_row_first_stats_add(
      &target->compact_window_claim_group_output_scan_entries,
      scan_entries);
    kls_row_first_stats_add(
      &target->compact_window_claim_group_output_group_scan_entries,
      group_scan_entries);
  } else {
    kls_row_first_stats_add(
      &target->compact_window_delayed_group_replay_surfaces, 1u);
    kls_row_first_stats_add(
      &target->compact_window_delayed_group_replay_states, states);
    kls_row_first_stats_add(
      &target->compact_window_delayed_group_replay_deps, deps);
    kls_row_first_stats_add(
      &target->compact_window_delayed_group_replay_unique_deps, unique_deps);
    kls_row_first_stats_add(
      &target->compact_window_delayed_group_replay_duplicate_deps,
      deps >= unique_deps ? deps - unique_deps : 0u);
    kls_row_first_stats_add(
      &target->compact_window_delayed_group_replay_scan_entries,
      scan_entries);
    kls_row_first_stats_add(
      &target->compact_window_delayed_group_replay_group_scan_entries,
      group_scan_entries);
  }
}

static void kls_row_first_pipeline_trace_claim_run_output_surface(
  kls_row_first_pipeline_shared *shared,
  const kls_row_first_pipeline_worker *worker,
  kls_row_first_pipeline_trace *trace,
  UF_long run_count) {
  if (shared == NULL || worker == NULL ||
      !shared->compact_window_delay_output_enabled ||
      run_count < 2u ||
      run_count > KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS ||
      shared->compact_window_states == NULL ||
      shared->ctx == NULL || shared->workspace == NULL ||
      shared->u_entries == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL ||
      shared->compact_union_mark == NULL ||
      shared->compact_union_pos == NULL) {
    return;
  }
  kls_row_first_pipeline_trace *target =
    trace != NULL ? trace
                  : (shared->trace_enabled ? &shared->trace_committed : NULL);
  if (target == NULL) {
    return;
  }

  unsigned int generation = shared->compact_union_generation + 1u;
  if (generation == 0u) {
    memset(shared->compact_union_mark, 0,
           (size_t)shared->ctx->nk *
             sizeof(*shared->compact_union_mark));
    generation = 1u;
  }
  shared->compact_union_generation = generation;

  const UF_long nk = shared->ctx->nk;
  UF_long states = 0u;
  UF_long deps = 0u;
  UF_long unique_deps = 0u;
  UF_long scan_entries = 0u;
  for (UF_long r = 0; r < run_count; ++r) {
    const int slot = worker->compact_claim_run_slots[r];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (state == NULL || !state->active ||
        state->pos != worker->compact_claim_run_pos[r] ||
        state->row >= nk ||
        state->delayed_output_replayed_l_count > state->l_count) {
      continue;
    }
    states++;
    for (UF_long lp = state->delayed_output_replayed_l_count;
         lp < state->l_count; ++lp) {
      const UF_long dep = state->l_cols[lp];
      if (dep >= state->row || dep >= nk) {
        continue;
      }
      const UF_long row_begin = shared->workspace->u_row_ptr[dep];
      const UF_long row_end = shared->workspace->u_row_end[dep];
      if (row_begin > row_end || row_end > shared->u_entries->count) {
        continue;
      }
      deps++;
      UF_long scan_begin = row_begin;
      if (shared->order_epoch == 0u) {
        scan_begin = kls_row_first_entries_lower_bound_col(
          shared->u_entries, row_begin, row_end, state->row);
      }
      if (row_end >= scan_begin) {
        kls_row_first_stats_add(&scan_entries, row_end - scan_begin);
      }
      if (shared->compact_union_mark[dep] != generation) {
        if (!kls_row_first_pipeline_reserve_compact_union_cols(
              shared, unique_deps + 1u)) {
          return;
        }
        shared->compact_union_mark[dep] = generation;
        shared->compact_union_pos[dep] = state->row;
        shared->compact_union_cols[unique_deps] = dep;
        unique_deps++;
      } else if (state->row < shared->compact_union_pos[dep]) {
        shared->compact_union_pos[dep] = state->row;
      }
    }
  }
  if (states == 0u || deps == 0u) {
    return;
  }

  UF_long group_scan_entries = 0u;
  for (UF_long p = 0; p < unique_deps; ++p) {
    const UF_long dep = shared->compact_union_cols[p];
    if (dep >= nk) {
      continue;
    }
    const UF_long row_begin = shared->workspace->u_row_ptr[dep];
    const UF_long row_end = shared->workspace->u_row_end[dep];
    if (row_begin > row_end || row_end > shared->u_entries->count) {
      continue;
    }
    UF_long scan_begin = row_begin;
    if (shared->order_epoch == 0u) {
      scan_begin = kls_row_first_entries_lower_bound_col(
        shared->u_entries, row_begin, row_end,
        shared->compact_union_pos[dep]);
    }
    if (row_end >= scan_begin) {
      kls_row_first_stats_add(&group_scan_entries, row_end - scan_begin);
    }
  }

  kls_row_first_stats_add(
    &target->compact_window_claim_run_output_surfaces, 1u);
  kls_row_first_stats_add(
    &target->compact_window_claim_run_output_states, states);
  kls_row_first_stats_add(
    &target->compact_window_claim_run_output_deps, deps);
  kls_row_first_stats_add(
    &target->compact_window_claim_run_output_unique_deps, unique_deps);
  kls_row_first_stats_add(
    &target->compact_window_claim_run_output_duplicate_deps,
    deps >= unique_deps ? deps - unique_deps : 0u);
  kls_row_first_stats_add(
    &target->compact_window_claim_run_output_scan_entries, scan_entries);
  kls_row_first_stats_add(
    &target->compact_window_claim_run_output_group_scan_entries,
    group_scan_entries);
}

static unsigned int kls_row_first_pipeline_next_compact_union_generation(
  kls_row_first_pipeline_shared *shared) {
  if (shared == NULL || shared->ctx == NULL ||
      shared->compact_union_mark == NULL) {
    return 0u;
  }
  unsigned int generation = shared->compact_union_generation + 1u;
  if (generation == 0u) {
    memset(shared->compact_union_mark, 0,
           (size_t)shared->ctx->nk *
             sizeof(*shared->compact_union_mark));
    generation = 1u;
  }
  shared->compact_union_generation = generation;
  return generation;
}

static int kls_row_first_pipeline_claim_span_trace_state_matches(
  const kls_row_first_pipeline_shared *shared,
  const kls_row_first_compact_window_state *state,
  UF_long wanted_pos,
  UF_long next_reserved,
  UF_long nk) {
  if (shared == NULL || state == NULL ||
      !state->active || !state->grouped ||
      state->row >= nk ||
      state->pos < wanted_pos ||
      state->delayed_output_replayed_l_count > state->l_count) {
    return 0;
  }
  if (state->pos - wanted_pos >=
      shared->compact_claim_span_trace_rows) {
    return 0;
  }
  return state->pos == wanted_pos || state->pos >= next_reserved;
}

static void kls_row_first_pipeline_trace_claim_span_output_surface(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long wanted_pos) {
  if (shared == NULL || !shared->compact_group_active ||
      !shared->compact_group_sparse ||
      !shared->compact_window_delay_output_enabled ||
      shared->compact_group_slots == NULL ||
      shared->compact_window_states == NULL ||
      shared->ctx == NULL || shared->workspace == NULL ||
      shared->u_entries == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL ||
      shared->compact_union_mark == NULL ||
      shared->compact_union_pos == NULL ||
      shared->compact_claim_span_trace_rows == 0u ||
      wanted_pos >= shared->ctx->nk) {
    return;
  }
  kls_row_first_pipeline_trace *target =
    trace != NULL ? trace
                  : (shared->trace_enabled ? &shared->trace_committed : NULL);
  if (target == NULL) {
    return;
  }

  const unsigned int generation =
    kls_row_first_pipeline_next_compact_union_generation(shared);
  if (generation == 0u) {
    return;
  }

  const UF_long nk = shared->ctx->nk;
  const UF_long next_reserved =
    (UF_long)atomic_load_explicit(&shared->next_pos, memory_order_acquire);
  UF_long states = 0u;
  UF_long deps = 0u;
  UF_long unique_deps = 0u;
  UF_long scan_entries = 0u;
  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    const int slot = shared->compact_group_slots[g];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (!kls_row_first_pipeline_claim_span_trace_state_matches(
          shared, state, wanted_pos, next_reserved, nk)) {
      continue;
    }
    states++;
    for (UF_long lp = state->delayed_output_replayed_l_count;
         lp < state->l_count; ++lp) {
      const UF_long dep = state->l_cols[lp];
      if (dep >= state->row || dep >= nk) {
        continue;
      }
      const UF_long row_begin = shared->workspace->u_row_ptr[dep];
      const UF_long row_end = shared->workspace->u_row_end[dep];
      if (row_begin > row_end || row_end > shared->u_entries->count) {
        continue;
      }
      deps++;
      UF_long scan_begin = row_begin;
      if (shared->order_epoch == 0u) {
        scan_begin = kls_row_first_entries_lower_bound_col(
          shared->u_entries, row_begin, row_end, state->row);
      }
      if (row_end >= scan_begin) {
        kls_row_first_stats_add(&scan_entries, row_end - scan_begin);
      }
      if (shared->compact_union_mark[dep] != generation) {
        if (!kls_row_first_pipeline_reserve_compact_union_cols(
              shared, unique_deps + 1u)) {
          return;
        }
        shared->compact_union_mark[dep] = generation;
        shared->compact_union_pos[dep] = state->row;
        shared->compact_union_cols[unique_deps] = dep;
        unique_deps++;
      } else if (state->row < shared->compact_union_pos[dep]) {
        shared->compact_union_pos[dep] = state->row;
      }
    }
  }
  if (states == 0u || deps == 0u) {
    return;
  }

  UF_long group_scan_entries = 0u;
  for (UF_long p = 0; p < unique_deps; ++p) {
    const UF_long dep = shared->compact_union_cols[p];
    if (dep >= nk) {
      continue;
    }
    const UF_long row_begin = shared->workspace->u_row_ptr[dep];
    const UF_long row_end = shared->workspace->u_row_end[dep];
    if (row_begin > row_end || row_end > shared->u_entries->count) {
      continue;
    }
    UF_long scan_begin = row_begin;
    if (shared->order_epoch == 0u) {
      scan_begin = kls_row_first_entries_lower_bound_col(
        shared->u_entries, row_begin, row_end,
        shared->compact_union_pos[dep]);
    }
    if (row_end >= scan_begin) {
      kls_row_first_stats_add(&group_scan_entries, row_end - scan_begin);
    }
  }

  UF_long output_value_entries = 0u;
  UF_long output_state_col_slots = 0u;
  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    const int slot = shared->compact_group_slots[g];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (!kls_row_first_pipeline_claim_span_trace_state_matches(
          shared, state, wanted_pos, next_reserved, nk)) {
      continue;
    }
    const unsigned int state_generation =
      kls_row_first_pipeline_next_compact_union_generation(shared);
    if (state_generation == 0u) {
      return;
    }
    for (UF_long lp = state->delayed_output_replayed_l_count;
         lp < state->l_count; ++lp) {
      const UF_long dep = state->l_cols[lp];
      if (dep >= state->row || dep >= nk) {
        continue;
      }
      const UF_long row_begin = shared->workspace->u_row_ptr[dep];
      const UF_long row_end = shared->workspace->u_row_end[dep];
      if (row_begin > row_end || row_end > shared->u_entries->count) {
        continue;
      }
      UF_long scan_begin = row_begin;
      if (shared->order_epoch == 0u) {
        scan_begin = kls_row_first_entries_lower_bound_col(
          shared->u_entries, row_begin, row_end, state->row);
      }
      for (UF_long up = scan_begin; up < row_end; ++up) {
        const UF_long col = shared->u_entries->col[up];
        if (col >= nk || col < state->row) {
          continue;
        }
        kls_row_first_stats_add(&output_value_entries, 1u);
        if (shared->compact_union_mark[col] != state_generation) {
          shared->compact_union_mark[col] = state_generation;
          kls_row_first_stats_add(&output_state_col_slots, 1u);
        }
      }
    }
  }

  const unsigned int col_generation =
    kls_row_first_pipeline_next_compact_union_generation(shared);
  if (col_generation == 0u) {
    return;
  }
  UF_long unique_output_cols = 0u;
  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    const int slot = shared->compact_group_slots[g];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (!kls_row_first_pipeline_claim_span_trace_state_matches(
          shared, state, wanted_pos, next_reserved, nk)) {
      continue;
    }
    for (UF_long lp = state->delayed_output_replayed_l_count;
         lp < state->l_count; ++lp) {
      const UF_long dep = state->l_cols[lp];
      if (dep >= state->row || dep >= nk) {
        continue;
      }
      const UF_long row_begin = shared->workspace->u_row_ptr[dep];
      const UF_long row_end = shared->workspace->u_row_end[dep];
      if (row_begin > row_end || row_end > shared->u_entries->count) {
        continue;
      }
      UF_long scan_begin = row_begin;
      if (shared->order_epoch == 0u) {
        scan_begin = kls_row_first_entries_lower_bound_col(
          shared->u_entries, row_begin, row_end, state->row);
      }
      for (UF_long up = scan_begin; up < row_end; ++up) {
        const UF_long col = shared->u_entries->col[up];
        if (col >= nk || col < state->row) {
          continue;
        }
        if (shared->compact_union_mark[col] != col_generation) {
          if (!kls_row_first_pipeline_reserve_compact_union_cols(
                shared, unique_output_cols + 1u)) {
            return;
          }
          shared->compact_union_mark[col] = col_generation;
          shared->compact_union_cols[unique_output_cols] = col;
          unique_output_cols++;
        }
      }
    }
  }

  UF_long panel_slots = 0u;
  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    const int slot = shared->compact_group_slots[g];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (!kls_row_first_pipeline_claim_span_trace_state_matches(
          shared, state, wanted_pos, next_reserved, nk)) {
      continue;
    }
    for (UF_long p = 0; p < unique_output_cols; ++p) {
      const UF_long col = shared->compact_union_cols[p];
      if (col >= state->row) {
        kls_row_first_stats_add(&panel_slots, 1u);
      }
    }
  }

  UF_long dense_slots = 0u;
  if (states > 0u && unique_output_cols > 0u) {
    dense_slots = states > UF_long_max / unique_output_cols
      ? UF_long_max : states * unique_output_cols;
  }

  kls_row_first_stats_add(
    &target->compact_window_claim_span_output_surfaces, 1u);
  kls_row_first_stats_add(
    &target->compact_window_claim_span_output_states, states);
  kls_row_first_stats_add(
    &target->compact_window_claim_span_output_deps, deps);
  kls_row_first_stats_add(
    &target->compact_window_claim_span_output_unique_deps, unique_deps);
  kls_row_first_stats_add(
    &target->compact_window_claim_span_output_duplicate_deps,
    deps >= unique_deps ? deps - unique_deps : 0u);
  kls_row_first_stats_add(
    &target->compact_window_claim_span_output_scan_entries, scan_entries);
  kls_row_first_stats_add(
    &target->compact_window_claim_span_output_group_scan_entries,
    group_scan_entries);
  kls_row_first_stats_add(
    &target->compact_window_claim_span_output_value_entries,
    output_value_entries);
  kls_row_first_stats_add(
    &target->compact_window_claim_span_output_state_col_slots,
    output_state_col_slots);
  kls_row_first_stats_add(
    &target->compact_window_claim_span_output_unique_cols,
    unique_output_cols);
  kls_row_first_stats_add(
    &target->compact_window_claim_span_output_panel_slots,
    panel_slots);
  kls_row_first_stats_add(
    &target->compact_window_claim_span_output_dense_slots,
    dense_slots);
  kls_row_first_stats_max(
    &target->compact_window_claim_span_output_max_states, states);
  kls_row_first_stats_max(
    &target->compact_window_claim_span_output_max_unique_cols,
    unique_output_cols);
}

static void kls_row_first_pipeline_trace_claim_group_run_surface(
  kls_row_first_pipeline_shared *shared,
  UF_long wanted_pos) {
  if (shared == NULL || !shared->trace_enabled ||
      !shared->compact_group_active ||
      shared->compact_group_slots == NULL ||
      shared->compact_window_states == NULL ||
      shared->compact_pos_slots == NULL ||
      shared->ctx == NULL ||
      wanted_pos >= shared->ctx->nk) {
    return;
  }

  UF_long states = 0u;
  UF_long near64 = 0u;
  UF_long near512 = 0u;
  const UF_long next_reserved =
    (UF_long)atomic_load_explicit(&shared->next_pos, memory_order_acquire);
  UF_long unreserved_near64 = 0u;
  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    const int slot = shared->compact_group_slots[g];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (state == NULL || !state->active || !state->grouped) {
      continue;
    }
    states++;
    if (state->pos >= wanted_pos) {
      const UF_long delta = state->pos - wanted_pos;
      if (delta < 64u) {
        near64++;
        if (state->pos >= next_reserved) {
          unreserved_near64++;
        }
      }
      if (delta < 512u) {
        near512++;
      }
    }
  }

  UF_long consecutive = 0u;
  while (consecutive < states) {
    const UF_long pos = wanted_pos + consecutive;
    if (pos < wanted_pos || pos >= shared->ctx->nk) {
      break;
    }
    const int slot = shared->compact_pos_slots[pos];
    if (slot < 0 || slot >= shared->compact_window_count) {
      break;
    }
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (state == NULL || !state->active || !state->grouped ||
        state->pos != pos) {
      break;
    }
    consecutive++;
  }

  UF_long stealable = 0u;
  if (next_reserved == wanted_pos + 1u) {
    while (stealable + 1u < states) {
      const UF_long pos = next_reserved + stealable;
      if (pos < next_reserved || pos >= shared->ctx->nk) {
        break;
      }
      const int slot = shared->compact_pos_slots[pos];
      if (slot < 0 || slot >= shared->compact_window_count) {
        break;
      }
      const kls_row_first_compact_window_state *state =
        shared->compact_window_states + slot;
      if (state == NULL || !state->active || !state->grouped ||
          state->pos != pos) {
        break;
      }
      stealable++;
    }
  }

  kls_row_first_pipeline_trace *trace = &shared->trace_committed;
  kls_row_first_stats_add(
    &trace->compact_window_claim_group_run_probes, 1u);
  kls_row_first_stats_add(
    &trace->compact_window_claim_group_run_states, states);
  kls_row_first_stats_add(
    &trace->compact_window_claim_group_run_consecutive, consecutive);
  kls_row_first_stats_add(
    &trace->compact_window_claim_group_run_near64, near64);
  kls_row_first_stats_add(
    &trace->compact_window_claim_group_run_near512, near512);
  kls_row_first_stats_max(
    &trace->compact_window_claim_group_run_max_consecutive, consecutive);
  kls_row_first_stats_add(
    &trace->compact_window_claim_group_run_stealable, stealable);
  kls_row_first_stats_max(
    &trace->compact_window_claim_group_run_max_stealable, stealable);
  kls_row_first_stats_add(
    &trace->compact_window_claim_group_run_unreserved_near64,
    unreserved_near64);
}

static int kls_row_first_pipeline_claim_run_contains_slot(
  const kls_row_first_pipeline_worker *worker,
  UF_long run_count,
  int slot) {
  if (worker == NULL || slot < 0 ||
      run_count > KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS) {
    return 0;
  }
  for (UF_long r = 0; r < run_count; ++r) {
    if (worker->compact_claim_run_slots[r] == slot) {
      return 1;
    }
  }
  return 0;
}

static UF_long kls_row_first_pipeline_prepare_sparse_claim_run(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_worker *worker,
  kls_row_first_pipeline_trace *trace,
  UF_long wanted_pos) {
  if (shared == NULL || worker == NULL ||
      !shared->compact_claim_run_enabled ||
      !shared->compact_group_active ||
      !shared->compact_group_sparse ||
      shared->compact_group_target_count < 2u ||
      shared->compact_claim_run_max_rows < 2u ||
      shared->compact_group_slots == NULL ||
      shared->compact_pos_slots == NULL ||
      shared->compact_window_states == NULL ||
      shared->ctx == NULL || wanted_pos >= shared->ctx->nk) {
    return 0u;
  }
  kls_row_first_pipeline_clear_sparse_group_output_cache(
    shared, trace, 0);

  UF_long run_limit = shared->compact_claim_run_max_rows;
  if (run_limit > KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS) {
    run_limit = KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS;
  }
  if (run_limit > shared->compact_group_target_count) {
    run_limit = shared->compact_group_target_count;
  }

  UF_long run_count = 0u;
  while (run_count < run_limit) {
    const UF_long pos = wanted_pos + run_count;
    if (pos < wanted_pos || pos >= shared->ctx->nk) {
      break;
    }
    const int slot = shared->compact_pos_slots[pos];
    if (slot < 0 || slot >= shared->compact_window_count) {
      break;
    }
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (state == NULL || !state->active || !state->grouped ||
        state->pos != pos) {
      break;
    }
    worker->compact_claim_run_slots[run_count] = slot;
    worker->compact_claim_run_pos[run_count] = pos;
    run_count++;
  }
  if (run_count < 2u) {
    return 0u;
  }
  const int claim_stream_owner_requested =
    shared->compact_claim_stream_owner_enabled;
  if (claim_stream_owner_requested &&
      !kls_row_first_pipeline_worker_reserve_claim_stream_owner(
        worker, run_count, 0u)) {
    return 0u;
  }

  if (wanted_pos + run_count < wanted_pos) {
    return 0u;
  }
  unsigned long expected = (unsigned long)(wanted_pos + 1u);
  const unsigned long desired = (unsigned long)(wanted_pos + run_count);
  if (!atomic_compare_exchange_strong_explicit(
        &shared->next_pos, &expected, desired,
        memory_order_acq_rel, memory_order_acquire)) {
    return 0u;
  }

  const UF_long old_count = shared->compact_group_target_count;
  UF_long dst = 0u;
  for (UF_long g = 0; g < old_count; ++g) {
    const int slot = shared->compact_group_slots[g];
    if (slot < 0 || slot >= shared->compact_window_count) {
      shared->compact_group_slots[g] = -1;
      continue;
    }
    kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (kls_row_first_pipeline_claim_run_contains_slot(
          worker, run_count, slot)) {
      state->grouped = 0;
      state->group_member_count = 0u;
      state->bucket_dep = KLS_KLU_EMPTY;
      state->bucket_next = -1;
      state->bucket_linked = 0;
      shared->compact_group_slots[g] = -1;
      continue;
    }
    shared->compact_group_slots[dst++] = slot;
  }
  for (UF_long g = dst; g < old_count; ++g) {
    shared->compact_group_slots[g] = -1;
  }

  if (dst < 2u) {
    for (UF_long g = 0; g < dst; ++g) {
      const int slot = shared->compact_group_slots[g];
      shared->compact_group_slots[g] = -1;
      if (slot < 0 || slot >= shared->compact_window_count) {
        continue;
      }
      kls_row_first_compact_window_state *state =
        shared->compact_window_states + slot;
      if (!state->active || !state->grouped) {
        continue;
      }
      state->grouped = 0;
      state->group_member_count = 0u;
      state->bucket_dep = KLS_KLU_EMPTY;
      state->bucket_next = -1;
      state->bucket_linked = 0;
      if (!kls_row_first_pipeline_register_compact_window_state(
            shared, state) &&
          trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
    }
    shared->compact_group_active = 0;
    shared->compact_group_target_count = 0u;
    shared->compact_group_union_count = 0u;
    shared->compact_group_stride = 0u;
    shared->compact_group_dep = KLS_KLU_EMPTY;
    shared->compact_group_sparse = 0;
  } else {
    shared->compact_group_target_count = dst;
    shared->compact_group_union_count = 0u;
    shared->compact_group_stride = 0u;
  }

  worker->compact_claim_run_count = run_count;
  worker->compact_claim_run_next = 1u;
  worker->compact_claim_stream_owner_active = 0;
  worker->compact_claim_stream_owner_rows = 0u;
  worker->compact_claim_stream_owner_cols_count = 0u;
  if (claim_stream_owner_requested) {
    memset(worker->compact_claim_stream_owner_replay_entries, 0,
           (size_t)run_count *
             sizeof(*worker->compact_claim_stream_owner_replay_entries));
    for (UF_long r = 0; r < run_count; ++r) {
      const int slot = worker->compact_claim_run_slots[r];
      const kls_row_first_compact_window_state *state =
        slot >= 0 && slot < shared->compact_window_count
          ? shared->compact_window_states + slot : NULL;
      const UF_long start_l_count =
        state != NULL && state->active &&
            state->pos == worker->compact_claim_run_pos[r]
          ? state->l_count : 0u;
      worker->compact_claim_stream_owner_start_l_counts[r] = start_l_count;
      worker->compact_claim_stream_owner_l_counts[r] = start_l_count;
    }
    worker->compact_claim_stream_owner_rows = run_count;
    worker->compact_claim_stream_owner_cols_count = 0u;
    worker->compact_claim_stream_owner_active = 1;
  }
  if (trace != NULL) {
    kls_row_first_stats_add(&trace->compact_window_claim_run_reservations,
                            1u);
    kls_row_first_stats_add(&trace->compact_window_claim_run_rows,
                            run_count);
  }
  kls_row_first_pipeline_trace_claim_run_output_surface(
    shared, worker, trace, run_count);
  return run_count;
}

static int kls_row_first_pipeline_state_has_shared_span_owner(
  const kls_row_first_pipeline_shared *shared,
  const kls_row_first_compact_window_state *state) {
  return shared != NULL && state != NULL &&
         shared->compact_span_shared_owner_enabled &&
         shared->compact_span_shared_owner_active &&
         state->compact_span_shared_owner_generation != 0u &&
         state->compact_span_shared_owner_generation ==
           shared->compact_span_shared_owner_generation &&
         state->compact_span_shared_owner_row <
           shared->compact_span_shared_owner_rows &&
         state->compact_span_shared_owner_start_l_count <=
           state->compact_span_shared_owner_l_count &&
         state->compact_span_shared_owner_l_count <= state->l_count;
}

static UF_long kls_row_first_pipeline_count_active_shared_span_owner_rows(
  const kls_row_first_pipeline_shared *shared,
  int require_nonprefix_claimable) {
  if (shared == NULL || !shared->compact_span_shared_owner_enabled ||
      !shared->compact_span_shared_owner_active ||
      shared->compact_span_shared_owner_generation == 0u ||
      shared->compact_window_states == NULL ||
      shared->compact_window_count <= 0) {
    return 0u;
  }
  UF_long remaining = 0u;
  for (int slot = 0; slot < shared->compact_window_count; ++slot) {
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (state == NULL || !state->active ||
        state->compact_span_shared_owner_generation !=
          shared->compact_span_shared_owner_generation ||
        state->compact_span_shared_owner_row >=
          shared->compact_span_shared_owner_rows ||
        state->compact_span_shared_owner_start_l_count >
          state->compact_span_shared_owner_l_count ||
        state->compact_span_shared_owner_l_count > state->l_count) {
      continue;
    }
    if (require_nonprefix_claimable &&
        state->delayed_output_replayed_l_count !=
          state->compact_span_shared_owner_start_l_count) {
      continue;
    }
    remaining++;
  }
  return remaining;
}

static void kls_row_first_pipeline_trace_span_owner_payoff_skip(
  kls_row_first_pipeline_trace *trace,
  UF_long rows,
  UF_long entries,
  UF_long scan_entries) {
  if (trace == NULL) {
    return;
  }
  kls_row_first_stats_add(
    &trace->compact_window_span_owner_payoff_skips, 1u);
  kls_row_first_stats_add(
    &trace->compact_window_span_owner_payoff_skip_rows, rows);
  kls_row_first_stats_add(
    &trace->compact_window_span_owner_payoff_skip_entries, entries);
  kls_row_first_stats_add(
    &trace->compact_window_span_owner_payoff_skip_scan_entries,
    scan_entries);
}

static int kls_row_first_pipeline_span_owner_payoff_allows(
  const kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long owner_rows,
  UF_long replay_entries,
  UF_long scan_entries,
  UF_long min_rows) {
  if (shared == NULL) {
    return 0;
  }
  if (min_rows > 0u && owner_rows < min_rows) {
    kls_row_first_pipeline_trace_span_owner_payoff_skip(
      trace, owner_rows, replay_entries, scan_entries);
    return 0;
  }
  if (replay_entries == 0u) {
    kls_row_first_pipeline_trace_span_owner_payoff_skip(
      trace, owner_rows, replay_entries, scan_entries);
    return 0;
  }
  if (shared->compact_span_owner_min_entries_per_scan > 0u &&
      scan_entries > 0u) {
    const UF_long ratio = shared->compact_span_owner_min_entries_per_scan;
    const UF_long required =
      scan_entries > UF_long_max / ratio ? UF_long_max
                                          : scan_entries * ratio;
    if (replay_entries < required) {
      kls_row_first_pipeline_trace_span_owner_payoff_skip(
        trace, owner_rows, replay_entries, scan_entries);
      return 0;
    }
  }
  return 1;
}

static int kls_row_first_pipeline_count_span_owner_replay_entries(
  const kls_row_first_pipeline_shared *shared,
  const int *owner_slots,
  const UF_long *owner_l_counts,
  UF_long owner_count,
  UF_long unique_deps,
  unsigned int col_generation,
  UF_long *replay_entries_out) {
  if (replay_entries_out != NULL) {
    *replay_entries_out = 0u;
  }
  if (shared == NULL || owner_slots == NULL || replay_entries_out == NULL ||
      shared->compact_window_states == NULL ||
      shared->compact_batch_positions == NULL ||
      shared->compact_replay_min_rows == NULL ||
      shared->compact_replay_next == NULL ||
      shared->compact_replay_lpos == NULL ||
      shared->compact_replay_slots == NULL ||
      shared->compact_union_cols == NULL ||
      shared->compact_union_mark == NULL ||
      shared->workspace == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL ||
      shared->u_entries == NULL || shared->ctx == NULL) {
    return 0;
  }
  UF_long replay_entries = 0u;
  for (UF_long u = 0u; u < unique_deps; ++u) {
    const UF_long dep = shared->compact_union_cols[u];
    if (dep >= shared->ctx->nk) {
      return 0;
    }
    const UF_long row_begin = shared->workspace->u_row_ptr[dep];
    const UF_long row_end = shared->workspace->u_row_end[dep];
    if (row_begin > row_end || row_end > shared->u_entries->count) {
      return 0;
    }
    UF_long scan_begin = row_begin;
    if (shared->order_epoch == 0u) {
      scan_begin = kls_row_first_entries_lower_bound_col(
        shared->u_entries, row_begin, row_end,
        shared->compact_replay_min_rows[u]);
    }
    for (UF_long up = scan_begin; up < row_end; ++up) {
      const UF_long col = shared->u_entries->col[up];
      if (col <= dep || col >= shared->ctx->nk) {
        return 0;
      }
      if (shared->compact_union_mark[col] != col_generation) {
        continue;
      }
      for (UF_long at = shared->compact_batch_positions[u];
           at != KLS_KLU_EMPTY;
           at = shared->compact_replay_next[at]) {
        const int row_slot = shared->compact_replay_slots[at];
        if (row_slot < 0 || (UF_long)row_slot >= owner_count) {
          continue;
        }
        const int slot = owner_slots[row_slot];
        if (slot < 0 || slot >= shared->compact_window_count) {
          continue;
        }
        const kls_row_first_compact_window_state *state =
          shared->compact_window_states + slot;
        const UF_long lp = shared->compact_replay_lpos[at];
        const UF_long l_limit =
          owner_l_counts != NULL ? owner_l_counts[row_slot]
                                 : (state != NULL ? state->l_count : 0u);
        if (state == NULL || !state->active || !state->grouped ||
            lp >= l_limit || col < state->row) {
          continue;
        }
        kls_row_first_stats_add(&replay_entries, 1u);
      }
    }
  }
  *replay_entries_out = replay_entries;
  return 1;
}

static int kls_row_first_pipeline_fill_span_owner_sparse_accum_values(
  kls_row_first_pipeline_shared *shared,
  const int *owner_slots,
  const UF_long *owner_l_counts,
  UF_long owner_count,
  UF_long unique_deps,
  unsigned int col_generation,
  UF_long unique_cols,
  UF_long expected_replay_entries,
  UF_long *storage_entries_out) {
  if (storage_entries_out != NULL) {
    *storage_entries_out = 0u;
  }
  if (shared == NULL || owner_slots == NULL || owner_l_counts == NULL ||
      storage_entries_out == NULL ||
      owner_count > KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS ||
      unique_cols == 0u ||
      unique_cols > (UF_long)(SIZE_MAX / sizeof(UF_long)) ||
      shared->compact_window_states == NULL ||
      shared->compact_batch_positions == NULL ||
      shared->compact_replay_min_rows == NULL ||
      shared->compact_replay_next == NULL ||
      shared->compact_replay_lpos == NULL ||
      shared->compact_replay_slots == NULL ||
      shared->compact_union_cols == NULL ||
      shared->compact_union_mark == NULL ||
      shared->compact_union_pos == NULL ||
      shared->workspace == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL ||
      shared->u_entries == NULL || shared->ctx == NULL) {
    return 0;
  }
  UF_long *col_to_entry =
    (UF_long *)malloc((size_t)unique_cols * sizeof(*col_to_entry));
  UF_long *touched =
    (UF_long *)malloc((size_t)unique_cols * sizeof(*touched));
  if (col_to_entry == NULL || touched == NULL) {
    free(col_to_entry);
    free(touched);
    return 0;
  }
  for (UF_long c = 0u; c < unique_cols; ++c) {
    col_to_entry[c] = KLS_KLU_EMPTY;
  }
  UF_long row_cells[KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS];
  UF_long row_replay_entries[KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS];
  UF_long total_cells = 0u;
  UF_long total_replay_entries = 0u;
  int ok = 1;

  for (UF_long r = 0u; r < owner_count && ok; ++r) {
    row_cells[r] = 0u;
    row_replay_entries[r] = 0u;
    UF_long touched_count = 0u;
    for (UF_long u = 0u; u < unique_deps && ok; ++u) {
      const UF_long dep = shared->compact_union_cols[u];
      if (dep >= shared->ctx->nk) {
        ok = 0;
        break;
      }
      const UF_long row_begin = shared->workspace->u_row_ptr[dep];
      const UF_long row_end = shared->workspace->u_row_end[dep];
      if (row_begin > row_end || row_end > shared->u_entries->count) {
        ok = 0;
        break;
      }
      UF_long scan_begin = row_begin;
      if (shared->order_epoch == 0u) {
        scan_begin = kls_row_first_entries_lower_bound_col(
          shared->u_entries, row_begin, row_end,
          shared->compact_replay_min_rows[u]);
      }
      for (UF_long up = scan_begin; up < row_end && ok; ++up) {
        const UF_long col = shared->u_entries->col[up];
        if (col <= dep || col >= shared->ctx->nk) {
          ok = 0;
          break;
        }
        if (shared->compact_union_mark[col] != col_generation) {
          continue;
        }
        const UF_long col_pos = shared->compact_union_pos[col];
        if (col_pos >= unique_cols) {
          ok = 0;
          break;
        }
        for (UF_long at = shared->compact_batch_positions[u];
             at != KLS_KLU_EMPTY;
             at = shared->compact_replay_next[at]) {
          const int row_slot = shared->compact_replay_slots[at];
          if (row_slot < 0 || (UF_long)row_slot != r) {
            continue;
          }
          const int slot = owner_slots[row_slot];
          if (slot < 0 || slot >= shared->compact_window_count) {
            continue;
          }
          const kls_row_first_compact_window_state *state =
            shared->compact_window_states + slot;
          const UF_long lp = shared->compact_replay_lpos[at];
          if (state == NULL || !state->active || !state->grouped ||
              lp >= owner_l_counts[row_slot] || col < state->row) {
            continue;
          }
          kls_row_first_stats_add(row_replay_entries + r, 1u);
          if (col_to_entry[col_pos] == KLS_KLU_EMPTY) {
            col_to_entry[col_pos] = row_cells[r];
            touched[touched_count++] = col_pos;
            kls_row_first_stats_add(row_cells + r, 1u);
          }
        }
      }
    }
    for (UF_long t = 0u; t < touched_count; ++t) {
      col_to_entry[touched[t]] = KLS_KLU_EMPTY;
    }
    if (total_cells > UF_long_max - row_cells[r] ||
        total_replay_entries > UF_long_max - row_replay_entries[r]) {
      ok = 0;
      break;
    }
    total_cells += row_cells[r];
    total_replay_entries += row_replay_entries[r];
  }

  if (!ok || total_replay_entries != expected_replay_entries ||
      !kls_row_first_pipeline_reserve_shared_span_owner_sparse(
        shared, owner_count, total_cells)) {
    free(col_to_entry);
    free(touched);
    return 0;
  }

  UF_long offset = 0u;
  for (UF_long r = 0u; r < owner_count; ++r) {
    shared->compact_span_shared_owner_sparse_row_ptr[r] = offset;
    if (offset > UF_long_max - row_cells[r]) {
      free(col_to_entry);
      free(touched);
      return 0;
    }
    offset += row_cells[r];
    shared->compact_span_shared_owner_replay_entries[r] =
      row_replay_entries[r];
  }
  shared->compact_span_shared_owner_sparse_row_ptr[owner_count] = offset;
  if (offset != total_cells ||
      total_cells > shared->compact_span_shared_owner_sparse_entry_capacity) {
    free(col_to_entry);
    free(touched);
    return 0;
  }

  for (UF_long r = 0u; r < owner_count && ok; ++r) {
    UF_long cursor =
      shared->compact_span_shared_owner_sparse_row_ptr[r];
    const UF_long row_end_slot =
      shared->compact_span_shared_owner_sparse_row_ptr[r + 1u];
    UF_long touched_count = 0u;
    for (UF_long u = 0u; u < unique_deps && ok; ++u) {
      const UF_long dep = shared->compact_union_cols[u];
      const UF_long row_begin = shared->workspace->u_row_ptr[dep];
      const UF_long row_end = shared->workspace->u_row_end[dep];
      UF_long scan_begin = row_begin;
      if (shared->order_epoch == 0u) {
        scan_begin = kls_row_first_entries_lower_bound_col(
          shared->u_entries, row_begin, row_end,
          shared->compact_replay_min_rows[u]);
      }
      for (UF_long up = scan_begin; up < row_end && ok; ++up) {
        const UF_long col = shared->u_entries->col[up];
        if (col <= dep || col >= shared->ctx->nk) {
          ok = 0;
          break;
        }
        if (shared->compact_union_mark[col] != col_generation) {
          continue;
        }
        const UF_long col_pos = shared->compact_union_pos[col];
        if (col_pos >= unique_cols) {
          ok = 0;
          break;
        }
        const double uvalue = shared->u_entries->value[up];
        for (UF_long at = shared->compact_batch_positions[u];
             at != KLS_KLU_EMPTY;
             at = shared->compact_replay_next[at]) {
          const int row_slot = shared->compact_replay_slots[at];
          if (row_slot < 0 || (UF_long)row_slot != r) {
            continue;
          }
          const int slot = owner_slots[row_slot];
          if (slot < 0 || slot >= shared->compact_window_count) {
            continue;
          }
          const kls_row_first_compact_window_state *state =
            shared->compact_window_states + slot;
          const UF_long lp = shared->compact_replay_lpos[at];
          if (state == NULL || !state->active || !state->grouped ||
              lp >= owner_l_counts[row_slot] || col < state->row) {
            continue;
          }
          UF_long dst = col_to_entry[col_pos];
          if (dst == KLS_KLU_EMPTY) {
            if (cursor >= row_end_slot) {
              ok = 0;
              break;
            }
            dst = cursor++;
            col_to_entry[col_pos] = dst;
            touched[touched_count++] = col_pos;
            shared->compact_span_shared_owner_sparse_cols[dst] = col;
            shared->compact_span_shared_owner_sparse_values[dst] = 0.0;
          }
          shared->compact_span_shared_owner_sparse_values[dst] +=
            -state->l_values[lp] * uvalue;
        }
      }
    }
    for (UF_long t = 0u; t < touched_count; ++t) {
      col_to_entry[touched[t]] = KLS_KLU_EMPTY;
    }
    if (cursor != row_end_slot) {
      ok = 0;
    }
  }
  free(col_to_entry);
  free(touched);
  if (!ok) {
    return 0;
  }
  *storage_entries_out = total_cells;
  return 1;
}

static UF_long kls_row_first_pipeline_prepare_sparse_shared_span_owner(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long wanted_pos) {
  if (shared == NULL ||
      !shared->compact_span_shared_owner_enabled ||
      !shared->compact_group_active ||
      !shared->compact_group_sparse ||
      !shared->compact_window_delay_output_enabled ||
      shared->compact_group_target_count < 2u ||
      shared->compact_span_owner_rows < 2u ||
      shared->compact_group_slots == NULL ||
      shared->compact_window_states == NULL ||
      shared->compact_union_mark == NULL ||
      shared->compact_union_pos == NULL ||
      shared->ctx == NULL || shared->workspace == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL ||
      shared->u_entries == NULL ||
      wanted_pos >= shared->ctx->nk || wanted_pos >= shared->end) {
    return 0u;
  }
  kls_row_first_pipeline_clear_sparse_group_output_cache(
    shared, trace, 0);

  UF_long owner_limit = shared->compact_span_owner_rows;
  if (owner_limit > KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS) {
    owner_limit = KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS;
  }
  if (owner_limit < 2u) {
    return 0u;
  }
  UF_long scan_rows = shared->compact_span_shared_owner_scan_rows;
  if (scan_rows < owner_limit) {
    scan_rows = owner_limit;
  }
  if (scan_rows > (UF_long)shared->compact_window_count) {
    scan_rows = (UF_long)shared->compact_window_count;
  }
  if (wanted_pos + scan_rows < wanted_pos ||
      wanted_pos + scan_rows > shared->end) {
    scan_rows = shared->end - wanted_pos;
  }
  if (scan_rows < 2u) {
    return 0u;
  }

  int owner_slots[KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS];
  UF_long owner_l_counts[KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS];
  const UF_long dep_window_limit =
    shared->compact_span_shared_owner_dep_limit;
  const int nonprefix_mode =
    shared->compact_span_shared_owner_nonprefix_enabled &&
    dep_window_limit > 0u;
  const int work_weight_mode =
    nonprefix_mode &&
    shared->compact_span_shared_owner_nonprefix_work_weight_enabled;
  UF_long selected_owner_dep_count = 0u;
  if (nonprefix_mode) {
    if (shared->compact_span_shared_owner_nonprefix_retain_enabled &&
        shared->compact_span_shared_owner_nonprefix_retain_min_rows > 0u &&
        shared->compact_span_shared_owner_nonprefix_active) {
      const UF_long remaining =
        kls_row_first_pipeline_count_active_shared_span_owner_rows(
          shared, 1);
      if (remaining >=
          shared->compact_span_shared_owner_nonprefix_retain_min_rows) {
        return 0u;
      }
    }
    shared->compact_span_shared_owner_active = 0;
    shared->compact_span_shared_owner_dep_count = 0u;
    shared->compact_span_shared_owner_nonprefix_active = 0;
    shared->compact_span_shared_owner_sparse_active = 0;
  }
  const UF_long min_owner_rows =
    dep_window_limit > 0u && shared->compact_span_owner_min_rows > 2u
      ? 2u : shared->compact_span_owner_min_rows;
  UF_long owner_count = 0u;
  unsigned int selected_dep_generation = 0u;
  if (dep_window_limit > 0u) {
    const unsigned int dep_count_generation =
      kls_row_first_pipeline_next_compact_union_generation(shared);
    if (dep_count_generation == 0u) {
      return 0u;
    }
    UF_long unique_next_deps = 0u;
    for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
      const int slot = shared->compact_group_slots[g];
      if (slot < 0 || slot >= shared->compact_window_count) {
        continue;
      }
      const kls_row_first_compact_window_state *state =
        shared->compact_window_states + slot;
      if (state == NULL || !state->active || !state->grouped ||
          state->row >= shared->ctx->nk ||
          state->pos < wanted_pos ||
          state->pos - wanted_pos >= scan_rows ||
          state->delayed_output_replayed_l_count > state->l_count) {
        continue;
      }
      UF_long local_deps = 0u;
      for (UF_long lp = state->delayed_output_replayed_l_count;
           lp < state->l_count; ++lp) {
        if (!nonprefix_mode && local_deps >= dep_window_limit) {
          break;
        }
        const UF_long dep = state->l_cols[lp];
        if (dep >= state->row || dep >= shared->ctx->nk) {
          break;
        }
        if (shared->compact_union_mark[dep] != dep_count_generation) {
          if (!kls_row_first_pipeline_reserve_compact_union_cols(
                shared, unique_next_deps + 1u) ||
              !kls_row_first_pipeline_reserve_compact_batch_positions(
                shared, unique_next_deps + 1u) ||
              (work_weight_mode &&
               !kls_row_first_pipeline_reserve_compact_replay_unique(
                 shared, unique_next_deps + 1u))) {
            return 0u;
          }
          shared->compact_union_mark[dep] = dep_count_generation;
          shared->compact_union_pos[dep] = unique_next_deps;
          shared->compact_union_cols[unique_next_deps] = dep;
          shared->compact_batch_positions[unique_next_deps] = 0u;
          if (work_weight_mode) {
            shared->compact_replay_min_rows[unique_next_deps] = 0u;
          }
          unique_next_deps++;
        }
        const UF_long dep_pos = shared->compact_union_pos[dep];
        if (dep_pos >= unique_next_deps) {
          return 0u;
        }
        if (work_weight_mode) {
          const UF_long row_begin = shared->workspace->u_row_ptr[dep];
          const UF_long row_end = shared->workspace->u_row_end[dep];
          if (row_begin > row_end ||
              row_end > shared->u_entries->count) {
            return 0u;
          }
          UF_long scan_begin = row_begin;
          if (shared->order_epoch == 0u) {
            scan_begin = kls_row_first_entries_lower_bound_col(
              shared->u_entries, row_begin, row_end, state->row);
          }
          const UF_long dep_output_entries =
            row_end >= scan_begin ? row_end - scan_begin : 0u;
          shared->compact_replay_min_rows[dep_pos] =
            shared->compact_replay_min_rows[dep_pos] >
                UF_long_max - dep_output_entries
              ? UF_long_max
              : shared->compact_replay_min_rows[dep_pos] +
                  dep_output_entries;
        }
        shared->compact_batch_positions[dep_pos] =
          shared->compact_batch_positions[dep_pos] == UF_long_max
            ? UF_long_max : shared->compact_batch_positions[dep_pos] + 1u;
        local_deps++;
      }
    }
    selected_dep_generation =
      kls_row_first_pipeline_next_compact_union_generation(shared);
    if (selected_dep_generation == 0u) {
      return 0u;
    }
    UF_long selected_deps = 0u;
    UF_long best_count = 0u;
    UF_long selected_total_count = 0u;
    while (selected_deps < dep_window_limit &&
           selected_deps < unique_next_deps) {
      UF_long best_index = KLS_KLU_EMPTY;
      UF_long best_dep = KLS_KLU_EMPTY;
      UF_long best_dep_count = 0u;
      UF_long best_dep_score = 0u;
      for (UF_long p = 0; p < unique_next_deps; ++p) {
        const UF_long count = shared->compact_batch_positions[p];
        const UF_long dep = shared->compact_union_cols[p];
        if (count == 0u) {
          continue;
        }
        const UF_long score =
          work_weight_mode ? shared->compact_replay_min_rows[p] : count;
        if (score == 0u) {
          continue;
        }
        if (score > best_dep_score ||
            (score == best_dep_score &&
             (count > best_dep_count ||
              (count == best_dep_count &&
               (best_dep == KLS_KLU_EMPTY || dep < best_dep))))) {
          best_dep_score = score;
          best_dep_count = count;
          best_dep = dep;
          best_index = p;
        }
      }
      if (best_index == KLS_KLU_EMPTY || best_dep_count == 0u ||
          best_dep_score == 0u) {
        break;
      }
      if (!kls_row_first_pipeline_reserve_shared_span_owner_deps(
            shared, selected_deps + 1u)) {
        return 0u;
      }
      shared->compact_batch_positions[best_index] = 0u;
      shared->compact_union_mark[best_dep] = selected_dep_generation;
      shared->compact_union_pos[best_dep] = selected_deps;
      shared->compact_span_shared_owner_deps[selected_deps] = best_dep;
      selected_deps++;
      selected_total_count =
        selected_total_count > UF_long_max - best_dep_score
          ? UF_long_max : selected_total_count + best_dep_score;
      if (best_count == 0u) {
        best_count = best_dep_count;
      }
    }
    if (selected_deps == 0u ||
        (min_owner_rows > 0u && best_count < min_owner_rows)) {
      kls_row_first_pipeline_trace_span_owner_payoff_skip(
        trace, best_count, selected_total_count, 0u);
      return 0u;
    }
    if (selected_deps > 1u) {
      qsort(shared->compact_span_shared_owner_deps,
            (size_t)selected_deps,
            sizeof(*shared->compact_span_shared_owner_deps),
            kls_algorithm5_payoff_compare_uf_long);
    }
    selected_owner_dep_count = selected_deps;
  }
  for (int pass = 0; pass < 2 && owner_count < owner_limit; ++pass) {
    for (UF_long g = 0; g < shared->compact_group_target_count &&
         owner_count < owner_limit; ++g) {
      const int slot = shared->compact_group_slots[g];
      if (slot < 0 || slot >= shared->compact_window_count) {
        continue;
      }
      const kls_row_first_compact_window_state *state =
        shared->compact_window_states + slot;
      if (state == NULL || !state->active || !state->grouped ||
          state->row >= shared->ctx->nk ||
          state->pos < wanted_pos ||
          state->pos - wanted_pos >= scan_rows ||
          state->delayed_output_replayed_l_count > state->l_count) {
        continue;
      }
      const int wanted_state = state->pos == wanted_pos;
      if (dep_window_limit == 0u &&
          ((pass == 0 && !wanted_state) ||
           (pass != 0 && wanted_state))) {
        continue;
      }
      if (dep_window_limit > 0u && pass != 0) {
        continue;
      }
      UF_long l_count = state->l_count;
      if (dep_window_limit > 0u) {
        if (nonprefix_mode) {
          int has_selected_dep = 0;
          for (UF_long lp = state->delayed_output_replayed_l_count;
               lp < state->l_count; ++lp) {
            const UF_long dep = state->l_cols[lp];
            if (dep >= state->row || dep >= shared->ctx->nk) {
              break;
            }
            if (kls_row_first_dep_sorted_contains(
                  shared->compact_span_shared_owner_deps,
                  selected_owner_dep_count, dep)) {
              has_selected_dep = 1;
              break;
            }
          }
          if (!has_selected_dep) {
            continue;
          }
        } else {
          l_count = state->delayed_output_replayed_l_count;
          while (l_count < state->l_count) {
            const UF_long dep = state->l_cols[l_count];
            if (dep >= state->row || dep >= shared->ctx->nk ||
                shared->compact_union_mark[dep] !=
                  selected_dep_generation) {
              break;
            }
            l_count++;
          }
          if (l_count == state->delayed_output_replayed_l_count) {
            continue;
          }
        }
      }
      owner_slots[owner_count] = slot;
      owner_l_counts[owner_count] = l_count;
      owner_count++;
    }
  }
  if (owner_count < 2u || owner_slots[0] < 0 ||
      (dep_window_limit == 0u &&
       shared->compact_window_states[owner_slots[0]].pos != wanted_pos)) {
    return 0u;
  }
  if (min_owner_rows > 0u && owner_count < min_owner_rows) {
    kls_row_first_pipeline_trace_span_owner_payoff_skip(
      trace, owner_count, 0u, 0u);
    return 0u;
  }

  const unsigned int dep_generation =
    kls_row_first_pipeline_next_compact_union_generation(shared);
  if (dep_generation == 0u) {
    return 0u;
  }

  UF_long unique_deps = 0u;
  UF_long link_count = 0u;
  UF_long dep_count = 0u;
  for (UF_long r = 0; r < owner_count; ++r) {
    const int slot = owner_slots[r];
    if (slot < 0 || slot >= shared->compact_window_count) {
      return 0u;
    }
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    for (UF_long lp = state->delayed_output_replayed_l_count;
         lp < owner_l_counts[r]; ++lp) {
      const UF_long dep = state->l_cols[lp];
      if (dep >= state->row || dep >= shared->ctx->nk) {
        return 0u;
      }
      if (nonprefix_mode &&
          !kls_row_first_dep_sorted_contains(
            shared->compact_span_shared_owner_deps,
            selected_owner_dep_count, dep)) {
        continue;
      }
      const UF_long row_begin = shared->workspace->u_row_ptr[dep];
      const UF_long row_end = shared->workspace->u_row_end[dep];
      if (row_begin > row_end || row_end > shared->u_entries->count) {
        return 0u;
      }
      dep_count++;
      if (shared->compact_union_mark[dep] != dep_generation) {
        if (!kls_row_first_pipeline_reserve_compact_union_cols(
              shared, unique_deps + 1u) ||
            !kls_row_first_pipeline_reserve_compact_replay_unique(
              shared, unique_deps + 1u)) {
          return 0u;
        }
        shared->compact_union_mark[dep] = dep_generation;
        shared->compact_union_pos[dep] = unique_deps;
        shared->compact_union_cols[unique_deps] = dep;
        shared->compact_replay_min_rows[unique_deps] = state->row;
        unique_deps++;
      } else {
        const UF_long pos = shared->compact_union_pos[dep];
        if (pos >= unique_deps) {
          return 0u;
        }
        if (state->row < shared->compact_replay_min_rows[pos]) {
          shared->compact_replay_min_rows[pos] = state->row;
        }
      }
      if (dep_window_limit == 0u &&
          link_count >= shared->compact_span_owner_max_links) {
        if (trace != NULL) {
          kls_row_first_stats_add(
            &trace->compact_window_span_owner_link_skips, 1u);
          kls_row_first_stats_add(
            &trace->compact_window_span_owner_link_skip_entries,
            link_count == UF_long_max ? UF_long_max : link_count + 1u);
        }
        return 0u;
      }
      link_count++;
    }
  }
  if (unique_deps == 0u || link_count == 0u ||
      !kls_row_first_pipeline_reserve_compact_replay_links(
        shared, link_count)) {
    return 0u;
  }

  for (UF_long u = 0; u < unique_deps; ++u) {
    shared->compact_batch_positions[u] = KLS_KLU_EMPTY;
  }
  UF_long link = 0u;
  for (UF_long r = 0; r < owner_count; ++r) {
    const int slot = owner_slots[r];
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    for (UF_long lp = state->delayed_output_replayed_l_count;
         lp < owner_l_counts[r]; ++lp) {
      const UF_long dep = state->l_cols[lp];
      if (dep >= shared->ctx->nk ||
          shared->compact_union_mark[dep] != dep_generation) {
        continue;
      }
      if (nonprefix_mode &&
          !kls_row_first_dep_sorted_contains(
            shared->compact_span_shared_owner_deps,
            selected_owner_dep_count, dep)) {
        continue;
      }
      const UF_long pos = shared->compact_union_pos[dep];
      if (pos >= unique_deps || link >= link_count) {
        return 0u;
      }
      shared->compact_replay_next[link] =
        shared->compact_batch_positions[pos];
      shared->compact_replay_lpos[link] = lp;
      shared->compact_replay_slots[link] = (int)r;
      shared->compact_batch_positions[pos] = link;
      link++;
    }
  }
  if (link != link_count) {
    return 0u;
  }

  const int sparse_values_mode =
    shared->compact_span_shared_owner_sparse_values_enabled;
  const unsigned int col_generation =
    kls_row_first_pipeline_next_compact_union_generation(shared);
  if (col_generation == 0u) {
    return 0u;
  }
  UF_long unique_cols = 0u;
  UF_long scan_entries = 0u;
  for (UF_long u = 0; u < unique_deps; ++u) {
    const UF_long dep = shared->compact_union_cols[u];
    const UF_long row_begin = shared->workspace->u_row_ptr[dep];
    const UF_long row_end = shared->workspace->u_row_end[dep];
    if (row_begin > row_end || row_end > shared->u_entries->count) {
      return 0u;
    }
    UF_long scan_begin = row_begin;
    if (shared->order_epoch == 0u) {
      scan_begin = kls_row_first_entries_lower_bound_col(
        shared->u_entries, row_begin, row_end,
        shared->compact_replay_min_rows[u]);
    }
    if (row_end >= scan_begin) {
      const UF_long row_scan_entries = row_end - scan_begin;
      if (scan_entries >
            shared->compact_span_owner_max_scan_entries ||
          row_scan_entries >
            shared->compact_span_owner_max_scan_entries - scan_entries) {
        if (trace != NULL) {
          kls_row_first_stats_add(
            &trace->compact_window_span_owner_scan_skips, 1u);
          kls_row_first_stats_add(
            &trace->compact_window_span_owner_scan_skip_entries,
            scan_entries > UF_long_max - row_scan_entries
              ? UF_long_max : scan_entries + row_scan_entries);
        }
        return 0u;
      }
      kls_row_first_stats_add(&scan_entries, row_scan_entries);
    }
    for (UF_long up = scan_begin; up < row_end; ++up) {
      const UF_long col = shared->u_entries->col[up];
      if (col <= dep || col >= shared->ctx->nk) {
        return 0u;
      }
      if (col < shared->compact_replay_min_rows[u]) {
        continue;
      }
      if (shared->compact_union_mark[col] != col_generation) {
        if (!sparse_values_mode &&
            (unique_cols + 1u < unique_cols ||
             owner_count >
               shared->compact_span_owner_max_slots / (unique_cols + 1u))) {
          if (trace != NULL) {
            kls_row_first_stats_add(
              &trace->compact_window_span_owner_oversize_skips, 1u);
            kls_row_first_stats_add(
              &trace->compact_window_span_owner_oversize_slots,
              unique_cols == UF_long_max ||
                  owner_count > UF_long_max / (unique_cols + 1u)
                ? UF_long_max
                : owner_count * (unique_cols + 1u));
          }
          return 0u;
        }
        if (!kls_row_first_pipeline_reserve_shared_span_owner_cols(
              shared, unique_cols + 1u)) {
          return 0u;
        }
        shared->compact_union_mark[col] = col_generation;
        shared->compact_union_pos[col] = unique_cols;
        shared->compact_span_shared_owner_cols[unique_cols] = col;
        unique_cols++;
      }
    }
  }
  UF_long matrix_slots = 0u;
  if (!sparse_values_mode) {
    if (unique_cols == 0u || owner_count > UF_long_max / unique_cols) {
      return 0u;
    }
    matrix_slots = owner_count * unique_cols;
    if (shared->compact_span_owner_max_slots == 0u ||
        matrix_slots > shared->compact_span_owner_max_slots) {
      if (trace != NULL) {
        kls_row_first_stats_add(
          &trace->compact_window_span_owner_oversize_skips, 1u);
        kls_row_first_stats_add(
          &trace->compact_window_span_owner_oversize_slots, matrix_slots);
      }
      return 0u;
    }
  }
  UF_long projected_replay_entries = 0u;
  if (!kls_row_first_pipeline_count_span_owner_replay_entries(
        shared, owner_slots, owner_l_counts, owner_count, unique_deps,
        col_generation, &projected_replay_entries)) {
    return 0u;
  }
  if (!kls_row_first_pipeline_span_owner_payoff_allows(
        shared, trace, owner_count, projected_replay_entries,
        scan_entries, min_owner_rows)) {
    return 0u;
  }

  UF_long replay_entries = 0u;
  if (sparse_values_mode) {
    if (!kls_row_first_pipeline_fill_span_owner_sparse_accum_values(
          shared, owner_slots, owner_l_counts, owner_count, unique_deps,
          col_generation, unique_cols, projected_replay_entries,
          &matrix_slots)) {
      return 0u;
    }
    replay_entries = projected_replay_entries;
  } else {
    if (!kls_row_first_pipeline_reserve_shared_span_owner_matrix(
          shared, matrix_slots, owner_count)) {
      return 0u;
    }
    memset(shared->compact_span_shared_owner_values, 0,
           (size_t)matrix_slots *
             sizeof(*shared->compact_span_shared_owner_values));
    memset(shared->compact_span_shared_owner_mask, 0,
           (size_t)matrix_slots *
             sizeof(*shared->compact_span_shared_owner_mask));
    memset(shared->compact_span_shared_owner_replay_entries, 0,
           (size_t)owner_count *
             sizeof(*shared->compact_span_shared_owner_replay_entries));

    for (UF_long u = 0; u < unique_deps; ++u) {
      const UF_long dep = shared->compact_union_cols[u];
      const UF_long row_begin = shared->workspace->u_row_ptr[dep];
      const UF_long row_end = shared->workspace->u_row_end[dep];
      UF_long scan_begin = row_begin;
      if (shared->order_epoch == 0u) {
        scan_begin = kls_row_first_entries_lower_bound_col(
          shared->u_entries, row_begin, row_end,
          shared->compact_replay_min_rows[u]);
      }
      for (UF_long up = scan_begin; up < row_end; ++up) {
        const UF_long col = shared->u_entries->col[up];
        if (col <= dep || col >= shared->ctx->nk) {
          return 0u;
        }
        if (shared->compact_union_mark[col] != col_generation) {
          continue;
        }
        const UF_long col_pos = shared->compact_union_pos[col];
        if (col_pos >= unique_cols) {
          return 0u;
        }
        const double uvalue = shared->u_entries->value[up];
        for (UF_long at = shared->compact_batch_positions[u];
             at != KLS_KLU_EMPTY;
             at = shared->compact_replay_next[at]) {
          const int row_slot = shared->compact_replay_slots[at];
          if (row_slot < 0 || (UF_long)row_slot >= owner_count) {
            continue;
          }
          const int slot = owner_slots[row_slot];
          if (slot < 0 || slot >= shared->compact_window_count) {
            continue;
          }
          const kls_row_first_compact_window_state *state =
            shared->compact_window_states + slot;
          const UF_long lp = shared->compact_replay_lpos[at];
          if (state == NULL || !state->active || !state->grouped ||
              lp >= owner_l_counts[row_slot] || col < state->row) {
            continue;
          }
          const UF_long matrix_pos =
            (UF_long)row_slot * unique_cols + col_pos;
          if (matrix_pos >= matrix_slots) {
            return 0u;
          }
          shared->compact_span_shared_owner_values[matrix_pos] +=
            -state->l_values[lp] * uvalue;
          shared->compact_span_shared_owner_mask[matrix_pos] = 1u;
          kls_row_first_stats_add(
            shared->compact_span_shared_owner_replay_entries + row_slot, 1u);
          kls_row_first_stats_add(&replay_entries, 1u);
        }
      }
    }
  }

  if (nonprefix_mode) {
    if (selected_owner_dep_count == 0u ||
        shared->compact_span_shared_owner_deps == NULL ||
        selected_owner_dep_count >
          shared->compact_span_shared_owner_dep_capacity) {
      return 0u;
    }
    shared->compact_span_shared_owner_dep_count =
      selected_owner_dep_count;
    shared->compact_span_shared_owner_nonprefix_active = 1;
  } else {
    shared->compact_span_shared_owner_dep_count = 0u;
    shared->compact_span_shared_owner_nonprefix_active = 0;
  }

  unsigned int owner_generation =
    shared->compact_span_shared_owner_generation + 1u;
  if (owner_generation == 0u) {
    for (int slot = 0; slot < shared->compact_window_count; ++slot) {
      shared->compact_window_states[slot]
        .compact_span_shared_owner_generation = 0u;
    }
    owner_generation = 1u;
  }
  shared->compact_span_shared_owner_generation = owner_generation;
  shared->compact_span_shared_owner_rows = owner_count;
  shared->compact_span_shared_owner_cols_count =
    sparse_values_mode ? 0u : unique_cols;
  shared->compact_span_shared_owner_sparse_active =
    sparse_values_mode ? 1 : 0;
  shared->compact_span_shared_owner_active = 1;
  for (UF_long r = 0; r < owner_count; ++r) {
    const int slot = owner_slots[r];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (!state->active || !state->grouped) {
      continue;
    }
    state->compact_span_shared_owner_generation = owner_generation;
    state->compact_span_shared_owner_row = r;
    state->compact_span_shared_owner_start_l_count =
      state->delayed_output_replayed_l_count;
    state->compact_span_shared_owner_l_count = owner_l_counts[r];
  }
  if (trace != NULL) {
    kls_row_first_stats_add(
      &trace->compact_window_span_shared_owner_reservations, 1u);
    kls_row_first_stats_add(
      &trace->compact_window_span_shared_owner_rows, owner_count);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_reservations, 1u);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_rows, owner_count);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_owned_rows, owner_count);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_deps, dep_count);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_unique_deps, unique_deps);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_scan_entries, scan_entries);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_cols, unique_cols);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_slots, matrix_slots);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_entries, replay_entries);
  }
  return owner_count;
}

static UF_long kls_row_first_pipeline_prepare_sparse_span_owner(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_worker *worker,
  kls_row_first_pipeline_trace *trace,
  UF_long wanted_pos) {
  if (shared == NULL || worker == NULL ||
      !shared->compact_span_owner_enabled ||
      !shared->compact_group_active ||
      !shared->compact_group_sparse ||
      !shared->compact_window_delay_output_enabled ||
      shared->compact_group_target_count < 2u ||
      shared->compact_span_owner_rows < 2u ||
      shared->compact_group_slots == NULL ||
      shared->compact_pos_slots == NULL ||
      shared->compact_window_states == NULL ||
      shared->compact_union_mark == NULL ||
      shared->compact_union_pos == NULL ||
      shared->ctx == NULL || shared->workspace == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL ||
      shared->u_entries == NULL ||
      wanted_pos >= shared->ctx->nk || wanted_pos >= shared->end) {
    return 0u;
  }
  kls_row_first_pipeline_clear_sparse_group_output_cache(
    shared, trace, 0);

  kls_row_first_pipeline_worker_reset_claim_run(worker);

  UF_long span_rows = shared->compact_span_owner_rows;
  if (span_rows > KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS) {
    span_rows = KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS;
  }
  if (wanted_pos + span_rows < wanted_pos ||
      wanted_pos + span_rows > shared->end) {
    span_rows = shared->end - wanted_pos;
  }
  if (span_rows < 2u) {
    return 0u;
  }

  int owner_slots[KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS];
  UF_long owned_count = 0u;
  for (UF_long r = 0; r < span_rows; ++r) {
    owner_slots[r] = -1;
    const UF_long pos = wanted_pos + r;
    if (pos < wanted_pos || pos >= shared->ctx->nk) {
      continue;
    }
    const int slot = shared->compact_pos_slots[pos];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (state == NULL || !state->active || !state->grouped ||
        state->pos != pos || state->row >= shared->ctx->nk ||
        state->delayed_output_replayed_l_count > state->l_count) {
      continue;
    }
    owner_slots[r] = slot;
    owned_count++;
  }
  if (owner_slots[0] < 0 || owned_count < 2u) {
    return 0u;
  }
  if (!shared->compact_span_owner_allow_holes) {
    UF_long prefix_rows = 0u;
    while (prefix_rows < span_rows && owner_slots[prefix_rows] >= 0) {
      prefix_rows++;
    }
    if (prefix_rows < 2u) {
      if (trace != NULL) {
        const UF_long skipped_holes =
          span_rows >= owned_count ? span_rows - owned_count : 0u;
        kls_row_first_stats_add(
          &trace->compact_window_span_owner_hole_skips, 1u);
        kls_row_first_stats_add(
          &trace->compact_window_span_owner_hole_skip_rows,
          skipped_holes);
      }
      return 0u;
    }
    if (prefix_rows < span_rows) {
      if (trace != NULL) {
        kls_row_first_stats_add(
          &trace->compact_window_span_owner_prefix_shrinks, 1u);
        kls_row_first_stats_add(
          &trace->compact_window_span_owner_prefix_shrink_rows,
          span_rows - prefix_rows);
      }
      if (!shared->compact_span_owner_allow_prefix) {
        if (trace != NULL) {
          const UF_long skipped_holes =
            span_rows >= owned_count ? span_rows - owned_count : 0u;
          kls_row_first_stats_add(
            &trace->compact_window_span_owner_hole_skips, 1u);
          kls_row_first_stats_add(
            &trace->compact_window_span_owner_hole_skip_rows,
            skipped_holes);
        }
        return 0u;
      }
      span_rows = prefix_rows;
      owned_count = prefix_rows;
    }
  }
  const UF_long hole_count =
    span_rows >= owned_count ? span_rows - owned_count : 0u;
  if (shared->compact_span_owner_min_rows > 0u &&
      owned_count < shared->compact_span_owner_min_rows) {
    kls_row_first_pipeline_trace_span_owner_payoff_skip(
      trace, owned_count, 0u, 0u);
    return 0u;
  }

  const unsigned int dep_generation =
    kls_row_first_pipeline_next_compact_union_generation(shared);
  if (dep_generation == 0u) {
    return 0u;
  }

  UF_long unique_deps = 0u;
  UF_long link_count = 0u;
  UF_long dep_count = 0u;
  for (UF_long r = 0; r < span_rows; ++r) {
    const int slot = owner_slots[r];
    if (slot < 0) {
      continue;
    }
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    for (UF_long lp = state->delayed_output_replayed_l_count;
         lp < state->l_count; ++lp) {
      const UF_long dep = state->l_cols[lp];
      if (dep >= state->row || dep >= shared->ctx->nk) {
        return 0u;
      }
      const UF_long row_begin = shared->workspace->u_row_ptr[dep];
      const UF_long row_end = shared->workspace->u_row_end[dep];
      if (row_begin > row_end || row_end > shared->u_entries->count) {
        return 0u;
      }
      dep_count++;
      if (shared->compact_union_mark[dep] != dep_generation) {
        if (!kls_row_first_pipeline_reserve_compact_union_cols(
              shared, unique_deps + 1u) ||
            !kls_row_first_pipeline_reserve_compact_replay_unique(
              shared, unique_deps + 1u)) {
          return 0u;
        }
        shared->compact_union_mark[dep] = dep_generation;
        shared->compact_union_pos[dep] = unique_deps;
        shared->compact_union_cols[unique_deps] = dep;
        shared->compact_replay_min_rows[unique_deps] = state->row;
        unique_deps++;
      } else {
        const UF_long pos = shared->compact_union_pos[dep];
        if (pos >= unique_deps) {
          return 0u;
        }
        if (state->row < shared->compact_replay_min_rows[pos]) {
          shared->compact_replay_min_rows[pos] = state->row;
        }
      }
      if (link_count >= shared->compact_span_owner_max_links) {
        if (trace != NULL) {
          kls_row_first_stats_add(
            &trace->compact_window_span_owner_link_skips, 1u);
          kls_row_first_stats_add(
            &trace->compact_window_span_owner_link_skip_entries,
            link_count == UF_long_max ? UF_long_max : link_count + 1u);
        }
        return 0u;
      }
      link_count++;
    }
  }
  if (unique_deps == 0u || link_count == 0u ||
      !kls_row_first_pipeline_reserve_compact_replay_links(
        shared, link_count)) {
    return 0u;
  }

  for (UF_long u = 0; u < unique_deps; ++u) {
    shared->compact_batch_positions[u] = KLS_KLU_EMPTY;
  }
  UF_long link = 0u;
  for (UF_long r = 0; r < span_rows; ++r) {
    const int slot = owner_slots[r];
    if (slot < 0) {
      continue;
    }
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    for (UF_long lp = state->delayed_output_replayed_l_count;
         lp < state->l_count; ++lp) {
      const UF_long dep = state->l_cols[lp];
      if (dep >= shared->ctx->nk ||
          shared->compact_union_mark[dep] != dep_generation) {
        continue;
      }
      const UF_long pos = shared->compact_union_pos[dep];
      if (pos >= unique_deps || link >= link_count) {
        return 0u;
      }
      shared->compact_replay_next[link] =
        shared->compact_batch_positions[pos];
      shared->compact_replay_lpos[link] = lp;
      shared->compact_replay_slots[link] = (int)r;
      shared->compact_batch_positions[pos] = link;
      link++;
    }
  }
  if (link != link_count) {
    return 0u;
  }

  const unsigned int col_generation =
    kls_row_first_pipeline_next_compact_union_generation(shared);
  if (col_generation == 0u) {
    return 0u;
  }
  UF_long unique_cols = 0u;
  UF_long scan_entries = 0u;
  for (UF_long u = 0; u < unique_deps; ++u) {
    const UF_long dep = shared->compact_union_cols[u];
    const UF_long row_begin = shared->workspace->u_row_ptr[dep];
    const UF_long row_end = shared->workspace->u_row_end[dep];
    if (row_begin > row_end || row_end > shared->u_entries->count) {
      return 0u;
    }
    UF_long scan_begin = row_begin;
    if (shared->order_epoch == 0u) {
      scan_begin = kls_row_first_entries_lower_bound_col(
        shared->u_entries, row_begin, row_end,
        shared->compact_replay_min_rows[u]);
    }
    if (row_end >= scan_begin) {
      const UF_long row_scan_entries = row_end - scan_begin;
      if (scan_entries >
            shared->compact_span_owner_max_scan_entries ||
          row_scan_entries >
            shared->compact_span_owner_max_scan_entries - scan_entries) {
        if (trace != NULL) {
          kls_row_first_stats_add(
            &trace->compact_window_span_owner_scan_skips, 1u);
          kls_row_first_stats_add(
            &trace->compact_window_span_owner_scan_skip_entries,
            scan_entries > UF_long_max - row_scan_entries
              ? UF_long_max : scan_entries + row_scan_entries);
        }
        return 0u;
      }
      kls_row_first_stats_add(&scan_entries, row_scan_entries);
    }
    for (UF_long up = scan_begin; up < row_end; ++up) {
      const UF_long col = shared->u_entries->col[up];
      if (col <= dep || col >= shared->ctx->nk) {
        return 0u;
      }
      if (col < shared->compact_replay_min_rows[u]) {
        continue;
      }
      if (shared->compact_union_mark[col] != col_generation) {
        if (unique_cols + 1u < unique_cols ||
            span_rows >
              shared->compact_span_owner_max_slots / (unique_cols + 1u)) {
          if (trace != NULL) {
            kls_row_first_stats_add(
              &trace->compact_window_span_owner_oversize_skips, 1u);
            kls_row_first_stats_add(
              &trace->compact_window_span_owner_oversize_slots,
              unique_cols == UF_long_max ||
                  span_rows > UF_long_max / (unique_cols + 1u)
                ? UF_long_max
                : span_rows * (unique_cols + 1u));
          }
          return 0u;
        }
        if (!kls_row_first_pipeline_worker_reserve_span_owner_cols(
              worker, unique_cols + 1u)) {
          return 0u;
        }
        shared->compact_union_mark[col] = col_generation;
        shared->compact_union_pos[col] = unique_cols;
        worker->compact_span_owner_cols[unique_cols] = col;
        unique_cols++;
      }
    }
  }
  if (unique_cols == 0u ||
      span_rows > UF_long_max / unique_cols) {
    return 0u;
  }
  const UF_long matrix_slots = span_rows * unique_cols;
  if (shared->compact_span_owner_max_slots == 0u ||
      matrix_slots > shared->compact_span_owner_max_slots) {
    if (trace != NULL) {
      kls_row_first_stats_add(
        &trace->compact_window_span_owner_oversize_skips, 1u);
      kls_row_first_stats_add(
        &trace->compact_window_span_owner_oversize_slots, matrix_slots);
    }
    return 0u;
  }
  UF_long projected_replay_entries = 0u;
  if (!kls_row_first_pipeline_count_span_owner_replay_entries(
        shared, owner_slots, NULL, span_rows, unique_deps, col_generation,
        &projected_replay_entries)) {
    return 0u;
  }
  if (!kls_row_first_pipeline_span_owner_payoff_allows(
        shared, trace, owned_count, projected_replay_entries,
        scan_entries, shared->compact_span_owner_min_rows)) {
    return 0u;
  }
  const size_t max_object = (size_t)PTRDIFF_MAX;
  if (matrix_slots >
        (UF_long)(max_object /
                  sizeof(*worker->compact_span_owner_values)) ||
      matrix_slots >
        (UF_long)(max_object /
                  sizeof(*worker->compact_span_owner_mask)) ||
      span_rows >
        (UF_long)(max_object /
                  sizeof(*worker->compact_span_owner_replay_entries))) {
    return 0u;
  }
  if (!kls_row_first_pipeline_worker_reserve_span_owner_matrix(
        worker, matrix_slots, span_rows)) {
    return 0u;
  }
  memset(worker->compact_span_owner_values, 0,
         (size_t)matrix_slots *
           sizeof(*worker->compact_span_owner_values));
  memset(worker->compact_span_owner_mask, 0,
         (size_t)matrix_slots *
           sizeof(*worker->compact_span_owner_mask));
  memset(worker->compact_span_owner_replay_entries, 0,
         (size_t)span_rows *
           sizeof(*worker->compact_span_owner_replay_entries));

  UF_long replay_entries = 0u;
  for (UF_long u = 0; u < unique_deps; ++u) {
    const UF_long dep = shared->compact_union_cols[u];
    const UF_long row_begin = shared->workspace->u_row_ptr[dep];
    const UF_long row_end = shared->workspace->u_row_end[dep];
    UF_long scan_begin = row_begin;
    if (shared->order_epoch == 0u) {
      scan_begin = kls_row_first_entries_lower_bound_col(
        shared->u_entries, row_begin, row_end,
        shared->compact_replay_min_rows[u]);
    }
    for (UF_long up = scan_begin; up < row_end; ++up) {
      const UF_long col = shared->u_entries->col[up];
      if (col <= dep || col >= shared->ctx->nk) {
        return 0u;
      }
      if (shared->compact_union_mark[col] != col_generation) {
        continue;
      }
      const UF_long col_pos = shared->compact_union_pos[col];
      if (col_pos >= unique_cols) {
        return 0u;
      }
      const double uvalue = shared->u_entries->value[up];
      for (UF_long at = shared->compact_batch_positions[u];
           at != KLS_KLU_EMPTY;
           at = shared->compact_replay_next[at]) {
        const int row_slot = shared->compact_replay_slots[at];
        if (row_slot < 0 || (UF_long)row_slot >= span_rows) {
          continue;
        }
        const int slot = owner_slots[row_slot];
        if (slot < 0 || slot >= shared->compact_window_count) {
          continue;
        }
        const kls_row_first_compact_window_state *state =
          shared->compact_window_states + slot;
        const UF_long lp = shared->compact_replay_lpos[at];
        if (state == NULL || !state->active || !state->grouped ||
            lp >= state->l_count || col < state->row) {
          continue;
        }
        const UF_long matrix_pos = (UF_long)row_slot * unique_cols + col_pos;
        if (matrix_pos >= matrix_slots) {
          return 0u;
        }
        worker->compact_span_owner_values[matrix_pos] +=
          -state->l_values[lp] * uvalue;
        worker->compact_span_owner_mask[matrix_pos] = 1u;
        kls_row_first_stats_add(
          worker->compact_span_owner_replay_entries + row_slot, 1u);
        kls_row_first_stats_add(&replay_entries, 1u);
      }
    }
  }

  unsigned long expected = (unsigned long)(wanted_pos + 1u);
  const unsigned long desired = (unsigned long)(wanted_pos + span_rows);
  if (!atomic_compare_exchange_strong_explicit(
        &shared->next_pos, &expected, desired,
        memory_order_acq_rel, memory_order_acquire)) {
    kls_row_first_pipeline_worker_reset_claim_run(worker);
    return 0u;
  }

  for (UF_long r = 0; r < span_rows; ++r) {
    worker->compact_claim_run_pos[r] = wanted_pos + r;
    worker->compact_claim_run_slots[r] = owner_slots[r];
  }

  const UF_long old_count = shared->compact_group_target_count;
  UF_long dst = 0u;
  for (UF_long g = 0; g < old_count; ++g) {
    const int slot = shared->compact_group_slots[g];
    if (slot < 0 || slot >= shared->compact_window_count) {
      shared->compact_group_slots[g] = -1;
      continue;
    }
    kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    int owned = 0;
    for (UF_long r = 0; r < span_rows; ++r) {
      if (owner_slots[r] == slot) {
        owned = 1;
        break;
      }
    }
    if (owned) {
      state->grouped = 0;
      state->group_member_count = 0u;
      state->bucket_dep = KLS_KLU_EMPTY;
      state->bucket_next = -1;
      state->bucket_linked = 0;
      state->delayed_output_replayed_l_count = state->l_count;
      kls_row_first_compact_window_deferred_output_reset(state);
      (void)kls_row_first_compact_window_deferred_output_bump_generation(
        state);
      shared->compact_group_slots[g] = -1;
      continue;
    }
    shared->compact_group_slots[dst++] = slot;
  }
  for (UF_long g = dst; g < old_count; ++g) {
    shared->compact_group_slots[g] = -1;
  }

  if (dst < 2u) {
    for (UF_long g = 0; g < dst; ++g) {
      const int slot = shared->compact_group_slots[g];
      shared->compact_group_slots[g] = -1;
      if (slot < 0 || slot >= shared->compact_window_count) {
        continue;
      }
      kls_row_first_compact_window_state *state =
        shared->compact_window_states + slot;
      if (!state->active || !state->grouped) {
        continue;
      }
      state->grouped = 0;
      state->group_member_count = 0u;
      state->bucket_dep = KLS_KLU_EMPTY;
      state->bucket_next = -1;
      state->bucket_linked = 0;
      if (!kls_row_first_pipeline_register_compact_window_state(
            shared, state) &&
          trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
    }
    shared->compact_group_active = 0;
    shared->compact_group_target_count = 0u;
    shared->compact_group_union_count = 0u;
    shared->compact_group_stride = 0u;
    shared->compact_group_dep = KLS_KLU_EMPTY;
    shared->compact_group_sparse = 0;
  } else {
    shared->compact_group_target_count = dst;
    shared->compact_group_union_count = 0u;
    shared->compact_group_stride = 0u;
  }

  worker->compact_claim_run_count = span_rows;
  worker->compact_claim_run_next = 1u;
  worker->compact_span_owner_rows = span_rows;
  worker->compact_span_owner_cols_count = unique_cols;
  worker->compact_span_owner_active = 1;
  if (trace != NULL) {
    kls_row_first_stats_add(&trace->compact_window_claim_run_reservations,
                            1u);
    kls_row_first_stats_add(&trace->compact_window_claim_run_rows,
                            span_rows);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_reservations, 1u);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_rows, span_rows);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_owned_rows, owned_count);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_hole_rows, hole_count);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_deps, dep_count);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_unique_deps, unique_deps);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_scan_entries, scan_entries);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_cols, unique_cols);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_slots, matrix_slots);
    kls_row_first_stats_add(
      &trace->compact_window_span_owner_entries, replay_entries);
  }
  return span_rows;
}

static void kls_row_first_pipeline_clear_compact_group(
  kls_row_first_pipeline_shared *shared) {
  if (shared == NULL || !shared->compact_group_active) {
    return;
  }
  kls_row_first_pipeline_clear_sparse_group_output_cache(
    shared, NULL, 0);
  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    const int slot = shared->compact_group_slots != NULL
      ? shared->compact_group_slots[g] : -1;
    if (slot < 0 || slot >= shared->compact_window_count ||
        shared->compact_window_states == NULL) {
      continue;
    }
    kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (state->active && state->grouped) {
      kls_row_first_pipeline_unlink_compact_window_state(shared, state);
      kls_row_first_pipeline_untrack_compact_window_state(shared, state);
      kls_row_first_compact_window_state_clear(state);
    }
    shared->compact_group_slots[g] = -1;
  }
  shared->compact_group_active = 0;
  shared->compact_group_target_count = 0u;
  shared->compact_group_union_count = 0u;
  shared->compact_group_stride = 0u;
  shared->compact_group_dep = KLS_KLU_EMPTY;
  shared->compact_group_sparse = 0;
}

static int kls_row_first_pipeline_replay_delayed_sparse_group(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long keep_root,
  int replay_nonmatching_only);

static int kls_row_first_pipeline_scatter_compact_group_row(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long row_slot) {
  if (shared == NULL || shared->compact_group_slots == NULL ||
      row_slot >= shared->compact_group_target_count ||
      shared->compact_window_states == NULL) {
    return 0;
  }
  const int slot = shared->compact_group_slots[row_slot];
  shared->compact_group_slots[row_slot] = -1;
  if (slot < 0 || slot >= shared->compact_window_count) {
    return 1;
  }
  kls_row_first_compact_window_state *state =
    shared->compact_window_states + slot;
  if (!state->active || !state->grouped) {
    return 1;
  }
  state->grouped = 0;
  if (shared->compact_group_sparse) {
    state->group_member_count = 0u;
    kls_row_first_pipeline_sparse_group_output_cache_clear_state(state);
    return kls_row_first_pipeline_register_compact_window_state(
      shared, state);
  }
  return kls_row_first_pipeline_scatter_compact_dense_row(
    shared, trace, state, shared->compact_group_cols,
    shared->compact_group_flags + row_slot * shared->compact_group_stride,
    shared->compact_group_values + row_slot * shared->compact_group_stride,
    shared->compact_group_union_count);
}

static int kls_row_first_pipeline_scatter_compact_group(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace) {
  if (shared == NULL || !shared->compact_group_active) {
    return 1;
  }
  kls_row_first_pipeline_trace_delayed_group_surface(
    shared, trace, KLS_KLU_EMPTY, 0, 0);
  if (shared->compact_group_replay_enabled) {
    (void)kls_row_first_pipeline_replay_delayed_sparse_group(
      shared, trace, KLS_KLU_EMPTY, 0);
  }
  int ok = 1;
  const UF_long target_count = shared->compact_group_target_count;
  for (UF_long g = 0; g < target_count; ++g) {
    if (!kls_row_first_pipeline_scatter_compact_group_row(
          shared, trace, g)) {
      ok = 0;
    }
  }
  shared->compact_group_active = 0;
  shared->compact_group_target_count = 0u;
  shared->compact_group_union_count = 0u;
  shared->compact_group_stride = 0u;
  shared->compact_group_dep = KLS_KLU_EMPTY;
  shared->compact_group_sparse = 0;
  return ok;
}

static kls_row_first_compact_window_state *
kls_row_first_pipeline_detach_sparse_group_row(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long group_slot) {
  if (shared == NULL || !shared->compact_group_active ||
      !shared->compact_group_sparse ||
      shared->compact_group_slots == NULL ||
      shared->compact_window_states == NULL ||
      group_slot >= shared->compact_group_target_count) {
    return NULL;
  }
  const UF_long old_count = shared->compact_group_target_count;
  const int slot = shared->compact_group_slots[group_slot];
  if (slot < 0 || slot >= shared->compact_window_count) {
    return NULL;
  }
  kls_row_first_compact_window_state *state =
    shared->compact_window_states + slot;
  if (!state->active || !state->grouped) {
    return NULL;
  }
  if (shared->compact_group_output_cache_active &&
      !kls_row_first_pipeline_materialize_sparse_group_output_cache_row(
        shared, trace, group_slot, state)) {
    kls_row_first_pipeline_clear_sparse_group_output_cache(
      shared, trace, 1);
  }
  if (shared->compact_group_output_cache_active &&
      !kls_row_first_pipeline_sparse_group_output_cache_remove_row(
        shared, trace, group_slot, old_count)) {
    kls_row_first_pipeline_clear_sparse_group_output_cache(
      shared, trace, 1);
  }

  for (UF_long g = group_slot + 1u; g < old_count; ++g) {
    shared->compact_group_slots[g - 1u] = shared->compact_group_slots[g];
  }
  shared->compact_group_slots[old_count - 1u] = -1;
  shared->compact_group_target_count = old_count - 1u;

  state->grouped = 0;
  state->group_member_count = 0u;
  state->bucket_dep = KLS_KLU_EMPTY;
  state->bucket_next = -1;
  state->bucket_linked = 0;

  if (shared->compact_group_target_count < 2u) {
    kls_row_first_pipeline_clear_sparse_group_output_cache(
      shared, trace, 0);
    const UF_long remaining = shared->compact_group_target_count;
    for (UF_long g = 0; g < remaining; ++g) {
      const int rem_slot = shared->compact_group_slots[g];
      shared->compact_group_slots[g] = -1;
      if (rem_slot < 0 || rem_slot >= shared->compact_window_count) {
        continue;
      }
      kls_row_first_compact_window_state *remaining_state =
        shared->compact_window_states + rem_slot;
      if (!remaining_state->active || !remaining_state->grouped) {
        continue;
      }
      remaining_state->grouped = 0;
      remaining_state->group_member_count = 0u;
      remaining_state->bucket_dep = KLS_KLU_EMPTY;
      remaining_state->bucket_next = -1;
      remaining_state->bucket_linked = 0;
      if (!kls_row_first_pipeline_register_compact_window_state(
            shared, remaining_state) &&
          trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
    }
    shared->compact_group_active = 0;
    shared->compact_group_target_count = 0u;
    shared->compact_group_union_count = 0u;
    shared->compact_group_stride = 0u;
    shared->compact_group_dep = KLS_KLU_EMPTY;
    shared->compact_group_sparse = 0;
  }

  return state;
}

static UF_long kls_row_first_pipeline_compact_batch_common_root(
  kls_row_first_pipeline_shared *shared,
  UF_long target_count,
  UF_long union_count,
  UF_long union_stride,
  UF_long min_targets) {
  if (shared == NULL || shared->compact_batch_targets == NULL ||
      shared->compact_batch_positions == NULL ||
      shared->compact_union_cols == NULL ||
      shared->compact_union_flags == NULL ||
      target_count < min_targets || union_count == 0u) {
    return KLS_KLU_EMPTY;
  }
  UF_long live_targets = 0u;
  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_compact_window_state *state =
      shared->compact_batch_targets[t].state;
    if (state == NULL || !state->active) {
      shared->compact_batch_positions[t] = KLS_KLU_EMPTY;
      continue;
    }
    const UF_long row_slot = shared->compact_batch_targets[t].dep_pos;
    if (row_slot >= target_count) {
      shared->compact_batch_positions[t] = KLS_KLU_EMPTY;
      continue;
    }
    shared->compact_batch_positions[t] =
      kls_row_first_compact_dense_min_dep(
        shared->compact_union_cols,
        shared->compact_union_flags + row_slot * union_stride,
        union_count, state->row);
    if (shared->compact_batch_positions[t] != KLS_KLU_EMPTY) {
      live_targets++;
    }
  }
  if (live_targets < min_targets) {
    return KLS_KLU_EMPTY;
  }
  UF_long best_dep = KLS_KLU_EMPTY;
  UF_long best_count = 0u;
  for (UF_long t = 0; t < target_count; ++t) {
    const UF_long dep = shared->compact_batch_positions[t];
    if (dep == KLS_KLU_EMPTY) {
      continue;
    }
    UF_long count = 0u;
    for (UF_long u = 0; u < target_count; ++u) {
      if (shared->compact_batch_positions[u] == dep) {
        count++;
      }
    }
    if (count > best_count ||
        (count == best_count &&
         (best_dep == KLS_KLU_EMPTY || dep < best_dep))) {
      best_dep = dep;
      best_count = count;
    }
  }
  return best_count >= min_targets ? best_dep : KLS_KLU_EMPTY;
}

static UF_long kls_row_first_pipeline_compact_group_common_root(
  kls_row_first_pipeline_shared *shared,
  UF_long min_targets) {
  if (shared == NULL || !shared->compact_group_active ||
      shared->compact_group_target_count < min_targets ||
      shared->compact_group_slots == NULL ||
      shared->compact_window_states == NULL ||
      !kls_row_first_pipeline_reserve_compact_batch_positions(
        shared, shared->compact_group_target_count)) {
    return KLS_KLU_EMPTY;
  }
  UF_long live_targets = 0u;
  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    shared->compact_batch_positions[g] = KLS_KLU_EMPTY;
    const int slot = shared->compact_group_slots[g];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (!state->active || !state->grouped) {
      continue;
    }
    shared->compact_batch_positions[g] =
      state->heap_size > 0u && state->heap[0] < state->row
        ? state->heap[0] : KLS_KLU_EMPTY;
    if (shared->compact_batch_positions[g] != KLS_KLU_EMPTY) {
      live_targets++;
    }
  }
  if (live_targets < min_targets) {
    return KLS_KLU_EMPTY;
  }
  UF_long best_dep = KLS_KLU_EMPTY;
  UF_long best_count = 0u;
  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    const UF_long dep = shared->compact_batch_positions[g];
    if (dep == KLS_KLU_EMPTY) {
      continue;
    }
    UF_long count = 0u;
    for (UF_long h = 0; h < shared->compact_group_target_count; ++h) {
      if (shared->compact_batch_positions[h] == dep) {
        count++;
      }
    }
    if (count > best_count ||
        (count == best_count &&
         (best_dep == KLS_KLU_EMPTY || dep < best_dep))) {
      best_dep = dep;
      best_count = count;
    }
  }
  return best_count >= min_targets ? best_dep : KLS_KLU_EMPTY;
}

static UF_long kls_row_first_pipeline_compact_targets_common_root(
  kls_row_first_pipeline_shared *shared,
  UF_long target_count,
  UF_long min_targets) {
  if (shared == NULL || shared->compact_batch_targets == NULL ||
      target_count < min_targets ||
      !kls_row_first_pipeline_reserve_compact_batch_positions(
        shared, target_count)) {
    return KLS_KLU_EMPTY;
  }
  UF_long live_targets = 0u;
  for (UF_long t = 0; t < target_count; ++t) {
    shared->compact_batch_positions[t] = KLS_KLU_EMPTY;
    const kls_row_first_compact_window_state *state =
      shared->compact_batch_targets[t].state;
    if (state == NULL || !state->active || state->grouped ||
        state->heap_size == 0u || state->heap[0] >= state->row) {
      continue;
    }
    shared->compact_batch_positions[t] = state->heap[0];
    live_targets++;
  }
  if (live_targets < min_targets) {
    return KLS_KLU_EMPTY;
  }
  UF_long best_dep = KLS_KLU_EMPTY;
  UF_long best_count = 0u;
  for (UF_long t = 0; t < target_count; ++t) {
    const UF_long dep = shared->compact_batch_positions[t];
    if (dep == KLS_KLU_EMPTY) {
      continue;
    }
    UF_long count = 0u;
    for (UF_long u = 0; u < target_count; ++u) {
      if (shared->compact_batch_positions[u] == dep) {
        count++;
      }
    }
    if (count > best_count ||
        (count == best_count &&
         (best_dep == KLS_KLU_EMPTY || dep < best_dep))) {
      best_dep = dep;
      best_count = count;
    }
  }
  return best_count >= min_targets ? best_dep : KLS_KLU_EMPTY;
}

static int kls_row_first_pipeline_promote_compact_sparse_group(
  kls_row_first_pipeline_shared *shared,
  UF_long target_count,
  UF_long root_dep) {
  if (shared == NULL || !shared->compact_group_sparse_enabled ||
      shared->compact_group_active || shared->compact_group_slots == NULL ||
      shared->compact_batch_targets == NULL ||
      shared->compact_window_states == NULL ||
      root_dep == KLS_KLU_EMPTY ||
      target_count > (UF_long)shared->compact_window_count) {
    return 0;
  }
  UF_long selected = 0u;
  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_compact_window_state *state =
      shared->compact_batch_targets[t].state;
    if (state == NULL || !state->active || state->grouped ||
        state->heap_size == 0u || state->heap[0] != root_dep ||
        state->bucket_slot < 0 ||
        state->bucket_slot >= shared->compact_window_count) {
      continue;
    }
    selected++;
  }
  if (selected < 2u ||
      selected > (UF_long)shared->compact_window_count) {
    return 0;
  }

  UF_long dst = 0u;
  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_compact_batch_target *target =
      shared->compact_batch_targets + t;
    kls_row_first_compact_window_state *state = target->state;
    if (state == NULL || !state->active || state->grouped ||
        state->heap_size == 0u || state->heap[0] != root_dep ||
        state->bucket_slot < 0 ||
        state->bucket_slot >= shared->compact_window_count) {
      continue;
    }
    kls_row_first_pipeline_unlink_compact_window_state(shared, state);
    shared->compact_group_slots[dst] = state->bucket_slot;
    state->grouped = 1;
    state->group_member_count = state->pattern_count;
    state->bucket_dep = KLS_KLU_EMPTY;
    state->bucket_next = -1;
    state->bucket_linked = 0;
    target->state = NULL;
    dst++;
  }
  if (dst < 2u) {
    for (UF_long g = 0; g < dst; ++g) {
      const int slot = shared->compact_group_slots[g];
      if (slot >= 0 && slot < shared->compact_window_count) {
        kls_row_first_compact_window_state *state =
          shared->compact_window_states + slot;
        state->grouped = 0;
        state->group_member_count = 0u;
        (void)kls_row_first_pipeline_register_compact_window_state(
          shared, state);
      }
      shared->compact_group_slots[g] = -1;
    }
    return 0;
  }
  shared->compact_group_active = 1;
  shared->compact_group_sparse = 1;
  shared->compact_group_target_count = dst;
  shared->compact_group_union_count = 0u;
  shared->compact_group_stride = 0u;
  shared->compact_group_dep = root_dep;
  if (!kls_row_first_pipeline_start_sparse_group_output_cache(shared)) {
    shared->compact_group_output_cache_active = 0;
  }
  return 1;
}

static int kls_row_first_pipeline_promote_compact_group(
  kls_row_first_pipeline_shared *shared,
  UF_long target_count,
  UF_long union_count,
  UF_long union_stride,
  UF_long root_dep) {
  if (shared == NULL || shared->compact_group_active ||
      shared->compact_group_slots == NULL ||
      shared->compact_group_pos == NULL ||
      shared->compact_group_mark == NULL ||
      shared->compact_batch_targets == NULL ||
      shared->compact_batch_positions == NULL ||
      shared->compact_union_cols == NULL ||
      shared->compact_union_flags == NULL ||
      shared->compact_union_values == NULL ||
      root_dep == KLS_KLU_EMPTY || union_count == 0u ||
      target_count > (UF_long)shared->compact_window_count) {
    return 0;
  }
  UF_long selected = 0u;
  for (UF_long t = 0; t < target_count; ++t) {
    if (shared->compact_batch_positions[t] == root_dep &&
        shared->compact_batch_targets[t].state != NULL &&
        shared->compact_batch_targets[t].state->active) {
      selected++;
    }
  }
  if (selected < 2u ||
      selected > (UF_long)shared->compact_window_count ||
      (selected != 0u && union_count > UF_long_max / selected) ||
      !kls_row_first_pipeline_reserve_compact_group_cols(
        shared, union_count) ||
      !kls_row_first_pipeline_reserve_compact_group_matrix(
        shared, selected * union_count)) {
    return 0;
  }

  unsigned int generation = shared->compact_group_generation + 1u;
  if (generation == 0u) {
    memset(shared->compact_group_mark, 0,
           (size_t)shared->ctx->nk *
             sizeof(*shared->compact_group_mark));
    generation = 1u;
  }
  shared->compact_group_generation = generation;
  for (UF_long u = 0; u < union_count; ++u) {
    const UF_long col = shared->compact_union_cols[u];
    if (col >= shared->ctx->nk) {
      return 0;
    }
    shared->compact_group_cols[u] = col;
    shared->compact_group_pos[col] = u;
    shared->compact_group_mark[col] = generation;
  }

  UF_long dst = 0u;
  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_compact_batch_target *target =
      shared->compact_batch_targets + t;
    kls_row_first_compact_window_state *state = target->state;
    if (shared->compact_batch_positions[t] != root_dep ||
        state == NULL || !state->active) {
      continue;
    }
    const UF_long row_slot = target->dep_pos;
    if (row_slot >= target_count) {
      return 0;
    }
    unsigned char *source_flags =
      shared->compact_union_flags + row_slot * union_stride;
    UF_long member_count = 0u;
    for (UF_long u = 0; u < union_count; ++u) {
      if ((source_flags[u] & 1u) != 0u) {
        member_count++;
      }
    }
    if (member_count > shared->compact_window_max_entries ||
        !kls_row_first_compact_window_reserve(
          state, member_count, shared->compact_window_max_entries)) {
      for (UF_long g = 0; g < dst; ++g) {
        const int old_slot = shared->compact_group_slots[g];
        if (old_slot >= 0 && old_slot < shared->compact_window_count) {
          shared->compact_window_states[old_slot].grouped = 0;
          shared->compact_window_states[old_slot].group_member_count = 0u;
        }
        shared->compact_group_slots[g] = -1;
      }
      return 0;
    }
    shared->compact_group_slots[dst] = state->bucket_slot;
    state->grouped = 1;
    state->group_member_count = member_count;
    state->heap_size = 0u;
    for (UF_long u = 0; u < union_count; ++u) {
      const UF_long col = shared->compact_union_cols[u];
      if ((source_flags[u] & 2u) != 0u && col < state->row) {
        kls_row_first_heap_push(state->heap, &state->heap_size, col);
      }
    }
    state->bucket_dep = KLS_KLU_EMPTY;
    state->bucket_next = -1;
    state->bucket_linked = 0;
    memcpy(shared->compact_group_values + dst * union_count,
           shared->compact_union_values + row_slot * union_stride,
           (size_t)union_count * sizeof(*shared->compact_group_values));
    memcpy(shared->compact_group_flags + dst * union_count,
           source_flags,
           (size_t)union_count * sizeof(*shared->compact_group_flags));
    target->state = NULL;
    dst++;
  }
  if (dst < 2u) {
    for (UF_long g = 0; g < dst; ++g) {
      const int slot = shared->compact_group_slots[g];
      if (slot >= 0 && slot < shared->compact_window_count) {
        shared->compact_window_states[slot].grouped = 0;
        shared->compact_window_states[slot].group_member_count = 0u;
      }
      shared->compact_group_slots[g] = -1;
    }
    return 0;
  }
  shared->compact_group_active = 1;
  shared->compact_group_sparse = 0;
  shared->compact_group_target_count = dst;
  shared->compact_group_union_count = union_count;
  shared->compact_group_stride = union_count;
  shared->compact_group_dep = root_dep;
  return 1;
}

static int kls_row_first_pipeline_merge_compact_sparse_group_targets(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long target_count) {
  if (shared == NULL || !shared->compact_group_active ||
      !shared->compact_group_sparse || shared->compact_group_slots == NULL ||
      shared->compact_batch_targets == NULL ||
      shared->compact_group_dep == KLS_KLU_EMPTY ||
      shared->compact_group_target_count >=
        (UF_long)shared->compact_window_count) {
    return 1;
  }
  const UF_long remaining =
    (UF_long)shared->compact_window_count -
    shared->compact_group_target_count;
  UF_long selected = 0u;
  for (UF_long t = 0; t < target_count && selected < remaining; ++t) {
    kls_row_first_compact_window_state *state =
      shared->compact_batch_targets[t].state;
    if (state == NULL || !state->active || state->grouped ||
        state->heap_size == 0u ||
        state->heap[0] != shared->compact_group_dep ||
        state->bucket_slot < 0 ||
        state->bucket_slot >= shared->compact_window_count) {
      continue;
    }
    selected++;
  }
  if (selected == 0u) {
    return 1;
  }

  UF_long merged = 0u;
  UF_long state_rows = 0u;
  for (UF_long t = 0; t < target_count && merged < selected; ++t) {
    kls_row_first_compact_batch_target *target =
      shared->compact_batch_targets + t;
    kls_row_first_compact_window_state *state = target->state;
    if (state == NULL || !state->active || state->grouped ||
        state->heap_size == 0u ||
        state->heap[0] != shared->compact_group_dep ||
        state->bucket_slot < 0 ||
        state->bucket_slot >= shared->compact_window_count) {
      continue;
    }
    kls_row_first_pipeline_unlink_compact_window_state(shared, state);
    const UF_long dst = shared->compact_group_target_count + merged;
    if (shared->compact_group_output_cache_active) {
      (void)kls_row_first_pipeline_sparse_group_output_cache_zero_row(
        shared, trace, dst);
      kls_row_first_pipeline_sparse_group_output_cache_clear_state(state);
    }
    shared->compact_group_slots[dst] = state->bucket_slot;
    state->grouped = 1;
    state->group_member_count = state->pattern_count;
    state->bucket_dep = KLS_KLU_EMPTY;
    state->bucket_next = -1;
    state->bucket_linked = 0;
    state_rows += state->pattern_count;
    target->state = NULL;
    merged++;
  }
  shared->compact_group_target_count += merged;
  if (trace != NULL && merged > 0u) {
    kls_row_first_stats_add(&trace->compact_window_group_merges, 1u);
    kls_row_first_stats_add(&trace->compact_window_group_merge_targets,
                            merged);
    kls_row_first_stats_add(&trace->compact_window_group_merge_cols,
                            state_rows);
    kls_row_first_stats_add(&trace->compact_window_group_merge_values,
                            state_rows);
  }
  return 1;
}

static int kls_row_first_pipeline_merge_compact_group_batch(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long target_count,
  UF_long active_target_count,
  UF_long union_count,
  UF_long union_stride) {
  if (shared == NULL || shared->ctx == NULL ||
      !shared->compact_group_active ||
      shared->compact_group_dep == KLS_KLU_EMPTY ||
      shared->compact_batch_targets == NULL ||
      shared->compact_batch_positions == NULL ||
      shared->compact_union_cols == NULL ||
      shared->compact_union_values == NULL ||
      shared->compact_union_flags == NULL ||
      shared->compact_group_slots == NULL ||
      shared->compact_group_pos == NULL ||
      shared->compact_group_mark == NULL ||
      shared->compact_window_states == NULL ||
      target_count == 0u || active_target_count == 0u ||
      union_count == 0u || shared->compact_group_stride == 0u ||
      union_stride < union_count ||
      shared->compact_group_target_count >=
        (UF_long)shared->compact_window_count) {
    return 1;
  }
  if (!kls_row_first_pipeline_reserve_compact_batch_positions(
        shared, target_count)) {
    return 1;
  }
  (void)kls_row_first_pipeline_compact_batch_common_root(
    shared, target_count, union_count, union_stride, 1u);

  UF_long selected = 0u;
  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_compact_window_state *state =
      shared->compact_batch_targets[t].state;
    if (state != NULL && state->active &&
        shared->compact_batch_positions[t] ==
          shared->compact_group_dep) {
      selected++;
    }
  }
  if (selected == 0u) {
    return 1;
  }
  const UF_long remaining =
    (UF_long)shared->compact_window_count -
    shared->compact_group_target_count;
  if (selected > remaining) {
    selected = remaining;
  }
  if (selected == 0u) {
    return 1;
  }

  for (UF_long u = 0; u < union_count; ++u) {
    const UF_long col = shared->compact_union_cols[u];
    if (col >= shared->ctx->nk ||
        !kls_row_first_pipeline_compact_group_ensure_col(shared, col)) {
      return 1;
    }
  }
  const UF_long new_target_count =
    shared->compact_group_target_count + selected;
  if (shared->compact_group_stride != 0u &&
      new_target_count >
        UF_long_max / shared->compact_group_stride) {
    return 1;
  }
  if (!kls_row_first_pipeline_reserve_compact_group_matrix(
        shared, new_target_count * shared->compact_group_stride)) {
    return 1;
  }

  UF_long merged = 0u;
  for (UF_long t = 0; t < target_count && merged < selected; ++t) {
    kls_row_first_compact_batch_target *target =
      shared->compact_batch_targets + t;
    kls_row_first_compact_window_state *state = target->state;
    if (state == NULL || !state->active ||
        shared->compact_batch_positions[t] !=
          shared->compact_group_dep) {
      continue;
    }
    const UF_long row_slot = target->dep_pos;
    if (row_slot >= active_target_count) {
      continue;
    }
    const unsigned char *source_flags =
      shared->compact_union_flags + row_slot * union_stride;
    const double *source_values =
      shared->compact_union_values + row_slot * union_stride;
    UF_long member_count = 0u;
    for (UF_long u = 0; u < union_count; ++u) {
      if ((source_flags[u] & 1u) != 0u) {
        member_count++;
      }
    }
    if (member_count > shared->compact_window_max_entries ||
        !kls_row_first_compact_window_reserve(
          state, member_count, shared->compact_window_max_entries)) {
      continue;
    }

    const UF_long dst = shared->compact_group_target_count + merged;
    double *dst_values =
      shared->compact_group_values + dst * shared->compact_group_stride;
    unsigned char *dst_flags =
      shared->compact_group_flags + dst * shared->compact_group_stride;
    memset(dst_values, 0,
           (size_t)shared->compact_group_stride *
             sizeof(*shared->compact_group_values));
    memset(dst_flags, 0,
           (size_t)shared->compact_group_stride *
             sizeof(*shared->compact_group_flags));
    state->grouped = 1;
    state->group_member_count = member_count;
    state->heap_size = 0u;
    for (UF_long u = 0; u < union_count; ++u) {
      const UF_long col = shared->compact_union_cols[u];
      const UF_long group_pos = shared->compact_group_pos[col];
      if (group_pos >= shared->compact_group_union_count) {
        state->grouped = 0;
        state->group_member_count = 0u;
        state->heap_size = 0u;
        return 1;
      }
      dst_values[group_pos] = source_values[u];
      dst_flags[group_pos] = source_flags[u];
      if ((source_flags[u] & 2u) != 0u && col < state->row) {
        kls_row_first_heap_push(state->heap, &state->heap_size, col);
      }
    }
    state->bucket_dep = KLS_KLU_EMPTY;
    state->bucket_next = -1;
    state->bucket_linked = 0;
    shared->compact_group_slots[dst] = state->bucket_slot;
    target->state = NULL;
    merged++;
  }
  if (merged == 0u) {
    return 1;
  }
  shared->compact_group_target_count += merged;
  if (trace != NULL) {
    kls_row_first_stats_add(&trace->compact_window_group_merges, 1u);
    kls_row_first_stats_add(&trace->compact_window_group_merge_targets,
                            merged);
    kls_row_first_stats_add(&trace->compact_window_group_merge_cols,
                            shared->compact_group_union_count);
    if (shared->compact_group_union_count <= UF_long_max / merged) {
      kls_row_first_stats_add(
        &trace->compact_window_group_merge_values,
        shared->compact_group_union_count * merged);
    }
  }
  return 1;
}

static void kls_row_first_pipeline_compact_sparse_group_keep_root(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long root_dep) {
  if (shared == NULL || !shared->compact_group_active ||
      !shared->compact_group_sparse) {
    return;
  }
  if (root_dep == KLS_KLU_EMPTY) {
    (void)kls_row_first_pipeline_scatter_compact_group(shared, trace);
    return;
  }
  kls_row_first_pipeline_trace_delayed_group_surface(
    shared, trace, root_dep, 1, 0);
  if (shared->compact_group_replay_enabled) {
    (void)kls_row_first_pipeline_replay_delayed_sparse_group(
      shared, trace, root_dep, 1);
  }
  UF_long dst = 0u;
  const UF_long old_count = shared->compact_group_target_count;
  const int output_cache_active =
    shared->compact_group_output_cache_active;
  for (UF_long g = 0; g < old_count; ++g) {
    int keep = 0;
    const int slot = shared->compact_group_slots[g];
    if (slot >= 0 && slot < shared->compact_window_count &&
        shared->compact_window_states != NULL) {
      const kls_row_first_compact_window_state *state =
        shared->compact_window_states + slot;
      if (kls_row_first_pipeline_sparse_group_state_keeps_root(
            state, root_dep)) {
        keep = 1;
      }
    }
    if (keep) {
      if (output_cache_active && dst != g) {
        (void)kls_row_first_pipeline_sparse_group_output_cache_copy_row(
          shared, trace, dst, g);
      }
      shared->compact_group_slots[dst] =
        shared->compact_group_slots[g];
      dst++;
    } else {
      (void)kls_row_first_pipeline_scatter_compact_group_row(
        shared, trace, g);
    }
  }
  if (dst < 2u) {
    shared->compact_group_target_count = dst;
    (void)kls_row_first_pipeline_scatter_compact_group(shared, trace);
    return;
  }
  for (UF_long g = dst; g < old_count; ++g) {
    shared->compact_group_slots[g] = -1;
  }
  shared->compact_group_target_count = dst;
  if (!shared->compact_group_output_cache_active) {
    shared->compact_group_union_count = 0u;
    shared->compact_group_stride = 0u;
  }
  shared->compact_group_dep = root_dep;
  shared->compact_group_sparse = 1;
}

static void kls_row_first_pipeline_compact_group_keep_root(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long root_dep) {
  if (shared == NULL || !shared->compact_group_active) {
    return;
  }
  if (shared->compact_group_sparse) {
    kls_row_first_pipeline_compact_sparse_group_keep_root(
      shared, trace, root_dep);
    return;
  }
  if (root_dep == KLS_KLU_EMPTY) {
    (void)kls_row_first_pipeline_scatter_compact_group(shared, trace);
    return;
  }
  UF_long dst = 0u;
  const UF_long old_count = shared->compact_group_target_count;
  const UF_long stride = shared->compact_group_stride;
  for (UF_long g = 0; g < old_count; ++g) {
    int keep = 0;
    const int slot = shared->compact_group_slots[g];
    if (slot >= 0 && slot < shared->compact_window_count &&
        shared->compact_window_states != NULL) {
      const kls_row_first_compact_window_state *state =
        shared->compact_window_states + slot;
      if (state->active && state->grouped &&
          shared->compact_batch_positions != NULL &&
          g < shared->compact_group_target_count &&
          shared->compact_batch_positions[g] == root_dep) {
        keep = 1;
      }
    }
    if (keep) {
      if (dst != g) {
        memmove(shared->compact_group_values + dst * stride,
                shared->compact_group_values + g * stride,
                (size_t)shared->compact_group_union_count *
                  sizeof(*shared->compact_group_values));
        memmove(shared->compact_group_flags + dst * stride,
                shared->compact_group_flags + g * stride,
                (size_t)shared->compact_group_union_count *
                  sizeof(*shared->compact_group_flags));
        shared->compact_group_slots[dst] =
          shared->compact_group_slots[g];
      }
      dst++;
    } else {
      (void)kls_row_first_pipeline_scatter_compact_group_row(
        shared, trace, g);
    }
  }
  if (dst < 2u) {
    shared->compact_group_target_count = dst;
    (void)kls_row_first_pipeline_scatter_compact_group(shared, trace);
    return;
  }
  for (UF_long g = dst; g < old_count; ++g) {
    shared->compact_group_slots[g] = -1;
  }
  shared->compact_group_target_count = dst;
  shared->compact_group_dep = root_dep;
}

static void kls_row_first_pipeline_discard_compact_group_slot(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long group_slot) {
  if (shared == NULL || shared->compact_group_slots == NULL ||
      group_slot >= shared->compact_group_target_count ||
      shared->compact_window_states == NULL) {
    return;
  }
  const int slot = shared->compact_group_slots[group_slot];
  shared->compact_group_slots[group_slot] = -1;
  if (slot >= 0 && slot < shared->compact_window_count) {
    kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (state->active) {
      kls_row_first_pipeline_unlink_compact_window_state(shared, state);
      kls_row_first_pipeline_untrack_compact_window_state(shared, state);
      kls_row_first_compact_window_state_clear(state);
    }
  }
  if (trace != NULL) {
    kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
  }
}

static int kls_row_first_pipeline_replay_delayed_sparse_group(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long keep_root,
  int replay_nonmatching_only) {
  if (shared == NULL || !shared->compact_group_active ||
      !shared->compact_group_sparse ||
      !shared->compact_group_replay_enabled ||
      !shared->compact_window_delay_output_enabled ||
      shared->compact_group_slots == NULL ||
      shared->compact_window_states == NULL ||
      shared->ctx == NULL || shared->workspace == NULL ||
      shared->u_entries == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL ||
      shared->compact_union_mark == NULL ||
      shared->compact_union_pos == NULL) {
    return 1;
  }
  if (!replay_nonmatching_only) {
    kls_row_first_pipeline_clear_sparse_group_output_cache(
      shared, trace, 0);
  }

  unsigned int generation = shared->compact_union_generation + 1u;
  if (generation == 0u) {
    memset(shared->compact_union_mark, 0,
           (size_t)shared->ctx->nk *
             sizeof(*shared->compact_union_mark));
    generation = 1u;
  }
  shared->compact_union_generation = generation;

  const UF_long nk = shared->ctx->nk;
  UF_long unique_deps = 0u;
  UF_long link_count = 0u;
  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    const int slot = shared->compact_group_slots[g];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (state == NULL || !state->active || !state->grouped ||
        state->row >= nk ||
        (replay_nonmatching_only &&
         kls_row_first_pipeline_sparse_group_state_keeps_root(
           state, keep_root))) {
      continue;
    }
    if (state->delayed_output_replayed_l_count > state->l_count) {
      return 1;
    }
    for (UF_long lp = state->delayed_output_replayed_l_count;
         lp < state->l_count; ++lp) {
      const UF_long dep = state->l_cols[lp];
      if (dep >= state->row || dep >= nk) {
        return 1;
      }
      const UF_long row_begin = shared->workspace->u_row_ptr[dep];
      const UF_long row_end = shared->workspace->u_row_end[dep];
      if (row_begin > row_end || row_end > shared->u_entries->count) {
        return 1;
      }
      if (shared->compact_union_mark[dep] != generation) {
        if (!kls_row_first_pipeline_reserve_compact_union_cols(
              shared, unique_deps + 1u) ||
            !kls_row_first_pipeline_reserve_compact_replay_unique(
              shared, unique_deps + 1u)) {
          return 1;
        }
        shared->compact_union_mark[dep] = generation;
        shared->compact_union_pos[dep] = unique_deps;
        shared->compact_union_cols[unique_deps] = dep;
        shared->compact_replay_min_rows[unique_deps] = state->row;
        unique_deps++;
      } else {
        const UF_long pos = shared->compact_union_pos[dep];
        if (pos >= unique_deps) {
          return 1;
        }
        if (state->row < shared->compact_replay_min_rows[pos]) {
          shared->compact_replay_min_rows[pos] = state->row;
        }
      }
      if (link_count == UF_long_max) {
        return 1;
      }
      link_count++;
    }
  }
  if (unique_deps == 0u || link_count == 0u ||
      !kls_row_first_pipeline_reserve_compact_replay_links(
        shared, link_count)) {
    return 1;
  }

  for (UF_long u = 0; u < unique_deps; ++u) {
    shared->compact_batch_positions[u] = KLS_KLU_EMPTY;
  }
  memset(shared->compact_replay_touched, 0,
         (size_t)link_count * sizeof(*shared->compact_replay_touched));
  memset(shared->compact_replay_state_touched, 0,
         (size_t)shared->compact_window_count *
           sizeof(*shared->compact_replay_state_touched));

  UF_long link = 0u;
  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    const int slot = shared->compact_group_slots[g];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (state == NULL || !state->active || !state->grouped ||
        (replay_nonmatching_only &&
         kls_row_first_pipeline_sparse_group_state_keeps_root(
           state, keep_root))) {
      continue;
    }
    for (UF_long lp = state->delayed_output_replayed_l_count;
         lp < state->l_count; ++lp) {
      const UF_long dep = state->l_cols[lp];
      if (dep >= nk ||
          shared->compact_union_mark[dep] != generation) {
        continue;
      }
      const UF_long pos = shared->compact_union_pos[dep];
      if (pos >= unique_deps || link >= link_count) {
        return 1;
      }
      shared->compact_replay_next[link] =
        shared->compact_batch_positions[pos];
      shared->compact_replay_lpos[link] = lp;
      shared->compact_replay_slots[link] = (int)g;
      shared->compact_batch_positions[pos] = link;
      link++;
    }
  }
  if (link != link_count) {
    return 1;
  }

  UF_long replay_states = 0u;
  UF_long replay_deps = 0u;
  UF_long replay_entries = 0u;
  UF_long replay_scan_entries = 0u;
  UF_long replay_seek_skips = 0u;
  for (UF_long u = 0; u < unique_deps; ++u) {
    const UF_long dep = shared->compact_union_cols[u];
    const UF_long row_begin = shared->workspace->u_row_ptr[dep];
    const UF_long row_end = shared->workspace->u_row_end[dep];
    if (row_begin > row_end || row_end > shared->u_entries->count) {
      continue;
    }
    UF_long scan_begin = row_begin;
    if (shared->order_epoch == 0u) {
      scan_begin = kls_row_first_entries_lower_bound_col(
        shared->u_entries, row_begin, row_end,
        shared->compact_replay_min_rows[u]);
      if (scan_begin > row_begin) {
        kls_row_first_stats_add(&replay_seek_skips,
                                scan_begin - row_begin);
      }
    }
    if (row_end >= scan_begin) {
      kls_row_first_stats_add(&replay_scan_entries,
                              row_end - scan_begin);
    }
    for (UF_long up = scan_begin; up < row_end; ++up) {
      const UF_long col = shared->u_entries->col[up];
      if (col <= dep || col >= nk) {
        return 1;
      }
      const double uvalue = shared->u_entries->value[up];
      for (UF_long at = shared->compact_batch_positions[u];
           at != KLS_KLU_EMPTY;
           at = shared->compact_replay_next[at]) {
        const int group_slot = shared->compact_replay_slots[at];
        if (group_slot < 0 ||
            (UF_long)group_slot >= shared->compact_group_target_count) {
          continue;
        }
        const int slot = shared->compact_group_slots[group_slot];
        if (slot < 0 || slot >= shared->compact_window_count) {
          continue;
        }
        kls_row_first_compact_window_state *state =
          shared->compact_window_states + slot;
        const UF_long lp = shared->compact_replay_lpos[at];
        if (state == NULL || !state->active || !state->grouped ||
            lp >= state->l_count || col < state->row) {
          continue;
        }
        if (!kls_row_first_compact_window_insert(
              state, state->row, col,
              -state->l_values[lp] * uvalue,
              shared->compact_window_max_entries, NULL)) {
          kls_row_first_pipeline_discard_compact_group_slot(
            shared, trace, (UF_long)group_slot);
          continue;
        }
        if (shared->compact_replay_touched[at] == 0u) {
          shared->compact_replay_touched[at] = 1u;
          kls_row_first_stats_add(&replay_deps, 1u);
        }
        if (shared->compact_replay_state_touched[slot] == 0u) {
          shared->compact_replay_state_touched[slot] = 1u;
          kls_row_first_stats_add(&replay_states, 1u);
        }
        kls_row_first_stats_add(&replay_entries, 1u);
      }
    }
  }

  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    const int slot = shared->compact_group_slots[g];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (state == NULL || !state->active || !state->grouped ||
        (replay_nonmatching_only &&
         kls_row_first_pipeline_sparse_group_state_keeps_root(
           state, keep_root))) {
      continue;
    }
    state->delayed_output_replayed_l_count = state->l_count;
    kls_row_first_compact_window_deferred_output_reset(state);
    (void)kls_row_first_compact_window_deferred_output_bump_generation(
      state);
  }

  kls_row_first_pipeline_trace *target =
    trace != NULL ? trace
                  : (shared->trace_enabled ? &shared->trace_committed : NULL);
  if (target != NULL) {
    kls_row_first_stats_add(
      &target->compact_window_delayed_output_replays, replay_states);
    kls_row_first_stats_add(
      &target->compact_window_delayed_output_deps, replay_deps);
    kls_row_first_stats_add(
      &target->compact_window_delayed_output_entries, replay_entries);
    kls_row_first_stats_add(
      &target->compact_window_delayed_output_scan_entries,
      replay_scan_entries);
    kls_row_first_stats_add(
      &target->compact_window_delayed_output_seek_skips,
      replay_seek_skips);
    kls_row_first_stats_add(&target->scalar_u_output_entries,
                            replay_entries);
  }
  return 1;
}

static void kls_row_first_pipeline_update_compact_sparse_group_producer(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long dep) {
  if (shared == NULL || !shared->compact_group_active ||
      !shared->compact_group_sparse || shared->compact_group_dep != dep ||
      shared->compact_group_target_count == 0u ||
      shared->compact_group_slots == NULL ||
      shared->compact_batch_targets == NULL ||
      shared->compact_window_states == NULL ||
      shared->workspace == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL ||
      shared->u_entries == NULL ||
      shared->udiag_values == NULL ||
      shared->ctx == NULL || dep >= shared->ctx->nk) {
    return;
  }
  const double dep_pivot = shared->udiag_values[dep];
  if (dep_pivot == 0.0) {
    kls_row_first_pipeline_clear_compact_group(shared);
    return;
  }
  const UF_long row_begin = shared->workspace->u_row_ptr[dep];
  const UF_long row_end = shared->workspace->u_row_end[dep];
  if (row_begin > row_end || row_end > shared->u_entries->count) {
    kls_row_first_pipeline_clear_compact_group(shared);
    return;
  }
  for (UF_long up = row_begin; up < row_end; ++up) {
    const UF_long col = shared->u_entries->col[up];
    if (col <= dep || col >= shared->ctx->nk) {
      kls_row_first_pipeline_clear_compact_group(shared);
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
      return;
    }
  }

  const UF_long row_entries = row_end - row_begin;
  const int group_cache_available =
    shared->compact_group_output_cache_enabled &&
    shared->compact_group_output_cache_active &&
    shared->compact_window_delay_output_enabled;
  UF_long live_targets = 0u;
  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    shared->compact_batch_targets[g].state = NULL;
    shared->compact_batch_targets[g].deferred_output_cache = 0;
    shared->compact_batch_targets[g].group_output_cache = 0;
    const int slot = shared->compact_group_slots[g];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (!state->active || !state->grouped) {
      continue;
    }
    const UF_long current_dep =
      state->heap_size > 0u ? state->heap[0] : KLS_KLU_EMPTY;
    UF_long dep_pos = KLS_KLU_EMPTY;
    if (current_dep != dep ||
        !kls_row_first_compact_window_value_pos(state, dep, &dep_pos) ||
        dep_pos >= state->pattern_count ||
        !kls_row_first_compact_window_l_reserve(
          state, state->l_count + 1u)) {
      kls_row_first_pipeline_discard_compact_group_slot(
        shared, trace, g);
      continue;
    }
    const UF_long popped =
      kls_row_first_heap_pop(state->heap, &state->heap_size);
    if (popped != dep) {
      kls_row_first_pipeline_discard_compact_group_slot(
        shared, trace, g);
      continue;
    }
    const double lij = state->values[dep_pos] / dep_pivot;
    if (!kls_row_first_compact_window_l_append(state, dep, lij)) {
      kls_row_first_pipeline_discard_compact_group_slot(
        shared, trace, g);
      continue;
    }
    state->values[dep_pos] = 0.0;
    shared->compact_batch_targets[g].state = state;
    shared->compact_batch_targets[g].lij = lij;
    if (group_cache_available &&
        (state->deferred_output_valid ||
         row_entries >= shared->compact_group_output_min_u_entries) &&
        kls_row_first_compact_window_deferred_output_begin_dep(
          state, &state->trace_current)) {
      shared->compact_batch_targets[g].group_output_cache = 1;
    } else if (shared->compact_deferred_output_cache_enabled &&
        shared->compact_window_delay_output_enabled &&
        (state->deferred_output_valid ||
         row_entries >= shared->compact_deferred_output_min_u_entries) &&
        kls_row_first_compact_window_deferred_output_begin_dep(
          state, &state->trace_current)) {
      shared->compact_batch_targets[g].deferred_output_cache = 1;
    }
    kls_row_first_stats_add(&state->trace_current.scalar_dep_calls, 1u);
    kls_row_first_stats_add(&state->trace_current.scalar_dep_l_entries, 1u);
    kls_row_first_stats_add(&state->trace_current.scalar_dep_u_entries,
                            row_entries);
    live_targets++;
  }
  if (live_targets == 0u) {
    kls_row_first_pipeline_clear_compact_group(shared);
    return;
  }

  UF_long group_update_values = 0u;
  for (UF_long up = row_begin; up < row_end; ++up) {
    const UF_long col = shared->u_entries->col[up];
    const double uvalue = shared->u_entries->value[up];
    for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
      kls_row_first_compact_batch_target *target =
        shared->compact_batch_targets + g;
      kls_row_first_compact_window_state *state = target->state;
      if (state == NULL || !state->active || !state->grouped) {
        target->state = NULL;
        continue;
      }
      if (shared->compact_window_delay_output_enabled &&
          col >= state->row) {
        if (target->group_output_cache) {
          if (!kls_row_first_pipeline_sparse_group_output_cache_store(
                shared, &state->trace_current, g, col,
                -target->lij * uvalue)) {
            target->group_output_cache = 0;
          }
        } else if (target->deferred_output_cache &&
            !kls_row_first_compact_window_deferred_output_insert(
              state, col, -target->lij * uvalue,
              shared->compact_deferred_output_max_entries,
              &state->trace_current)) {
          target->deferred_output_cache = 0;
        }
        kls_row_first_stats_add(
          &state->trace_current.compact_window_delayed_output_skips, 1u);
        continue;
      }
      UF_long value_pos = KLS_KLU_EMPTY;
      if (!kls_row_first_compact_window_prepare_update_pos(
            state, state->row, col, shared->compact_window_max_entries,
            &value_pos, NULL) ||
          value_pos >= state->pattern_count ||
          state->values == NULL) {
        kls_row_first_pipeline_discard_compact_group_slot(
          shared, trace, g);
        target->state = NULL;
        continue;
      }
      state->values[value_pos] -= target->lij * uvalue;
      group_update_values =
        group_update_values == UF_long_max
          ? UF_long_max : group_update_values + 1u;
      if (col < state->row) {
        kls_row_first_stats_add(
          &state->trace_current.scalar_u_internal_entries, 1u);
      } else {
        kls_row_first_stats_add(
          &state->trace_current.scalar_u_output_entries, 1u);
      }
    }
  }

  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    kls_row_first_compact_batch_target *target =
      shared->compact_batch_targets + g;
    if (target->deferred_output_cache && target->state != NULL &&
        target->state->active && target->state->grouped) {
      (void)kls_row_first_compact_window_deferred_output_finish_dep(
        target->state, &target->state->trace_current);
    }
    if (target->group_output_cache && target->state != NULL &&
        target->state->active && target->state->grouped &&
        shared->compact_group_output_cache_active) {
      (void)kls_row_first_compact_window_deferred_output_finish_dep(
        target->state, &target->state->trace_current);
    }
    target->deferred_output_cache = 0;
    target->group_output_cache = 0;
  }

  UF_long retained_targets = 0u;
  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    const int slot = shared->compact_group_slots[g];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (state->active && state->grouped) {
      retained_targets++;
    }
  }
  if (retained_targets == 0u) {
    kls_row_first_pipeline_clear_compact_group(shared);
    return;
  }
  if (trace != NULL) {
    kls_row_first_stats_add(&trace->compact_window_group_steps, 1u);
    kls_row_first_stats_add(&trace->compact_window_group_targets,
                            retained_targets);
    kls_row_first_stats_add(&trace->compact_window_group_cols,
                            row_entries);
    kls_row_first_stats_add(&trace->compact_window_group_values,
                            group_update_values);
  }

  const UF_long root_dep =
    kls_row_first_pipeline_compact_group_common_root(shared, 2u);
  kls_row_first_pipeline_compact_group_keep_root(shared, trace, root_dep);
}

static void kls_row_first_pipeline_update_compact_group_producer(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long dep) {
  if (shared == NULL || !shared->compact_group_active ||
      shared->compact_group_dep != dep ||
      shared->compact_group_target_count == 0u ||
      shared->compact_group_slots == NULL ||
      shared->compact_batch_targets == NULL ||
      shared->compact_window_states == NULL ||
      shared->workspace == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL ||
      shared->u_entries == NULL ||
      shared->udiag_values == NULL ||
      shared->ctx == NULL || dep >= shared->ctx->nk) {
    return;
  }
  if (shared->compact_group_sparse) {
    kls_row_first_pipeline_update_compact_sparse_group_producer(
      shared, trace, dep);
    return;
  }
  if (shared->compact_group_cols == NULL ||
      shared->compact_group_pos == NULL ||
      shared->compact_group_mark == NULL ||
      shared->compact_group_values == NULL ||
      shared->compact_group_flags == NULL) {
    return;
  }
  const double dep_pivot = shared->udiag_values[dep];
  if (dep_pivot == 0.0) {
    kls_row_first_pipeline_clear_compact_group(shared);
    return;
  }
  const UF_long row_begin = shared->workspace->u_row_ptr[dep];
  const UF_long row_end = shared->workspace->u_row_end[dep];
  if (row_begin > row_end || row_end > shared->u_entries->count) {
    kls_row_first_pipeline_clear_compact_group(shared);
    return;
  }
  for (UF_long up = row_begin; up < row_end; ++up) {
    const UF_long col = shared->u_entries->col[up];
    if (col <= dep || col >= shared->ctx->nk ||
        !kls_row_first_pipeline_compact_group_ensure_col(shared, col)) {
      kls_row_first_pipeline_clear_compact_group(shared);
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
      return;
    }
  }

  const UF_long row_entries = row_end - row_begin;
  UF_long live_targets = 0u;
  for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
    const int slot = shared->compact_group_slots[g];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (!state->active || !state->grouped) {
      continue;
    }
    unsigned char *flags =
      shared->compact_group_flags + g * shared->compact_group_stride;
    double *values =
      shared->compact_group_values + g * shared->compact_group_stride;
    const UF_long current_dep =
      state->heap_size > 0u ? state->heap[0] : KLS_KLU_EMPTY;
    const UF_long dep_pos = shared->compact_group_pos[dep];
    if (current_dep != dep || dep_pos >= shared->compact_group_union_count ||
        (flags[dep_pos] & 2u) == 0u ||
        !kls_row_first_compact_window_l_reserve(
          state, state->l_count + 1u)) {
      kls_row_first_pipeline_unlink_compact_window_state(shared, state);
      kls_row_first_pipeline_untrack_compact_window_state(shared, state);
      kls_row_first_compact_window_state_clear(state);
      shared->compact_group_slots[g] = -1;
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
      continue;
    }
    const UF_long popped =
      kls_row_first_heap_pop(state->heap, &state->heap_size);
    if (popped != dep) {
      kls_row_first_pipeline_unlink_compact_window_state(shared, state);
      kls_row_first_pipeline_untrack_compact_window_state(shared, state);
      kls_row_first_compact_window_state_clear(state);
      shared->compact_group_slots[g] = -1;
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
      continue;
    }
    const double lij = values[dep_pos] / dep_pivot;
    if (!kls_row_first_compact_window_l_append(state, dep, lij)) {
      kls_row_first_pipeline_unlink_compact_window_state(shared, state);
      kls_row_first_pipeline_untrack_compact_window_state(shared, state);
      kls_row_first_compact_window_state_clear(state);
      shared->compact_group_slots[g] = -1;
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
      continue;
    }
    shared->compact_batch_targets[g].lij = lij;
    values[dep_pos] = 0.0;
    flags[dep_pos] = (unsigned char)(flags[dep_pos] & ~2u);
    flags[dep_pos] |= 1u;
    kls_row_first_stats_add(&state->trace_current.scalar_dep_calls, 1u);
    kls_row_first_stats_add(&state->trace_current.scalar_dep_l_entries, 1u);
    kls_row_first_stats_add(&state->trace_current.scalar_dep_u_entries,
                            row_entries);
    live_targets++;
  }
  if (live_targets == 0u) {
    kls_row_first_pipeline_clear_compact_group(shared);
    return;
  }

  UF_long internal_entries = 0u;
  UF_long output_entries = 0u;
  for (UF_long up = row_begin; up < row_end; ++up) {
    const UF_long col = shared->u_entries->col[up];
    const UF_long pos = shared->compact_group_pos[col];
    const double uvalue = shared->u_entries->value[up];
    if (pos >= shared->compact_group_union_count) {
      kls_row_first_pipeline_clear_compact_group(shared);
      return;
    }
    for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
      const int slot = shared->compact_group_slots[g];
      if (slot < 0 || slot >= shared->compact_window_count) {
        continue;
      }
      kls_row_first_compact_window_state *state =
        shared->compact_window_states + slot;
      if (!state->active || !state->grouped) {
        continue;
      }
      unsigned char *flags =
        shared->compact_group_flags + g * shared->compact_group_stride;
      double *values =
        shared->compact_group_values + g * shared->compact_group_stride;
      const unsigned char old_flags = flags[pos];
      if ((old_flags & 1u) == 0u) {
        if (state->group_member_count >=
              shared->compact_window_max_entries ||
            !kls_row_first_compact_window_reserve(
              state, state->group_member_count + 1u,
              shared->compact_window_max_entries)) {
          kls_row_first_pipeline_unlink_compact_window_state(shared, state);
          kls_row_first_pipeline_untrack_compact_window_state(shared, state);
          kls_row_first_compact_window_state_clear(state);
          shared->compact_group_slots[g] = -1;
          if (trace != NULL) {
            kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
          }
          continue;
        }
        state->group_member_count++;
      }
      flags[pos] |= 1u;
      values[pos] -= shared->compact_batch_targets[g].lij * uvalue;
      if (col < state->row) {
        if ((old_flags & 2u) == 0u) {
          if (state->heap_size >= state->pattern_capacity) {
            if (!kls_row_first_compact_window_reserve(
                  state, state->group_member_count,
                  shared->compact_window_max_entries)) {
              kls_row_first_pipeline_unlink_compact_window_state(
                shared, state);
              kls_row_first_pipeline_untrack_compact_window_state(
                shared, state);
              kls_row_first_compact_window_state_clear(state);
              shared->compact_group_slots[g] = -1;
              if (trace != NULL) {
                kls_row_first_stats_add(&trace->compact_window_overflows,
                                        1u);
              }
              continue;
            }
          }
          kls_row_first_heap_push(state->heap, &state->heap_size, col);
        }
        flags[pos] |= 2u;
        internal_entries++;
        kls_row_first_stats_add(
          &state->trace_current.scalar_u_internal_entries, 1u);
      } else {
        output_entries++;
        kls_row_first_stats_add(
          &state->trace_current.scalar_u_output_entries, 1u);
      }
    }
  }
  if (trace != NULL) {
    kls_row_first_stats_add(&trace->compact_window_group_steps, 1u);
    kls_row_first_stats_add(&trace->compact_window_group_targets,
                            live_targets);
    kls_row_first_stats_add(&trace->compact_window_group_cols,
                            shared->compact_group_union_count);
    if (shared->compact_group_union_count <=
        UF_long_max / live_targets) {
      kls_row_first_stats_add(
        &trace->compact_window_group_values,
        shared->compact_group_union_count * live_targets);
    }
    (void)internal_entries;
    (void)output_entries;
  }

  const UF_long root_dep =
    kls_row_first_pipeline_compact_group_common_root(shared, 2u);
  kls_row_first_pipeline_compact_group_keep_root(shared, trace, root_dep);
}

static int kls_row_first_pipeline_try_compact_window_union_batch(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long dep,
  UF_long row_begin,
  UF_long row_end,
  UF_long row_entries,
  UF_long target_count,
  UF_long *handled_out) {
  if (handled_out != NULL) {
    *handled_out = 0u;
  }
  if (shared == NULL || shared->ctx == NULL ||
      shared->compact_batch_targets == NULL ||
      shared->compact_union_mark == NULL ||
      shared->compact_union_pos == NULL ||
      shared->compact_window_max_entries == 0u ||
      target_count == 0u ||
      (!shared->compact_group_active && target_count < 2u) ||
      row_entries == 0u ||
      dep >= shared->ctx->nk) {
    return 1;
  }
  if (shared->compact_window_delay_output_enabled) {
    return 1;
  }
  if (shared->compact_group_sparse_enabled) {
    return 1;
  }
  for (UF_long up = row_begin; up < row_end; ++up) {
    const UF_long col = shared->u_entries->col[up];
    if (col <= dep || col >= shared->ctx->nk) {
      return 0;
    }
  }

  unsigned int generation = shared->compact_union_generation + 1u;
  if (generation == 0u) {
    memset(shared->compact_union_mark, 0,
           (size_t)shared->ctx->nk *
             sizeof(*shared->compact_union_mark));
    generation = 1u;
  }
  shared->compact_union_generation = generation;

  UF_long union_count = 0u;
  UF_long active_targets = 0u;
  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_compact_window_state *state =
      shared->compact_batch_targets[t].state;
    if (state == NULL || !state->active || state->pattern == NULL ||
        state->values == NULL ||
        state->pattern_count > shared->compact_window_max_entries) {
      shared->compact_batch_targets[t].state = NULL;
      continue;
    }
    for (UF_long p = 0; p < state->pattern_count; ++p) {
      const UF_long col = state->pattern[p];
      if (col >= shared->ctx->nk ||
          !kls_row_first_compact_union_add_col(shared, col,
                                               &union_count)) {
        return 1;
      }
    }
    active_targets++;
  }
  if (active_targets == 0u ||
      (!shared->compact_group_active && active_targets < 2u)) {
    return 1;
  }
  for (UF_long up = row_begin; up < row_end; ++up) {
    if (!kls_row_first_compact_union_add_col(
          shared, shared->u_entries->col[up], &union_count)) {
      return 1;
    }
  }
  if (union_count == 0u ||
      active_targets > UF_long_max / union_count) {
    return 1;
  }
  const UF_long matrix_count = active_targets * union_count;
  const UF_long sparse_matrix_count =
    active_targets > UF_long_max / row_entries
      ? UF_long_max : active_targets * row_entries;
  const UF_long dense_union_limit =
    row_entries > UF_long_max /
                    KLS_ROW_FIRST_COMPACT_DENSE_UNION_MAX_SPARSE_MULT
      ? UF_long_max
      : row_entries *
          KLS_ROW_FIRST_COMPACT_DENSE_UNION_MAX_SPARSE_MULT;
  if (union_count > dense_union_limit) {
    if (trace != NULL) {
      kls_row_first_stats_add(&trace->compact_window_union_skips, 1u);
      kls_row_first_stats_add(&trace->compact_window_union_skip_targets,
                              active_targets);
      kls_row_first_stats_add(&trace->compact_window_union_skip_cols,
                              union_count);
      kls_row_first_stats_add(&trace->compact_window_union_skip_values,
                              matrix_count);
      kls_row_first_stats_add(
        &trace->compact_window_union_skip_sparse_values,
        sparse_matrix_count);
    }
    return 1;
  }
  if (!kls_row_first_pipeline_reserve_compact_union_matrix(
        shared, matrix_count)) {
    return 1;
  }
  memset(shared->compact_union_values, 0,
         (size_t)matrix_count * sizeof(*shared->compact_union_values));
  memset(shared->compact_union_flags, 0,
         (size_t)matrix_count * sizeof(*shared->compact_union_flags));

  if (handled_out != NULL) {
    *handled_out = 1u;
  }
  UF_long dense_target = 0u;
  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_compact_batch_target *target =
      shared->compact_batch_targets + t;
    kls_row_first_compact_window_state *state = target->state;
    if (state == NULL || !state->active) {
      continue;
    }
    target->dep_pos = dense_target;
    unsigned char *flags =
      shared->compact_union_flags + dense_target * union_count;
    double *values =
      shared->compact_union_values + dense_target * union_count;
    for (UF_long p = 0; p < state->pattern_count; ++p) {
      const UF_long col = state->pattern[p];
      const UF_long pos = shared->compact_union_pos[col];
      if (pos >= union_count) {
        return 1;
      }
      values[pos] = state->values[p];
      flags[pos] |= 1u;
    }
    if (state->heap_size > 0u) {
      const UF_long popped =
        kls_row_first_heap_pop(state->heap, &state->heap_size);
      if (popped != dep ||
          !kls_row_first_compact_window_l_append(
            state, dep, target->lij)) {
        kls_row_first_pipeline_clear_compact_window_state(shared, state);
        target->state = NULL;
        if (trace != NULL) {
          kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
        }
        continue;
      }
    }
    for (UF_long p = 0; p < state->heap_size; ++p) {
      const UF_long col = state->heap[p];
      if (col >= shared->ctx->nk ||
          shared->compact_union_mark[col] !=
            shared->compact_union_generation) {
        return 1;
      }
      flags[shared->compact_union_pos[col]] |= 2u;
    }
    const UF_long dep_pos = shared->compact_union_pos[dep];
    if (dep_pos < union_count) {
      values[dep_pos] = 0.0;
    }
    kls_row_first_stats_add(&state->trace_current.scalar_dep_calls, 1u);
    kls_row_first_stats_add(&state->trace_current.scalar_dep_l_entries, 1u);
    kls_row_first_stats_add(&state->trace_current.scalar_dep_u_entries,
                            row_entries);
    dense_target++;
  }
  active_targets = dense_target;
  if (active_targets == 0u) {
    return 1;
  }

  for (UF_long up = row_begin; up < row_end; ++up) {
    const UF_long col = shared->u_entries->col[up];
    const UF_long pos = shared->compact_union_pos[col];
    const double uvalue = shared->u_entries->value[up];
    if (pos >= union_count) {
      return 1;
    }
    for (UF_long t = 0; t < target_count; ++t) {
      kls_row_first_compact_batch_target *target =
        shared->compact_batch_targets + t;
      kls_row_first_compact_window_state *state = target->state;
      if (state == NULL || !state->active) {
        continue;
      }
      const UF_long row_slot = target->dep_pos;
      if (row_slot >= active_targets) {
        return 1;
      }
      unsigned char *flags =
        shared->compact_union_flags + row_slot * union_count;
      double *values =
        shared->compact_union_values + row_slot * union_count;
      flags[pos] |= 1u;
      values[pos] -= target->lij * uvalue;
      if (col < state->row) {
        flags[pos] |= 2u;
        kls_row_first_stats_add(
          &state->trace_current.scalar_u_internal_entries, 1u);
      } else {
        kls_row_first_stats_add(
          &state->trace_current.scalar_u_output_entries, 1u);
      }
    }
  }

  if (shared->compact_group_active) {
    (void)kls_row_first_pipeline_merge_compact_group_batch(
      shared, trace, target_count, active_targets, union_count,
      union_count);
  } else if (kls_row_first_pipeline_reserve_compact_batch_positions(
               shared, target_count)) {
    const UF_long root_dep =
      kls_row_first_pipeline_compact_batch_common_root(
        shared, target_count, union_count, union_count, 2u);
    if (root_dep != KLS_KLU_EMPTY) {
      (void)kls_row_first_pipeline_promote_compact_group(
        shared, target_count, union_count, union_count, root_dep);
    }
  }

  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_compact_batch_target *target =
      shared->compact_batch_targets + t;
    kls_row_first_compact_window_state *state = target->state;
    if (state == NULL || !state->active) {
      target->state = NULL;
      continue;
    }
    const UF_long row_slot = target->dep_pos;
    if (row_slot >= active_targets) {
      kls_row_first_pipeline_clear_compact_window_state(shared, state);
      target->state = NULL;
      continue;
    }
    (void)kls_row_first_pipeline_scatter_compact_dense_row(
      shared, trace, state, shared->compact_union_cols,
      shared->compact_union_flags + row_slot * union_count,
      shared->compact_union_values + row_slot * union_count,
      union_count);
    target->state = NULL;
  }

  if (trace != NULL) {
    kls_row_first_stats_add(&trace->compact_window_batches, 1u);
    kls_row_first_stats_add(&trace->compact_window_stream_u_entries,
                            row_entries);
    kls_row_first_stats_add(&trace->compact_window_union_batches, 1u);
    kls_row_first_stats_add(&trace->compact_window_union_targets,
                            active_targets);
    kls_row_first_stats_add(&trace->compact_window_union_cols,
                            union_count);
    kls_row_first_stats_add(&trace->compact_window_union_values,
                            matrix_count);
  }
  if (handled_out != NULL) {
    *handled_out = 1u;
  }
  return 1;
}

static void kls_row_first_pipeline_apply_compact_window_producer_batch(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long dep,
  UF_long row_begin,
  UF_long row_end,
  UF_long row_entries) {
  if (shared == NULL || shared->compact_batch_targets == NULL ||
      shared->compact_window_states == NULL ||
      shared->compact_batch_target_capacity <= 0 ||
      shared->ctx == NULL || shared->u_entries == NULL ||
      shared->udiag_values == NULL || dep >= shared->ctx->nk) {
    return;
  }
  const double dep_pivot = shared->udiag_values[dep];
  if (dep_pivot == 0.0) {
    return;
  }

  UF_long target_count = 0u;
  if (shared->compact_root_heads != NULL) {
    int slot = shared->compact_root_heads[dep];
    shared->compact_root_heads[dep] = -1;
    int guard = 0;
    while (slot >= 0 && slot < shared->compact_window_count &&
           guard++ < shared->compact_window_count) {
      kls_row_first_compact_window_state *state =
        shared->compact_window_states + slot;
      const int next_slot = state->bucket_next;
      state->bucket_dep = KLS_KLU_EMPTY;
      state->bucket_next = -1;
      state->bucket_linked = 0;
      if (!state->active) {
        slot = next_slot;
        continue;
      }
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_probes, 1u);
      }
      if (state->row <= dep || state->heap_size == 0u ||
          state->heap[0] != dep) {
        (void)kls_row_first_pipeline_register_compact_window_state(
          shared, state);
        slot = next_slot;
        continue;
      }
      UF_long dep_pos = KLS_KLU_EMPTY;
      if (!kls_row_first_compact_window_value_pos(state, dep, &dep_pos) ||
          dep_pos >= state->pattern_count ||
          target_count >= (UF_long)shared->compact_batch_target_capacity ||
          !kls_row_first_compact_window_l_reserve(
            state, state->l_count + 1u)) {
        kls_row_first_pipeline_clear_compact_window_state(shared, state);
        if (trace != NULL) {
          kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
        }
        slot = next_slot;
        continue;
      }
      shared->compact_batch_targets[target_count].state = state;
      shared->compact_batch_targets[target_count].dep_pos = dep_pos;
      shared->compact_batch_targets[target_count].lij =
        state->values[dep_pos] / dep_pivot;
      target_count++;
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_targets, 1u);
        kls_row_first_stats_add(&trace->compact_window_target_u_entries,
                                row_entries);
        kls_row_first_stats_add(&trace->compact_window_state_rows,
                                state->pattern_count);
      }
      slot = next_slot;
    }
  } else {
    for (int slot = 0; slot < shared->compact_window_count; ++slot) {
      kls_row_first_compact_window_state *state =
        shared->compact_window_states + slot;
      if (!state->active) {
        continue;
      }
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_probes, 1u);
      }
      if (state->row <= dep || state->heap_size == 0u ||
          state->heap[0] != dep) {
        continue;
      }
      UF_long dep_pos = KLS_KLU_EMPTY;
      if (!kls_row_first_compact_window_value_pos(state, dep, &dep_pos) ||
          dep_pos >= state->pattern_count ||
          target_count >= (UF_long)shared->compact_batch_target_capacity ||
          !kls_row_first_compact_window_l_reserve(
            state, state->l_count + 1u)) {
        kls_row_first_pipeline_clear_compact_window_state(shared, state);
        if (trace != NULL) {
          kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
        }
        continue;
      }
      shared->compact_batch_targets[target_count].state = state;
      shared->compact_batch_targets[target_count].dep_pos = dep_pos;
      shared->compact_batch_targets[target_count].lij =
        state->values[dep_pos] / dep_pivot;
      target_count++;
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_targets, 1u);
        kls_row_first_stats_add(&trace->compact_window_target_u_entries,
                                row_entries);
        kls_row_first_stats_add(&trace->compact_window_state_rows,
                                state->pattern_count);
      }
    }
  }
  if (target_count == 0u) {
    return;
  }
  if (trace != NULL) {
    kls_row_first_pipeline_trace_compact_window_state_union(
      shared, trace, target_count);
  }
  UF_long active_target_count = 0u;
  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_compact_window_state *state =
      shared->compact_batch_targets[t].state;
    if (state == NULL || !state->active) {
      shared->compact_batch_targets[t].state = NULL;
      continue;
    }
    if (row_entries <= shared->compact_window_max_entries &&
        state->pattern_count <=
          shared->compact_window_max_entries - row_entries &&
        !kls_row_first_compact_window_reserve(
          state, state->pattern_count + row_entries,
          shared->compact_window_max_entries)) {
      kls_row_first_pipeline_clear_compact_window_state(shared, state);
      shared->compact_batch_targets[t].state = NULL;
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
      continue;
    }
    active_target_count++;
  }
  if (active_target_count == 0u) {
    return;
  }
  UF_long union_handled = 0u;
  if (!kls_row_first_pipeline_try_compact_window_union_batch(
        shared, trace, dep, row_begin, row_end, row_entries, target_count,
        &union_handled)) {
    for (UF_long t = 0; t < target_count; ++t) {
      if (shared->compact_batch_targets[t].state != NULL) {
        kls_row_first_pipeline_clear_compact_window_state(
          shared, shared->compact_batch_targets[t].state);
        shared->compact_batch_targets[t].state = NULL;
      }
    }
    if (trace != NULL) {
      kls_row_first_stats_add(&trace->compact_window_overflows,
                              target_count);
    }
    return;
  }
  if (union_handled) {
    return;
  }
  for (UF_long up = row_begin; up < row_end; ++up) {
    const UF_long col = shared->u_entries->col[up];
    if (col <= dep || col >= shared->ctx->nk) {
      for (UF_long t = 0; t < target_count; ++t) {
        if (shared->compact_batch_targets[t].state != NULL) {
          kls_row_first_pipeline_clear_compact_window_state(
            shared, shared->compact_batch_targets[t].state);
          shared->compact_batch_targets[t].state = NULL;
        }
      }
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows,
                                target_count);
      }
      return;
    }
  }
  if (row_entries > 0u && target_count > UF_long_max / row_entries) {
    for (UF_long t = 0; t < target_count; ++t) {
      if (shared->compact_batch_targets[t].state != NULL) {
        kls_row_first_pipeline_clear_compact_window_state(
          shared, shared->compact_batch_targets[t].state);
        shared->compact_batch_targets[t].state = NULL;
      }
    }
    if (trace != NULL) {
      kls_row_first_stats_add(&trace->compact_window_overflows,
                              target_count);
    }
    return;
  }
  const UF_long position_count = target_count * row_entries;
  if (!kls_row_first_pipeline_reserve_compact_batch_positions(
        shared, position_count)) {
    for (UF_long t = 0; t < target_count; ++t) {
      if (shared->compact_batch_targets[t].state != NULL) {
        kls_row_first_pipeline_clear_compact_window_state(
          shared, shared->compact_batch_targets[t].state);
        shared->compact_batch_targets[t].state = NULL;
      }
    }
    if (trace != NULL) {
      kls_row_first_stats_add(&trace->compact_window_overflows,
                              target_count);
    }
    return;
  }
  for (UF_long t = 0; t < target_count; ++t) {
    UF_long *target_positions =
      shared->compact_batch_positions + t * row_entries;
    for (UF_long local = 0; local < row_entries; ++local) {
      target_positions[local] = KLS_KLU_EMPTY;
    }
  }
  for (UF_long up = row_begin, local = 0u; up < row_end; ++up, ++local) {
    const UF_long col = shared->u_entries->col[up];
    for (UF_long t = 0; t < target_count; ++t) {
      kls_row_first_compact_batch_target *target =
        shared->compact_batch_targets + t;
      kls_row_first_compact_window_state *state = target->state;
      if (state == NULL || !state->active) {
        target->state = NULL;
        continue;
      }
      if (shared->compact_window_delay_output_enabled &&
          col >= state->row) {
        continue;
      }
      UF_long value_pos = KLS_KLU_EMPTY;
      if (!kls_row_first_compact_window_prepare_update_pos(
            state, state->row, col, shared->compact_window_max_entries,
            &value_pos, NULL) ||
          value_pos >= state->pattern_count) {
        kls_row_first_pipeline_clear_compact_window_state(shared, state);
        target->state = NULL;
        if (trace != NULL) {
          kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
        }
        continue;
      }
      shared->compact_batch_positions[t * row_entries + local] = value_pos;
    }
  }
  active_target_count = 0u;
  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_compact_window_state *state =
      shared->compact_batch_targets[t].state;
    if (state != NULL && state->active) {
      active_target_count++;
    }
  }
  if (active_target_count == 0u) {
    return;
  }
  if (trace != NULL) {
    kls_row_first_stats_add(&trace->compact_window_batches, 1u);
    kls_row_first_stats_add(&trace->compact_window_stream_u_entries,
                            row_entries);
  }

  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_compact_batch_target *target =
      shared->compact_batch_targets + t;
    kls_row_first_compact_window_state *state = target->state;
    if (state == NULL || !state->active) {
      target->state = NULL;
      continue;
    }
    const UF_long popped =
      kls_row_first_heap_pop(state->heap, &state->heap_size);
    if (popped != dep ||
        !kls_row_first_compact_window_l_append(state, dep, target->lij)) {
      kls_row_first_pipeline_clear_compact_window_state(shared, state);
      target->state = NULL;
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
      continue;
    }
    state->values[target->dep_pos] = 0.0;
    kls_row_first_stats_add(&state->trace_current.scalar_dep_calls, 1u);
    kls_row_first_stats_add(&state->trace_current.scalar_dep_l_entries, 1u);
    kls_row_first_stats_add(&state->trace_current.scalar_dep_u_entries,
                            row_entries);
  }

  for (UF_long up = row_begin, local = 0u; up < row_end; ++up, ++local) {
    const UF_long col = shared->u_entries->col[up];
    const double uvalue = shared->u_entries->value[up];
    for (UF_long t = 0; t < target_count; ++t) {
      kls_row_first_compact_batch_target *target =
        shared->compact_batch_targets + t;
      kls_row_first_compact_window_state *state = target->state;
      if (state == NULL || !state->active) {
        target->state = NULL;
        continue;
      }
      const UF_long value_pos =
        shared->compact_batch_positions[t * row_entries + local];
      if (shared->compact_window_delay_output_enabled &&
          col >= state->row) {
        kls_row_first_stats_add(
          &state->trace_current.compact_window_delayed_output_skips, 1u);
        continue;
      }
      if (value_pos >= state->pattern_count || state->values == NULL) {
        kls_row_first_pipeline_clear_compact_window_state(shared, state);
        target->state = NULL;
        if (trace != NULL) {
          kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
        }
        continue;
      }
      state->values[value_pos] -= target->lij * uvalue;
      if (col < state->row) {
        kls_row_first_stats_add(
          &state->trace_current.scalar_u_internal_entries, 1u);
      } else {
        kls_row_first_stats_add(
          &state->trace_current.scalar_u_output_entries, 1u);
      }
    }
  }
  if (shared->compact_group_sparse_enabled) {
    if (shared->compact_group_active &&
        shared->compact_group_sparse) {
      (void)kls_row_first_pipeline_merge_compact_sparse_group_targets(
        shared, trace, target_count);
    } else if (!shared->compact_group_active) {
      const UF_long root_dep =
        kls_row_first_pipeline_compact_targets_common_root(
          shared, target_count, 2u);
      if (root_dep != KLS_KLU_EMPTY) {
        (void)kls_row_first_pipeline_promote_compact_sparse_group(
          shared, target_count, root_dep);
      }
    }
  }
  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_compact_window_state *state =
      shared->compact_batch_targets[t].state;
    if (state != NULL && state->active &&
        !kls_row_first_pipeline_register_compact_window_state(
          shared, state)) {
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
    }
    shared->compact_batch_targets[t].state = NULL;
  }
}

static void kls_row_first_pipeline_clear_compact_window(
  kls_row_first_pipeline_shared *shared) {
  if (shared == NULL || shared->compact_window_states == NULL) {
    return;
  }
  kls_row_first_pipeline_clear_compact_group(shared);
  if (shared->compact_root_heads != NULL && shared->ctx != NULL) {
    for (UF_long dep = 0; dep < shared->ctx->nk; ++dep) {
      shared->compact_root_heads[dep] = -1;
    }
  }
  for (int slot = 0; slot < shared->compact_window_count; ++slot) {
    kls_row_first_compact_window_state_clear(
      shared->compact_window_states + slot);
  }
  if (shared->compact_pos_slots != NULL && shared->ctx != NULL) {
    for (UF_long pos = 0; pos < shared->ctx->nk; ++pos) {
      shared->compact_pos_slots[pos] = -1;
    }
  }
  shared->compact_window_active_count = 0u;
  shared->compact_window_scan_slot = 0;
  shared->compact_window_next_pos = shared->compact_window_execute_enabled
    ? (UF_long)atomic_load_explicit(&shared->next_pos, memory_order_acquire)
    : shared->completed_pos;
  shared->compact_window_evict_pos = shared->completed_pos;
}

static int kls_row_first_pipeline_fill_compact_window(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace) {
  if (shared == NULL || !shared->compact_window_enabled ||
      shared->compact_window_states == NULL ||
      shared->compact_window_count <= 0 || shared->ctx == NULL ||
      shared->row_order == NULL || shared->failed) {
    return 1;
  }
  const UF_long completed_pos = shared->completed_pos;
  const UF_long fill_pos =
    shared->compact_window_execute_enabled
      ? (UF_long)atomic_load_explicit(&shared->next_pos,
                                      memory_order_acquire)
      : completed_pos;
  if (shared->compact_window_next_pos < fill_pos) {
    shared->compact_window_next_pos = fill_pos;
  }
  if (shared->compact_window_evict_pos < shared->begin) {
    shared->compact_window_evict_pos = shared->begin;
  }
  while (shared->compact_window_evict_pos < completed_pos &&
         shared->compact_window_evict_pos < shared->ctx->nk) {
    const UF_long pos = shared->compact_window_evict_pos++;
    const int slot = shared->compact_pos_slots != NULL
      ? shared->compact_pos_slots[pos] : -1;
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (!state->active || state->pos != pos) {
      if (shared->compact_pos_slots != NULL) {
        shared->compact_pos_slots[pos] = -1;
      }
      continue;
    }
    if (trace != NULL) {
      kls_row_first_stats_add(&trace->compact_window_evictions, 1u);
    }
    if (state->grouped) {
      kls_row_first_pipeline_clear_compact_group(shared);
    } else {
      kls_row_first_pipeline_clear_compact_window_state(shared, state);
    }
  }

  while (shared->compact_window_active_count <
           (UF_long)shared->compact_window_count &&
         shared->compact_window_next_pos < shared->end) {
    const int slot =
      kls_row_first_pipeline_find_free_compact_window_slot(shared);
    if (slot < 0) {
      break;
    }
    kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    int filled = 0;
    while (shared->compact_window_next_pos < shared->end) {
      const UF_long pos = shared->compact_window_next_pos++;
      if (pos < completed_pos) {
        continue;
      }
      if (pos >= shared->ctx->nk) {
        return 0;
      }
      const UF_long row = shared->row_order[pos];
      if (!kls_row_first_compact_window_state_begin(
            shared->ctx, state, pos, row,
            shared->compact_window_max_entries,
            shared->compact_window_execute_enabled)) {
        if (trace != NULL) {
          kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
        }
        continue;
      }
      state->trace_current.long_row_threshold =
        shared->long_row_trace_threshold;
      state->trace_current.long_row = row;
      state->trace_current.long_row_pos = pos;
      if (shared->compact_window_execute_enabled &&
          !kls_row_first_compact_window_apply_ready_until(
            shared, state, completed_pos)) {
        kls_row_first_compact_window_state_clear(state);
        if (trace != NULL) {
          kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
        }
        continue;
      }
      if (!kls_row_first_pipeline_track_compact_window_state(
            shared, state)) {
        kls_row_first_compact_window_state_clear(state);
        if (trace != NULL) {
          kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
        }
        continue;
      }
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_fills, 1u);
      }
      if (!kls_row_first_pipeline_register_compact_window_state(
            shared, state)) {
        kls_row_first_pipeline_clear_compact_window_state(shared, state);
        if (trace != NULL) {
          kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
        }
        continue;
      }
      filled = 1;
      break;
    }
    if (!filled) {
      break;
    }
  }
  return 1;
}

static void kls_row_first_pipeline_update_compact_window_producer(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long dep) {
  if (shared == NULL || !shared->compact_window_enabled ||
      shared->compact_window_states == NULL ||
      shared->compact_window_count <= 0 ||
      shared->workspace == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL ||
      shared->u_entries == NULL || shared->ctx == NULL ||
      dep >= shared->ctx->nk) {
    return;
  }
  if (!kls_row_first_pipeline_fill_compact_window(shared, trace)) {
    return;
  }
  const UF_long row_begin = shared->workspace->u_row_ptr[dep];
  const UF_long row_end = shared->workspace->u_row_end[dep];
  if (row_begin > row_end || row_end > shared->u_entries->count ||
      row_begin == row_end) {
    return;
  }
  const UF_long row_entries = row_end - row_begin;
  if (shared->compact_window_execute_enabled) {
    if (shared->compact_window_delay_output_enabled) {
      if (shared->compact_group_sparse_enabled) {
        kls_row_first_pipeline_update_compact_group_producer(
          shared, trace, dep);
      } else {
        kls_row_first_pipeline_clear_compact_group(shared);
      }
    } else {
      kls_row_first_pipeline_update_compact_group_producer(
        shared, trace, dep);
    }
    kls_row_first_pipeline_apply_compact_window_producer_batch(
      shared, trace, dep, row_begin, row_end, row_entries);
    return;
  }
  for (int slot = 0; slot < shared->compact_window_count; ++slot) {
    kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (!state->active) {
      continue;
    }
    if (trace != NULL) {
      kls_row_first_stats_add(&trace->compact_window_probes, 1u);
    }
    if (state->row <= dep || state->heap_size == 0u ||
        state->heap[0] != dep) {
      continue;
    }
    const UF_long popped =
      kls_row_first_heap_pop(state->heap, &state->heap_size);
    if (popped != dep) {
      kls_row_first_pipeline_clear_compact_window_state(shared, state);
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
      continue;
    }
    if (trace != NULL) {
      kls_row_first_stats_add(&trace->compact_window_targets, 1u);
      kls_row_first_stats_add(&trace->compact_window_target_u_entries,
                              row_entries);
      kls_row_first_stats_add(&trace->compact_window_state_rows,
                              state->pattern_count);
    }
    if (shared->compact_window_execute_enabled) {
      kls_row_first_heap_push(state->heap, &state->heap_size, dep);
      if (!kls_row_first_compact_window_apply_dep(
            shared, state, dep, &state->trace_current)) {
        kls_row_first_pipeline_clear_compact_window_state(shared, state);
        if (trace != NULL) {
          kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
        }
      }
      continue;
    }
    int overflow = 0;
    for (UF_long up = row_begin; up < row_end; ++up) {
      const UF_long col = shared->u_entries->col[up];
      if (col <= dep || col >= shared->ctx->nk) {
        overflow = 1;
        break;
      }
      if (!kls_row_first_compact_window_insert(
            state, state->row, col, 0.0,
            shared->compact_window_max_entries, NULL)) {
        overflow = 1;
        break;
      }
    }
    if (overflow) {
      kls_row_first_pipeline_clear_compact_window_state(shared, state);
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
    }
  }
}

static UF_long kls_row_first_pipeline_update_claim_run_producer(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_worker *worker,
  kls_row_first_pipeline_trace *trace,
  UF_long dep) {
  if (shared == NULL || worker == NULL ||
      worker->compact_claim_run_next >= worker->compact_claim_run_count ||
      worker->compact_claim_run_count >
        KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS ||
      shared->compact_window_states == NULL ||
      shared->compact_batch_targets == NULL ||
      shared->compact_batch_target_capacity <= 0 ||
      shared->ctx == NULL || shared->workspace == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL ||
      shared->u_entries == NULL || shared->udiag_values == NULL ||
      dep >= shared->ctx->nk) {
    return 0u;
  }
  const double dep_pivot = shared->udiag_values[dep];
  if (dep_pivot == 0.0) {
    return 0u;
  }
  const UF_long row_begin = shared->workspace->u_row_ptr[dep];
  const UF_long row_end = shared->workspace->u_row_end[dep];
  if (row_begin > row_end || row_end > shared->u_entries->count) {
    return 0u;
  }
  for (UF_long up = row_begin; up < row_end; ++up) {
    const UF_long col = shared->u_entries->col[up];
    if (col <= dep || col >= shared->ctx->nk) {
      return 0u;
    }
  }
  int stream_owner_active =
    shared->compact_claim_stream_owner_enabled &&
    worker->compact_claim_stream_owner_active &&
    worker->compact_claim_stream_owner_rows ==
      worker->compact_claim_run_count &&
    worker->compact_claim_stream_owner_rows > 0u &&
    worker->compact_claim_stream_owner_start_l_counts != NULL &&
    worker->compact_claim_stream_owner_l_counts != NULL &&
    worker->compact_claim_stream_owner_replay_entries != NULL &&
    shared->compact_union_mark != NULL &&
    shared->compact_union_pos != NULL;
  if (stream_owner_active &&
      worker->compact_claim_stream_owner_cols_count > 0u &&
      (worker->compact_claim_stream_owner_cols == NULL ||
       worker->compact_claim_stream_owner_values == NULL ||
       worker->compact_claim_stream_owner_mask == NULL ||
       worker->compact_claim_stream_owner_cols_count >
         worker->compact_claim_stream_owner_col_capacity ||
       worker->compact_claim_stream_owner_cols_count >
         worker->compact_claim_stream_owner_value_capacity /
           worker->compact_claim_stream_owner_rows)) {
    stream_owner_active = 0;
  }
  unsigned int stream_generation = 0u;
  if (stream_owner_active) {
    stream_generation =
      kls_row_first_pipeline_next_compact_union_generation(shared);
    if (stream_generation == 0u) {
      stream_owner_active = 0;
    } else {
      for (UF_long c = 0;
           c < worker->compact_claim_stream_owner_cols_count; ++c) {
        const UF_long col = worker->compact_claim_stream_owner_cols[c];
        if (col >= shared->ctx->nk) {
          stream_owner_active = 0;
          break;
        }
        shared->compact_union_mark[col] = stream_generation;
        shared->compact_union_pos[col] = c;
      }
    }
  }

  UF_long target_count = 0u;
  for (UF_long r = worker->compact_claim_run_next;
       r < worker->compact_claim_run_count; ++r) {
    const int slot = worker->compact_claim_run_slots[r];
    if (slot < 0 || slot >= shared->compact_window_count ||
        target_count >= (UF_long)shared->compact_batch_target_capacity) {
      continue;
    }
    kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (state == NULL || !state->active || state->grouped ||
        state->pos != worker->compact_claim_run_pos[r] ||
        state->row <= dep || state->heap_size == 0u ||
        state->heap[0] != dep) {
      continue;
    }
    UF_long dep_pos = KLS_KLU_EMPTY;
    if (!kls_row_first_compact_window_value_pos(state, dep, &dep_pos) ||
        dep_pos >= state->pattern_count ||
        !kls_row_first_compact_window_l_reserve(
          state, state->l_count + 1u)) {
      kls_row_first_pipeline_clear_compact_window_state(shared, state);
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
      continue;
    }
    const UF_long popped =
      kls_row_first_heap_pop(state->heap, &state->heap_size);
    if (popped != dep) {
      kls_row_first_pipeline_clear_compact_window_state(shared, state);
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
      continue;
    }
    const double lij = state->values[dep_pos] / dep_pivot;
    if (!kls_row_first_compact_window_l_append(state, dep, lij)) {
      kls_row_first_pipeline_clear_compact_window_state(shared, state);
      if (trace != NULL) {
        kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
      }
      continue;
    }
    state->values[dep_pos] = 0.0;
    shared->compact_batch_targets[target_count].state = state;
    shared->compact_batch_targets[target_count].dep_pos = r;
    shared->compact_batch_targets[target_count].lij = lij;
    shared->compact_batch_targets[target_count].deferred_output_cache = 0;
    shared->compact_batch_targets[target_count].group_output_cache = 0;
    if (!stream_owner_active &&
        shared->compact_deferred_output_cache_enabled &&
        shared->compact_window_delay_output_enabled &&
        (state->deferred_output_valid ||
         row_end - row_begin >= shared->compact_deferred_output_min_u_entries) &&
        kls_row_first_compact_window_deferred_output_begin_dep(
          state, &state->trace_current)) {
      shared->compact_batch_targets[target_count].deferred_output_cache = 1;
    }
    target_count++;
    kls_row_first_stats_add(&state->trace_current.scalar_dep_calls, 1u);
    kls_row_first_stats_add(&state->trace_current.scalar_dep_l_entries, 1u);
    kls_row_first_stats_add(&state->trace_current.scalar_dep_u_entries,
                            row_end - row_begin);
  }
  if (target_count == 0u) {
    return 0u;
  }

  for (UF_long up = row_begin; up < row_end; ++up) {
    const UF_long col = shared->u_entries->col[up];
    const double uvalue = shared->u_entries->value[up];
    for (UF_long t = 0; t < target_count; ++t) {
      kls_row_first_compact_batch_target *target =
        shared->compact_batch_targets + t;
      kls_row_first_compact_window_state *state = target->state;
      if (state == NULL || !state->active || state->grouped) {
        target->state = NULL;
        continue;
      }
      if (shared->compact_window_delay_output_enabled &&
          col >= state->row) {
        if (stream_owner_active) {
          const UF_long row_slot = target->dep_pos;
          if (row_slot >= worker->compact_claim_stream_owner_rows) {
            stream_owner_active = 0;
            worker->compact_claim_stream_owner_active = 0;
            worker->compact_claim_stream_owner_cols_count = 0u;
          } else {
            if (shared->compact_union_mark[col] != stream_generation) {
              const UF_long new_col =
                worker->compact_claim_stream_owner_cols_count;
              const UF_long rows =
                worker->compact_claim_stream_owner_rows;
              if (rows == 0u ||
                  new_col >=
                    shared->compact_claim_stream_owner_max_slots / rows ||
                  !kls_row_first_pipeline_worker_reserve_claim_stream_owner(
                    worker, rows, new_col + 1u)) {
                stream_owner_active = 0;
                worker->compact_claim_stream_owner_active = 0;
                worker->compact_claim_stream_owner_cols_count = 0u;
              } else {
                shared->compact_union_mark[col] = stream_generation;
                shared->compact_union_pos[col] = new_col;
                worker->compact_claim_stream_owner_cols[new_col] = col;
                for (UF_long rr = 0; rr < rows; ++rr) {
                  const UF_long at = new_col * rows + rr;
                  worker->compact_claim_stream_owner_values[at] = 0.0;
                  worker->compact_claim_stream_owner_mask[at] = 0u;
                }
                worker->compact_claim_stream_owner_cols_count = new_col + 1u;
              }
            }
            if (stream_owner_active &&
                shared->compact_union_mark[col] == stream_generation) {
              const UF_long col_pos = shared->compact_union_pos[col];
              const UF_long rows = worker->compact_claim_stream_owner_rows;
              const UF_long at = col_pos * rows + row_slot;
              if (col_pos >= worker->compact_claim_stream_owner_cols_count ||
                  at >= worker->compact_claim_stream_owner_value_capacity) {
                stream_owner_active = 0;
                worker->compact_claim_stream_owner_active = 0;
                worker->compact_claim_stream_owner_cols_count = 0u;
              } else {
                worker->compact_claim_stream_owner_values[at] -=
                  target->lij * uvalue;
                worker->compact_claim_stream_owner_mask[at] = 1u;
                kls_row_first_stats_add(
                  worker->compact_claim_stream_owner_replay_entries +
                    row_slot,
                  1u);
              }
            }
          }
        }
        if (!stream_owner_active) {
          if (target->deferred_output_cache &&
              !kls_row_first_compact_window_deferred_output_insert(
                state, col, -target->lij * uvalue,
                shared->compact_deferred_output_max_entries,
                &state->trace_current)) {
            target->deferred_output_cache = 0;
          }
          kls_row_first_stats_add(
            &state->trace_current.compact_window_delayed_output_skips, 1u);
        }
        continue;
      }
      UF_long value_pos = KLS_KLU_EMPTY;
      if (!kls_row_first_compact_window_prepare_update_pos(
            state, state->row, col, shared->compact_window_max_entries,
            &value_pos, NULL) ||
          value_pos >= state->pattern_count ||
          state->values == NULL) {
        kls_row_first_pipeline_clear_compact_window_state(shared, state);
        target->state = NULL;
        if (trace != NULL) {
          kls_row_first_stats_add(&trace->compact_window_overflows, 1u);
        }
        continue;
      }
      state->values[value_pos] -= target->lij * uvalue;
      if (col < state->row) {
        kls_row_first_stats_add(
          &state->trace_current.scalar_u_internal_entries, 1u);
      } else {
        kls_row_first_stats_add(
          &state->trace_current.scalar_u_output_entries, 1u);
      }
    }
  }
  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_compact_batch_target *target =
      shared->compact_batch_targets + t;
    if (target->deferred_output_cache && target->state != NULL &&
        target->state->active) {
      (void)kls_row_first_compact_window_deferred_output_finish_dep(
        target->state, &target->state->trace_current);
    }
    if (stream_owner_active && target->state != NULL &&
        target->dep_pos < worker->compact_claim_stream_owner_rows) {
      worker->compact_claim_stream_owner_l_counts[target->dep_pos] =
        target->state->l_count;
    }
    target->deferred_output_cache = 0;
    target->state = NULL;
  }
  if (trace != NULL) {
    kls_row_first_stats_add(&trace->compact_window_claim_run_updates, 1u);
    kls_row_first_stats_add(&trace->compact_window_claim_run_update_targets,
                            target_count);
  }
  return target_count;
}

static UF_long kls_row_first_pipeline_claim_run_ready_root(
  const kls_row_first_pipeline_shared *shared,
  const kls_row_first_pipeline_worker *worker) {
  if (shared == NULL || worker == NULL ||
      worker->compact_claim_run_next >= worker->compact_claim_run_count ||
      worker->compact_claim_run_count >
        KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS ||
      shared->compact_window_states == NULL || shared->ctx == NULL ||
      shared->row_done == NULL) {
    return KLS_KLU_EMPTY;
  }
  UF_long best = KLS_KLU_EMPTY;
  for (UF_long r = worker->compact_claim_run_next;
       r < worker->compact_claim_run_count; ++r) {
    const int slot = worker->compact_claim_run_slots[r];
    if (slot < 0 || slot >= shared->compact_window_count) {
      continue;
    }
    const kls_row_first_compact_window_state *state =
      shared->compact_window_states + slot;
    if (state == NULL || !state->active || state->grouped ||
        state->pos != worker->compact_claim_run_pos[r] ||
        state->row >= shared->ctx->nk ||
        state->heap_size == 0u) {
      continue;
    }
    const UF_long dep = state->heap[0];
    if (dep >= state->row || dep >= shared->ctx->nk ||
        !kls_row_first_dependency_ready(shared->row_done,
                                        shared->active_rank,
                                        shared->completed_pos, dep)) {
      continue;
    }
    if (best == KLS_KLU_EMPTY || dep < best) {
      best = dep;
    }
  }
  return best;
}

static void kls_row_first_pipeline_update_claim_run_ready(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_worker *worker,
  kls_row_first_pipeline_trace *trace) {
  if (shared == NULL || worker == NULL ||
      worker->compact_claim_run_next >= worker->compact_claim_run_count) {
    return;
  }
  UF_long guard = 0u;
  const UF_long guard_limit =
    worker->compact_claim_run_count <=
      KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS
      ? worker->compact_claim_run_count *
          KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS
      : KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS;
  while (guard++ < guard_limit) {
    const UF_long dep =
      kls_row_first_pipeline_claim_run_ready_root(shared, worker);
    if (dep == KLS_KLU_EMPTY) {
      break;
    }
    if (kls_row_first_pipeline_update_claim_run_producer(
          shared, worker, trace, dep) == 0u) {
      break;
    }
  }
}

static int kls_row_first_pipeline_fill_lookahead(
  kls_row_first_pipeline_shared *shared) {
  if (shared == NULL || shared->lookahead_states == NULL ||
      shared->lookahead_count <= 0 || shared->ctx == NULL ||
      shared->row_order == NULL || shared->private_u_entries == NULL ||
      shared->private_u_row_ptr == NULL ||
      shared->private_u_row_end == NULL ||
      shared->u_entries == NULL || shared->workspace == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL ||
      shared->udiag_values == NULL || shared->row_done == NULL ||
      shared->failed) {
    return 1;
  }
  const UF_long reserved_next =
    (UF_long)atomic_load_explicit(&shared->next_pos, memory_order_acquire);
  if (shared->lookahead_next_pos < reserved_next) {
    shared->lookahead_next_pos = reserved_next;
  }
  UF_long scan_budget =
    (UF_long)shared->lookahead_count * 4u + (UF_long)shared->worker_count;
  if (scan_budget < 16u) {
    scan_budget = 16u;
  }

  for (int slot = 0; slot < shared->lookahead_count; ++slot) {
    kls_row_first_pipeline_worker *state =
      shared->lookahead_states + slot;
    if (state->lookahead_active) {
      if (!state->lookahead_claimed &&
          (state->active_order_epoch != shared->order_epoch ||
           state->lookahead_pos < reserved_next)) {
        kls_row_first_pipeline_clear_lookahead_state(state);
      } else {
        continue;
      }
    }
    UF_long pos = KLS_KLU_EMPTY;
    UF_long row = KLS_KLU_EMPTY;
    int found = 0;
    while (scan_budget > 0u && shared->lookahead_next_pos < shared->end) {
      scan_budget--;
      pos = shared->lookahead_next_pos++;
      if (pos >= shared->end) {
        break;
      }
      if (pos < shared->begin) {
        return 0;
      }
      if (pos < reserved_next) {
        continue;
      }
      row = shared->row_order[pos];
      if (row >= shared->ctx->nk ||
          shared->ctx->row_ptr == NULL ||
          shared->ctx->row_ptr[row] > shared->ctx->row_ptr[row + 1u]) {
        return 0;
      }
      const UF_long input_count =
        shared->ctx->row_ptr[row + 1u] - shared->ctx->row_ptr[row];
      if (input_count > shared->lookahead_max_inputs) {
        continue;
      }
      int duplicate = 0;
      for (int other = 0; other < shared->lookahead_count; ++other) {
        const kls_row_first_pipeline_worker *other_state =
          shared->lookahead_states + other;
        if (other_state != state &&
            other_state->lookahead_active &&
            !other_state->lookahead_claimed &&
            other_state->lookahead_pos == pos) {
          duplicate = 1;
          break;
        }
      }
      if (!duplicate) {
        found = 1;
        break;
      }
    }
    if (!found) {
      break;
    }
    state->l_entries.count = 0u;
    state->u_entries.count = 0u;
    state->l_entries.reserve_growths = 0u;
    state->l_entries.reserve_copied_entries = 0u;
    state->u_entries.reserve_growths = 0u;
    state->u_entries.reserve_copied_entries = 0u;
    state->l_reserve_growths_reported = 0u;
    state->l_reserve_copied_reported = 0u;
    state->u_reserve_growths_reported = 0u;
    state->u_reserve_copied_reported = 0u;
    memset(&state->trace_current, 0, sizeof(state->trace_current));
    state->trace_current.long_row_threshold =
      shared->long_row_trace_threshold;
    state->trace_current.long_row = row;
    state->trace_current.long_row_pos = pos;
    memset(&state->state_storage, 0, sizeof(state->state_storage));
    state->state_storage.row = UF_long_max;
    if (row >= shared->ctx->nk ||
        !kls_row_first_partial_row_begin(shared->ctx, &state->workspace,
                                         &state->state_storage, row)) {
      kls_row_first_partial_row_clear(&state->state_storage,
                                      &state->workspace);
      state->l_entries.count = 0u;
      state->u_entries.count = 0u;
      return 0;
    }
    state->active_state = &state->state_storage;
    state->active_order_epoch = shared->order_epoch;
    state->lookahead_pos = pos;
    state->lookahead_row = row;
    state->lookahead_active = 1;
    state->lookahead_claimed = 0;
  }
  return 1;
}

static int kls_row_first_pipeline_try_claim_lookahead(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_worker *worker,
  UF_long wanted_pos,
  UF_long *pos_out,
  UF_long *row_out,
  UF_long *order_epoch_out,
  kls_row_first_partial_row *state_out) {
  if (shared == NULL || worker == NULL || pos_out == NULL ||
      row_out == NULL || order_epoch_out == NULL || state_out == NULL ||
      shared->lookahead_states == NULL) {
    return 0;
  }
  int best_slot = -1;
  for (int slot = 0; slot < shared->lookahead_count; ++slot) {
    kls_row_first_pipeline_worker *state =
      shared->lookahead_states + slot;
    if (!state->lookahead_active || state->lookahead_claimed) {
      continue;
    }
    if (state->active_order_epoch != shared->order_epoch) {
      kls_row_first_pipeline_clear_lookahead_state(state);
      continue;
    }
    if (state->lookahead_pos == wanted_pos) {
      best_slot = slot;
      break;
    }
  }
  if (best_slot < 0) {
    return 0;
  }
  kls_row_first_pipeline_worker *state =
    shared->lookahead_states + best_slot;
  state->lookahead_claimed = 1;

  kls_row_first_workspace tmp_workspace = worker->workspace;
  worker->workspace = state->workspace;
  state->workspace = tmp_workspace;

  kls_row_first_entries tmp_l_entries = worker->l_entries;
  worker->l_entries = state->l_entries;
  state->l_entries = tmp_l_entries;

  kls_row_first_entries tmp_u_entries = worker->u_entries;
  worker->u_entries = state->u_entries;
  state->u_entries = tmp_u_entries;

  worker->trace_current = state->trace_current;
  worker->l_reserve_growths_reported = 0u;
  worker->l_reserve_copied_reported = 0u;
  worker->u_reserve_growths_reported = 0u;
  worker->u_reserve_copied_reported = 0u;
  *state_out = state->state_storage;
  *pos_out = state->lookahead_pos;
  *row_out = state->lookahead_row;
  *order_epoch_out = state->active_order_epoch;

  state->active_state = NULL;
  state->active_order_epoch = 0u;
  memset(&state->state_storage, 0, sizeof(state->state_storage));
  state->state_storage.row = UF_long_max;
  memset(&state->trace_current, 0, sizeof(state->trace_current));
  state->lookahead_active = 0;
  state->lookahead_claimed = 0;
  state->lookahead_pos = KLS_KLU_EMPTY;
  state->lookahead_row = KLS_KLU_EMPTY;
  return 1;
}

static void kls_row_first_pipeline_clear_claim_workspace(
  kls_row_first_workspace *workspace,
  UF_long row,
  unsigned int generation,
  UF_long pattern_count) {
  kls_row_first_partial_row cleanup_state;
  memset(&cleanup_state, 0, sizeof(cleanup_state));
  cleanup_state.row = row;
  cleanup_state.generation = generation;
  cleanup_state.pattern_count = pattern_count;
  kls_row_first_partial_row_clear(&cleanup_state, workspace);
}

static int kls_row_first_pipeline_claim_compact_window_slot(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_worker *worker,
  int best_slot,
  UF_long expected_pos,
  UF_long *pos_out,
  UF_long *row_out,
  UF_long *order_epoch_out,
  kls_row_first_partial_row *state_out) {
  if (shared == NULL || worker == NULL || pos_out == NULL ||
      row_out == NULL || order_epoch_out == NULL || state_out == NULL ||
      shared->compact_window_states == NULL || shared->ctx == NULL ||
      best_slot < 0 || best_slot >= shared->compact_window_count ||
      worker->workspace.x == NULL || worker->workspace.mark == NULL ||
      worker->workspace.pattern == NULL ||
      worker->workspace.dep_heap == NULL) {
    return 0;
  }

  kls_row_first_compact_window_state *state =
    shared->compact_window_states + best_slot;
  if (!state->active || state->grouped ||
      (expected_pos != KLS_KLU_EMPTY && state->pos != expected_pos)) {
    return 0;
  }
  kls_row_first_pipeline_unlink_compact_window_state(shared, state);
  if (state->row >= shared->ctx->nk ||
      state->generation == 0u ||
      state->pattern_count > shared->ctx->nk ||
      state->heap_size > state->pattern_count ||
      state->values == NULL) {
    if (shared->trace_enabled) {
      kls_row_first_stats_add(
        &shared->trace_committed.compact_window_claim_stale_clears, 1u);
    }
    kls_row_first_pipeline_clear_compact_window_state(shared, state);
    return 0;
  }
  UF_long claimed_pattern_count = 0u;
  for (UF_long p = 0; p < state->pattern_count; ++p) {
    const UF_long col = state->pattern[p];
    if (col >= shared->ctx->nk) {
      if (shared->trace_enabled) {
        kls_row_first_stats_add(
          &shared->trace_committed.compact_window_claim_stale_clears, 1u);
      }
      kls_row_first_pipeline_clear_claim_workspace(
        &worker->workspace, state->row, state->generation,
        claimed_pattern_count);
      kls_row_first_pipeline_clear_compact_window_state(shared, state);
      return 0;
    }
    worker->workspace.pattern[claimed_pattern_count] = col;
    claimed_pattern_count++;
    worker->workspace.mark[col] = state->generation;
    worker->workspace.x[col] = state->values[p];
  }
  if (state->heap_size > 0u) {
    memcpy(worker->workspace.dep_heap, state->heap,
           (size_t)state->heap_size * sizeof(*state->heap));
  }
  if (!kls_row_first_pipeline_apply_claim_stream_owner_to_workspace(
        worker, state, &worker->workspace, &claimed_pattern_count,
        &state->trace_current)) {
    if (shared->trace_enabled) {
      kls_row_first_stats_add(
        &shared->trace_committed.compact_window_claim_stale_clears, 1u);
    }
    kls_row_first_pipeline_clear_claim_workspace(
      &worker->workspace, state->row, state->generation,
      claimed_pattern_count);
    kls_row_first_pipeline_clear_compact_window_state(shared, state);
    return 0;
  }
  if (!kls_row_first_pipeline_apply_span_owner_panel_to_workspace(
        worker, state, &worker->workspace, &claimed_pattern_count,
        &state->trace_current)) {
    if (shared->trace_enabled) {
      kls_row_first_stats_add(
        &shared->trace_committed.compact_window_claim_stale_clears, 1u);
    }
    kls_row_first_pipeline_clear_claim_workspace(
      &worker->workspace, state->row, state->generation,
      claimed_pattern_count);
    kls_row_first_pipeline_clear_compact_window_state(shared, state);
    return 0;
  }
  if (!kls_row_first_pipeline_apply_shared_span_owner_to_workspace(
        shared, state, &worker->workspace, &claimed_pattern_count,
        &state->trace_current)) {
    if (shared->trace_enabled) {
      kls_row_first_stats_add(
        &shared->trace_committed.compact_window_claim_stale_clears, 1u);
    }
    kls_row_first_pipeline_clear_claim_workspace(
      &worker->workspace, state->row, state->generation,
      claimed_pattern_count);
    kls_row_first_pipeline_clear_compact_window_state(shared, state);
    return 0;
  }
  if (!kls_row_first_compact_window_apply_deferred_output_cache(
        shared, state, &worker->workspace, &claimed_pattern_count,
        &state->trace_current)) {
    if (shared->trace_enabled) {
      kls_row_first_stats_add(
        &shared->trace_committed.compact_window_claim_stale_clears, 1u);
    }
    kls_row_first_pipeline_clear_claim_workspace(
      &worker->workspace, state->row, state->generation,
      claimed_pattern_count);
    kls_row_first_pipeline_clear_compact_window_state(shared, state);
    return 0;
  }
  if (!kls_row_first_compact_window_replay_delayed_output_to_workspace(
        shared, state, &worker->workspace, &claimed_pattern_count,
        &state->trace_current)) {
    if (shared->trace_enabled) {
      kls_row_first_stats_add(
        &shared->trace_committed.compact_window_claim_stale_clears, 1u);
    }
    kls_row_first_pipeline_clear_claim_workspace(
      &worker->workspace, state->row, state->generation,
      claimed_pattern_count);
    kls_row_first_pipeline_clear_compact_window_state(shared, state);
    return 0;
  }

  worker->l_entries.count = 0u;
  worker->u_entries.count = 0u;
  worker->l_reserve_growths_reported = worker->l_entries.reserve_growths;
  worker->l_reserve_copied_reported =
    worker->l_entries.reserve_copied_entries;
  worker->u_reserve_growths_reported = worker->u_entries.reserve_growths;
  worker->u_reserve_copied_reported =
    worker->u_entries.reserve_copied_entries;
  if (state->l_count > 0u &&
      !kls_row_first_entries_reserve_append(
        &worker->l_entries, state->l_count)) {
    if (shared->trace_enabled) {
      kls_row_first_stats_add(
        &shared->trace_committed.compact_window_claim_stale_clears, 1u);
    }
    kls_row_first_pipeline_clear_claim_workspace(
      &worker->workspace, state->row, state->generation,
      claimed_pattern_count);
    kls_row_first_pipeline_clear_compact_window_state(shared, state);
    return 0;
  }
  for (UF_long p = 0; p < state->l_count; ++p) {
    if (!kls_row_first_entries_append_reserved(
          &worker->l_entries, state->row,
          state->l_cols[p], state->l_values[p])) {
      if (shared->trace_enabled) {
        kls_row_first_stats_add(
          &shared->trace_committed.compact_window_claim_stale_clears, 1u);
      }
      kls_row_first_pipeline_clear_claim_workspace(
        &worker->workspace, state->row, state->generation,
        claimed_pattern_count);
      kls_row_first_pipeline_clear_compact_window_state(shared, state);
      return 0;
    }
  }
  state->l_count = 0u;
  worker->trace_current = state->trace_current;

  state_out->row = state->row;
  state_out->generation = state->generation;
  state_out->pattern_count = claimed_pattern_count;
  state_out->dep_heap_size = state->heap_size;
  state_out->pivot = 0.0;
  *pos_out = state->pos;
  *row_out = state->row;
  *order_epoch_out = shared->order_epoch;

  if (shared->trace_enabled) {
    kls_row_first_stats_add(
      &shared->trace_committed.compact_window_claims, 1u);
  }
  kls_row_first_pipeline_clear_compact_window_state(shared, state);
  return 1;
}

static int kls_row_first_pipeline_try_claim_compact_window(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_worker *worker,
  UF_long wanted_pos,
  UF_long *pos_out,
  UF_long *row_out,
  UF_long *order_epoch_out,
  kls_row_first_partial_row *state_out) {
  if (shared == NULL || worker == NULL || pos_out == NULL ||
      row_out == NULL || order_epoch_out == NULL || state_out == NULL ||
      !shared->compact_window_execute_enabled ||
      shared->compact_window_states == NULL ||
      shared->ctx == NULL || worker->workspace.x == NULL ||
      worker->workspace.mark == NULL ||
      worker->workspace.pattern == NULL ||
      worker->workspace.dep_heap == NULL) {
    return 0;
  }
  if (shared->trace_enabled) {
    kls_row_first_stats_add(
      &shared->trace_committed.compact_window_claim_attempts, 1u);
  }
  int best_slot = -1;
  if (shared->compact_group_active &&
      shared->compact_group_slots != NULL) {
    for (UF_long g = 0; g < shared->compact_group_target_count; ++g) {
      const int slot = shared->compact_group_slots[g];
      if (slot < 0 || slot >= shared->compact_window_count) {
        continue;
      }
      const kls_row_first_compact_window_state *state =
        shared->compact_window_states + slot;
      if (state->active && state->grouped &&
          state->pos == wanted_pos) {
        kls_row_first_pipeline_trace_claim_group_run_surface(
          shared, wanted_pos);
        kls_row_first_pipeline_trace_claim_span_output_surface(
          shared,
          shared->trace_enabled ? &shared->trace_committed : NULL,
          wanted_pos);
        kls_row_first_pipeline_trace_delayed_group_surface(
          shared,
          shared->trace_enabled ? &shared->trace_committed : NULL,
          KLS_KLU_EMPTY, 0, 1);
        if (shared->compact_group_sparse) {
          const int has_shared_owner =
            kls_row_first_pipeline_state_has_shared_span_owner(
              shared, state);
          UF_long run_count = 0u;
          if (!has_shared_owner) {
            if (shared->compact_span_shared_owner_dep_limit > 0u) {
              (void)kls_row_first_pipeline_prepare_sparse_shared_span_owner(
                shared,
                shared->trace_enabled ? &shared->trace_committed : NULL,
                wanted_pos);
            } else {
              run_count =
                kls_row_first_pipeline_prepare_sparse_span_owner(
                  shared, worker,
                  shared->trace_enabled ? &shared->trace_committed : NULL,
                  wanted_pos);
            }
          }
          if (run_count < 2u) {
            if (!has_shared_owner &&
                shared->compact_span_shared_owner_dep_limit == 0u) {
              (void)kls_row_first_pipeline_prepare_sparse_shared_span_owner(
                shared,
                shared->trace_enabled ? &shared->trace_committed : NULL,
                wanted_pos);
            }
            run_count =
              kls_row_first_pipeline_prepare_sparse_claim_run(
                shared, worker,
                shared->trace_enabled ? &shared->trace_committed : NULL,
                wanted_pos);
          }
          if (run_count >= 2u) {
            best_slot = worker->compact_claim_run_slots[0];
            if (shared->trace_enabled) {
              kls_row_first_stats_add(
                &shared->trace_committed.compact_window_claim_group_detaches,
                1u);
            }
          } else {
            kls_row_first_compact_window_state *detached =
              kls_row_first_pipeline_detach_sparse_group_row(
                shared,
                shared->trace_enabled ? &shared->trace_committed : NULL,
                g);
            if (detached != NULL) {
              best_slot = detached->bucket_slot;
              if (shared->trace_enabled) {
                kls_row_first_stats_add(
                  &shared->trace_committed.compact_window_claim_group_detaches,
                  1u);
              }
            } else {
              if (shared->trace_enabled) {
                kls_row_first_stats_add(
                  &shared->trace_committed.compact_window_claim_group_scatters,
                  1u);
              }
              (void)kls_row_first_pipeline_scatter_compact_group(
                shared, NULL);
            }
          }
        } else {
          if (shared->trace_enabled) {
            kls_row_first_stats_add(
              &shared->trace_committed.compact_window_claim_group_scatters,
              1u);
          }
          (void)kls_row_first_pipeline_scatter_compact_group(
            shared, NULL);
        }
        break;
      }
    }
  }
  if (best_slot < 0 && shared->compact_pos_slots != NULL &&
      wanted_pos < shared->ctx->nk) {
    best_slot = shared->compact_pos_slots[wanted_pos];
    if (best_slot < 0 || best_slot >= shared->compact_window_count) {
      best_slot = -1;
    } else {
      kls_row_first_compact_window_state *state =
        shared->compact_window_states + best_slot;
      if (!state->active || state->grouped ||
          state->pos != wanted_pos ||
          state->pos < shared->completed_pos) {
        if (state->active && state->pos < shared->completed_pos) {
          if (shared->trace_enabled) {
            kls_row_first_stats_add(
              &shared->trace_committed.compact_window_claim_stale_clears,
              1u);
          }
          kls_row_first_pipeline_clear_compact_window_state(shared, state);
        } else {
          shared->compact_pos_slots[wanted_pos] = -1;
        }
        best_slot = -1;
      }
    }
  } else if (best_slot < 0) {
    for (int slot = 0; slot < shared->compact_window_count; ++slot) {
      kls_row_first_compact_window_state *state =
        shared->compact_window_states + slot;
      if (!state->active || state->grouped) {
        continue;
      }
      if (state->pos < shared->completed_pos) {
        if (shared->trace_enabled) {
          kls_row_first_stats_add(
            &shared->trace_committed.compact_window_claim_stale_clears,
            1u);
        }
        kls_row_first_pipeline_clear_compact_window_state(shared, state);
        continue;
      }
      if (state->pos == wanted_pos) {
        best_slot = slot;
        break;
      }
    }
  }
  if (best_slot < 0) {
    if (shared->trace_enabled) {
      kls_row_first_stats_add(
        &shared->trace_committed.compact_window_claim_misses, 1u);
    }
    return 0;
  }
  return kls_row_first_pipeline_claim_compact_window_slot(
    shared, worker, best_slot, wanted_pos, pos_out, row_out, order_epoch_out,
    state_out);
}

