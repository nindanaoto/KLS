static void kls_egraph_reset_u_supernode_l_used(kls_solver *solver) {
  if (solver == NULL || solver->refactor_u_supernode_l_pruned ||
      solver->refactor_u_supernode_l_used == NULL) {
    return;
  }
  for (UF_long panel = 0u;
       panel < solver->refactor_u_supernode_pattern_count; ++panel) {
    atomic_store_explicit(&solver->refactor_u_supernode_l_used[panel], 0u,
                          memory_order_relaxed);
  }
}

static void kls_egraph_mark_u_supernode_l_panel_used(kls_solver *solver,
                                                     UF_long panel) {
  if (solver == NULL || solver->refactor_u_supernode_l_pruned ||
      solver->refactor_u_supernode_l_used == NULL ||
      panel >= solver->refactor_u_supernode_pattern_count) {
    return;
  }
  atomic_store_explicit(&solver->refactor_u_supernode_l_used[panel], 1u,
                        memory_order_relaxed);
}

static void kls_egraph_prune_unused_u_supernode_l_panels(kls_solver *solver) {
  if (solver == NULL || solver->refactor_u_supernode_l_pruned ||
      solver->refactor_u_supernode_l_used == NULL ||
      solver->refactor_u_supernode_l_valid == NULL ||
      solver->refactor_u_supernode_width == NULL ||
      solver->refactor_u_supernode_l_row_begin == NULL ||
      solver->refactor_u_supernode_l_row_ptr == NULL) {
    return;
  }

  UF_long pruned_panels = 0u;
  UF_long pruned_dense_entries = 0u;
  UF_long pruned_trailing_entries = 0u;
  for (UF_long panel = 0u;
       panel < solver->refactor_u_supernode_pattern_count; ++panel) {
    if (!solver->refactor_u_supernode_l_valid[panel]) {
      continue;
    }
    if (atomic_load_explicit(&solver->refactor_u_supernode_l_used[panel],
                             memory_order_relaxed) != 0u) {
      continue;
    }
    const UF_long width = solver->refactor_u_supernode_width[panel];
    const UF_long row_begin = solver->refactor_u_supernode_l_row_begin[panel];
    if (width > 0u &&
        row_begin <= solver->refactor_u_supernode_pattern_rows &&
        width <= solver->refactor_u_supernode_pattern_rows - row_begin) {
      pruned_panels++;
      pruned_dense_entries += width * width;
      const UF_long begin = solver->refactor_u_supernode_l_row_ptr[row_begin];
      const UF_long end =
        solver->refactor_u_supernode_l_row_ptr[row_begin + width];
      if (end >= begin) {
        pruned_trailing_entries += end - begin;
      }
    }
    solver->refactor_u_supernode_l_valid[panel] = 0u;
  }
  solver->refactor_u_supernode_l_pruned = 1;
  solver->refactor_u_supernode_l_prune_count++;
  solver->refactor_u_supernode_l_pruned_panels += pruned_panels;
  solver->refactor_u_supernode_l_pruned_dense_entries +=
    pruned_dense_entries;
  solver->refactor_u_supernode_l_pruned_trailing_entries +=
    pruned_trailing_entries;
}

static void kls_egraph_publish_u_supernode_l_column(
  kls_egraph_refactor_shared *shared,
  UF_long col) {
  if (shared == NULL || !shared->u_supernode_ragged_l_updates) {
    return;
  }
  kls_solver *solver = shared->solver;
  if (solver == NULL || col >= solver->n ||
      solver->refactor_u_supernode_col_id == NULL ||
      solver->refactor_u_supernode_start == NULL ||
      solver->refactor_u_supernode_local_start == NULL ||
      solver->refactor_u_supernode_width == NULL ||
      solver->refactor_u_supernode_dense_begin == NULL ||
      solver->refactor_u_supernode_l_valid == NULL ||
      solver->refactor_u_supernode_l_row_begin == NULL ||
      solver->refactor_u_supernode_l_row_ptr == NULL ||
      solver->refactor_u_supernode_l_cols == NULL ||
      solver->refactor_u_supernode_l_dense_values == NULL ||
      solver->refactor_l_indices == NULL ||
      solver->refactor_l_values == NULL ||
      solver->numeric == NULL || solver->numeric->Llen == NULL) {
    return;
  }
  const UF_long panel = solver->refactor_u_supernode_col_id[col];
  if (panel == KLS_KLU_EMPTY ||
      panel >= solver->refactor_u_supernode_pattern_count ||
      !solver->refactor_u_supernode_l_valid[panel]) {
    return;
  }
  const UF_long start = solver->refactor_u_supernode_start[panel];
  const UF_long width = solver->refactor_u_supernode_width[panel];
  const UF_long local_start =
    solver->refactor_u_supernode_local_start[panel];
  if (width <= 1u || col < start || col >= start + width) {
    return;
  }
  const UF_long local = col - start;
  const UF_long row_base =
    solver->refactor_u_supernode_l_row_begin[panel] + local;
  if (row_base + 1u > solver->refactor_u_supernode_pattern_rows) {
    kls_egraph_disable_u_supernode_l_panel(solver, panel);
    return;
  }
  const UF_long *rows = solver->refactor_l_indices[col];
  const double *values = solver->refactor_l_values[col];
  const UF_long length = solver->numeric->Llen[col];
  if ((rows == NULL || values == NULL) && length > 0u) {
    kls_egraph_disable_u_supernode_l_panel(solver, panel);
    return;
  }

  const UF_long skip_begin = local_start;
  const UF_long skip_end = local_start + width;
  double *dense_row =
    solver->refactor_u_supernode_l_dense_values +
    solver->refactor_u_supernode_dense_begin[panel] + local * width;
  memset(dense_row, 0, (size_t)width * sizeof(*dense_row));

  const UF_long trailing_begin =
    solver->refactor_u_supernode_l_row_ptr[row_base];
  const UF_long trailing_end =
    solver->refactor_u_supernode_l_row_ptr[row_base + 1u];
  const UF_long trailing_len = trailing_end - trailing_begin;
  const UF_long *trailing_rows =
    trailing_len > 0u
      ? solver->refactor_u_supernode_l_cols + trailing_begin
      : NULL;
  double *trailing_values =
    trailing_len > 0u
      ? solver->refactor_u_supernode_l_values + trailing_begin
      : NULL;
  if (trailing_len > 0u &&
      (trailing_rows == NULL || trailing_values == NULL)) {
    kls_egraph_disable_u_supernode_l_panel(solver, panel);
    return;
  }
  if (trailing_len > 0u) {
    memset(trailing_values, 0,
           (size_t)trailing_len * sizeof(*trailing_values));
  }

  UF_long trailing_offset = 0u;
  for (UF_long p = 0u; p < length; ++p) {
    const UF_long row = rows[p];
    if (row >= skip_begin && row < skip_end) {
      const UF_long target = row - skip_begin;
      if (target <= local || target >= width) {
        kls_egraph_disable_u_supernode_l_panel(solver, panel);
        return;
      }
      dense_row[target] = values[p];
      continue;
    }
    if (trailing_offset >= trailing_len ||
        trailing_rows[trailing_offset] != row) {
      kls_egraph_disable_u_supernode_l_panel(solver, panel);
      return;
    }
    trailing_values[trailing_offset++] = values[p];
  }
  if (trailing_offset != trailing_len) {
    kls_egraph_disable_u_supernode_l_panel(solver, panel);
  }
}

static void kls_egraph_publish_consumer_plan_group_l_column(
  kls_egraph_refactor_shared *shared,
  UF_long col) {
  if (shared == NULL || !shared->supernode_consumer_plan_group_l_values) {
    return;
  }
  kls_solver *solver = shared->solver;
  if (solver == NULL || col >= solver->n ||
      solver->refactor_supernode_consumer_plan_group_l_col_ptr == NULL ||
      solver->refactor_supernode_consumer_plan_group_l_col_groups == NULL ||
      solver->refactor_supernode_consumer_plan_group_l_col_local == NULL ||
      solver->refactor_supernode_consumer_plan_group_l_valid == NULL ||
      solver->refactor_supernode_consumer_plan_group_l_dense_begin == NULL ||
      solver->refactor_supernode_consumer_plan_group_l_row_begin == NULL ||
      solver->refactor_supernode_consumer_plan_group_l_row_ptr == NULL ||
      solver->refactor_supernode_consumer_plan_group_l_dense_values == NULL ||
      solver->refactor_supernode_consumer_plan_shape_group_panel_start ==
        NULL ||
      solver->refactor_supernode_consumer_plan_shape_group_panel_offset ==
        NULL ||
      solver->refactor_supernode_consumer_plan_shape_group_rows == NULL ||
      solver->refactor_l_indices == NULL ||
      solver->refactor_l_values == NULL ||
      solver->numeric == NULL || solver->numeric->Llen == NULL) {
    return;
  }

  const UF_long begin =
    solver->refactor_supernode_consumer_plan_group_l_col_ptr[col];
  const UF_long end =
    solver->refactor_supernode_consumer_plan_group_l_col_ptr[col + 1u];
  if (begin > end ||
      end > solver->refactor_supernode_consumer_plan_group_l_rows) {
    return;
  }

  const UF_long *rows = solver->refactor_l_indices[col];
  const double *values = solver->refactor_l_values[col];
  const UF_long length = solver->numeric->Llen[col];
  if ((rows == NULL || values == NULL) && length > 0u) {
    for (UF_long pos = begin; pos < end; ++pos) {
      const UF_long group =
        solver->refactor_supernode_consumer_plan_group_l_col_groups[pos];
      kls_egraph_disable_consumer_plan_group_l_panel(solver, group);
      atomic_fetch_add_explicit(
        &shared->supernode_consumer_plan_group_l_invalidations, 1ul,
        memory_order_relaxed);
    }
    return;
  }

  for (UF_long pos = begin; pos < end; ++pos) {
    const UF_long group =
      solver->refactor_supernode_consumer_plan_group_l_col_groups[pos];
    const UF_long local =
      solver->refactor_supernode_consumer_plan_group_l_col_local[pos];
    if (group >= solver->refactor_supernode_consumer_plan_shape_batch_count ||
        !solver->refactor_supernode_consumer_plan_group_l_valid[group]) {
      continue;
    }
    const UF_long panel_start =
      solver->refactor_supernode_consumer_plan_shape_group_panel_start[group];
    const UF_long panel_offset =
      solver->refactor_supernode_consumer_plan_shape_group_panel_offset[group];
    const UF_long width =
      solver->refactor_supernode_consumer_plan_shape_group_rows[group];
    if (width <= 1u || local >= width ||
        panel_start > solver->n || panel_offset > solver->n - panel_start) {
      kls_egraph_disable_consumer_plan_group_l_panel(solver, group);
      atomic_fetch_add_explicit(
        &shared->supernode_consumer_plan_group_l_invalidations, 1ul,
        memory_order_relaxed);
      continue;
    }
    const UF_long start = panel_start + panel_offset;
    if (start > solver->n || width > solver->n - start ||
        col != start + local) {
      kls_egraph_disable_consumer_plan_group_l_panel(solver, group);
      atomic_fetch_add_explicit(
        &shared->supernode_consumer_plan_group_l_invalidations, 1ul,
        memory_order_relaxed);
      continue;
    }

    UF_long k1 = 0u;
    UF_long block_size = 0u;
    UF_long local_start = 0u;
    if (!kls_refactor_supernode_panel_block_info(
          solver, start, start + width, &k1, &block_size, &local_start)) {
      kls_egraph_disable_consumer_plan_group_l_panel(solver, group);
      atomic_fetch_add_explicit(
        &shared->supernode_consumer_plan_group_l_invalidations, 1ul,
        memory_order_relaxed);
      continue;
    }
    (void)k1;
    const UF_long skip_begin = local_start;
    const UF_long skip_end = local_start + width;
    const UF_long row_base =
      solver->refactor_supernode_consumer_plan_group_l_row_begin[group] +
      local;
    if (row_base + 1u >
        solver->refactor_supernode_consumer_plan_group_l_rows) {
      kls_egraph_disable_consumer_plan_group_l_panel(solver, group);
      atomic_fetch_add_explicit(
        &shared->supernode_consumer_plan_group_l_invalidations, 1ul,
        memory_order_relaxed);
      continue;
    }

    double *dense_row =
      solver->refactor_supernode_consumer_plan_group_l_dense_values +
      solver->refactor_supernode_consumer_plan_group_l_dense_begin[group] +
      local * width;
    memset(dense_row, 0, (size_t)width * sizeof(*dense_row));

    const UF_long trailing_begin =
      solver->refactor_supernode_consumer_plan_group_l_row_ptr[row_base];
    const UF_long trailing_end =
      solver->refactor_supernode_consumer_plan_group_l_row_ptr[row_base + 1u];
    if (trailing_end < trailing_begin ||
        trailing_end >
          solver->refactor_supernode_consumer_plan_group_l_trailing_entries) {
      kls_egraph_disable_consumer_plan_group_l_panel(solver, group);
      atomic_fetch_add_explicit(
        &shared->supernode_consumer_plan_group_l_invalidations, 1ul,
        memory_order_relaxed);
      continue;
    }
    const UF_long trailing_len = trailing_end - trailing_begin;
    const UF_long *trailing_rows =
      trailing_len > 0u
        ? solver->refactor_supernode_consumer_plan_group_l_cols +
            trailing_begin
        : NULL;
    double *trailing_values =
      trailing_len > 0u
        ? solver->refactor_supernode_consumer_plan_group_l_values +
            trailing_begin
        : NULL;
    if (trailing_len > 0u &&
        (trailing_rows == NULL || trailing_values == NULL)) {
      kls_egraph_disable_consumer_plan_group_l_panel(solver, group);
      atomic_fetch_add_explicit(
        &shared->supernode_consumer_plan_group_l_invalidations, 1ul,
        memory_order_relaxed);
      continue;
    }
    if (trailing_len > 0u) {
      memset(trailing_values, 0,
             (size_t)trailing_len * sizeof(*trailing_values));
    }

    UF_long dense_writes = 0u;
    UF_long trailing_offset = 0u;
    int ok = 1;
    for (UF_long p = 0u; p < length; ++p) {
      const UF_long row = rows[p];
      if (row >= block_size) {
        ok = 0;
        break;
      }
      if (row >= skip_begin && row < skip_end) {
        const UF_long target = row - skip_begin;
        if (target <= local || target >= width) {
          ok = 0;
          break;
        }
        dense_row[target] = values[p];
        dense_writes++;
        continue;
      }
      if (trailing_offset >= trailing_len ||
          trailing_rows[trailing_offset] != row) {
        ok = 0;
        break;
      }
      trailing_values[trailing_offset++] = values[p];
    }
    if (!ok || trailing_offset != trailing_len) {
      kls_egraph_disable_consumer_plan_group_l_panel(solver, group);
      atomic_fetch_add_explicit(
        &shared->supernode_consumer_plan_group_l_invalidations, 1ul,
        memory_order_relaxed);
      continue;
    }
    atomic_fetch_add_explicit(
      &shared->supernode_consumer_plan_group_l_dense_writes,
      (unsigned long)dense_writes, memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->supernode_consumer_plan_group_l_trailing_writes,
      (unsigned long)trailing_offset, memory_order_relaxed);
  }
}

static void kls_egraph_publish_supernode_panel_column(
  kls_egraph_refactor_shared *shared,
  UF_long col) {
  if (shared == NULL || !shared->supernode_numeric_updates) {
    return;
  }
  kls_solver *solver = shared->solver;
  if (solver == NULL || col >= solver->n ||
      solver->refactor_supernode_panel_col_id == NULL ||
      solver->refactor_supernode_panel_start == NULL ||
      solver->refactor_supernode_panel_local_start == NULL ||
      solver->refactor_supernode_panel_width == NULL ||
      solver->refactor_supernode_panel_dense_begin == NULL ||
      solver->refactor_supernode_panel_trailing_begin == NULL ||
      solver->refactor_supernode_panel_trailing_value_begin == NULL ||
      solver->refactor_supernode_panel_trailing_len == NULL ||
      solver->refactor_supernode_panel_dense_values == NULL ||
      solver->refactor_l_indices == NULL ||
      solver->refactor_l_values == NULL ||
      solver->numeric == NULL || solver->numeric->Llen == NULL) {
    return;
  }
  const UF_long panel = solver->refactor_supernode_panel_col_id[col];
  if (panel == KLS_KLU_EMPTY ||
      panel >= solver->refactor_supernode_panel_count) {
    return;
  }
  const UF_long start = solver->refactor_supernode_panel_start[panel];
  const UF_long width = solver->refactor_supernode_panel_width[panel];
  const UF_long local_start =
    solver->refactor_supernode_panel_local_start[panel];
  const UF_long trailing_len =
    solver->refactor_supernode_panel_trailing_len[panel];
  if (width <= 1u || col < start || col >= start + width) {
    return;
  }
  const UF_long local = col - start;
  const UF_long *rows = solver->refactor_l_indices[col];
  const double *values = solver->refactor_l_values[col];
  const UF_long length = solver->numeric->Llen[col];
  if ((rows == NULL || values == NULL) && length > 0u) {
    kls_egraph_disable_supernode_panel(solver, panel);
    return;
  }
  const UF_long skip_begin = local_start;
  const UF_long skip_end = local_start + width;
  double *dense_row =
    solver->refactor_supernode_panel_dense_values +
    solver->refactor_supernode_panel_dense_begin[panel] + local * width;
  memset(dense_row, 0, (size_t)width * sizeof(*dense_row));

  const UF_long trailing_begin =
    solver->refactor_supernode_panel_trailing_begin[panel];
  const UF_long trailing_value_begin =
    solver->refactor_supernode_panel_trailing_value_begin[panel];
  const UF_long *trailing_rows =
    trailing_len > 0u
      ? solver->refactor_supernode_panel_trailing_rows + trailing_begin
      : NULL;
  double *trailing_values =
    trailing_len > 0u
      ? solver->refactor_supernode_panel_trailing_values +
          trailing_value_begin + local * trailing_len
      : NULL;
  if (trailing_len > 0u &&
      (trailing_rows == NULL || trailing_values == NULL)) {
    kls_egraph_disable_supernode_panel(solver, panel);
    return;
  }
  if (trailing_len > 0u) {
    memset(trailing_values, 0,
           (size_t)trailing_len * sizeof(*trailing_values));
  }

  UF_long trailing_offset = 0u;
  for (UF_long p = 0; p < length; ++p) {
    const UF_long row = rows[p];
    if (row >= skip_begin && row < skip_end) {
      const UF_long target = row - skip_begin;
      if (target <= local || target >= width) {
        kls_egraph_disable_supernode_panel(solver, panel);
        return;
      }
      dense_row[target] = values[p];
      continue;
    }
    if (trailing_offset >= trailing_len ||
        trailing_rows[trailing_offset] != row) {
      kls_egraph_disable_supernode_panel(solver, panel);
      return;
    }
    trailing_values[trailing_offset++] = values[p];
  }
  if (trailing_offset != trailing_len) {
    kls_egraph_disable_supernode_panel(solver, panel);
  }
}

#ifdef KLS_HAVE_CBLAS
static int kls_egraph_apply_cached_supernode_cblas(
  kls_egraph_refactor_shared *shared,
  UF_long run_rows,
  UF_long panel_offset,
  UF_long available_end,
  UF_long width,
  UF_long local_start,
  UF_long trailing_len,
  const double *dense_panel,
  const double *trailing_values,
  double *workspace,
  double *trailing_workspace,
  double *x,
  double *ux) {
  if (shared == NULL || !shared->supernode_numeric_updates ||
      dense_panel == NULL || workspace == NULL || x == NULL || ux == NULL ||
      run_rows < 2u ||
      panel_offset >= width ||
      available_end > width ||
      run_rows != available_end - panel_offset ||
      run_rows > (UF_long)INT_MAX ||
      width > (UF_long)INT_MAX ||
      trailing_len > (UF_long)INT_MAX ||
      (trailing_len > 0u &&
       (trailing_values == NULL || trailing_workspace == NULL)) ||
      !kls_cblas_supernode_env_enabled()) {
    return 0;
  }

  const UF_long dense_scatter_len = width - available_end;
  if (!kls_cblas_supernode_vector_update_allows(run_rows, dense_scatter_len,
                                                trailing_len)) {
    return 0;
  }

  cblas_dtrsv(CblasRowMajor, CblasUpper, CblasTrans, CblasUnit,
              (int)run_rows,
              dense_panel + panel_offset * width + panel_offset,
              (int)width, workspace, 1);
  for (UF_long local = 0; local < run_rows; ++local) {
    ux[local] = workspace[local];
  }

  if (dense_scatter_len > 0u) {
    cblas_dgemv(CblasRowMajor, CblasTrans, (int)run_rows,
                (int)dense_scatter_len, -1.0,
                dense_panel + panel_offset * width + available_end,
                (int)width, workspace, 1, 1.0,
                x + local_start + available_end, 1);
  }
  if (trailing_len > 0u) {
    cblas_dgemv(CblasRowMajor, CblasTrans, (int)run_rows,
                (int)trailing_len, 1.0,
                trailing_values + panel_offset * trailing_len,
                (int)trailing_len, workspace, 1, 0.0,
                trailing_workspace, 1);
  }
  const UF_long trsv_entries = (run_rows * (run_rows - 1u)) / 2u;
  const UF_long dense_scatter_entries = run_rows * dense_scatter_len;
  const UF_long trailing_entries = run_rows * trailing_len;
  kls_egraph_record_supernode_cblas_update(
    shared, run_rows, trsv_entries + dense_scatter_entries +
                       trailing_entries);
  return 1;
}
#endif

static int kls_egraph_apply_cached_supernode_blocked(
  kls_egraph_refactor_shared *shared,
  UF_long run_rows,
  UF_long panel_offset,
  UF_long available_end,
  UF_long width,
  UF_long local_start,
  UF_long trailing_len,
  const double *dense_panel,
  const double *trailing_values,
  double *workspace,
  double *trailing_workspace,
  double *x,
  double *ux) {
  if (shared == NULL || !shared->supernode_numeric_updates ||
      dense_panel == NULL || workspace == NULL || x == NULL || ux == NULL ||
      run_rows < 2u ||
      panel_offset >= width ||
      available_end > width ||
      run_rows != available_end - panel_offset ||
      (trailing_len > 0u &&
       (trailing_values == NULL || trailing_workspace == NULL))) {
    return 0;
  }

  const UF_long dense_scatter_len = width - available_end;
  if (!kls_egraph_cached_supernode_update_allows(
        run_rows, dense_scatter_len, trailing_len)) {
    return 0;
  }

  for (UF_long block_begin = 0u; block_begin < run_rows;
       block_begin += KLS_ROW_REFACTOR_CBLAS_BLOCK_ROWS) {
    UF_long block_end = block_begin + KLS_ROW_REFACTOR_CBLAS_BLOCK_ROWS;
    if (block_end > run_rows) {
      block_end = run_rows;
    }

    for (UF_long local = block_begin; local < block_end; ++local) {
      const UF_long panel_local = panel_offset + local;
      const double ujk = workspace[local];
      ux[local] = ujk;
      const double *dense_row = dense_panel + panel_local * width;
      for (UF_long target = local + 1u; target < block_end; ++target) {
        workspace[target] -=
          ujk * dense_row[panel_offset + target];
      }
    }

    for (UF_long target = block_end; target < run_rows; ++target) {
      const UF_long panel_target = panel_offset + target;
      double update = 0.0;
      for (UF_long local = block_begin; local < block_end; ++local) {
        const UF_long panel_local = panel_offset + local;
        update += workspace[local] *
                  dense_panel[panel_local * width + panel_target];
      }
      workspace[target] -= update;
    }

    for (UF_long target = available_end; target < width; ++target) {
      double update = 0.0;
      for (UF_long local = block_begin; local < block_end; ++local) {
        const UF_long panel_local = panel_offset + local;
        update += workspace[local] *
                  dense_panel[panel_local * width + target];
      }
      x[local_start + target] -= update;
    }

    if (trailing_len > 0u) {
      for (UF_long offset = 0u; offset < trailing_len; ++offset) {
        double update = 0.0;
        for (UF_long local = block_begin; local < block_end; ++local) {
          const UF_long panel_local = panel_offset + local;
          update += workspace[local] *
                    trailing_values[panel_local * trailing_len + offset];
        }
        trailing_workspace[offset] += update;
      }
    }
  }

  const UF_long trsv_entries = (run_rows * (run_rows - 1u)) / 2u;
  const UF_long dense_scatter_entries = run_rows * dense_scatter_len;
  const UF_long trailing_entries = run_rows * trailing_len;
  kls_egraph_record_supernode_blocked_update(
    shared, run_rows, trsv_entries + dense_scatter_entries +
                       trailing_entries);
  return 1;
}

static int kls_egraph_find_consumer_plan_run(
  const kls_solver *solver,
  UF_long current_global,
  UF_long dep_global,
  UF_long dep_pos,
  UF_long *run_id_out,
  UF_long *run_rows_out,
  UF_long *panel_start_out,
  UF_long *panel_offset_out) {
  if (run_id_out != NULL) {
    *run_id_out = KLS_KLU_EMPTY;
  }
  if (run_rows_out != NULL) {
    *run_rows_out = 0u;
  }
  if (panel_start_out != NULL) {
    *panel_start_out = KLS_KLU_EMPTY;
  }
  if (panel_offset_out != NULL) {
    *panel_offset_out = 0u;
  }
  if (solver == NULL || current_global >= solver->n ||
      solver->refactor_supernode_consumer_plan_col_ptr == NULL ||
      solver->refactor_supernode_consumer_plan_col_runs == NULL ||
      solver->refactor_supernode_consumer_plan_dep == NULL ||
      solver->refactor_supernode_consumer_plan_rows == NULL ||
      solver->refactor_supernode_consumer_plan_panel_start == NULL ||
      solver->refactor_supernode_consumer_plan_panel_offset == NULL) {
    return 0;
  }
  const int use_position =
    dep_pos != KLS_KLU_EMPTY &&
    solver->refactor_supernode_consumer_plan_dep_pos != NULL;
  const UF_long begin =
    solver->refactor_supernode_consumer_plan_col_ptr[current_global];
  const UF_long end =
    solver->refactor_supernode_consumer_plan_col_ptr[current_global + 1u];
  if (begin > end ||
      end > solver->refactor_supernode_consumer_plan_run_count) {
    return 0;
  }
  for (UF_long pos = begin; pos < end; ++pos) {
    const UF_long run = solver->refactor_supernode_consumer_plan_col_runs[pos];
    if (run >= solver->refactor_supernode_consumer_plan_run_count) {
      return 0;
    }
    if (use_position &&
        solver->refactor_supernode_consumer_plan_dep_pos[run] != dep_pos) {
      continue;
    }
    if (solver->refactor_supernode_consumer_plan_dep[run] == dep_global) {
      if (run_id_out != NULL) {
        *run_id_out = run;
      }
      if (run_rows_out != NULL) {
        *run_rows_out = solver->refactor_supernode_consumer_plan_rows[run];
      }
      if (panel_start_out != NULL) {
        *panel_start_out =
          solver->refactor_supernode_consumer_plan_panel_start[run];
      }
      if (panel_offset_out != NULL) {
        *panel_offset_out =
          solver->refactor_supernode_consumer_plan_panel_offset[run];
      }
      return 1;
    }
  }
  return 0;
}

static int kls_egraph_worker_find_consumer_plan_run(
  kls_egraph_refactor_worker *worker,
  UF_long current_global,
  UF_long dep_global,
  UF_long dep_pos,
  UF_long *run_id_out,
  UF_long *run_rows_out,
  UF_long *panel_start_out,
  UF_long *panel_offset_out) {
  if (run_id_out != NULL) {
    *run_id_out = KLS_KLU_EMPTY;
  }
  if (run_rows_out != NULL) {
    *run_rows_out = 0u;
  }
  if (panel_start_out != NULL) {
    *panel_start_out = KLS_KLU_EMPTY;
  }
  if (panel_offset_out != NULL) {
    *panel_offset_out = 0u;
  }
  if (worker == NULL || worker->shared == NULL ||
      worker->shared->solver == NULL) {
    return 0;
  }
  const kls_solver *solver = worker->shared->solver;
  if (!solver->refactor_supernode_consumer_plan_col_sorted ||
      current_global >= solver->n ||
      solver->refactor_supernode_consumer_plan_col_ptr == NULL ||
      solver->refactor_supernode_consumer_plan_col_runs == NULL ||
      solver->refactor_supernode_consumer_plan_dep == NULL ||
      solver->refactor_supernode_consumer_plan_rows == NULL ||
      solver->refactor_supernode_consumer_plan_panel_start == NULL ||
      solver->refactor_supernode_consumer_plan_panel_offset == NULL) {
    return kls_egraph_find_consumer_plan_run(
      solver, current_global, dep_global, dep_pos, run_id_out, run_rows_out,
      panel_start_out, panel_offset_out);
  }
  const int use_position =
    dep_pos != KLS_KLU_EMPTY &&
    solver->refactor_supernode_consumer_plan_dep_pos != NULL &&
    solver->refactor_supernode_consumer_plan_dep_pos_sorted;
  const UF_long target_key = use_position ? dep_pos : dep_global;

  const UF_long begin =
    solver->refactor_supernode_consumer_plan_col_ptr[current_global];
  const UF_long end =
    solver->refactor_supernode_consumer_plan_col_ptr[current_global + 1u];
  if (begin > end ||
      end > solver->refactor_supernode_consumer_plan_run_count) {
    worker->consumer_plan_cursor_valid = 0;
    worker->consumer_plan_cursor_last_dep = KLS_KLU_EMPTY;
    return 0;
  }
  if (!worker->consumer_plan_cursor_valid ||
      worker->consumer_plan_cursor_current != current_global ||
      worker->consumer_plan_cursor_pos < begin ||
      worker->consumer_plan_cursor_pos > end ||
      (worker->consumer_plan_cursor_last_dep != KLS_KLU_EMPTY &&
       target_key < worker->consumer_plan_cursor_last_dep)) {
    worker->consumer_plan_cursor_valid = 1;
    worker->consumer_plan_cursor_current = current_global;
    worker->consumer_plan_cursor_pos = begin;
    worker->consumer_plan_cursor_last_dep = KLS_KLU_EMPTY;
  }

  UF_long pos = worker->consumer_plan_cursor_pos;
  while (pos < end) {
    const UF_long run = solver->refactor_supernode_consumer_plan_col_runs[pos];
    if (run >= solver->refactor_supernode_consumer_plan_run_count) {
      worker->consumer_plan_cursor_valid = 0;
      worker->consumer_plan_cursor_last_dep = KLS_KLU_EMPTY;
      return 0;
    }
    const UF_long dep = solver->refactor_supernode_consumer_plan_dep[run];
    const UF_long key =
      use_position ? solver->refactor_supernode_consumer_plan_dep_pos[run] : dep;
    if (key == KLS_KLU_EMPTY || key < target_key) {
      pos++;
      continue;
    }
    worker->consumer_plan_cursor_pos = pos;
    worker->consumer_plan_cursor_last_dep = target_key;
    if (key != target_key || dep != dep_global) {
      return 0;
    }
    if (run_id_out != NULL) {
      *run_id_out = run;
    }
    if (run_rows_out != NULL) {
      *run_rows_out = solver->refactor_supernode_consumer_plan_rows[run];
    }
    if (panel_start_out != NULL) {
      *panel_start_out =
        solver->refactor_supernode_consumer_plan_panel_start[run];
    }
    if (panel_offset_out != NULL) {
      *panel_offset_out =
        solver->refactor_supernode_consumer_plan_panel_offset[run];
    }
    worker->consumer_plan_cursor_pos = pos + 1u;
    return 1;
  }
  worker->consumer_plan_cursor_pos = end;
  worker->consumer_plan_cursor_last_dep = target_key;
  return 0;
}

static int kls_egraph_refactor_try_consumer_plan_group_l_run(
  kls_egraph_refactor_worker *worker,
  UF_long k1,
  UF_long current_global,
  UF_long current_local,
  UF_long *up_io,
  UF_long ucol_len,
  const UF_long *ui,
  double *ux,
  double *x,
  int wait_for_dependencies) {
  if (worker == NULL || worker->shared == NULL || up_io == NULL ||
      ui == NULL || ux == NULL || x == NULL || *up_io >= ucol_len) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || !shared->supernode_consumer_plan_group_l_exec ||
      solver->refactor_supernode_consumer_plan_group_l_run_group == NULL ||
      solver->refactor_supernode_consumer_plan_group_l_valid == NULL ||
      solver->refactor_supernode_consumer_plan_group_l_dense_begin == NULL ||
      solver->refactor_supernode_consumer_plan_group_l_row_begin == NULL ||
      solver->refactor_supernode_consumer_plan_group_l_row_ptr == NULL ||
      solver->refactor_supernode_consumer_plan_group_l_dense_values == NULL ||
      solver->refactor_supernode_consumer_plan_shape_group_panel_start ==
        NULL ||
      solver->refactor_supernode_consumer_plan_shape_group_panel_offset ==
        NULL ||
      solver->refactor_supernode_consumer_plan_shape_group_rows == NULL) {
    return 0;
  }

  const UF_long up = *up_io;
  const UF_long dep_local = ui[up];
  if (dep_local >= current_local || k1 > current_global ||
      dep_local > UF_long_max - k1) {
    return 0;
  }
  const UF_long dep_global = k1 + dep_local;
  if (dep_global >= current_global || dep_global >= solver->n) {
    return 0;
  }

  UF_long run_id = KLS_KLU_EMPTY;
  UF_long planned_rows = 0u;
  UF_long planned_start = KLS_KLU_EMPTY;
  UF_long planned_offset = 0u;
  kls_egraph_record_consumer_plan_attempt(shared);
  if (!kls_egraph_worker_find_consumer_plan_run(
        worker, current_global, dep_global, up, &run_id, &planned_rows,
        &planned_start, &planned_offset)) {
    return 0;
  }
  kls_egraph_record_consumer_plan_hit(shared);
  if (run_id == KLS_KLU_EMPTY ||
      run_id >= solver->refactor_supernode_consumer_plan_run_count) {
    return 0;
  }

  const UF_long group =
    solver->refactor_supernode_consumer_plan_group_l_run_group[run_id];
  if (group == KLS_KLU_EMPTY ||
      group >= solver->refactor_supernode_consumer_plan_shape_batch_count ||
      !solver->refactor_supernode_consumer_plan_group_l_valid[group]) {
    return 0;
  }
  const UF_long panel_start =
    solver->refactor_supernode_consumer_plan_shape_group_panel_start[group];
  const UF_long panel_offset =
    solver->refactor_supernode_consumer_plan_shape_group_panel_offset[group];
  const UF_long width =
    solver->refactor_supernode_consumer_plan_shape_group_rows[group];
  if (width <= 1u || planned_rows != width ||
      planned_start != panel_start || planned_offset != panel_offset ||
      panel_start > solver->n || panel_offset > solver->n - panel_start) {
    return 0;
  }
  const UF_long start = panel_start + panel_offset;
  if (start != dep_global || width > solver->n - start ||
      width > current_global - start ||
      width > ucol_len - up ||
      width > current_local - dep_local ||
      width > (UF_long)(SIZE_MAX / sizeof(double))) {
    return 0;
  }
  for (UF_long local = 0u; local < width; ++local) {
    if (ui[up + local] != dep_local + local) {
      return 0;
    }
  }

  const UF_long row_base =
    solver->refactor_supernode_consumer_plan_group_l_row_begin[group];
  if (row_base + width >
      solver->refactor_supernode_consumer_plan_group_l_rows) {
    return 0;
  }
  UF_long trailing_entries = 0u;
  for (UF_long local = 0u; local < width; ++local) {
    const UF_long begin =
      solver->refactor_supernode_consumer_plan_group_l_row_ptr[
        row_base + local];
    const UF_long end =
      solver->refactor_supernode_consumer_plan_group_l_row_ptr[
        row_base + local + 1u];
    if (end < begin ||
        end >
          solver->refactor_supernode_consumer_plan_group_l_trailing_entries ||
        end - begin > UF_long_max - trailing_entries) {
      return 0;
    }
    trailing_entries += end - begin;
  }
  if (!kls_egraph_ragged_u_supernode_update_allows(
        width, 0u, trailing_entries)) {
    if (!shared->supernode_consumer_plan_group_l_batch_exec ||
        (solver->refactor_supernode_consumer_plan_group_l_valid[group] &
         KLS_REFACTOR_PLAN_GROUP_L_PAYOFF) == 0u) {
      return 0;
    }
  }

  double *workspace = kls_egraph_worker_supernode_workspace(worker, width);
  if (workspace == NULL) {
    return 0;
  }
  if (wait_for_dependencies) {
    for (UF_long local = 0u; local < width; ++local) {
      if (!kls_egraph_refactor_wait_done(shared, start + local)) {
        return -1;
      }
    }
  }
  for (UF_long local = 0u; local < width; ++local) {
    const UF_long row = dep_local + local;
    workspace[local] = x[row];
    x[row] = 0.0;
  }

  const UF_long dense_begin =
    solver->refactor_supernode_consumer_plan_group_l_dense_begin[group];
  if (dense_begin == KLS_KLU_EMPTY ||
      width > UF_long_max / width ||
      dense_begin >
        solver->refactor_supernode_consumer_plan_group_l_dense_entries ||
      width * width >
        solver->refactor_supernode_consumer_plan_group_l_dense_entries -
          dense_begin) {
    return 0;
  }
  const double *dense_panel =
    solver->refactor_supernode_consumer_plan_group_l_dense_values +
    dense_begin;
  const UF_long *trailing_cols =
    solver->refactor_supernode_consumer_plan_group_l_cols;
  const double *trailing_values =
    solver->refactor_supernode_consumer_plan_group_l_values;
  if (trailing_entries > 0u &&
      (trailing_cols == NULL || trailing_values == NULL)) {
    return 0;
  }

  for (UF_long local = 0u; local < width; ++local) {
    const double ujk = workspace[local];
    ux[up + local] = ujk;
    if (shared->u_supernode_values) {
      kls_egraph_record_u_supernode_value(
        shared, start + local, current_global, ujk);
    }
    const double *dense_row = dense_panel + local * width;
    for (UF_long target = local + 1u; target < width; ++target) {
      workspace[target] -= ujk * dense_row[target];
    }
    const UF_long row = row_base + local;
    const UF_long begin =
      solver->refactor_supernode_consumer_plan_group_l_row_ptr[row];
    const UF_long end =
      solver->refactor_supernode_consumer_plan_group_l_row_ptr[row + 1u];
    for (UF_long p = begin; p < end; ++p) {
      x[trailing_cols[p]] -= ujk * trailing_values[p];
    }
  }

  const UF_long trsv_entries = (width * (width - 1u)) / 2u;
  const UF_long update_entries = trsv_entries + trailing_entries;
  kls_egraph_record_consumer_plan_group_l_update(
    shared, width, update_entries);
  kls_egraph_record_consumer_plan_applied(shared, width, update_entries);
  *up_io = up + width;
  return 1;
}

static int kls_egraph_refactor_try_u_supernode_ragged_l_run(
  kls_egraph_refactor_worker *worker,
  UF_long k1,
  UF_long current_global,
  UF_long current_local,
  UF_long *up_io,
  UF_long ucol_len,
  const UF_long *ui,
  double *ux,
  double *x,
  int wait_for_dependencies) {
  if (worker == NULL || worker->shared == NULL || up_io == NULL ||
      ui == NULL || ux == NULL || x == NULL || *up_io >= ucol_len) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || !shared->u_supernode_ragged_l_updates ||
      solver->refactor_u_supernode_col_id == NULL ||
      solver->refactor_u_supernode_start == NULL ||
      solver->refactor_u_supernode_local_start == NULL ||
      solver->refactor_u_supernode_width == NULL ||
      solver->refactor_u_supernode_dense_begin == NULL ||
      solver->refactor_u_supernode_l_valid == NULL ||
      solver->refactor_u_supernode_l_row_begin == NULL ||
      solver->refactor_u_supernode_l_row_ptr == NULL ||
      solver->refactor_u_supernode_l_cols == NULL ||
      solver->refactor_u_supernode_l_dense_values == NULL) {
    return 0;
  }

  const UF_long up = *up_io;
  const UF_long dep_local = ui[up];
  if (dep_local >= current_local || k1 > current_global) {
    kls_egraph_record_u_supernode_l_short_reject(shared);
    return 0;
  }
  const UF_long dep_global = k1 + dep_local;
  if (dep_global >= current_global || dep_global >= solver->n) {
    kls_egraph_record_u_supernode_l_short_reject(shared);
    return 0;
  }
  UF_long planned_rows = 0u;
  UF_long planned_start = KLS_KLU_EMPTY;
  UF_long planned_offset = 0u;
  UF_long planned_run_id = KLS_KLU_EMPTY;
  UF_long algorithm5_workspace_request = 0u;
  UF_long algorithm5_workspace_offset = 0u;
  UF_long algorithm5_workspace_begin = 0u;
  UF_long algorithm5_target_slot_begin = KLS_KLU_EMPTY;
  UF_long algorithm5_target_slots = 0u;
  UF_long algorithm5_target_entries = 0u;
  UF_long algorithm5_pattern_width = 0u;
  int algorithm5_slot_accum_candidate = 0;
  int algorithm5_prefix_prep_candidate = 0;
  const int plan_pattern =
    solver->refactor_u_supernode_plan_pattern_built ? 1 : 0;
  if (plan_pattern &&
      !kls_egraph_worker_find_consumer_plan_run(
        worker, current_global, dep_global, up, &planned_run_id,
        &planned_rows,
        &planned_start, &planned_offset)) {
    return 0;
  }
  if (shared->supernode_algorithm5_payoff_exec &&
      (!plan_pattern || planned_run_id == KLS_KLU_EMPTY ||
       planned_run_id >= solver->refactor_supernode_consumer_plan_run_count ||
       solver->refactor_supernode_algorithm5_payoff_runs == NULL ||
       solver->refactor_supernode_algorithm5_payoff_group_ptr == NULL ||
       solver->refactor_supernode_algorithm5_payoff_run_group == NULL ||
       solver->refactor_supernode_algorithm5_payoff_run_group[
          planned_run_id] == KLS_KLU_EMPTY ||
       solver->refactor_supernode_algorithm5_payoff_run_group_pos == NULL ||
       solver->refactor_supernode_algorithm5_payoff_run_current_pos == NULL ||
       solver->refactor_supernode_algorithm5_payoff_run_advance_deps == NULL ||
       solver->refactor_supernode_algorithm5_payoff_run_advance_ptr == NULL ||
       solver->refactor_supernode_algorithm5_payoff_run_advance_slots == NULL ||
       solver->refactor_supernode_algorithm5_payoff_run_advance_slot_ptr ==
         NULL ||
       solver->refactor_supernode_algorithm5_payoff_run_prefix_rows == NULL ||
       solver->refactor_supernode_algorithm5_payoff_run_target_entries == NULL ||
       solver->refactor_supernode_algorithm5_payoff_run_target_ptr == NULL ||
       solver->refactor_supernode_algorithm5_payoff_run_target_slots == NULL ||
       solver->refactor_supernode_algorithm5_payoff_run_target_slot_ptr ==
         NULL ||
       solver->refactor_supernode_algorithm5_payoff_run_prefix_rows[
          planned_run_id] == 0u ||
       solver->refactor_supernode_algorithm5_payoff_group_current_ptr ==
         NULL ||
       solver->refactor_supernode_algorithm5_payoff_group_pattern_width ==
         NULL ||
       solver->refactor_supernode_algorithm5_payoff_group_target_entries ==
         NULL ||
       solver->refactor_supernode_algorithm5_payoff_group_target_slots ==
         NULL ||
       solver->refactor_supernode_algorithm5_payoff_group_advance_deps ==
         NULL ||
       solver->refactor_supernode_algorithm5_payoff_group_advance_slots ==
         NULL ||
       (solver->refactor_supernode_algorithm5_payoff_group_advance_slots_total >
          0u &&
        solver->refactor_supernode_algorithm5_payoff_group_advance_cols ==
          NULL) ||
       solver->refactor_supernode_algorithm5_payoff_group_currents == NULL ||
       solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr ==
         NULL ||
       solver->refactor_supernode_algorithm5_payoff_group_current_runs ==
         NULL ||
       solver
         ->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr ==
           NULL ||
       solver->refactor_supernode_algorithm5_payoff_group_workspace_rows ==
         NULL ||
       solver->refactor_supernode_algorithm5_payoff_run_selected == NULL ||
       !solver->refactor_supernode_algorithm5_payoff_run_selected[
          planned_run_id])) {
    return 0;
  }
  if (shared->supernode_algorithm5_payoff_exec) {
    const UF_long group =
      solver->refactor_supernode_algorithm5_payoff_run_group[
        planned_run_id];
    const UF_long current_slot =
      solver->refactor_supernode_algorithm5_payoff_run_current_pos[
        planned_run_id];
    if (group >= solver->refactor_supernode_algorithm5_payoff_group_count) {
      return 0;
    }
    const UF_long current_begin =
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr[
        group];
    const UF_long current_end =
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr[
        group + 1u];
    if (current_slot == KLS_KLU_EMPTY ||
        current_end < current_begin ||
        current_slot < current_begin || current_slot >= current_end ||
        solver->refactor_supernode_algorithm5_payoff_group_currents[
          current_slot] != current_global) {
      return 0;
    }
    if (current_slot + 1u >
          solver->refactor_supernode_algorithm5_payoff_group_current_total ||
        solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
          current_slot] >
          solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
            current_slot + 1u] ||
        solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
          current_slot + 1u] >
          solver->refactor_supernode_algorithm5_payoff_group_ptr[
            solver->refactor_supernode_algorithm5_payoff_group_count]) {
      return 0;
    }
    int run_listed_for_current = 0;
    const UF_long current_run_begin =
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
        current_slot];
    const UF_long current_run_end =
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
        current_slot + 1u];
    for (UF_long pos = current_run_begin; pos < current_run_end; ++pos) {
      if (solver->refactor_supernode_algorithm5_payoff_group_current_runs[
            pos] == planned_run_id) {
        run_listed_for_current = 1;
        break;
      }
    }
    if (!run_listed_for_current) {
      return 0;
    }
    planned_rows =
      solver->refactor_supernode_algorithm5_payoff_run_prefix_rows[
        planned_run_id];
    const UF_long pattern_width =
      solver->refactor_supernode_algorithm5_payoff_group_pattern_width[group];
    algorithm5_pattern_width = pattern_width;
    if (pattern_width == 0u || planned_offset > pattern_width ||
        planned_rows > pattern_width - planned_offset) {
      return 0;
    }
    const UF_long group_run_begin =
      solver->refactor_supernode_algorithm5_payoff_group_ptr[group];
    const UF_long group_run_end =
      solver->refactor_supernode_algorithm5_payoff_group_ptr[group + 1u];
    const UF_long group_pos =
      solver->refactor_supernode_algorithm5_payoff_run_group_pos[
        planned_run_id];
    if (group_run_end < group_run_begin ||
        group_run_end >
          solver->refactor_supernode_algorithm5_payoff_group_ptr[
            solver->refactor_supernode_algorithm5_payoff_group_count] ||
        group_pos == KLS_KLU_EMPTY ||
        group_pos >= group_run_end - group_run_begin ||
        solver->refactor_supernode_algorithm5_payoff_runs[
          group_run_begin + group_pos] != planned_run_id) {
      return 0;
    }
    const UF_long first_run =
      solver->refactor_supernode_algorithm5_payoff_runs[group_run_begin];
    if (first_run >= solver->refactor_supernode_consumer_plan_run_count) {
      return 0;
    }
    const UF_long group_target_begin =
      solver->refactor_supernode_algorithm5_payoff_run_target_ptr[first_run];
    const UF_long run_target_begin =
      solver->refactor_supernode_algorithm5_payoff_run_target_ptr[
        planned_run_id];
    const UF_long run_target_entries =
      solver->refactor_supernode_algorithm5_payoff_run_target_entries[
        planned_run_id];
    const UF_long group_target_entries =
      solver->refactor_supernode_algorithm5_payoff_group_target_entries[group];
    if (group_target_begin == KLS_KLU_EMPTY ||
        run_target_begin == KLS_KLU_EMPTY ||
        run_target_begin < group_target_begin ||
        run_target_begin - group_target_begin > group_target_entries ||
        run_target_entries >
          group_target_entries - (run_target_begin - group_target_begin)) {
      return 0;
    }
    const UF_long group_target_slot_begin =
      solver->refactor_supernode_algorithm5_payoff_run_target_slot_ptr[
        first_run];
    const UF_long run_target_slot_begin =
      solver->refactor_supernode_algorithm5_payoff_run_target_slot_ptr[
        planned_run_id];
    const UF_long run_target_slots =
      solver->refactor_supernode_algorithm5_payoff_run_target_slots[
        planned_run_id];
    const UF_long group_target_slots =
      solver->refactor_supernode_algorithm5_payoff_group_target_slots[group];
    if (group_target_slot_begin == KLS_KLU_EMPTY ||
        run_target_slot_begin == KLS_KLU_EMPTY ||
        run_target_slot_begin < group_target_slot_begin ||
        run_target_slot_begin - group_target_slot_begin > group_target_slots ||
        run_target_slots >
          group_target_slots - (run_target_slot_begin -
                                group_target_slot_begin) ||
        (group_target_slots > 0u &&
         solver->refactor_supernode_algorithm5_payoff_group_target_cols ==
           NULL)) {
      return 0;
    }
    algorithm5_target_slot_begin = run_target_slot_begin;
    algorithm5_target_slots = run_target_slots;
    algorithm5_target_entries = run_target_entries;
    const UF_long group_advance_begin =
      solver->refactor_supernode_algorithm5_payoff_run_advance_ptr[
        first_run];
    const UF_long run_advance_begin =
      solver->refactor_supernode_algorithm5_payoff_run_advance_ptr[
        planned_run_id];
    const UF_long run_advance_deps =
      solver->refactor_supernode_algorithm5_payoff_run_advance_deps[
        planned_run_id];
    const UF_long group_advance_deps =
      solver->refactor_supernode_algorithm5_payoff_group_advance_deps[
        group];
    if (group_advance_begin == KLS_KLU_EMPTY ||
        run_advance_begin == KLS_KLU_EMPTY ||
        run_advance_begin < group_advance_begin ||
        run_advance_begin - group_advance_begin > group_advance_deps ||
        run_advance_deps >
          group_advance_deps - (run_advance_begin - group_advance_begin)) {
      return 0;
    }
    if (solver->refactor_supernode_algorithm5_payoff_run_advance_deps[
          planned_run_id] != up) {
      return 0;
    }
    const UF_long workspace_begin =
      solver
        ->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr[
          current_slot];
    const UF_long workspace_end =
      solver
        ->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr[
          current_slot + 1u];
    const UF_long group_workspace_begin =
      solver
        ->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr[
          current_begin];
    const UF_long group_workspace_rows =
      solver->refactor_supernode_algorithm5_payoff_group_workspace_rows[
        group];
    if (workspace_end < workspace_begin ||
        workspace_begin < group_workspace_begin ||
        planned_rows > workspace_end - workspace_begin ||
        workspace_end < group_workspace_begin ||
        workspace_end - group_workspace_begin > group_workspace_rows ||
        workspace_begin - group_workspace_begin > group_workspace_rows ||
        group_workspace_rows >
          (UF_long)(SIZE_MAX / sizeof(double))) {
      return 0;
    }
    algorithm5_workspace_request = group_workspace_rows;
    algorithm5_workspace_offset = workspace_begin - group_workspace_begin;
    algorithm5_workspace_begin = group_workspace_begin;
    if (algorithm5_workspace_request == 0u ||
        algorithm5_workspace_offset > algorithm5_workspace_request ||
        planned_rows >
          algorithm5_workspace_request - algorithm5_workspace_offset) {
      return 0;
    }
    if (shared->supernode_algorithm5_payoff_slot_accum ||
        shared->supernode_algorithm5_payoff_prefix_prep) {
      const int algorithm5_needs_target_values =
        shared->supernode_algorithm5_payoff_slot_accum ||
        !shared->supernode_algorithm5_payoff_direct_prefix_prep;
      if (!shared->supernode_algorithm5_payoff_workspace ||
          shared->algorithm5_payoff_workspace_values == NULL ||
          shared->algorithm5_payoff_current_flags == NULL ||
          algorithm5_workspace_begin >
            shared->algorithm5_payoff_workspace_size ||
          algorithm5_workspace_request >
            shared->algorithm5_payoff_workspace_size -
              algorithm5_workspace_begin ||
          (algorithm5_needs_target_values &&
           (shared->algorithm5_payoff_target_values == NULL ||
            solver->refactor_supernode_algorithm5_payoff_group_target_cols ==
              NULL ||
            algorithm5_target_slot_begin == KLS_KLU_EMPTY ||
            algorithm5_target_slot_begin >
              shared->algorithm5_payoff_target_size ||
            algorithm5_target_slots >
              shared->algorithm5_payoff_target_size -
                algorithm5_target_slot_begin ||
            algorithm5_target_slots == 0u))) {
        return 0;
      }
      algorithm5_slot_accum_candidate =
        shared->supernode_algorithm5_payoff_slot_accum ? 1 : 0;
      algorithm5_prefix_prep_candidate =
        shared->supernode_algorithm5_payoff_prefix_prep ? 1 : 0;
    }
  }
  kls_egraph_record_u_supernode_l_probe_attempt(shared);
  const UF_long panel = solver->refactor_u_supernode_col_id[dep_global];
  if (panel == KLS_KLU_EMPTY ||
      panel >= solver->refactor_u_supernode_pattern_count ||
      !solver->refactor_u_supernode_l_valid[panel]) {
    kls_egraph_record_u_supernode_l_panel_miss(shared);
    return 0;
  }
  const UF_long start = solver->refactor_u_supernode_start[panel];
  const UF_long local_start =
    solver->refactor_u_supernode_local_start[panel];
  const UF_long width = solver->refactor_u_supernode_width[panel];
  if (width <= 1u || start > dep_global || dep_global >= start + width ||
      start > solver->n || width > solver->n - start) {
    kls_egraph_record_u_supernode_l_panel_miss(shared);
    return 0;
  }
  const UF_long panel_offset = dep_global - start;
  if (local_start > dep_local ||
      dep_local - local_start != panel_offset) {
    kls_egraph_record_u_supernode_l_panel_miss(shared);
    return 0;
  }
  UF_long available_end = width;
  if (plan_pattern) {
    if (planned_start != start || planned_offset != panel_offset ||
        planned_rows == 0u) {
      kls_egraph_record_u_supernode_l_panel_miss(shared);
      return 0;
    }
    available_end = panel_offset + planned_rows;
    if (shared->supernode_algorithm5_payoff_exec &&
        available_end > width) {
      available_end = width;
    }
    if (available_end > width ||
        start + available_end > current_global) {
      kls_egraph_record_u_supernode_l_panel_miss(shared);
      return 0;
    }
  } else if (current_global < start + width) {
    available_end = current_global - start;
  }
  if (wait_for_dependencies && !shared->supernode_algorithm5_payoff_exec) {
    available_end = kls_egraph_algorithm5_split_available_end(
      shared, panel_offset, available_end);
  }
  if (available_end > width || available_end <= panel_offset + 1u) {
    kls_egraph_record_u_supernode_l_short_reject(shared);
    return 0;
  }
  const UF_long run_rows = available_end - panel_offset;
  if (run_rows > ucol_len - up ||
      run_rows > current_local - dep_local ||
      run_rows > (UF_long)(SIZE_MAX / sizeof(double))) {
    kls_egraph_record_u_supernode_l_short_reject(shared);
    return 0;
  }
  for (UF_long local = 0u; local < run_rows; ++local) {
    if (ui[up + local] != dep_local + local) {
      kls_egraph_record_u_supernode_l_stream_reject(shared);
      return 0;
    }
  }

  const UF_long row_base =
    solver->refactor_u_supernode_l_row_begin[panel] + panel_offset;
  if (row_base + run_rows > solver->refactor_u_supernode_pattern_rows) {
    kls_egraph_record_u_supernode_l_panel_miss(shared);
    return 0;
  }
  UF_long trailing_entries = 0u;
  for (UF_long local = 0u; local < run_rows; ++local) {
    const UF_long begin =
      solver->refactor_u_supernode_l_row_ptr[row_base + local];
    const UF_long end =
      solver->refactor_u_supernode_l_row_ptr[row_base + local + 1u];
    if (end < begin || end > solver->refactor_u_supernode_l_trailing_entries ||
        end - begin > UF_long_max - trailing_entries) {
      kls_egraph_record_u_supernode_l_panel_miss(shared);
      return 0;
    }
    trailing_entries += end - begin;
  }
  const UF_long dense_scatter_cols = width - available_end;
  if (!shared->supernode_algorithm5_payoff_exec &&
      !kls_egraph_ragged_u_supernode_update_allows(
        run_rows, dense_scatter_cols, trailing_entries)) {
    kls_egraph_record_u_supernode_l_work_reject(shared);
    return 0;
  }

  const double *dense_panel =
    solver->refactor_u_supernode_l_dense_values +
    solver->refactor_u_supernode_dense_begin[panel];
  const UF_long *trailing_cols = solver->refactor_u_supernode_l_cols;
  const double *trailing_values = solver->refactor_u_supernode_l_values;
  if (trailing_entries > 0u &&
      (trailing_cols == NULL || trailing_values == NULL)) {
    return 0;
  }

  const UF_long trsv_entries = (run_rows * (run_rows - 1u)) / 2u;
  const UF_long dense_entries = run_rows * dense_scatter_cols;
  if (algorithm5_prefix_prep_candidate) {
    const UF_long current_slot =
      solver->refactor_supernode_algorithm5_payoff_run_current_pos[
        planned_run_id];
    if (current_slot >= shared->algorithm5_payoff_current_count) {
      return 0;
    }
    unsigned char state =
      kls_algorithm5_payoff_current_state_load(
        shared->algorithm5_payoff_current_flags, current_slot);
    unsigned spin = 0u;
    while (state == KLS_ALGORITHM5_PAYOFF_CURRENT_PREPARING) {
      if (kls_egraph_refactor_should_stop(shared)) {
        return -1;
      }
      kls_egraph_pipeline_pause(&spin);
      state = kls_algorithm5_payoff_current_state_load(
        shared->algorithm5_payoff_current_flags, current_slot);
    }
    if (state == KLS_ALGORITHM5_PAYOFF_CURRENT_READY &&
        kls_algorithm5_payoff_current_state_try_consume(
          shared->algorithm5_payoff_current_flags, current_slot)) {
      double *prepared_workspace =
        shared->algorithm5_payoff_workspace_values +
        algorithm5_workspace_begin + algorithm5_workspace_offset;
      if (shared->supernode_algorithm5_payoff_direct_prefix_prep) {
        for (UF_long local = 0u; local < run_rows; ++local) {
          const UF_long row = dep_local + local;
          const UF_long panel_local = panel_offset + local;
          const double ujk = prepared_workspace[local];
          ux[up + local] = ujk;
          x[row] = 0.0;
          if (shared->u_supernode_values) {
            kls_egraph_record_u_supernode_value(
              shared, dep_global + local, current_global, ujk);
          }
          const double *dense_row = dense_panel + panel_local * width;
          for (UF_long target = available_end; target < width; ++target) {
            x[local_start + target] -= ujk * dense_row[target];
          }
          const UF_long lrow = row_base + local;
          const UF_long begin = solver->refactor_u_supernode_l_row_ptr[lrow];
          const UF_long end =
            solver->refactor_u_supernode_l_row_ptr[lrow + 1u];
          for (UF_long p = begin; p < end; ++p) {
            x[trailing_cols[p]] -= ujk * trailing_values[p];
          }
        }
      } else {
        double *prepared_targets =
          shared->algorithm5_payoff_target_values +
          algorithm5_target_slot_begin;
        const UF_long *prepared_target_cols =
          solver->refactor_supernode_algorithm5_payoff_group_target_cols +
          algorithm5_target_slot_begin;
        for (UF_long local = 0u; local < run_rows; ++local) {
          const UF_long row = dep_local + local;
          const double ujk = prepared_workspace[local];
          ux[up + local] = ujk;
          x[row] = 0.0;
          if (shared->u_supernode_values) {
            kls_egraph_record_u_supernode_value(
              shared, dep_global + local, current_global, ujk);
          }
        }
        for (UF_long slot = 0u; slot < algorithm5_target_slots; ++slot) {
          x[prepared_target_cols[slot]] -= prepared_targets[slot];
        }
      }
      kls_egraph_record_algorithm5_payoff_prefix_prep(
        shared, run_rows, algorithm5_target_entries,
        shared->supernode_algorithm5_payoff_direct_prefix_prep
          ? 0u
          : algorithm5_target_slots);
      kls_egraph_record_u_supernode_l_update(
        shared, run_rows, trsv_entries + dense_entries + trailing_entries);
      kls_egraph_mark_u_supernode_l_panel_used(solver, panel);
      *up_io = up + run_rows;
      return 1;
    }
  }
  int use_algorithm5_slot_accum = 0;
  UF_long algorithm5_block_size = 0u;
  UF_long algorithm5_target_stamp_value = 0u;
  UF_long *algorithm5_target_stamp = NULL;
  UF_long *algorithm5_target_pos = NULL;
  const UF_long *algorithm5_target_cols = NULL;
  double *algorithm5_target_values = NULL;
  UF_long algorithm5_dense_target_slots = 0u;
  UF_long algorithm5_trailing_target_slots = 0u;
  if (algorithm5_slot_accum_candidate) {
    UF_long checked_k1 = 0u;
    UF_long checked_local_start = 0u;
    if (algorithm5_target_entries != dense_entries + trailing_entries ||
        algorithm5_pattern_width != width ||
        !kls_refactor_supernode_panel_block_info(
          solver, start, start + width, &checked_k1, &algorithm5_block_size,
          &checked_local_start) ||
        checked_k1 != k1 ||
        checked_local_start != local_start ||
        local_start > algorithm5_block_size ||
        width > algorithm5_block_size - local_start ||
        dense_scatter_cols > algorithm5_target_slots) {
      return 0;
    }
    algorithm5_target_cols =
      solver->refactor_supernode_algorithm5_payoff_group_target_cols +
      algorithm5_target_slot_begin;
    algorithm5_target_values =
      shared->algorithm5_payoff_target_values + algorithm5_target_slot_begin;
    algorithm5_dense_target_slots = dense_scatter_cols;
    algorithm5_trailing_target_slots =
      algorithm5_target_slots - algorithm5_dense_target_slots;
    for (UF_long slot = 0u; slot < algorithm5_dense_target_slots; ++slot) {
      const UF_long row = local_start + available_end + slot;
      if (row >= algorithm5_block_size ||
          algorithm5_target_cols[slot] != row) {
        return 0;
      }
    }
    memset(algorithm5_target_values, 0,
           (size_t)algorithm5_target_slots *
             sizeof(*algorithm5_target_values));
    if (algorithm5_trailing_target_slots > 0u) {
      if (!kls_egraph_worker_row_target_workspace(worker,
                                                  algorithm5_block_size)) {
        return 0;
      }
      if (worker->row_target_stamp == UF_long_max) {
        memset(worker->row_target_stamp_workspace, 0,
               (size_t)algorithm5_block_size *
                 sizeof(*worker->row_target_stamp_workspace));
        worker->row_target_stamp = 1u;
      } else {
        worker->row_target_stamp++;
        if (worker->row_target_stamp == 0u) {
          worker->row_target_stamp = 1u;
        }
      }
      algorithm5_target_stamp_value = worker->row_target_stamp;
      algorithm5_target_stamp = worker->row_target_stamp_workspace;
      algorithm5_target_pos = worker->row_target_pos_workspace;
      for (UF_long slot = algorithm5_dense_target_slots;
           slot < algorithm5_target_slots; ++slot) {
        const UF_long row = algorithm5_target_cols[slot];
        if (row >= algorithm5_block_size ||
            algorithm5_target_stamp[row] == algorithm5_target_stamp_value) {
          return 0;
        }
        algorithm5_target_stamp[row] = algorithm5_target_stamp_value;
        algorithm5_target_pos[row] = slot;
      }
    }
    use_algorithm5_slot_accum = 1;
  }

  UF_long workspace_request = run_rows;
  UF_long workspace_offset = 0u;
  double *workspace_base = NULL;
  if (shared->supernode_algorithm5_payoff_exec) {
    if (algorithm5_workspace_request == 0u ||
        algorithm5_workspace_offset > algorithm5_workspace_request ||
        run_rows > algorithm5_workspace_request - algorithm5_workspace_offset) {
      kls_egraph_record_u_supernode_l_work_reject(shared);
      return 0;
    }
    workspace_request = algorithm5_workspace_request;
    workspace_offset = algorithm5_workspace_offset;
  }
  if (use_algorithm5_slot_accum) {
    workspace_base =
      shared->algorithm5_payoff_workspace_values + algorithm5_workspace_begin;
  } else {
    workspace_base =
      kls_egraph_worker_supernode_workspace(worker, workspace_request);
  }
  if (workspace_base == NULL) {
    return 0;
  }
  double *workspace = workspace_base + workspace_offset;
  if (wait_for_dependencies) {
    for (UF_long local = 0u; local < run_rows; ++local) {
      if (!kls_egraph_refactor_wait_done(
            shared, start + panel_offset + local)) {
        return -1;
      }
    }
  }

  for (UF_long local = 0u; local < run_rows; ++local) {
    const UF_long row = dep_local + local;
    workspace[local] = x[row];
    x[row] = 0.0;
  }

  for (UF_long local = 0u; local < run_rows; ++local) {
    const UF_long panel_local = panel_offset + local;
    const double ujk = workspace[local];
    ux[up + local] = ujk;
    if (shared->u_supernode_values) {
      kls_egraph_record_u_supernode_value(
        shared, start + panel_local, current_global, ujk);
    }
    const double *dense_row = dense_panel + panel_local * width;
    for (UF_long target = panel_local + 1u; target < width; ++target) {
      const double update = ujk * dense_row[target];
      if (target < available_end) {
        workspace[target - panel_offset] -= update;
      } else if (use_algorithm5_slot_accum) {
        const UF_long row = local_start + target;
        const UF_long slot = target - available_end;
        if (row >= algorithm5_block_size ||
            slot >= algorithm5_dense_target_slots ||
            algorithm5_target_cols[slot] != row) {
          kls_egraph_refactor_record_invalid(shared);
          return -1;
        }
        algorithm5_target_values[slot] += update;
      } else {
        x[local_start + target] -= update;
      }
    }
    const UF_long row = row_base + local;
    const UF_long begin = solver->refactor_u_supernode_l_row_ptr[row];
    const UF_long end = solver->refactor_u_supernode_l_row_ptr[row + 1u];
    for (UF_long p = begin; p < end; ++p) {
      if (use_algorithm5_slot_accum) {
        const UF_long target_row = trailing_cols[p];
        if (algorithm5_trailing_target_slots == 0u ||
            target_row >= algorithm5_block_size ||
            algorithm5_target_stamp[target_row] !=
              algorithm5_target_stamp_value) {
          kls_egraph_refactor_record_invalid(shared);
          return -1;
        }
        algorithm5_target_values[algorithm5_target_pos[target_row]] +=
          ujk * trailing_values[p];
      } else {
        x[trailing_cols[p]] -= ujk * trailing_values[p];
      }
    }
  }
  if (use_algorithm5_slot_accum) {
    for (UF_long slot = 0u; slot < algorithm5_target_slots; ++slot) {
      x[algorithm5_target_cols[slot]] -= algorithm5_target_values[slot];
    }
    kls_egraph_record_algorithm5_payoff_slot_accum(
      shared, run_rows, algorithm5_target_entries, algorithm5_target_slots);
  }

  kls_egraph_record_u_supernode_l_update(
    shared, run_rows, trsv_entries + dense_entries + trailing_entries);
  kls_egraph_mark_u_supernode_l_panel_used(solver, panel);
  *up_io = up + run_rows;
  return 1;
}

