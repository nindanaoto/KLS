static void kls_row_first_pipeline_trace_producer_batch_state_union(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long target_count) {
  if (shared == NULL || trace == NULL ||
      shared->trace_state_union_mark == NULL ||
      shared->ctx == NULL || shared->batch_targets == NULL ||
      target_count == 0u) {
    return;
  }
  unsigned int generation = shared->trace_state_union_generation + 1u;
  if (generation == 0u) {
    memset(shared->trace_state_union_mark, 0,
           (size_t)shared->ctx->nk *
             sizeof(*shared->trace_state_union_mark));
    generation = 1u;
  }
  shared->trace_state_union_generation = generation;

  UF_long state_rows = 0u;
  UF_long unique_rows = 0u;
  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_pipeline_worker *worker =
      shared->batch_targets[t].worker;
    kls_row_first_partial_row *state = shared->batch_targets[t].state;
    if (worker == NULL || state == NULL ||
        worker->workspace.pattern == NULL ||
        state->pattern_count > shared->ctx->nk) {
      return;
    }
    kls_row_first_stats_add(&state_rows, state->pattern_count);
    for (UF_long p = 0; p < state->pattern_count; ++p) {
      const UF_long col = worker->workspace.pattern[p];
      if (col >= shared->ctx->nk) {
        return;
      }
      if (shared->trace_state_union_mark[col] != generation) {
        shared->trace_state_union_mark[col] = generation;
        kls_row_first_stats_add(&unique_rows, 1u);
      }
    }
  }
  kls_row_first_stats_add(&trace->producer_batch_state_rows, state_rows);
  kls_row_first_stats_add(&trace->producer_batch_unique_state_rows,
                          unique_rows);
}

static void kls_row_first_pipeline_trace_compact_window_state_union(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_trace *trace,
  UF_long target_count) {
  if (shared == NULL || trace == NULL ||
      shared->trace_state_union_mark == NULL ||
      shared->ctx == NULL || shared->compact_batch_targets == NULL ||
      target_count == 0u) {
    return;
  }
  unsigned int generation = shared->trace_state_union_generation + 1u;
  if (generation == 0u) {
    memset(shared->trace_state_union_mark, 0,
           (size_t)shared->ctx->nk *
             sizeof(*shared->trace_state_union_mark));
    generation = 1u;
  }
  shared->trace_state_union_generation = generation;

  UF_long unique_rows = 0u;
  for (UF_long t = 0; t < target_count; ++t) {
    const kls_row_first_compact_window_state *state =
      shared->compact_batch_targets[t].state;
    if (state == NULL || !state->active || state->pattern == NULL ||
        state->pattern_count > shared->ctx->nk) {
      continue;
    }
    for (UF_long p = 0; p < state->pattern_count; ++p) {
      const UF_long col = state->pattern[p];
      if (col >= shared->ctx->nk) {
        return;
      }
      if (shared->trace_state_union_mark[col] != generation) {
        shared->trace_state_union_mark[col] = generation;
        kls_row_first_stats_add(&unique_rows, 1u);
      }
    }
  }
  kls_row_first_stats_add(&trace->compact_window_unique_state_rows,
                          unique_rows);
}

static int kls_row_first_pipeline_apply_supernode_producer_batch(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_worker *current_worker,
  UF_long dep_begin,
  UF_long dep_end) {
  if (shared == NULL || current_worker == NULL ||
      !shared->producer_batch_enabled ||
      !shared->supernode_producer_batch_enabled ||
      shared->workers == NULL || shared->batch_targets == NULL ||
      shared->batch_target_capacity <= 1 || shared->ctx == NULL ||
      shared->u_entries == NULL || shared->workspace == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL ||
      shared->udiag_values == NULL ||
      dep_begin >= dep_end || dep_end >= shared->ctx->nk) {
    return 1;
  }
  if (shared->supernode_start == NULL || shared->supernode_end == NULL ||
      dep_begin < shared->supernode_valid_begin ||
      shared->supernode_start[dep_begin] != dep_begin ||
      shared->supernode_end[dep_begin] < dep_end) {
    return 1;
  }

  const UF_long run_rows = dep_end - dep_begin + 1u;
  UF_long run_entries = 0u;
  for (UF_long dep = dep_begin; dep <= dep_end; ++dep) {
    const UF_long row_begin = shared->workspace->u_row_ptr[dep];
    const UF_long row_end = shared->workspace->u_row_end[dep];
    if (row_begin > row_end || row_end > shared->u_entries->count ||
        shared->udiag_values[dep] == 0.0) {
      return 1;
    }
    kls_row_first_stats_add(&run_entries, row_end - row_begin);
  }
  if (run_entries == 0u) {
    return 1;
  }

  kls_row_first_pipeline_trace *producer_trace =
    shared->trace_enabled ? &current_worker->trace_current : NULL;
  UF_long target_count = 0u;
  for (int tid = 0; tid < shared->worker_count; ++tid) {
    kls_row_first_pipeline_worker *worker = shared->workers + tid;
    if (worker == current_worker) {
      continue;
    }
    if (producer_trace != NULL) {
      kls_row_first_stats_add(&producer_trace->producer_probe_workers, 1u);
    }
    kls_row_first_pipeline_producer_reject reject_reason =
      KLS_ROW_FIRST_PRODUCER_REJECT_NONE;
    if (!kls_row_first_pipeline_worker_supernode_batch_candidate(
          shared, worker, dep_begin, dep_end, &reject_reason)) {
      kls_row_first_pipeline_trace_producer_reject(producer_trace,
                                                  reject_reason);
      continue;
    }
    if (producer_trace != NULL) {
      kls_row_first_stats_add(&producer_trace->producer_probe_ready_roots, 1u);
    }
    if (target_count >= (UF_long)shared->batch_target_capacity) {
      return 0;
    }
    shared->batch_targets[target_count].worker = worker;
    shared->batch_targets[target_count].state = worker->active_state;
    shared->batch_targets[target_count].lij = 0.0;
    target_count++;
  }
  for (int slot = 0; slot < shared->lookahead_count; ++slot) {
    kls_row_first_pipeline_worker *worker =
      shared->lookahead_states + slot;
    if (!worker->lookahead_active || worker->lookahead_claimed) {
      continue;
    }
    if (producer_trace != NULL) {
      kls_row_first_stats_add(&producer_trace->producer_probe_lookahead, 1u);
    }
    kls_row_first_pipeline_producer_reject reject_reason =
      KLS_ROW_FIRST_PRODUCER_REJECT_NONE;
    if (!kls_row_first_pipeline_worker_supernode_batch_candidate(
          shared, worker, dep_begin, dep_end, &reject_reason)) {
      kls_row_first_pipeline_trace_producer_reject(producer_trace,
                                                  reject_reason);
      continue;
    }
    if (producer_trace != NULL) {
      kls_row_first_stats_add(&producer_trace->producer_probe_ready_roots, 1u);
    }
    if (target_count >= (UF_long)shared->batch_target_capacity) {
      return 0;
    }
    shared->batch_targets[target_count].worker = worker;
    shared->batch_targets[target_count].state = worker->active_state;
    shared->batch_targets[target_count].lij = 0.0;
    target_count++;
  }

  const UF_long candidate_target_u_entries =
    target_count != 0u && run_entries > UF_long_max / target_count
      ? UF_long_max
      : run_entries * target_count;
  if (producer_trace != NULL) {
    kls_row_first_stats_add(&producer_trace->producer_candidate_targets,
                            target_count);
    kls_row_first_stats_add(
      &producer_trace->producer_candidate_target_u_entries,
      candidate_target_u_entries);
  }
  if (target_count < 2u) {
    if (producer_trace != NULL) {
      kls_row_first_stats_add(&producer_trace->producer_probe_underfilled, 1u);
      kls_row_first_stats_add(
        &producer_trace->producer_probe_underfilled_targets,
        target_count);
      kls_row_first_stats_add(
        &producer_trace->producer_underfilled_target_u_entries,
        candidate_target_u_entries);
    }
    return 1;
  }
  const UF_long saved_targets = target_count - 1u;
  const UF_long saved_stream =
    saved_targets != 0u && run_entries > UF_long_max / saved_targets
      ? UF_long_max
      : run_entries * saved_targets;
  if (saved_stream < KLS_ROW_FIRST_PRODUCER_BATCH_MIN_SAVED_STREAM) {
    if (producer_trace != NULL) {
      kls_row_first_stats_add(&producer_trace->producer_probe_low_saved_stream,
                              1u);
      kls_row_first_stats_add(
        &producer_trace->producer_low_saved_stream_target_u_entries,
        candidate_target_u_entries);
    }
    return 1;
  }

  /*
   * The opt-in supernode producer can be expensive; claim target states and
   * run it outside the pipeline mutex while owner threads wait on the gate.
   */
  shared->supernode_producer_batch_active = 1;
  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_pipeline_worker *worker =
      shared->batch_targets[t].worker;
    worker->external_update_active = 1;
  }

  pthread_mutex_unlock(&shared->lock);
  int ok = 1;
  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_pipeline_worker *worker =
      shared->batch_targets[t].worker;
    kls_row_first_partial_row *state = shared->batch_targets[t].state;
    UF_long applied_rows = 0u;
    if (!kls_row_first_entries_reserve_append(&worker->l_entries,
                                              run_rows)) {
      ok = 0;
      break;
    }
    const int compact_status =
      kls_row_first_partial_apply_supernode_run_compact(
        shared->ctx, &worker->workspace, &worker->l_entries,
        shared->u_entries, shared->udiag_values,
        shared->workspace->u_row_ptr, shared->workspace->u_row_end,
        state, dep_begin, dep_end, &applied_rows, 1, 0,
        shared->stats);
    if (compact_status < 0) {
      ok = 0;
      break;
    }
    if (compact_status == 0 &&
        !kls_row_first_partial_apply_supernode_run_scalar(
          shared->ctx, &worker->workspace, &worker->l_entries,
          shared->u_entries, shared->udiag_values,
          shared->workspace->u_row_ptr, shared->workspace->u_row_end,
          state, dep_begin, dep_end, NULL, &applied_rows)) {
      ok = 0;
      break;
    }
    if (applied_rows != run_rows) {
      ok = 0;
      break;
    }
    worker->pipeline_supernode_update_groups++;
    worker->pipeline_supernode_update_rows += run_rows;
  }
  pthread_mutex_lock(&shared->lock);
  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_pipeline_worker *worker =
      shared->batch_targets[t].worker;
    worker->external_update_active = 0;
  }
  shared->supernode_producer_batch_active = 0;
  pthread_cond_broadcast(&shared->cond);
  if (!ok) {
    return 0;
  }

  if (producer_trace != NULL) {
    kls_row_first_stats_add(&producer_trace->producer_batch_calls, 1u);
    kls_row_first_stats_add(&producer_trace->producer_batch_targets,
                            target_count);
    kls_row_first_stats_add(&producer_trace->producer_batch_stream_u_entries,
                            run_entries);
    kls_row_first_stats_add(&producer_trace->producer_batch_target_u_entries,
                            candidate_target_u_entries);
    kls_row_first_pipeline_trace_producer_batch_state_union(
      shared, producer_trace, target_count);
  }
  return 1;
}

static int kls_row_first_pipeline_apply_scalar_producer_targets(
  const kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_batch_target *targets,
  UF_long target_count,
  UF_long dep,
  const UF_long *row_cols,
  const double *row_values,
  UF_long row_entries,
  UF_long *internal_entries_out,
  UF_long *output_entries_out) {
  if (internal_entries_out != NULL) {
    *internal_entries_out = 0u;
  }
  if (output_entries_out != NULL) {
    *output_entries_out = 0u;
  }
  if (shared == NULL || targets == NULL || target_count == 0u ||
      shared->ctx == NULL || row_cols == NULL || row_values == NULL ||
      dep >= shared->ctx->nk) {
    return 0;
  }

  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_pipeline_worker *worker = targets[t].worker;
    if (worker == NULL ||
        !kls_row_first_entries_reserve_append(&worker->l_entries, 1u)) {
      return 0;
    }
  }

  for (UF_long t = 0; t < target_count; ++t) {
    kls_row_first_pipeline_worker *worker = targets[t].worker;
    kls_row_first_partial_row *state = targets[t].state;
    if (worker == NULL || state == NULL ||
        worker->workspace.dep_heap == NULL ||
        worker->workspace.x == NULL) {
      return 0;
    }
    const UF_long popped =
      kls_row_first_heap_pop(worker->workspace.dep_heap,
                             &state->dep_heap_size);
    if (popped != dep ||
        !kls_row_first_entries_append_reserved(
          &worker->l_entries, state->row, dep, targets[t].lij)) {
      return 0;
    }
    worker->workspace.x[dep] = 0.0;
  }

  UF_long internal_entries = 0u;
  UF_long output_entries = 0u;
  for (UF_long up = 0u; up < row_entries; ++up) {
    const UF_long col = row_cols[up];
    if (col <= dep || col >= shared->ctx->nk) {
      return 0;
    }
    const double uvalue = row_values[up];
    for (UF_long t = 0; t < target_count; ++t) {
      kls_row_first_pipeline_worker *worker = targets[t].worker;
      kls_row_first_partial_row *state = targets[t].state;
      if (worker == NULL || state == NULL ||
          worker->workspace.x == NULL ||
          worker->workspace.mark == NULL ||
          worker->workspace.pattern == NULL ||
          worker->workspace.dep_heap == NULL) {
        return 0;
      }
      double *x = worker->workspace.x;
      unsigned int *mark = worker->workspace.mark;
      UF_long *pattern = worker->workspace.pattern;
      UF_long *dep_heap = worker->workspace.dep_heap;
      if (mark[col] != state->generation) {
        mark[col] = state->generation;
        pattern[state->pattern_count++] = col;
        if (col < state->row) {
          kls_row_first_heap_push(dep_heap, &state->dep_heap_size, col);
        }
        x[col] = 0.0;
      }
      x[col] -= targets[t].lij * uvalue;
      if (col < state->row) {
        kls_row_first_stats_add(&internal_entries, 1u);
      } else {
        kls_row_first_stats_add(&output_entries, 1u);
      }
    }
  }

  if (internal_entries_out != NULL) {
    *internal_entries_out = internal_entries;
  }
  if (output_entries_out != NULL) {
    *output_entries_out = output_entries;
  }
  return 1;
}

static int kls_row_first_pipeline_apply_producer_batch(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_pipeline_worker *current_worker,
  UF_long dep) {
  if (shared == NULL || current_worker == NULL ||
      !shared->producer_batch_enabled ||
      shared->workers == NULL || shared->batch_targets == NULL ||
      shared->batch_target_capacity <= 1 || shared->ctx == NULL ||
      shared->u_entries == NULL || shared->workspace == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL ||
      shared->udiag_values == NULL || dep >= shared->ctx->nk) {
    return 1;
  }
  const UF_long row_begin = shared->workspace->u_row_ptr[dep];
  const UF_long row_end = shared->workspace->u_row_end[dep];
  if (row_begin > row_end || row_end > shared->u_entries->count ||
      row_begin == row_end || shared->udiag_values[dep] == 0.0) {
    return 1;
  }
  const UF_long row_entries = row_end - row_begin;
  kls_row_first_pipeline_trace *producer_trace =
    shared->trace_enabled && current_worker != NULL
      ? &current_worker->trace_current : NULL;

  UF_long target_count = 0;
  for (int tid = 0; tid < shared->worker_count; ++tid) {
    kls_row_first_pipeline_worker *worker = shared->workers + tid;
    if (worker == current_worker) {
      continue;
    }
    if (producer_trace != NULL) {
      kls_row_first_stats_add(&producer_trace->producer_probe_workers, 1u);
    }
    kls_row_first_pipeline_producer_reject reject_reason =
      KLS_ROW_FIRST_PRODUCER_REJECT_NONE;
    if (!kls_row_first_pipeline_worker_scalar_batch_candidate(
          shared, worker, dep, &reject_reason)) {
      int retry_after_catchup = 0;
      if (shared->active_catchup_batch_enabled &&
          reject_reason == KLS_ROW_FIRST_PRODUCER_REJECT_NOT_ROOT &&
          worker->active_state != NULL &&
          worker->active_order_epoch == shared->order_epoch &&
          worker->workspace.mark != NULL &&
          worker->workspace.dep_heap != NULL &&
          dep < worker->active_state->row &&
          worker->workspace.mark[dep] ==
            worker->active_state->generation &&
          worker->active_state->dep_heap_size > 0u &&
          worker->workspace.dep_heap[0] < dep) {
        if (producer_trace != NULL) {
          kls_row_first_stats_add(
            &producer_trace->producer_active_catchup_attempts, 1u);
        }
        const UF_long before_l_count = worker->l_entries.count;
        if (!kls_row_first_partial_apply_ready_until(
              shared->ctx, &worker->workspace, &worker->l_entries,
              shared->u_entries, shared->udiag_values,
              shared->workspace->u_row_ptr, shared->workspace->u_row_end,
              shared->supernode_start, shared->supernode_end,
              shared->supernode_valid_begin, shared->row_done,
              shared->active_rank, shared->completed_pos,
              worker->active_state, dep,
              &worker->pipeline_supernode_update_groups,
              &worker->pipeline_supernode_update_rows,
              &worker->pipeline_supernode_panel_update_groups,
              &worker->pipeline_supernode_panel_update_rows,
              shared->stats,
              shared->trace_enabled ? &worker->trace_current : NULL,
              NULL)) {
          return 0;
        }
        if (producer_trace != NULL &&
            worker->l_entries.count > before_l_count) {
          kls_row_first_stats_add(
            &producer_trace->producer_active_catchup_deps,
            worker->l_entries.count - before_l_count);
        }
        retry_after_catchup = 1;
      }
      if (!retry_after_catchup ||
          !kls_row_first_pipeline_worker_scalar_batch_candidate(
            shared, worker, dep, &reject_reason)) {
        kls_row_first_pipeline_trace_producer_reject(producer_trace,
                                                    reject_reason);
        continue;
      }
      if (producer_trace != NULL) {
        kls_row_first_stats_add(
          &producer_trace->producer_active_catchup_targets, 1u);
      }
    }
    if (producer_trace != NULL) {
      kls_row_first_stats_add(&producer_trace->producer_probe_ready_roots, 1u);
    }
    if (target_count >= (UF_long)shared->batch_target_capacity) {
      return 0;
    }
    kls_row_first_partial_row *state = worker->active_state;
    const double lij = worker->workspace.x[dep] / shared->udiag_values[dep];
    shared->batch_targets[target_count].worker = worker;
    shared->batch_targets[target_count].state = state;
    shared->batch_targets[target_count].lij = lij;
    target_count++;
  }
  const UF_long active_target_count = target_count;
  for (int slot = 0; slot < shared->lookahead_count; ++slot) {
    kls_row_first_pipeline_worker *worker =
      shared->lookahead_states + slot;
    if (!worker->lookahead_active || worker->lookahead_claimed) {
      continue;
    }
    if (producer_trace != NULL) {
      kls_row_first_stats_add(&producer_trace->producer_probe_lookahead, 1u);
    }
    if (worker->active_order_epoch != shared->order_epoch) {
      kls_row_first_pipeline_trace_producer_reject(
        producer_trace, KLS_ROW_FIRST_PRODUCER_REJECT_EPOCH);
      continue;
    }
    if (!kls_row_first_partial_apply_ready_until(
          shared->ctx, &worker->workspace, &worker->l_entries,
          shared->u_entries, shared->udiag_values,
          shared->workspace->u_row_ptr, shared->workspace->u_row_end,
          shared->supernode_start, shared->supernode_end,
          shared->supernode_valid_begin, shared->row_done,
          shared->active_rank, shared->completed_pos,
          worker->active_state, dep,
          &worker->pipeline_supernode_update_groups,
          &worker->pipeline_supernode_update_rows,
          &worker->pipeline_supernode_panel_update_groups,
          &worker->pipeline_supernode_panel_update_rows,
          shared->stats,
          shared->trace_enabled ? &worker->trace_current : NULL,
          NULL)) {
      return 0;
    }
    kls_row_first_pipeline_producer_reject reject_reason =
      KLS_ROW_FIRST_PRODUCER_REJECT_NONE;
    if (!kls_row_first_pipeline_worker_scalar_batch_candidate(
          shared, worker, dep, &reject_reason)) {
      kls_row_first_pipeline_trace_producer_reject(producer_trace,
                                                  reject_reason);
      continue;
    }
    if (producer_trace != NULL) {
      kls_row_first_stats_add(&producer_trace->producer_probe_ready_roots, 1u);
    }
    if (target_count >= (UF_long)shared->batch_target_capacity) {
      return 0;
    }
    kls_row_first_partial_row *state = worker->active_state;
    const double lij = worker->workspace.x[dep] / shared->udiag_values[dep];
    shared->batch_targets[target_count].worker = worker;
    shared->batch_targets[target_count].state = state;
    shared->batch_targets[target_count].lij = lij;
    target_count++;
  }
  const UF_long candidate_target_u_entries =
    target_count != 0u && row_entries > UF_long_max / target_count
      ? UF_long_max
      : row_entries * target_count;
  if (producer_trace != NULL) {
    kls_row_first_stats_add(&producer_trace->producer_candidate_targets,
                            target_count);
    kls_row_first_stats_add(
      &producer_trace->producer_candidate_target_u_entries,
      candidate_target_u_entries);
  }
  if (target_count < 2u) {
    if (producer_trace != NULL) {
      kls_row_first_stats_add(&producer_trace->producer_probe_underfilled, 1u);
      kls_row_first_stats_add(&producer_trace->producer_probe_underfilled_targets,
                              target_count);
      kls_row_first_stats_add(
        &producer_trace->producer_underfilled_target_u_entries,
        candidate_target_u_entries);
    }
    return 1;
  }
  const UF_long saved_targets = target_count - 1u;
  const UF_long saved_stream =
    saved_targets != 0u && row_entries > UF_long_max / saved_targets
      ? UF_long_max
      : row_entries * saved_targets;
  if (saved_stream < KLS_ROW_FIRST_PRODUCER_BATCH_MIN_SAVED_STREAM) {
    if (producer_trace != NULL) {
      kls_row_first_stats_add(&producer_trace->producer_probe_low_saved_stream,
                              1u);
      kls_row_first_stats_add(
        &producer_trace->producer_low_saved_stream_target_u_entries,
        candidate_target_u_entries);
    }
    return 1;
  }

  UF_long internal_entries = 0u;
  UF_long output_entries = 0u;
  if (active_target_count == target_count) {
    if (target_count >
          (UF_long)(SIZE_MAX / sizeof(*shared->batch_targets)) ||
        row_entries > (UF_long)(SIZE_MAX / sizeof(*shared->u_entries->col)) ||
        row_entries > (UF_long)(SIZE_MAX /
                                sizeof(*shared->u_entries->value))) {
      return 0;
    }
    kls_row_first_pipeline_batch_target *detached_targets =
      (kls_row_first_pipeline_batch_target *)malloc(
        (size_t)target_count * sizeof(*detached_targets));
    if (detached_targets == NULL) {
      return 0;
    }
    UF_long *detached_cols =
      (UF_long *)malloc((size_t)row_entries *
                        sizeof(*detached_cols));
    double *detached_values =
      (double *)malloc((size_t)row_entries *
                       sizeof(*detached_values));
    if (detached_cols == NULL || detached_values == NULL) {
      free(detached_values);
      free(detached_cols);
      free(detached_targets);
      return 0;
    }
    memcpy(detached_cols, shared->u_entries->col + row_begin,
           (size_t)row_entries * sizeof(*detached_cols));
    memcpy(detached_values, shared->u_entries->value + row_begin,
           (size_t)row_entries * sizeof(*detached_values));
    for (UF_long t = 0; t < target_count; ++t) {
      kls_row_first_pipeline_worker *worker =
        shared->batch_targets[t].worker;
      detached_targets[t] = shared->batch_targets[t];
      if (worker != NULL) {
        worker->external_update_active = 1;
      }
    }
    pthread_mutex_unlock(&shared->lock);
    const int ok = kls_row_first_pipeline_apply_scalar_producer_targets(
      shared, detached_targets, target_count, dep,
      detached_cols, detached_values, row_entries,
      &internal_entries, &output_entries);
    pthread_mutex_lock(&shared->lock);
    for (UF_long t = 0; t < target_count; ++t) {
      kls_row_first_pipeline_worker *worker = detached_targets[t].worker;
      if (worker != NULL) {
        worker->external_update_active = 0;
      }
    }
    pthread_cond_broadcast(&shared->cond);
    if (!ok) {
      free(detached_values);
      free(detached_cols);
      free(detached_targets);
      return 0;
    }
    memcpy(shared->batch_targets, detached_targets,
           (size_t)target_count * sizeof(*shared->batch_targets));
    free(detached_values);
    free(detached_cols);
    free(detached_targets);
  } else if (!kls_row_first_pipeline_apply_scalar_producer_targets(
               shared, shared->batch_targets, target_count, dep,
               shared->u_entries->col + row_begin,
               shared->u_entries->value + row_begin, row_entries,
               &internal_entries, &output_entries)) {
    return 0;
  }

  if (producer_trace != NULL) {
    kls_row_first_stats_add(&producer_trace->producer_batch_calls, 1u);
    kls_row_first_stats_add(&producer_trace->producer_batch_targets,
                            target_count);
    kls_row_first_stats_add(&producer_trace->producer_batch_stream_u_entries,
                            row_entries);
    for (UF_long t = 0; t < target_count; ++t) {
      kls_row_first_stats_add(&producer_trace->producer_batch_target_u_entries,
                              row_entries);
    }
    kls_row_first_stats_add(&producer_trace->producer_batch_internal_entries,
                            internal_entries);
    kls_row_first_stats_add(&producer_trace->producer_batch_output_entries,
                            output_entries);
    kls_row_first_pipeline_trace_producer_batch_state_union(
      shared, producer_trace, target_count);
  }
  return 1;
}

static void kls_row_first_pipeline_clear_lookahead_state(
  kls_row_first_pipeline_worker *state) {
  if (state == NULL || !state->lookahead_active) {
    return;
  }
  if (state->active_state != NULL) {
    kls_row_first_partial_row_clear(state->active_state,
                                    &state->workspace);
  }
  state->l_entries.count = 0u;
  state->u_entries.count = 0u;
  memset(&state->trace_current, 0, sizeof(state->trace_current));
  memset(&state->state_storage, 0, sizeof(state->state_storage));
  state->state_storage.row = UF_long_max;
  state->active_state = NULL;
  state->active_order_epoch = 0u;
  state->lookahead_pos = KLS_KLU_EMPTY;
  state->lookahead_row = KLS_KLU_EMPTY;
  state->lookahead_active = 0;
  state->lookahead_claimed = 0;
}

static void kls_row_first_pipeline_clear_unclaimed_lookahead(
  kls_row_first_pipeline_shared *shared) {
  if (shared == NULL || shared->lookahead_states == NULL) {
    return;
  }
  for (int slot = 0; slot < shared->lookahead_count; ++slot) {
    kls_row_first_pipeline_worker *state =
      shared->lookahead_states + slot;
    if (state->lookahead_active && !state->lookahead_claimed) {
      kls_row_first_pipeline_clear_lookahead_state(state);
    }
  }
  shared->lookahead_next_pos =
    (UF_long)atomic_load_explicit(&shared->next_pos, memory_order_acquire);
}

static int kls_row_first_compact_window_value_pos(
  const kls_row_first_compact_window_state *state,
  UF_long col,
  UF_long *pos_out) {
  if (pos_out != NULL) {
    *pos_out = KLS_KLU_EMPTY;
  }
  if (state == NULL || pos_out == NULL) {
    return 0;
  }
  int found = 0;
  const UF_long slot =
    kls_row_first_compact_window_index_slot(state, col, &found);
  if (found) {
    const UF_long at = state->index_pos[slot];
    if (at >= state->pattern_count || state->pattern[at] != col) {
      return 0;
    }
    *pos_out = at;
    return 1;
  }
  for (UF_long at = 0u; at < state->pattern_count; ++at) {
    if (state->pattern[at] == col) {
      *pos_out = at;
      return 1;
    }
  }
  return 0;
}

static int kls_row_first_compact_window_apply_dep(
  const kls_row_first_pipeline_shared *shared,
  kls_row_first_compact_window_state *state,
  UF_long dep,
  kls_row_first_pipeline_trace *trace) {
  if (shared == NULL || state == NULL || !state->active ||
      state->values == NULL || shared->ctx == NULL ||
      shared->u_entries == NULL || shared->udiag_values == NULL ||
      shared->workspace == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL ||
      dep >= state->row || state->row >= shared->ctx->nk ||
      state->heap_size == 0u || state->heap[0] != dep) {
    return 0;
  }
  UF_long dep_pos = KLS_KLU_EMPTY;
  if (!kls_row_first_compact_window_value_pos(state, dep, &dep_pos) ||
      dep_pos >= state->pattern_count) {
    return 0;
  }
  const double dep_pivot = shared->udiag_values[dep];
  if (dep_pivot == 0.0) {
    return 0;
  }
  const UF_long row_begin = shared->workspace->u_row_ptr[dep];
  const UF_long row_end = shared->workspace->u_row_end[dep];
  if (row_begin > row_end || row_end > shared->u_entries->count) {
    return 0;
  }
  const UF_long popped =
    kls_row_first_heap_pop(state->heap, &state->heap_size);
  if (popped != dep) {
    return 0;
  }
  const double lij = state->values[dep_pos] / dep_pivot;
  if (!kls_row_first_compact_window_l_append(state, dep, lij)) {
    return 0;
  }
  state->values[dep_pos] = 0.0;

  int deferred_output_cache =
    shared->compact_deferred_output_cache_enabled &&
    shared->compact_window_delay_output_enabled &&
    (state->deferred_output_valid ||
     row_end - row_begin >= shared->compact_deferred_output_min_u_entries);
  if (deferred_output_cache &&
      !kls_row_first_compact_window_deferred_output_begin_dep(
        state, trace)) {
    deferred_output_cache = 0;
  }

  UF_long trace_internal_entries = 0u;
  UF_long trace_output_entries = 0u;
  UF_long delayed_output_entries = 0u;
  for (UF_long up = row_begin; up < row_end; ++up) {
    const UF_long col = shared->u_entries->col[up];
    if (col <= dep || col >= shared->ctx->nk) {
      return 0;
    }
    if (shared->compact_window_delay_output_enabled &&
        col >= state->row) {
      if (deferred_output_cache &&
          !kls_row_first_compact_window_deferred_output_insert(
            state, col, -lij * shared->u_entries->value[up],
            shared->compact_deferred_output_max_entries, trace)) {
        deferred_output_cache = 0;
      }
      delayed_output_entries++;
      continue;
    }
    if (!kls_row_first_compact_window_insert(
          state, state->row, col, -lij * shared->u_entries->value[up],
          shared->compact_window_max_entries, NULL)) {
      return 0;
    }
    if (col < state->row) {
      trace_internal_entries++;
    } else {
      trace_output_entries++;
    }
  }
  if (deferred_output_cache) {
    (void)kls_row_first_compact_window_deferred_output_finish_dep(
      state, trace);
  }
  if (trace != NULL) {
    kls_row_first_stats_add(&trace->scalar_dep_calls, 1u);
    kls_row_first_stats_add(&trace->scalar_dep_l_entries, 1u);
    kls_row_first_stats_add(&trace->scalar_dep_u_entries,
                            row_end - row_begin);
    kls_row_first_stats_add(&trace->scalar_u_internal_entries,
                            trace_internal_entries);
    kls_row_first_stats_add(&trace->scalar_u_output_entries,
                            trace_output_entries);
    kls_row_first_stats_add(&trace->compact_window_delayed_output_skips,
                            delayed_output_entries);
  }
  return 1;
}

static UF_long kls_row_first_entries_lower_bound_col(
  const kls_row_first_entries *entries,
  UF_long begin,
  UF_long end,
  UF_long target) {
  if (entries == NULL || entries->col == NULL || begin > end ||
      end > entries->count) {
    return begin;
  }
  UF_long lo = begin;
  UF_long hi = end;
  while (lo < hi) {
    const UF_long mid = lo + (hi - lo) / 2u;
    if (entries->col[mid] < target) {
      lo = mid + 1u;
    } else {
      hi = mid;
    }
  }
  return lo;
}

static int kls_row_first_workspace_accumulate_claim_value(
  kls_row_first_workspace *workspace,
  unsigned int generation,
  UF_long nk,
  UF_long *pattern_count_io,
  UF_long col,
  double delta) {
  if (workspace == NULL || workspace->x == NULL ||
      workspace->mark == NULL || workspace->pattern == NULL ||
      pattern_count_io == NULL || col >= nk) {
    return 0;
  }
  if (workspace->mark[col] != generation) {
    if (*pattern_count_io >= nk) {
      return 0;
    }
    workspace->mark[col] = generation;
    workspace->pattern[*pattern_count_io] = col;
    (*pattern_count_io)++;
    workspace->x[col] = delta;
  } else {
    workspace->x[col] += delta;
  }
  return 1;
}

static int kls_row_first_dep_list_contains(
  const UF_long *deps,
  UF_long dep_count,
  UF_long dep) {
  if (deps == NULL) {
    return 0;
  }
  for (UF_long p = 0u; p < dep_count; ++p) {
    if (deps[p] == dep) {
      return 1;
    }
  }
  return 0;
}

static int kls_row_first_dep_sorted_contains(
  const UF_long *deps,
  UF_long dep_count,
  UF_long dep) {
  if (deps == NULL || dep_count == 0u) {
    return 0;
  }
  UF_long lo = 0u;
  UF_long hi = dep_count;
  while (lo < hi) {
    const UF_long mid = lo + (hi - lo) / 2u;
    if (deps[mid] < dep) {
      lo = mid + 1u;
    } else {
      hi = mid;
    }
  }
  return lo < dep_count && deps[lo] == dep;
}

static int kls_row_first_compact_window_replay_delayed_output_range_to_workspace(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_compact_window_state *state,
  kls_row_first_workspace *workspace,
  UF_long *pattern_count_io,
  kls_row_first_pipeline_trace *trace,
  UF_long begin_l_count,
  UF_long end_l_count,
  const UF_long *skip_deps,
  UF_long skip_dep_count,
  int skip_deps_sorted,
  int update_cutoff);

static int kls_row_first_compact_window_apply_deferred_output_cache(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_compact_window_state *state,
  kls_row_first_workspace *workspace,
  UF_long *pattern_count_io,
  kls_row_first_pipeline_trace *trace) {
  if (shared == NULL || state == NULL || workspace == NULL ||
      pattern_count_io == NULL ||
      (!shared->compact_deferred_output_cache_enabled &&
       !shared->compact_group_output_cache_enabled) ||
      !state->deferred_output_valid || state->deferred_output_disabled) {
    return 1;
  }
  if (state->deferred_output_l_count > state->l_count ||
      state->deferred_output_start_l_count >
        state->deferred_output_l_count) {
    kls_row_first_compact_window_deferred_output_disable(
      state, trace, 0);
    return 1;
  }
  if (state->deferred_output_start_l_count !=
      state->delayed_output_replayed_l_count) {
    if (state->deferred_output_start_l_count <
        state->delayed_output_replayed_l_count) {
      kls_row_first_compact_window_deferred_output_reset(state);
      (void)kls_row_first_compact_window_deferred_output_bump_generation(
        state);
      return 1;
    }
    if (!kls_row_first_compact_window_replay_delayed_output_range_to_workspace(
          shared, state, workspace, pattern_count_io, trace,
          state->delayed_output_replayed_l_count,
          state->deferred_output_start_l_count, NULL, 0u, 0, 0)) {
      return 0;
    }
    state->delayed_output_replayed_l_count =
      state->deferred_output_start_l_count;
  }
  if (state->deferred_output_count > state->deferred_output_capacity ||
      state->deferred_output_cols == NULL ||
      state->deferred_output_values == NULL ||
      shared->ctx == NULL) {
    return 0;
  }
  for (UF_long p = 0u; p < state->deferred_output_count; ++p) {
    const UF_long col = state->deferred_output_cols[p];
    if (col < state->row || col >= shared->ctx->nk) {
      return 0;
    }
    if (!kls_row_first_workspace_accumulate_claim_value(
          workspace, state->generation, shared->ctx->nk,
          pattern_count_io, col, state->deferred_output_values[p])) {
      return 0;
    }
  }
  const UF_long covered_l_entries =
    state->deferred_output_l_count -
    state->deferred_output_start_l_count;
  state->delayed_output_replayed_l_count =
    state->deferred_output_l_count;
  if (trace != NULL) {
    kls_row_first_stats_add(
      &trace->compact_window_deferred_output_cache_applies, 1u);
    kls_row_first_stats_add(
      &trace->compact_window_deferred_output_cache_l_entries,
      covered_l_entries);
    kls_row_first_stats_add(
      &trace->compact_window_deferred_output_cache_entries,
      state->deferred_output_count);
    if (state->deferred_output_count > 0u) {
      kls_row_first_stats_add(
        &trace->compact_window_delayed_output_replays, 1u);
      kls_row_first_stats_add(
        &trace->compact_window_delayed_output_deps,
        covered_l_entries);
      kls_row_first_stats_add(
        &trace->compact_window_delayed_output_entries,
        state->deferred_output_count);
      kls_row_first_stats_add(&trace->scalar_u_output_entries,
                              state->deferred_output_count);
    }
  }
  kls_row_first_compact_window_deferred_output_reset(state);
  (void)kls_row_first_compact_window_deferred_output_bump_generation(state);
  return 1;
}

static int kls_row_first_compact_window_replay_delayed_output_range_to_workspace(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_compact_window_state *state,
  kls_row_first_workspace *workspace,
  UF_long *pattern_count_io,
  kls_row_first_pipeline_trace *trace,
  UF_long begin_l_count,
  UF_long end_l_count,
  const UF_long *skip_deps,
  UF_long skip_dep_count,
  int skip_deps_sorted,
  int update_cutoff) {
  if (shared == NULL || state == NULL ||
      !shared->compact_window_delay_output_enabled) {
    return 1;
  }
  if (shared->ctx == NULL ||
      !state->active || state->row >= shared->ctx->nk ||
      state->generation == 0u ||
      workspace == NULL || pattern_count_io == NULL ||
      shared->u_entries == NULL || shared->workspace == NULL ||
      shared->workspace->u_row_ptr == NULL ||
      shared->workspace->u_row_end == NULL) {
    return 0;
  }
  if (begin_l_count > end_l_count || end_l_count > state->l_count) {
    return 0;
  }
  if (update_cutoff &&
      begin_l_count != state->delayed_output_replayed_l_count) {
    return 0;
  }
  UF_long replay_deps = 0u;
  UF_long replay_entries = 0u;
  UF_long replay_scan_entries = 0u;
  UF_long replay_seek_skips = 0u;
  for (UF_long lp = begin_l_count; lp < end_l_count; ++lp) {
    const UF_long dep = state->l_cols[lp];
    if (dep >= state->row || dep >= shared->ctx->nk) {
      return 0;
    }
    if (skip_dep_count > 0u &&
        (skip_deps_sorted
           ? kls_row_first_dep_sorted_contains(
               skip_deps, skip_dep_count, dep)
           : kls_row_first_dep_list_contains(
               skip_deps, skip_dep_count, dep))) {
      continue;
    }
    const UF_long row_begin = shared->workspace->u_row_ptr[dep];
    const UF_long row_end = shared->workspace->u_row_end[dep];
    if (row_begin > row_end || row_end > shared->u_entries->count) {
      return 0;
    }
    const double lij = state->l_values[lp];
    UF_long dep_output_entries = 0u;
    UF_long scan_begin = row_begin;
    if (shared->order_epoch == 0u) {
      scan_begin = kls_row_first_entries_lower_bound_col(
        shared->u_entries, row_begin, row_end, state->row);
      if (scan_begin > row_begin) {
        kls_row_first_stats_add(&replay_seek_skips,
                                scan_begin - row_begin);
      }
    }
    if (row_end >= scan_begin) {
      kls_row_first_stats_add(&replay_scan_entries,
                              row_end - scan_begin);
    }
    for (UF_long up = scan_begin; up < row_end; ++up) {
      const UF_long col = shared->u_entries->col[up];
      if (col <= dep || col >= shared->ctx->nk) {
        return 0;
      }
      if (shared->order_epoch != 0u && col < state->row) {
        continue;
      }
      if (!kls_row_first_workspace_accumulate_claim_value(
            workspace, state->generation, shared->ctx->nk,
            pattern_count_io, col,
            -lij * shared->u_entries->value[up])) {
        return 0;
      }
      dep_output_entries++;
    }
    if (dep_output_entries > 0u) {
      replay_deps++;
      kls_row_first_stats_add(&replay_entries, dep_output_entries);
    }
  }
  if (update_cutoff) {
    state->delayed_output_replayed_l_count = end_l_count;
    kls_row_first_compact_window_deferred_output_reset(state);
    (void)kls_row_first_compact_window_deferred_output_bump_generation(
      state);
  }
  if (trace != NULL) {
    kls_row_first_stats_add(&trace->compact_window_delayed_output_replays,
                            replay_deps > 0u ? 1u : 0u);
    kls_row_first_stats_add(&trace->compact_window_delayed_output_deps,
                            replay_deps);
    kls_row_first_stats_add(&trace->compact_window_delayed_output_entries,
                            replay_entries);
    kls_row_first_stats_add(
      &trace->compact_window_delayed_output_scan_entries,
      replay_scan_entries);
    kls_row_first_stats_add(&trace->compact_window_delayed_output_seek_skips,
                            replay_seek_skips);
    kls_row_first_stats_add(&trace->scalar_u_output_entries,
                            replay_entries);
  }
  return 1;
}

static int kls_row_first_compact_window_replay_delayed_output_to_workspace(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_compact_window_state *state,
  kls_row_first_workspace *workspace,
  UF_long *pattern_count_io,
  kls_row_first_pipeline_trace *trace) {
  if (shared == NULL || state == NULL) {
    return 0;
  }
  if (state->delayed_output_replayed_l_count > state->l_count) {
    return 0;
  }
  return kls_row_first_compact_window_replay_delayed_output_range_to_workspace(
    shared, state, workspace, pattern_count_io, trace,
    state->delayed_output_replayed_l_count, state->l_count, NULL, 0u, 0, 1);
}

static UF_long kls_row_first_pipeline_worker_span_owner_index(
  const kls_row_first_pipeline_worker *worker,
  int slot,
  UF_long pos) {
  if (worker == NULL || !worker->compact_span_owner_active ||
      worker->compact_claim_run_count >
        KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS) {
    return KLS_KLU_EMPTY;
  }
  for (UF_long r = 0; r < worker->compact_claim_run_count; ++r) {
    if (worker->compact_claim_run_slots[r] == slot &&
        worker->compact_claim_run_pos[r] == pos) {
      return r;
    }
  }
  return KLS_KLU_EMPTY;
}

static int kls_row_first_pipeline_apply_span_owner_panel_to_workspace(
  kls_row_first_pipeline_worker *worker,
  kls_row_first_compact_window_state *state,
  kls_row_first_workspace *workspace,
  UF_long *pattern_count_io,
  kls_row_first_pipeline_trace *trace) {
  if (worker == NULL || state == NULL || workspace == NULL ||
      pattern_count_io == NULL || !worker->compact_span_owner_active ||
      worker->shared == NULL || worker->shared->ctx == NULL ||
      worker->compact_span_owner_cols_count == 0u ||
      worker->compact_span_owner_values == NULL ||
      worker->compact_span_owner_mask == NULL ||
      worker->compact_span_owner_cols == NULL) {
    return 1;
  }
  const UF_long row_index =
    kls_row_first_pipeline_worker_span_owner_index(
      worker, state->bucket_slot, state->pos);
  if (row_index == KLS_KLU_EMPTY ||
      row_index >= worker->compact_span_owner_rows ||
      worker->compact_span_owner_cols_count >
        worker->compact_span_owner_value_capacity ||
      row_index > UF_long_max / worker->compact_span_owner_cols_count) {
    return 1;
  }
  const UF_long cols = worker->compact_span_owner_cols_count;
  const UF_long base = row_index * cols;
  UF_long applied_cols = 0u;
  for (UF_long c = 0; c < cols; ++c) {
    const UF_long at = base + c;
    if (at >= worker->compact_span_owner_value_capacity ||
        worker->compact_span_owner_mask[at] == 0u) {
      continue;
    }
    const UF_long col = worker->compact_span_owner_cols[c];
    if (col < state->row || col >= worker->shared->ctx->nk) {
      continue;
    }
    if (!kls_row_first_workspace_accumulate_claim_value(
          workspace, state->generation, worker->shared->ctx->nk,
          pattern_count_io, col,
          worker->compact_span_owner_values[at])) {
      return 0;
    }
    applied_cols++;
  }
  if (trace != NULL && worker->compact_span_owner_replay_entries != NULL &&
      row_index < worker->compact_span_owner_rows) {
    const UF_long replay_entries =
      worker->compact_span_owner_replay_entries[row_index];
    if (replay_entries > 0u) {
      kls_row_first_stats_add(
        &trace->compact_window_delayed_output_replays, 1u);
      kls_row_first_stats_add(
        &trace->compact_window_delayed_output_entries, replay_entries);
      kls_row_first_stats_add(&trace->scalar_u_output_entries,
                              replay_entries);
      (void)applied_cols;
    }
  }
  return 1;
}

static UF_long kls_row_first_pipeline_claim_stream_owner_index(
  const kls_row_first_pipeline_worker *worker,
  int slot,
  UF_long pos) {
  if (worker == NULL || !worker->compact_claim_stream_owner_active ||
      worker->compact_claim_run_count >
        KLS_ROW_FIRST_COMPACT_CLAIM_RUN_MAX_ROWS) {
    return KLS_KLU_EMPTY;
  }
  for (UF_long r = 0; r < worker->compact_claim_run_count; ++r) {
    if (worker->compact_claim_run_slots[r] == slot &&
        worker->compact_claim_run_pos[r] == pos) {
      return r;
    }
  }
  return KLS_KLU_EMPTY;
}

static int kls_row_first_pipeline_apply_claim_stream_owner_to_workspace(
  kls_row_first_pipeline_worker *worker,
  kls_row_first_compact_window_state *state,
  kls_row_first_workspace *workspace,
  UF_long *pattern_count_io,
  kls_row_first_pipeline_trace *trace) {
  if (worker == NULL || state == NULL || workspace == NULL ||
      pattern_count_io == NULL ||
      !worker->compact_claim_stream_owner_active ||
      worker->shared == NULL || worker->shared->ctx == NULL ||
      worker->compact_claim_stream_owner_cols_count == 0u ||
      worker->compact_claim_stream_owner_cols == NULL ||
      worker->compact_claim_stream_owner_values == NULL ||
      worker->compact_claim_stream_owner_mask == NULL ||
      worker->compact_claim_stream_owner_start_l_counts == NULL ||
      worker->compact_claim_stream_owner_l_counts == NULL ||
      worker->compact_claim_stream_owner_replay_entries == NULL) {
    return 1;
  }
  const UF_long row_index =
    kls_row_first_pipeline_claim_stream_owner_index(
      worker, state->bucket_slot, state->pos);
  if (row_index == KLS_KLU_EMPTY ||
      row_index >= worker->compact_claim_stream_owner_rows ||
      worker->compact_claim_stream_owner_rows == 0u ||
      worker->compact_claim_stream_owner_cols_count >
        worker->compact_claim_stream_owner_col_capacity ||
      worker->compact_claim_stream_owner_cols_count >
        worker->compact_claim_stream_owner_value_capacity /
          worker->compact_claim_stream_owner_rows) {
    return 1;
  }
  const UF_long start_l_count =
    worker->compact_claim_stream_owner_start_l_counts[row_index];
  const UF_long end_l_count =
    worker->compact_claim_stream_owner_l_counts[row_index];
  if (start_l_count > end_l_count || end_l_count > state->l_count ||
      state->delayed_output_replayed_l_count > start_l_count) {
    return 0;
  }
  if (state->delayed_output_replayed_l_count < start_l_count &&
      !kls_row_first_compact_window_replay_delayed_output_range_to_workspace(
        worker->shared, state, workspace, pattern_count_io, trace,
        state->delayed_output_replayed_l_count, start_l_count,
        NULL, 0u, 0, 1)) {
    return 0;
  }
  const UF_long rows = worker->compact_claim_stream_owner_rows;
  const UF_long cols = worker->compact_claim_stream_owner_cols_count;
  UF_long applied_entries = 0u;
  for (UF_long c = 0; c < cols; ++c) {
    const UF_long at = c * rows + row_index;
    if (at >= worker->compact_claim_stream_owner_value_capacity ||
        worker->compact_claim_stream_owner_mask[at] == 0u) {
      continue;
    }
    const UF_long col = worker->compact_claim_stream_owner_cols[c];
    if (col < state->row || col >= worker->shared->ctx->nk) {
      continue;
    }
    if (!kls_row_first_workspace_accumulate_claim_value(
          workspace, state->generation, worker->shared->ctx->nk,
          pattern_count_io, col,
          worker->compact_claim_stream_owner_values[at])) {
      return 0;
    }
    applied_entries++;
  }
  if (state->delayed_output_replayed_l_count != start_l_count) {
    return 0;
  }
  if (state->delayed_output_replayed_l_count < end_l_count) {
    state->delayed_output_replayed_l_count = end_l_count;
  }
  kls_row_first_compact_window_deferred_output_reset(state);
  (void)kls_row_first_compact_window_deferred_output_bump_generation(state);
  if (trace != NULL) {
    const UF_long replay_entries =
      worker->compact_claim_stream_owner_replay_entries[row_index];
    if (replay_entries > 0u) {
      kls_row_first_stats_add(
        &trace->compact_window_delayed_output_replays, 1u);
      kls_row_first_stats_add(
        &trace->compact_window_delayed_output_entries, replay_entries);
      kls_row_first_stats_add(&trace->scalar_u_output_entries,
                              replay_entries);
      (void)applied_entries;
    }
  }
  return 1;
}

static int kls_row_first_pipeline_apply_shared_span_owner_to_workspace(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_compact_window_state *state,
  kls_row_first_workspace *workspace,
  UF_long *pattern_count_io,
  kls_row_first_pipeline_trace *trace) {
  if (shared == NULL || state == NULL || workspace == NULL ||
      pattern_count_io == NULL ||
      !shared->compact_span_shared_owner_enabled ||
      !shared->compact_span_shared_owner_active ||
      state->compact_span_shared_owner_generation == 0u ||
      state->compact_span_shared_owner_generation !=
        shared->compact_span_shared_owner_generation ||
      state->compact_span_shared_owner_row >=
        shared->compact_span_shared_owner_rows ||
      state->compact_span_shared_owner_start_l_count >
        state->compact_span_shared_owner_l_count ||
      state->compact_span_shared_owner_l_count > state->l_count ||
      shared->ctx == NULL) {
    return 1;
  }
  const UF_long row_index = state->compact_span_shared_owner_row;
  const int nonprefix =
    shared->compact_span_shared_owner_nonprefix_active &&
    shared->compact_span_shared_owner_dep_count > 0u;
  if (nonprefix && shared->compact_span_shared_owner_deps == NULL) {
    return 0;
  }
  if (nonprefix &&
      state->delayed_output_replayed_l_count !=
        state->compact_span_shared_owner_start_l_count) {
    state->compact_span_shared_owner_generation = 0u;
    state->compact_span_shared_owner_row = KLS_KLU_EMPTY;
    state->compact_span_shared_owner_start_l_count = 0u;
    state->compact_span_shared_owner_l_count = 0u;
    return 1;
  }

  const int sparse_values =
    shared->compact_span_shared_owner_sparse_active;
  UF_long applied_cols = 0u;
  if (sparse_values) {
    if (shared->compact_span_shared_owner_sparse_row_ptr == NULL ||
        shared->compact_span_shared_owner_sparse_cols == NULL ||
        shared->compact_span_shared_owner_sparse_values == NULL ||
        row_index + 1u >
          shared->compact_span_shared_owner_rows ||
        row_index + 1u >=
          shared->compact_span_shared_owner_sparse_row_capacity) {
      return 0;
    }
    const UF_long begin =
      shared->compact_span_shared_owner_sparse_row_ptr[row_index];
    const UF_long end =
      shared->compact_span_shared_owner_sparse_row_ptr[row_index + 1u];
    if (begin > end ||
        end > shared->compact_span_shared_owner_sparse_entry_capacity) {
      return 0;
    }
    for (UF_long p = begin; p < end; ++p) {
      const UF_long col =
        shared->compact_span_shared_owner_sparse_cols[p];
      if (col < state->row || col >= shared->ctx->nk) {
        continue;
      }
      if (!kls_row_first_workspace_accumulate_claim_value(
            workspace, state->generation, shared->ctx->nk,
            pattern_count_io, col,
            shared->compact_span_shared_owner_sparse_values[p])) {
        return 0;
      }
      applied_cols++;
    }
  } else {
    if (shared->compact_span_shared_owner_cols_count == 0u ||
        shared->compact_span_shared_owner_cols == NULL ||
        shared->compact_span_shared_owner_values == NULL ||
        shared->compact_span_shared_owner_mask == NULL ||
        shared->compact_span_shared_owner_cols_count >
          shared->compact_span_shared_owner_value_capacity ||
        row_index >
          UF_long_max / shared->compact_span_shared_owner_cols_count) {
      return 1;
    }
    const UF_long cols = shared->compact_span_shared_owner_cols_count;
    const UF_long base = row_index * cols;
    for (UF_long c = 0; c < cols; ++c) {
      const UF_long at = base + c;
      if (at >= shared->compact_span_shared_owner_value_capacity ||
          shared->compact_span_shared_owner_mask[at] == 0u) {
        continue;
      }
      const UF_long col = shared->compact_span_shared_owner_cols[c];
      if (col < state->row || col >= shared->ctx->nk) {
        continue;
      }
      if (!kls_row_first_workspace_accumulate_claim_value(
            workspace, state->generation, shared->ctx->nk,
            pattern_count_io, col,
            shared->compact_span_shared_owner_values[at])) {
        return 0;
      }
      applied_cols++;
    }
  }
  if (nonprefix) {
    if (state->delayed_output_replayed_l_count >
        state->compact_span_shared_owner_l_count) {
      return 0;
    }
    if (!kls_row_first_compact_window_replay_delayed_output_range_to_workspace(
          shared, state, workspace, pattern_count_io, trace,
          state->delayed_output_replayed_l_count,
          state->compact_span_shared_owner_l_count,
          shared->compact_span_shared_owner_deps,
          shared->compact_span_shared_owner_dep_count, 1, 1)) {
      return 0;
    }
  } else {
    if (state->delayed_output_replayed_l_count <
        state->compact_span_shared_owner_l_count) {
      state->delayed_output_replayed_l_count =
        state->compact_span_shared_owner_l_count;
    }
    kls_row_first_compact_window_deferred_output_reset(state);
    (void)kls_row_first_compact_window_deferred_output_bump_generation(state);
  }
  if (trace != NULL &&
      shared->compact_span_shared_owner_replay_entries != NULL &&
      row_index < shared->compact_span_shared_owner_rows) {
    const UF_long replay_entries =
      shared->compact_span_shared_owner_replay_entries[row_index];
    kls_row_first_stats_add(
      &trace->compact_window_span_shared_owner_applies, 1u);
    kls_row_first_stats_add(
      &trace->compact_window_span_shared_owner_entries, replay_entries);
    if (replay_entries > 0u) {
      kls_row_first_stats_add(
        &trace->compact_window_delayed_output_replays, 1u);
      kls_row_first_stats_add(
        &trace->compact_window_delayed_output_entries, replay_entries);
      kls_row_first_stats_add(&trace->scalar_u_output_entries,
                              replay_entries);
    }
  }
  (void)applied_cols;
  state->compact_span_shared_owner_generation = 0u;
  state->compact_span_shared_owner_row = KLS_KLU_EMPTY;
  state->compact_span_shared_owner_start_l_count = 0u;
  state->compact_span_shared_owner_l_count = 0u;
  return 1;
}

static int kls_row_first_compact_window_apply_ready_until(
  const kls_row_first_pipeline_shared *shared,
  kls_row_first_compact_window_state *state,
  UF_long ready_limit) {
  if (shared == NULL || state == NULL) {
    return 0;
  }
  while (state->active && state->heap_size > 0u) {
    const UF_long dep = state->heap[0];
    if (dep >= state->row ||
        !kls_row_first_dependency_ready(shared->row_done,
                                        shared->active_rank,
                                        ready_limit, dep)) {
      break;
    }
    if (!kls_row_first_compact_window_apply_dep(
          shared, state, dep, &state->trace_current)) {
      return 0;
    }
  }
  return 1;
}

static void kls_row_first_pipeline_unlink_compact_window_state(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_compact_window_state *state) {
  if (shared == NULL || state == NULL || !state->bucket_linked) {
    return;
  }
  if (shared->compact_root_heads != NULL && shared->ctx != NULL &&
      state->bucket_dep < shared->ctx->nk &&
      state->bucket_slot >= 0 &&
      state->bucket_slot < shared->compact_window_count) {
    int *head = shared->compact_root_heads + state->bucket_dep;
    if (*head == state->bucket_slot) {
      *head = state->bucket_next;
    } else {
      int cursor = *head;
      int guard = 0;
      while (cursor >= 0 && cursor < shared->compact_window_count &&
             guard++ < shared->compact_window_count) {
        kls_row_first_compact_window_state *candidate =
          shared->compact_window_states + cursor;
        if (candidate->bucket_next == state->bucket_slot) {
          candidate->bucket_next = state->bucket_next;
          break;
        }
        cursor = candidate->bucket_next;
      }
    }
  }
  state->bucket_dep = KLS_KLU_EMPTY;
  state->bucket_next = -1;
  state->bucket_linked = 0;
}

static void kls_row_first_pipeline_untrack_compact_window_state(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_compact_window_state *state) {
  if (shared == NULL || state == NULL) {
    return;
  }
  if (state->active && shared->compact_window_active_count > 0u) {
    shared->compact_window_active_count--;
  }
  if (shared->compact_pos_slots != NULL && shared->ctx != NULL &&
      state->pos < shared->ctx->nk &&
      state->bucket_slot >= 0 &&
      state->bucket_slot < shared->compact_window_count &&
      shared->compact_pos_slots[state->pos] == state->bucket_slot) {
    shared->compact_pos_slots[state->pos] = -1;
  }
  if (state->bucket_slot >= 0 &&
      state->bucket_slot < shared->compact_window_count) {
    shared->compact_window_scan_slot = state->bucket_slot;
  }
}

static int kls_row_first_pipeline_track_compact_window_state(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_compact_window_state *state) {
  if (shared == NULL || state == NULL || !state->active ||
      shared->compact_pos_slots == NULL || shared->ctx == NULL ||
      state->pos >= shared->ctx->nk ||
      state->bucket_slot < 0 ||
      state->bucket_slot >= shared->compact_window_count) {
    return 0;
  }
  const int old_slot = shared->compact_pos_slots[state->pos];
  if (old_slot >= 0 && old_slot < shared->compact_window_count &&
      old_slot != state->bucket_slot) {
    kls_row_first_compact_window_state *old_state =
      shared->compact_window_states + old_slot;
    if (old_state->active && old_state->pos == state->pos) {
      return 0;
    }
  }
  if (old_slot == state->bucket_slot) {
    return 1;
  }
  shared->compact_pos_slots[state->pos] = state->bucket_slot;
  shared->compact_window_active_count++;
  return 1;
}

static int kls_row_first_pipeline_find_free_compact_window_slot(
  kls_row_first_pipeline_shared *shared) {
  if (shared == NULL || shared->compact_window_states == NULL ||
      shared->compact_window_count <= 0) {
    return -1;
  }
  if (shared->compact_window_scan_slot < 0 ||
      shared->compact_window_scan_slot >= shared->compact_window_count) {
    shared->compact_window_scan_slot = 0;
  }
  for (int scanned = 0; scanned < shared->compact_window_count; ++scanned) {
    const int slot =
      (shared->compact_window_scan_slot + scanned) %
      shared->compact_window_count;
    if (!shared->compact_window_states[slot].active) {
      shared->compact_window_scan_slot =
        (slot + 1) % shared->compact_window_count;
      return slot;
    }
  }
  return -1;
}

static void kls_row_first_pipeline_clear_compact_window_state(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_compact_window_state *state) {
  if (state == NULL) {
    return;
  }
  if (state->grouped && shared != NULL && shared->compact_group_active) {
    kls_row_first_pipeline_clear_compact_group(shared);
    return;
  }
  kls_row_first_pipeline_unlink_compact_window_state(shared, state);
  kls_row_first_pipeline_untrack_compact_window_state(shared, state);
  kls_row_first_compact_window_state_clear(state);
}

static int kls_row_first_pipeline_register_compact_window_state(
  kls_row_first_pipeline_shared *shared,
  kls_row_first_compact_window_state *state) {
  if (shared == NULL || state == NULL ||
      !shared->compact_window_execute_enabled ||
      shared->compact_root_heads == NULL || shared->ctx == NULL) {
    return 1;
  }
  if (state->grouped) {
    return 1;
  }
  kls_row_first_pipeline_unlink_compact_window_state(shared, state);
  if (!state->active || state->heap_size == 0u) {
    return 1;
  }
  const UF_long dep = state->heap[0];
  if (dep >= state->row || dep >= shared->ctx->nk ||
      state->bucket_slot < 0 ||
      state->bucket_slot >= shared->compact_window_count) {
    kls_row_first_pipeline_clear_compact_window_state(shared, state);
    return 0;
  }
  state->bucket_dep = dep;
  state->bucket_next = shared->compact_root_heads[dep];
  state->bucket_linked = 1;
  shared->compact_root_heads[dep] = state->bucket_slot;
  return 1;
}

static int kls_row_first_pipeline_reserve_compact_batch_positions(
  kls_row_first_pipeline_shared *shared,
  UF_long needed) {
  if (shared == NULL) {
    return 0;
  }
  if (needed <= shared->compact_batch_position_capacity) {
    return 1;
  }
  if (needed > (UF_long)(SIZE_MAX / sizeof(*shared->compact_batch_positions))) {
    return 0;
  }
  UF_long grown = shared->compact_batch_position_capacity == 0u
    ? 1024u : shared->compact_batch_position_capacity;
  while (grown < needed) {
    if (grown > UF_long_max / 2u) {
      grown = needed;
      break;
    }
    grown *= 2u;
  }
  if (grown > (UF_long)(SIZE_MAX / sizeof(*shared->compact_batch_positions))) {
    return 0;
  }
  UF_long *positions =
    (UF_long *)realloc(shared->compact_batch_positions,
                       (size_t)grown *
                         sizeof(*shared->compact_batch_positions));
  if (positions == NULL) {
    return 0;
  }
  shared->compact_batch_positions = positions;
  shared->compact_batch_position_capacity = grown;
  return 1;
}

