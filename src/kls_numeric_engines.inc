    btf_scalar_run_group_wake_stats_active_requested &&
    selected_kernel == KLS_EGRAPH_REFACTOR_KERNEL_BTF_UNSCALED &&
    solver->refactor_btf_scalar_run_group_built &&
    solver->refactor_btf_scalar_run_group_wake_count > 0u;
  const int pipeline_claims_requested =
    consumer_plan_claims_requested || algorithm5_payoff_claims_have_groups ||
    algorithm5_payoff_queue_have_groups ||
    algorithm5_payoff_group_complete_have_groups ||
    btf_scalar_run_group_claims_have_groups ||
    btf_scalar_run_group_prefix_stats_have_groups ||
    btf_scalar_run_group_wake_stats_have_groups;
  if (pipeline_claims_requested && pipeline_done == NULL) {
    pipeline_done =
      ensure_egraph_pipeline_done(solver, &pipeline_generation);
  }
  if (pipeline_claims_requested) {
    if (pipeline_done == NULL || pipeline_generation == 0u) {
      return -1;
    }
    pipeline_claimed =
      ensure_egraph_pipeline_claimed(solver, &pipeline_claim_generation);
    if (pipeline_claimed == NULL || pipeline_claim_generation == 0u) {
      return -1;
    }
    if (pipeline_claim_generation >= UINT_MAX) {
      return -1;
    }
  }
  if (algorithm5_payoff_queue_have_groups) {
    if (!ensure_egraph_algorithm5_payoff_queue(
          solver,
          solver->refactor_supernode_algorithm5_payoff_group_current_total,
          &algorithm5_payoff_queue_cols,
          &algorithm5_payoff_queue_slots,
          &algorithm5_payoff_queue_flags)) {
      return -1;
    }
    algorithm5_payoff_queue_capacity =
      solver->refactor_supernode_algorithm5_payoff_group_current_total;
  }
  if (algorithm5_payoff_group_complete_have_groups &&
      !build_egraph_algorithm5_payoff_final_triggers(
        solver, &algorithm5_payoff_final_trigger_ptr,
        &algorithm5_payoff_final_trigger_slots)) {
    return -1;
  }
  if (algorithm5_payoff_suffix_advance_requested &&
      algorithm5_payoff_group_complete_have_groups &&
      !build_egraph_algorithm5_payoff_suffix_triggers(
        solver, &algorithm5_payoff_suffix_trigger_ptr,
        &algorithm5_payoff_suffix_trigger_slots)) {
    return -1;
  }
  if (algorithm5_payoff_suffix_group_advance_requested &&
      algorithm5_payoff_group_complete_have_groups &&
      !build_egraph_algorithm5_payoff_suffix_group_triggers(
        solver, &algorithm5_payoff_suffix_group_trigger_ptr,
        &algorithm5_payoff_suffix_group_trigger_entries)) {
    return -1;
  }
  if (algorithm5_payoff_suffix_producer_advance_requested &&
      algorithm5_payoff_group_complete_have_groups &&
      !build_egraph_algorithm5_payoff_suffix_producer_triggers(
        solver, &algorithm5_payoff_suffix_producer_trigger_ptr,
        &algorithm5_payoff_suffix_producer_trigger_entries)) {
    return -1;
  }
  if (kls_refactor_supernode_algorithm5_payoff_runtime_env_enabled() &&
      solver->refactor_supernode_algorithm5_payoff_group_count > 0u &&
      solver->refactor_supernode_algorithm5_payoff_group_current_total > 0u) {
    algorithm5_payoff_workspace_size =
      solver->refactor_supernode_algorithm5_payoff_group_workspace_rows_total;
    algorithm5_payoff_target_size =
      kls_refactor_supernode_algorithm5_payoff_runtime_target_size(solver);
    algorithm5_payoff_advance_size =
      algorithm5_payoff_direct_prefix_advance_seed_requested
        ? solver
            ->refactor_supernode_algorithm5_payoff_group_advance_slots_total
        : 0u;
    algorithm5_payoff_advance_u_size =
      (algorithm5_payoff_direct_prefix_advance_seed_requested ||
       algorithm5_payoff_direct_prefix_current_state_requested)
        ? solver->refactor_supernode_algorithm5_payoff_group_advance_deps_total
        : 0u;
    algorithm5_payoff_current_state_size =
      algorithm5_payoff_direct_prefix_current_state_requested
        ? solver->refactor_supernode_algorithm5_payoff_current_state_rows_total
        : 0u;
    algorithm5_payoff_current_count =
      solver->refactor_supernode_algorithm5_payoff_group_current_total;
    algorithm5_payoff_workspace_values =
      algorithm5_payoff_workspace_size > 0u
        ? solver->egraph_algorithm5_payoff_workspace_values : NULL;
    algorithm5_payoff_target_values =
      algorithm5_payoff_target_size > 0u
        ? solver->egraph_algorithm5_payoff_target_values : NULL;
    algorithm5_payoff_advance_values =
      algorithm5_payoff_advance_size > 0u
        ? solver->egraph_algorithm5_payoff_advance_values : NULL;
    algorithm5_payoff_advance_u_values =
      algorithm5_payoff_advance_u_size > 0u
        ? solver->egraph_algorithm5_payoff_advance_u_values : NULL;
    algorithm5_payoff_current_state_values =
      algorithm5_payoff_current_state_size > 0u
        ? solver->egraph_algorithm5_payoff_current_state_values : NULL;
    algorithm5_payoff_current_flags =
      algorithm5_payoff_current_count > 0u
        ? solver->egraph_algorithm5_payoff_current_flags : NULL;
    algorithm5_payoff_current_up =
      algorithm5_payoff_current_count > 0u
        ? solver->egraph_algorithm5_payoff_current_up : NULL;
    algorithm5_payoff_workspace_active =
      (algorithm5_payoff_workspace_size == 0u ||
       algorithm5_payoff_workspace_values != NULL) &&
      (algorithm5_payoff_target_size == 0u ||
       algorithm5_payoff_target_values != NULL) &&
      (algorithm5_payoff_advance_size == 0u ||
       algorithm5_payoff_advance_values != NULL) &&
      (algorithm5_payoff_advance_u_size == 0u ||
       algorithm5_payoff_advance_u_values != NULL) &&
      (algorithm5_payoff_current_state_size == 0u ||
       algorithm5_payoff_current_state_values != NULL) &&
      (algorithm5_payoff_current_count == 0u ||
       (algorithm5_payoff_current_flags != NULL &&
        algorithm5_payoff_current_up != NULL));
    if (algorithm5_payoff_workspace_active &&
        algorithm5_payoff_current_count > 0u) {
      for (UF_long slot = 0u; slot < algorithm5_payoff_current_count;
           ++slot) {
        atomic_store_explicit(&algorithm5_payoff_current_flags[slot], 0u,
                              memory_order_relaxed);
        atomic_store_explicit(&algorithm5_payoff_current_up[slot], 0ul,
                              memory_order_relaxed);
      }
    }
  }

  const int use_pipeline_ready_queue =
    kls_egraph_ready_queue_env_enabled() &&
    pipeline_done != NULL && !natural_pipeline &&
    solver->refactor_pipeline_column_count > 0u &&
    solver->refactor_level_cols != NULL &&
    solver->refactor_pipeline_successor_ptr != NULL &&
    solver->refactor_pipeline_pred_count != NULL &&
    solver->refactor_pipeline_ready_cols != NULL &&
    solver->refactor_pipeline_ready_slots != NULL &&
    solver->refactor_pipeline_remaining_preds != NULL;
  UF_long pipeline_initial_ready_count = 0u;
  if (use_pipeline_ready_queue) {
    const UF_long pipeline_begin =
      all_pipeline ? 0u : solver->refactor_level_ptr[cluster_level_count];
    if (pipeline_begin > solver->n ||
        solver->refactor_pipeline_column_count > solver->n - pipeline_begin) {
      return -1;
    }
    for (UF_long pos = 0u; pos < solver->refactor_pipeline_column_count;
         ++pos) {
      atomic_store_explicit(&solver->refactor_pipeline_ready_slots[pos],
                            0u, memory_order_relaxed);
    }
    for (UF_long pos = pipeline_begin; pos < solver->n; ++pos) {
      const UF_long col = solver->refactor_level_cols[pos];
      if (col >= solver->n) {
        return -1;
      }
      const UF_long pred_count = solver->refactor_pipeline_pred_count[col];
      atomic_store_explicit(&solver->refactor_pipeline_remaining_preds[col],
                            (unsigned long)pred_count,
                            memory_order_relaxed);
      if (pred_count == 0u) {
        if (pipeline_initial_ready_count >=
            solver->refactor_pipeline_column_count) {
          return -1;
        }
        solver->refactor_pipeline_ready_cols[pipeline_initial_ready_count] =
          col;
        atomic_store_explicit(
          &solver->refactor_pipeline_ready_slots[pipeline_initial_ready_count],
          pipeline_generation, memory_order_release);
        pipeline_initial_ready_count++;
      }
    }
    if (pipeline_initial_ready_count == 0u) {
      return -1;
    }
  }
  const int single_block = solver->symbolic->nblocks == 1u;
  const UF_long scratch_size =
    single_block ? solver->n : solver->symbolic->maxblock;
  double **scratch =
    ensure_egraph_worker_scratch(solver, thread_count, scratch_size);
  if (scratch == NULL) {
    return -1;
  }

  atomic_uint *btf_scalar_run_group_live = NULL;
  UF_long btf_scalar_run_group_live_count = 0u;
  atomic_uint *btf_scalar_run_group_wake_live = NULL;
  UF_long btf_scalar_run_group_wake_live_count = 0u;
  UF_long *btf_scalar_run_group_state_next = NULL;
  UF_long btf_scalar_run_group_state_next_count = 0u;
  double *btf_scalar_run_group_state_values = NULL;
  double *btf_scalar_run_group_state_u_values = NULL;
  UF_long btf_scalar_run_group_state_size = 0u;
  const UF_long *btf_scalar_run_group_state_value_base = NULL;
  UF_long btf_scalar_run_group_state_value_base_count = 0u;
  if (btf_scalar_run_group_wait_stats_requested &&
      selected_kernel == KLS_EGRAPH_REFACTOR_KERNEL_BTF_UNSCALED &&
      solver->refactor_btf_scalar_run_group_built &&
      solver->refactor_btf_scalar_run_group_multi_count > 0u) {
    btf_scalar_run_group_live =
      kls_prepare_refactor_btf_scalar_run_group_live(solver);
    if (btf_scalar_run_group_live == NULL) {
      return -1;
    }
    btf_scalar_run_group_live_count =
      solver->refactor_btf_scalar_run_group_live_count;
  }
  if (btf_scalar_run_group_wake_stats_active_requested &&
      selected_kernel == KLS_EGRAPH_REFACTOR_KERNEL_BTF_UNSCALED &&
      solver->refactor_btf_scalar_run_group_built &&
      solver->refactor_btf_scalar_run_group_wake_count > 0u) {
    btf_scalar_run_group_wake_live =
      kls_prepare_refactor_btf_scalar_run_group_wake_live(solver);
    if (btf_scalar_run_group_wake_live == NULL) {
      return -1;
    }
    btf_scalar_run_group_wake_live_count =
      solver->refactor_btf_scalar_run_group_wake_live_count;
  }
  if (btf_scalar_run_group_state_stats_active_requested &&
      selected_kernel == KLS_EGRAPH_REFACTOR_KERNEL_BTF_UNSCALED &&
      solver->refactor_btf_scalar_run_group_built &&
      solver->refactor_btf_scalar_run_group_state_rows_total > 0u) {
    btf_scalar_run_group_state_values =
      kls_prepare_refactor_btf_scalar_run_group_state_values(
        solver, btf_scalar_run_group_state_exec_active_requested,
        btf_scalar_run_group_state_compact_values_active_requested,
        &btf_scalar_run_group_state_value_base,
        &btf_scalar_run_group_state_value_base_count,
        &btf_scalar_run_group_state_u_values);
    if (btf_scalar_run_group_state_values == NULL) {
      return -1;
    }
    btf_scalar_run_group_state_size =
      solver->egraph_btf_scalar_run_group_state_size;
  }
  if (btf_scalar_run_group_state_step_advance_active_requested &&
      selected_kernel == KLS_EGRAPH_REFACTOR_KERNEL_BTF_UNSCALED &&
      solver->refactor_btf_scalar_run_group_built &&
      solver->refactor_btf_scalar_run_group_multi_current_total > 0u) {
    btf_scalar_run_group_state_next =
      kls_prepare_refactor_btf_scalar_run_group_state_next(solver);
    if (btf_scalar_run_group_state_next == NULL) {
      return -1;
    }
    btf_scalar_run_group_state_next_count =
      solver->refactor_btf_scalar_run_group_state_next_count;
  }

  kls_egraph_refactor_pool *pool =
    ensure_egraph_refactor_pool(solver, thread_count);
  if (pool == NULL) {
    return -1;
  }
  if (
      getenv("KLS_EGRAPH_WORKER_SPIN_OVERRIDE") == NULL &&
      !check_pivots && kls_repeated_update_workload(&solver->options) &&
      solver->options.expected_refactorizations >= 16 &&
      kls_pts_solve_available(solver) &&
      pool->worker_spin_iters < 200000u) {
    /* A retained EGraph crew is reused by the following solve/value phases
       and by the next numeric generation.  The generic pool default is
       deliberately short for isolated calls, but it expires before these
       back-to-back repeated-update phases and turns every generation into
       N-1 condition-variable wakeups.  Once the realized executor and the
       caller's repeated lifecycle establish reuse, keep the crew live over
       that bounded gap only when the verified parallel triangular solve will
       immediately dispatch the same pool again.  This is an implementation-
       capability decision: serial solves plus row, lean, and direct numeric
       executors retain their independently selected idle policies, and the
       public override remains authoritative. */
    pool->worker_spin_iters = 200000u;
  }
  kls_egraph_refactor_shared *shared = &pool->shared;

  pthread_mutex_lock(&shared->lock);
  if (pool->active_workers != 0) {
    pthread_mutex_unlock(&shared->lock);
    return -1;
  }

  shared->solver = solver;
  shared->values = numeric_values;
  shared->rs = solver->numeric->Rs;
  shared->check_pivots = check_pivots;
  shared->scale = (int)common->scale;
  shared->parallel_scale_rows = parallel_scale_rows;
  shared->parallel_scale_method = (int)common->scale;
  shared->parallel_scale_permute = parallel_scale_permute;
  shared->parallel_scale_input_values = numeric_values;
  shared->kernel = selected_kernel;
  shared->thread_count = thread_count;
  /* A resident spin barrier wins when synchronization is frequent relative
     to the remaining dependency-pipeline work.  On long pipeline tails,
     allowing pthread_barrier_wait to stagger/sleep early arrivals avoids
     cache and bandwidth contention.  Work is the ordering-independent
     symbolic estimate built with the dependency graph, not a matrix- or
     machine-specific timing sample. */
  shared->use_spin_cluster_barrier =
    cluster_level_count > 0u &&
    solver->refactor_pipeline_work <=
      1500000.0 * (double)cluster_level_count;
  /* Generations are local to one numeric dispatch.  The crew is idle while
     shared->lock is held here, so clear every private arrival before worker
     zero starts comparing the new generation against those slots. */
  for (int tid = 0; tid < thread_count; ++tid) {
    atomic_store_explicit(&pool->workers[tid].cluster_barrier_arrival, 0u,
                          memory_order_relaxed);
  }
  atomic_store_explicit(&shared->cluster_barrier_generation, 0u,
                        memory_order_relaxed);
  shared->snode_run_end = kls_refactor_snode_run_end(solver);
  shared->deferred_pts_terminal_col = KLS_KLU_EMPTY;
  if (!check_pivots &&
      selected_kernel == KLS_EGRAPH_REFACTOR_KERNEL_BTF_UNSCALED &&
      shared->btf_unscaled_plain &&
      kls_repeated_update_workload(&solver->options) &&
      solver->refactor_u_indices != NULL) {
    shared->deferred_pts_terminal_col =
      kls_pts_egraph_terminal_candidate(solver);
    if (shared->deferred_pts_terminal_col != KLS_KLU_EMPTY) {
      shared->kernel =
        KLS_EGRAPH_REFACTOR_KERNEL_BTF_UNSCALED_DEFER_TERMINAL;
    }
  }
  shared->row_refactor_mode = 0;
  shared->row_solve_mode = 0;
  shared->row_solve_view = NULL;
  shared->row_solve_work = NULL;
  shared->row_refactor_native_row_panel_active = 0;
  shared->row_refactor_defer_value_scatter = 0;
  shared->row_pipeline_ready_queue = 0;
  shared->row_pipeline_row_dep_ready_queue = 0;
  shared->row_pipeline_ready_groups = NULL;
  shared->row_pipeline_ready_slots = NULL;
  shared->row_pipeline_remaining_preds = NULL;
  shared->row_pipeline_tail_groups = NULL;
  shared->row_pipeline_tail_count = 0;
  shared->row_pipeline_private_groups = NULL;
  shared->row_pipeline_private_thread_ptr = NULL;
  shared->row_pipeline_private_group_mask = NULL;
  shared->row_pipeline_private_external_wait_mask = NULL;
  shared->row_pipeline_private_count = 0;
  shared->row_pipeline_ordered_private = 0;
  atomic_store_explicit(&shared->stop, 0, memory_order_release);
  shared->invalid = 0;
  shared->pivot_rejected = 0;
  shared->singular = 0;
  shared->rejected_pivot = KLS_KLU_EMPTY;
  shared->rejected_pivot_col = KLS_KLU_EMPTY;
  shared->rejected_row = KLS_KLU_EMPTY;
  shared->rejected_multiplier_abs = -1.0;
  shared->rejected_pivot_abs = -1.0;
  shared->rejected_candidate_abs = -1.0;
  shared->numerical_rank = UF_long_max;
  shared->singular_col = KLS_KLU_EMPTY;
  shared->pipeline_done = pipeline_done;
  shared->pipeline_claimed = pipeline_claimed;
  shared->pipeline_generation = pipeline_generation;
  shared->cluster_level_count =
    pipeline_done != NULL ? cluster_level_count : solver->refactor_level_count;
  shared->pipeline_claim_generation = pipeline_claim_generation;
  shared->pipeline_lease_generation =
    pipeline_claim_generation != 0u ? pipeline_claim_generation + 1u : 0u;
  shared->separator_private = separator_private;
  shared->pipeline_natural_order = natural_pipeline ? 1 : 0;
  shared->pipeline_supernode_tasks =
    (natural_pipeline && kls_egraph_supernode_tasks_env_enabled()) ? 1 : 0;
  shared->supernode_numeric_updates =
    supernode_numeric_updates ? 1 : 0;
  shared->subtree_supernode_split =
    kls_egraph_subtree_supernode_split_env_enabled() ? 1 : 0;
  shared->supernode_cached_updates_only =
    cached_supernode_updates_only ? 1 : 0;
  shared->btf_scalar_run_stats =
    (btf_scalar_run_stats_requested &&
     kls_egraph_kernel_is_btf_unscaled(shared->kernel))
      ? 1 : 0;
  shared->btf_scalar_run_exec =
    (btf_scalar_run_exec_requested &&
     kls_egraph_kernel_is_btf_unscaled(shared->kernel))
      ? 1 : 0;
  shared->btf_scalar_run_group_wait_stats =
    (btf_scalar_run_group_wait_stats_requested &&
     kls_egraph_kernel_is_btf_unscaled(shared->kernel) &&
     btf_scalar_run_group_live != NULL &&
     btf_scalar_run_group_live_count > 0u)
      ? 1 : 0;
  shared->btf_scalar_run_group_live =
    shared->btf_scalar_run_group_wait_stats ? btf_scalar_run_group_live : NULL;
  shared->btf_scalar_run_group_live_count =
    shared->btf_scalar_run_group_wait_stats
      ? btf_scalar_run_group_live_count
      : 0u;
  shared->btf_scalar_run_group_claims =
    (btf_scalar_run_group_claims_requested &&
     kls_egraph_kernel_is_btf_unscaled(shared->kernel) &&
     pipeline_claimed != NULL &&
     solver->refactor_btf_scalar_run_group_built &&
     solver->refactor_btf_scalar_run_group_multi_count > 0u)
      ? 1 : 0;
  shared->btf_scalar_run_group_prefix_stats =
    (btf_scalar_run_group_prefix_stats_requested &&
     kls_egraph_kernel_is_btf_unscaled(shared->kernel) &&
     pipeline_done != NULL &&
     solver->refactor_btf_scalar_run_group_built &&
     solver->refactor_btf_scalar_run_group_multi_count > 0u)
      ? 1 : 0;
  shared->btf_scalar_run_group_wake_stats =
    (btf_scalar_run_group_wake_stats_active_requested &&
     kls_egraph_kernel_is_btf_unscaled(shared->kernel) &&
     pipeline_done != NULL &&
     btf_scalar_run_group_wake_live != NULL &&
     btf_scalar_run_group_wake_live_count > 0u &&
     solver->refactor_btf_scalar_run_group_built &&
     solver->refactor_btf_scalar_run_group_wake_count > 0u)
      ? 1 : 0;
  shared->btf_scalar_run_group_wake_live =
    shared->btf_scalar_run_group_wake_stats
      ? btf_scalar_run_group_wake_live
      : NULL;
  shared->btf_scalar_run_group_wake_live_count =
    shared->btf_scalar_run_group_wake_stats
      ? btf_scalar_run_group_wake_live_count
      : 0u;
  shared->btf_scalar_run_group_state_stats =
    (btf_scalar_run_group_state_stats_active_requested &&
     shared->btf_scalar_run_group_wake_stats &&
     btf_scalar_run_group_state_values != NULL &&
     ((btf_scalar_run_group_state_compact_values_active_requested &&
       btf_scalar_run_group_state_value_base != NULL &&
       btf_scalar_run_group_state_value_base_count >=
         solver->refactor_btf_scalar_run_group_multi_current_total &&
       btf_scalar_run_group_state_size > 0u) ||
      (!btf_scalar_run_group_state_compact_values_active_requested &&
       btf_scalar_run_group_state_size >=
         solver->refactor_btf_scalar_run_group_state_rows_total)))
      ? 1 : 0;
  shared->btf_scalar_run_group_state_values =
    shared->btf_scalar_run_group_state_stats
      ? btf_scalar_run_group_state_values
      : NULL;
  shared->btf_scalar_run_group_state_u_values =
    shared->btf_scalar_run_group_state_stats &&
        btf_scalar_run_group_state_exec_active_requested
      ? btf_scalar_run_group_state_u_values
      : NULL;
  shared->btf_scalar_run_group_state_size =
    shared->btf_scalar_run_group_state_stats
      ? btf_scalar_run_group_state_size
      : 0u;
  shared->btf_scalar_run_group_state_value_base =
    shared->btf_scalar_run_group_state_stats &&
        btf_scalar_run_group_state_compact_values_active_requested
      ? btf_scalar_run_group_state_value_base
      : NULL;
  shared->btf_scalar_run_group_state_value_base_count =
    shared->btf_scalar_run_group_state_value_base != NULL
      ? btf_scalar_run_group_state_value_base_count
      : 0u;
  shared->btf_scalar_run_group_state_values_compact =
    shared->btf_scalar_run_group_state_value_base != NULL ? 1 : 0;
  shared->btf_scalar_run_group_state_advance_batch_stats =
    (btf_scalar_run_group_state_advance_batch_stats_requested &&
     shared->btf_scalar_run_group_state_stats)
      ? 1 : 0;
  shared->btf_scalar_run_group_state_step_advance =
    (btf_scalar_run_group_state_step_advance_active_requested &&
     shared->btf_scalar_run_group_state_stats &&
     btf_scalar_run_group_state_next != NULL &&
     btf_scalar_run_group_state_next_count >=
       solver->refactor_btf_scalar_run_group_multi_current_total &&
     solver->refactor_btf_scalar_run_group_step_count > 0u &&
     solver->refactor_btf_scalar_run_group_step_ptr != NULL &&
     solver->refactor_btf_scalar_run_group_step_groups != NULL &&
     solver->refactor_btf_scalar_run_group_step_member_ptr != NULL &&
     solver->refactor_btf_scalar_run_group_step_members != NULL)
      ? 1 : 0;
  shared->btf_scalar_run_group_state_next =
    shared->btf_scalar_run_group_state_step_advance
      ? btf_scalar_run_group_state_next
