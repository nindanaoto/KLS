static inline UF_long kls_algorithm5_payoff_u_index_at(
  const UF_long *ui,
  const int32_t *ui32,
  UF_long p) {
  return ui32 != NULL ? (UF_long)ui32[p] : ui[p];
}

static inline double kls_algorithm5_payoff_state_with_delta(
  const kls_algorithm5_payoff_group_prefix_item *item,
  const unsigned char *delta_mark,
  const double *delta_values,
  UF_long pos) {
  return item->state_values[pos] +
         (delta_mark[pos] ? delta_values[pos] : 0.0);
}

static inline void kls_algorithm5_payoff_add_state_delta(
  unsigned char *delta_mark,
  double *delta_values,
  UF_long pos,
  double delta) {
  if (delta_mark[pos]) {
    delta_values[pos] += delta;
  } else {
    delta_mark[pos] = 1u;
    delta_values[pos] = delta;
  }
}

static inline void kls_algorithm5_payoff_log_live_state(
  unsigned char *mark,
  double *old_values,
  double *state_values,
  UF_long pos) {
  if (!mark[pos]) {
    mark[pos] = 1u;
    old_values[pos] = state_values[pos];
  }
}

static inline double kls_algorithm5_payoff_take_live_state(
  unsigned char *mark,
  double *old_values,
  double *state_values,
  UF_long pos) {
  kls_algorithm5_payoff_log_live_state(mark, old_values, state_values, pos);
  const double value = state_values[pos];
  state_values[pos] = 0.0;
  return value;
}

static inline void kls_algorithm5_payoff_add_live_state(
  unsigned char *mark,
  double *old_values,
  double *state_values,
  UF_long pos,
  double delta) {
  kls_algorithm5_payoff_log_live_state(mark, old_values, state_values, pos);
  state_values[pos] += delta;
}

static void kls_algorithm5_payoff_restore_live_state(
  double *state_values,
  const unsigned char *mark,
  const double *old_values,
  UF_long state_rows) {
  if (state_values == NULL || mark == NULL || old_values == NULL) {
    return;
  }
  for (UF_long p = 0u; p < state_rows; ++p) {
    if (mark[p]) {
      state_values[p] = old_values[p];
    }
  }
}

static int kls_egraph_refactor_dependency_done_now(
  const kls_egraph_refactor_shared *shared,
  UF_long col);

static int
kls_egraph_refactor_try_seed_algorithm5_payoff_direct_prefix_current_state(
  kls_egraph_refactor_worker *worker,
  UF_long k1,
  UF_long current_global,
  UF_long current_local,
  UF_long *up_io,
  UF_long ucol_len,
  const UF_long *ui,
  double *ux,
  double *x) {
  if (worker == NULL || worker->shared == NULL || up_io == NULL ||
      ui == NULL || ux == NULL || x == NULL || *up_io >= ucol_len ||
      ucol_len == 0u) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  const int direct_prefix_final_state =
    shared->supernode_algorithm5_payoff_direct_prefix_final_state;
  if (solver == NULL ||
      !shared->supernode_algorithm5_payoff_direct_prefix_current_state ||
      !shared->supernode_algorithm5_payoff_direct_prefix_prep ||
      (direct_prefix_final_state &&
       shared->algorithm5_payoff_workspace_values == NULL) ||
      shared->algorithm5_payoff_current_flags == NULL ||
      current_global >= solver->n || k1 > current_global ||
      current_local != current_global - k1 ||
      solver->refactor_supernode_consumer_plan_col_ptr == NULL ||
      solver->refactor_supernode_consumer_plan_col_runs == NULL ||
      solver->refactor_supernode_consumer_plan_current == NULL ||
      solver->refactor_supernode_consumer_plan_dep == NULL ||
      solver->refactor_supernode_consumer_plan_panel_start == NULL ||
      solver->refactor_supernode_consumer_plan_panel_offset == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_group == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_current_pos == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_deps == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_prefix_rows == NULL ||
      (direct_prefix_final_state &&
       solver->refactor_supernode_algorithm5_payoff_run_target_entries == NULL) ||
      solver->refactor_supernode_algorithm5_payoff_group_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_currents == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_runs ==
        NULL ||
      (direct_prefix_final_state &&
       solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr ==
         NULL) ||
      solver->refactor_supernode_algorithm5_payoff_run_selected == NULL ||
      solver->refactor_supernode_algorithm5_payoff_current_state_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_current_state_rows == NULL) {
    return 0;
  }

  UF_long block_size = 0u;
  if (solver->symbolic != NULL && solver->symbolic->R != NULL &&
      solver->symbolic->nblocks > 1u) {
    UF_long block = KLS_KLU_EMPTY;
    if (solver->refactor_col_block != NULL) {
      block = solver->refactor_col_block[current_global];
    } else {
      block = kls_block_for_pivot(solver, current_global);
    }
    if (block == KLS_KLU_EMPTY || block >= solver->symbolic->nblocks ||
        solver->symbolic->R[block] != k1 ||
        solver->symbolic->R[block + 1u] <= k1) {
      return 0;
    }
    block_size = solver->symbolic->R[block + 1u] - k1;
  } else {
    if (k1 != 0u || solver->n < current_global) {
      return 0;
    }
    block_size = solver->n;
  }
  if (current_local >= block_size) {
    return 0;
  }

  const UF_long begin =
    solver->refactor_supernode_consumer_plan_col_ptr[current_global];
  const UF_long end =
    solver->refactor_supernode_consumer_plan_col_ptr[current_global + 1u];
  if (begin > end ||
      end > solver->refactor_supernode_consumer_plan_run_count) {
    return 0;
  }
  for (UF_long pos = begin; pos < end; ++pos) {
    const UF_long run = solver->refactor_supernode_consumer_plan_col_runs[pos];
    if (run >= solver->refactor_supernode_consumer_plan_run_count ||
        !solver->refactor_supernode_algorithm5_payoff_run_selected[run] ||
        solver->refactor_supernode_consumer_plan_current[run] !=
          current_global) {
      continue;
    }
    const UF_long group =
      solver->refactor_supernode_algorithm5_payoff_run_group[run];
    if (group == KLS_KLU_EMPTY ||
        group >= solver->refactor_supernode_algorithm5_payoff_group_count) {
      continue;
    }
    const UF_long current_slot =
      solver->refactor_supernode_algorithm5_payoff_run_current_pos[run];
    const UF_long current_begin =
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group];
    const UF_long current_end =
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group +
                                                                     1u];
    if (current_begin > current_end ||
        current_end >
          solver->refactor_supernode_algorithm5_payoff_group_current_total ||
        current_slot == KLS_KLU_EMPTY || current_slot < current_begin ||
        current_slot >= current_end ||
        current_slot >= shared->algorithm5_payoff_current_count ||
        solver->refactor_supernode_algorithm5_payoff_group_currents[
          current_slot] != current_global ||
        current_slot + 1u >
          solver->refactor_supernode_algorithm5_payoff_group_current_total) {
      continue;
    }
    const UF_long current_run_begin =
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
        current_slot];
    const UF_long current_run_end =
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
        current_slot + 1u];
    if (current_run_begin > current_run_end ||
        current_run_end >
          solver->refactor_supernode_algorithm5_payoff_group_ptr[
            solver->refactor_supernode_algorithm5_payoff_group_count] ||
        current_run_end - current_run_begin != 1u ||
        solver->refactor_supernode_algorithm5_payoff_group_current_runs[
          current_run_begin] != run) {
      continue;
    }

    const UF_long advance_deps =
      solver->refactor_supernode_algorithm5_payoff_run_advance_deps[run];
    const UF_long prefix_rows =
      solver->refactor_supernode_algorithm5_payoff_run_prefix_rows[run];
    const UF_long current_up = *up_io;
    if ((!direct_prefix_final_state && advance_deps <= current_up) ||
        advance_deps >= ucol_len || prefix_rows == 0u ||
        prefix_rows > ucol_len - advance_deps) {
      continue;
    }
    const UF_long prefix_end = advance_deps + prefix_rows;
    if (direct_prefix_final_state &&
        (prefix_end <= current_up || prefix_end > ucol_len)) {
      continue;
    }
    const UF_long dep =
      solver->refactor_supernode_consumer_plan_dep[run];
    const UF_long panel_start =
      solver->refactor_supernode_consumer_plan_panel_start[run];
    const UF_long panel_offset =
      solver->refactor_supernode_consumer_plan_panel_offset[run];
    if (dep < k1 || dep >= current_global ||
        panel_start == KLS_KLU_EMPTY || panel_offset == KLS_KLU_EMPTY ||
        dep != panel_start + panel_offset) {
      continue;
    }
    const UF_long dep_local = dep - k1;
    if (dep_local >= current_local || ui[advance_deps] != dep_local) {
      continue;
    }
    int stream_ok = 1;
    for (UF_long p = 0u; p < advance_deps; ++p) {
      if (ui[p] >= current_local) {
        stream_ok = 0;
        break;
      }
    }
    for (UF_long local = 0u; local < prefix_rows; ++local) {
      if (ui[advance_deps + local] != dep_local + local) {
        stream_ok = 0;
        break;
      }
    }
    if (!stream_ok) {
      continue;
    }

    const UF_long advance_u_begin =
      solver->refactor_supernode_algorithm5_payoff_run_advance_ptr[run];
    if (advance_u_begin == KLS_KLU_EMPTY ||
        advance_u_begin > shared->algorithm5_payoff_advance_u_size ||
        advance_deps >
          shared->algorithm5_payoff_advance_u_size - advance_u_begin ||
        (advance_deps > 0u &&
         shared->algorithm5_payoff_advance_u_values == NULL)) {
      continue;
    }

    const double *prepared_workspace = NULL;
    if (direct_prefix_final_state) {
      const UF_long workspace_begin =
        solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr[
          current_slot];
      const UF_long workspace_end =
        solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr[
          current_slot + 1u];
      if (workspace_end < workspace_begin ||
          prefix_rows > workspace_end - workspace_begin ||
          workspace_begin > shared->algorithm5_payoff_workspace_size ||
          prefix_rows >
            shared->algorithm5_payoff_workspace_size - workspace_begin) {
        continue;
      }
      prepared_workspace =
        shared->algorithm5_payoff_workspace_values + workspace_begin;
    }

    const UF_long state_begin =
      solver->refactor_supernode_algorithm5_payoff_current_state_ptr[
        current_slot];
    const UF_long state_end =
      solver->refactor_supernode_algorithm5_payoff_current_state_ptr[
        current_slot + 1u];
    if (state_end < state_begin ||
        state_end > shared->algorithm5_payoff_current_state_size ||
        (state_end > state_begin &&
         shared->algorithm5_payoff_current_state_values == NULL)) {
      continue;
    }
    const UF_long state_rows = state_end - state_begin;
    const UF_long *state_row_idx =
      solver->refactor_supernode_algorithm5_payoff_current_state_rows +
      state_begin;
    const double *state_values =
      state_rows > 0u
        ? shared->algorithm5_payoff_current_state_values + state_begin
        : NULL;

    unsigned char state =
      kls_algorithm5_payoff_current_state_load(
        shared->algorithm5_payoff_current_flags, current_slot);
    unsigned spin = 0u;
    while (state == KLS_ALGORITHM5_PAYOFF_CURRENT_PREPARING) {
      if (kls_egraph_refactor_should_stop(shared)) {
        return -1;
      }
      kls_egraph_pipeline_pause(&spin);
      state = kls_algorithm5_payoff_current_state_load(
        shared->algorithm5_payoff_current_flags, current_slot);
    }
    if (state != KLS_ALGORITHM5_PAYOFF_CURRENT_READY) {
      continue;
    }

    UF_long restored_rows = state_rows;
    int sparse_restored = 0;
    if (direct_prefix_final_state &&
        shared->supernode_algorithm5_payoff_direct_prefix_sparse_restore &&
        current_up == 0u && state_rows > 0u) {
      int sparse_candidate =
        solver->numeric != NULL && solver->numeric->Llen != NULL;
      if (sparse_candidate) {
        double needed_bound = 1.0 + (double)solver->numeric->Llen[current_global];
        const double useful_bound = 0.75 * (double)state_rows;
        if (needed_bound >= useful_bound) {
          sparse_candidate = 0;
        }
        for (UF_long p = prefix_end; sparse_candidate && p < ucol_len; ++p) {
          const UF_long dep_local = ui[p];
          if (dep_local >= block_size || dep_local > UF_long_max - k1 ||
              k1 + dep_local >= solver->n) {
            sparse_candidate = 0;
            break;
          }
          needed_bound +=
            1.0 + (double)solver->numeric->Llen[k1 + dep_local];
          if (needed_bound >= useful_bound) {
            sparse_candidate = 0;
            break;
          }
        }
      }
      if (!sparse_candidate) {
        goto algorithm5_payoff_full_state_restore;
      }
      kls_algorithm5_payoff_group_prefix_item state_item;
      memset(&state_item, 0, sizeof(state_item));
      state_item.current = current_global;
      state_item.k1 = k1;
      state_item.block_size = block_size;
      state_item.state_rows = state_rows;
      state_item.state_row_idx = state_row_idx;
      state_item.state_values = (double *)state_values;

      UF_long state_stamp_value = 0u;
      UF_long *state_stamp = NULL;
      UF_long *state_pos = NULL;
      unsigned char *needed =
        kls_egraph_worker_byte_workspace(worker, block_size);
      UF_long *needed_rows =
        (UF_long *)kls_egraph_worker_object_workspace(
          worker, state_rows, sizeof(*needed_rows));
      if (needed != NULL && needed_rows != NULL &&
          kls_algorithm5_payoff_prepare_state_row_lookup(
            worker, &state_item, &state_stamp_value, &state_stamp,
            &state_pos)) {
        memset(needed, 0, (size_t)block_size);
        UF_long needed_count = 0u;
        int sparse_ok = 1;
        for (UF_long p = prefix_end; p < ucol_len; ++p) {
          const UF_long dep_local = ui[p];
          if (dep_local >= block_size || dep_local > UF_long_max - k1 ||
              !kls_algorithm5_payoff_add_sparse_restore_row(
                &state_item, dep_local, state_stamp_value, state_stamp,
                state_pos, needed, needed_rows, state_rows, &needed_count) ||
              !kls_algorithm5_payoff_add_l_sparse_restore_rows(
                solver, &state_item, k1 + dep_local, state_stamp_value,
                state_stamp, state_pos, needed, needed_rows, state_rows,
                &needed_count)) {
            sparse_ok = 0;
            break;
          }
        }
        if (sparse_ok &&
            (!kls_algorithm5_payoff_add_sparse_restore_row(
               &state_item, current_local, state_stamp_value, state_stamp,
               state_pos, needed, needed_rows, state_rows, &needed_count) ||
             !kls_algorithm5_payoff_add_l_sparse_restore_rows(
               solver, &state_item, current_global, state_stamp_value,
               state_stamp, state_pos, needed, needed_rows, state_rows,
               &needed_count))) {
          sparse_ok = 0;
        }
        if (sparse_ok) {
          for (UF_long p = 0u; p < needed_count; ++p) {
            const UF_long row = needed_rows[p];
            UF_long pos = 0u;
            if (!kls_algorithm5_payoff_state_value_position(
                  &state_item, row, state_stamp_value, state_stamp, state_pos,
                  &pos)) {
              sparse_ok = 0;
              break;
            }
            x[row] = state_values[pos];
          }
        }
        if (sparse_ok &&
            !kls_algorithm5_payoff_clear_sparse_restore_scatter(
              solver, k1, current_global, block_size, needed, x)) {
          sparse_ok = 0;
        }
        if (sparse_ok) {
          restored_rows = needed_count;
          sparse_restored = 1;
        }
      }
    }
algorithm5_payoff_full_state_restore:
    if (!sparse_restored) {
      for (UF_long p = 0u; p < state_rows; ++p) {
        const UF_long row = state_row_idx[p];
        if (row >= block_size) {
          return 0;
        }
        x[row] = state_values[p];
      }
    }

    const double *advance_u_values =
      shared->algorithm5_payoff_advance_u_values + advance_u_begin;
    for (UF_long p = 0u; p < advance_deps; ++p) {
      const UF_long local = ui[p];
      const double ujk = advance_u_values[p];
      ux[p] = ujk;
      x[local] = 0.0;
      if (shared->u_supernode_values) {
        kls_egraph_record_u_supernode_value(
          shared, k1 + local, current_global, ujk);
      }
    }
    UF_long seed_end = advance_deps;
    if (direct_prefix_final_state) {
      for (UF_long local = 0u; local < prefix_rows; ++local) {
        const UF_long up = advance_deps + local;
        const UF_long row = ui[up];
        const double ujk = prepared_workspace[local];
        ux[up] = ujk;
        x[row] = 0.0;
        if (shared->u_supernode_values) {
          kls_egraph_record_u_supernode_value(
            shared, k1 + row, current_global, ujk);
        }
      }
      seed_end = prefix_end;
      const UF_long target_entries =
        solver->refactor_supernode_algorithm5_payoff_run_target_entries[run];
      const UF_long trsv_entries = (prefix_rows * (prefix_rows - 1u)) / 2u;
      kls_egraph_record_algorithm5_payoff_prefix_prep(
        shared, prefix_rows, target_entries, 0u);
      kls_egraph_record_u_supernode_l_update(
        shared, prefix_rows, trsv_entries + target_entries);
    }
    const UF_long seeded_deps = seed_end - current_up;
    *up_io = seed_end;
    kls_egraph_record_algorithm5_payoff_current_state_seed(
      shared, seeded_deps, restored_rows);
    return 1;
  }
  return 0;
}

static int
kls_egraph_refactor_try_seed_algorithm5_payoff_direct_prefix_advance(
  kls_egraph_refactor_worker *worker,
  UF_long k1,
  UF_long current_global,
  UF_long current_local,
  UF_long *up_io,
  UF_long ucol_len,
  const UF_long *ui,
  double *ux,
  double *x) {
  if (worker == NULL || worker->shared == NULL || up_io == NULL ||
      ui == NULL || ux == NULL || x == NULL || *up_io >= ucol_len ||
      ucol_len == 0u) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (shared->supernode_algorithm5_payoff_direct_prefix_current_state) {
    const int status =
      kls_egraph_refactor_try_seed_algorithm5_payoff_direct_prefix_current_state(
        worker, k1, current_global, current_local, up_io, ucol_len, ui, ux, x);
    if (status != 0) {
      return status;
    }
  }
  if (solver == NULL ||
      !shared->supernode_algorithm5_payoff_direct_prefix_advance_seed ||
      !shared->supernode_algorithm5_payoff_direct_prefix_prep ||
      shared->algorithm5_payoff_current_flags == NULL ||
      current_global >= solver->n || k1 > current_global ||
      current_local != current_global - k1 ||
      solver->refactor_supernode_consumer_plan_col_ptr == NULL ||
      solver->refactor_supernode_consumer_plan_col_runs == NULL ||
      solver->refactor_supernode_consumer_plan_current == NULL ||
      solver->refactor_supernode_consumer_plan_dep == NULL ||
      solver->refactor_supernode_consumer_plan_panel_start == NULL ||
      solver->refactor_supernode_consumer_plan_panel_offset == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_group == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_current_pos == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_deps == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_slots == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_slot_ptr ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_prefix_rows == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_currents == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_runs ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_selected == NULL ||
      (solver->refactor_supernode_algorithm5_payoff_group_advance_slots_total >
         0u &&
       solver->refactor_supernode_algorithm5_payoff_group_advance_cols ==
         NULL)) {
    return 0;
  }

  UF_long block_size = 0u;
  if (solver->symbolic != NULL && solver->symbolic->R != NULL &&
      solver->symbolic->nblocks > 1u) {
    UF_long block = KLS_KLU_EMPTY;
    if (solver->refactor_col_block != NULL) {
      block = solver->refactor_col_block[current_global];
    } else {
      block = kls_block_for_pivot(solver, current_global);
    }
    if (block == KLS_KLU_EMPTY || block >= solver->symbolic->nblocks ||
        solver->symbolic->R[block] != k1 ||
        solver->symbolic->R[block + 1u] <= k1) {
      return 0;
    }
    block_size = solver->symbolic->R[block + 1u] - k1;
  } else {
    if (k1 != 0u || solver->n < current_global) {
      return 0;
    }
    block_size = solver->n;
  }
  if (current_local >= block_size) {
    return 0;
  }

  const UF_long begin =
    solver->refactor_supernode_consumer_plan_col_ptr[current_global];
  const UF_long end =
    solver->refactor_supernode_consumer_plan_col_ptr[current_global + 1u];
  if (begin > end ||
      end > solver->refactor_supernode_consumer_plan_run_count) {
    return 0;
  }
  for (UF_long pos = begin; pos < end; ++pos) {
    const UF_long run = solver->refactor_supernode_consumer_plan_col_runs[pos];
    if (run >= solver->refactor_supernode_consumer_plan_run_count ||
        !solver->refactor_supernode_algorithm5_payoff_run_selected[run] ||
        solver->refactor_supernode_consumer_plan_current[run] !=
          current_global) {
      continue;
    }
    const UF_long group =
      solver->refactor_supernode_algorithm5_payoff_run_group[run];
    if (group == KLS_KLU_EMPTY ||
        group >= solver->refactor_supernode_algorithm5_payoff_group_count) {
      continue;
    }
    const UF_long current_slot =
      solver->refactor_supernode_algorithm5_payoff_run_current_pos[run];
    const UF_long current_begin =
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group];
    const UF_long current_end =
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group +
                                                                     1u];
    if (current_begin > current_end ||
        current_end >
          solver->refactor_supernode_algorithm5_payoff_group_current_total ||
        current_slot == KLS_KLU_EMPTY || current_slot < current_begin ||
        current_slot >= current_end ||
        current_slot >= shared->algorithm5_payoff_current_count ||
        solver->refactor_supernode_algorithm5_payoff_group_currents[
          current_slot] != current_global ||
        current_slot + 1u >
          solver->refactor_supernode_algorithm5_payoff_group_current_total) {
      continue;
    }
    const UF_long current_run_begin =
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
        current_slot];
    const UF_long current_run_end =
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
        current_slot + 1u];
    if (current_run_begin > current_run_end ||
        current_run_end >
          solver->refactor_supernode_algorithm5_payoff_group_ptr[
            solver->refactor_supernode_algorithm5_payoff_group_count] ||
        current_run_end - current_run_begin != 1u ||
        solver->refactor_supernode_algorithm5_payoff_group_current_runs[
          current_run_begin] != run) {
      continue;
    }

    const UF_long advance_deps =
      solver->refactor_supernode_algorithm5_payoff_run_advance_deps[run];
    const UF_long prefix_rows =
      solver->refactor_supernode_algorithm5_payoff_run_prefix_rows[run];
    const UF_long current_up = *up_io;
    if (advance_deps <= current_up || advance_deps >= ucol_len ||
        prefix_rows == 0u || prefix_rows > ucol_len - advance_deps) {
      continue;
    }
    const UF_long dep =
      solver->refactor_supernode_consumer_plan_dep[run];
    const UF_long panel_start =
      solver->refactor_supernode_consumer_plan_panel_start[run];
    const UF_long panel_offset =
      solver->refactor_supernode_consumer_plan_panel_offset[run];
    if (dep < k1 || dep >= current_global ||
        panel_start == KLS_KLU_EMPTY || panel_offset == KLS_KLU_EMPTY ||
        dep != panel_start + panel_offset) {
      continue;
    }
    const UF_long dep_local = dep - k1;
    if (dep_local >= current_local || ui[advance_deps] != dep_local) {
      continue;
    }
    int stream_ok = 1;
    for (UF_long p = 0u; p < advance_deps; ++p) {
      if (ui[p] >= current_local) {
        stream_ok = 0;
        break;
      }
    }
    for (UF_long local = 0u; local < prefix_rows; ++local) {
      if (ui[advance_deps + local] != dep_local + local) {
        stream_ok = 0;
        break;
      }
    }
    if (!stream_ok) {
      continue;
    }

    const UF_long advance_u_begin =
      solver->refactor_supernode_algorithm5_payoff_run_advance_ptr[run];
    const UF_long advance_slot_begin =
      solver->refactor_supernode_algorithm5_payoff_run_advance_slot_ptr[run];
    const UF_long advance_slots =
      solver->refactor_supernode_algorithm5_payoff_run_advance_slots[run];
    if (advance_u_begin == KLS_KLU_EMPTY ||
        advance_u_begin > shared->algorithm5_payoff_advance_u_size ||
        advance_deps >
          shared->algorithm5_payoff_advance_u_size - advance_u_begin ||
        shared->algorithm5_payoff_advance_u_values == NULL ||
        advance_slot_begin == KLS_KLU_EMPTY ||
        advance_slot_begin > shared->algorithm5_payoff_advance_size ||
        advance_slots >
          shared->algorithm5_payoff_advance_size - advance_slot_begin ||
        (advance_slots > 0u &&
         (shared->algorithm5_payoff_advance_values == NULL ||
          solver->refactor_supernode_algorithm5_payoff_group_advance_cols ==
            NULL))) {
      continue;
    }

    unsigned char state =
      kls_algorithm5_payoff_current_state_load(
        shared->algorithm5_payoff_current_flags, current_slot);
    unsigned spin = 0u;
    while (state == KLS_ALGORITHM5_PAYOFF_CURRENT_PREPARING) {
      if (kls_egraph_refactor_should_stop(shared)) {
        return -1;
      }
      kls_egraph_pipeline_pause(&spin);
      state = kls_algorithm5_payoff_current_state_load(
        shared->algorithm5_payoff_current_flags, current_slot);
    }
    if (state != KLS_ALGORITHM5_PAYOFF_CURRENT_READY) {
      continue;
    }

    const double *advance_u_values =
      shared->algorithm5_payoff_advance_u_values + advance_u_begin;
    for (UF_long p = 0u; p < advance_deps; ++p) {
      const UF_long local = ui[p];
      const double ujk = advance_u_values[p];
      ux[p] = ujk;
      x[local] = 0.0;
      if (shared->u_supernode_values) {
        kls_egraph_record_u_supernode_value(
          shared, k1 + local, current_global, ujk);
      }
    }
    if (advance_slots > 0u) {
      const UF_long *advance_cols =
        solver->refactor_supernode_algorithm5_payoff_group_advance_cols +
        advance_slot_begin;
      const double *advance_values =
        shared->algorithm5_payoff_advance_values + advance_slot_begin;
      for (UF_long slot = 0u; slot < advance_slots; ++slot) {
        const UF_long row = advance_cols[slot];
        if (row >= block_size) {
          return 0;
        }
        x[row] = advance_values[slot];
      }
    }
    const UF_long seeded_deps = advance_deps - current_up;
    *up_io = advance_deps;
    kls_egraph_record_algorithm5_payoff_advance_seed(
      shared, seeded_deps, advance_slots);
    return 1;
  }
  return 0;
}

static int
kls_egraph_refactor_try_algorithm5_payoff_state_ragged_l_suffix_run(
  kls_egraph_refactor_worker *worker,
  kls_algorithm5_payoff_group_prefix_item *state_item,
  UF_long k1,
  UF_long current_global,
  UF_long current_local,
  UF_long *up_io,
  UF_long ucol_len,
  const UF_long *ui,
  const int32_t *ui32,
  double *u_work,
  double *state_work,
  UF_long state_stamp_value,
  const UF_long *state_stamp,
  const UF_long *state_pos,
  int wait_for_dependencies,
  int u_supernode_values) {
  if (worker == NULL || worker->shared == NULL || state_item == NULL ||
      up_io == NULL || u_work == NULL || state_work == NULL ||
      state_stamp == NULL || state_pos == NULL || *up_io >= ucol_len ||
      (ucol_len > 0u && ui == NULL && ui32 == NULL) ||
      current_local == 0u || current_local >= state_item->block_size ||
      current_global < k1 || current_global - k1 != current_local) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || !shared->u_supernode_ragged_l_updates ||
      solver->refactor_u_supernode_col_id == NULL ||
      solver->refactor_u_supernode_start == NULL ||
      solver->refactor_u_supernode_local_start == NULL ||
      solver->refactor_u_supernode_width == NULL ||
      solver->refactor_u_supernode_dense_begin == NULL ||
      solver->refactor_u_supernode_l_valid == NULL ||
      solver->refactor_u_supernode_l_row_begin == NULL ||
      solver->refactor_u_supernode_l_row_ptr == NULL ||
      solver->refactor_u_supernode_l_cols == NULL ||
      solver->refactor_u_supernode_l_dense_values == NULL ||
      current_global >= solver->n) {
    return 0;
  }

  const UF_long up = *up_io;
  const UF_long dep_local =
    kls_algorithm5_payoff_u_index_at(ui, ui32, up);
  if (dep_local >= current_local || dep_local > UF_long_max - k1) {
    kls_egraph_record_u_supernode_l_short_reject(shared);
    return 0;
  }
  const UF_long dep_global = k1 + dep_local;
  if (dep_global >= current_global || dep_global >= solver->n) {
    kls_egraph_record_u_supernode_l_short_reject(shared);
    return 0;
  }
  kls_egraph_record_u_supernode_l_probe_attempt(shared);
  const UF_long panel = solver->refactor_u_supernode_col_id[dep_global];
  if (panel == KLS_KLU_EMPTY ||
      panel >= solver->refactor_u_supernode_pattern_count ||
      !solver->refactor_u_supernode_l_valid[panel]) {
    kls_egraph_record_u_supernode_l_panel_miss(shared);
    return 0;
  }
  const UF_long start = solver->refactor_u_supernode_start[panel];
  const UF_long local_start =
    solver->refactor_u_supernode_local_start[panel];
  const UF_long width = solver->refactor_u_supernode_width[panel];
  if (width <= 1u || start > solver->n || width > solver->n - start ||
      start > dep_global || dep_global - start >= width ||
      local_start > state_item->block_size ||
      width > state_item->block_size - local_start) {
    kls_egraph_record_u_supernode_l_panel_miss(shared);
    return 0;
  }
  const UF_long panel_offset = dep_global - start;
  if (local_start > dep_local ||
      dep_local - local_start != panel_offset) {
    kls_egraph_record_u_supernode_l_panel_miss(shared);
    return 0;
  }

  UF_long available_end = width;
  if (current_global - start < width) {
    available_end = current_global - start;
  }
  if (available_end > width || available_end <= panel_offset + 1u) {
    kls_egraph_record_u_supernode_l_short_reject(shared);
    return 0;
  }
  const UF_long run_rows = available_end - panel_offset;
  if (run_rows > ucol_len - up ||
      run_rows > current_local - dep_local ||
      run_rows > (UF_long)(SIZE_MAX / sizeof(double))) {
    kls_egraph_record_u_supernode_l_short_reject(shared);
    return 0;
  }

  UF_long tmp_pos = 0u;
  for (UF_long local = 0u; local < run_rows; ++local) {
    const UF_long row =
      kls_algorithm5_payoff_u_index_at(ui, ui32, up + local);
    if (row != dep_local + local ||
        !kls_algorithm5_payoff_state_value_position(
          state_item, row, state_stamp_value, state_stamp, state_pos,
          &tmp_pos)) {
      kls_egraph_record_u_supernode_l_stream_reject(shared);
      return 0;
    }
  }

  const UF_long row_base =
    solver->refactor_u_supernode_l_row_begin[panel] + panel_offset;
  if (row_base > solver->refactor_u_supernode_pattern_rows ||
      run_rows > solver->refactor_u_supernode_pattern_rows - row_base) {
    kls_egraph_record_u_supernode_l_panel_miss(shared);
    return 0;
  }
  UF_long trailing_entries = 0u;
  for (UF_long local = 0u; local < run_rows; ++local) {
    const UF_long begin =
      solver->refactor_u_supernode_l_row_ptr[row_base + local];
    const UF_long end =
      solver->refactor_u_supernode_l_row_ptr[row_base + local + 1u];
    if (end < begin || end > solver->refactor_u_supernode_l_trailing_entries ||
        end - begin > UF_long_max - trailing_entries) {
      kls_egraph_record_u_supernode_l_panel_miss(shared);
      return 0;
    }
    trailing_entries += end - begin;
  }

  const double *dense_panel =
    solver->refactor_u_supernode_l_dense_values +
    solver->refactor_u_supernode_dense_begin[panel];
  const UF_long *trailing_cols = solver->refactor_u_supernode_l_cols;
  const double *trailing_values = solver->refactor_u_supernode_l_values;
  if (trailing_entries > 0u &&
      (trailing_cols == NULL || trailing_values == NULL)) {
    kls_egraph_record_u_supernode_l_panel_miss(shared);
    return 0;
  }

  for (UF_long target = available_end; target < width; ++target) {
    const UF_long row = local_start + target;
    if (!kls_algorithm5_payoff_state_value_position(
          state_item, row, state_stamp_value, state_stamp, state_pos,
          &tmp_pos)) {
      kls_egraph_record_u_supernode_l_stream_reject(shared);
      return 0;
    }
  }
  for (UF_long local = 0u; local < run_rows; ++local) {
    const UF_long row = row_base + local;
    const UF_long begin = solver->refactor_u_supernode_l_row_ptr[row];
    const UF_long end = solver->refactor_u_supernode_l_row_ptr[row + 1u];
    for (UF_long p = begin; p < end; ++p) {
      if (!kls_algorithm5_payoff_state_value_position(
            state_item, trailing_cols[p], state_stamp_value, state_stamp,
            state_pos, &tmp_pos)) {
        kls_egraph_record_u_supernode_l_stream_reject(shared);
        return 0;
      }
    }
  }

  double *workspace = kls_egraph_worker_supernode_workspace(worker, run_rows);
  if (workspace == NULL) {
    kls_egraph_record_u_supernode_l_work_reject(shared);
    return 0;
  }

  if (wait_for_dependencies) {
    for (UF_long local = 0u; local < run_rows; ++local) {
      if (!kls_egraph_refactor_wait_done(shared,
                                         start + panel_offset + local)) {
        return -1;
      }
    }
  } else {
    for (UF_long local = 0u; local < run_rows; ++local) {
      if (!kls_egraph_refactor_dependency_done_now(
            shared, start + panel_offset + local)) {
        return 0;
      }
    }
  }

  for (UF_long local = 0u; local < run_rows; ++local) {
    const UF_long row = dep_local + local;
    UF_long row_pos = 0u;
    (void)kls_algorithm5_payoff_state_value_position(
      state_item, row, state_stamp_value, state_stamp, state_pos, &row_pos);
    workspace[local] = state_work[row_pos];
    state_work[row_pos] = 0.0;
  }

  for (UF_long local = 0u; local < run_rows; ++local) {
    const UF_long panel_local = panel_offset + local;
    const double ujk = workspace[local];
    u_work[up + local] = ujk;
    if (u_supernode_values) {
      kls_egraph_record_u_supernode_value(
        shared, start + panel_local, current_global, ujk);
    }
    const double *dense_row = dense_panel + panel_local * width;
    for (UF_long target = panel_local + 1u; target < width; ++target) {
      const double update = ujk * dense_row[target];
      if (target < available_end) {
        workspace[target - panel_offset] -= update;
      } else {
        const UF_long row = local_start + target;
        UF_long row_pos = 0u;
        (void)kls_algorithm5_payoff_state_value_position(
          state_item, row, state_stamp_value, state_stamp, state_pos,
          &row_pos);
        state_work[row_pos] -= update;
      }
    }
    const UF_long row = row_base + local;
    const UF_long begin = solver->refactor_u_supernode_l_row_ptr[row];
    const UF_long end = solver->refactor_u_supernode_l_row_ptr[row + 1u];
    for (UF_long p = begin; p < end; ++p) {
      UF_long row_pos = 0u;
      (void)kls_algorithm5_payoff_state_value_position(
        state_item, trailing_cols[p], state_stamp_value, state_stamp,
        state_pos, &row_pos);
      state_work[row_pos] -= ujk * trailing_values[p];
    }
  }

  const UF_long trsv_entries = (run_rows * (run_rows - 1u)) / 2u;
  const UF_long dense_entries = run_rows * (width - available_end);
  kls_egraph_record_u_supernode_l_update(
    shared, run_rows, trsv_entries + dense_entries + trailing_entries);
  kls_egraph_mark_u_supernode_l_panel_used(solver, panel);
  *up_io = up + run_rows;
  return 1;
}

static int
kls_egraph_refactor_try_complete_algorithm5_payoff_direct_prefix_final_state_btf(
  kls_egraph_refactor_worker *worker,
  UF_long k1,
  UF_long current_global,
  UF_long current_local,
  UF_long block_size,
  UF_long ucol_len,
  const UF_long *ui,
  const int32_t *ui32,
  double *ux,
  double *udiag,
  UF_long **l_indices,
  double **l_values,
  const UF_long *llen,
  int wait_for_dependencies,
  int supernode_numeric_updates,
  int consumer_plan_group_l_values,
  int u_supernode_ragged_l_updates,
  int u_supernode_values) {
  if (worker == NULL || worker->shared == NULL || ux == NULL ||
      udiag == NULL || l_values == NULL || llen == NULL ||
      (ucol_len > 0u && ui == NULL && ui32 == NULL) ||
      current_local >= block_size || block_size == 0u) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || solver->symbolic == NULL ||
      !shared->supernode_algorithm5_payoff_direct_prefix_complete ||
      !shared->supernode_algorithm5_payoff_direct_prefix_final_state ||
      shared->check_pivots ||
      shared->algorithm5_payoff_workspace_values == NULL ||
      shared->algorithm5_payoff_current_flags == NULL ||
      current_global >= solver->n || k1 > current_global ||
      current_local != current_global - k1 ||
      solver->refactor_supernode_consumer_plan_col_ptr == NULL ||
      solver->refactor_supernode_consumer_plan_col_runs == NULL ||
      solver->refactor_supernode_consumer_plan_current == NULL ||
      solver->refactor_supernode_consumer_plan_dep == NULL ||
      solver->refactor_supernode_consumer_plan_panel_start == NULL ||
      solver->refactor_supernode_consumer_plan_panel_offset == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_group == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_current_pos == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_deps == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_prefix_rows == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_target_entries == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_currents == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_runs ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_selected == NULL ||
      solver->refactor_supernode_algorithm5_payoff_current_state_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_current_state_rows == NULL) {
    return 0;
  }

  const UF_long begin =
    solver->refactor_supernode_consumer_plan_col_ptr[current_global];
  const UF_long end =
    solver->refactor_supernode_consumer_plan_col_ptr[current_global + 1u];
  if (begin > end ||
      end > solver->refactor_supernode_consumer_plan_run_count) {
    return 0;
  }
  for (UF_long pos = begin; pos < end; ++pos) {
    const UF_long run = solver->refactor_supernode_consumer_plan_col_runs[pos];
    if (run >= solver->refactor_supernode_consumer_plan_run_count ||
        !solver->refactor_supernode_algorithm5_payoff_run_selected[run] ||
        solver->refactor_supernode_consumer_plan_current[run] !=
          current_global) {
      continue;
    }
    const UF_long group =
      solver->refactor_supernode_algorithm5_payoff_run_group[run];
    if (group == KLS_KLU_EMPTY ||
        group >= solver->refactor_supernode_algorithm5_payoff_group_count) {
      continue;
    }
    const UF_long current_slot =
      solver->refactor_supernode_algorithm5_payoff_run_current_pos[run];
    const UF_long current_begin =
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group];
    const UF_long current_end =
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group +
                                                                     1u];
    if (current_begin > current_end ||
        current_end >
          solver->refactor_supernode_algorithm5_payoff_group_current_total ||
        current_slot == KLS_KLU_EMPTY || current_slot < current_begin ||
        current_slot >= current_end ||
        current_slot >= shared->algorithm5_payoff_current_count ||
        solver->refactor_supernode_algorithm5_payoff_group_currents[
          current_slot] != current_global ||
        current_slot + 1u >
          solver->refactor_supernode_algorithm5_payoff_group_current_total) {
      continue;
    }
    const UF_long current_run_begin =
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
        current_slot];
    const UF_long current_run_end =
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
        current_slot + 1u];
    if (current_run_begin > current_run_end ||
        current_run_end >
          solver->refactor_supernode_algorithm5_payoff_group_ptr[
            solver->refactor_supernode_algorithm5_payoff_group_count] ||
        current_run_end - current_run_begin != 1u ||
        solver->refactor_supernode_algorithm5_payoff_group_current_runs[
          current_run_begin] != run) {
      continue;
    }

    const UF_long advance_deps =
      solver->refactor_supernode_algorithm5_payoff_run_advance_deps[run];
    const UF_long prefix_rows =
      solver->refactor_supernode_algorithm5_payoff_run_prefix_rows[run];
    if (advance_deps >= ucol_len || prefix_rows == 0u ||
        prefix_rows > ucol_len - advance_deps) {
      continue;
    }
    const UF_long prefix_end = advance_deps + prefix_rows;
    if (prefix_end > ucol_len) {
      continue;
    }
    const UF_long dep =
      solver->refactor_supernode_consumer_plan_dep[run];
    const UF_long panel_start =
      solver->refactor_supernode_consumer_plan_panel_start[run];
    const UF_long panel_offset =
      solver->refactor_supernode_consumer_plan_panel_offset[run];
    if (dep < k1 || dep >= current_global ||
        panel_start == KLS_KLU_EMPTY || panel_offset == KLS_KLU_EMPTY ||
        dep != panel_start + panel_offset) {
      continue;
    }
    const UF_long dep_local = dep - k1;
    if (dep_local >= current_local ||
        kls_algorithm5_payoff_u_index_at(ui, ui32, advance_deps) !=
          dep_local) {
      continue;
    }
    int stream_ok = 1;
    for (UF_long p = 0u; p < advance_deps; ++p) {
      if (kls_algorithm5_payoff_u_index_at(ui, ui32, p) >= current_local) {
        stream_ok = 0;
        break;
      }
    }
    for (UF_long local = 0u; local < prefix_rows; ++local) {
      if (kls_algorithm5_payoff_u_index_at(
            ui, ui32, advance_deps + local) != dep_local + local) {
        stream_ok = 0;
        break;
      }
    }
    if (!stream_ok) {
      continue;
    }

    const UF_long advance_u_begin =
      solver->refactor_supernode_algorithm5_payoff_run_advance_ptr[run];
    if (advance_u_begin == KLS_KLU_EMPTY ||
        advance_u_begin > shared->algorithm5_payoff_advance_u_size ||
        advance_deps >
          shared->algorithm5_payoff_advance_u_size - advance_u_begin ||
        (advance_deps > 0u &&
         shared->algorithm5_payoff_advance_u_values == NULL)) {
      continue;
    }

    const UF_long workspace_begin =
      solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr[
        current_slot];
    const UF_long workspace_end =
      solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr[
        current_slot + 1u];
    if (workspace_end < workspace_begin ||
        prefix_rows > workspace_end - workspace_begin ||
        workspace_begin > shared->algorithm5_payoff_workspace_size ||
        prefix_rows > shared->algorithm5_payoff_workspace_size -
                        workspace_begin) {
      continue;
    }
    const double *prepared_workspace =
      shared->algorithm5_payoff_workspace_values + workspace_begin;

    const UF_long state_begin =
      solver->refactor_supernode_algorithm5_payoff_current_state_ptr[
        current_slot];
    const UF_long state_end =
      solver->refactor_supernode_algorithm5_payoff_current_state_ptr[
        current_slot + 1u];
    if (state_end < state_begin ||
        state_end > shared->algorithm5_payoff_current_state_size ||
        state_end == state_begin ||
        shared->algorithm5_payoff_current_state_values == NULL) {
      continue;
    }
    const UF_long state_rows = state_end - state_begin;
    kls_algorithm5_payoff_group_prefix_item state_item;
    memset(&state_item, 0, sizeof(state_item));
    state_item.current = current_global;
    state_item.k1 = k1;
    state_item.block_size = block_size;
    state_item.state_rows = state_rows;
    state_item.state_row_idx =
      solver->refactor_supernode_algorithm5_payoff_current_state_rows +
      state_begin;
    state_item.state_values =
      shared->algorithm5_payoff_current_state_values + state_begin;

    unsigned char state =
      kls_algorithm5_payoff_current_state_load(
        shared->algorithm5_payoff_current_flags, current_slot);
    unsigned spin = 0u;
    while (state == KLS_ALGORITHM5_PAYOFF_CURRENT_PREPARING) {
      if (kls_egraph_refactor_should_stop(shared)) {
        return -1;
      }
      kls_egraph_pipeline_pause(&spin);
      state = kls_algorithm5_payoff_current_state_load(
        shared->algorithm5_payoff_current_flags, current_slot);
    }
    if (state != KLS_ALGORITHM5_PAYOFF_CURRENT_READY) {
      continue;
    }

    UF_long state_stamp_value = 0u;
    UF_long *state_stamp = NULL;
    UF_long *state_pos = NULL;
    if (!kls_algorithm5_payoff_prepare_state_row_lookup(
          worker, &state_item, &state_stamp_value, &state_stamp, &state_pos)) {
      continue;
    }

    UF_long tmp_pos = 0u;
    for (UF_long p = 0u; p < prefix_end; ++p) {
      const UF_long row = kls_algorithm5_payoff_u_index_at(ui, ui32, p);
      if (!kls_algorithm5_payoff_state_value_position(
            &state_item, row, state_stamp_value, state_stamp, state_pos,
            &tmp_pos)) {
        stream_ok = 0;
        break;
      }
    }
    if (!stream_ok) {
      continue;
    }
    if (!stream_ok ||
        !kls_algorithm5_payoff_state_value_position(
          &state_item, current_local, state_stamp_value, state_stamp,
          state_pos, &tmp_pos)) {
      continue;
    }
    const UF_long current_l_len = llen[current_local];
    const int32_t *current_rows32 =
      solver->refactor_l_indices32 != NULL
        ? solver->refactor_l_indices32[current_global] : NULL;
    UF_long *current_rows =
      current_rows32 == NULL && l_indices != NULL
        ? l_indices[current_global] : NULL;
    double *current_lx = l_values[current_global];
    if (current_l_len > 0u &&
        (current_lx == NULL ||
         (current_rows32 == NULL && current_rows == NULL))) {
      continue;
    }
    for (UF_long q = 0u; q < current_l_len; ++q) {
      const UF_long lrow =
        current_rows32 != NULL ? (UF_long)current_rows32[q] : current_rows[q];
      if (!kls_algorithm5_payoff_state_value_position(
            &state_item, lrow, state_stamp_value, state_stamp, state_pos,
            &tmp_pos)) {
        stream_ok = 0;
        break;
      }
    }
    if (!stream_ok) {
      continue;
    }

    if (!kls_algorithm5_payoff_current_state_try_claim_ready(
          shared->algorithm5_payoff_current_flags, current_slot)) {
      continue;
    }

    int live_state_dirty = 0;
    unsigned char *live_state_mark = NULL;
    double *live_state_old_values = NULL;
    const double *advance_u_values =
      shared->algorithm5_payoff_advance_u_values + advance_u_begin;
    UF_long resume_up =
      kls_algorithm5_payoff_current_up_load(
        shared->algorithm5_payoff_current_up, current_slot);
    if (resume_up < prefix_end) {
      resume_up = prefix_end;
    }
    if (resume_up > ucol_len) {
      goto restore_current_ready;
    }

    if (prefix_end == ucol_len) {
      UF_long pivot_pos = 0u;
      (void)kls_algorithm5_payoff_state_value_position(
        &state_item, current_local, state_stamp_value, state_stamp, state_pos,
        &pivot_pos);
      const double ukk = state_item.state_values[pivot_pos];
      if (ukk == 0.0) {
        goto restore_current_ready;
      }
      for (UF_long p = 0u; p < advance_deps; ++p) {
        const UF_long row = kls_algorithm5_payoff_u_index_at(ui, ui32, p);
        const double ujk = advance_u_values[p];
        ux[p] = ujk;
        if (u_supernode_values) {
          kls_egraph_record_u_supernode_value(
            shared, k1 + row, current_global, ujk);
        }
      }
      for (UF_long local = 0u; local < prefix_rows; ++local) {
        const UF_long up = advance_deps + local;
        const UF_long row = kls_algorithm5_payoff_u_index_at(ui, ui32, up);
        const double ujk = prepared_workspace[local];
        ux[up] = ujk;
        if (u_supernode_values) {
          kls_egraph_record_u_supernode_value(
            shared, k1 + row, current_global, ujk);
        }
      }
      udiag[current_global] = ukk;
      if (u_supernode_values) {
        kls_egraph_record_u_supernode_value(
          shared, current_global, current_global, ukk);
      }

      for (UF_long q = 0u; q < current_l_len; ++q) {
        const UF_long row =
          current_rows32 != NULL ? (UF_long)current_rows32[q]
                                 : current_rows[q];
        UF_long row_pos = 0u;
        (void)kls_algorithm5_payoff_state_value_position(
          &state_item, row, state_stamp_value, state_stamp, state_pos,
          &row_pos);
        current_lx[q] = state_item.state_values[row_pos] / ukk;
      }

      const UF_long target_entries =
        solver->refactor_supernode_algorithm5_payoff_run_target_entries[run];
      const UF_long trsv_entries = (prefix_rows * (prefix_rows - 1u)) / 2u;
      kls_egraph_record_algorithm5_payoff_prefix_prep(
        shared, prefix_rows, target_entries, 0u);
      kls_egraph_record_u_supernode_l_update(
        shared, prefix_rows, trsv_entries + target_entries);
      kls_egraph_record_algorithm5_payoff_current_state_seed(
        shared, ucol_len, 0u);

      if (u_supernode_ragged_l_updates) {
        kls_egraph_publish_u_supernode_l_column(shared, current_global);
      }
      if (consumer_plan_group_l_values) {
        kls_egraph_publish_consumer_plan_group_l_column(shared,
                                                        current_global);
      }
      if (supernode_numeric_updates) {
        kls_egraph_publish_supernode_panel_column(shared, current_global);
      }
      kls_algorithm5_payoff_current_up_store(
        shared->algorithm5_payoff_current_up, current_slot, 0u);
      kls_algorithm5_payoff_current_state_store(
        shared->algorithm5_payoff_current_flags, current_slot,
        KLS_ALGORITHM5_PAYOFF_CURRENT_EMPTY);
      return 1;
    }

    if (shared->supernode_algorithm5_payoff_direct_prefix_live_state) {
      if (state_rows > UF_long_max - ucol_len ||
          state_rows + ucol_len >
            (UF_long)(SIZE_MAX / sizeof(double))) {
        goto restore_current_ready;
      }
      double *work_values =
        kls_egraph_worker_supernode_workspace(worker, state_rows + ucol_len);
      live_state_mark = kls_egraph_worker_byte_workspace(worker, state_rows);
      if (work_values == NULL || live_state_mark == NULL) {
        goto restore_current_ready;
      }
      live_state_old_values = work_values;
      double *u_work = work_values + state_rows;
      memset(live_state_mark, 0, (size_t)state_rows);
      live_state_dirty = 1;

      for (UF_long p = 0u; p < advance_deps; ++p) {
        const UF_long row = kls_algorithm5_payoff_u_index_at(ui, ui32, p);
        UF_long pos_row = 0u;
        (void)kls_algorithm5_payoff_state_value_position(
          &state_item, row, state_stamp_value, state_stamp, state_pos,
          &pos_row);
        const double ujk = advance_u_values[p];
        u_work[p] = ujk;
        kls_algorithm5_payoff_take_live_state(
          live_state_mark, live_state_old_values, state_item.state_values,
          pos_row);
      }
      for (UF_long local = 0u; local < prefix_rows; ++local) {
        const UF_long up = advance_deps + local;
        const UF_long row = kls_algorithm5_payoff_u_index_at(ui, ui32, up);
        UF_long pos_row = 0u;
        (void)kls_algorithm5_payoff_state_value_position(
          &state_item, row, state_stamp_value, state_stamp, state_pos,
          &pos_row);
        const double ujk = prepared_workspace[local];
        u_work[up] = ujk;
        kls_algorithm5_payoff_take_live_state(
          live_state_mark, live_state_old_values, state_item.state_values,
          pos_row);
      }
      for (UF_long p = prefix_end; p < resume_up; ++p) {
        const UF_long dep_local2 =
          kls_algorithm5_payoff_u_index_at(ui, ui32, p);
        if (dep_local2 >= current_local || dep_local2 > UF_long_max - k1) {
          stream_ok = 0;
          break;
        }
        UF_long dep_pos = 0u;
        if (!kls_algorithm5_payoff_state_value_position(
              &state_item, dep_local2, state_stamp_value, state_stamp,
              state_pos, &dep_pos)) {
          stream_ok = 0;
          break;
        }
        (void)dep_pos;
        u_work[p] = ux[p];
      }
      if (!stream_ok) {
        goto restore_current_ready;
      }
      for (UF_long p = resume_up; p < ucol_len; ++p) {
        const UF_long dep_local2 =
          kls_algorithm5_payoff_u_index_at(ui, ui32, p);
        if (dep_local2 >= current_local || dep_local2 > UF_long_max - k1 ||
            k1 + dep_local2 >= solver->n) {
          stream_ok = 0;
          break;
        }
        const UF_long dep_global = k1 + dep_local2;
        UF_long dep_pos = 0u;
        if (!kls_algorithm5_payoff_state_value_position(
              &state_item, dep_local2, state_stamp_value, state_stamp,
              state_pos, &dep_pos)) {
          stream_ok = 0;
          break;
        }
        if (wait_for_dependencies) {
          if (!kls_egraph_refactor_wait_done(shared, dep_global)) {
            goto restore_current_ready_error;
          }
        } else if (!kls_egraph_refactor_dependency_done_now(shared,
                                                           dep_global)) {
          stream_ok = 0;
          break;
        }
        const double ujk =
          kls_algorithm5_payoff_take_live_state(
            live_state_mark, live_state_old_values, state_item.state_values,
            dep_pos);
        u_work[p] = ujk;
        if (ujk == 0.0) {
          continue;
        }
        const UF_long lcol_len = llen[dep_local2];
        const int32_t *rows32 =
          solver->refactor_l_indices32 != NULL
            ? solver->refactor_l_indices32[dep_global] : NULL;
        const UF_long *rows =
          rows32 == NULL && l_indices != NULL ? l_indices[dep_global] : NULL;
        const double *lx = l_values[dep_global];
        if (lcol_len > 0u &&
            (lx == NULL || (rows32 == NULL && rows == NULL))) {
          stream_ok = 0;
          break;
        }
        for (UF_long q = 0u; q < lcol_len; ++q) {
          const UF_long row = rows32 != NULL ? (UF_long)rows32[q] : rows[q];
          UF_long row_pos = 0u;
          if (!kls_algorithm5_payoff_state_value_position(
                &state_item, row, state_stamp_value, state_stamp, state_pos,
                &row_pos)) {
            stream_ok = 0;
            break;
          }
          kls_algorithm5_payoff_add_live_state(
            live_state_mark, live_state_old_values, state_item.state_values,
            row_pos, -ujk * lx[q]);
        }
        if (!stream_ok) {
          break;
        }
      }
      if (!stream_ok) {
        goto restore_current_ready;
      }

      UF_long pivot_pos = 0u;
      (void)kls_algorithm5_payoff_state_value_position(
        &state_item, current_local, state_stamp_value, state_stamp, state_pos,
        &pivot_pos);
      const double ukk = state_item.state_values[pivot_pos];
      if (ukk == 0.0) {
        goto restore_current_ready;
      }
      (void)kls_algorithm5_payoff_take_live_state(
        live_state_mark, live_state_old_values, state_item.state_values,
        pivot_pos);
      for (UF_long p = 0u; p < ucol_len; ++p) {
        const UF_long row = kls_algorithm5_payoff_u_index_at(ui, ui32, p);
        const double ujk = u_work[p];
        ux[p] = ujk;
        if (u_supernode_values) {
          kls_egraph_record_u_supernode_value(
            shared, k1 + row, current_global, ujk);
        }
      }
      udiag[current_global] = ukk;
      if (u_supernode_values) {
        kls_egraph_record_u_supernode_value(
          shared, current_global, current_global, ukk);
      }

      for (UF_long q = 0u; q < current_l_len; ++q) {
        const UF_long row =
          current_rows32 != NULL ? (UF_long)current_rows32[q]
                                 : current_rows[q];
        UF_long row_pos = 0u;
        (void)kls_algorithm5_payoff_state_value_position(
          &state_item, row, state_stamp_value, state_stamp, state_pos,
          &row_pos);
        current_lx[q] = state_item.state_values[row_pos] / ukk;
      }

      const UF_long target_entries =
        solver->refactor_supernode_algorithm5_payoff_run_target_entries[run];
      const UF_long trsv_entries = (prefix_rows * (prefix_rows - 1u)) / 2u;
      kls_egraph_record_algorithm5_payoff_prefix_prep(
        shared, prefix_rows, target_entries, 0u);
      kls_egraph_record_u_supernode_l_update(
        shared, prefix_rows, trsv_entries + target_entries);
      kls_egraph_record_algorithm5_payoff_current_state_seed(
        shared, ucol_len, 0u);

      if (u_supernode_ragged_l_updates) {
        kls_egraph_publish_u_supernode_l_column(shared, current_global);
      }
      if (consumer_plan_group_l_values) {
        kls_egraph_publish_consumer_plan_group_l_column(shared,
                                                        current_global);
      }
      if (supernode_numeric_updates) {
        kls_egraph_publish_supernode_panel_column(shared, current_global);
      }
      kls_algorithm5_payoff_current_up_store(
        shared->algorithm5_payoff_current_up, current_slot, 0u);
      kls_algorithm5_payoff_current_state_store(
        shared->algorithm5_payoff_current_flags, current_slot,
        KLS_ALGORITHM5_PAYOFF_CURRENT_EMPTY);
      return 1;
    }

    if (!shared->supernode_algorithm5_payoff_direct_prefix_sparse_delta) {
      if (state_rows > UF_long_max - ucol_len ||
          state_rows + ucol_len >
            (UF_long)(SIZE_MAX / sizeof(double))) {
        goto restore_current_ready;
      }
      double *work_values =
        (double *)kls_egraph_worker_object_workspace(
          worker, state_rows + ucol_len, sizeof(*work_values));
      if (work_values == NULL) {
        goto restore_current_ready;
      }
      double *state_work = work_values;
      double *u_work = work_values + state_rows;
      memcpy(state_work, state_item.state_values,
             (size_t)state_rows * sizeof(*state_work));

      for (UF_long p = 0u; p < advance_deps; ++p) {
        const UF_long row = kls_algorithm5_payoff_u_index_at(ui, ui32, p);
        UF_long pos_row = 0u;
        (void)kls_algorithm5_payoff_state_value_position(
          &state_item, row, state_stamp_value, state_stamp, state_pos,
          &pos_row);
        const double ujk = advance_u_values[p];
        u_work[p] = ujk;
        state_work[pos_row] = 0.0;
      }
      for (UF_long local = 0u; local < prefix_rows; ++local) {
        const UF_long up = advance_deps + local;
        const UF_long row = kls_algorithm5_payoff_u_index_at(ui, ui32, up);
        UF_long pos_row = 0u;
        (void)kls_algorithm5_payoff_state_value_position(
          &state_item, row, state_stamp_value, state_stamp, state_pos,
          &pos_row);
        const double ujk = prepared_workspace[local];
        u_work[up] = ujk;
        state_work[pos_row] = 0.0;
      }
      for (UF_long p = prefix_end; p < resume_up; ++p) {
        const UF_long dep_local2 =
          kls_algorithm5_payoff_u_index_at(ui, ui32, p);
        if (dep_local2 >= current_local || dep_local2 > UF_long_max - k1) {
          stream_ok = 0;
          break;
        }
        UF_long dep_pos = 0u;
        if (!kls_algorithm5_payoff_state_value_position(
              &state_item, dep_local2, state_stamp_value, state_stamp,
              state_pos, &dep_pos)) {
          stream_ok = 0;
          break;
        }
        u_work[p] = ux[p];
        state_work[dep_pos] = 0.0;
      }
      if (!stream_ok) {
        goto restore_current_ready;
      }
      UF_long p = resume_up;
      while (p < ucol_len) {
        if (u_supernode_ragged_l_updates &&
            shared->supernode_algorithm5_payoff_direct_prefix_state_ragged_suffix) {
          const int ragged_status =
            kls_egraph_refactor_try_algorithm5_payoff_state_ragged_l_suffix_run(
              worker, &state_item, k1, current_global, current_local, &p,
              ucol_len, ui, ui32, u_work, state_work, state_stamp_value,
              state_stamp, state_pos, wait_for_dependencies,
              u_supernode_values);
          if (ragged_status < 0) {
            goto restore_current_ready_error;
          }
          if (ragged_status > 0) {
            continue;
          }
        }
        const UF_long dep_local2 =
          kls_algorithm5_payoff_u_index_at(ui, ui32, p);
        if (dep_local2 >= current_local || dep_local2 > UF_long_max - k1 ||
            k1 + dep_local2 >= solver->n) {
          stream_ok = 0;
          break;
        }
        const UF_long dep_global = k1 + dep_local2;
        UF_long dep_pos = 0u;
        if (!kls_algorithm5_payoff_state_value_position(
              &state_item, dep_local2, state_stamp_value, state_stamp,
              state_pos, &dep_pos)) {
          stream_ok = 0;
          break;
        }
        if (wait_for_dependencies) {
          if (!kls_egraph_refactor_wait_done(shared, dep_global)) {
            goto restore_current_ready_error;
          }
        } else if (!kls_egraph_refactor_dependency_done_now(shared,
                                                           dep_global)) {
          stream_ok = 0;
          break;
        }
        const double ujk = state_work[dep_pos];
        state_work[dep_pos] = 0.0;
        u_work[p] = ujk;
        if (ujk == 0.0) {
          p++;
          continue;
        }
        const UF_long lcol_len = llen[dep_local2];
        const int32_t *rows32 =
          solver->refactor_l_indices32 != NULL
            ? solver->refactor_l_indices32[dep_global] : NULL;
        const UF_long *rows =
          rows32 == NULL && l_indices != NULL ? l_indices[dep_global] : NULL;
        const double *lx = l_values[dep_global];
        if (lcol_len > 0u &&
            (lx == NULL || (rows32 == NULL && rows == NULL))) {
          stream_ok = 0;
          break;
        }
        for (UF_long q = 0u; q < lcol_len; ++q) {
          const UF_long row = rows32 != NULL ? (UF_long)rows32[q] : rows[q];
          UF_long row_pos = 0u;
          if (!kls_algorithm5_payoff_state_value_position(
                &state_item, row, state_stamp_value, state_stamp, state_pos,
                &row_pos)) {
            stream_ok = 0;
            break;
          }
          state_work[row_pos] -= ujk * lx[q];
        }
        if (!stream_ok) {
          break;
        }
        p++;
      }
      if (!stream_ok) {
        goto restore_current_ready;
      }

      UF_long pivot_pos = 0u;
      (void)kls_algorithm5_payoff_state_value_position(
        &state_item, current_local, state_stamp_value, state_stamp, state_pos,
        &pivot_pos);
      const double ukk = state_work[pivot_pos];
      state_work[pivot_pos] = 0.0;
      if (ukk == 0.0) {
        goto restore_current_ready;
      }
      for (UF_long p = 0u; p < ucol_len; ++p) {
        const UF_long row = kls_algorithm5_payoff_u_index_at(ui, ui32, p);
        const double ujk = u_work[p];
        ux[p] = ujk;
        if (u_supernode_values) {
          kls_egraph_record_u_supernode_value(
            shared, k1 + row, current_global, ujk);
        }
      }
      udiag[current_global] = ukk;
      if (u_supernode_values) {
        kls_egraph_record_u_supernode_value(
          shared, current_global, current_global, ukk);
      }

      for (UF_long q = 0u; q < current_l_len; ++q) {
        const UF_long row =
          current_rows32 != NULL ? (UF_long)current_rows32[q]
                                 : current_rows[q];
        UF_long row_pos = 0u;
        (void)kls_algorithm5_payoff_state_value_position(
          &state_item, row, state_stamp_value, state_stamp, state_pos,
          &row_pos);
        current_lx[q] = state_work[row_pos] / ukk;
      }

      const UF_long target_entries =
        solver->refactor_supernode_algorithm5_payoff_run_target_entries[run];
      const UF_long trsv_entries = (prefix_rows * (prefix_rows - 1u)) / 2u;
      kls_egraph_record_algorithm5_payoff_prefix_prep(
        shared, prefix_rows, target_entries, 0u);
      kls_egraph_record_u_supernode_l_update(
        shared, prefix_rows, trsv_entries + target_entries);
      kls_egraph_record_algorithm5_payoff_current_state_seed(
        shared, ucol_len, state_rows);

      if (u_supernode_ragged_l_updates) {
        kls_egraph_publish_u_supernode_l_column(shared, current_global);
      }
      if (consumer_plan_group_l_values) {
        kls_egraph_publish_consumer_plan_group_l_column(shared,
                                                        current_global);
      }
      if (supernode_numeric_updates) {
        kls_egraph_publish_supernode_panel_column(shared, current_global);
      }
      kls_algorithm5_payoff_current_up_store(
        shared->algorithm5_payoff_current_up, current_slot, 0u);
      kls_algorithm5_payoff_current_state_store(
        shared->algorithm5_payoff_current_flags, current_slot,
        KLS_ALGORITHM5_PAYOFF_CURRENT_EMPTY);
      return 1;
    }

    if (state_rows > UF_long_max - ucol_len ||
        state_rows + ucol_len >
          (UF_long)(SIZE_MAX / sizeof(double))) {
      goto restore_current_ready;
    }
    double *work_values =
      kls_egraph_worker_supernode_workspace(worker, state_rows + ucol_len);
    unsigned char *delta_mark =
      kls_egraph_worker_byte_workspace(worker, state_rows);
    if (work_values == NULL) {
      goto restore_current_ready;
    }
    if (delta_mark == NULL) {
      goto restore_current_ready;
    }
    double *delta_values = work_values;
    double *u_work = work_values + state_rows;
    memset(delta_mark, 0, (size_t)state_rows);

    for (UF_long p = 0u; p < advance_deps; ++p) {
      const double ujk = advance_u_values[p];
      u_work[p] = ujk;
    }
    for (UF_long local = 0u; local < prefix_rows; ++local) {
      const UF_long up = advance_deps + local;
      const double ujk = prepared_workspace[local];
      u_work[up] = ujk;
    }
    for (UF_long p = prefix_end; p < resume_up; ++p) {
      const UF_long dep_local2 =
        kls_algorithm5_payoff_u_index_at(ui, ui32, p);
      if (dep_local2 >= current_local || dep_local2 > UF_long_max - k1) {
        stream_ok = 0;
        break;
      }
      UF_long dep_pos = 0u;
      if (!kls_algorithm5_payoff_state_value_position(
            &state_item, dep_local2, state_stamp_value, state_stamp,
            state_pos, &dep_pos)) {
        stream_ok = 0;
        break;
      }
      (void)dep_pos;
      u_work[p] = ux[p];
    }
    if (!stream_ok) {
      goto restore_current_ready;
    }
    for (UF_long p = resume_up; p < ucol_len; ++p) {
      const UF_long dep_local2 =
        kls_algorithm5_payoff_u_index_at(ui, ui32, p);
      if (dep_local2 >= current_local || dep_local2 > UF_long_max - k1 ||
          k1 + dep_local2 >= solver->n) {
        stream_ok = 0;
        break;
      }
      const UF_long dep_global = k1 + dep_local2;
      UF_long dep_pos = 0u;
      if (!kls_algorithm5_payoff_state_value_position(
            &state_item, dep_local2, state_stamp_value, state_stamp,
            state_pos, &dep_pos)) {
        stream_ok = 0;
        break;
      }
      if (wait_for_dependencies) {
        if (!kls_egraph_refactor_wait_done(shared, dep_global)) {
          goto restore_current_ready_error;
        }
      } else if (!kls_egraph_refactor_dependency_done_now(shared,
                                                         dep_global)) {
        stream_ok = 0;
        break;
      }
      const double ujk = kls_algorithm5_payoff_state_with_delta(
        &state_item, delta_mark, delta_values, dep_pos);
      u_work[p] = ujk;
      if (ujk == 0.0) {
        continue;
      }
      const UF_long lcol_len = llen[dep_local2];
      const int32_t *rows32 =
        solver->refactor_l_indices32 != NULL
          ? solver->refactor_l_indices32[dep_global] : NULL;
      const UF_long *rows =
        rows32 == NULL && l_indices != NULL ? l_indices[dep_global] : NULL;
      const double *lx = l_values[dep_global];
      if (lcol_len > 0u &&
          (lx == NULL || (rows32 == NULL && rows == NULL))) {
        stream_ok = 0;
        break;
      }
      for (UF_long q = 0u; q < lcol_len; ++q) {
        const UF_long row = rows32 != NULL ? (UF_long)rows32[q] : rows[q];
        UF_long row_pos = 0u;
        if (!kls_algorithm5_payoff_state_value_position(
              &state_item, row, state_stamp_value, state_stamp, state_pos,
              &row_pos)) {
          stream_ok = 0;
          break;
        }
        kls_algorithm5_payoff_add_state_delta(
          delta_mark, delta_values, row_pos, -ujk * lx[q]);
      }
      if (!stream_ok) {
        break;
      }
    }
    if (!stream_ok) {
      goto restore_current_ready;
    }

    UF_long pivot_pos = 0u;
    (void)kls_algorithm5_payoff_state_value_position(
      &state_item, current_local, state_stamp_value, state_stamp, state_pos,
      &pivot_pos);
    const double ukk = kls_algorithm5_payoff_state_with_delta(
      &state_item, delta_mark, delta_values, pivot_pos);
    if (ukk == 0.0) {
      goto restore_current_ready;
    }
    for (UF_long p = 0u; p < ucol_len; ++p) {
      const UF_long row = kls_algorithm5_payoff_u_index_at(ui, ui32, p);
      const double ujk = u_work[p];
      ux[p] = ujk;
      if (u_supernode_values) {
        kls_egraph_record_u_supernode_value(
          shared, k1 + row, current_global, ujk);
      }
    }
    udiag[current_global] = ukk;
    if (u_supernode_values) {
      kls_egraph_record_u_supernode_value(
        shared, current_global, current_global, ukk);
    }

    for (UF_long q = 0u; q < current_l_len; ++q) {
      const UF_long row =
        current_rows32 != NULL ? (UF_long)current_rows32[q] : current_rows[q];
      UF_long row_pos = 0u;
      (void)kls_algorithm5_payoff_state_value_position(
        &state_item, row, state_stamp_value, state_stamp, state_pos, &row_pos);
      current_lx[q] = kls_algorithm5_payoff_state_with_delta(
                        &state_item, delta_mark, delta_values, row_pos) / ukk;
    }

    const UF_long target_entries =
      solver->refactor_supernode_algorithm5_payoff_run_target_entries[run];
    const UF_long trsv_entries = (prefix_rows * (prefix_rows - 1u)) / 2u;
    kls_egraph_record_algorithm5_payoff_prefix_prep(
      shared, prefix_rows, target_entries, 0u);
    kls_egraph_record_u_supernode_l_update(
      shared, prefix_rows, trsv_entries + target_entries);
    kls_egraph_record_algorithm5_payoff_current_state_seed(
      shared, ucol_len, 0u);

    if (u_supernode_ragged_l_updates) {
      kls_egraph_publish_u_supernode_l_column(shared, current_global);
    }
    if (consumer_plan_group_l_values) {
      kls_egraph_publish_consumer_plan_group_l_column(shared, current_global);
    }
    if (supernode_numeric_updates) {
      kls_egraph_publish_supernode_panel_column(shared, current_global);
    }
    kls_algorithm5_payoff_current_up_store(
      shared->algorithm5_payoff_current_up, current_slot, 0u);
    kls_algorithm5_payoff_current_state_store(
      shared->algorithm5_payoff_current_flags, current_slot,
      KLS_ALGORITHM5_PAYOFF_CURRENT_EMPTY);
    return 1;
restore_current_ready_error:
    if (live_state_dirty) {
      kls_algorithm5_payoff_restore_live_state(
        state_item.state_values, live_state_mark, live_state_old_values,
        state_rows);
    }
    kls_algorithm5_payoff_current_state_store(
      shared->algorithm5_payoff_current_flags, current_slot,
      KLS_ALGORITHM5_PAYOFF_CURRENT_READY);
    return -1;
restore_current_ready:
    if (live_state_dirty) {
      kls_algorithm5_payoff_restore_live_state(
        state_item.state_values, live_state_mark, live_state_old_values,
        state_rows);
    }
    kls_algorithm5_payoff_current_state_store(
      shared->algorithm5_payoff_current_flags, current_slot,
      KLS_ALGORITHM5_PAYOFF_CURRENT_READY);
    continue;
  }
  return 0;
}

static int kls_egraph_refactor_try_cached_supernode_dependency_run(
  kls_egraph_refactor_worker *worker,
  UF_long k1,
  UF_long current_global,
  UF_long current_local,
  UF_long *up_io,
  UF_long ucol_len,
  const UF_long *ui,
  double *ux,
  double *x,
  int wait_for_dependencies) {
  if (worker == NULL || worker->shared == NULL || up_io == NULL ||
      ui == NULL || ux == NULL || x == NULL || *up_io >= ucol_len) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || !shared->supernode_numeric_updates ||
      solver->refactor_supernode_panel_col_id == NULL ||
      solver->refactor_supernode_panel_start == NULL ||
      solver->refactor_supernode_panel_local_start == NULL ||
      solver->refactor_supernode_panel_width == NULL ||
      solver->refactor_supernode_panel_dense_begin == NULL ||
      solver->refactor_supernode_panel_trailing_begin == NULL ||
      solver->refactor_supernode_panel_trailing_value_begin == NULL ||
      solver->refactor_supernode_panel_trailing_len == NULL ||
      solver->refactor_supernode_panel_dense_values == NULL) {
    return 0;
  }

  const UF_long up = *up_io;
  const UF_long dep_local = ui[up];
  if (dep_local >= current_local || k1 > current_global) {
    return 0;
  }
  const UF_long dep_global = k1 + dep_local;
  if (dep_global >= current_global || dep_global >= solver->n) {
    return 0;
  }
  UF_long planned_run_rows = 0u;
  UF_long planned_panel_start = KLS_KLU_EMPTY;
  UF_long planned_panel_offset = 0u;
  int planned_run = 0;
  if (shared->supernode_consumer_plan_exec) {
    kls_egraph_record_consumer_plan_attempt(shared);
    planned_run = kls_egraph_worker_find_consumer_plan_run(
      worker, current_global, dep_global, up, NULL,
      &planned_run_rows,
      &planned_panel_start, &planned_panel_offset);
    if (planned_run) {
      kls_egraph_record_consumer_plan_hit(shared);
    } else if (shared->supernode_consumer_plan_only) {
      return 0;
    }
  }
  kls_egraph_record_cached_probe_attempt(shared);
  UF_long panel = KLS_KLU_EMPTY;
  if (planned_run) {
    if (solver->refactor_supernode_panel_start_id == NULL ||
        planned_panel_start >= solver->n ||
        planned_panel_start > dep_global ||
        planned_panel_offset != dep_global - planned_panel_start) {
      kls_egraph_record_cached_probe_shape_reject(
        shared, planned_run_rows);
      return 0;
    }
    panel = solver->refactor_supernode_panel_start_id[planned_panel_start];
  } else {
    panel = solver->refactor_supernode_panel_col_id[dep_global];
  }
  if (panel == KLS_KLU_EMPTY ||
      panel >= solver->refactor_supernode_panel_count) {
    kls_egraph_record_cached_probe_shape_reject(
      shared, planned_run ? planned_run_rows : 0u);
    return 0;
  }
  kls_egraph_record_cached_probe_panel_hit(shared);
  const UF_long start = solver->refactor_supernode_panel_start[panel];
  const UF_long local_start =
    solver->refactor_supernode_panel_local_start[panel];
  const UF_long width = solver->refactor_supernode_panel_width[panel];
  const UF_long trailing_len =
    solver->refactor_supernode_panel_trailing_len[panel];
  if (width <= 1u || start > dep_global || dep_global >= start + width ||
      start > solver->n || width > solver->n - start) {
    kls_egraph_record_cached_probe_shape_reject(
      shared, planned_run ? planned_run_rows : width);
    return 0;
  }
  const UF_long panel_offset = dep_global - start;
  if (planned_run &&
      (start != planned_panel_start ||
       panel_offset != planned_panel_offset)) {
    kls_egraph_record_cached_probe_shape_reject(
      shared, planned_run_rows);
    return 0;
  }
  if (local_start > dep_local ||
      dep_local - local_start != panel_offset) {
    kls_egraph_record_cached_probe_shape_reject(
      shared, planned_run ? planned_run_rows : width - panel_offset);
    return 0;
  }
  UF_long available_end = width;
  if (start + width > current_global) {
    available_end = current_global - start;
  }
  if (available_end > width) {
    available_end = width;
  }
  if (planned_run) {
    if (planned_run_rows <= 1u ||
        planned_run_rows > width - panel_offset) {
      kls_egraph_record_cached_probe_shape_reject(
        shared, planned_run_rows);
      return 0;
    }
    available_end = panel_offset + planned_run_rows;
    if (available_end > width || start + available_end > current_global) {
      kls_egraph_record_cached_probe_shape_reject(
        shared, planned_run_rows);
      return 0;
    }
  }
  if (wait_for_dependencies) {
    available_end =
      kls_egraph_subtree_split_available_end(shared, panel_offset,
                                             available_end);
  }
  if (available_end <= panel_offset + 1u) {
    kls_egraph_record_cached_probe_shape_reject(
      shared, planned_run ? planned_run_rows : 0u);
    return 0;
  }
  const UF_long run_rows = available_end - panel_offset;
  if (run_rows > ucol_len - up ||
      run_rows > current_local - dep_local) {
    kls_egraph_record_cached_probe_shape_reject(shared, run_rows);
    return 0;
  }
  for (UF_long local = 0; local < run_rows; ++local) {
    if (ui[up + local] != dep_local + local) {
      kls_egraph_record_cached_probe_stream_reject(shared, run_rows);
      return 0;
    }
  }
  kls_egraph_record_cached_probe_contiguous(shared);
  const UF_long dense_scatter_len = width - available_end;
  if (!kls_egraph_cached_supernode_update_allows(
        run_rows, dense_scatter_len, trailing_len)) {
    kls_egraph_record_cached_probe_work_reject(shared, run_rows);
    return 0;
  }
  kls_egraph_record_cached_probe_allowed(shared, run_rows);
  const UF_long max_workspace_entries =
    (UF_long)(SIZE_MAX / sizeof(double));
  if (run_rows > max_workspace_entries ||
      trailing_len > max_workspace_entries - run_rows) {
    kls_egraph_record_cached_probe_workspace_reject(shared, run_rows);
    return 0;
  }
  double *workspace =
    kls_egraph_worker_supernode_workspace(worker, run_rows + trailing_len);
  if (workspace == NULL) {
    kls_egraph_record_cached_probe_workspace_reject(shared, run_rows);
    return 0;
  }
  double *trailing_workspace =
    trailing_len > 0u ? workspace + run_rows : NULL;
  if (trailing_len > 0u) {
    memset(trailing_workspace, 0,
           (size_t)trailing_len * sizeof(*trailing_workspace));
  }

  if (wait_for_dependencies) {
    for (UF_long local = 0; local < run_rows; ++local) {
      if (!kls_egraph_refactor_wait_done(
            shared, start + panel_offset + local)) {
        return -1;
      }
    }
  }

  for (UF_long local = 0; local < run_rows; ++local) {
    const UF_long row = dep_local + local;
    workspace[local] = x[row];
    x[row] = 0.0;
  }

  const double *dense_panel =
    solver->refactor_supernode_panel_dense_values +
    solver->refactor_supernode_panel_dense_begin[panel];
  const double *trailing_values =
    trailing_len > 0u
      ? solver->refactor_supernode_panel_trailing_values +
          solver->refactor_supernode_panel_trailing_value_begin[panel]
      : NULL;
  if (trailing_len > 0u && trailing_values == NULL) {
    kls_egraph_record_cached_probe_shape_reject(shared, run_rows);
    return 0;
  }

  int used_cblas = 0;
#ifdef KLS_HAVE_CBLAS
  used_cblas = kls_egraph_apply_cached_supernode_cblas(
    shared, run_rows, panel_offset, available_end, width, local_start,
    trailing_len, dense_panel, trailing_values, workspace,
    trailing_workspace, x, ux + up);
#endif
  int used_blocked = 0;
  if (!used_cblas) {
    used_blocked = kls_egraph_apply_cached_supernode_blocked(
      shared, run_rows, panel_offset, available_end, width, local_start,
      trailing_len, dense_panel, trailing_values, workspace,
      trailing_workspace, x, ux + up);
  }
  if (!used_cblas && !used_blocked) {
    for (UF_long local = 0; local < run_rows; ++local) {
      const UF_long panel_local = panel_offset + local;
      const double ujk = workspace[local];
      ux[up + local] = ujk;
      const double *dense_row = dense_panel + panel_local * width;
      for (UF_long target = panel_local + 1u; target < width; ++target) {
        if (target < available_end) {
          workspace[target - panel_offset] -= ujk * dense_row[target];
        } else {
          x[local_start + target] -= ujk * dense_row[target];
        }
      }
      if (trailing_len > 0u) {
        const double *row_values =
          trailing_values + panel_local * trailing_len;
        for (UF_long offset = 0; offset < trailing_len; ++offset) {
          trailing_workspace[offset] += ujk * row_values[offset];
        }
      }
    }
  }
  if (shared->u_supernode_values) {
    for (UF_long local = 0; local < run_rows; ++local) {
      kls_egraph_record_u_supernode_value(
        shared, start + panel_offset + local, current_global,
        workspace[local]);
    }
  }

  if (trailing_len > 0u) {
    const UF_long *trailing_rows =
      solver->refactor_supernode_panel_trailing_rows +
      solver->refactor_supernode_panel_trailing_begin[panel];
    for (UF_long offset = 0; offset < trailing_len; ++offset) {
      x[trailing_rows[offset]] -= trailing_workspace[offset];
    }
  }

  const UF_long trsv_entries = (run_rows * (run_rows - 1u)) / 2u;
  const UF_long dense_scatter_entries = run_rows * (width - available_end);
  const UF_long trailing_entries = run_rows * trailing_len;
  const UF_long update_entries =
    trsv_entries + dense_scatter_entries + trailing_entries;
  kls_egraph_record_supernode_update(shared, run_rows, update_entries);
  if (planned_run) {
    kls_egraph_record_consumer_plan_applied(
      shared, run_rows, update_entries);
  }
  kls_egraph_record_cached_probe_applied(shared, run_rows);
  *up_io = up + run_rows;
  return 1;
}

static int kls_egraph_refactor_try_supernode_dependency_run(
  kls_egraph_refactor_worker *worker,
  UF_long k1,
  UF_long current_global,
  UF_long current_local,
  UF_long *up_io,
  UF_long ucol_len,
  const UF_long *ui,
  double *ux,
  UF_long **l_indices,
  double **l_values,
  const UF_long *llen,
  double *x,
  int wait_for_dependencies) {
  if (worker == NULL || worker->shared == NULL || up_io == NULL ||
      ui == NULL || ux == NULL || l_indices == NULL || l_values == NULL ||
      llen == NULL || x == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || !shared->supernode_numeric_updates ||
      solver->refactor_supernode_pipeline_end == NULL ||
      *up_io >= ucol_len) {
    return 0;
  }

  const UF_long up = *up_io;
  const UF_long dep_local = ui[up];
  if (dep_local >= current_local || k1 > current_global) {
    return 0;
  }
  const UF_long dep_global = k1 + dep_local;
  if (dep_global >= current_global || dep_global >= solver->n) {
    return 0;
  }
  int try_cached = 0;
  if (solver->refactor_supernode_panel_col_id != NULL) {
    const UF_long panel = solver->refactor_supernode_panel_col_id[dep_global];
    try_cached = panel != KLS_KLU_EMPTY &&
                 panel < solver->refactor_supernode_panel_count &&
                 solver->refactor_supernode_panel_width != NULL &&
                 solver->refactor_supernode_panel_width[panel] > 1u;
  }
  if (try_cached) {
    const int cached_status =
      kls_egraph_refactor_try_cached_supernode_dependency_run(
        worker, k1, current_global, current_local, up_io, ucol_len,
        ui, ux, x, wait_for_dependencies);
    if (cached_status != 0) {
      return cached_status;
    }
  }
  if (shared->supernode_cached_updates_only) {
    return 0;
  }
  if (solver->refactor_supernode_panel_start_id != NULL) {
    const UF_long full_end =
      solver->refactor_supernode_pipeline_end[dep_global];
    if (full_end > dep_global + 1u && full_end <= current_global) {
      return 0;
    }
  }
  UF_long candidate_end = solver->refactor_supernode_pipeline_end[dep_global];
  if (candidate_end > current_global) {
    candidate_end = current_global;
  }
  if (candidate_end <= dep_global + 1u) {
    return 0;
  }
  const UF_long run_rows = candidate_end - dep_global;
  if (run_rows > KLS_EGRAPH_SCALAR_SUPERNODE_UPDATE_MAX_WIDTH ||
      run_rows > ucol_len - up ||
      run_rows > current_local - dep_local) {
    return 0;
  }
  for (UF_long local = 0; local < run_rows; ++local) {
    if (ui[up + local] != dep_local + local) {
      return 0;
    }
  }

  const UF_long skip_begin = dep_local;
  const UF_long skip_end = dep_local + run_rows;
  const UF_long *first_rows = l_indices[dep_global];
  const UF_long first_len = llen[dep_global];
  UF_long trailing_len = 0u;
  for (UF_long p = 0; p < first_len; ++p) {
    const UF_long row = first_rows[p];
    if (row < skip_begin || row >= skip_end) {
      trailing_len++;
    }
  }
  if (trailing_len == 0u) {
    return 0;
  }

  const UF_long max_workspace_entries =
    (UF_long)(SIZE_MAX / sizeof(double));
  if (run_rows > max_workspace_entries / run_rows) {
    return 0;
  }
  const UF_long dense_entries = run_rows * run_rows;
  if (run_rows > max_workspace_entries - dense_entries) {
    return 0;
  }
  UF_long workspace_entries = run_rows + dense_entries;
  double *workspace =
    kls_egraph_worker_supernode_workspace(worker, workspace_entries);
  if (workspace == NULL) {
    return 0;
  }
  double *dense_panel = workspace + run_rows;
  memset(dense_panel, 0, (size_t)dense_entries * sizeof(*dense_panel));

  int common_trailing = 1;
  for (UF_long local = 0; local < run_rows; ++local) {
    const UF_long dep_col = dep_global + local;
    const UF_long *rows = l_indices[dep_col];
    const double *values = l_values[dep_col];
    const UF_long length = llen[dep_col];
    const UF_long expected_internal = run_rows - local - 1u;
    UF_long internal_seen = 0u;
    UF_long trailing_seen = 0u;
    UF_long first_pos = 0u;
    for (UF_long p = 0; p < length; ++p) {
      const UF_long row = rows[p];
      if (row >= skip_begin && row < skip_end) {
        const UF_long target = row - skip_begin;
        if (target <= local || target >= run_rows) {
          return 0;
        }
        dense_panel[local * run_rows + target] = values[p];
        internal_seen++;
      } else if (common_trailing) {
        if (local > 0u) {
          while (first_pos < first_len &&
                 first_rows[first_pos] >= skip_begin &&
                 first_rows[first_pos] < skip_end) {
            first_pos++;
          }
          if (first_pos >= first_len || first_rows[first_pos] != row) {
            common_trailing = 0;
          } else {
            first_pos++;
          }
        }
        trailing_seen++;
      }
    }
    if (internal_seen != expected_internal) {
      return 0;
    }
    if (common_trailing && local > 0u) {
      while (first_pos < first_len) {
        const UF_long row = first_rows[first_pos++];
        if (row < skip_begin || row >= skip_end) {
          common_trailing = 0;
          break;
        }
      }
      if (trailing_seen != trailing_len) {
        common_trailing = 0;
      }
    }
  }

  double *trailing_workspace = NULL;
  if (common_trailing && trailing_len > 0u) {
    if (trailing_len <= max_workspace_entries - workspace_entries) {
      workspace_entries += trailing_len;
      double *grown_workspace =
        kls_egraph_worker_supernode_workspace(worker, workspace_entries);
      if (grown_workspace != NULL) {
        workspace = grown_workspace;
        dense_panel = workspace + run_rows;
        trailing_workspace = dense_panel + dense_entries;
        memset(trailing_workspace, 0,
               (size_t)trailing_len * sizeof(*trailing_workspace));
      } else {
        common_trailing = 0;
      }
    } else {
      common_trailing = 0;
    }
  }
  if (!common_trailing || trailing_len == 0u || trailing_workspace == NULL) {
    return 0;
  }

  if (wait_for_dependencies) {
    for (UF_long local = 0; local < run_rows; ++local) {
      if (!kls_egraph_refactor_wait_done(shared, dep_global + local)) {
        return -1;
      }
    }
  }

  for (UF_long local = 0; local < run_rows; ++local) {
    const UF_long row = dep_local + local;
    workspace[local] = x[row];
    x[row] = 0.0;
  }

  UF_long trailing_entries = 0u;
  for (UF_long local = 0; local < run_rows; ++local) {
    const UF_long dep_col = dep_global + local;
    const UF_long *rows = l_indices[dep_col];
    const double *values = l_values[dep_col];
    const UF_long length = llen[dep_col];
    const double ujk = workspace[local];
    ux[up + local] = ujk;
    const double *dense_row = dense_panel + local * run_rows;
    for (UF_long target = local + 1u; target < run_rows; ++target) {
      workspace[target] -= ujk * dense_row[target];
    }
    if (common_trailing && trailing_workspace != NULL) {
      UF_long offset = 0u;
      for (UF_long p = 0; p < length; ++p) {
        const UF_long row = rows[p];
        if (row >= skip_begin && row < skip_end) {
          continue;
        }
        if (offset >= trailing_len) {
          kls_egraph_refactor_record_invalid(shared);
          return -1;
        }
        trailing_workspace[offset++] += ujk * values[p];
      }
      if (offset != trailing_len) {
        kls_egraph_refactor_record_invalid(shared);
        return -1;
      }
    } else {
      kls_scatter_subtract_skip_range(x, rows, values, length, ujk,
                                      skip_begin, skip_end,
                                      &trailing_entries);
    }
  }

  if (common_trailing && trailing_workspace != NULL) {
    UF_long offset = 0u;
    for (UF_long p = 0; p < first_len; ++p) {
      const UF_long row = first_rows[p];
      if (row >= skip_begin && row < skip_end) {
        continue;
      }
      if (offset >= trailing_len) {
        kls_egraph_refactor_record_invalid(shared);
        return -1;
      }
      x[row] -= trailing_workspace[offset++];
    }
    if (offset != trailing_len) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    trailing_entries += run_rows * trailing_len;
  }
  if (shared->u_supernode_values) {
    for (UF_long local = 0; local < run_rows; ++local) {
      kls_egraph_record_u_supernode_value(
        shared, dep_global + local, current_global, workspace[local]);
    }
  }

  const UF_long trsv_entries = (run_rows * (run_rows - 1u)) / 2u;
  kls_egraph_record_supernode_update(shared, run_rows,
                                     trsv_entries + trailing_entries);
  *up_io = up + run_rows;
  return 1;
}

static int kls_egraph_refreshed_prefix(
  const kls_egraph_refactor_shared *shared,
  UF_long rejected_pivot) {
  if (shared == NULL || shared->pipeline_done == NULL ||
      rejected_pivot == KLS_KLU_EMPTY ||
      shared->solver == NULL || rejected_pivot >= shared->solver->n) {
    return 0;
  }
  const unsigned int generation = shared->pipeline_generation;
  if (generation == 0u) {
    return 0;
  }
  for (UF_long col = 0; col < rejected_pivot; ++col) {
    if (atomic_load_explicit(&shared->pipeline_done[col],
                             memory_order_acquire) != generation) {
      return 0;
    }
  }
  return 1;
}

static int kls_egraph_refactor_dependency_done_now(
  const kls_egraph_refactor_shared *shared,
  UF_long col) {
  if (shared == NULL || shared->pipeline_done == NULL ||
      shared->pipeline_generation == 0u ||
      shared->solver == NULL || col >= shared->solver->n) {
    return 0;
  }
  return atomic_load_explicit(&shared->pipeline_done[col],
                              memory_order_acquire) ==
         shared->pipeline_generation;
}

/* Cached-pointer variant of kls_snode_batch_consume for the EGraph column
 * kernels, which read L columns through the retained l_indices/l_values
 * caches and can walk 32-bit U index mirrors.  In pipeline mode a batch is
 * only taken when every producer in it is already published; otherwise the
 * scalar path performs its usual blocking wait.  Returns the number of
 * producers consumed (0 = no batch at position up). */
/* Keep the large panel temporaries out of the eligibility probe.  Most call
 * sites decline because the first dependency is not in a supernode run; a
 * single combined function made every one of those probes reserve the full
 * ~2.7 KiB AVX-512 update frame before inspecting run_end. */
#if defined(__GNUC__) && defined(__x86_64__) && !defined(__clang__)
/* GCC cannot instantiate the explicit AVX-512 FMA source below as its
   x86-64-v3 clone.  The default clone remains the fallback and native v4
   builds dispatch to the tuned clone. */
__attribute__((noinline, target_clones("default", "arch=x86-64-v4")))
#endif
static UF_long kls_snode_batch_consume_cached_apply(
  const kls_solver *solver,
  double *const *l_values,
  double *ux,
  UF_long up,
  double *restrict x,
  UF_long k1,
  UF_long j,
  UF_long t,
  const UF_long *tli,
  const int32_t *tli32,
  UF_long tlen) {
  double xs[KLS_SNODE_MAX_BATCH];
  const double *lx_arr[KLS_SNODE_MAX_BATCH];
  for (UF_long i = 0; i < t; ++i) {
    lx_arr[i] = l_values[k1 + j + i];
    if (lx_arr[i] == NULL) {
      return 0;
    }
    xs[i] = x[j + i];
  }
  for (UF_long i = 0; i < t; ++i) {
    x[j + i] = 0.0;
  }
  for (UF_long i = 0; i < t; ++i) {
    const double u = xs[i];
    ux[up + i] = u;
    const double *lxi = lx_arr[i];
    for (UF_long r0 = 0; r0 + i + 1u < t; ++r0) {
      xs[i + 1u + r0] -= lxi[r0] * u;
    }
  }
  const double *tlx = lx_arr[t - 1u];
  UF_long p0 = 0;
  while (p0 < tlen) {
    const UF_long remaining = tlen - p0;
#if defined(__AVX512F__)
    const UF_long pc =
                       remaining >= 144u && solver != NULL &&
                           solver->snode_tail_chunk144
                         ? 144u
                       : remaining >= 128u && solver != NULL &&
                           solver->snode_tail_chunk128
                         ? 128u
                       : remaining >= 64u ? 64u
                       : remaining > KLS_SNODE_TAIL_CHUNK &&
                           solver != NULL &&
                           solver->snode_tail_masked_remainder
                         ? remaining
                       : remaining >= KLS_SNODE_TAIL_CHUNK
                         ? KLS_SNODE_TAIL_CHUNK : remaining;
#else
    const UF_long pc = remaining < KLS_SNODE_TAIL_CHUNK
                         ? remaining : KLS_SNODE_TAIL_CHUNK;
#endif
    double acc[144];
#if defined(__AVX512F__)
    if (pc == 144u) {
      __m512d u = _mm512_set1_pd(xs[t - 1u]);
#define KLS_SNODE_INIT_ACC(I) \
      __m512d a##I = _mm512_mul_pd( \
        _mm512_loadu_pd(tlx + p0 + 8u * (I)), u)
      KLS_SNODE_INIT_ACC(0);
      KLS_SNODE_INIT_ACC(1);
      KLS_SNODE_INIT_ACC(2);
      KLS_SNODE_INIT_ACC(3);
      KLS_SNODE_INIT_ACC(4);
      KLS_SNODE_INIT_ACC(5);
      KLS_SNODE_INIT_ACC(6);
      KLS_SNODE_INIT_ACC(7);
      KLS_SNODE_INIT_ACC(8);
      KLS_SNODE_INIT_ACC(9);
      KLS_SNODE_INIT_ACC(10);
      KLS_SNODE_INIT_ACC(11);
      KLS_SNODE_INIT_ACC(12);
      KLS_SNODE_INIT_ACC(13);
      KLS_SNODE_INIT_ACC(14);
      KLS_SNODE_INIT_ACC(15);
      KLS_SNODE_INIT_ACC(16);
      KLS_SNODE_INIT_ACC(17);
#undef KLS_SNODE_INIT_ACC
      for (UF_long i = 0; i + 1u < t; ++i) {
        const double *src = lx_arr[i] + (t - 1u - i) + p0;
        u = _mm512_set1_pd(xs[i]);
#define KLS_SNODE_UPDATE_ACC(I) \
        a##I = _mm512_fmadd_pd( \
          _mm512_loadu_pd(src + 8u * (I)), u, a##I)
        KLS_SNODE_UPDATE_ACC(0);
        KLS_SNODE_UPDATE_ACC(1);
        KLS_SNODE_UPDATE_ACC(2);
        KLS_SNODE_UPDATE_ACC(3);
        KLS_SNODE_UPDATE_ACC(4);
        KLS_SNODE_UPDATE_ACC(5);
        KLS_SNODE_UPDATE_ACC(6);
        KLS_SNODE_UPDATE_ACC(7);
        KLS_SNODE_UPDATE_ACC(8);
        KLS_SNODE_UPDATE_ACC(9);
        KLS_SNODE_UPDATE_ACC(10);
        KLS_SNODE_UPDATE_ACC(11);
        KLS_SNODE_UPDATE_ACC(12);
        KLS_SNODE_UPDATE_ACC(13);
        KLS_SNODE_UPDATE_ACC(14);
        KLS_SNODE_UPDATE_ACC(15);
        KLS_SNODE_UPDATE_ACC(16);
        KLS_SNODE_UPDATE_ACC(17);
#undef KLS_SNODE_UPDATE_ACC
      }
#define KLS_SNODE_STORE_ACC(I) \
      _mm512_storeu_pd(acc + 8u * (I), a##I)
      KLS_SNODE_STORE_ACC(0);
      KLS_SNODE_STORE_ACC(1);
      KLS_SNODE_STORE_ACC(2);
      KLS_SNODE_STORE_ACC(3);
      KLS_SNODE_STORE_ACC(4);
      KLS_SNODE_STORE_ACC(5);
      KLS_SNODE_STORE_ACC(6);
      KLS_SNODE_STORE_ACC(7);
      KLS_SNODE_STORE_ACC(8);
      KLS_SNODE_STORE_ACC(9);
      KLS_SNODE_STORE_ACC(10);
      KLS_SNODE_STORE_ACC(11);
      KLS_SNODE_STORE_ACC(12);
      KLS_SNODE_STORE_ACC(13);
      KLS_SNODE_STORE_ACC(14);
      KLS_SNODE_STORE_ACC(15);
      KLS_SNODE_STORE_ACC(16);
      KLS_SNODE_STORE_ACC(17);
#undef KLS_SNODE_STORE_ACC
    } else if (pc == 128u) {
      /* A 185-entry average shared tail otherwise scans every producer four
         times (64+64+32+remainder).  Sixteen accumulators fit in the
         32-register AVX-512 file, so a 128-entry block retains the arithmetic
         order while removing one producer-pointer/broadcast scan. */
#define KLS_SNODE_INIT_ACC(I) \
      __m512d a##I = _mm512_mul_pd( \
        _mm512_loadu_pd(tlx + p0 + 8u * (I)), u)
      __m512d u = _mm512_set1_pd(xs[t - 1u]);
      KLS_SNODE_INIT_ACC(0);
      KLS_SNODE_INIT_ACC(1);
      KLS_SNODE_INIT_ACC(2);
      KLS_SNODE_INIT_ACC(3);
      KLS_SNODE_INIT_ACC(4);
      KLS_SNODE_INIT_ACC(5);
      KLS_SNODE_INIT_ACC(6);
      KLS_SNODE_INIT_ACC(7);
      KLS_SNODE_INIT_ACC(8);
      KLS_SNODE_INIT_ACC(9);
      KLS_SNODE_INIT_ACC(10);
      KLS_SNODE_INIT_ACC(11);
      KLS_SNODE_INIT_ACC(12);
      KLS_SNODE_INIT_ACC(13);
      KLS_SNODE_INIT_ACC(14);
      KLS_SNODE_INIT_ACC(15);
#undef KLS_SNODE_INIT_ACC
      for (UF_long i = 0; i + 1u < t; ++i) {
        const double *src = lx_arr[i] + (t - 1u - i) + p0;
        u = _mm512_set1_pd(xs[i]);
#define KLS_SNODE_UPDATE_ACC(I) \
        a##I = _mm512_fmadd_pd( \
          _mm512_loadu_pd(src + 8u * (I)), u, a##I)
        KLS_SNODE_UPDATE_ACC(0);
        KLS_SNODE_UPDATE_ACC(1);
        KLS_SNODE_UPDATE_ACC(2);
        KLS_SNODE_UPDATE_ACC(3);
        KLS_SNODE_UPDATE_ACC(4);
        KLS_SNODE_UPDATE_ACC(5);
        KLS_SNODE_UPDATE_ACC(6);
        KLS_SNODE_UPDATE_ACC(7);
        KLS_SNODE_UPDATE_ACC(8);
        KLS_SNODE_UPDATE_ACC(9);
        KLS_SNODE_UPDATE_ACC(10);
        KLS_SNODE_UPDATE_ACC(11);
        KLS_SNODE_UPDATE_ACC(12);
        KLS_SNODE_UPDATE_ACC(13);
        KLS_SNODE_UPDATE_ACC(14);
        KLS_SNODE_UPDATE_ACC(15);
#undef KLS_SNODE_UPDATE_ACC
      }
#define KLS_SNODE_STORE_ACC(I) \
      _mm512_storeu_pd(acc + 8u * (I), a##I)
      KLS_SNODE_STORE_ACC(0);
      KLS_SNODE_STORE_ACC(1);
      KLS_SNODE_STORE_ACC(2);
      KLS_SNODE_STORE_ACC(3);
      KLS_SNODE_STORE_ACC(4);
      KLS_SNODE_STORE_ACC(5);
      KLS_SNODE_STORE_ACC(6);
      KLS_SNODE_STORE_ACC(7);
      KLS_SNODE_STORE_ACC(8);
      KLS_SNODE_STORE_ACC(9);
      KLS_SNODE_STORE_ACC(10);
      KLS_SNODE_STORE_ACC(11);
      KLS_SNODE_STORE_ACC(12);
      KLS_SNODE_STORE_ACC(13);
      KLS_SNODE_STORE_ACC(14);
      KLS_SNODE_STORE_ACC(15);
#undef KLS_SNODE_STORE_ACC
    } else if (pc == 64u) {
      /* Eight accumulators still fit comfortably in the v4 register file.
         Consuming two old chunks at once halves producer-pointer loads and
         broadcasts on long shared tails. */
      __m512d u = _mm512_set1_pd(xs[t - 1u]);
      __m512d a0 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0), u);
      __m512d a1 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0 + 8u), u);
      __m512d a2 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0 + 16u), u);
      __m512d a3 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0 + 24u), u);
      __m512d a4 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0 + 32u), u);
      __m512d a5 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0 + 40u), u);
      __m512d a6 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0 + 48u), u);
      __m512d a7 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0 + 56u), u);
      for (UF_long i = 0; i + 1u < t; ++i) {
        const double *src = lx_arr[i] + (t - 1u - i) + p0;
        u = _mm512_set1_pd(xs[i]);
        a0 = _mm512_fmadd_pd(_mm512_loadu_pd(src), u, a0);
        a1 = _mm512_fmadd_pd(_mm512_loadu_pd(src + 8u), u, a1);
        a2 = _mm512_fmadd_pd(_mm512_loadu_pd(src + 16u), u, a2);
        a3 = _mm512_fmadd_pd(_mm512_loadu_pd(src + 24u), u, a3);
        a4 = _mm512_fmadd_pd(_mm512_loadu_pd(src + 32u), u, a4);
        a5 = _mm512_fmadd_pd(_mm512_loadu_pd(src + 40u), u, a5);
        a6 = _mm512_fmadd_pd(_mm512_loadu_pd(src + 48u), u, a6);
        a7 = _mm512_fmadd_pd(_mm512_loadu_pd(src + 56u), u, a7);
      }
      _mm512_storeu_pd(acc, a0);
      _mm512_storeu_pd(acc + 8u, a1);
      _mm512_storeu_pd(acc + 16u, a2);
      _mm512_storeu_pd(acc + 24u, a3);
      _mm512_storeu_pd(acc + 32u, a4);
      _mm512_storeu_pd(acc + 40u, a5);
      _mm512_storeu_pd(acc + 48u, a6);
      _mm512_storeu_pd(acc + 56u, a7);
    } else if (pc >= 24u && pc < KLS_SNODE_TAIL_CHUNK) {
      const __mmask8 tail_mask =
        (__mmask8)((1u << (unsigned)(pc - 24u)) - 1u);
      __m512d u = _mm512_set1_pd(xs[t - 1u]);
      __m512d a0 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0), u);
      __m512d a1 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0 + 8u), u);
      __m512d a2 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0 + 16u), u);
      __m512d a3 = _mm512_mul_pd(
        _mm512_maskz_loadu_pd(tail_mask, tlx + p0 + 24u), u);
      for (UF_long i = 0; i + 1u < t; ++i) {
        const double *src = lx_arr[i] + (t - 1u - i) + p0;
        u = _mm512_set1_pd(xs[i]);
        a0 = _mm512_fmadd_pd(_mm512_loadu_pd(src), u, a0);
        a1 = _mm512_fmadd_pd(_mm512_loadu_pd(src + 8u), u, a1);
        a2 = _mm512_fmadd_pd(_mm512_loadu_pd(src + 16u), u, a2);
        a3 = _mm512_fmadd_pd(
          _mm512_maskz_loadu_pd(tail_mask, src + 24u), u, a3);
      }
      _mm512_storeu_pd(acc, a0);
      _mm512_storeu_pd(acc + 8u, a1);
      _mm512_storeu_pd(acc + 16u, a2);
      _mm512_mask_storeu_pd(acc + 24u, tail_mask, a3);
    } else if (pc >= 16u && pc < 24u) {
      const __mmask8 tail_mask =
        (__mmask8)((1u << (unsigned)(pc - 16u)) - 1u);
      __m512d u = _mm512_set1_pd(xs[t - 1u]);
      __m512d a0 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0), u);
      __m512d a1 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0 + 8u), u);
      __m512d a2 = _mm512_mul_pd(
        _mm512_maskz_loadu_pd(tail_mask, tlx + p0 + 16u), u);
      for (UF_long i = 0; i + 1u < t; ++i) {
        const double *src = lx_arr[i] + (t - 1u - i) + p0;
        u = _mm512_set1_pd(xs[i]);
        a0 = _mm512_fmadd_pd(_mm512_loadu_pd(src), u, a0);
        a1 = _mm512_fmadd_pd(_mm512_loadu_pd(src + 8u), u, a1);
        a2 = _mm512_fmadd_pd(
          _mm512_maskz_loadu_pd(tail_mask, src + 16u), u, a2);
      }
      _mm512_storeu_pd(acc, a0);
      _mm512_storeu_pd(acc + 8u, a1);
      _mm512_mask_storeu_pd(acc + 16u, tail_mask, a2);
    } else if (pc >= 8u && pc < 16u) {
      const __mmask8 tail_mask =
        (__mmask8)((1u << (unsigned)(pc - 8u)) - 1u);
      __m512d u = _mm512_set1_pd(xs[t - 1u]);
      __m512d a0 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0), u);
      __m512d a1 = _mm512_mul_pd(
        _mm512_maskz_loadu_pd(tail_mask, tlx + p0 + 8u), u);
      for (UF_long i = 0; i + 1u < t; ++i) {
        const double *src = lx_arr[i] + (t - 1u - i) + p0;
        u = _mm512_set1_pd(xs[i]);
        a0 = _mm512_fmadd_pd(_mm512_loadu_pd(src), u, a0);
        a1 = _mm512_fmadd_pd(
          _mm512_maskz_loadu_pd(tail_mask, src + 8u), u, a1);
      }
      _mm512_storeu_pd(acc, a0);
      _mm512_mask_storeu_pd(acc + 8u, tail_mask, a1);
    } else if (pc > KLS_SNODE_TAIL_CHUNK && pc <= 40u) {
      /* A 144-entry main tile commonly leaves only 33--40 entries.  Keep
         that remainder in five zmm accumulators and mask the final vector,
         avoiding a second producer/broadcast pass for the last 1--8 rows. */
      const __mmask8 tail_mask =
        (__mmask8)((1u << (unsigned)(pc - 32u)) - 1u);
      __m512d u = _mm512_set1_pd(xs[t - 1u]);
      __m512d a0 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0), u);
      __m512d a1 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0 + 8u), u);
      __m512d a2 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0 + 16u), u);
      __m512d a3 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0 + 24u), u);
      __m512d a4 = _mm512_mul_pd(
        _mm512_maskz_loadu_pd(tail_mask, tlx + p0 + 32u), u);
      for (UF_long i = 0; i + 1u < t; ++i) {
        const double *src = lx_arr[i] + (t - 1u - i) + p0;
        u = _mm512_set1_pd(xs[i]);
        a0 = _mm512_fmadd_pd(_mm512_loadu_pd(src), u, a0);
        a1 = _mm512_fmadd_pd(_mm512_loadu_pd(src + 8u), u, a1);
        a2 = _mm512_fmadd_pd(_mm512_loadu_pd(src + 16u), u, a2);
        a3 = _mm512_fmadd_pd(_mm512_loadu_pd(src + 24u), u, a3);
        a4 = _mm512_fmadd_pd(
          _mm512_maskz_loadu_pd(tail_mask, src + 32u), u, a4);
      }
      _mm512_storeu_pd(acc, a0);
      _mm512_storeu_pd(acc + 8u, a1);
      _mm512_storeu_pd(acc + 16u, a2);
      _mm512_storeu_pd(acc + 24u, a3);
      _mm512_mask_storeu_pd(acc + 32u, tail_mask, a4);
    } else if (pc == KLS_SNODE_TAIL_CHUNK) {
      /* GCC's generic dynamic-trip loop reloads and stores acc[] for every
         producer, even in the x86-64-v4 clone.  A full tail chunk is exactly
         four vectors, so keep those accumulators live across the producer
         dimension and materialize acc[] only once for the sparse scatter. */
      __m512d u = _mm512_set1_pd(xs[t - 1u]);
      __m512d a0 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0), u);
      __m512d a1 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0 + 8u), u);
      __m512d a2 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0 + 16u), u);
      __m512d a3 = _mm512_mul_pd(_mm512_loadu_pd(tlx + p0 + 24u), u);
      for (UF_long i = 0; i + 1u < t; ++i) {
        const double *src = lx_arr[i] + (t - 1u - i) + p0;
        u = _mm512_set1_pd(xs[i]);
        a0 = _mm512_fmadd_pd(_mm512_loadu_pd(src), u, a0);
        a1 = _mm512_fmadd_pd(_mm512_loadu_pd(src + 8u), u, a1);
        a2 = _mm512_fmadd_pd(_mm512_loadu_pd(src + 16u), u, a2);
        a3 = _mm512_fmadd_pd(_mm512_loadu_pd(src + 24u), u, a3);
      }
      _mm512_storeu_pd(acc, a0);
      _mm512_storeu_pd(acc + 8u, a1);
      _mm512_storeu_pd(acc + 16u, a2);
      _mm512_storeu_pd(acc + 24u, a3);
    } else
#endif
    {
    {
      const double *src = tlx + p0;
      const double u = xs[t - 1u];
      for (UF_long p = 0; p < pc; ++p) {
        acc[p] = src[p] * u;
      }
    }
    for (UF_long i = 0; i + 1u < t; ++i) {
      const double *src = lx_arr[i] + (t - 1u - i) + p0;
      const double u = xs[i];
      for (UF_long p = 0; p < pc; ++p) {
        acc[p] += src[p] * u;
      }
    }
    }
    if (tli32 != NULL) {
      /* The persistent 32-bit row mirror halves index traffic in the
         batch's final indexed RMW and shares the same AVX-512 crossover
         machinery as ordinary L scatters.  This scatter is the remaining
         non-contiguous phase after the dense tail panel has been fused. */
      kls_scatter_subtract_refactor_i32(
        solver, x, tli32 + p0, acc, pc, 1.0);
    } else {
      for (UF_long p = 0; p < pc; ++p) {
        x[tli[p0 + p]] -= acc[p];
      }
    }
    p0 += pc;
  }
  if (kls_snode_trace_enabled()) {
    kls_snode_trace_batched_producers += t;
    kls_snode_trace_batched_tail_entries += t * tlen;
    kls_snode_trace_batches++;
    kls_snode_trace_tlen_sum += tlen;
    if (tlen > kls_snode_trace_tlen_max) {
      kls_snode_trace_tlen_max = tlen;
    }
    const unsigned int bucket =
      t <= 1u ? 0u : t <= 3u ? 1u : t <= 7u ? 2u : t <= 15u ? 3u
      : t <= 31u ? 4u : t <= 63u ? 5u : 6u;
    kls_snode_trace_t_hist[bucket]++;
  }
  return t;
}

static KLS_ALWAYS_INLINE UF_long kls_snode_batch_consume_cached(
  UF_long *const *l_indices,
  double *const *l_values,
  const UF_long *llen_local,
  const UF_long *ui,
  const int32_t *ui32,
  double *ux,
  UF_long ucol_len,
  UF_long up,
  double *restrict x,
  UF_long k1,
  UF_long producer_limit,
  const UF_long *snode_run_end,
  const kls_egraph_refactor_shared *shared,
  int wait_for_dependencies,
  const unsigned char *applied) {
  const UF_long j = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
  const UF_long run_end = snode_run_end[k1 + j];
  if (run_end <= k1 + j + 1u) {
    if (kls_snode_trace_enabled()) {
      kls_snode_trace_decline_norun++;
    }
    return 0;
  }
  UF_long tmax = run_end - (k1 + j);
  if (tmax > KLS_SNODE_MAX_BATCH) {
    tmax = KLS_SNODE_MAX_BATCH;
  }
  if (tmax > ucol_len - up) {
    tmax = ucol_len - up;
  }
  UF_long t = 1;
  if (ui32 != NULL) {
    while (t < tmax && (UF_long)ui32[up + t] == j + t) {
      t++;
    }
  } else {
    while (t < tmax && ui[up + t] == j + t) {
      t++;
    }
  }
  if (applied != NULL) {
    /* Positions the Algorithm-5 prefactor already applied must not be
       consumed again; clamp the batch at the first applied position. */
    UF_long limit = 0;
    while (limit < t && !applied[up + limit]) {
      limit++;
    }
    t = limit;
  }
  if (t < KLS_SNODE_MIN_BATCH || j + t > producer_limit) {
    if (kls_snode_trace_enabled()) {
      kls_snode_trace_decline_short++;
    }
    return 0;
  }
  if (wait_for_dependencies) {
    for (UF_long i = 0; i < t; ++i) {
      if (!kls_egraph_refactor_dependency_done_now(shared, k1 + j + i)) {
        return 0;
      }
    }
  }
  const UF_long *tli = l_indices[k1 + j + t - 1u];
  const int32_t *tli32 =
    shared != NULL && shared->solver != NULL &&
        shared->solver->refactor_l_indices32 != NULL
      ? shared->solver->refactor_l_indices32[k1 + j + t - 1u]
      : NULL;
  const UF_long tlen = llen_local[j + t - 1u];
  if (tli == NULL || t * tlen < KLS_SNODE_MIN_BATCH_WORK) {
    /* Short shared tails lose to the 32-bit-index scalar path; only pay the
       panel staging when the batched update amortizes it. */
    if (kls_snode_trace_enabled()) {
      kls_snode_trace_decline_work++;
    }
    return 0;
  }
  return kls_snode_batch_consume_cached_apply(
    shared != NULL ? shared->solver : NULL,
    l_values, ux, up, x, k1, j, t, tli, tli32, tlen);
}

/* Fused two-consumer batch consume: one pass over the producer run's tail
   panel feeds two consumer SPAs (the panel stream is the per-core wall;
   sharing it halves the dominant refactor traffic).  Both consumers must
   hold the run contiguously at their current U positions; the run's shared
   tail pattern (last member) is producer-side structure and thus consumer
   independent.  Per-consumer arithmetic order matches the single kernel
   exactly, so paired columns are bit-identical to single dispatch.
   Returns producers consumed from BOTH positions, or 0 to fall back. */
static UF_long kls_snode_batch_consume_cached_pair(
  UF_long *const *l_indices,
  double *const *l_values,
  const UF_long *llen_local,
  const UF_long *uia,
  const int32_t *uia32,
  double *uxa,
  UF_long ulen_a,
  UF_long upa,
  double *restrict xa,
  const UF_long *uib,
  const int32_t *uib32,
  double *uxb,
  UF_long ulen_b,
  UF_long upb,
  double *restrict xb,
  UF_long k1,
  UF_long producer_limit,
  const UF_long *snode_run_end,
  const kls_egraph_refactor_shared *shared,
  int wait_for_dependencies) {
  const UF_long j = uia32 != NULL ? (UF_long)uia32[upa] : uia[upa];
  const UF_long run_end = snode_run_end[k1 + j];
  if (run_end <= k1 + j + 1u) {
    return 0;
  }
  UF_long tmax = run_end - (k1 + j);
  if (tmax > KLS_SNODE_MAX_BATCH) {
    tmax = KLS_SNODE_MAX_BATCH;
  }
  if (tmax > ulen_a - upa) {
    tmax = ulen_a - upa;
  }
  if (tmax > ulen_b - upb) {
    tmax = ulen_b - upb;
  }
  UF_long t = 1;
  while (t < tmax &&
         (uia32 != NULL ? (UF_long)uia32[upa + t] : uia[upa + t]) == j + t &&
         (uib32 != NULL ? (UF_long)uib32[upb + t] : uib[upb + t]) == j + t) {
    t++;
  }
  if (t < KLS_SNODE_MIN_BATCH || j + t > producer_limit) {
    return 0;
  }
  if (wait_for_dependencies) {
    for (UF_long i = 0; i < t; ++i) {
      if (!kls_egraph_refactor_dependency_done_now(shared, k1 + j + i)) {
        return 0;
      }
    }
  }
  const UF_long *tli = l_indices[k1 + j + t - 1u];
  const UF_long tlen = llen_local[j + t - 1u];
  if (tli == NULL || 2u * t * tlen < KLS_SNODE_MIN_BATCH_WORK) {
    return 0;
  }
  double xsa[KLS_SNODE_MAX_BATCH];
  double xsb[KLS_SNODE_MAX_BATCH];
  const double *lx_arr[KLS_SNODE_MAX_BATCH];
  for (UF_long i = 0; i < t; ++i) {
    lx_arr[i] = l_values[k1 + j + i];
    if (lx_arr[i] == NULL) {
      return 0;
    }
    xsa[i] = xa[j + i];
    xsb[i] = xb[j + i];
  }
  for (UF_long i = 0; i < t; ++i) {
    xa[j + i] = 0.0;
    xb[j + i] = 0.0;
  }
  for (UF_long i = 0; i < t; ++i) {
    const double ua = xsa[i];
    const double ub = xsb[i];
    uxa[upa + i] = ua;
    uxb[upb + i] = ub;
    const double *lxi = lx_arr[i];
    for (UF_long r0 = 0; r0 + i + 1u < t; ++r0) {
      xsa[i + 1u + r0] -= lxi[r0] * ua;
      xsb[i + 1u + r0] -= lxi[r0] * ub;
    }
  }
  const double *tlx = lx_arr[t - 1u];
  for (UF_long p0 = 0; p0 < tlen; p0 += KLS_SNODE_TAIL_CHUNK) {
    const UF_long pc = tlen - p0 < KLS_SNODE_TAIL_CHUNK
                         ? tlen - p0
                         : KLS_SNODE_TAIL_CHUNK;
    double acca[KLS_SNODE_TAIL_CHUNK];
    double accb[KLS_SNODE_TAIL_CHUNK];
    {
      const double *src = tlx + p0;
      const double ua = xsa[t - 1u];
      const double ub = xsb[t - 1u];
      for (UF_long p = 0; p < pc; ++p) {
        acca[p] = src[p] * ua;
        accb[p] = src[p] * ub;
      }
    }
    for (UF_long i = 0; i + 1u < t; ++i) {
      const double *src = lx_arr[i] + (t - 1u - i) + p0;
      const double ua = xsa[i];
      const double ub = xsb[i];
      for (UF_long p = 0; p < pc; ++p) {
        acca[p] += src[p] * ua;
        accb[p] += src[p] * ub;
      }
    }
    for (UF_long p = 0; p < pc; ++p) {
      const UF_long row = tli[p0 + p];
      xa[row] -= acca[p];
      xb[row] -= accb[p];
    }
  }
  if (kls_snode_trace_enabled()) {
    kls_snode_trace_batched_producers += 2u * t;
    kls_snode_trace_batched_tail_entries += 2u * t * tlen;
    kls_snode_trace_pair_batches += 1u;
    kls_snode_trace_pair_producers += t;
  }
  return t;
}

#define KLS_SNODE_MAX_FUSE 4

/* Fused k-consumer batch consume (k <= KLS_SNODE_MAX_FUSE): one pass
   over the producer run's tail panel feeds k consumer SPAs, dividing
   the dominant panel-stream traffic by k. All consumers' cursors must
   point at the run start (caller-checked) and hold it contiguously;
   per-consumer arithmetic order matches the single kernel exactly, so
   fused columns stay bit-identical to single dispatch. Returns
   producers consumed from EVERY cursor, or 0 to fall back. */
static UF_long kls_snode_batch_consume_cached_multi(
  UF_long *const *l_indices,
  double *const *l_values,
  const UF_long *llen_local,
  int nc,
  const UF_long *const *ui,
  const int32_t *const *ui32,
  double *const *ux,
  const UF_long *ulen,
  const UF_long *up,
  double *const *xv,
  UF_long k1,
  UF_long producer_limit,
  const UF_long *snode_run_end,
  const kls_egraph_refactor_shared *shared,
  int wait_for_dependencies) {
  const UF_long j =
    ui32[0] != NULL ? (UF_long)ui32[0][up[0]] : ui[0][up[0]];
  const UF_long run_end = snode_run_end[k1 + j];
  if (run_end <= k1 + j + 1u) {
    return 0;
  }
  UF_long tmax = run_end - (k1 + j);
  if (tmax > KLS_SNODE_MAX_BATCH) {
    tmax = KLS_SNODE_MAX_BATCH;
  }
  for (int c = 0; c < nc; ++c) {
    if (tmax > ulen[c] - up[c]) {
      tmax = ulen[c] - up[c];
    }
  }
  UF_long t = 1;
  for (; t < tmax; ++t) {
    int aligned = 1;
    for (int c = 0; c < nc; ++c) {
      const UF_long jc = ui32[c] != NULL
        ? (UF_long)ui32[c][up[c] + t] : ui[c][up[c] + t];
      if (jc != j + t) {
        aligned = 0;
        break;
      }
    }
    if (!aligned) {
      break;
    }
  }
  if (t < KLS_SNODE_MIN_BATCH || j + t > producer_limit) {
    return 0;
  }
  if (wait_for_dependencies) {
    for (UF_long i = 0; i < t; ++i) {
      if (!kls_egraph_refactor_dependency_done_now(shared, k1 + j + i)) {
        return 0;
      }
    }
  }
  const UF_long *tli = l_indices[k1 + j + t - 1u];
  const UF_long tlen = llen_local[j + t - 1u];
  if (tli == NULL || (UF_long)nc * t * tlen < KLS_SNODE_MIN_BATCH_WORK) {
    return 0;
  }
  double xs[KLS_SNODE_MAX_FUSE][KLS_SNODE_MAX_BATCH];
  const double *lx_arr[KLS_SNODE_MAX_BATCH];
  for (UF_long i = 0; i < t; ++i) {
    lx_arr[i] = l_values[k1 + j + i];
    if (lx_arr[i] == NULL) {
      return 0;
    }
    for (int c = 0; c < nc; ++c) {
      xs[c][i] = xv[c][j + i];
    }
  }
  for (UF_long i = 0; i < t; ++i) {
    for (int c = 0; c < nc; ++c) {
      xv[c][j + i] = 0.0;
    }
  }
  for (UF_long i = 0; i < t; ++i) {
    const double *lxi = lx_arr[i];
    for (int c = 0; c < nc; ++c) {
      const double u = xs[c][i];
      ux[c][up[c] + i] = u;
      for (UF_long r0 = 0; r0 + i + 1u < t; ++r0) {
        xs[c][i + 1u + r0] -= lxi[r0] * u;
      }
    }
  }
  const double *tlx = lx_arr[t - 1u];
  for (UF_long p0 = 0; p0 < tlen; p0 += KLS_SNODE_TAIL_CHUNK) {
    const UF_long pc = tlen - p0 < KLS_SNODE_TAIL_CHUNK
                         ? tlen - p0
                         : KLS_SNODE_TAIL_CHUNK;
    double acc[KLS_SNODE_MAX_FUSE][KLS_SNODE_TAIL_CHUNK];
    {
      const double *src = tlx + p0;
      for (int c = 0; c < nc; ++c) {
        const double u = xs[c][t - 1u];
        for (UF_long p = 0; p < pc; ++p) {
          acc[c][p] = src[p] * u;
        }
      }
    }
    for (UF_long i = 0; i + 1u < t; ++i) {
      const double *src = lx_arr[i] + (t - 1u - i) + p0;
      for (int c = 0; c < nc; ++c) {
        const double u = xs[c][i];
        for (UF_long p = 0; p < pc; ++p) {
          acc[c][p] += src[p] * u;
        }
      }
    }
    for (UF_long p = 0; p < pc; ++p) {
      const UF_long row = tli[p0 + p];
      for (int c = 0; c < nc; ++c) {
        xv[c][row] -= acc[c][p];
      }
    }
  }
  if (kls_snode_trace_enabled()) {
    kls_snode_trace_batched_producers += (UF_long)nc * t;
    kls_snode_trace_batched_tail_entries += (UF_long)nc * t * tlen;
  }
  return t;
}

#if defined(__GNUC__) && defined(__x86_64__) && !defined(__clang__)
__attribute__((target_clones("default", "arch=x86-64-v3", "arch=x86-64-v4")))
#endif
static UF_long kls_snode_batch_consume_cached_f32(
  UF_long *const *l_indices,
  const int32_t *const *l_indices32,
  float *const *l_values32,
  const UF_long *llen_local,
  const UF_long *ui,
  const int32_t *ui32,
  double *ux,
  UF_long ucol_len,
  UF_long up,
  double *restrict x,
  UF_long k1,
  UF_long producer_limit,
  const UF_long *snode_run_end,
  const kls_egraph_refactor_shared *shared,
  int wait_for_dependencies,
  const unsigned char *applied) {
  const UF_long j = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
  const UF_long run_end = snode_run_end[k1 + j];
  if (run_end <= k1 + j + 1u) {
    if (kls_snode_trace_enabled()) {
      kls_snode_trace_decline_norun++;
    }
    return 0;
  }
  UF_long tmax = run_end - (k1 + j);
  if (tmax > KLS_SNODE_MAX_BATCH) {
    tmax = KLS_SNODE_MAX_BATCH;
  }
  if (tmax > ucol_len - up) {
    tmax = ucol_len - up;
  }
  UF_long t = 1;
  if (ui32 != NULL) {
    while (t < tmax && (UF_long)ui32[up + t] == j + t) {
      t++;
    }
  } else {
    while (t < tmax && ui[up + t] == j + t) {
      t++;
    }
  }
  if (applied != NULL) {
    UF_long limit = 0;
    while (limit < t && !applied[up + limit]) {
      limit++;
    }
    t = limit;
  }
  if (t < KLS_SNODE_MIN_BATCH || j + t > producer_limit) {
    if (kls_snode_trace_enabled()) {
      kls_snode_trace_decline_short++;
    }
    return 0;
  }
  if (wait_for_dependencies) {
    for (UF_long i = 0; i < t; ++i) {
      if (!kls_egraph_refactor_dependency_done_now(shared, k1 + j + i)) {
        return 0;
      }
    }
  }
  const int32_t *tli32 =
    l_indices32 != NULL ? l_indices32[k1 + j + t - 1u] : NULL;
  const UF_long *tli = l_indices[k1 + j + t - 1u];
  const UF_long tlen = llen_local[j + t - 1u];
  if ((tli == NULL && tli32 == NULL) ||
      t * tlen < KLS_SNODE_MIN_BATCH_WORK) {
    return 0;
  }
  double xs[KLS_SNODE_MAX_BATCH];
  const float *lx_arr[KLS_SNODE_MAX_BATCH];
  for (UF_long i = 0; i < t; ++i) {
    lx_arr[i] = l_values32[k1 + j + i];
    if (lx_arr[i] == NULL) {
      return 0;
    }
    xs[i] = x[j + i];
  }
  for (UF_long i = 0; i < t; ++i) {
    x[j + i] = 0.0;
  }
  for (UF_long i = 0; i < t; ++i) {
    const double u = xs[i];
    ux[up + i] = u;
    const float *lxi = lx_arr[i];
    for (UF_long r0 = 0; r0 + i + 1u < t; ++r0) {
      xs[i + 1u + r0] -= (double)lxi[r0] * u;
    }
  }
  if (kls_fp32_tail_float_accum_enabled()) {
    /* All-float tail dot products avoid two float-to-double conversions per
       FMA.  The factor remains stored in double, while the FP32 mode's
       residual probe and refinement contract police the extra rounding. */
    const float *tlx = lx_arr[t - 1u];
    for (UF_long p0 = 0; p0 < tlen; p0 += KLS_SNODE_TAIL_CHUNK) {
      const UF_long pc = tlen - p0 < KLS_SNODE_TAIL_CHUNK
                           ? tlen - p0
                           : KLS_SNODE_TAIL_CHUNK;
      float acc[KLS_SNODE_TAIL_CHUNK];
      {
        const float *src = tlx + p0;
        const float u = (float)xs[t - 1u];
#pragma omp simd
        for (UF_long p = 0; p < pc; ++p) {
          acc[p] = src[p] * u;
        }
      }
      for (UF_long i = 0; i + 1u < t; ++i) {
        const float *src = lx_arr[i] + (t - 1u - i) + p0;
        const float u = (float)xs[i];
#pragma omp simd
        for (UF_long p = 0; p < pc; ++p) {
          acc[p] += src[p] * u;
        }
      }
      if (tli32 != NULL) {
#pragma omp simd
        for (UF_long p = 0; p < pc; ++p) {
          x[tli32[p0 + p]] -= (double)acc[p];
        }
      } else {
#pragma omp simd
        for (UF_long p = 0; p < pc; ++p) {
          x[tli[p0 + p]] -= (double)acc[p];
        }
      }
    }
    if (kls_snode_trace_enabled()) {
      kls_snode_trace_batched_producers += t;
      kls_snode_trace_batched_tail_entries += t * tlen;
    }
    return t;
  }
  const float *tlx = lx_arr[t - 1u];
  for (UF_long p0 = 0; p0 < tlen; p0 += KLS_SNODE_TAIL_CHUNK) {
    const UF_long pc = tlen - p0 < KLS_SNODE_TAIL_CHUNK
                         ? tlen - p0
                         : KLS_SNODE_TAIL_CHUNK;
    double acc[KLS_SNODE_TAIL_CHUNK];
    {
      const float *src = tlx + p0;
      const double u = xs[t - 1u];
#pragma omp simd
      for (UF_long p = 0; p < pc; ++p) {
        acc[p] = (double)src[p] * u;
      }
    }
    for (UF_long i = 0; i + 1u < t; ++i) {
      const float *src = lx_arr[i] + (t - 1u - i) + p0;
      const double u = xs[i];
#pragma omp simd
      for (UF_long p = 0; p < pc; ++p) {
        acc[p] += (double)src[p] * u;
      }
    }
    if (tli32 != NULL) {
#pragma omp simd
      for (UF_long p = 0; p < pc; ++p) {
        x[tli32[p0 + p]] -= acc[p];
      }
    } else {
#pragma omp simd
      for (UF_long p = 0; p < pc; ++p) {
        x[tli[p0 + p]] -= acc[p];
      }
    }
  }
  if (kls_snode_trace_enabled()) {
    kls_snode_trace_batched_producers += t;
    kls_snode_trace_batched_tail_entries += t * tlen;
  }
  return t;
}

static int kls_egraph_refactor_column_owned_now(
  const kls_egraph_refactor_shared *shared,
  UF_long col) {
  if (shared == NULL || shared->pipeline_claimed == NULL ||
      shared->pipeline_claim_generation == 0u ||
      shared->pipeline_lease_generation == 0u ||
      shared->solver == NULL || col >= shared->solver->n) {
    return 0;
  }
  const unsigned int owner =
    atomic_load_explicit(&shared->pipeline_claimed[col],
                         memory_order_acquire);
  return owner == shared->pipeline_claim_generation ||
         owner == shared->pipeline_lease_generation;
}

static int kls_egraph_l_column_contains_row(
  const kls_solver *solver,
  UF_long column,
  UF_long row,
  UF_long length) {
  if (solver == NULL || column >= solver->n) {
    return -1;
  }
  if (length == 0u) {
    return 0;
  }
  if (solver->refactor_l_indices32 != NULL) {
    const int32_t *rows32 = solver->refactor_l_indices32[column];
    if (rows32 != NULL) {
      if (row > (UF_long)INT32_MAX) {
        return 0;
      }
      const int32_t row32 = (int32_t)row;
      for (UF_long p = 0; p < length; ++p) {
        if (rows32[p] == row32) {
          return 1;
        }
      }
      return 0;
    }
  }
  if (solver->refactor_l_indices == NULL ||
      solver->refactor_l_indices[column] == NULL) {
    return -1;
  }
  const UF_long *rows = solver->refactor_l_indices[column];
  for (UF_long p = 0; p < length; ++p) {
    if (rows[p] == row) {
      return 1;
    }
  }
  return 0;
}

static int kls_egraph_btf_prefactor_dep_safe_with_run(
  const kls_solver *solver,
  const kls_egraph_refactor_shared *shared,
  UF_long k1,
  UF_long run_begin,
  UF_long pos,
  const unsigned char *applied,
  const UF_long *ui,
  const int32_t *ui32,
  const UF_long *llen,
  UF_long local_k,
  UF_long dep_local) {
  if (solver == NULL || shared == NULL || applied == NULL ||
      ui == NULL || llen == NULL ||
      dep_local > UF_long_max - k1 ||
      !kls_egraph_refactor_dependency_done_now(shared, k1 + dep_local)) {
    return 0;
  }

  for (UF_long prior_pos = 0u; prior_pos < pos; ++prior_pos) {
    if (applied[prior_pos] ||
        (prior_pos >= run_begin && prior_pos < pos)) {
      continue;
    }
    const UF_long prior_local =
      ui32 != NULL ? (UF_long)ui32[prior_pos] : ui[prior_pos];
    if (prior_local >= local_k || prior_local > UF_long_max - k1) {
      return -1;
    }
    const int writes_candidate =
      kls_egraph_l_column_contains_row(
        solver, k1 + prior_local, dep_local, llen[prior_local]);
    if (writes_candidate < 0) {
      return -1;
    }
    if (writes_candidate > 0) {
      return 0;
    }
  }
  return 1;
}

static int kls_egraph_btf_prefactor_dep_safe(
  const kls_solver *solver,
  const kls_egraph_refactor_shared *shared,
  UF_long k1,
  UF_long scan,
  const unsigned char *applied,
  const UF_long *ui,
  const int32_t *ui32,
  const UF_long *llen,
  UF_long local_k,
  UF_long dep_local) {
  return kls_egraph_btf_prefactor_dep_safe_with_run(
    solver, shared, k1, scan, scan, applied, ui, ui32, llen, local_k,
    dep_local);
}

static void kls_egraph_refactor_apply_btf_scalar_dep(
  kls_egraph_refactor_shared *shared,
  UF_long k1,
  UF_long current_global,
  UF_long dep_local,
  UF_long dep_pos,
  double *ux,
  UF_long **l_indices,
  int32_t **l_indices32,
  double **l_values,
  const UF_long *llen,
  double *x,
  int record_u_value) {
  const UF_long dep_global = k1 + dep_local;
  const double ujk = x[dep_local];
  x[dep_local] = 0.0;
  ux[dep_pos] = ujk;
  if (record_u_value) {
    kls_egraph_record_u_supernode_value(shared, dep_global, current_global,
                                        ujk);
  }

  if (ujk != 0.0) {
    UF_long *li = l_indices[dep_global];
    const int32_t *li32 =
      l_indices32 != NULL ? l_indices32[dep_global] : NULL;
    double *lx = l_values[dep_global];
    UF_long lcol_len = llen[dep_local];
    const float *lx32 =
      shared->use_fp32_l_values && li32 != NULL
        ? shared->solver->refactor_l_values32[dep_global] : NULL;
    if (lx32 != NULL) {
      kls_scatter_subtract_i32_f32(x, li32, lx32, lcol_len, ujk);
    } else if (li32 != NULL || lcol_len == 0u) {
      kls_scatter_subtract_refactor_i32(
        shared->solver, x, li32, lx, lcol_len, ujk);
    } else {
      kls_scatter_subtract(x, li, lx, lcol_len, ujk);
    }
  }
}

static UF_long kls_egraph_btf_scalar_producer_run_len(
  UF_long start_pos,
  UF_long ucol_len,
  const UF_long *ui,
  const int32_t *ui32,
  const unsigned char *applied,
  UF_long local_k) {
  if (start_pos >= ucol_len || (ui == NULL && ui32 == NULL) ||
      (applied != NULL && applied[start_pos])) {
    return 0u;
  }
  const UF_long dep0 =
    ui32 != NULL ? (UF_long)ui32[start_pos] : ui[start_pos];
  if (dep0 >= local_k) {
    return 0u;
  }
  UF_long rows = 1u;
  while (start_pos + rows < ucol_len &&
         rows < KLS_BTF_SCALAR_RUN_EXEC_MAX_ROWS) {
    if (applied != NULL && applied[start_pos + rows]) {
      break;
    }
    if (dep0 > UF_long_max - rows) {
      break;
    }
    const UF_long dep =
      ui32 != NULL ? (UF_long)ui32[start_pos + rows] : ui[start_pos + rows];
    if (dep != dep0 + rows || dep >= local_k) {
      break;
    }
    rows++;
  }
  return rows;
}

static int kls_egraph_refactor_try_btf_scalar_producer_run(
  kls_egraph_refactor_worker *worker,
  UF_long k1,
  UF_long current_global,
  UF_long local_k,
  UF_long *up,
  UF_long ucol_len,
  const UF_long *ui,
  const int32_t *ui32,
  double *ux,
  UF_long **l_indices,
  int32_t **l_indices32,
  double **l_values,
  const UF_long *llen,
  double *x,
  const unsigned char *applied,
  int wait_for_dependencies,
  int record_u_value) {
  if (worker == NULL || worker->shared == NULL || up == NULL ||
      !worker->shared->btf_scalar_run_exec || *up >= ucol_len ||
      (ui == NULL && ui32 == NULL) || ux == NULL || l_indices == NULL ||
      l_values == NULL || llen == NULL || x == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  const int use_sorted_mirror =
    solver != NULL && solver->refactor_l_sorted_enabled &&
    solver->refactor_l_sorted_indices32 != NULL &&
    solver->refactor_l_sorted_values != NULL;
  if (solver == NULL ||
      (!use_sorted_mirror && !solver->refactor_l_indices_sorted)) {
    return 0;
  }
  const UF_long start_pos = *up;
  const UF_long rows =
    kls_egraph_btf_scalar_producer_run_len(
      start_pos, ucol_len, ui, ui32, applied, local_k);
  if (rows < KLS_BTF_SCALAR_RUN_EXEC_MIN_ROWS) {
    return 0;
  }
  const UF_long dep0 =
    ui32 != NULL ? (UF_long)ui32[start_pos] : ui[start_pos];
  if (dep0 > UF_long_max - rows) {
    return 0;
  }
  const UF_long run_end = dep0 + rows;

  double *workspace = kls_egraph_worker_supernode_workspace(worker, rows);
  if (workspace == NULL) {
    return 0;
  }

  UF_long entries = 0u;
  for (UF_long local = 0u; local < rows; ++local) {
    const UF_long dep = dep0 + local;
    if (wait_for_dependencies &&
        !kls_egraph_refactor_wait_done(shared, k1 + dep)) {
      return -1;
    }
    const UF_long lcol_len = llen[dep];
    if (lcol_len > UF_long_max - entries) {
      entries = UF_long_max;
    } else {
      entries += lcol_len;
    }
    const UF_long dep_global = k1 + dep;
    const int32_t *li32 =
      use_sorted_mirror ? solver->refactor_l_sorted_indices32[dep_global]
                        : (l_indices32 != NULL ? l_indices32[dep_global]
                                                : NULL);
    const double *lx_check =
      use_sorted_mirror ? solver->refactor_l_sorted_values[dep_global]
                        : l_values[dep_global];
    if (lcol_len > 0u &&
        (lx_check == NULL || (use_sorted_mirror && li32 == NULL))) {
      return 0;
    }
    if (li32 == NULL && lcol_len != 0u) {
      const UF_long *li = l_indices[dep_global];
      if (li == NULL) {
        return 0;
      }
    }
  }

  for (UF_long local = 0u; local < rows; ++local) {
    const UF_long dep = dep0 + local;
    workspace[local] = x[dep];
    x[dep] = 0.0;
  }

  for (UF_long local = 0u; local < rows; ++local) {
    const UF_long dep = dep0 + local;
    const UF_long dep_global = k1 + dep;
    const double ujk = workspace[local];
    ux[start_pos + local] = ujk;
    if (record_u_value) {
      kls_egraph_record_u_supernode_value(shared, dep_global, current_global,
                                          ujk);
    }
    if (ujk == 0.0) {
      continue;
    }
    const UF_long lcol_len = llen[dep];
    double *lx = use_sorted_mirror
                   ? solver->refactor_l_sorted_values[dep_global]
                   : l_values[dep_global];
    const int32_t *li32 =
      use_sorted_mirror ? solver->refactor_l_sorted_indices32[dep_global]
                        : (l_indices32 != NULL ? l_indices32[dep_global]
                                                : NULL);
    if (li32 != NULL || lcol_len == 0u) {
      UF_long p = 0u;
      for (; p < lcol_len; ++p) {
        const UF_long row = (UF_long)li32[p];
        if (row >= run_end) {
          break;
        }
        workspace[row - dep0] -= ujk * lx[p];
      }
      if (p < lcol_len) {
        kls_scatter_subtract_refactor_i32(
          solver, x, li32 + p, lx + p, lcol_len - p, ujk);
      }
    } else {
      UF_long *li = l_indices[dep_global];
      UF_long p = 0u;
      for (; p < lcol_len; ++p) {
        const UF_long row = li[p];
        if (row >= run_end) {
          break;
        }
        workspace[row - dep0] -= ujk * lx[p];
      }
      if (p < lcol_len) {
        kls_scatter_subtract(x, li + p, lx + p, lcol_len - p, ujk);
      }
    }
  }

  if (shared->btf_scalar_run_stats) {
    kls_egraph_record_btf_scalar_run(shared, rows, entries);
  }
  kls_egraph_record_btf_scalar_run_exec(shared, rows, entries);
  *up = start_pos + rows;
  return 1;
}

static int kls_egraph_refactor_prefactor_u_supernode_ragged_l_run(
  kls_egraph_refactor_worker *worker,
  UF_long k1,
  UF_long current_global,
  UF_long local_k,
  UF_long scan,
  UF_long ucol_len,
  const UF_long *ui,
  const int32_t *ui32,
  double *ux,
  const UF_long *llen,
  double *x,
  const unsigned char *applied,
  int record_u_value,
  UF_long *run_rows_out) {
  if (run_rows_out != NULL) {
    *run_rows_out = 0u;
  }
  if (worker == NULL || worker->shared == NULL ||
      worker->shared->solver == NULL || ui == NULL || ux == NULL ||
      x == NULL || applied == NULL || run_rows_out == NULL ||
      scan >= ucol_len) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (!shared->u_supernode_ragged_l_updates ||
      shared->supernode_algorithm5_payoff_exec ||
      solver->refactor_u_supernode_col_id == NULL ||
      solver->refactor_u_supernode_start == NULL ||
      solver->refactor_u_supernode_local_start == NULL ||
      solver->refactor_u_supernode_width == NULL ||
      solver->refactor_u_supernode_dense_begin == NULL ||
      solver->refactor_u_supernode_l_valid == NULL ||
      solver->refactor_u_supernode_l_row_begin == NULL ||
      solver->refactor_u_supernode_l_row_ptr == NULL ||
      solver->refactor_u_supernode_l_cols == NULL ||
      solver->refactor_u_supernode_l_dense_values == NULL) {
    return 0;
  }

  const UF_long dep0_local = ui32 != NULL ? (UF_long)ui32[scan] : ui[scan];
  if (dep0_local >= local_k || dep0_local > UF_long_max - k1) {
    return 0;
  }
  const UF_long dep0_global = k1 + dep0_local;
  if (dep0_global >= current_global || dep0_global >= solver->n) {
    return 0;
  }
  const UF_long panel = solver->refactor_u_supernode_col_id[dep0_global];
  if (panel == KLS_KLU_EMPTY ||
      panel >= solver->refactor_u_supernode_pattern_count ||
      !solver->refactor_u_supernode_l_valid[panel]) {
    return 0;
  }
  const UF_long start = solver->refactor_u_supernode_start[panel];
  const UF_long local_start =
    solver->refactor_u_supernode_local_start[panel];
  const UF_long width = solver->refactor_u_supernode_width[panel];
  if (width <= 1u || start > dep0_global ||
      dep0_global >= start + width ||
      start > solver->n || width > solver->n - start ||
      local_start > dep0_local ||
      dep0_local - local_start != dep0_global - start) {
    return 0;
  }
  const UF_long panel_offset = dep0_global - start;
  UF_long available_end = width;
  if (start + available_end > current_global) {
    available_end = current_global - start;
  }
  if (available_end > width || available_end <= panel_offset + 1u) {
    return 0;
  }

  UF_long run_rows = 0u;
  while (panel_offset + run_rows < available_end &&
         scan + run_rows < ucol_len) {
    const UF_long pos = scan + run_rows;
    if (applied[pos]) {
      break;
    }
    const UF_long dep_local = ui32 != NULL ? (UF_long)ui32[pos] : ui[pos];
    if (dep_local != dep0_local + run_rows ||
        dep_local >= local_k || dep_local > UF_long_max - k1) {
      break;
    }
    const int safe =
      kls_egraph_btf_prefactor_dep_safe_with_run(
        solver, shared, k1, scan, pos, applied, ui, ui32, llen, local_k,
        dep_local);
    if (safe < 0) {
      return -1;
    }
    if (safe == 0) {
      break;
    }
    run_rows++;
  }
  if (run_rows < 2u) {
    return 0;
  }
  const UF_long run_end = panel_offset + run_rows;
  const UF_long row_base =
    solver->refactor_u_supernode_l_row_begin[panel] + panel_offset;
  if (row_base + run_rows > solver->refactor_u_supernode_pattern_rows) {
    return -1;
  }
  UF_long trailing_entries = 0u;
  for (UF_long local = 0u; local < run_rows; ++local) {
    const UF_long begin =
      solver->refactor_u_supernode_l_row_ptr[row_base + local];
    const UF_long end =
      solver->refactor_u_supernode_l_row_ptr[row_base + local + 1u];
    if (end < begin || end > solver->refactor_u_supernode_l_trailing_entries ||
        end - begin > UF_long_max - trailing_entries) {
      return -1;
    }
    trailing_entries += end - begin;
  }
  const UF_long dense_scatter_cols = width - run_end;
  if (!kls_egraph_ragged_u_supernode_update_allows(
        run_rows, dense_scatter_cols, trailing_entries)) {
    return 0;
  }
  const UF_long *trailing_cols = solver->refactor_u_supernode_l_cols;
  const double *trailing_values = solver->refactor_u_supernode_l_values;
  if (trailing_entries > 0u &&
      (trailing_cols == NULL || trailing_values == NULL)) {
    return -1;
  }
  if (run_rows > (UF_long)(SIZE_MAX / sizeof(double))) {
    return 0;
  }
  double *workspace =
    kls_egraph_worker_supernode_workspace(worker, run_rows);
  if (workspace == NULL) {
    return 0;
  }
  for (UF_long local = 0u; local < run_rows; ++local) {
    const UF_long row = dep0_local + local;
    workspace[local] = x[row];
    x[row] = 0.0;
  }

  const double *dense_panel =
    solver->refactor_u_supernode_l_dense_values +
    solver->refactor_u_supernode_dense_begin[panel];

  for (UF_long local = 0u; local < run_rows; ++local) {
    const UF_long panel_local = panel_offset + local;
    const double ujk = workspace[local];
    ux[scan + local] = ujk;
    if (record_u_value) {
      kls_egraph_record_u_supernode_value(
        shared, start + panel_local, current_global, ujk);
    }
    const double *dense_row = dense_panel + panel_local * width;
    for (UF_long target = panel_local + 1u; target < width; ++target) {
      const double update = ujk * dense_row[target];
      if (target < run_end) {
        workspace[target - panel_offset] -= update;
      } else {
        x[local_start + target] -= update;
      }
    }
    const UF_long row = row_base + local;
    const UF_long begin = solver->refactor_u_supernode_l_row_ptr[row];
    const UF_long end = solver->refactor_u_supernode_l_row_ptr[row + 1u];
    for (UF_long p = begin; p < end; ++p) {
      x[trailing_cols[p]] -= ujk * trailing_values[p];
    }
  }

  const UF_long trsv_entries = (run_rows * (run_rows - 1u)) / 2u;
  const UF_long dense_entries = run_rows * dense_scatter_cols;
  kls_egraph_record_u_supernode_l_update(
    shared, run_rows, trsv_entries + dense_entries + trailing_entries);
  kls_egraph_mark_u_supernode_l_panel_used(solver, panel);
  *run_rows_out = run_rows;
  return 1;
}

static int kls_egraph_refactor_prefactor_finished_btf_deps(
  kls_egraph_refactor_worker *worker,
  UF_long k1,
  UF_long current_global,
  UF_long local_k,
  UF_long blocked_pos,
  UF_long ucol_len,
  const UF_long *ui,
  const int32_t *ui32,
  double *ux,
  UF_long **l_indices,
  double **l_values,
  const UF_long *llen,
  double *x,
  unsigned char *applied,
  int record_u_value,
  UF_long *prefactor_deps_out) {
  if (worker == NULL || worker->shared == NULL ||
      worker->shared->solver == NULL || applied == NULL ||
      prefactor_deps_out == NULL) {
    return 1;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  for (UF_long scan = blocked_pos + 1u; scan < ucol_len; ++scan) {
    if (applied[scan]) {
      continue;
    }
    if (kls_egraph_refactor_should_stop(shared)) {
      return 0;
    }
    const UF_long dep_local =
      ui32 != NULL ? (UF_long)ui32[scan] : ui[scan];
    if (dep_local >= local_k) {
      kls_egraph_refactor_record_invalid(shared);
      return 0;
    }
    UF_long run_rows = 0u;
    const int run_status =
      kls_egraph_refactor_prefactor_u_supernode_ragged_l_run(
        worker, k1, current_global, local_k, scan, ucol_len, ui, ui32, ux,
        llen, x, applied, record_u_value, &run_rows);
    if (run_status < 0) {
      kls_egraph_refactor_record_invalid(shared);
      return 0;
    }
    if (run_status > 0) {
      if (run_rows == 0u || run_rows > ucol_len - scan) {
        kls_egraph_refactor_record_invalid(shared);
        return 0;
      }
      memset(applied + scan, 1, (size_t)run_rows);
      *prefactor_deps_out += run_rows;
      scan += run_rows - 1u;
      continue;
    }
    const int safe =
      kls_egraph_btf_prefactor_dep_safe(
        solver, shared, k1, scan, applied, ui, ui32, llen, local_k,
        dep_local);
    if (safe < 0) {
      kls_egraph_refactor_record_invalid(shared);
      return 0;
    }
    if (safe == 0) {
      continue;
    }
    kls_egraph_refactor_apply_btf_scalar_dep(
      shared, k1, current_global, dep_local, scan, ux, l_indices,
      solver->refactor_l_indices32, l_values, llen, x, record_u_value);
    applied[scan] = 1u;
    (*prefactor_deps_out)++;
  }
  return 1;
}

static int kls_egraph_refactor_single_unscaled_column(
  kls_egraph_refactor_worker *worker,
  UF_long k,
  int wait_for_dependencies) {
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  trilinos_klu_l_numeric *numeric = solver->numeric;
  const trilinos_klu_l_symbolic *symbolic = solver->symbolic;
  double *x = worker->x;
  double *udiag = (double *)numeric->Udiag;
  UF_long **l_indices = solver->refactor_l_indices;
  double **l_values = solver->refactor_l_values;
  UF_long **u_indices = solver->refactor_u_indices;
  double **u_values = solver->refactor_u_values;
  if (solver->refactor_lu_pointer_count != solver->n ||
      l_indices == NULL || l_values == NULL ||
      u_indices == NULL || u_values == NULL) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }

  /* The EGraph dispatcher validates the map, LU arrays, and U topological
     order once before launching workers; keep this hot kernel branch-light. */
  kls_egraph_scatter_unscaled_input(solver, shared->values, x,
                                    solver->refactor_col_ptr[k],
                                    solver->refactor_col_ptr[k + 1u]);

  UF_long *ui = u_indices[k];
  const int32_t *ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[k] : NULL;
  double *ux = u_values[k];
  UF_long ucol_len = kls_egraph_ulen_at(solver, k);
  UF_long up = 0;
  const int supernode_numeric_updates = shared->supernode_numeric_updates;
  const int consumer_plan_group_l_updates =
    shared->supernode_consumer_plan_group_l_exec;
  const int u_supernode_ragged_l_updates =
    shared->u_supernode_ragged_l_updates;
  const int u_supernode_values = shared->u_supernode_values;
  UF_long algorithm5_prefactor_deps = 0u;
  const int algorithm5_prefactor_enabled =
    wait_for_dependencies && shared->algorithm5_prefactor_updates &&
    ucol_len > 1u;
  const int algorithm5_seed_active =
    shared->supernode_algorithm5_payoff_direct_prefix_current_state ||
    shared->supernode_algorithm5_payoff_direct_prefix_advance_seed;
  const int snode_batches_allowed =
    !kls_batch_consume_disabled() && shared->snode_run_end != NULL &&
    !u_supernode_values;
  unsigned char *algorithm5_prefactor_applied = NULL;
  if (algorithm5_seed_active) {
    const int advance_seed_status =
      kls_egraph_refactor_try_seed_algorithm5_payoff_direct_prefix_advance(
        worker, 0u, k, k, &up, ucol_len, ui, ux, x);
    if (advance_seed_status < 0) {
      return 0;
    }
  }
  while (up < ucol_len) {
    if (algorithm5_prefactor_applied != NULL &&
        algorithm5_prefactor_applied[up]) {
      up++;
      continue;
    }
    if (algorithm5_seed_active) {
      const int advance_seed_loop_status =
        kls_egraph_refactor_try_seed_algorithm5_payoff_direct_prefix_advance(
          worker, 0u, k, k, &up, ucol_len, ui, ux, x);
      if (advance_seed_loop_status < 0) {
        return 0;
      }
      if (advance_seed_loop_status > 0) {
        continue;
      }
    }
    const int batch_paths_allowed =
      algorithm5_prefactor_deps == 0u;
    if (batch_paths_allowed && supernode_numeric_updates) {
      const UF_long run_begin = up;
      const int supernode_status =
        kls_egraph_refactor_try_supernode_dependency_run(
          worker, 0u, k, k, &up, ucol_len, ui, ux, l_indices, l_values,
          numeric->Llen, x, wait_for_dependencies);
      if (supernode_status < 0) {
        return 0;
      }
      if (supernode_status > 0) {
        if (algorithm5_prefactor_applied != NULL && up > run_begin) {
          memset(algorithm5_prefactor_applied + run_begin, 1,
                 (size_t)(up - run_begin));
        }
        continue;
      }
    }
    if (batch_paths_allowed && consumer_plan_group_l_updates) {
      const UF_long run_begin = up;
      const int group_l_status =
        kls_egraph_refactor_try_consumer_plan_group_l_run(
          worker, 0u, k, k, &up, ucol_len, ui, ux, x,
          wait_for_dependencies);
      if (group_l_status < 0) {
        return 0;
      }
      if (group_l_status > 0) {
        if (algorithm5_prefactor_applied != NULL && up > run_begin) {
          memset(algorithm5_prefactor_applied + run_begin, 1,
                 (size_t)(up - run_begin));
        }
        continue;
      }
    }
    if (batch_paths_allowed && u_supernode_ragged_l_updates) {
      const UF_long run_begin = up;
      const int ragged_status =
        kls_egraph_refactor_try_u_supernode_ragged_l_run(
          worker, 0u, k, k, &up, ucol_len, ui, ux, x,
          wait_for_dependencies);
      if (ragged_status < 0) {
        return 0;
      }
      if (ragged_status > 0) {
        if (algorithm5_prefactor_applied != NULL && up > run_begin) {
          memset(algorithm5_prefactor_applied + run_begin, 1,
                 (size_t)(up - run_begin));
        }
        continue;
      }
    }
    if (snode_batches_allowed) {
      const UF_long consumed = shared->use_fp32_l_values
        ? kls_snode_batch_consume_cached_f32(
            l_indices, (const int32_t *const *)solver->refactor_l_indices32,
            solver->refactor_l_values32, numeric->Llen, ui, ui32, ux,
            ucol_len, up, x, 0u, k, shared->snode_run_end, shared,
            wait_for_dependencies, algorithm5_prefactor_applied)
        : kls_snode_batch_consume_cached(
            l_indices, l_values, numeric->Llen, ui, ui32, ux, ucol_len, up, x,
            0u, k, shared->snode_run_end, shared, wait_for_dependencies,
            algorithm5_prefactor_applied);
      if (consumed != 0u) {
        if (algorithm5_prefactor_applied != NULL) {
          memset(algorithm5_prefactor_applied + up, 1, (size_t)consumed);
        }
        up += consumed;
        continue;
      }
    }
    if (snode_batches_allowed && solver->padded_run_of != NULL &&
        solver->padded_active && symbolic->nblocks == 1u &&
        algorithm5_prefactor_deps == 0u &&
        algorithm5_prefactor_applied == NULL) {
      const UF_long j0 = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
      const UF_long r1 = solver->padded_run_of[j0];
      int run_ready = r1 != 0u;
      if (run_ready && wait_for_dependencies) {
        const UF_long re0 = solver->padded_run_start[r1 - 1u] +
                            solver->padded_run_len[r1 - 1u];
        for (UF_long c = j0; c < re0; ++c) {
          if (!kls_egraph_refactor_dependency_done_now(shared, c)) {
            run_ready = 0;
            break;
          }
        }
      }
      if (run_ready) {
        const UF_long consumed = kls_padded_run_consume(
          solver, 0u, j0, ui, ux, ucol_len, up, x);
        if (consumed != 0u) {
          up += consumed;
          continue;
        }
      }
    }
    const UF_long j = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
    if (algorithm5_prefactor_enabled &&
        !kls_egraph_refactor_dependency_done_now(shared, j)) {
      if (algorithm5_prefactor_applied == NULL) {
        algorithm5_prefactor_applied =
          kls_egraph_worker_byte_workspace(worker, ucol_len);
        if (algorithm5_prefactor_applied != NULL) {
          memset(algorithm5_prefactor_applied, 0, (size_t)ucol_len);
          if (up > 0u) {
            memset(algorithm5_prefactor_applied, 1, (size_t)up);
          }
        }
      }
      if (algorithm5_prefactor_applied != NULL &&
          !kls_egraph_refactor_prefactor_finished_btf_deps(
            worker, 0u, k, k, up, ucol_len, ui, ui32, ux, l_indices,
            l_values, numeric->Llen, x, algorithm5_prefactor_applied,
            u_supernode_values, &algorithm5_prefactor_deps)) {
        return 0;
      }
    }
    if (wait_for_dependencies &&
        !kls_egraph_refactor_wait_done(shared, j)) {
      return 0;
    }
    const double ujk = x[j];
    x[j] = 0.0;
    ux[up] = ujk;
    if (u_supernode_values) {
      kls_egraph_record_u_supernode_value(shared, j, k, ujk);
    }

    if (ujk != 0.0) {
      UF_long *li = l_indices[j];
      double *lx = l_values[j];
      UF_long lcol_len = kls_egraph_llen_at(solver, j);
      const int32_t *li32 =
        solver->refactor_l_indices32 != NULL
          ? solver->refactor_l_indices32[j] : NULL;
      const float *lx32 =
        shared->use_fp32_l_values && li32 != NULL
          ? solver->refactor_l_values32[j] : NULL;
      if (lx32 != NULL) {
        kls_scatter_subtract_i32_f32(x, li32, lx32, lcol_len, ujk);
      } else {
        kls_scatter_subtract_refactor_l(solver, x, j, li, lx, lcol_len, ujk);
      }
    }
    if (algorithm5_prefactor_applied != NULL) {
      algorithm5_prefactor_applied[up] = 1u;
    }
    up++;
  }

  if (algorithm5_prefactor_deps > 0u) {
    atomic_fetch_add_explicit(&shared->algorithm5_prefactor_columns, 1ul,
                              memory_order_relaxed);
    atomic_fetch_add_explicit(&shared->algorithm5_prefactor_deps,
                              (unsigned long)algorithm5_prefactor_deps,
                              memory_order_relaxed);
  }

  const double ukk = x[k];
  x[k] = 0.0;
  if (ukk == 0.0) {
    kls_egraph_refactor_record_singular(shared, k, symbolic->Q[k]);
    if (solver->common.halt_if_singular) {
      return 0;
    }
  }
  kls_egraph_store_udiag(shared, udiag, k, ukk);
  if (u_supernode_values) {
    kls_egraph_record_u_supernode_value(shared, k, k, ukk);
  }

  UF_long *li = l_indices[k];
  double *lx = l_values[k];
  UF_long lcol_len = kls_egraph_llen_at(solver, k);
  UF_long rejected_row = KLS_KLU_EMPTY;
  UF_long rejected_local_row = KLS_KLU_EMPTY;
  double rejected_multiplier_abs = -1.0;
  double rejected_pivot_abs = -1.0;
  double rejected_candidate_abs = -1.0;
  if (shared->check_pivots &&
      kls_checked_refactor_best_reject_candidate(
        li, lcol_len, x, ukk, solver->common.tol, 0u, &rejected_row,
        &rejected_local_row, &rejected_multiplier_abs, &rejected_pivot_abs,
        &rejected_candidate_abs)) {
    x[rejected_local_row] = 0.0;
    kls_egraph_refactor_record_reject(shared, k, symbolic->Q[k],
                                      rejected_row,
                                      rejected_multiplier_abs,
                                      rejected_pivot_abs,
                                      rejected_candidate_abs);
    return 0;
  }
  kls_egraph_store_l_column_from_workspace(solver, x, k, li, lx, lcol_len,
                                           ukk);
  kls_egraph_publish_u_supernode_l_column(shared, k);
  kls_egraph_publish_consumer_plan_group_l_column(shared, k);
  if (supernode_numeric_updates) {
    kls_egraph_publish_supernode_panel_column(shared, k);
  }
  return 1;
}

/* Once the realized single-block executor has declined every representation-
   changing numeric surface, keep its scalar dependency walk free of the
   corresponding per-dependency tests.  The capability gate is computed once
   per refactor dispatch; this kernel retains the cached strict-supernode
   consumer and the exact scalar arithmetic/storage order of the general
   single-block path. */
static int kls_egraph_refactor_single_unscaled_plain_column(
  kls_egraph_refactor_worker *worker,
  UF_long k,
  int wait_for_dependencies) {
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  trilinos_klu_l_numeric *numeric = solver->numeric;
  const trilinos_klu_l_symbolic *symbolic = solver->symbolic;
  double *restrict x = worker->x;
  double *restrict udiag = (double *)numeric->Udiag;
  UF_long **restrict l_indices = solver->refactor_l_indices;
  int32_t **restrict l_indices32 = solver->refactor_l_indices32;
  double **restrict l_values = solver->refactor_l_values;
  UF_long **restrict u_indices = solver->refactor_u_indices;
  double **restrict u_values = solver->refactor_u_values;
  if (solver->refactor_lu_pointer_count != solver->n ||
      l_indices == NULL || l_values == NULL ||
      u_indices == NULL || u_values == NULL) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }

  kls_egraph_scatter_unscaled_input(solver, shared->values, x,
                                    solver->refactor_col_ptr[k],
                                    solver->refactor_col_ptr[k + 1u]);

  UF_long *restrict ui = u_indices[k];
  const int32_t *restrict ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[k] : NULL;
  double *restrict ux = u_values[k];
  const UF_long ucol_len = kls_egraph_ulen_at(solver, k);
  UF_long up = 0u;
  while (up < ucol_len) {
    const UF_long consumed = kls_snode_batch_consume_cached(
      l_indices, l_values, numeric->Llen, ui, ui32, ux, ucol_len, up, x,
      0u, k, shared->snode_run_end, shared, wait_for_dependencies, NULL);
    if (consumed != 0u) {
      up += consumed;
      continue;
    }

    const UF_long j = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
    if (wait_for_dependencies && shared->pipeline_done != NULL &&
        atomic_load_explicit(&shared->pipeline_done[j],
                             memory_order_acquire) !=
          shared->pipeline_generation &&
        !kls_egraph_refactor_wait_done(shared, j)) {
      return 0;
    }
    const double ujk = x[j];
    x[j] = 0.0;
    ux[up] = ujk;
    if (ujk != 0.0) {
      const UF_long lcol_len = kls_egraph_llen_at(solver, j);
      const int32_t *restrict li32 =
        l_indices32 != NULL ? l_indices32[j] : NULL;
      if (li32 != NULL || lcol_len == 0u) {
        kls_scatter_subtract_refactor_i32(
          solver, x, li32, l_values[j], lcol_len, ujk);
      } else {
        kls_scatter_subtract(x, l_indices[j], l_values[j], lcol_len, ujk);
      }
    }
    up++;
  }

  const double ukk = x[k];
  x[k] = 0.0;
  if (ukk == 0.0) {
    kls_egraph_refactor_record_singular(shared, k, symbolic->Q[k]);
    if (solver->common.halt_if_singular) {
      return 0;
    }
  }
  kls_egraph_store_udiag(shared, udiag, k, ukk);
  kls_egraph_store_l_column_from_workspace(
    solver, x, k, l_indices[k], l_values[k],
    kls_egraph_llen_at(solver, k), ukk);
  return 1;
}

/* Two READY pipeline columns (readiness implies mutual independence)
   processed with one merged dependency walk so producer runs shared by
   both U patterns stream their tail panels once.  Plain configuration
   only; kls_egraph_pair_dispatch_allowed gates the call. */
static int kls_egraph_refactor_single_unscaled_column_pair(
  kls_egraph_refactor_worker *worker,
  UF_long ka,
  UF_long kb) {
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  trilinos_klu_l_numeric *numeric = solver->numeric;
  const trilinos_klu_l_symbolic *symbolic = solver->symbolic;
  double *xa = worker->x;
  double *xb = worker->pair_x;
  double *udiag = (double *)numeric->Udiag;
  UF_long **l_indices = solver->refactor_l_indices;
  double **l_values = solver->refactor_l_values;
  UF_long **u_indices = solver->refactor_u_indices;
  double **u_values = solver->refactor_u_values;
  if (solver->refactor_lu_pointer_count != solver->n ||
      l_indices == NULL || l_values == NULL ||
      u_indices == NULL || u_values == NULL || xb == NULL) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }
  kls_egraph_scatter_unscaled_input(solver, shared->values, xa,
                                    solver->refactor_col_ptr[ka],
                                    solver->refactor_col_ptr[ka + 1u]);
  kls_egraph_scatter_unscaled_input(solver, shared->values, xb,
                                    solver->refactor_col_ptr[kb],
                                    solver->refactor_col_ptr[kb + 1u]);

  UF_long *uia = u_indices[ka];
  UF_long *uib = u_indices[kb];
  const int32_t *uia32 = solver->refactor_u_indices32 != NULL
    ? solver->refactor_u_indices32[ka] : NULL;
  const int32_t *uib32 = solver->refactor_u_indices32 != NULL
    ? solver->refactor_u_indices32[kb] : NULL;
  double *uxa = u_values[ka];
  double *uxb = u_values[kb];
  const UF_long ulen_a = numeric->Ulen[ka];
  const UF_long ulen_b = numeric->Ulen[kb];
  UF_long upa = 0;
  UF_long upb = 0;
  const UF_long producer_limit = ka < kb ? ka : kb;

  /* Cooperative walk: leased pipeline columns are not necessarily ready,
     and one side of the pair may depend (transitively) on the other, so
     no step may block.  Each side advances only through done_now
     dependencies; a completed side finalizes and is marked done
     IMMEDIATELY so chains through it (including the partner's) keep
     moving.  Liveness follows the single-column argument: the earliest
     not-done column's dependencies are all done, so its owner always
     progresses. */
  int a_done = 0;
  int b_done = 0;
  unsigned spin = 0;
  while (!a_done || !b_done) {
    if (kls_egraph_refactor_should_stop(shared)) {
      return 0;
    }
    int progress = 0;
    if (upa < ulen_a && upb < ulen_b) {
      const UF_long ja = uia32 != NULL ? (UF_long)uia32[upa] : uia[upa];
      const UF_long jb = uib32 != NULL ? (UF_long)uib32[upb] : uib[upb];
      if (ja == jb) {
        const UF_long consumed = kls_snode_batch_consume_cached_pair(
          l_indices, l_values, numeric->Llen, uia, uia32, uxa, ulen_a, upa,
          xa, uib, uib32, uxb, ulen_b, upb, xb, 0u, producer_limit,
          shared->snode_run_end, shared, 1);
        if (consumed != 0u) {
          upa += consumed;
          upb += consumed;
          progress = 1;
        }
      }
    }
    if (!progress && upa < ulen_a) {
      const UF_long consumed = kls_snode_batch_consume_cached(
        l_indices, l_values, numeric->Llen, uia, uia32, uxa, ulen_a, upa,
        xa, 0u, ka, shared->snode_run_end, shared, 1, NULL);
      if (consumed != 0u) {
        upa += consumed;
        progress = 1;
      } else {
        const UF_long ja = uia32 != NULL ? (UF_long)uia32[upa] : uia[upa];
        if (kls_egraph_refactor_dependency_done_now(shared, ja)) {
          const double ujk = xa[ja];
          xa[ja] = 0.0;
          uxa[upa] = ujk;
          if (ujk != 0.0) {
            kls_scatter_subtract_refactor_l(solver, xa, ja, l_indices[ja],
                                            l_values[ja], numeric->Llen[ja],
                                            ujk);
          }
          upa++;
          progress = 1;
        }
      }
    }
    if (!progress && upb < ulen_b) {
      const UF_long consumed = kls_snode_batch_consume_cached(
        l_indices, l_values, numeric->Llen, uib, uib32, uxb, ulen_b, upb,
        xb, 0u, kb, shared->snode_run_end, shared, 1, NULL);
      if (consumed != 0u) {
        upb += consumed;
        progress = 1;
      } else {
        const UF_long jb = uib32 != NULL ? (UF_long)uib32[upb] : uib[upb];
        if (kls_egraph_refactor_dependency_done_now(shared, jb)) {
          const double ujk = xb[jb];
          xb[jb] = 0.0;
          uxb[upb] = ujk;
          if (ujk != 0.0) {
            kls_scatter_subtract_refactor_l(solver, xb, jb, l_indices[jb],
                                            l_values[jb], numeric->Llen[jb],
                                            ujk);
          }
          upb++;
          progress = 1;
        }
      }
    }
    if (!a_done && upa >= ulen_a) {
      const double ukka = xa[ka];
      xa[ka] = 0.0;
      if (ukka == 0.0) {
        kls_egraph_refactor_record_singular(shared, ka, symbolic->Q[ka]);
        if (solver->common.halt_if_singular) {
          return 0;
        }
      }
      udiag[ka] = ukka;
      kls_egraph_store_l_column_from_workspace(solver, xa, ka,
                                               l_indices[ka], l_values[ka],
                                               numeric->Llen[ka], ukka);
      kls_egraph_publish_u_supernode_l_column(shared, ka);
      kls_egraph_publish_consumer_plan_group_l_column(shared, ka);
      kls_egraph_refactor_mark_done(shared, ka);
      a_done = 1;
      progress = 1;
    }
    if (!b_done && upb >= ulen_b) {
      const double ukkb = xb[kb];
      xb[kb] = 0.0;
      if (ukkb == 0.0) {
        kls_egraph_refactor_record_singular(shared, kb, symbolic->Q[kb]);
        if (solver->common.halt_if_singular) {
          return 0;
        }
      }
      udiag[kb] = ukkb;
      kls_egraph_store_l_column_from_workspace(solver, xb, kb,
                                               l_indices[kb], l_values[kb],
                                               numeric->Llen[kb], ukkb);
      kls_egraph_publish_u_supernode_l_column(shared, kb);
      kls_egraph_publish_consumer_plan_group_l_column(shared, kb);
      kls_egraph_refactor_mark_done(shared, kb);
      b_done = 1;
      progress = 1;
    }
    if (!progress) {
      kls_cpu_relax();
      kls_egraph_pipeline_pause(&spin);
    }
  }
  return 1;
}

/* k-way fused column walk (k <= KLS_SNODE_MAX_FUSE), the pair walk
   generalized over per-side arrays. Same cooperative contract: leased
   pipeline columns are not necessarily ready and may depend on each
   other, so no step blocks; every side advances only through done_now
   dependencies, aligned sides consume runs fused (panel read once for
   k SPAs), and a completed side finalizes and marks done IMMEDIATELY
   so chains through it keep moving. */
static int kls_egraph_refactor_single_unscaled_column_multi(
  kls_egraph_refactor_worker *worker,
  const UF_long *cols,
  int nc) {
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  trilinos_klu_l_numeric *numeric = solver->numeric;
  const trilinos_klu_l_symbolic *symbolic = solver->symbolic;
  double *udiag = (double *)numeric->Udiag;
  UF_long **l_indices = solver->refactor_l_indices;
  double **l_values = solver->refactor_l_values;
  UF_long **u_indices = solver->refactor_u_indices;
  double **u_values = solver->refactor_u_values;
  double *xv[KLS_SNODE_MAX_FUSE];
  if (solver->refactor_lu_pointer_count != solver->n ||
      l_indices == NULL || l_values == NULL ||
      u_indices == NULL || u_values == NULL || nc < 2 ||
      nc > KLS_SNODE_MAX_FUSE || worker->pair_x == NULL ||
      (nc > 2 && worker->fuse_x == NULL)) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }
  xv[0] = worker->x;
  xv[1] = worker->pair_x;
  for (int c = 2; c < nc; ++c) {
    xv[c] = worker->fuse_x + (size_t)(c - 2) * (size_t)solver->n;
  }
  const UF_long *ui[KLS_SNODE_MAX_FUSE];
  const int32_t *ui32[KLS_SNODE_MAX_FUSE];
  double *ux[KLS_SNODE_MAX_FUSE];
  UF_long ulen[KLS_SNODE_MAX_FUSE];
  UF_long up[KLS_SNODE_MAX_FUSE];
  int done[KLS_SNODE_MAX_FUSE];
  for (int c = 0; c < nc; ++c) {
    const UF_long k = cols[c];
    kls_egraph_scatter_unscaled_input(solver, shared->values, xv[c],
                                      solver->refactor_col_ptr[k],
                                      solver->refactor_col_ptr[k + 1u]);
    ui[c] = u_indices[k];
    ui32[c] = solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[k] : NULL;
    ux[c] = u_values[k];
    ulen[c] = numeric->Ulen[k];
    up[c] = 0;
    done[c] = 0;
  }
  int remaining = nc;
  unsigned spin = 0;
  while (remaining > 0) {
    if (kls_egraph_refactor_should_stop(shared)) {
      return 0;
    }
    int progress = 0;
    const int subset_fusion = solver->eg_subset_choice > 0 ||
      solver->eg_subset_pending == 2;
    if (subset_fusion) {
      /* Fuse every aligned subset in the deck.  Requiring all four consumers
         to share the same current producer made one divergent U stream force
         four independent reads of an otherwise common L panel. */
      unsigned int grouped = 0u;
      for (int seed = 0; seed < nc; ++seed) {
        if ((grouped & (1u << seed)) != 0u || done[seed] ||
            up[seed] >= ulen[seed]) {
          continue;
        }
      const UF_long j0 = ui32[seed] != NULL
        ? (UF_long)ui32[seed][up[seed]] : ui[seed][up[seed]];
      const UF_long *group_ui[KLS_SNODE_MAX_FUSE];
      const int32_t *group_ui32[KLS_SNODE_MAX_FUSE];
      double *group_ux[KLS_SNODE_MAX_FUSE];
      double *group_xv[KLS_SNODE_MAX_FUSE];
      UF_long group_ulen[KLS_SNODE_MAX_FUSE];
      UF_long group_up[KLS_SNODE_MAX_FUSE];
      int members[KLS_SNODE_MAX_FUSE];
      int group_count = 0;
      UF_long group_producer_limit = solver->n;
      for (int c = seed; c < nc; ++c) {
        if ((grouped & (1u << c)) != 0u || done[c] || up[c] >= ulen[c]) {
          continue;
        }
        const UF_long jc = ui32[c] != NULL
          ? (UF_long)ui32[c][up[c]] : ui[c][up[c]];
        if (jc != j0) {
          continue;
        }
        members[group_count] = c;
        group_ui[group_count] = ui[c];
        group_ui32[group_count] = ui32[c];
        group_ux[group_count] = ux[c];
        group_xv[group_count] = xv[c];
        group_ulen[group_count] = ulen[c];
        group_up[group_count] = up[c];
        if (cols[c] < group_producer_limit) {
          group_producer_limit = cols[c];
        }
        grouped |= 1u << c;
        group_count++;
      }
      if (group_count >= 2) {
        const UF_long consumed = kls_snode_batch_consume_cached_multi(
          l_indices, l_values, numeric->Llen, group_count, group_ui,
          group_ui32, group_ux, group_ulen, group_up, group_xv, 0u,
          group_producer_limit, shared->snode_run_end, shared, 1);
        if (consumed != 0u) {
          for (int g = 0; g < group_count; ++g) {
            up[members[g]] += consumed;
          }
          progress = 1;
        }
      }
    }
    } else {
      int all_alive = 1;
      UF_long all_producer_limit = solver->n;
      for (int c = 0; c < nc; ++c) {
        if (done[c] || up[c] >= ulen[c]) {
          all_alive = 0;
          break;
        }
        if (cols[c] < all_producer_limit) {
          all_producer_limit = cols[c];
        }
      }
      if (all_alive) {
        const UF_long j0 = ui32[0] != NULL
          ? (UF_long)ui32[0][up[0]] : ui[0][up[0]];
        int aligned = 1;
        for (int c = 1; c < nc; ++c) {
          const UF_long jc = ui32[c] != NULL
            ? (UF_long)ui32[c][up[c]] : ui[c][up[c]];
          if (jc != j0) {
            aligned = 0;
            break;
          }
        }
        if (aligned) {
          const UF_long consumed = kls_snode_batch_consume_cached_multi(
            l_indices, l_values, numeric->Llen, nc, ui, ui32, ux, ulen,
            up, xv, 0u, all_producer_limit, shared->snode_run_end, shared, 1);
          if (consumed != 0u) {
            for (int c = 0; c < nc; ++c) {
              up[c] += consumed;
            }
            progress = 1;
          }
        }
      }
    }
    /* When the current producer positions are not common, advance every
       ready consumer in this deck before polling the dependency frontier
       again.  The former first-progress break revisited the same four-side
       deck up to four times and repeated the stop/alignment scans even
       though the SPAs are independent.  Each side still advances strictly
       in U order and only through published dependencies. */
    for (int c = 0; c < nc; ++c) {
      if (done[c] || up[c] >= ulen[c]) {
        continue;
      }
      const UF_long consumed = kls_snode_batch_consume_cached(
        l_indices, l_values, numeric->Llen, ui[c], ui32[c], ux[c],
        ulen[c], up[c], xv[c], 0u, cols[c], shared->snode_run_end,
        shared, 1, NULL);
      if (consumed != 0u) {
        up[c] += consumed;
        progress = 1;
        continue;
      }
      const UF_long jc = ui32[c] != NULL
        ? (UF_long)ui32[c][up[c]] : ui[c][up[c]];
      if (kls_egraph_refactor_dependency_done_now(shared, jc)) {
        const double ujk = xv[c][jc];
        xv[c][jc] = 0.0;
        ux[c][up[c]] = ujk;
        if (ujk != 0.0) {
          kls_scatter_subtract_refactor_l(solver, xv[c], jc,
                                          l_indices[jc], l_values[jc],
                                          numeric->Llen[jc], ujk);
        }
        up[c]++;
        progress = 1;
      }
    }
    for (int c = 0; c < nc; ++c) {
      if (!done[c] && up[c] >= ulen[c]) {
        const UF_long k = cols[c];
        const double ukk = xv[c][k];
        xv[c][k] = 0.0;
        if (ukk == 0.0) {
          kls_egraph_refactor_record_singular(shared, k, symbolic->Q[k]);
          if (solver->common.halt_if_singular) {
            return 0;
          }
        }
        udiag[k] = ukk;
        kls_egraph_store_l_column_from_workspace(solver, xv[c], k,
                                                 l_indices[k],
                                                 l_values[k],
                                                 numeric->Llen[k], ukk);
        kls_egraph_publish_u_supernode_l_column(shared, k);
        kls_egraph_publish_consumer_plan_group_l_column(shared, k);
        kls_egraph_refactor_mark_done(shared, k);
        done[c] = 1;
        remaining--;
        progress = 1;
      }
    }
    if (!progress) {
      kls_cpu_relax();
      kls_egraph_pipeline_pause(&spin);
    }
  }
  return 1;
}

static int kls_egraph_refactor_single_scaled_column(
  kls_egraph_refactor_worker *worker,
  UF_long k,
  int wait_for_dependencies) {
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  trilinos_klu_l_numeric *numeric = solver->numeric;
  const trilinos_klu_l_symbolic *symbolic = solver->symbolic;
  double *x = worker->x;
  double *udiag = (double *)numeric->Udiag;
  UF_long **l_indices = solver->refactor_l_indices;
  double **l_values = solver->refactor_l_values;
  UF_long **u_indices = solver->refactor_u_indices;
  double **u_values = solver->refactor_u_values;
  if (solver->refactor_lu_pointer_count != solver->n ||
      l_indices == NULL || l_values == NULL ||
      u_indices == NULL || u_values == NULL ||
      solver->row_idx == NULL || shared->rs == NULL) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }

  if (!kls_egraph_scatter_refactor_input(
        solver, shared->values, shared->rs, shared->scale, x, 0u, solver->n,
        solver->refactor_col_ptr[k], solver->refactor_col_ptr[k + 1u])) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }

  UF_long *ui = u_indices[k];
  const int32_t *ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[k] : NULL;
  double *ux = u_values[k];
  UF_long ucol_len = numeric->Ulen[k];
  UF_long up = 0;
  const int supernode_numeric_updates = shared->supernode_numeric_updates;
  const int consumer_plan_group_l_updates =
    shared->supernode_consumer_plan_group_l_exec;
  const int u_supernode_ragged_l_updates =
    shared->u_supernode_ragged_l_updates;
  const int u_supernode_values = shared->u_supernode_values;
  UF_long algorithm5_prefactor_deps = 0u;
  const int algorithm5_prefactor_enabled =
    wait_for_dependencies && shared->algorithm5_prefactor_updates &&
    ucol_len > 1u;
  const int algorithm5_seed_active =
    shared->supernode_algorithm5_payoff_direct_prefix_current_state ||
    shared->supernode_algorithm5_payoff_direct_prefix_advance_seed;
  const int snode_batches_allowed =
    !kls_batch_consume_disabled() && shared->snode_run_end != NULL &&
    !u_supernode_values;
  unsigned char *algorithm5_prefactor_applied = NULL;
  if (algorithm5_seed_active) {
    const int advance_seed_status =
      kls_egraph_refactor_try_seed_algorithm5_payoff_direct_prefix_advance(
        worker, 0u, k, k, &up, ucol_len, ui, ux, x);
    if (advance_seed_status < 0) {
      return 0;
    }
  }
  while (up < ucol_len) {
    if (algorithm5_prefactor_applied != NULL &&
        algorithm5_prefactor_applied[up]) {
      up++;
      continue;
    }
    if (algorithm5_seed_active) {
      const int advance_seed_loop_status =
        kls_egraph_refactor_try_seed_algorithm5_payoff_direct_prefix_advance(
          worker, 0u, k, k, &up, ucol_len, ui, ux, x);
      if (advance_seed_loop_status < 0) {
        return 0;
      }
      if (advance_seed_loop_status > 0) {
        continue;
      }
    }
    const int batch_paths_allowed =
      algorithm5_prefactor_deps == 0u;
    if (batch_paths_allowed && supernode_numeric_updates) {
      const UF_long run_begin = up;
      const int supernode_status =
        kls_egraph_refactor_try_supernode_dependency_run(
          worker, 0u, k, k, &up, ucol_len, ui, ux, l_indices, l_values,
          numeric->Llen, x, wait_for_dependencies);
      if (supernode_status < 0) {
        return 0;
      }
      if (supernode_status > 0) {
        if (algorithm5_prefactor_applied != NULL && up > run_begin) {
          memset(algorithm5_prefactor_applied + run_begin, 1,
                 (size_t)(up - run_begin));
        }
        continue;
      }
    }
    if (batch_paths_allowed && consumer_plan_group_l_updates) {
      const UF_long run_begin = up;
      const int group_l_status =
        kls_egraph_refactor_try_consumer_plan_group_l_run(
          worker, 0u, k, k, &up, ucol_len, ui, ux, x,
          wait_for_dependencies);
      if (group_l_status < 0) {
        return 0;
      }
      if (group_l_status > 0) {
        if (algorithm5_prefactor_applied != NULL && up > run_begin) {
          memset(algorithm5_prefactor_applied + run_begin, 1,
                 (size_t)(up - run_begin));
        }
        continue;
      }
    }
    if (batch_paths_allowed && u_supernode_ragged_l_updates) {
      const UF_long run_begin = up;
      const int ragged_status =
        kls_egraph_refactor_try_u_supernode_ragged_l_run(
          worker, 0u, k, k, &up, ucol_len, ui, ux, x,
          wait_for_dependencies);
      if (ragged_status < 0) {
        return 0;
      }
      if (ragged_status > 0) {
        if (algorithm5_prefactor_applied != NULL && up > run_begin) {
          memset(algorithm5_prefactor_applied + run_begin, 1,
                 (size_t)(up - run_begin));
        }
        continue;
      }
    }
    if (snode_batches_allowed) {
      const UF_long consumed = shared->use_fp32_l_values
        ? kls_snode_batch_consume_cached_f32(
            l_indices, (const int32_t *const *)solver->refactor_l_indices32,
            solver->refactor_l_values32, numeric->Llen, ui, ui32, ux,
            ucol_len, up, x, 0u, k, shared->snode_run_end, shared,
            wait_for_dependencies, algorithm5_prefactor_applied)
        : kls_snode_batch_consume_cached(
            l_indices, l_values, numeric->Llen, ui, ui32, ux, ucol_len, up, x,
            0u, k, shared->snode_run_end, shared, wait_for_dependencies,
            algorithm5_prefactor_applied);
      if (consumed != 0u) {
        if (algorithm5_prefactor_applied != NULL) {
          memset(algorithm5_prefactor_applied + up, 1, (size_t)consumed);
        }
        up += consumed;
        continue;
      }
    }
    if (snode_batches_allowed && solver->padded_run_of != NULL &&
        solver->padded_active && symbolic->nblocks == 1u &&
        algorithm5_prefactor_deps == 0u &&
        algorithm5_prefactor_applied == NULL) {
      const UF_long j0 = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
      const UF_long r1 = solver->padded_run_of[j0];
      int run_ready = r1 != 0u;
      if (run_ready && wait_for_dependencies) {
        const UF_long re0 = solver->padded_run_start[r1 - 1u] +
                            solver->padded_run_len[r1 - 1u];
        for (UF_long c = j0; c < re0; ++c) {
          if (!kls_egraph_refactor_dependency_done_now(shared, c)) {
            run_ready = 0;
            break;
          }
        }
      }
      if (run_ready) {
        const UF_long consumed = kls_padded_run_consume(
          solver, 0u, j0, ui, ux, ucol_len, up, x);
        if (consumed != 0u) {
          up += consumed;
          continue;
        }
      }
    }
    const UF_long j = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
    if (algorithm5_prefactor_enabled &&
        !kls_egraph_refactor_dependency_done_now(shared, j)) {
      if (algorithm5_prefactor_applied == NULL) {
        algorithm5_prefactor_applied =
          kls_egraph_worker_byte_workspace(worker, ucol_len);
        if (algorithm5_prefactor_applied != NULL) {
          memset(algorithm5_prefactor_applied, 0, (size_t)ucol_len);
          if (up > 0u) {
            memset(algorithm5_prefactor_applied, 1, (size_t)up);
          }
        }
      }
      if (algorithm5_prefactor_applied != NULL &&
          !kls_egraph_refactor_prefactor_finished_btf_deps(
            worker, 0u, k, k, up, ucol_len, ui, ui32, ux, l_indices,
            l_values, numeric->Llen, x, algorithm5_prefactor_applied,
            u_supernode_values, &algorithm5_prefactor_deps)) {
        return 0;
      }
    }
    if (wait_for_dependencies &&
        !kls_egraph_refactor_wait_done(shared, j)) {
      return 0;
    }
    const double ujk = x[j];
    x[j] = 0.0;
    ux[up] = ujk;
    if (u_supernode_values) {
      kls_egraph_record_u_supernode_value(shared, j, k, ujk);
    }

    if (ujk != 0.0) {
      UF_long *li = l_indices[j];
      double *lx = l_values[j];
      UF_long lcol_len = numeric->Llen[j];
      kls_scatter_subtract_refactor_l(solver, x, j, li, lx, lcol_len, ujk);
    }
    if (algorithm5_prefactor_applied != NULL) {
      algorithm5_prefactor_applied[up] = 1u;
    }
    up++;
  }

  if (algorithm5_prefactor_deps > 0u) {
    atomic_fetch_add_explicit(&shared->algorithm5_prefactor_columns, 1ul,
                              memory_order_relaxed);
    atomic_fetch_add_explicit(&shared->algorithm5_prefactor_deps,
                              (unsigned long)algorithm5_prefactor_deps,
                              memory_order_relaxed);
  }

  const double ukk = x[k];
  x[k] = 0.0;
  if (ukk == 0.0) {
    kls_egraph_refactor_record_singular(shared, k, symbolic->Q[k]);
    if (solver->common.halt_if_singular) {
      return 0;
    }
  }
  udiag[k] = ukk;
  if (u_supernode_values) {
    kls_egraph_record_u_supernode_value(shared, k, k, ukk);
  }

  UF_long *li = l_indices[k];
  double *lx = l_values[k];
  UF_long lcol_len = numeric->Llen[k];
  UF_long rejected_row = KLS_KLU_EMPTY;
  UF_long rejected_local_row = KLS_KLU_EMPTY;
  double rejected_multiplier_abs = -1.0;
  double rejected_pivot_abs = -1.0;
  double rejected_candidate_abs = -1.0;
  if (shared->check_pivots &&
      kls_checked_refactor_best_reject_candidate(
        li, lcol_len, x, ukk, solver->common.tol, 0u, &rejected_row,
        &rejected_local_row, &rejected_multiplier_abs, &rejected_pivot_abs,
        &rejected_candidate_abs)) {
    x[rejected_local_row] = 0.0;
    kls_egraph_refactor_record_reject(shared, k, symbolic->Q[k],
                                      rejected_row,
                                      rejected_multiplier_abs,
                                      rejected_pivot_abs,
                                      rejected_candidate_abs);
    return 0;
  }
  kls_egraph_store_l_column_from_workspace(solver, x, k, li, lx, lcol_len,
                                           ukk);
  kls_egraph_publish_u_supernode_l_column(shared, k);
  kls_egraph_publish_consumer_plan_group_l_column(shared, k);
  if (supernode_numeric_updates) {
    kls_egraph_publish_supernode_panel_column(shared, k);
  }
  return 1;
}

/* Cluster levels enter this kernel only after a barrier has published every
   predecessor.  In the normal forced-refactor configuration none of the
   speculative BTF run/group or Algorithm-5 surfaces is active, but routing
   every column through the fully general BTF state machine still performs
   their tests (and a declined helper call per scalar dependency).  Keep a
   deliberately narrow CKTSO-style cluster kernel for that common case.  It
   retains the profitable cached-supernode batch consumer and exactly the
   same scalar arithmetic/storage order as the general no-wait path. */
static int kls_egraph_btf_plain_cluster_allowed(
  const kls_egraph_refactor_shared *shared) {
  return shared != NULL && !shared->check_pivots &&
         !shared->supernode_numeric_updates &&
         !shared->supernode_consumer_plan_group_l_exec &&
         !shared->supernode_consumer_plan_group_l_values &&
         !shared->u_supernode_ragged_l_updates &&
         !shared->u_supernode_values &&
         !shared->algorithm5_prefactor_updates &&
         !shared->supernode_algorithm5_payoff_direct_prefix_current_state &&
         !shared->supernode_algorithm5_payoff_direct_prefix_advance_seed &&
         !shared->supernode_algorithm5_payoff_direct_prefix_complete &&
         !shared->btf_scalar_run_stats &&
         !shared->btf_scalar_run_exec &&
         !shared->btf_scalar_run_group_wait_stats &&
         !shared->btf_scalar_run_group_claims &&
         !shared->btf_scalar_run_group_prefix_stats &&
         !shared->btf_scalar_run_group_wake_stats &&
         !shared->btf_scalar_run_group_state_stats &&
         !shared->btf_scalar_run_group_state_advance_batch_stats &&
         !shared->btf_scalar_run_group_live_step_partial_owner_stats &&
         !shared->btf_scalar_run_group_state_step_advance &&
         !shared->btf_scalar_run_group_state_step_window &&
         !shared->btf_scalar_run_group_state_exec &&
         !shared->use_fp32_l_values;
}

static int kls_egraph_refactor_btf_unscaled_plain_cluster_column(
  kls_egraph_refactor_worker *worker,
  UF_long k,
  int wait_for_dependencies) {
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  trilinos_klu_l_numeric *numeric = solver->numeric;
  const trilinos_klu_l_symbolic *symbolic = solver->symbolic;
  double *restrict x = worker->x;
  double *restrict udiag = (double *)numeric->Udiag;
  UF_long **restrict l_indices = solver->refactor_l_indices;
  int32_t **restrict l_indices32 = solver->refactor_l_indices32;
  double **restrict l_values = solver->refactor_l_values;
  UF_long **restrict u_indices = solver->refactor_u_indices;
  double **restrict u_values = solver->refactor_u_values;
  if (solver->refactor_lu_pointer_count != solver->n ||
      l_indices == NULL || l_values == NULL ||
      u_indices == NULL || u_values == NULL) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }

  const UF_long block = solver->refactor_col_block[k];
  const UF_long k1 = symbolic->R[block];
  const UF_long k2 = symbolic->R[block + 1u];
  const UF_long nk = k2 - k1;
  const UF_long local_k = k - k1;
  UF_long poff = numeric->Offp[k];
  const UF_long poff_end = numeric->Offp[k + 1u];
  if (!kls_egraph_copy_unscaled_offblock_input(
        solver, shared->values, (double *)numeric->Offx, &poff, poff_end,
        solver->refactor_col_ptr[k], solver->refactor_block_start[k])) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }

  if (nk == 1u) {
    double pivot = 0.0;
    for (UF_long p = solver->refactor_block_start[k];
         p < solver->refactor_col_ptr[k + 1u]; ++p) {
      pivot = kls_egraph_unscaled_input_value_at(solver, shared->values, p);
    }
    kls_egraph_store_udiag(shared, udiag, k, pivot);
    if (pivot == 0.0) {
      kls_egraph_refactor_record_singular(shared, k, symbolic->Q[k]);
      if (solver->common.halt_if_singular) {
        return 0;
      }
    }
    return 1;
  }

  UF_long *restrict ui = u_indices[k];
  const int32_t *restrict ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[k] : NULL;
  double *restrict ux = u_values[k];
  const UF_long ucol_len = numeric->Ulen[k];
  const UF_long *restrict llen = numeric->Llen + k1;
  const int snode_batches_allowed =
    !kls_batch_consume_disabled() && shared->snode_run_end != NULL;

  kls_egraph_scatter_btf_unscaled_input(
    solver, shared->values, x, k1, solver->refactor_block_start[k],
    solver->refactor_col_ptr[k + 1u]);

  UF_long up = 0u;
  while (up < ucol_len) {
    if (snode_batches_allowed) {
      const UF_long consumed = kls_snode_batch_consume_cached(
        l_indices, l_values, llen, ui, ui32, ux, ucol_len, up, x, k1,
        local_k, shared->snode_run_end, shared, wait_for_dependencies, NULL);
      if (consumed != 0u) {
        up += consumed;
        continue;
      }
    }
    const UF_long j = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
    if (wait_for_dependencies && shared->pipeline_done != NULL &&
        atomic_load_explicit(&shared->pipeline_done[k1 + j],
                             memory_order_acquire) !=
          shared->pipeline_generation) {
      /* The general wait helper also polls stop/help state.  Keep it for an
         actually late producer; the overwhelmingly common published case
         needs only this inlined acquire instead of a non-inlined call. */
      if (!kls_egraph_refactor_wait_done(shared, k1 + j)) {
        return 0;
      }
    }
    const double ujk = x[j];
    x[j] = 0.0;
    ux[up] = ujk;
    if (ujk != 0.0) {
      const UF_long global_j = k1 + j;
      const UF_long lcol_len = llen[j];
      const int32_t *restrict li32 =
        l_indices32 != NULL ? l_indices32[global_j] : NULL;
      if (li32 != NULL || lcol_len == 0u) {
        kls_scatter_subtract_refactor_i32(
          solver, x, li32, l_values[global_j], lcol_len, ujk);
      } else {
        kls_scatter_subtract(x, l_indices[global_j], l_values[global_j],
                             lcol_len, ujk);
      }
    }
    up++;
  }

  const double ukk = x[local_k];
  x[local_k] = 0.0;
  if (ukk == 0.0) {
    kls_egraph_refactor_record_singular(shared, k, symbolic->Q[k]);
    if (solver->common.halt_if_singular) {
      return 0;
    }
  }
  kls_egraph_store_udiag(shared, udiag, k, ukk);
  UF_long *restrict li = l_indices[k];
  double *restrict lx = l_values[k];
  const UF_long lcol_len = llen[local_k];
  kls_egraph_store_l_column_from_workspace(solver, x, k, li, lx, lcol_len,
                                           ukk);
  return 1;
}

__attribute__((aligned(32)))
static int kls_egraph_refactor_btf_unscaled_column(
  kls_egraph_refactor_worker *worker,
  UF_long k,
  int wait_for_dependencies) {
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  trilinos_klu_l_numeric *numeric = solver->numeric;
  const trilinos_klu_l_symbolic *symbolic = solver->symbolic;
  double *x = worker->x;
  double *udiag = (double *)numeric->Udiag;
  UF_long **l_indices = solver->refactor_l_indices;
  int32_t **l_indices32 = solver->refactor_l_indices32;
  double **l_values = solver->refactor_l_values;
  UF_long **u_indices = solver->refactor_u_indices;
  double **u_values = solver->refactor_u_values;
  if (solver->refactor_lu_pointer_count != solver->n ||
      l_indices == NULL || l_values == NULL ||
      u_indices == NULL || u_values == NULL) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }

  /* The dispatcher validates the map, block metadata, Offx arrays, and
     topological U pattern before launching workers; keep this BTF hot path
     aligned with the branch-light single-block kernel. */
  const UF_long block = solver->refactor_col_block[k];
  const UF_long k1 = symbolic->R[block];
  const UF_long k2 = symbolic->R[block + 1u];
  const UF_long nk = k2 - k1;
  const UF_long local_k = k - k1;

  UF_long poff = numeric->Offp[k];
  const UF_long poff_end = numeric->Offp[k + 1u];
  double *offx = (double *)numeric->Offx;
  if (!kls_egraph_copy_unscaled_offblock_input(
        solver, shared->values, offx, &poff, poff_end,
        solver->refactor_col_ptr[k], solver->refactor_block_start[k])) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }

  if (nk == 1u) {
    double pivot = 0.0;
    for (UF_long p = solver->refactor_block_start[k];
         p < solver->refactor_col_ptr[k + 1u]; ++p) {
      pivot = kls_egraph_unscaled_input_value_at(solver, shared->values, p);
    }
    kls_egraph_store_udiag(shared, udiag, k, pivot);
    if (pivot == 0.0) {
      kls_egraph_refactor_record_singular(shared, k, symbolic->Q[k]);
      if (solver->common.halt_if_singular) {
        return 0;
      }
    }
    return 1;
  }

  UF_long *ui = u_indices[k];
  const int32_t *ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[k] : NULL;
  double *ux = u_values[k];
  UF_long ucol_len = numeric->Ulen[k];
  const int supernode_numeric_updates = shared->supernode_numeric_updates;
  const int consumer_plan_group_l_updates =
    shared->supernode_consumer_plan_group_l_exec;
  const int consumer_plan_group_l_values =
    shared->supernode_consumer_plan_group_l_values;
  const int u_supernode_ragged_l_updates =
    shared->u_supernode_ragged_l_updates;
  const int u_supernode_values = shared->u_supernode_values;
  const int plain_scalar_updates =
    !supernode_numeric_updates && !consumer_plan_group_l_updates &&
    !u_supernode_ragged_l_updates && !u_supernode_values;
  const int snode_batches_allowed =
    !kls_batch_consume_disabled() && shared->snode_run_end != NULL;
  const UF_long *llen = numeric->Llen + k1;
  const int complete_status =
    shared->supernode_algorithm5_payoff_direct_prefix_complete
      ? kls_egraph_refactor_try_complete_algorithm5_payoff_direct_prefix_final_state_btf(
          worker, k1, k, local_k, nk, ucol_len, ui, ui32, ux, udiag,
          l_indices, l_values, llen, wait_for_dependencies,
          supernode_numeric_updates, consumer_plan_group_l_values,
          u_supernode_ragged_l_updates, u_supernode_values)
      : 0;
  if (complete_status < 0) {
    return 0;
  }
  if (complete_status > 0) {
    return 1;
  }

  UF_long up = 0;
  const int restore_btf_group_state_gate =
    plain_scalar_updates &&
    !shared->supernode_algorithm5_payoff_direct_prefix_current_state &&
    !shared->supernode_algorithm5_payoff_direct_prefix_advance_seed;
  if (!restore_btf_group_state_gate) {
    kls_egraph_record_btf_scalar_run_group_state_exec_dispatch_bypass(
      worker, k);
  }
  const int restored_btf_group_state =
    restore_btf_group_state_gate
      ? kls_egraph_refactor_try_restore_btf_scalar_run_group_state(
          worker, k, nk, local_k, ucol_len, ui, ui32, ux, x, 0, &up)
      : 0;
  if (restored_btf_group_state < 0) {
    return 0;
  }
  if (restored_btf_group_state > 1) {
    return 1;
  }
  if (!restored_btf_group_state) {
    kls_egraph_scatter_btf_unscaled_input(
      solver, shared->values, x, k1, solver->refactor_block_start[k],
      solver->refactor_col_ptr[k + 1u]);
  }

  UF_long algorithm5_prefactor_deps = 0u;
  const int algorithm5_prefactor_enabled =
    wait_for_dependencies && shared->algorithm5_prefactor_updates &&
    ucol_len > 1u;
  const int algorithm5_seed_active =
    shared->supernode_algorithm5_payoff_direct_prefix_current_state ||
    shared->supernode_algorithm5_payoff_direct_prefix_advance_seed;
  unsigned char *algorithm5_prefactor_applied = NULL;
  kls_btf_scalar_run_tracker scalar_run_tracker;
  memset(&scalar_run_tracker, 0, sizeof(scalar_run_tracker));
  scalar_run_tracker.enabled =
    shared->btf_scalar_run_stats && plain_scalar_updates;
  if (algorithm5_seed_active) {
    const int advance_seed_status =
      kls_egraph_refactor_try_seed_algorithm5_payoff_direct_prefix_advance(
        worker, k1, k, local_k, &up, ucol_len, ui, ux, x);
    if (advance_seed_status < 0) {
      return 0;
    }
  }
  /* Cluster columns already have their predecessors published; keep that
     CKTSO-style cluster loop free of the per-entry wait check used below. */
  if (plain_scalar_updates) {
    if (wait_for_dependencies) {
      while (up < ucol_len) {
        if (algorithm5_prefactor_applied != NULL &&
            algorithm5_prefactor_applied[up]) {
          up++;
          continue;
        }
        if (algorithm5_seed_active) {
          const int advance_seed_loop_status =
            kls_egraph_refactor_try_seed_algorithm5_payoff_direct_prefix_advance(
              worker, k1, k, local_k, &up, ucol_len, ui, ux, x);
          if (advance_seed_loop_status < 0) {
            return 0;
          }
          if (advance_seed_loop_status > 0) {
            continue;
          }
        }
        if (snode_batches_allowed) {
          const UF_long consumed = shared->use_fp32_l_values
            ? kls_snode_batch_consume_cached_f32(
                l_indices,
                (const int32_t *const *)solver->refactor_l_indices32,
                solver->refactor_l_values32, llen, ui, ui32, ux, ucol_len,
                up, x, k1, local_k, shared->snode_run_end, shared, 1,
                algorithm5_prefactor_applied)
            : kls_snode_batch_consume_cached(
                l_indices, l_values, llen, ui, ui32, ux, ucol_len, up, x, k1,
                local_k, shared->snode_run_end, shared, 1,
                algorithm5_prefactor_applied);
          if (consumed != 0u) {
            if (algorithm5_prefactor_applied != NULL) {
              memset(algorithm5_prefactor_applied + up, 1, (size_t)consumed);
            }
            up += consumed;
            continue;
          }
        }
        if (snode_batches_allowed && solver->padded_run_of != NULL &&
            solver->padded_active &&
            algorithm5_prefactor_applied == NULL) {
          const UF_long j0 = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
          const UF_long r1 = solver->padded_run_of[k1 + j0];
          int run_ready = r1 != 0u;
          if (run_ready) {
            const UF_long re0 = solver->padded_run_start[r1 - 1u] +
                                solver->padded_run_len[r1 - 1u];
            for (UF_long c = k1 + j0; c < re0; ++c) {
              if (!kls_egraph_refactor_dependency_done_now(shared, c)) {
                run_ready = 0;
                break;
              }
            }
          }
          if (run_ready) {
            const UF_long consumed = kls_padded_run_consume(
              solver, k1, j0, ui, ux, ucol_len, up, x);
            if (consumed != 0u) {
              up += consumed;
              continue;
            }
          }
        }
        const UF_long j = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
        if (algorithm5_prefactor_enabled &&
            !kls_egraph_refactor_dependency_done_now(shared, k1 + j)) {
          if (algorithm5_prefactor_applied == NULL) {
            algorithm5_prefactor_applied =
              kls_egraph_worker_byte_workspace(worker, ucol_len);
            if (algorithm5_prefactor_applied != NULL) {
              memset(algorithm5_prefactor_applied, 0, (size_t)ucol_len);
              if (up > 0u) {
                memset(algorithm5_prefactor_applied, 1, (size_t)up);
              }
            }
          }
          if (algorithm5_prefactor_applied != NULL &&
              !kls_egraph_refactor_prefactor_finished_btf_deps(
                worker, k1, k, local_k, up, ucol_len, ui, ui32, ux,
                l_indices, l_values, llen, x, algorithm5_prefactor_applied, 0,
                &algorithm5_prefactor_deps)) {
            return 0;
          }
        }
        const UF_long run_begin = up;
        const int run_status =
          kls_egraph_refactor_try_btf_scalar_producer_run(
            worker, k1, k, local_k, &up, ucol_len, ui, ui32, ux, l_indices,
            l_indices32, l_values, llen, x, algorithm5_prefactor_applied, 1,
            0);
        if (run_status < 0) {
          return 0;
        }
        if (run_status > 0) {
          if (algorithm5_prefactor_applied != NULL && up > run_begin) {
            memset(algorithm5_prefactor_applied + run_begin, 1,
                   (size_t)(up - run_begin));
          }
          continue;
        }
        UF_long wait_group = KLS_KLU_EMPTY;
        int wait_group_active = 0;
        if (shared->btf_scalar_run_group_wait_stats &&
            !kls_egraph_refactor_dependency_done_now(shared, k1 + j)) {
          UF_long wait_rows = 0u;
          wait_group =
            kls_refactor_btf_scalar_run_group_for_current(
              solver, k1 + j, k, up, &wait_rows);
          if (wait_group != KLS_KLU_EMPTY) {
            const UF_long wait_entries =
              kls_btf_scalar_run_l_entries(solver, k1 + j, wait_rows);
            wait_group_active =
              kls_egraph_record_btf_scalar_run_group_wait_begin(
                shared, wait_group, wait_rows, wait_entries);
          }
        }
        if (!kls_egraph_refactor_wait_done(shared, k1 + j)) {
          if (wait_group_active) {
            kls_egraph_record_btf_scalar_run_group_wait_end(
              shared, wait_group);
          }
          return 0;
        }
        if (wait_group_active) {
          kls_egraph_record_btf_scalar_run_group_wait_end(
            shared, wait_group);
        }
        kls_btf_scalar_run_tracker_note(
          shared, &scalar_run_tracker, up, j, llen[j]);
        kls_egraph_refactor_apply_btf_scalar_dep(
          shared, k1, k, j, up, ux, l_indices, l_indices32, l_values,
          llen, x, 0);
        if (algorithm5_prefactor_applied != NULL) {
          algorithm5_prefactor_applied[up] = 1u;
        }
        up++;
      }
    } else {
      while (up < ucol_len) {
        if (snode_batches_allowed) {
          const UF_long consumed = shared->use_fp32_l_values
            ? kls_snode_batch_consume_cached_f32(
                l_indices,
                (const int32_t *const *)solver->refactor_l_indices32,
                solver->refactor_l_values32, llen, ui, ui32, ux, ucol_len,
                up, x, k1, local_k, shared->snode_run_end, shared, 0, NULL)
            : kls_snode_batch_consume_cached(
                l_indices, l_values, llen, ui, ui32, ux, ucol_len, up, x, k1,
                local_k, shared->snode_run_end, shared, 0, NULL);
          if (consumed != 0u) {
            up += consumed;
            continue;
          }
        }
        const int run_status =
          kls_egraph_refactor_try_btf_scalar_producer_run(
            worker, k1, k, local_k, &up, ucol_len, ui, ui32, ux, l_indices,
            l_indices32, l_values, llen, x, NULL, 0, 0);
        if (run_status < 0) {
          return 0;
        }
        if (run_status > 0) {
          continue;
        }
        const UF_long j = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
        kls_btf_scalar_run_tracker_note(
          shared, &scalar_run_tracker, up, j, llen[j]);
        kls_egraph_refactor_apply_btf_scalar_dep(
          shared, k1, k, j, up, ux, l_indices, l_indices32, l_values,
          llen, x, 0);
        up++;
      }
    }
  } else if (wait_for_dependencies) {
    while (up < ucol_len) {
      if (algorithm5_prefactor_applied != NULL &&
          algorithm5_prefactor_applied[up]) {
        up++;
        continue;
      }
      if (algorithm5_seed_active) {
        const int advance_seed_loop_status =
          kls_egraph_refactor_try_seed_algorithm5_payoff_direct_prefix_advance(
            worker, k1, k, local_k, &up, ucol_len, ui, ux, x);
        if (advance_seed_loop_status < 0) {
          return 0;
        }
        if (advance_seed_loop_status > 0) {
          continue;
        }
      }
      const int batch_paths_allowed =
        algorithm5_prefactor_deps == 0u;
      if (batch_paths_allowed && supernode_numeric_updates) {
        const UF_long run_begin = up;
        const int supernode_status =
          kls_egraph_refactor_try_supernode_dependency_run(
            worker, k1, k, local_k, &up, ucol_len, ui, ux, l_indices,
            l_values, numeric->Llen, x, 1);
        if (supernode_status < 0) {
          return 0;
        }
        if (supernode_status > 0) {
          if (algorithm5_prefactor_applied != NULL && up > run_begin) {
            memset(algorithm5_prefactor_applied + run_begin, 1,
                   (size_t)(up - run_begin));
          }
          continue;
        }
      }
      if (batch_paths_allowed && consumer_plan_group_l_updates) {
        const UF_long run_begin = up;
        const int group_l_status =
          kls_egraph_refactor_try_consumer_plan_group_l_run(
            worker, k1, k, local_k, &up, ucol_len, ui, ux, x, 1);
        if (group_l_status < 0) {
          return 0;
        }
        if (group_l_status > 0) {
          if (algorithm5_prefactor_applied != NULL && up > run_begin) {
            memset(algorithm5_prefactor_applied + run_begin, 1,
                   (size_t)(up - run_begin));
          }
          continue;
        }
      }
      if (batch_paths_allowed && u_supernode_ragged_l_updates) {
        const UF_long run_begin = up;
        const int ragged_status =
          kls_egraph_refactor_try_u_supernode_ragged_l_run(
            worker, k1, k, local_k, &up, ucol_len, ui, ux, x, 1);
        if (ragged_status < 0) {
          return 0;
        }
        if (ragged_status > 0) {
          if (algorithm5_prefactor_applied != NULL && up > run_begin) {
            memset(algorithm5_prefactor_applied + run_begin, 1,
                   (size_t)(up - run_begin));
          }
          continue;
        }
      }
      const UF_long j = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
      if (algorithm5_prefactor_enabled &&
          !kls_egraph_refactor_dependency_done_now(shared, k1 + j)) {
        if (algorithm5_prefactor_applied == NULL) {
          algorithm5_prefactor_applied =
            kls_egraph_worker_byte_workspace(worker, ucol_len);
          if (algorithm5_prefactor_applied != NULL) {
            memset(algorithm5_prefactor_applied, 0, (size_t)ucol_len);
            if (up > 0u) {
              memset(algorithm5_prefactor_applied, 1, (size_t)up);
            }
          }
        }
        if (algorithm5_prefactor_applied != NULL &&
            !kls_egraph_refactor_prefactor_finished_btf_deps(
              worker, k1, k, local_k, up, ucol_len, ui, ui32, ux,
              l_indices, l_values, llen, x, algorithm5_prefactor_applied,
              u_supernode_values, &algorithm5_prefactor_deps)) {
          return 0;
        }
      }
      if (!kls_egraph_refactor_wait_done(shared, k1 + j)) {
        return 0;
      }
      kls_egraph_refactor_apply_btf_scalar_dep(
        shared, k1, k, j, up, ux, l_indices, l_indices32, l_values,
        llen, x, u_supernode_values);
      if (algorithm5_prefactor_applied != NULL) {
        algorithm5_prefactor_applied[up] = 1u;
      }
      up++;
    }
  } else {
    while (up < ucol_len) {
      if (supernode_numeric_updates) {
        const int supernode_status =
          kls_egraph_refactor_try_supernode_dependency_run(
            worker, k1, k, local_k, &up, ucol_len, ui, ux, l_indices,
            l_values, numeric->Llen, x, 0);
        if (supernode_status < 0) {
          return 0;
        }
        if (supernode_status > 0) {
          continue;
        }
      }
      if (consumer_plan_group_l_updates) {
        const int group_l_status =
          kls_egraph_refactor_try_consumer_plan_group_l_run(
            worker, k1, k, local_k, &up, ucol_len, ui, ux, x, 0);
        if (group_l_status < 0) {
          return 0;
        }
        if (group_l_status > 0) {
          continue;
        }
      }
      if (u_supernode_ragged_l_updates) {
        const int ragged_status =
          kls_egraph_refactor_try_u_supernode_ragged_l_run(
            worker, k1, k, local_k, &up, ucol_len, ui, ux, x, 0);
        if (ragged_status < 0) {
          return 0;
        }
        if (ragged_status > 0) {
          continue;
        }
      }
      const UF_long j = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
      const double ujk = x[j];
      x[j] = 0.0;
      ux[up] = ujk;
      if (u_supernode_values) {
        kls_egraph_record_u_supernode_value(shared, k1 + j, k, ujk);
      }

      if (ujk != 0.0) {
        UF_long *li = l_indices[k1 + j];
        const int32_t *li32 =
          l_indices32 != NULL ? l_indices32[k1 + j] : NULL;
        double *lx = l_values[k1 + j];
        UF_long lcol_len = llen[j];
        const float *lx32 =
          shared->use_fp32_l_values && li32 != NULL
            ? solver->refactor_l_values32[k1 + j] : NULL;
        if (lx32 != NULL) {
          kls_scatter_subtract_i32_f32(x, li32, lx32, lcol_len, ujk);
        } else if (li32 != NULL || lcol_len == 0u) {
          kls_scatter_subtract_refactor_i32(
            solver, x, li32, lx, lcol_len, ujk);
        } else {
          kls_scatter_subtract(x, li, lx, lcol_len, ujk);
        }
      }
      up++;
    }
  }
  kls_btf_scalar_run_tracker_flush(shared, &scalar_run_tracker);

  if (algorithm5_prefactor_deps > 0u) {
    atomic_fetch_add_explicit(&shared->algorithm5_prefactor_columns, 1ul,
                              memory_order_relaxed);
    atomic_fetch_add_explicit(&shared->algorithm5_prefactor_deps,
                              (unsigned long)algorithm5_prefactor_deps,
                              memory_order_relaxed);
  }

  const double ukk = x[local_k];
  x[local_k] = 0.0;
  if (ukk == 0.0) {
    kls_egraph_refactor_record_singular(shared, k, symbolic->Q[k]);
    if (solver->common.halt_if_singular) {
      return 0;
    }
  }
  kls_egraph_store_udiag(shared, udiag, k, ukk);
  if (u_supernode_values) {
    kls_egraph_record_u_supernode_value(shared, k, k, ukk);
  }

  UF_long *li = l_indices[k];
  double *lx = l_values[k];
  UF_long lcol_len = llen[local_k];
  UF_long rejected_row = KLS_KLU_EMPTY;
  UF_long rejected_local_row = KLS_KLU_EMPTY;
  double rejected_multiplier_abs = -1.0;
  double rejected_pivot_abs = -1.0;
  double rejected_candidate_abs = -1.0;
  if (shared->check_pivots &&
      kls_checked_refactor_best_reject_candidate(
        li, lcol_len, x, ukk, solver->common.tol, k1, &rejected_row,
        &rejected_local_row, &rejected_multiplier_abs, &rejected_pivot_abs,
        &rejected_candidate_abs)) {
    x[rejected_local_row] = 0.0;
    kls_egraph_refactor_record_reject(shared, k, symbolic->Q[k],
                                      rejected_row,
                                      rejected_multiplier_abs,
                                      rejected_pivot_abs,
                                      rejected_candidate_abs);
    return 0;
  }
  kls_egraph_store_l_column_from_workspace(solver, x, k, li, lx, lcol_len,
                                           ukk);
  if (u_supernode_ragged_l_updates) {
    kls_egraph_publish_u_supernode_l_column(shared, k);
  }
  if (consumer_plan_group_l_values) {
    kls_egraph_publish_consumer_plan_group_l_column(shared, k);
  }
  if (supernode_numeric_updates) {
    kls_egraph_publish_supernode_panel_column(shared, k);
  }
  return 1;
}

/* One L-column stream feeding two consumer SPAs: the scalar-dep twin of
   the fused batch (2 fmas per streamed value + one shared index load). */
static KLS_ALWAYS_INLINE void kls_scatter_subtract_pair_i32(
  double *restrict xa,
  double *restrict xb,
  const int32_t *restrict rows,
  const double *restrict values,
  UF_long length,
  double ua,
  double ub) {
  for (UF_long p = 0; p < length; ++p) {
    const UF_long row = (UF_long)rows[p];
    const double v = values[p];
    xa[row] -= ua * v;
    xb[row] -= ub * v;
  }
}

static KLS_ALWAYS_INLINE void kls_scatter_subtract_pair(
  double *restrict xa,
  double *restrict xb,
  const UF_long *restrict rows,
  const double *restrict values,
  UF_long length,
  double ua,
  double ub) {
  for (UF_long p = 0; p < length; ++p) {
    const UF_long row = rows[p];
    const double v = values[p];
    xa[row] -= ua * v;
    xb[row] -= ub * v;
  }
}

/* BTF twin of the single-unscaled pair: two leased same-block columns
   walked cooperatively so shared producer runs stream once.  The group
   state machinery is informed via the existing dispatch-bypass branch;
   the fp64 scalar-run exec is skipped (it either blocks or assumes done
   dependencies) - declined batch positions go through done_now-gated
   scalars.  Caller guarantees the plain flag surface and same block. */
static int kls_egraph_refactor_btf_unscaled_column_pair(
  kls_egraph_refactor_worker *worker,
  UF_long ka,
  UF_long kb) {
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  trilinos_klu_l_numeric *numeric = solver->numeric;
  const trilinos_klu_l_symbolic *symbolic = solver->symbolic;
  double *xa = worker->x;
  double *xb = worker->pair_x;
  double *udiag = (double *)numeric->Udiag;
  UF_long **l_indices = solver->refactor_l_indices;
  int32_t **l_indices32 = solver->refactor_l_indices32;
  double **l_values = solver->refactor_l_values;
  UF_long **u_indices = solver->refactor_u_indices;
  double **u_values = solver->refactor_u_values;
  if (solver->refactor_lu_pointer_count != solver->n ||
      l_indices == NULL || l_values == NULL ||
      u_indices == NULL || u_values == NULL || xb == NULL) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }
  const UF_long block = solver->refactor_col_block[ka];
  const UF_long k1 = symbolic->R[block];
  const UF_long local_a = ka - k1;
  const UF_long local_b = kb - k1;
  const UF_long *llen = numeric->Llen + k1;

  UF_long poff = numeric->Offp[ka];
  double *offx = (double *)numeric->Offx;
  if (!kls_egraph_copy_unscaled_offblock_input(
        solver, shared->values, offx, &poff, numeric->Offp[ka + 1u],
        solver->refactor_col_ptr[ka], solver->refactor_block_start[ka])) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }
  poff = numeric->Offp[kb];
  if (!kls_egraph_copy_unscaled_offblock_input(
        solver, shared->values, offx, &poff, numeric->Offp[kb + 1u],
        solver->refactor_col_ptr[kb], solver->refactor_block_start[kb])) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }
  kls_egraph_record_btf_scalar_run_group_state_exec_dispatch_bypass(worker,
                                                                    ka);
  kls_egraph_record_btf_scalar_run_group_state_exec_dispatch_bypass(worker,
                                                                    kb);
  kls_egraph_scatter_btf_unscaled_input(
    solver, shared->values, xa, k1, solver->refactor_block_start[ka],
    solver->refactor_col_ptr[ka + 1u]);
  kls_egraph_scatter_btf_unscaled_input(
    solver, shared->values, xb, k1, solver->refactor_block_start[kb],
    solver->refactor_col_ptr[kb + 1u]);

  UF_long *uia = u_indices[ka];
  UF_long *uib = u_indices[kb];
  const int32_t *uia32 = solver->refactor_u_indices32 != NULL
    ? solver->refactor_u_indices32[ka] : NULL;
  const int32_t *uib32 = solver->refactor_u_indices32 != NULL
    ? solver->refactor_u_indices32[kb] : NULL;
  double *uxa = u_values[ka];
  double *uxb = u_values[kb];
  const UF_long ulen_a = numeric->Ulen[ka];
  const UF_long ulen_b = numeric->Ulen[kb];
  UF_long upa = 0;
  UF_long upb = 0;
  const UF_long producer_limit = local_a < local_b ? local_a : local_b;

  int a_done = 0;
  int b_done = 0;
  unsigned spin = 0;
  while (!a_done || !b_done) {
    if (kls_egraph_refactor_should_stop(shared)) {
      return 0;
    }
    int progress = 0;
    if (upa < ulen_a && upb < ulen_b) {
      const UF_long ja = uia32 != NULL ? (UF_long)uia32[upa] : uia[upa];
      const UF_long jb = uib32 != NULL ? (UF_long)uib32[upb] : uib[upb];
      if (ja == jb) {
        const UF_long consumed = kls_snode_batch_consume_cached_pair(
          l_indices, l_values, llen, uia, uia32, uxa, ulen_a, upa, xa,
          uib, uib32, uxb, ulen_b, upb, xb, k1, producer_limit,
          shared->snode_run_end, shared, 1);
        if (consumed != 0u) {
          upa += consumed;
          upb += consumed;
          progress = 1;
        } else if (kls_egraph_refactor_dependency_done_now(shared,
                                                           k1 + ja)) {
          const double ua = xa[ja];
          const double ub = xb[ja];
          xa[ja] = 0.0;
          xb[ja] = 0.0;
          uxa[upa] = ua;
          uxb[upb] = ub;
          if (ua != 0.0 || ub != 0.0) {
            const UF_long dep_global = k1 + ja;
            const int32_t *li32 =
              l_indices32 != NULL ? l_indices32[dep_global] : NULL;
            const double *lx = l_values[dep_global];
            const UF_long lcol_len = llen[ja];
            if (li32 != NULL || lcol_len == 0u) {
              kls_scatter_subtract_pair_i32(xa, xb, li32, lx, lcol_len, ua,
                                            ub);
            } else {
              kls_scatter_subtract_pair(xa, xb, l_indices[dep_global], lx,
                                        lcol_len, ua, ub);
            }
            if (kls_snode_trace_enabled()) {
              kls_snode_trace_pair_producers += 1u;
            }
          }
          upa++;
          upb++;
          progress = 1;
        }
      }
    }
    if (!progress && upa < ulen_a) {
      const UF_long consumed = kls_snode_batch_consume_cached(
        l_indices, l_values, llen, uia, uia32, uxa, ulen_a, upa, xa, k1,
        local_a, shared->snode_run_end, shared, 1, NULL);
      if (consumed != 0u) {
        upa += consumed;
        progress = 1;
      } else {
        const UF_long ja = uia32 != NULL ? (UF_long)uia32[upa] : uia[upa];
        if (kls_egraph_refactor_dependency_done_now(shared, k1 + ja)) {
          kls_egraph_refactor_apply_btf_scalar_dep(
            shared, k1, ka, ja, upa, uxa, l_indices, l_indices32, l_values,
            llen, xa, 0);
          upa++;
          progress = 1;
        }
      }
    }
    if (!progress && upb < ulen_b) {
      const UF_long consumed = kls_snode_batch_consume_cached(
        l_indices, l_values, llen, uib, uib32, uxb, ulen_b, upb, xb, k1,
        local_b, shared->snode_run_end, shared, 1, NULL);
      if (consumed != 0u) {
        upb += consumed;
        progress = 1;
      } else {
        const UF_long jb = uib32 != NULL ? (UF_long)uib32[upb] : uib[upb];
        if (kls_egraph_refactor_dependency_done_now(shared, k1 + jb)) {
          kls_egraph_refactor_apply_btf_scalar_dep(
            shared, k1, kb, jb, upb, uxb, l_indices, l_indices32, l_values,
            llen, xb, 0);
          upb++;
          progress = 1;
        }
      }
    }
    if (!a_done && upa >= ulen_a) {
      const double ukka = xa[local_a];
      xa[local_a] = 0.0;
      if (ukka == 0.0) {
        kls_egraph_refactor_record_singular(shared, ka, symbolic->Q[ka]);
        if (solver->common.halt_if_singular) {
          return 0;
        }
      }
      kls_egraph_store_udiag(shared, udiag, ka, ukka);
      kls_egraph_store_l_column_from_workspace(solver, xa, ka,
                                               l_indices[ka], l_values[ka],
                                               llen[local_a], ukka);
      kls_egraph_refactor_mark_done(shared, ka);
      a_done = 1;
      progress = 1;
    }
    if (!b_done && upb >= ulen_b) {
      const double ukkb = xb[local_b];
      xb[local_b] = 0.0;
      if (ukkb == 0.0) {
        kls_egraph_refactor_record_singular(shared, kb, symbolic->Q[kb]);
        if (solver->common.halt_if_singular) {
          return 0;
        }
      }
      kls_egraph_store_udiag(shared, udiag, kb, ukkb);
      kls_egraph_store_l_column_from_workspace(solver, xb, kb,
                                               l_indices[kb], l_values[kb],
                                               llen[local_b], ukkb);
      kls_egraph_refactor_mark_done(shared, kb);
      b_done = 1;
      progress = 1;
    }
    if (!progress) {
      kls_cpu_relax();
      kls_egraph_pipeline_pause(&spin);
    }
  }
  return 1;
}

/* k-way counterpart of the BTF pair walk.  All columns belong to one BTF
   block, so their SPAs use the same local row frame.  Ready/pipeline leases
   are still only ownership claims: a side advances solely through published
   dependencies and publishes immediately on completion.  Consequently this
   is the same dependency-safe algorithm as the pair kernel, while a common
   producer's L stream can feed up to four independent consumer SPAs. */
static int kls_egraph_refactor_btf_unscaled_column_multi(
  kls_egraph_refactor_worker *worker,
  const UF_long *cols,
  int nc) {
  if (worker == NULL || worker->shared == NULL || cols == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || solver->symbolic == NULL || solver->numeric == NULL) {
    return 0;
  }
  trilinos_klu_l_numeric *numeric = solver->numeric;
  const trilinos_klu_l_symbolic *symbolic = solver->symbolic;
  double *udiag = (double *)numeric->Udiag;
  UF_long **l_indices = solver->refactor_l_indices;
  int32_t **l_indices32 = solver->refactor_l_indices32;
  double **l_values = solver->refactor_l_values;
  UF_long **u_indices = solver->refactor_u_indices;
  double **u_values = solver->refactor_u_values;
  if (solver->refactor_lu_pointer_count != solver->n ||
      solver->refactor_col_block == NULL ||
      solver->refactor_col_ptr == NULL ||
      solver->refactor_block_start == NULL || numeric->Offp == NULL ||
      numeric->Offx == NULL || udiag == NULL || l_indices == NULL ||
      l_values == NULL || u_indices == NULL || u_values == NULL || nc < 2 ||
      nc > KLS_SNODE_MAX_FUSE || worker->pair_x == NULL ||
      (nc > 2 && worker->fuse_x == NULL)) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }

  const UF_long block = solver->refactor_col_block[cols[0]];
  if (block >= symbolic->nblocks) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }
  const UF_long k1 = symbolic->R[block];
  const UF_long k2 = symbolic->R[block + 1u];
  if (k2 <= k1 + 1u || k2 > solver->n) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }
  const UF_long *llen = numeric->Llen + k1;
  double *xv[KLS_SNODE_MAX_FUSE];
  xv[0] = worker->x;
  xv[1] = worker->pair_x;
  for (int c = 2; c < nc; ++c) {
    xv[c] = worker->fuse_x + (size_t)(c - 2) * (size_t)solver->n;
  }

  const UF_long *ui[KLS_SNODE_MAX_FUSE];
  const int32_t *ui32[KLS_SNODE_MAX_FUSE];
  double *ux[KLS_SNODE_MAX_FUSE];
  UF_long ulen[KLS_SNODE_MAX_FUSE];
  UF_long up[KLS_SNODE_MAX_FUSE];
  UF_long local_col[KLS_SNODE_MAX_FUSE];
  int done[KLS_SNODE_MAX_FUSE];
  UF_long producer_limit = k2 - k1;
  double *offx = (double *)numeric->Offx;
  for (int c = 0; c < nc; ++c) {
    const UF_long k = cols[c];
    if (k < k1 || k >= k2 || solver->refactor_col_block[k] != block) {
      kls_egraph_refactor_record_invalid(shared);
      return 0;
    }
    local_col[c] = k - k1;
    if (local_col[c] < producer_limit) {
      producer_limit = local_col[c];
    }
    UF_long poff = numeric->Offp[k];
    if (!kls_egraph_copy_unscaled_offblock_input(
          solver, shared->values, offx, &poff, numeric->Offp[k + 1u],
          solver->refactor_col_ptr[k], solver->refactor_block_start[k])) {
      kls_egraph_refactor_record_invalid(shared);
      return 0;
    }
    kls_egraph_record_btf_scalar_run_group_state_exec_dispatch_bypass(worker,
                                                                      k);
    kls_egraph_scatter_btf_unscaled_input(
      solver, shared->values, xv[c], k1, solver->refactor_block_start[k],
      solver->refactor_col_ptr[k + 1u]);
    ui[c] = u_indices[k];
    ui32[c] = solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[k] : NULL;
    ux[c] = u_values[k];
    ulen[c] = numeric->Ulen[k];
    up[c] = 0u;
    done[c] = 0;
  }

  int remaining = nc;
  unsigned spin = 0u;
  while (remaining > 0) {
    if (kls_egraph_refactor_should_stop(shared)) {
      return 0;
    }
    int progress = 0;
    int all_alive = 1;
    for (int c = 0; c < nc; ++c) {
      if (done[c] || up[c] >= ulen[c]) {
        all_alive = 0;
        break;
      }
    }
    if (all_alive) {
      const UF_long j0 = ui32[0] != NULL
        ? (UF_long)ui32[0][up[0]] : ui[0][up[0]];
      int aligned = 1;
      for (int c = 1; c < nc; ++c) {
        const UF_long jc = ui32[c] != NULL
          ? (UF_long)ui32[c][up[c]] : ui[c][up[c]];
        if (jc != j0) {
          aligned = 0;
          break;
        }
      }
      if (aligned) {
        const UF_long consumed = kls_snode_batch_consume_cached_multi(
          l_indices, l_values, llen, nc, ui, ui32, ux, ulen, up, xv, k1,
          producer_limit, shared->snode_run_end, shared, 1);
        if (consumed != 0u) {
          for (int c = 0; c < nc; ++c) {
            up[c] += consumed;
          }
          progress = 1;
        } else if (kls_egraph_refactor_dependency_done_now(shared,
                                                            k1 + j0)) {
          /* Scalar aligned producers are worth fusing too: read each L row
             and value once, then update every independent SPA. */
          double u[KLS_SNODE_MAX_FUSE];
          int any_nonzero = 0;
          for (int c = 0; c < nc; ++c) {
            u[c] = xv[c][j0];
            xv[c][j0] = 0.0;
            ux[c][up[c]] = u[c];
            any_nonzero |= u[c] != 0.0;
          }
          if (any_nonzero) {
            const UF_long dep_global = k1 + j0;
            const UF_long length = llen[j0];
            const int32_t *rows32 =
              l_indices32 != NULL ? l_indices32[dep_global] : NULL;
            const double *values = l_values[dep_global];
            if (rows32 != NULL || length == 0u) {
              for (UF_long p = 0u; p < length; ++p) {
                const UF_long row = (UF_long)rows32[p];
                const double value = values[p];
                for (int c = 0; c < nc; ++c) {
                  xv[c][row] -= u[c] * value;
                }
              }
            } else {
              const UF_long *rows = l_indices[dep_global];
              for (UF_long p = 0u; p < length; ++p) {
                const UF_long row = rows[p];
                const double value = values[p];
                for (int c = 0; c < nc; ++c) {
                  xv[c][row] -= u[c] * value;
                }
              }
            }
          }
          for (int c = 0; c < nc; ++c) {
            up[c]++;
          }
          progress = 1;
        }
      }
    }

    /* A mismatched deck still contains independent ready sides.  Advance
       all of them before polling the shared frontier again; each cursor
       remains ordered and the done bitmap still gates every dependency. */
    for (int c = 0; c < nc; ++c) {
      if (done[c] || up[c] >= ulen[c]) {
        continue;
      }
      const UF_long consumed = kls_snode_batch_consume_cached(
        l_indices, l_values, llen, ui[c], ui32[c], ux[c], ulen[c], up[c],
        xv[c], k1, local_col[c], shared->snode_run_end, shared, 1, NULL);
      if (consumed != 0u) {
        up[c] += consumed;
        progress = 1;
        continue;
      }
      const UF_long j = ui32[c] != NULL
        ? (UF_long)ui32[c][up[c]] : ui[c][up[c]];
      if (kls_egraph_refactor_dependency_done_now(shared, k1 + j)) {
        kls_egraph_refactor_apply_btf_scalar_dep(
          shared, k1, cols[c], j, up[c], ux[c], l_indices, l_indices32,
          l_values, llen, xv[c], 0);
        up[c]++;
        progress = 1;
      }
    }

    for (int c = 0; c < nc; ++c) {
      if (!done[c] && up[c] >= ulen[c]) {
        const UF_long k = cols[c];
        const UF_long local_k = local_col[c];
        const double pivot = xv[c][local_k];
        xv[c][local_k] = 0.0;
        if (pivot == 0.0) {
          kls_egraph_refactor_record_singular(shared, k, symbolic->Q[k]);
          if (solver->common.halt_if_singular) {
            return 0;
          }
        }
        kls_egraph_store_udiag(shared, udiag, k, pivot);
        kls_egraph_store_l_column_from_workspace(
          solver, xv[c], k, l_indices[k], l_values[k], llen[local_k], pivot);
        kls_egraph_refactor_mark_done(shared, k);
        done[c] = 1;
        remaining--;
        progress = 1;
      }
    }
    if (!progress) {
      kls_cpu_relax();
      kls_egraph_pipeline_pause(&spin);
    }
  }
  return 1;
}

static int kls_egraph_refactor_column(kls_egraph_refactor_worker *worker,
                                      UF_long k,
                                      int wait_for_dependencies) {
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  trilinos_klu_l_numeric *numeric = solver->numeric;
  const trilinos_klu_l_symbolic *symbolic = solver->symbolic;
  double *x = worker->x;
  double *udiag = (double *)numeric->Udiag;
  UF_long **l_indices = solver->refactor_l_indices;
  double **l_values = solver->refactor_l_values;
  UF_long **u_indices = solver->refactor_u_indices;
  double **u_values = solver->refactor_u_values;
  if (symbolic != NULL && shared->scale <= 0) {
    if (symbolic->nblocks == 1u) {
      return kls_egraph_refactor_single_unscaled_column(
        worker, k, wait_for_dependencies);
    }
    if (symbolic->nblocks > 1u && symbolic->maxblock >= 30000u) {
      return kls_egraph_refactor_btf_unscaled_column(
        worker, k, wait_for_dependencies);
    }
  }
  if (solver->refactor_lu_pointer_count != solver->n ||
      l_indices == NULL || l_values == NULL ||
      u_indices == NULL || u_values == NULL) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }
  if (k >= solver->n || symbolic->R == NULL || symbolic->Q == NULL) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }
  UF_long block = KLS_KLU_EMPTY;
  if (symbolic->nblocks == 1u) {
    block = 0u;
  } else if (solver->refactor_col_block != NULL) {
    block = solver->refactor_col_block[k];
  } else {
    block = kls_block_for_pivot(solver, k);
  }
  if (block == KLS_KLU_EMPTY || block >= symbolic->nblocks) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }

  const UF_long k1 = symbolic->R[block];
  const UF_long k2 = symbolic->R[block + 1u];
  const UF_long nk = k2 - k1;
  const UF_long local_k = k - k1;
  const int btf_block = symbolic->nblocks != 1u;

  if (local_k >= nk ||
      solver->refactor_col_ptr == NULL ||
      solver->refactor_row_idx == NULL ||
      solver->refactor_input_pos == NULL ||
      (btf_block && (solver->refactor_block_start == NULL ||
                     solver->refactor_col_block == NULL))) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }

  if (nk == 1u) {
    if (!btf_block || numeric->Offp == NULL || numeric->Offx == NULL) {
      kls_egraph_refactor_record_invalid(shared);
      return 0;
    }
    UF_long poff = numeric->Offp[k];
    const UF_long poff_end = numeric->Offp[k + 1u];
    double *offx = (double *)numeric->Offx;
    double pivot = 0.0;
    if (!kls_egraph_copy_refactor_values(
          solver, shared->values, shared->rs, shared->scale, offx, &poff,
          poff_end, solver->refactor_col_ptr[k],
          solver->refactor_block_start[k])) {
      kls_egraph_refactor_record_invalid(shared);
      return 0;
    }
    for (UF_long p = solver->refactor_block_start[k];
         p < solver->refactor_col_ptr[k + 1u]; ++p) {
      if (kls_refactor_map_row_at(solver, p) != k) {
        kls_egraph_refactor_record_invalid(shared);
        return 0;
      }
      if (!kls_egraph_refactor_value(
            shared, kls_refactor_map_input_at(solver, p),
                                     &pivot)) {
        kls_egraph_refactor_record_invalid(shared);
        return 0;
      }
    }
    udiag[k] = pivot;
    if (pivot == 0.0) {
      kls_egraph_refactor_record_singular(shared, k, symbolic->Q[k]);
      if (solver->common.halt_if_singular) {
        return 0;
      }
    }
    return 1;
  }

  UF_long *llen = numeric->Llen + k1;
  UF_long *ulen = numeric->Ulen + k1;
  double *lu = (double *)numeric->LUbx[block];
  if (lu == NULL) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }

  if (btf_block) {
    if (numeric->Offp == NULL || numeric->Offx == NULL) {
      kls_egraph_refactor_record_invalid(shared);
      return 0;
    }
    UF_long poff = numeric->Offp[k];
    const UF_long poff_end = numeric->Offp[k + 1u];
    double *offx = (double *)numeric->Offx;
    if (!kls_egraph_copy_refactor_values(
          solver, shared->values, shared->rs, shared->scale, offx, &poff,
          poff_end, solver->refactor_col_ptr[k],
          solver->refactor_block_start[k])) {
      kls_egraph_refactor_record_invalid(shared);
      return 0;
    }
    if (!kls_egraph_scatter_refactor_input(
          solver, shared->values, shared->rs, shared->scale, x, k1, k2,
          solver->refactor_block_start[k],
          solver->refactor_col_ptr[k + 1u])) {
      kls_egraph_refactor_record_invalid(shared);
      return 0;
    }
  } else {
    if (!kls_egraph_scatter_refactor_input(
          solver, shared->values, shared->rs, shared->scale, x, 0u, solver->n,
          solver->refactor_col_ptr[k], solver->refactor_col_ptr[k + 1u])) {
      kls_egraph_refactor_record_invalid(shared);
      return 0;
    }
  }

  UF_long *ui = u_indices[k];
  const int32_t *ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[k] : NULL;
  double *ux = u_values[k];
  UF_long ucol_len = ulen[local_k];
  UF_long up = 0u;
  const int supernode_numeric_updates = shared->supernode_numeric_updates;
  const int consumer_plan_group_l_updates =
    shared->supernode_consumer_plan_group_l_exec;
  const int u_supernode_ragged_l_updates =
    shared->u_supernode_ragged_l_updates;
  const int u_supernode_values = shared->u_supernode_values;
  UF_long algorithm5_prefactor_deps = 0u;
  const int algorithm5_prefactor_enabled =
    wait_for_dependencies && shared->algorithm5_prefactor_updates &&
    ucol_len > 1u;
  const int algorithm5_seed_active =
    shared->supernode_algorithm5_payoff_direct_prefix_current_state ||
    shared->supernode_algorithm5_payoff_direct_prefix_advance_seed;
  const int snode_batches_allowed =
    !kls_batch_consume_disabled() && shared->snode_run_end != NULL &&
    !u_supernode_values;
  unsigned char *algorithm5_prefactor_applied = NULL;
  if (algorithm5_seed_active) {
    const int advance_seed_status =
      kls_egraph_refactor_try_seed_algorithm5_payoff_direct_prefix_advance(
        worker, k1, k, local_k, &up, ucol_len, ui, ux, x);
    if (advance_seed_status < 0) {
      return 0;
    }
  }
  while (up < ucol_len) {
    if (algorithm5_prefactor_applied != NULL &&
        algorithm5_prefactor_applied[up]) {
      up++;
      continue;
    }
    if (algorithm5_seed_active) {
      const int advance_seed_loop_status =
        kls_egraph_refactor_try_seed_algorithm5_payoff_direct_prefix_advance(
          worker, k1, k, local_k, &up, ucol_len, ui, ux, x);
      if (advance_seed_loop_status < 0) {
        return 0;
      }
      if (advance_seed_loop_status > 0) {
        continue;
      }
    }
    const int batch_paths_allowed =
      algorithm5_prefactor_deps == 0u;
    if (batch_paths_allowed && supernode_numeric_updates) {
      const UF_long run_begin = up;
      const int supernode_status =
        kls_egraph_refactor_try_supernode_dependency_run(
          worker, k1, k, local_k, &up, ucol_len, ui, ux, l_indices,
          l_values, numeric->Llen, x, wait_for_dependencies);
      if (supernode_status < 0) {
        return 0;
      }
      if (supernode_status > 0) {
        if (algorithm5_prefactor_applied != NULL && up > run_begin) {
          memset(algorithm5_prefactor_applied + run_begin, 1,
                 (size_t)(up - run_begin));
        }
        continue;
      }
    }
    if (batch_paths_allowed && consumer_plan_group_l_updates) {
      const UF_long run_begin = up;
      const int group_l_status =
        kls_egraph_refactor_try_consumer_plan_group_l_run(
          worker, k1, k, local_k, &up, ucol_len, ui, ux, x,
          wait_for_dependencies);
      if (group_l_status < 0) {
        return 0;
      }
      if (group_l_status > 0) {
        if (algorithm5_prefactor_applied != NULL && up > run_begin) {
          memset(algorithm5_prefactor_applied + run_begin, 1,
                 (size_t)(up - run_begin));
        }
        continue;
      }
    }
    if (batch_paths_allowed && u_supernode_ragged_l_updates) {
      const UF_long run_begin = up;
      const int ragged_status =
        kls_egraph_refactor_try_u_supernode_ragged_l_run(
          worker, k1, k, local_k, &up, ucol_len, ui, ux, x,
          wait_for_dependencies);
      if (ragged_status < 0) {
        return 0;
      }
      if (ragged_status > 0) {
        if (algorithm5_prefactor_applied != NULL && up > run_begin) {
          memset(algorithm5_prefactor_applied + run_begin, 1,
                 (size_t)(up - run_begin));
        }
        continue;
      }
    }
    if (snode_batches_allowed) {
      const UF_long consumed = shared->use_fp32_l_values
        ? kls_snode_batch_consume_cached_f32(
            l_indices, (const int32_t *const *)solver->refactor_l_indices32,
            solver->refactor_l_values32, llen, ui, ui32, ux, ucol_len, up,
            x, k1, local_k, shared->snode_run_end, shared,
            wait_for_dependencies, algorithm5_prefactor_applied)
        : kls_snode_batch_consume_cached(
            l_indices, l_values, llen, ui, ui32, ux, ucol_len, up, x, k1,
            local_k, shared->snode_run_end, shared, wait_for_dependencies,
            algorithm5_prefactor_applied);
      if (consumed != 0u) {
        if (algorithm5_prefactor_applied != NULL) {
          memset(algorithm5_prefactor_applied + up, 1, (size_t)consumed);
        }
        up += consumed;
        continue;
      }
    }
    const UF_long j = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
    if (j >= local_k) {
      kls_egraph_refactor_record_invalid(shared);
      return 0;
    }
    if (algorithm5_prefactor_enabled &&
        !kls_egraph_refactor_dependency_done_now(shared, k1 + j)) {
      if (algorithm5_prefactor_applied == NULL) {
        algorithm5_prefactor_applied =
          kls_egraph_worker_byte_workspace(worker, ucol_len);
        if (algorithm5_prefactor_applied != NULL) {
          memset(algorithm5_prefactor_applied, 0, (size_t)ucol_len);
          if (up > 0u) {
            memset(algorithm5_prefactor_applied, 1, (size_t)up);
          }
        }
      }
      if (algorithm5_prefactor_applied != NULL &&
          !kls_egraph_refactor_prefactor_finished_btf_deps(
            worker, k1, k, local_k, up, ucol_len, ui, ui32, ux, l_indices,
            l_values, llen, x, algorithm5_prefactor_applied,
            u_supernode_values, &algorithm5_prefactor_deps)) {
        return 0;
      }
    }
    if (wait_for_dependencies &&
        !kls_egraph_refactor_wait_done(shared, k1 + j)) {
      return 0;
    }
    const double ujk = x[j];
    x[j] = 0.0;
    ux[up] = ujk;
    if (u_supernode_values) {
      kls_egraph_record_u_supernode_value(shared, k1 + j, k, ujk);
    }

    if (ujk != 0.0) {
      UF_long *li = l_indices[k1 + j];
      double *lx = l_values[k1 + j];
      UF_long lcol_len = llen[j];
      kls_scatter_subtract_refactor_l(solver, x, k1 + j, li, lx, lcol_len,
                                      ujk);
    }
    if (algorithm5_prefactor_applied != NULL) {
      algorithm5_prefactor_applied[up] = 1u;
    }
    up++;
  }

  if (algorithm5_prefactor_deps > 0u) {
    atomic_fetch_add_explicit(&shared->algorithm5_prefactor_columns, 1ul,
                              memory_order_relaxed);
    atomic_fetch_add_explicit(&shared->algorithm5_prefactor_deps,
                              (unsigned long)algorithm5_prefactor_deps,
                              memory_order_relaxed);
  }

  const double ukk = x[local_k];
  x[local_k] = 0.0;
  if (ukk == 0.0) {
    kls_egraph_refactor_record_singular(shared, k, symbolic->Q[k]);
    if (solver->common.halt_if_singular) {
      return 0;
    }
  }
  udiag[k] = ukk;
  if (u_supernode_values) {
    kls_egraph_record_u_supernode_value(shared, k, k, ukk);
  }

  UF_long *li = l_indices[k];
  double *lx = l_values[k];
  UF_long lcol_len = llen[local_k];
  UF_long rejected_row = KLS_KLU_EMPTY;
  UF_long rejected_local_row = KLS_KLU_EMPTY;
  double rejected_multiplier_abs = -1.0;
  double rejected_pivot_abs = -1.0;
  double rejected_candidate_abs = -1.0;
  if (shared->check_pivots &&
      kls_checked_refactor_best_reject_candidate(
        li, lcol_len, x, ukk, solver->common.tol, k1, &rejected_row,
        &rejected_local_row, &rejected_multiplier_abs, &rejected_pivot_abs,
        &rejected_candidate_abs)) {
    x[rejected_local_row] = 0.0;
    kls_egraph_refactor_record_reject(shared, k, symbolic->Q[k],
                                      rejected_row,
                                      rejected_multiplier_abs,
                                      rejected_pivot_abs,
                                      rejected_candidate_abs);
    return 0;
  }
  kls_egraph_store_l_column_from_workspace(solver, x, k, li, lx, lcol_len,
                                           ukk);
  kls_egraph_publish_u_supernode_l_column(shared, k);
  kls_egraph_publish_consumer_plan_group_l_column(shared, k);
  if (supernode_numeric_updates) {
    kls_egraph_publish_supernode_panel_column(shared, k);
  }
  return 1;
}

static int kls_egraph_refactor_dispatch_column(
  kls_egraph_refactor_worker *worker,
  UF_long k,
  int wait_for_dependencies) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  {
    const kls_solver *solver = worker->shared->solver;
    if (solver != NULL && solver->dense_tail_cols > 0 &&
        solver->symbolic != NULL) {
      const UF_long tail_end =
        solver->symbolic->R[solver->dense_tail_block + 1];
      if (k >= tail_end - solver->dense_tail_cols && k < tail_end) {
        /* pipe-emitted dense-tail column: the BLAS3 tail refresh
           rebuilds its values after this refactorization; completing
           it here releases dependents (only later tail columns, which
           no-op the same way) without the 24s scalar scatter walk */
        return 1;
      }
    }
  }
  switch (worker->shared->kernel) {
    case KLS_EGRAPH_REFACTOR_KERNEL_SINGLE_UNSCALED:
      if (worker->shared->single_unscaled_plain) {
        return kls_egraph_refactor_single_unscaled_plain_column(
          worker, k, wait_for_dependencies);
      }
      return kls_egraph_refactor_single_unscaled_column(
        worker, k, wait_for_dependencies);
    case KLS_EGRAPH_REFACTOR_KERNEL_SINGLE_SCALED:
      return kls_egraph_refactor_single_scaled_column(
        worker, k, wait_for_dependencies);
    case KLS_EGRAPH_REFACTOR_KERNEL_BTF_UNSCALED_DEFER_TERMINAL:
      if (k == worker->shared->deferred_pts_terminal_col) return 1;
      /* fall through */
    case KLS_EGRAPH_REFACTOR_KERNEL_BTF_UNSCALED:
      if (worker->shared->btf_unscaled_plain &&
          (!wait_for_dependencies ||
           !worker->shared->solver->padded_active)) {
        return kls_egraph_refactor_btf_unscaled_plain_cluster_column(worker,
          k, wait_for_dependencies);
      }
      return kls_egraph_refactor_btf_unscaled_column(
        worker, k, wait_for_dependencies);
    case KLS_EGRAPH_REFACTOR_KERNEL_GENERIC:
    default:
      return kls_egraph_refactor_column(worker, k, wait_for_dependencies);
  }
}

static int kls_egraph_refactor_pipeline_position_for_column(
  const kls_egraph_refactor_shared *shared,
  UF_long col,
  UF_long *pos_out) {
  if (pos_out != NULL) {
    *pos_out = KLS_KLU_EMPTY;
  }
  if (shared == NULL || shared->solver == NULL ||
      col >= shared->solver->n) {
    return 0;
  }
  const kls_solver *solver = shared->solver;
  UF_long pos = KLS_KLU_EMPTY;
  UF_long pipeline_begin = 0u;
  if (shared->pipeline_natural_order) {
    pos = col;
  } else {
    if (solver->refactor_level_pos == NULL ||
        solver->refactor_level_ptr == NULL ||
        shared->cluster_level_count > solver->refactor_level_count) {
      return 0;
    }
    pos = solver->refactor_level_pos[col];
    pipeline_begin = solver->refactor_level_ptr[shared->cluster_level_count];
  }
  if (pos == KLS_KLU_EMPTY || pos < pipeline_begin ||
      pos >= shared->pipeline_pos_end) {
    return 0;
  }
  if (pos_out != NULL) {
    *pos_out = pos;
  }
  return 1;
}

static int kls_egraph_refactor_try_claim_shape_column(
  kls_egraph_refactor_shared *shared,
  UF_long col) {
  if (shared == NULL || shared->solver == NULL ||
      shared->pipeline_claimed == NULL ||
      shared->pipeline_done == NULL ||
      shared->pipeline_generation == 0u ||
      shared->pipeline_claim_generation == 0u ||
      shared->pipeline_lease_generation == 0u ||
      col >= shared->solver->n) {
    return 0;
  }
  if (atomic_load_explicit(&shared->pipeline_done[col],
                           memory_order_acquire) ==
      shared->pipeline_generation) {
    return 0;
  }

  for (;;) {
    unsigned int owner =
      atomic_load_explicit(&shared->pipeline_claimed[col],
                           memory_order_acquire);
    if (owner == shared->pipeline_claim_generation ||
        owner == shared->pipeline_lease_generation) {
      return 0;
    }
    if (atomic_compare_exchange_weak_explicit(
          &shared->pipeline_claimed[col], &owner,
          shared->pipeline_claim_generation,
          memory_order_acq_rel, memory_order_acquire)) {
      atomic_fetch_add_explicit(
        &shared->supernode_consumer_plan_claimed_columns, 1ul,
        memory_order_relaxed);
      return 1;
    }
  }
}

static void kls_sort_claimed_columns_by_position(
  UF_long *claimed,
  UF_long count) {
  if (claimed == NULL) {
    return;
  }
  for (UF_long i = 1u; i < count; ++i) {
    const UF_long pos = claimed[2u * i];
    const UF_long col = claimed[2u * i + 1u];
    UF_long j = i;
    while (j > 0u && claimed[2u * (j - 1u)] > pos) {
      claimed[2u * j] = claimed[2u * (j - 1u)];
      claimed[2u * j + 1u] = claimed[2u * (j - 1u) + 1u];
      j--;
    }
    claimed[2u * j] = pos;
    claimed[2u * j + 1u] = col;
  }
}

static int kls_egraph_refactor_try_claim_shape_group_columns(
  kls_egraph_refactor_worker *worker,
  UF_long current_col) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || !shared->supernode_consumer_plan_shape_claims ||
      shared->pipeline_ready_queue ||
      current_col >= solver->n ||
      solver->refactor_supernode_consumer_plan_col_ptr == NULL ||
      solver->refactor_supernode_consumer_plan_col_runs == NULL ||
      solver->refactor_supernode_consumer_plan_current == NULL ||
      solver->refactor_supernode_consumer_plan_group_l_run_group == NULL ||
      solver->refactor_supernode_consumer_plan_group_l_valid == NULL ||
      solver->refactor_supernode_consumer_plan_shape_group_ptr == NULL ||
      solver->refactor_supernode_consumer_plan_shape_group_runs == NULL) {
    return 0;
  }

  const UF_long begin =
    solver->refactor_supernode_consumer_plan_col_ptr[current_col];
  const UF_long end =
    solver->refactor_supernode_consumer_plan_col_ptr[current_col + 1u];
  if (begin > end ||
      end > solver->refactor_supernode_consumer_plan_run_count) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }

  int processed = 0;
  for (UF_long pos = begin; pos < end; ++pos) {
    const UF_long run =
      solver->refactor_supernode_consumer_plan_col_runs[pos];
    if (run >= solver->refactor_supernode_consumer_plan_run_count) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    const UF_long group =
      solver->refactor_supernode_consumer_plan_group_l_run_group[run];
    if (group == KLS_KLU_EMPTY ||
        group >= solver->refactor_supernode_consumer_plan_shape_batch_count ||
        (solver->refactor_supernode_consumer_plan_group_l_valid[group] &
         KLS_REFACTOR_PLAN_GROUP_L_PAYOFF) == 0u) {
      continue;
    }
    const UF_long runs_begin =
      solver->refactor_supernode_consumer_plan_shape_group_ptr[group];
    const UF_long runs_end =
      solver->refactor_supernode_consumer_plan_shape_group_ptr[group + 1u];
    if (runs_begin > runs_end ||
        runs_end >
          solver->refactor_supernode_consumer_plan_shape_batch_run_count) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    const UF_long group_runs = runs_end - runs_begin;
    if (group_runs <= 1u ||
        group_runs > (UF_long)(SIZE_MAX / (2u * sizeof(UF_long)))) {
      continue;
    }

    UF_long *claimed =
      (UF_long *)malloc((size_t)(2u * group_runs) * sizeof(*claimed));
    if (claimed == NULL) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    UF_long claimed_count = 0u;
    for (UF_long run_pos = runs_begin; run_pos < runs_end; ++run_pos) {
      const UF_long group_run =
        solver->refactor_supernode_consumer_plan_shape_group_runs[run_pos];
      if (group_run >= solver->refactor_supernode_consumer_plan_run_count) {
        free(claimed);
        kls_egraph_refactor_record_invalid(shared);
        return -1;
      }
      const UF_long candidate =
        solver->refactor_supernode_consumer_plan_current[group_run];
      UF_long candidate_pos = KLS_KLU_EMPTY;
      if (candidate == current_col || candidate >= solver->n ||
          !kls_egraph_refactor_pipeline_position_for_column(
            shared, candidate, &candidate_pos)) {
        continue;
      }
      if (!kls_egraph_refactor_try_claim_shape_column(shared, candidate)) {
        continue;
      }
      claimed[2u * claimed_count] = candidate_pos;
      claimed[2u * claimed_count + 1u] = candidate;
      claimed_count++;
    }

    kls_sort_claimed_columns_by_position(claimed, claimed_count);
    for (UF_long i = 0u; i < claimed_count; ++i) {
      const UF_long col = claimed[2u * i + 1u];
      if (kls_egraph_refactor_should_stop(shared)) {
        free(claimed);
        return -1;
      }
      if (!kls_egraph_refactor_dispatch_column(worker, col, 1)) {
        free(claimed);
        if (!kls_egraph_refactor_should_stop(shared)) {
          kls_egraph_refactor_record_invalid(shared);
        }
        return -1;
      }
      kls_egraph_refactor_mark_done(shared, col);
      processed = 1;
    }
    free(claimed);
  }
  return processed;
}

static int kls_egraph_refactor_push_payoff_trigger(
  UF_long **pending,
  UF_long *pending_count,
  UF_long *pending_capacity,
  const UF_long *inline_pending,
  UF_long col) {
  if (pending == NULL || *pending == NULL || pending_count == NULL ||
      pending_capacity == NULL) {
    return 0;
  }
  if (*pending_count == *pending_capacity) {
    const UF_long old_capacity = *pending_capacity;
    if (old_capacity == 0u ||
        old_capacity > (UF_long)(SIZE_MAX / (2u * sizeof(UF_long)))) {
      return 0;
    }
    const UF_long new_capacity = old_capacity * 2u;
    UF_long *next = NULL;
    if (*pending == inline_pending) {
      next = (UF_long *)malloc((size_t)new_capacity * sizeof(*next));
      if (next != NULL) {
        memcpy(next, inline_pending, (size_t)old_capacity * sizeof(*next));
      }
    } else {
      next = (UF_long *)realloc(
        *pending, (size_t)new_capacity * sizeof(*next));
    }
    if (next == NULL) {
      return 0;
    }
    *pending = next;
    *pending_capacity = new_capacity;
  }
  (*pending)[(*pending_count)++] = col;
  return 1;
}

static int kls_egraph_refactor_try_claim_algorithm5_payoff_group_currents(
  kls_egraph_refactor_worker *worker,
  UF_long current_col) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || !shared->supernode_algorithm5_payoff_claims ||
      shared->pipeline_ready_queue ||
      current_col >= solver->n ||
      solver->refactor_supernode_algorithm5_payoff_group_count == 0u ||
      solver->refactor_supernode_algorithm5_payoff_group_prefix_end == NULL ||
      solver->refactor_supernode_algorithm5_payoff_trigger_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_trigger_groups == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_currents == NULL) {
    return 0;
  }
  if (!kls_refactor_supernode_algorithm5_payoff_claim_surface_allowed(
        solver, shared->thread_count)) {
    return 0;
  }

  UF_long inline_pending[16];
  UF_long *pending = inline_pending;
  UF_long pending_capacity =
    (UF_long)(sizeof(inline_pending) / sizeof(inline_pending[0]));
  UF_long pending_count = 0u;
  UF_long pending_pos = 0u;
  int processed = 0;
  inline_pending[pending_count++] = current_col;

  while (pending_pos < pending_count) {
    const UF_long trigger_col = pending[pending_pos++];
    if (trigger_col >= solver->n) {
      if (pending != inline_pending) {
        free(pending);
      }
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    const UF_long trigger_begin =
      solver->refactor_supernode_algorithm5_payoff_trigger_ptr[trigger_col];
    const UF_long trigger_end =
      solver
        ->refactor_supernode_algorithm5_payoff_trigger_ptr[trigger_col + 1u];
    if (trigger_begin > trigger_end ||
        trigger_end >
          solver->refactor_supernode_algorithm5_payoff_group_count) {
      if (pending != inline_pending) {
        free(pending);
      }
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }

    for (UF_long trigger_pos = trigger_begin; trigger_pos < trigger_end;
         ++trigger_pos) {
      const UF_long group =
        solver->refactor_supernode_algorithm5_payoff_trigger_groups[
          trigger_pos];
      if (group >= solver->refactor_supernode_algorithm5_payoff_group_count ||
          solver->refactor_supernode_algorithm5_payoff_group_prefix_end[
            group] != trigger_col + 1u) {
        if (pending != inline_pending) {
          free(pending);
        }
        kls_egraph_refactor_record_invalid(shared);
        return -1;
      }
      const UF_long current_begin =
        solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group];
      const UF_long current_end =
        solver
          ->refactor_supernode_algorithm5_payoff_group_current_ptr[group + 1u];
      if (current_begin > current_end ||
          current_end >
            solver->refactor_supernode_algorithm5_payoff_group_current_total) {
        if (pending != inline_pending) {
          free(pending);
        }
        kls_egraph_refactor_record_invalid(shared);
        return -1;
      }
      const UF_long current_count = current_end - current_begin;
      if (shared->thread_count <= 0) {
        continue;
      }
      const UF_long max_serial_currents =
        4u * (UF_long)shared->thread_count;
      if (current_count <= 1u ||
          current_count > max_serial_currents ||
          current_count > (UF_long)(SIZE_MAX / (2u * sizeof(UF_long)))) {
        continue;
      }

      UF_long *claimed =
        (UF_long *)malloc((size_t)(2u * current_count) * sizeof(*claimed));
      if (claimed == NULL) {
        if (pending != inline_pending) {
          free(pending);
        }
        kls_egraph_refactor_record_invalid(shared);
        return -1;
      }
      UF_long claimed_count = 0u;
      for (UF_long current_pos = current_begin; current_pos < current_end;
           ++current_pos) {
        const UF_long candidate =
          solver->refactor_supernode_algorithm5_payoff_group_currents[
            current_pos];
        if (candidate >= solver->n) {
          free(claimed);
          if (pending != inline_pending) {
            free(pending);
          }
          kls_egraph_refactor_record_invalid(shared);
          return -1;
        }
        UF_long candidate_pos = KLS_KLU_EMPTY;
        if (candidate == trigger_col ||
            !kls_egraph_refactor_pipeline_position_for_column(
              shared, candidate, &candidate_pos)) {
          continue;
        }
        if (!kls_egraph_refactor_try_claim_shape_column(shared, candidate)) {
          continue;
        }
        claimed[2u * claimed_count] = candidate_pos;
        claimed[2u * claimed_count + 1u] = candidate;
        claimed_count++;
      }

      kls_sort_claimed_columns_by_position(claimed, claimed_count);
      for (UF_long i = 0u; i < claimed_count; ++i) {
        const UF_long col = claimed[2u * i + 1u];
        if (kls_egraph_refactor_should_stop(shared)) {
          free(claimed);
          if (pending != inline_pending) {
            free(pending);
          }
          return -1;
        }
        if (!kls_egraph_refactor_dispatch_column(worker, col, 1)) {
          free(claimed);
          if (pending != inline_pending) {
            free(pending);
          }
          if (!kls_egraph_refactor_should_stop(shared)) {
            kls_egraph_refactor_record_invalid(shared);
          }
          return -1;
        }
        kls_egraph_refactor_mark_done(shared, col);
        processed = 1;
        if (solver->refactor_supernode_algorithm5_payoff_trigger_ptr[col] <
            solver->refactor_supernode_algorithm5_payoff_trigger_ptr[col + 1u]) {
          if (!kls_egraph_refactor_push_payoff_trigger(
                &pending, &pending_count, &pending_capacity, inline_pending,
                col)) {
            free(claimed);
            if (pending != inline_pending) {
              free(pending);
            }
            kls_egraph_refactor_record_invalid(shared);
            return -1;
          }
        }
      }
      free(claimed);
    }
  }
  if (pending != inline_pending) {
    free(pending);
  }
  return processed;
}

enum {
  KLS_ALGORITHM5_PAYOFF_QUEUE_PRECLAIMED = 1u
};

static int kls_egraph_refactor_column_dependencies_done(
  const kls_egraph_refactor_shared *shared,
  UF_long col) {
  if (shared == NULL || shared->solver == NULL ||
      shared->pipeline_done == NULL ||
      shared->pipeline_generation == 0u ||
      col >= shared->solver->n) {
    return 0;
  }
  const kls_solver *solver = shared->solver;
  if (solver->symbolic == NULL || solver->symbolic->R == NULL ||
      solver->symbolic->nblocks == 0u ||
      solver->numeric == NULL || solver->numeric->Ulen == NULL ||
      (solver->refactor_u_indices == NULL &&
       solver->refactor_u_indices32 == NULL)) {
    return 0;
  }
  if (atomic_load_explicit(&shared->pipeline_done[col],
                           memory_order_acquire) ==
      shared->pipeline_generation) {
    return 0;
  }

  UF_long block = KLS_KLU_EMPTY;
  if (solver->symbolic->nblocks == 1u) {
    block = 0u;
  } else if (solver->refactor_col_block != NULL) {
    block = solver->refactor_col_block[col];
  } else {
    block = kls_block_for_pivot(solver, col);
  }
  if (block == KLS_KLU_EMPTY || block >= solver->symbolic->nblocks) {
    return 0;
  }
  const UF_long k1 = solver->symbolic->R[block];
  const UF_long k2 = solver->symbolic->R[block + 1u];
  if (col < k1 || col >= k2) {
    return 0;
  }
  const UF_long local_col = col - k1;
  const UF_long ulen = solver->numeric->Ulen[col];
  const int32_t *ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[col] : NULL;
  const UF_long *ui =
    ui32 == NULL && solver->refactor_u_indices != NULL
      ? solver->refactor_u_indices[col] : NULL;
  if (ui32 == NULL && ui == NULL && ulen > 0u) {
    return 0;
  }
  for (UF_long p = 0u; p < ulen; ++p) {
    const UF_long dep_local = ui32 != NULL ? (UF_long)ui32[p] : ui[p];
    if (dep_local >= local_col || dep_local > UF_long_max - k1) {
      return 0;
    }
    const UF_long dep_global = k1 + dep_local;
    if (dep_global >= col || dep_global >= solver->n ||
        atomic_load_explicit(&shared->pipeline_done[dep_global],
                             memory_order_acquire) !=
          shared->pipeline_generation) {
      return 0;
    }
  }
  return 1;
}

enum {
  KLS_BTF_SCALAR_RUN_GROUP_PREFIX_READY = 1,
  KLS_BTF_SCALAR_RUN_GROUP_RUN_READY = 2
};

enum {
  KLS_BTF_SCALAR_RUN_GROUP_WAKE_EMPTY = 0u,
  KLS_BTF_SCALAR_RUN_GROUP_WAKE_ARMED = 1u,
  KLS_BTF_SCALAR_RUN_GROUP_WAKE_READY = 2u,
  KLS_BTF_SCALAR_RUN_GROUP_WAKE_PREPARING = 3u,
  KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED = 4u,
  KLS_BTF_SCALAR_RUN_GROUP_WAKE_CONSUMED = 5u
};

static int kls_egraph_refactor_btf_scalar_run_group_readiness(
  const kls_egraph_refactor_shared *shared,
  UF_long current_col,
  UF_long current_up,
  UF_long dep0_global,
  UF_long rows) {
  if (shared == NULL || shared->solver == NULL ||
      shared->pipeline_done == NULL || shared->pipeline_generation == 0u ||
      rows == 0u || current_col >= shared->solver->n ||
      dep0_global >= shared->solver->n ||
      rows > shared->solver->n - dep0_global) {
    return 0;
  }
  const kls_solver *solver = shared->solver;
  if (atomic_load_explicit(&shared->pipeline_done[current_col],
                           memory_order_acquire) ==
      shared->pipeline_generation) {
    return 0;
  }
  if (solver->symbolic == NULL || solver->symbolic->R == NULL ||
      solver->symbolic->nblocks == 0u ||
      solver->numeric == NULL || solver->numeric->Ulen == NULL ||
      solver->refactor_u_indices == NULL) {
    return 0;
  }

  UF_long block = KLS_KLU_EMPTY;
  if (solver->symbolic->nblocks == 1u) {
    block = 0u;
  } else if (solver->refactor_col_block != NULL) {
    block = solver->refactor_col_block[current_col];
  } else {
    block = kls_block_for_pivot(solver, current_col);
  }
  if (block == KLS_KLU_EMPTY || block >= solver->symbolic->nblocks) {
    return 0;
  }
  const UF_long k1 = solver->symbolic->R[block];
  const UF_long k2 = solver->symbolic->R[block + 1u];
  if (current_col < k1 || current_col >= k2 ||
      dep0_global < k1 || dep0_global >= k2 ||
      rows > k2 - dep0_global || dep0_global >= current_col) {
    return 0;
  }
  const UF_long local_col = current_col - k1;
  const UF_long dep0_local = dep0_global - k1;
  const UF_long ulen = solver->numeric->Ulen[current_col];
  const UF_long *ui = solver->refactor_u_indices[current_col];
  const int32_t *ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[current_col] : NULL;
  if ((ui == NULL && ulen > 0u) || current_up > ulen ||
      rows > ulen - current_up || dep0_local > local_col) {
    return 0;
  }
  for (UF_long p = 0u; p < current_up; ++p) {
    const UF_long dep_local = ui32 != NULL ? (UF_long)ui32[p] : ui[p];
    if (dep_local >= local_col || dep_local > UF_long_max - k1) {
      return 0;
    }
    const UF_long dep_global = k1 + dep_local;
    if (dep_global >= current_col ||
        atomic_load_explicit(&shared->pipeline_done[dep_global],
                             memory_order_acquire) !=
          shared->pipeline_generation) {
      return 0;
    }
  }
  for (UF_long r = 0u; r < rows; ++r) {
    const UF_long dep_local =
      ui32 != NULL ? (UF_long)ui32[current_up + r] : ui[current_up + r];
    if (dep_local != dep0_local + r || dep_local >= local_col) {
      return 0;
    }
  }

  int ready = KLS_BTF_SCALAR_RUN_GROUP_PREFIX_READY;
  for (UF_long r = 0u; r < rows; ++r) {
    const UF_long dep_global = dep0_global + r;
    if (dep_global >= current_col ||
        atomic_load_explicit(&shared->pipeline_done[dep_global],
                             memory_order_acquire) !=
          shared->pipeline_generation) {
      return ready;
    }
  }
  return ready | KLS_BTF_SCALAR_RUN_GROUP_RUN_READY;
}

static int kls_btf_scalar_run_group_state_position(
  const kls_solver *solver,
  UF_long member,
  UF_long row,
  UF_long *pos_out) {
  if (pos_out != NULL) {
    *pos_out = 0u;
  }
  if (solver == NULL || pos_out == NULL ||
      solver->refactor_btf_scalar_run_group_state_ptr == NULL ||
      solver->refactor_btf_scalar_run_group_state_rows == NULL ||
      member >= solver->refactor_btf_scalar_run_group_multi_current_total) {
    return 0;
  }
  const UF_long begin =
    solver->refactor_btf_scalar_run_group_state_ptr[member];
  const UF_long end =
    solver->refactor_btf_scalar_run_group_state_ptr[member + 1u];
  if (end < begin ||
      end > solver->refactor_btf_scalar_run_group_state_rows_total) {
    return 0;
  }
  UF_long rel = 0u;
  if (!kls_find_sorted_uf_long_position(
        solver->refactor_btf_scalar_run_group_state_rows + begin,
        end - begin, row, &rel)) {
    return 0;
  }
  *pos_out = begin + rel;
  return 1;
}

static int kls_egraph_btf_scalar_run_group_state_block_info(
  const kls_solver *solver,
  UF_long current,
  UF_long *k1_out,
  UF_long *k2_out,
  UF_long *block_size_out,
  UF_long *current_local_out) {
  if (k1_out != NULL) {
    *k1_out = 0u;
  }
  if (k2_out != NULL) {
    *k2_out = 0u;
  }
  if (block_size_out != NULL) {
    *block_size_out = 0u;
  }
  if (current_local_out != NULL) {
    *current_local_out = 0u;
  }
  if (solver == NULL || solver->symbolic == NULL ||
      solver->symbolic->R == NULL || k1_out == NULL || k2_out == NULL ||
      block_size_out == NULL || current_local_out == NULL ||
      current >= solver->n) {
    return 0;
  }
  UF_long block = 0u;
  if (solver->symbolic->nblocks != 1u) {
    if (solver->refactor_col_block == NULL) {
      return 0;
    }
    block = solver->refactor_col_block[current];
  }
  if (block >= solver->symbolic->nblocks) {
    return 0;
  }
  const UF_long k1 = solver->symbolic->R[block];
  const UF_long k2 = solver->symbolic->R[block + 1u];
  if (k2 <= k1 || current < k1 || current >= k2) {
    return 0;
  }
  *k1_out = k1;
  *k2_out = k2;
  *block_size_out = k2 - k1;
  *current_local_out = current - k1;
  return 1;
}

static int kls_btf_scalar_run_group_state_value_range(
  const kls_egraph_refactor_shared *shared,
  const kls_solver *solver,
  UF_long member,
  UF_long *state_begin_out,
  UF_long *state_count_out,
  UF_long *value_begin_out) {
  if (state_begin_out != NULL) {
    *state_begin_out = 0u;
  }
  if (state_count_out != NULL) {
    *state_count_out = 0u;
  }
  if (value_begin_out != NULL) {
    *value_begin_out = 0u;
  }
  if (shared == NULL || solver == NULL ||
      state_begin_out == NULL || state_count_out == NULL ||
      value_begin_out == NULL ||
      shared->btf_scalar_run_group_state_values == NULL ||
      solver->refactor_btf_scalar_run_group_state_ptr == NULL ||
      member >= solver->refactor_btf_scalar_run_group_multi_current_total) {
    return 0;
  }
  const UF_long state_begin =
    solver->refactor_btf_scalar_run_group_state_ptr[member];
  const UF_long state_end =
    solver->refactor_btf_scalar_run_group_state_ptr[member + 1u];
  if (state_end < state_begin ||
      state_end > solver->refactor_btf_scalar_run_group_state_rows_total) {
    return 0;
  }
  const UF_long state_count = state_end - state_begin;
  UF_long value_begin = state_begin;
  if (shared->btf_scalar_run_group_state_values_compact) {
    if (shared->btf_scalar_run_group_state_value_base == NULL ||
        member >= shared->btf_scalar_run_group_state_value_base_count) {
      return 0;
    }
    value_begin = shared->btf_scalar_run_group_state_value_base[member];
    if (value_begin == KLS_KLU_EMPTY) {
      return 0;
    }
  }
  if (state_count > shared->btf_scalar_run_group_state_size ||
      value_begin > shared->btf_scalar_run_group_state_size - state_count) {
    return 0;
  }
  *state_begin_out = state_begin;
  *state_count_out = state_count;
  *value_begin_out = value_begin;
  return 1;
}

static int kls_btf_scalar_run_group_state_value_pos(
  const kls_egraph_refactor_shared *shared,
  const kls_solver *solver,
  UF_long member,
  UF_long state_abs_pos,
  UF_long *value_pos_out) {
  if (value_pos_out != NULL) {
    *value_pos_out = 0u;
  }
  if (value_pos_out == NULL) {
    return 0;
  }
  UF_long state_begin = 0u;
  UF_long state_count = 0u;
  UF_long value_begin = 0u;
  if (!kls_btf_scalar_run_group_state_value_range(
        shared, solver, member, &state_begin, &state_count, &value_begin) ||
      state_abs_pos < state_begin ||
      state_abs_pos - state_begin >= state_count) {
    return 0;
  }
  *value_pos_out = value_begin + (state_abs_pos - state_begin);
  return 1;
}

static int kls_egraph_btf_scalar_run_group_state_apply_l(
  kls_egraph_refactor_shared *shared,
  UF_long member,
  UF_long dep_global,
  UF_long block_size,
  double ujk,
  double *state_values,
  UF_long *entries_io) {
  if (shared == NULL || shared->solver == NULL || state_values == NULL ||
      dep_global >= shared->solver->n || block_size == 0u ||
      shared->solver->numeric == NULL ||
      shared->solver->numeric->Llen == NULL) {
    return 0;
  }
  kls_solver *solver = shared->solver;
  const UF_long len = solver->numeric->Llen[dep_global];
  const int32_t *rows32 =
    solver->refactor_l_indices32 != NULL
      ? solver->refactor_l_indices32[dep_global] : NULL;
  const UF_long *rows =
    rows32 == NULL && solver->refactor_l_indices != NULL
      ? solver->refactor_l_indices[dep_global] : NULL;
  const double *lx =
    solver->refactor_l_values != NULL ? solver->refactor_l_values[dep_global]
                                      : NULL;
  if (len > 0u && (lx == NULL || (rows32 == NULL && rows == NULL))) {
    return 0;
  }
  const UF_long state_begin =
    solver->refactor_btf_scalar_run_group_state_ptr[member];
  const UF_long state_end =
    solver->refactor_btf_scalar_run_group_state_ptr[member + 1u];
  UF_long range_state_begin = 0u;
  UF_long state_count = 0u;
  UF_long value_begin = 0u;
  if (!kls_btf_scalar_run_group_state_value_range(
        shared, solver, member, &range_state_begin, &state_count,
        &value_begin) ||
      range_state_begin != state_begin ||
      state_end - state_begin != state_count) {
    return 0;
  }
  if (solver->refactor_l_indices_sorted) {
    const UF_long *state_rows =
      solver->refactor_btf_scalar_run_group_state_rows + state_begin;
    UF_long state_pos = 0u;
    for (UF_long q = 0u; q < len; ++q) {
      const UF_long row = rows32 != NULL ? (UF_long)rows32[q] : rows[q];
      if (row >= block_size) {
        return 0;
      }
      while (state_pos < state_count && state_rows[state_pos] < row) {
        state_pos++;
      }
      if (state_pos >= state_count || state_rows[state_pos] != row) {
        return 0;
      }
      state_values[value_begin + state_pos] -= ujk * lx[q];
    }
    if (entries_io != NULL) {
      *entries_io =
        len > UF_long_max - *entries_io ? UF_long_max : *entries_io + len;
    }
    return 1;
  }
  for (UF_long q = 0u; q < len; ++q) {
    const UF_long row = rows32 != NULL ? (UF_long)rows32[q] : rows[q];
    UF_long pos = 0u;
    UF_long value_pos = 0u;
    if (row >= block_size ||
        !kls_btf_scalar_run_group_state_position(solver, member, row, &pos) ||
        !kls_btf_scalar_run_group_state_value_pos(
          shared, solver, member, pos, &value_pos)) {
      return 0;
    }
    state_values[value_pos] -= ujk * lx[q];
  }
  if (entries_io != NULL) {
    *entries_io =
      len > UF_long_max - *entries_io ? UF_long_max : *entries_io + len;
  }
  return 1;
}

static int kls_egraph_materialize_btf_scalar_run_group_state(
  kls_egraph_refactor_worker *worker,
  UF_long member,
  UF_long *state_rows_out,
  UF_long *prefix_deps_out) {
  if (state_rows_out != NULL) {
    *state_rows_out = 0u;
  }
  if (prefix_deps_out != NULL) {
    *prefix_deps_out = 0u;
  }
  if (worker == NULL || worker->shared == NULL ||
      !worker->shared->btf_scalar_run_group_state_stats ||
      state_rows_out == NULL || prefix_deps_out == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || shared->btf_scalar_run_group_state_values == NULL ||
      solver->refactor_btf_scalar_run_group_state_ptr == NULL ||
      solver->refactor_btf_scalar_run_group_state_rows == NULL ||
      solver->refactor_btf_scalar_run_group_currents == NULL ||
      solver->refactor_btf_scalar_run_group_current_up == NULL ||
      solver->refactor_col_ptr == NULL ||
      solver->refactor_block_start == NULL ||
      solver->numeric == NULL || solver->numeric->Ulen == NULL ||
      member >= solver->refactor_btf_scalar_run_group_multi_current_total) {
    return 0;
  }
  const UF_long state_begin =
    solver->refactor_btf_scalar_run_group_state_ptr[member];
  const UF_long state_end =
    solver->refactor_btf_scalar_run_group_state_ptr[member + 1u];
  UF_long range_state_begin = 0u;
  UF_long state_rows = 0u;
  UF_long value_begin = 0u;
  if (!kls_btf_scalar_run_group_state_value_range(
        shared, solver, member, &range_state_begin, &state_rows,
        &value_begin) ||
      range_state_begin != state_begin ||
      state_end - state_begin != state_rows) {
    return 0;
  }
  double *state_values = shared->btf_scalar_run_group_state_values;
  double *state_u_values = shared->btf_scalar_run_group_state_u_values;
  if (state_rows > 0u) {
    memset(state_values + value_begin, 0,
           (size_t)state_rows * sizeof(*state_values));
    if (state_u_values != NULL) {
      memset(state_u_values + value_begin, 0,
             (size_t)state_rows * sizeof(*state_u_values));
    }
  }

  const UF_long current =
    solver->refactor_btf_scalar_run_group_currents[member];
  const UF_long current_up =
    solver->refactor_btf_scalar_run_group_current_up[member];
  UF_long k1 = 0u;
  UF_long k2 = 0u;
  UF_long block_size = 0u;
  UF_long current_local = 0u;
  if (!kls_egraph_btf_scalar_run_group_state_block_info(
        solver, current, &k1, &k2, &block_size, &current_local)) {
    return 0;
  }
  (void)k2;

  const UF_long input_begin = solver->refactor_block_start[current];
  const UF_long input_end = solver->refactor_col_ptr[current + 1u];
  if (input_begin > input_end || input_end > solver->nnz) {
    return 0;
  }
  if (solver->refactor_row_idx32 != NULL) {
    const int32_t *input_rows32 = solver->refactor_row_idx32;
    for (UF_long p = input_begin; p < input_end; ++p) {
      const UF_long row_global = (UF_long)input_rows32[p];
      UF_long pos = 0u;
      if (row_global < k1 ||
          !kls_btf_scalar_run_group_state_position(
            solver, member, row_global - k1, &pos)) {
        return 0;
      }
      state_values[value_begin + (pos - state_begin)] =
        kls_egraph_unscaled_input_value_at(solver, shared->values, p);
    }
  } else {
    if (solver->refactor_row_idx == NULL) {
      return 0;
    }
    const UF_long *input_rows = solver->refactor_row_idx;
    for (UF_long p = input_begin; p < input_end; ++p) {
      const UF_long row_global = input_rows[p];
      UF_long pos = 0u;
      if (row_global < k1 ||
          !kls_btf_scalar_run_group_state_position(
            solver, member, row_global - k1, &pos)) {
        return 0;
      }
      state_values[value_begin + (pos - state_begin)] =
        kls_egraph_unscaled_input_value_at(solver, shared->values, p);
    }
  }

  const UF_long ulen = solver->numeric->Ulen[current];
  const int32_t *ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[current] : NULL;
  const UF_long *ui =
    ui32 == NULL && solver->refactor_u_indices != NULL
      ? solver->refactor_u_indices[current] : NULL;
  if ((ui32 == NULL && ui == NULL && ulen > 0u) || current_up > ulen) {
    return 0;
  }
  for (UF_long up = 0u; up < current_up; ++up) {
    const UF_long dep_local = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
    if (dep_local >= current_local || dep_local > UF_long_max - k1 ||
        !kls_egraph_refactor_dependency_done_now(shared, k1 + dep_local)) {
      return 0;
    }
    UF_long dep_pos = 0u;
    if (!kls_btf_scalar_run_group_state_position(
          solver, member, dep_local, &dep_pos)) {
      return 0;
    }
    const UF_long dep_value_pos = value_begin + (dep_pos - state_begin);
    const double ujk = state_values[dep_value_pos];
    if (state_u_values != NULL) {
      state_u_values[dep_value_pos] = ujk;
    }
    state_values[dep_value_pos] = 0.0;
    UF_long unused_entries = 0u;
    if (!kls_egraph_btf_scalar_run_group_state_apply_l(
          shared, member, k1 + dep_local, block_size, ujk, state_values,
          &unused_entries)) {
      return 0;
    }
  }
  *state_rows_out = state_rows;
  *prefix_deps_out = current_up;
  return 1;
}

static int
kls_egraph_btf_scalar_run_group_state_member_row_union(
  const kls_solver *solver,
  const UF_long *members,
  UF_long member_count,
  UF_long *cursors,
  UF_long *block_offsets,
  UF_long *state_rows_out,
  UF_long *unique_rows_out) {
  if (state_rows_out != NULL) {
    *state_rows_out = 0u;
  }
  if (unique_rows_out != NULL) {
    *unique_rows_out = 0u;
  }
  if (solver == NULL || members == NULL || member_count == 0u ||
      cursors == NULL || block_offsets == NULL ||
      state_rows_out == NULL || unique_rows_out == NULL ||
      solver->refactor_btf_scalar_run_group_currents == NULL ||
      solver->refactor_btf_scalar_run_group_state_ptr == NULL ||
      solver->refactor_btf_scalar_run_group_state_rows == NULL) {
    return 0;
  }

  UF_long state_rows = 0u;
  for (UF_long i = 0u; i < member_count; ++i) {
    cursors[i] = 0u;
    block_offsets[i] = 0u;
    const UF_long member = members[i];
    if (member >= solver->refactor_btf_scalar_run_group_multi_current_total) {
      return 0;
    }
    const UF_long current =
      solver->refactor_btf_scalar_run_group_currents[member];
    UF_long k1 = 0u;
    UF_long k2 = 0u;
    UF_long block_size = 0u;
    UF_long current_local = 0u;
    if (!kls_egraph_btf_scalar_run_group_state_block_info(
          solver, current, &k1, &k2, &block_size, &current_local)) {
      return 0;
    }
    (void)k2;
    (void)block_size;
    (void)current_local;
    const UF_long begin =
      solver->refactor_btf_scalar_run_group_state_ptr[member];
    const UF_long end =
      solver->refactor_btf_scalar_run_group_state_ptr[member + 1u];
    if (end < begin ||
        end > solver->refactor_btf_scalar_run_group_state_rows_total) {
      return 0;
    }
    const UF_long count = end - begin;
    state_rows =
      count > UF_long_max - state_rows ? UF_long_max : state_rows + count;
    block_offsets[i] = k1;
  }

  UF_long unique_rows = 0u;
  for (;;) {
    UF_long min_row = UF_long_max;
    int have_row = 0;
    for (UF_long i = 0u; i < member_count; ++i) {
      const UF_long member = members[i];
      const UF_long begin =
        solver->refactor_btf_scalar_run_group_state_ptr[member];
      const UF_long end =
        solver->refactor_btf_scalar_run_group_state_ptr[member + 1u];
      const UF_long cursor = cursors[i];
      if (cursor >= end - begin) {
        continue;
      }
      const UF_long local_row =
        solver->refactor_btf_scalar_run_group_state_rows[begin + cursor];
      if (local_row > UF_long_max - block_offsets[i]) {
        return 0;
      }
      const UF_long global_row = block_offsets[i] + local_row;
      if (!have_row || global_row < min_row) {
        min_row = global_row;
        have_row = 1;
      }
    }
    if (!have_row) {
      break;
    }
    if (unique_rows != UF_long_max) {
      unique_rows++;
    }
    for (UF_long i = 0u; i < member_count; ++i) {
      const UF_long member = members[i];
      const UF_long begin =
        solver->refactor_btf_scalar_run_group_state_ptr[member];
      const UF_long end =
        solver->refactor_btf_scalar_run_group_state_ptr[member + 1u];
      UF_long cursor = cursors[i];
      while (cursor < end - begin) {
        const UF_long local_row =
          solver->refactor_btf_scalar_run_group_state_rows[begin + cursor];
        if (local_row > UF_long_max - block_offsets[i]) {
          return 0;
        }
        const UF_long global_row = block_offsets[i] + local_row;
        if (global_row != min_row) {
          break;
        }
        cursor++;
      }
      cursors[i] = cursor;
    }
  }

  *state_rows_out = state_rows;
  *unique_rows_out = unique_rows;
  return 1;
}

static int
kls_egraph_btf_scalar_run_group_state_step_batch_row_union(
  const kls_solver *solver,
  const UF_long *members,
  const unsigned char *active,
  UF_long member_count,
  UF_long *cursors,
  UF_long *block_offsets,
  UF_long *state_rows_out,
  UF_long *unique_rows_out) {
  if (state_rows_out != NULL) {
    *state_rows_out = 0u;
  }
  if (unique_rows_out != NULL) {
    *unique_rows_out = 0u;
  }
  if (solver == NULL || members == NULL || active == NULL ||
      cursors == NULL || block_offsets == NULL ||
      state_rows_out == NULL || unique_rows_out == NULL ||
      solver->refactor_btf_scalar_run_group_currents == NULL ||
      solver->refactor_btf_scalar_run_group_state_ptr == NULL ||
      solver->refactor_btf_scalar_run_group_state_rows == NULL) {
    return 0;
  }

  UF_long state_rows = 0u;
  for (UF_long i = 0u; i < member_count; ++i) {
    cursors[i] = 0u;
    block_offsets[i] = 0u;
    if (!active[i]) {
      continue;
    }
    const UF_long member = members[i];
    if (member >= solver->refactor_btf_scalar_run_group_multi_current_total) {
      return 0;
    }
    const UF_long current =
      solver->refactor_btf_scalar_run_group_currents[member];
    UF_long k1 = 0u;
    UF_long k2 = 0u;
    UF_long block_size = 0u;
    UF_long current_local = 0u;
    if (!kls_egraph_btf_scalar_run_group_state_block_info(
          solver, current, &k1, &k2, &block_size, &current_local)) {
      return 0;
    }
    (void)k2;
    (void)block_size;
    (void)current_local;
    const UF_long begin =
      solver->refactor_btf_scalar_run_group_state_ptr[member];
    const UF_long end =
      solver->refactor_btf_scalar_run_group_state_ptr[member + 1u];
    if (end < begin ||
        end > solver->refactor_btf_scalar_run_group_state_rows_total) {
      return 0;
    }
    const UF_long count = end - begin;
    state_rows =
      count > UF_long_max - state_rows ? UF_long_max : state_rows + count;
    block_offsets[i] = k1;
  }

  UF_long unique_rows = 0u;
  for (;;) {
    UF_long min_row = UF_long_max;
    int have_row = 0;
    for (UF_long i = 0u; i < member_count; ++i) {
      if (!active[i]) {
        continue;
      }
      const UF_long member = members[i];
      const UF_long begin =
        solver->refactor_btf_scalar_run_group_state_ptr[member];
      const UF_long end =
        solver->refactor_btf_scalar_run_group_state_ptr[member + 1u];
      const UF_long cursor = cursors[i];
      if (cursor >= end - begin) {
        continue;
      }
      const UF_long local_row =
        solver->refactor_btf_scalar_run_group_state_rows[begin + cursor];
      if (local_row > UF_long_max - block_offsets[i]) {
        return 0;
      }
      const UF_long global_row = block_offsets[i] + local_row;
      if (!have_row || global_row < min_row) {
        min_row = global_row;
        have_row = 1;
      }
    }
    if (!have_row) {
      break;
    }
    if (unique_rows != UF_long_max) {
      unique_rows++;
    }
    for (UF_long i = 0u; i < member_count; ++i) {
      if (!active[i]) {
        continue;
      }
      const UF_long member = members[i];
      const UF_long begin =
        solver->refactor_btf_scalar_run_group_state_ptr[member];
      const UF_long end =
        solver->refactor_btf_scalar_run_group_state_ptr[member + 1u];
      UF_long cursor = cursors[i];
      while (cursor < end - begin) {
        const UF_long local_row =
          solver->refactor_btf_scalar_run_group_state_rows[begin + cursor];
        if (local_row > UF_long_max - block_offsets[i]) {
          return 0;
        }
        const UF_long global_row = block_offsets[i] + local_row;
        if (global_row != min_row) {
          break;
        }
        cursor++;
      }
      cursors[i] = cursor;
    }
  }

  *state_rows_out = state_rows;
  *unique_rows_out = unique_rows;
  return 1;
}

static void
kls_egraph_reject_btf_scalar_run_group_state_batch_member(
  kls_egraph_refactor_shared *shared,
  UF_long member,
  unsigned char *active,
  UF_long slot,
  UF_long *active_count_io,
  UF_long *rejected_count_io) {
  if (active != NULL && active[slot]) {
    active[slot] = 0u;
    if (active_count_io != NULL && *active_count_io > 0u) {
      (*active_count_io)--;
    }
    if (rejected_count_io != NULL) {
      (*rejected_count_io)++;
    }
  }
  if (shared != NULL && shared->btf_scalar_run_group_wake_live != NULL &&
      member < shared->btf_scalar_run_group_wake_live_count) {
    atomic_store_explicit(&shared->btf_scalar_run_group_wake_live[member],
                          KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED,
                          memory_order_release);
  }
}

static void kls_egraph_apply_btf_scalar_run_group_state_l_to_claims(
  kls_egraph_refactor_worker *worker,
  kls_egraph_refactor_shared *shared,
  const int32_t *rows32,
  const UF_long *rows,
  const double *lx,
  UF_long lcol_len,
  const UF_long *claimed_members,
  const UF_long *state_begin_by_claim,
  const UF_long *state_count_by_claim,
  const UF_long *value_begin_by_claim,
  UF_long *state_cursor,
  const double *coefficients,
  UF_long claimed_count,
  const UF_long *candidate_indices,
  UF_long candidate_count,
  int skip_zero_coefficients,
  int sorted_l,
  UF_long position_max_entries,
  unsigned char *active,
  UF_long *active_count_io,
  UF_long *rejected_count_io) {
  if (worker == NULL || shared == NULL || shared->solver == NULL ||
      shared->btf_scalar_run_group_state_values == NULL || lx == NULL ||
      (rows32 == NULL && rows == NULL && lcol_len > 0u) ||
      claimed_members == NULL || state_begin_by_claim == NULL ||
      state_count_by_claim == NULL || value_begin_by_claim == NULL ||
      state_cursor == NULL || coefficients == NULL || active == NULL ||
      active_count_io == NULL || candidate_count == 0u ||
      claimed_count == 0u || lcol_len == 0u || *active_count_io == 0u) {
    return;
  }

  kls_solver *solver = shared->solver;
  double *state_values = shared->btf_scalar_run_group_state_values;
  const int use_position_plan =
    sorted_l && position_max_entries > 0u &&
    candidate_count <= position_max_entries / lcol_len;
  UF_long *position_workspace =
    use_position_plan
      ? (UF_long *)kls_egraph_worker_object_workspace(
          worker, candidate_count * lcol_len, sizeof(UF_long))
      : NULL;

  if (position_workspace != NULL) {
    UF_long active_count = *active_count_io;
    for (UF_long v = 0u; v < candidate_count; ++v) {
      const UF_long i = candidate_indices != NULL ? candidate_indices[v] : v;
      if (i >= claimed_count || !active[i] ||
          (skip_zero_coefficients && coefficients[i] == 0.0)) {
        continue;
      }
      const UF_long member = claimed_members[i];
      const UF_long state_begin = state_begin_by_claim[i];
      const UF_long state_count = state_count_by_claim[i];
      const UF_long value_begin = value_begin_by_claim[i];
      const UF_long *state_rows =
        solver->refactor_btf_scalar_run_group_state_rows + state_begin;
      UF_long cursor = state_cursor[i];
      int ok = 1;
      for (UF_long q = 0u; q < lcol_len; ++q) {
        const UF_long row = rows32 != NULL ? (UF_long)rows32[q] : rows[q];
        while (cursor < state_count && state_rows[cursor] < row) {
          cursor++;
        }
        if (cursor >= state_count || state_rows[cursor] != row) {
          ok = 0;
          break;
        }
        position_workspace[q * candidate_count + v] =
          value_begin + cursor;
        cursor++;
      }
      if (!ok) {
        kls_egraph_reject_btf_scalar_run_group_state_batch_member(
          shared, member, active, i, &active_count, rejected_count_io);
        continue;
      }
      state_cursor[i] = cursor;
    }
    *active_count_io = active_count;
    if (active_count == 0u) {
      return;
    }

    for (UF_long q = 0u; q < lcol_len; ++q) {
      const double value = lx[q];
      for (UF_long v = 0u; v < candidate_count; ++v) {
        const UF_long i = candidate_indices != NULL ? candidate_indices[v] : v;
        if (i >= claimed_count || !active[i] ||
            (skip_zero_coefficients && coefficients[i] == 0.0)) {
          continue;
        }
        state_values[position_workspace[q * candidate_count + v]] -=
          coefficients[i] * value;
      }
    }
    return;
  }

  for (UF_long q = 0u; q < lcol_len && *active_count_io > 0u; ++q) {
    const UF_long row = rows32 != NULL ? (UF_long)rows32[q] : rows[q];
    const double value = lx[q];
    for (UF_long v = 0u; v < candidate_count; ++v) {
      const UF_long i = candidate_indices != NULL ? candidate_indices[v] : v;
      if (i >= claimed_count || !active[i] ||
          (skip_zero_coefficients && coefficients[i] == 0.0)) {
        continue;
      }
      const UF_long member = claimed_members[i];
      const UF_long state_begin = state_begin_by_claim[i];
      const UF_long state_count = state_count_by_claim[i];
      const UF_long state_end = state_begin + state_count;
      const UF_long *state_rows =
        solver->refactor_btf_scalar_run_group_state_rows + state_begin;
      UF_long rel_pos = 0u;
      int have_pos = 0;
      if (sorted_l) {
        UF_long cursor = state_cursor[i];
        while (cursor < state_count && state_rows[cursor] < row) {
          cursor++;
        }
        if (cursor < state_count && state_rows[cursor] == row) {
          rel_pos = cursor;
          state_cursor[i] = cursor + 1u;
          have_pos = 1;
        }
      } else {
        UF_long row_abs_pos = 0u;
        if (kls_btf_scalar_run_group_state_position(
              solver, member, row, &row_abs_pos) &&
            row_abs_pos >= state_begin && row_abs_pos < state_end &&
            solver->refactor_btf_scalar_run_group_state_rows[row_abs_pos] ==
              row) {
          rel_pos = row_abs_pos - state_begin;
          have_pos = 1;
        }
      }
      if (!have_pos) {
        kls_egraph_reject_btf_scalar_run_group_state_batch_member(
          shared, member, active, i, active_count_io, rejected_count_io);
        continue;
      }
      state_values[value_begin_by_claim[i] + rel_pos] -=
        coefficients[i] * value;
    }
  }
}

static int kls_egraph_advance_btf_scalar_run_group_state_window(
  kls_egraph_refactor_worker *worker,
  UF_long group,
  UF_long member,
  UF_long start_row,
  UF_long row_limit,
  UF_long *advanced_rows_out,
  UF_long *advanced_entries_out) {
  if (advanced_rows_out != NULL) {
    *advanced_rows_out = 0u;
  }
  if (advanced_entries_out != NULL) {
    *advanced_entries_out = 0u;
  }
  if (worker == NULL || worker->shared == NULL ||
      !worker->shared->btf_scalar_run_group_state_stats ||
      advanced_rows_out == NULL || advanced_entries_out == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || shared->btf_scalar_run_group_state_values == NULL ||
      solver->refactor_btf_scalar_run_group_state_ptr == NULL ||
      solver->refactor_btf_scalar_run_group_dep0 == NULL ||
      solver->refactor_btf_scalar_run_group_currents == NULL ||
      solver->refactor_btf_scalar_run_group_current_up == NULL ||
      solver->refactor_btf_scalar_run_group_current_rows == NULL ||
      solver->numeric == NULL || solver->numeric->Ulen == NULL ||
      group >= solver->refactor_btf_scalar_run_group_multi_count ||
      member >= solver->refactor_btf_scalar_run_group_multi_current_total) {
    return 0;
  }
  const UF_long current =
    solver->refactor_btf_scalar_run_group_currents[member];
  const UF_long current_up =
    solver->refactor_btf_scalar_run_group_current_up[member];
  const UF_long rows =
    solver->refactor_btf_scalar_run_group_current_rows[member];
  const UF_long dep0_global =
    solver->refactor_btf_scalar_run_group_dep0[group];
  UF_long k1 = 0u;
  UF_long k2 = 0u;
  UF_long block_size = 0u;
  UF_long current_local = 0u;
  if (!kls_egraph_btf_scalar_run_group_state_block_info(
        solver, current, &k1, &k2, &block_size, &current_local) ||
      dep0_global < k1 || dep0_global >= k2) {
    return 0;
  }
  const UF_long dep0_local = dep0_global - k1;
  if (dep0_local >= current_local ||
      rows == 0u || rows > block_size - dep0_local ||
      rows > current_local - dep0_local ||
      start_row > rows || row_limit == 0u) {
    return 0;
  }
  const UF_long ulen = solver->numeric->Ulen[current];
  const int32_t *ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[current] : NULL;
  const UF_long *ui =
    ui32 == NULL && solver->refactor_u_indices != NULL
      ? solver->refactor_u_indices[current] : NULL;
  if ((ui32 == NULL && ui == NULL && ulen > 0u) ||
      current_up > ulen || rows > ulen - current_up) {
    return 0;
  }

  double *state_values = shared->btf_scalar_run_group_state_values;
  double *state_u_values = shared->btf_scalar_run_group_state_u_values;
  UF_long entries = 0u;
  UF_long end_row = rows;
  if (row_limit < rows - start_row) {
    end_row = start_row + row_limit;
  }
  for (UF_long local = start_row; local < end_row; ++local) {
    const UF_long dep_local =
      ui32 != NULL ? (UF_long)ui32[current_up + local]
                   : ui[current_up + local];
    if (dep_local != dep0_local + local || dep_local >= current_local ||
        dep_local > UF_long_max - k1 ||
        !kls_egraph_refactor_dependency_done_now(shared, k1 + dep_local)) {
      return 0;
    }
    UF_long dep_pos = 0u;
    UF_long dep_value_pos = 0u;
    if (!kls_btf_scalar_run_group_state_position(
          solver, member, dep_local, &dep_pos) ||
        !kls_btf_scalar_run_group_state_value_pos(
          shared, solver, member, dep_pos, &dep_value_pos)) {
      return 0;
    }
    const double ujk = state_values[dep_value_pos];
    if (state_u_values != NULL) {
      state_u_values[dep_value_pos] = ujk;
    }
    state_values[dep_value_pos] = 0.0;
    if (!kls_egraph_btf_scalar_run_group_state_apply_l(
          shared, member, k1 + dep_local, block_size, ujk, state_values,
          &entries)) {
      return 0;
    }
  }
  *advanced_rows_out = end_row - start_row;
  *advanced_entries_out = entries;
  return 1;
}

static int kls_egraph_advance_btf_scalar_run_group_state(
  kls_egraph_refactor_worker *worker,
  UF_long group,
  UF_long member,
  UF_long *advanced_rows_out,
  UF_long *advanced_entries_out) {
  return kls_egraph_advance_btf_scalar_run_group_state_window(
    worker, group, member, 0u, UF_long_max, advanced_rows_out,
    advanced_entries_out);
}

static int
kls_egraph_refactor_try_advance_btf_scalar_run_group_state_producer_batch(
  kls_egraph_refactor_worker *worker,
  UF_long producer_col,
  UF_long step_begin,
  UF_long step_end) {
  if (worker == NULL || worker->shared == NULL ||
      step_begin >= step_end) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || !shared->btf_scalar_run_group_state_step_advance ||
      shared->btf_scalar_run_group_wake_live == NULL ||
      shared->btf_scalar_run_group_state_next == NULL ||
      shared->btf_scalar_run_group_state_values == NULL ||
      producer_col >= solver->n ||
      solver->refactor_btf_scalar_run_group_dep0 == NULL ||
      solver->refactor_btf_scalar_run_group_currents == NULL ||
      solver->refactor_btf_scalar_run_group_current_rows == NULL ||
      solver->refactor_btf_scalar_run_group_step_groups == NULL ||
      solver->refactor_btf_scalar_run_group_step_member_ptr == NULL ||
      solver->refactor_btf_scalar_run_group_step_members == NULL ||
      solver->refactor_btf_scalar_run_group_state_ptr == NULL ||
      solver->refactor_btf_scalar_run_group_state_rows == NULL ||
      solver->numeric == NULL || solver->numeric->Llen == NULL ||
      solver->refactor_l_values == NULL) {
    return 0;
  }
  const int use_sorted_mirror =
    solver->refactor_l_sorted_enabled &&
    solver->refactor_l_sorted_indices32 != NULL &&
    solver->refactor_l_sorted_values != NULL;
  const int sorted_l = use_sorted_mirror || solver->refactor_l_indices_sorted;
  if (step_end > solver->refactor_btf_scalar_run_group_step_count) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }
  const UF_long step_span = step_end - step_begin;
  const int step_window =
    shared->btf_scalar_run_group_state_step_window ? 1 : 0;
  const UF_long position_max_entries =
    kls_refactor_btf_scalar_run_group_state_step_position_max_entries_env();
  const int partial_owner_stats =
    shared->btf_scalar_run_group_live_step_partial_owner_stats &&
    solver->refactor_btf_scalar_run_group_live_step_ptr != NULL;

  UF_long member_capacity = 0u;
  for (UF_long step = step_begin; step < step_end; ++step) {
    const UF_long member_begin =
      solver->refactor_btf_scalar_run_group_step_member_ptr[step];
    const UF_long member_end =
      solver->refactor_btf_scalar_run_group_step_member_ptr[step + 1u];
    if (member_begin > member_end ||
        member_end > solver->refactor_btf_scalar_run_group_step_member_total ||
        member_end - member_begin > UF_long_max - member_capacity) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    member_capacity += member_end - member_begin;
  }
  const UF_long member_workspace_multiplier =
    7u + (partial_owner_stats ? 3u : 0u) + (step_window ? 1u : 0u);
  if (member_capacity <= 1u ||
      member_capacity > UF_long_max / member_workspace_multiplier ||
      step_span > (partial_owner_stats ? (UF_long_max - 1u) / 4u
                                       : UF_long_max / 2u)) {
    return 0;
  }
  const UF_long step_workspace_entries =
    partial_owner_stats ? 4u * step_span + 1u : 2u * step_span;
  const UF_long member_workspace_entries =
    member_workspace_multiplier * member_capacity;
  if (step_workspace_entries > UF_long_max - member_workspace_entries) {
    return 0;
  }

  UF_long *index_workspace =
    kls_egraph_worker_index_workspace(
      worker, member_workspace_entries + step_workspace_entries);
  double *coefficients =
    kls_egraph_worker_supernode_workspace(worker, member_capacity);
  if (index_workspace == NULL || coefficients == NULL) {
    return 0;
  }
  UF_long *claimed_members = index_workspace;
  UF_long *producer_offsets = claimed_members + member_capacity;
  UF_long *state_cursor = producer_offsets + member_capacity;
  UF_long *claimed_steps = state_cursor + member_capacity;
  UF_long *state_begin_by_claim = claimed_steps + member_capacity;
  UF_long *state_count_by_claim = state_begin_by_claim + member_capacity;
  UF_long *value_begin_by_claim = state_count_by_claim + member_capacity;
  UF_long *member_tail = value_begin_by_claim + member_capacity;
  UF_long *window_candidates = NULL;
  if (step_window) {
    window_candidates = member_tail;
    member_tail += member_capacity;
  }
  UF_long *step_active_count = member_tail;
  UF_long *step_member_count = step_active_count + step_span;
  UF_long *step_active_ptr = NULL;
  UF_long *step_active_fill = NULL;
  UF_long *partial_members = NULL;
  UF_long *partial_cursors = NULL;
  UF_long *partial_offsets = NULL;
  if (partial_owner_stats) {
    step_active_ptr = step_member_count + step_span;
    step_active_fill = step_active_ptr + step_span + 1u;
    partial_members = step_active_fill + step_span;
    partial_cursors = partial_members + member_capacity;
    partial_offsets = partial_cursors + member_capacity;
  }
  for (UF_long rel = 0u; rel < step_span; ++rel) {
    step_active_count[rel] = 0u;
    step_member_count[rel] = 0u;
  }

  UF_long claimed_count = 0u;
  UF_long rejected_count = 0u;
  for (UF_long step = step_begin; step < step_end; ++step) {
    const UF_long step_rel = step - step_begin;
    const UF_long group =
      solver->refactor_btf_scalar_run_group_step_groups[step];
    const UF_long member_begin =
      solver->refactor_btf_scalar_run_group_step_member_ptr[step];
    const UF_long member_end =
      solver->refactor_btf_scalar_run_group_step_member_ptr[step + 1u];
    if (group >= solver->refactor_btf_scalar_run_group_multi_count) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    step_member_count[step_rel] = member_end - member_begin;
    const UF_long dep0 = solver->refactor_btf_scalar_run_group_dep0[group];
    if (producer_col < dep0) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    const UF_long producer_offset = producer_col - dep0;
    for (UF_long input = member_begin; input < member_end; ++input) {
      const UF_long member =
        solver->refactor_btf_scalar_run_group_step_members[input];
      if (member >= shared->btf_scalar_run_group_wake_live_count ||
          member >= shared->btf_scalar_run_group_state_next_count ||
          member >=
            solver->refactor_btf_scalar_run_group_multi_current_total) {
        kls_egraph_refactor_record_invalid(shared);
        return -1;
      }
      if (atomic_load_explicit(&shared->btf_scalar_run_group_wake_live[member],
                               memory_order_acquire) !=
          KLS_BTF_SCALAR_RUN_GROUP_WAKE_ARMED) {
        continue;
      }
      if (shared->btf_scalar_run_group_state_next[member] !=
          producer_offset) {
        continue;
      }
      unsigned expected = KLS_BTF_SCALAR_RUN_GROUP_WAKE_ARMED;
      if (!atomic_compare_exchange_strong_explicit(
            &shared->btf_scalar_run_group_wake_live[member], &expected,
            KLS_BTF_SCALAR_RUN_GROUP_WAKE_PREPARING, memory_order_acq_rel,
            memory_order_acquire)) {
        continue;
      }

      const UF_long rows =
        solver->refactor_btf_scalar_run_group_current_rows[member];
      const UF_long next = shared->btf_scalar_run_group_state_next[member];
      if (next > rows) {
        atomic_store_explicit(&shared->btf_scalar_run_group_wake_live[member],
                              KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED,
                              memory_order_release);
        rejected_count++;
        continue;
      }
      if (next == rows) {
        atomic_store_explicit(&shared->btf_scalar_run_group_wake_live[member],
                              KLS_BTF_SCALAR_RUN_GROUP_WAKE_READY,
                              memory_order_release);
        continue;
      }
      if (next != producer_offset ||
          !kls_egraph_refactor_dependency_done_now(shared, producer_col)) {
        atomic_store_explicit(&shared->btf_scalar_run_group_wake_live[member],
                              KLS_BTF_SCALAR_RUN_GROUP_WAKE_ARMED,
                              memory_order_release);
        continue;
      }

      const UF_long current =
        solver->refactor_btf_scalar_run_group_currents[member];
      UF_long k1 = 0u;
      UF_long k2 = 0u;
      UF_long block_size = 0u;
      UF_long current_local = 0u;
      if (!kls_egraph_btf_scalar_run_group_state_block_info(
            solver, current, &k1, &k2, &block_size, &current_local) ||
          producer_col < k1 || producer_col >= k2 ||
          producer_col >= current) {
        atomic_store_explicit(&shared->btf_scalar_run_group_wake_live[member],
                              KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED,
                              memory_order_release);
        rejected_count++;
        continue;
      }
      const UF_long dep_local = producer_col - k1;
      if (dep_local >= current_local || dep_local >= block_size) {
        atomic_store_explicit(&shared->btf_scalar_run_group_wake_live[member],
                              KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED,
                              memory_order_release);
        rejected_count++;
        continue;
      }
      const UF_long state_begin =
        solver->refactor_btf_scalar_run_group_state_ptr[member];
      const UF_long state_end =
        solver->refactor_btf_scalar_run_group_state_ptr[member + 1u];
      if (state_end < state_begin ||
          state_end > solver->refactor_btf_scalar_run_group_state_rows_total) {
        atomic_store_explicit(&shared->btf_scalar_run_group_wake_live[member],
                              KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED,
                              memory_order_release);
        rejected_count++;
        continue;
      }
      const UF_long *state_rows =
        solver->refactor_btf_scalar_run_group_state_rows + state_begin;
      const UF_long state_count = state_end - state_begin;
      const UF_long dep_rel =
        kls_lower_bound_uf_long_count(state_rows, state_count, dep_local);
      if (dep_rel >= state_count || state_rows[dep_rel] != dep_local) {
        atomic_store_explicit(&shared->btf_scalar_run_group_wake_live[member],
                              KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED,
                              memory_order_release);
        rejected_count++;
        continue;
      }
      UF_long range_state_begin = 0u;
      UF_long range_state_count = 0u;
      UF_long value_begin = 0u;
      if (!kls_btf_scalar_run_group_state_value_range(
            shared, solver, member, &range_state_begin, &range_state_count,
            &value_begin) ||
          range_state_begin != state_begin ||
          range_state_count != state_count) {
        atomic_store_explicit(&shared->btf_scalar_run_group_wake_live[member],
                              KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED,
                              memory_order_release);
        rejected_count++;
        continue;
      }
      const UF_long dep_value_pos = value_begin + dep_rel;
      const double ujk =
        shared->btf_scalar_run_group_state_values[dep_value_pos];
      if (shared->btf_scalar_run_group_state_u_values != NULL) {
        shared->btf_scalar_run_group_state_u_values[dep_value_pos] = ujk;
      }
      shared->btf_scalar_run_group_state_values[dep_value_pos] = 0.0;
      claimed_members[claimed_count] = member;
      producer_offsets[claimed_count] = producer_offset;
      claimed_steps[claimed_count] = step_rel;
      state_begin_by_claim[claimed_count] = state_begin;
      state_count_by_claim[claimed_count] = state_count;
      value_begin_by_claim[claimed_count] = value_begin;
      if (sorted_l && dep_local != UF_long_max) {
        state_cursor[claimed_count] =
          kls_lower_bound_uf_long_count(
            state_rows, state_count, dep_local + 1u);
      } else {
        state_cursor[claimed_count] = sorted_l ? state_count : 0u;
      }
      coefficients[claimed_count] = ujk;
      claimed_count++;
    }
  }
  if (claimed_count == 0u) {
    if (rejected_count > 0u) {
      atomic_fetch_add_explicit(
        &shared->btf_scalar_run_group_state_step_advance_rejects,
        (unsigned long)rejected_count, memory_order_relaxed);
      atomic_fetch_add_explicit(
        &shared->btf_scalar_run_group_state_rejects,
        (unsigned long)rejected_count, memory_order_relaxed);
    }
    return rejected_count > 0u;
  }

  const UF_long lcol_len = solver->numeric->Llen[producer_col];
  const int32_t *rows32 =
    use_sorted_mirror
      ? solver->refactor_l_sorted_indices32[producer_col]
      : solver->refactor_l_indices32 != NULL
      ? solver->refactor_l_indices32[producer_col] : NULL;
  const UF_long *rows =
    !use_sorted_mirror && rows32 == NULL && solver->refactor_l_indices != NULL
      ? solver->refactor_l_indices[producer_col] : NULL;
  const double *lx =
    use_sorted_mirror ? solver->refactor_l_sorted_values[producer_col]
                      : solver->refactor_l_values[producer_col];
  if (lcol_len > 0u && (lx == NULL || (rows32 == NULL && rows == NULL))) {
    for (UF_long i = 0u; i < claimed_count; ++i) {
      atomic_store_explicit(
        &shared->btf_scalar_run_group_wake_live[claimed_members[i]],
        KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED, memory_order_release);
    }
    rejected_count += claimed_count;
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_step_advance_rejects,
      (unsigned long)rejected_count, memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_rejects,
      (unsigned long)rejected_count, memory_order_relaxed);
    return 1;
  }

  unsigned char *active =
    kls_egraph_worker_byte_workspace(worker, claimed_count);
  if (active == NULL) {
    for (UF_long i = 0u; i < claimed_count; ++i) {
      atomic_store_explicit(
        &shared->btf_scalar_run_group_wake_live[claimed_members[i]],
        KLS_BTF_SCALAR_RUN_GROUP_WAKE_ARMED, memory_order_release);
    }
    return 0;
  }
  memset(active, 1, (size_t)claimed_count);
  UF_long active_count = claimed_count;
  kls_egraph_apply_btf_scalar_run_group_state_l_to_claims(
    worker, shared, rows32, rows, lx, lcol_len, claimed_members,
    state_begin_by_claim, state_count_by_claim, value_begin_by_claim,
    state_cursor, coefficients, claimed_count, NULL, claimed_count, 0,
    sorted_l, position_max_entries, active, &active_count, &rejected_count);

  UF_long advanced_currents = 0u;
  UF_long ready_currents = 0u;
  UF_long advance_entries = 0u;
  UF_long window_rounds = 0u;
  UF_long window_currents = 0u;
  UF_long window_entries = 0u;
  for (UF_long i = 0u; i < claimed_count; ++i) {
    if (!active[i]) {
      continue;
    }
    const UF_long member = claimed_members[i];
    const UF_long rows =
      solver->refactor_btf_scalar_run_group_current_rows[member];
    const UF_long next = shared->btf_scalar_run_group_state_next[member];
    const UF_long producer_offset = producer_offsets[i];
    if (next != producer_offset) {
      active[i] = 0u;
      atomic_store_explicit(
        &shared->btf_scalar_run_group_wake_live[member],
        KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED, memory_order_release);
      rejected_count++;
      continue;
    }
    const UF_long new_next = next + 1u;
    shared->btf_scalar_run_group_state_next[member] = new_next;
    producer_offsets[i] = new_next;
    if (new_next >= rows) {
      atomic_store_explicit(
        &shared->btf_scalar_run_group_wake_live[member],
        KLS_BTF_SCALAR_RUN_GROUP_WAKE_READY, memory_order_release);
      ready_currents++;
    } else if (!step_window) {
      atomic_store_explicit(
        &shared->btf_scalar_run_group_wake_live[member],
        KLS_BTF_SCALAR_RUN_GROUP_WAKE_ARMED, memory_order_release);
    }
    advanced_currents++;
    advance_entries =
      lcol_len > UF_long_max - advance_entries
        ? UF_long_max : advance_entries + lcol_len;
  }

  if (step_window && window_candidates != NULL) {
    const UF_long min_window_fanout = 2u;
    for (;;) {
      UF_long selected_dep = KLS_KLU_EMPTY;
      UF_long selected_count = 0u;
      for (UF_long i = 0u; i < claimed_count; ++i) {
        if (!active[i]) {
          continue;
        }
        const UF_long member = claimed_members[i];
        if (atomic_load_explicit(
              &shared->btf_scalar_run_group_wake_live[member],
              memory_order_acquire) !=
            KLS_BTF_SCALAR_RUN_GROUP_WAKE_PREPARING) {
          continue;
        }
        const UF_long rows_member =
          solver->refactor_btf_scalar_run_group_current_rows[member];
        const UF_long next =
          shared->btf_scalar_run_group_state_next[member];
        if (next >= rows_member) {
          continue;
        }
        const UF_long rel = claimed_steps[i];
        if (rel >= step_span ||
            step_begin + rel >=
              solver->refactor_btf_scalar_run_group_step_count) {
          active[i] = 0u;
          atomic_store_explicit(
            &shared->btf_scalar_run_group_wake_live[member],
            KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED, memory_order_release);
          rejected_count++;
          continue;
        }
        const UF_long group =
          solver->refactor_btf_scalar_run_group_step_groups[step_begin + rel];
        if (group >= solver->refactor_btf_scalar_run_group_multi_count) {
          active[i] = 0u;
          atomic_store_explicit(
            &shared->btf_scalar_run_group_wake_live[member],
            KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED, memory_order_release);
          rejected_count++;
          continue;
        }
        const UF_long dep0 =
          solver->refactor_btf_scalar_run_group_dep0[group];
        if (next > UF_long_max - dep0) {
          active[i] = 0u;
          atomic_store_explicit(
            &shared->btf_scalar_run_group_wake_live[member],
            KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED, memory_order_release);
          rejected_count++;
          continue;
        }
        const UF_long dep = dep0 + next;
        if (dep >= solver->n ||
            !kls_egraph_refactor_dependency_done_now(shared, dep)) {
          continue;
        }
        UF_long dep_count = 0u;
        for (UF_long j = i; j < claimed_count; ++j) {
          if (!active[j]) {
            continue;
          }
          const UF_long other_member = claimed_members[j];
          if (atomic_load_explicit(
                &shared->btf_scalar_run_group_wake_live[other_member],
                memory_order_acquire) !=
              KLS_BTF_SCALAR_RUN_GROUP_WAKE_PREPARING) {
            continue;
          }
          const UF_long other_next =
            shared->btf_scalar_run_group_state_next[other_member];
          const UF_long other_rows =
            solver->refactor_btf_scalar_run_group_current_rows[other_member];
          if (other_next >= other_rows) {
            continue;
          }
          const UF_long other_rel = claimed_steps[j];
          if (other_rel >= step_span ||
              step_begin + other_rel >=
                solver->refactor_btf_scalar_run_group_step_count) {
            continue;
          }
          const UF_long other_group =
            solver
              ->refactor_btf_scalar_run_group_step_groups[step_begin +
                                                          other_rel];
          if (other_group >=
              solver->refactor_btf_scalar_run_group_multi_count) {
            continue;
          }
          const UF_long other_dep0 =
            solver->refactor_btf_scalar_run_group_dep0[other_group];
          if (other_next <= UF_long_max - other_dep0 &&
              other_dep0 + other_next == dep) {
            dep_count++;
          }
        }
        if (dep_count >= min_window_fanout &&
            dep_count > selected_count) {
          selected_dep = dep;
          selected_count = dep_count;
        }
      }
      if (selected_dep == KLS_KLU_EMPTY) {
        break;
      }

      const UF_long win_lcol_len = solver->numeric->Llen[selected_dep];
      const int32_t *win_rows32 =
        use_sorted_mirror
          ? solver->refactor_l_sorted_indices32[selected_dep]
          : solver->refactor_l_indices32 != NULL
          ? solver->refactor_l_indices32[selected_dep] : NULL;
      const UF_long *win_rows =
        !use_sorted_mirror && win_rows32 == NULL &&
            solver->refactor_l_indices != NULL
          ? solver->refactor_l_indices[selected_dep] : NULL;
      const double *win_lx =
        use_sorted_mirror ? solver->refactor_l_sorted_values[selected_dep]
                          : solver->refactor_l_values[selected_dep];
      if (win_lcol_len > 0u &&
          (win_lx == NULL || (win_rows32 == NULL && win_rows == NULL))) {
        break;
      }

      UF_long valid_count = 0u;
      for (UF_long i = 0u; i < claimed_count; ++i) {
        if (!active[i]) {
          continue;
        }
        const UF_long member = claimed_members[i];
        if (atomic_load_explicit(
              &shared->btf_scalar_run_group_wake_live[member],
              memory_order_acquire) !=
            KLS_BTF_SCALAR_RUN_GROUP_WAKE_PREPARING) {
          continue;
        }
        const UF_long next =
          shared->btf_scalar_run_group_state_next[member];
        const UF_long rows_member =
          solver->refactor_btf_scalar_run_group_current_rows[member];
        if (next >= rows_member) {
          continue;
        }
        const UF_long rel = claimed_steps[i];
        if (rel >= step_span ||
            step_begin + rel >=
              solver->refactor_btf_scalar_run_group_step_count) {
          continue;
        }
        const UF_long group =
          solver->refactor_btf_scalar_run_group_step_groups[step_begin + rel];
        if (group >= solver->refactor_btf_scalar_run_group_multi_count) {
          continue;
        }
        const UF_long dep0 =
          solver->refactor_btf_scalar_run_group_dep0[group];
        if (next > UF_long_max - dep0 || dep0 + next != selected_dep) {
          continue;
        }
        const UF_long current =
          solver->refactor_btf_scalar_run_group_currents[member];
        UF_long k1 = 0u;
        UF_long k2 = 0u;
        UF_long block_size = 0u;
        UF_long current_local = 0u;
        int ok = kls_egraph_btf_scalar_run_group_state_block_info(
          solver, current, &k1, &k2, &block_size, &current_local);
        if (ok && (selected_dep < k1 || selected_dep >= k2 ||
                   selected_dep >= current)) {
          ok = 0;
        }
        const UF_long dep_local = ok ? selected_dep - k1 : 0u;
        if (ok && (dep_local >= current_local || dep_local >= block_size)) {
          ok = 0;
        }
        const UF_long state_begin = state_begin_by_claim[i];
        const UF_long state_count = state_count_by_claim[i];
        const UF_long *state_rows =
          ok ? solver->refactor_btf_scalar_run_group_state_rows + state_begin
             : NULL;
        const UF_long dep_rel =
          ok ? kls_lower_bound_uf_long_count(state_rows, state_count,
                                             dep_local)
             : 0u;
        if (ok && (dep_rel >= state_count ||
                   state_rows[dep_rel] != dep_local)) {
          ok = 0;
        }
        if (!ok) {
          active[i] = 0u;
          atomic_store_explicit(
            &shared->btf_scalar_run_group_wake_live[member],
            KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED, memory_order_release);
          rejected_count++;
          continue;
        }
        window_candidates[valid_count++] = i;
      }
      if (valid_count < min_window_fanout) {
        continue;
      }

      for (UF_long v = 0u; v < valid_count; ++v) {
        const UF_long i = window_candidates[v];
        const UF_long member = claimed_members[i];
        const UF_long current =
          solver->refactor_btf_scalar_run_group_currents[member];
        UF_long k1 = 0u;
        UF_long k2 = 0u;
        UF_long block_size = 0u;
        UF_long current_local = 0u;
        (void)kls_egraph_btf_scalar_run_group_state_block_info(
          solver, current, &k1, &k2, &block_size, &current_local);
        (void)k2;
        (void)current_local;
        const UF_long dep_local = selected_dep - k1;
        const UF_long state_begin = state_begin_by_claim[i];
        const UF_long *state_rows =
          solver->refactor_btf_scalar_run_group_state_rows + state_begin;
        const UF_long state_count = state_count_by_claim[i];
        const UF_long dep_rel =
          kls_lower_bound_uf_long_count(state_rows, state_count, dep_local);
        if (dep_rel >= state_count || state_rows[dep_rel] != dep_local) {
          active[i] = 0u;
          atomic_store_explicit(
            &shared->btf_scalar_run_group_wake_live[member],
            KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED, memory_order_release);
          rejected_count++;
          continue;
        }
        const UF_long dep_value_pos = value_begin_by_claim[i] + dep_rel;
        const double ujk =
          shared->btf_scalar_run_group_state_values[dep_value_pos];
        if (shared->btf_scalar_run_group_state_u_values != NULL) {
          shared->btf_scalar_run_group_state_u_values[dep_value_pos] = ujk;
        }
        shared->btf_scalar_run_group_state_values[dep_value_pos] = 0.0;
        coefficients[i] = ujk;
        if (sorted_l && dep_local != UF_long_max) {
          state_cursor[i] =
            kls_lower_bound_uf_long_count(state_rows, state_count,
                                          dep_local + 1u);
        } else {
          state_cursor[i] = sorted_l ? state_count : 0u;
        }
        (void)block_size;
      }

      UF_long window_active_count = 0u;
      for (UF_long v = 0u; v < valid_count; ++v) {
        const UF_long i = window_candidates[v];
        if (active[i] && coefficients[i] != 0.0) {
          window_active_count++;
        }
      }
      kls_egraph_apply_btf_scalar_run_group_state_l_to_claims(
        worker, shared, win_rows32, win_rows, win_lx, win_lcol_len,
        claimed_members, state_begin_by_claim, state_count_by_claim,
        value_begin_by_claim, state_cursor, coefficients, claimed_count,
        window_candidates, valid_count, 1, sorted_l, position_max_entries,
        active, &window_active_count, &rejected_count);

      UF_long round_advanced = 0u;
      for (UF_long v = 0u; v < valid_count; ++v) {
        const UF_long i = window_candidates[v];
        if (!active[i]) {
          continue;
        }
        const UF_long member = claimed_members[i];
        const UF_long rows_member =
          solver->refactor_btf_scalar_run_group_current_rows[member];
        const UF_long next =
          shared->btf_scalar_run_group_state_next[member];
        const UF_long rel = claimed_steps[i];
        const UF_long group =
          solver->refactor_btf_scalar_run_group_step_groups[step_begin + rel];
        const UF_long dep0 =
          solver->refactor_btf_scalar_run_group_dep0[group];
        if (next > UF_long_max - dep0 || dep0 + next != selected_dep) {
          active[i] = 0u;
          atomic_store_explicit(
            &shared->btf_scalar_run_group_wake_live[member],
            KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED, memory_order_release);
          rejected_count++;
          continue;
        }
        const UF_long new_next = next + 1u;
        shared->btf_scalar_run_group_state_next[member] = new_next;
        producer_offsets[i] = new_next;
        advanced_currents++;
        window_currents++;
        round_advanced++;
        advance_entries =
          win_lcol_len > UF_long_max - advance_entries
            ? UF_long_max : advance_entries + win_lcol_len;
        window_entries =
          win_lcol_len > UF_long_max - window_entries
            ? UF_long_max : window_entries + win_lcol_len;
        if (new_next >= rows_member) {
          atomic_store_explicit(
            &shared->btf_scalar_run_group_wake_live[member],
            KLS_BTF_SCALAR_RUN_GROUP_WAKE_READY, memory_order_release);
          ready_currents++;
        }
      }
      if (round_advanced == 0u) {
        break;
      }
      window_rounds++;
    }

    for (UF_long i = 0u; i < claimed_count; ++i) {
      if (!active[i]) {
        continue;
      }
      const UF_long member = claimed_members[i];
      if (atomic_load_explicit(
            &shared->btf_scalar_run_group_wake_live[member],
            memory_order_acquire) != KLS_BTF_SCALAR_RUN_GROUP_WAKE_PREPARING) {
        continue;
      }
      const UF_long rows_member =
        solver->refactor_btf_scalar_run_group_current_rows[member];
      if (shared->btf_scalar_run_group_state_next[member] >= rows_member) {
        atomic_store_explicit(
          &shared->btf_scalar_run_group_wake_live[member],
          KLS_BTF_SCALAR_RUN_GROUP_WAKE_READY, memory_order_release);
        ready_currents++;
      } else {
        atomic_store_explicit(
          &shared->btf_scalar_run_group_wake_live[member],
          KLS_BTF_SCALAR_RUN_GROUP_WAKE_ARMED, memory_order_release);
      }
    }
  }

  UF_long live_step_runtime_full_steps = 0u;
  UF_long live_step_runtime_full_currents = 0u;
  UF_long live_step_runtime_full_rows = 0u;
  UF_long live_step_runtime_partial_steps = 0u;
  UF_long live_step_runtime_partial_currents = 0u;
  UF_long live_step_runtime_partial_members = 0u;
  UF_long live_step_runtime_partial_rows = 0u;
  UF_long live_step_runtime_partial_active_rows = 0u;
  UF_long live_step_runtime_partial_active_unique_rows = 0u;
  if (advanced_currents > 0u &&
      solver->refactor_btf_scalar_run_group_live_step_ptr != NULL) {
    const UF_long *live_step_ptr =
      solver->refactor_btf_scalar_run_group_live_step_ptr;
    for (UF_long i = 0u; i < claimed_count; ++i) {
      if (!active[i]) {
        continue;
      }
      const UF_long rel = claimed_steps[i];
      if (rel < step_span) {
        step_active_count[rel] =
          kls_saturating_add_uf_long(step_active_count[rel], 1u);
      }
    }
    int partial_owner_ready = 0;
    if (partial_owner_stats && step_active_ptr != NULL &&
        step_active_fill != NULL && partial_members != NULL &&
        partial_cursors != NULL && partial_offsets != NULL) {
      UF_long prefix = 0u;
      step_active_ptr[0] = 0u;
      for (UF_long rel = 0u; rel < step_span; ++rel) {
        step_active_fill[rel] = prefix;
        prefix =
          step_active_count[rel] > UF_long_max - prefix
            ? UF_long_max : prefix + step_active_count[rel];
        step_active_ptr[rel + 1u] = prefix;
      }
      if (prefix <= member_capacity) {
        partial_owner_ready = 1;
        for (UF_long i = 0u; i < claimed_count; ++i) {
          if (!active[i]) {
            continue;
          }
          const UF_long rel = claimed_steps[i];
          if (rel >= step_span) {
            partial_owner_ready = 0;
            break;
          }
          const UF_long pos = step_active_fill[rel]++;
          if (pos >= member_capacity) {
            partial_owner_ready = 0;
            break;
          }
          partial_members[pos] = claimed_members[i];
        }
      }
    }
    for (UF_long rel = 0u; rel < step_span; ++rel) {
      const UF_long active_members = step_active_count[rel];
      const UF_long structural_members = step_member_count[rel];
      if (active_members == 0u || structural_members <= 1u) {
        continue;
      }
      const UF_long step = step_begin + rel;
      if (step >= solver->refactor_btf_scalar_run_group_step_count) {
        continue;
      }
      const UF_long begin = live_step_ptr[step];
      const UF_long end = live_step_ptr[step + 1u];
      if (end <= begin) {
        continue;
      }
      if (active_members == structural_members) {
        live_step_runtime_full_steps =
          kls_saturating_add_uf_long(live_step_runtime_full_steps, 1u);
        live_step_runtime_full_currents =
          kls_saturating_add_uf_long(live_step_runtime_full_currents,
                                     active_members);
        live_step_runtime_full_rows =
          kls_saturating_add_uf_long(live_step_runtime_full_rows, end - begin);
      } else {
        live_step_runtime_partial_steps =
          kls_saturating_add_uf_long(live_step_runtime_partial_steps, 1u);
        live_step_runtime_partial_currents =
          kls_saturating_add_uf_long(live_step_runtime_partial_currents,
                                     active_members);
        live_step_runtime_partial_members =
          kls_saturating_add_uf_long(live_step_runtime_partial_members,
                                     structural_members);
        live_step_runtime_partial_rows =
          kls_saturating_add_uf_long(live_step_runtime_partial_rows,
                                     end - begin);
        if (partial_owner_ready) {
          const UF_long subset_begin = step_active_ptr[rel];
          const UF_long subset_end = step_active_ptr[rel + 1u];
          UF_long active_rows = 0u;
          UF_long active_unique_rows = 0u;
          if (subset_end > subset_begin &&
              subset_end - subset_begin == active_members &&
              kls_egraph_btf_scalar_run_group_state_member_row_union(
                solver, partial_members + subset_begin,
                subset_end - subset_begin, partial_cursors + subset_begin,
                partial_offsets + subset_begin, &active_rows,
                &active_unique_rows)) {
            live_step_runtime_partial_active_rows =
              kls_saturating_add_uf_long(
                live_step_runtime_partial_active_rows, active_rows);
            live_step_runtime_partial_active_unique_rows =
              kls_saturating_add_uf_long(
                live_step_runtime_partial_active_unique_rows,
                active_unique_rows);
          }
        }
      }
    }
  }

  UF_long batch_state_rows = 0u;
  UF_long batch_unique_state_rows = 0u;
  if (advanced_currents > 0u &&
      shared->btf_scalar_run_group_state_advance_batch_stats) {
    (void)kls_egraph_btf_scalar_run_group_state_step_batch_row_union(
      solver, claimed_members, active, claimed_count, state_cursor,
      producer_offsets, &batch_state_rows, &batch_unique_state_rows);
  }

  if (advanced_currents > 0u) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_step_advance_currents,
      (unsigned long)advanced_currents, memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_step_advance_rows,
      (unsigned long)advanced_currents, memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_step_advance_entries,
      (unsigned long)advance_entries, memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_step_batch_steps,
      (unsigned long)(step_end - step_begin), memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_step_batch_currents,
      (unsigned long)advanced_currents, memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_step_batch_entries,
      (unsigned long)advance_entries, memory_order_relaxed);
    if (shared->btf_scalar_run_group_state_advance_batch_stats) {
      atomic_fetch_add_explicit(
        &shared->btf_scalar_run_group_state_step_batch_state_rows,
        (unsigned long)batch_state_rows, memory_order_relaxed);
      atomic_fetch_add_explicit(
        &shared->btf_scalar_run_group_state_step_batch_unique_state_rows,
        (unsigned long)batch_unique_state_rows, memory_order_relaxed);
    }
    if (live_step_runtime_full_steps > 0u) {
      atomic_fetch_add_explicit(
        &shared->btf_scalar_run_group_live_step_runtime_full_steps,
        (unsigned long)live_step_runtime_full_steps, memory_order_relaxed);
      atomic_fetch_add_explicit(
        &shared->btf_scalar_run_group_live_step_runtime_full_currents,
        (unsigned long)live_step_runtime_full_currents, memory_order_relaxed);
      atomic_fetch_add_explicit(
        &shared->btf_scalar_run_group_live_step_runtime_full_rows,
        (unsigned long)live_step_runtime_full_rows, memory_order_relaxed);
    }
    if (live_step_runtime_partial_steps > 0u) {
      atomic_fetch_add_explicit(
        &shared->btf_scalar_run_group_live_step_runtime_partial_steps,
        (unsigned long)live_step_runtime_partial_steps, memory_order_relaxed);
      atomic_fetch_add_explicit(
        &shared->btf_scalar_run_group_live_step_runtime_partial_currents,
        (unsigned long)live_step_runtime_partial_currents,
        memory_order_relaxed);
      atomic_fetch_add_explicit(
        &shared->btf_scalar_run_group_live_step_runtime_partial_members,
        (unsigned long)live_step_runtime_partial_members, memory_order_relaxed);
      atomic_fetch_add_explicit(
        &shared->btf_scalar_run_group_live_step_runtime_partial_rows,
        (unsigned long)live_step_runtime_partial_rows, memory_order_relaxed);
      if (live_step_runtime_partial_active_rows > 0u) {
        atomic_fetch_add_explicit(
          &shared
             ->btf_scalar_run_group_live_step_runtime_partial_active_rows,
          (unsigned long)live_step_runtime_partial_active_rows,
          memory_order_relaxed);
        atomic_fetch_add_explicit(
          &shared
             ->btf_scalar_run_group_live_step_runtime_partial_active_unique_rows,
          (unsigned long)live_step_runtime_partial_active_unique_rows,
          memory_order_relaxed);
      }
    }
    if (window_rounds > 0u) {
      atomic_fetch_add_explicit(
        &shared->btf_scalar_run_group_state_step_window_rounds,
        (unsigned long)window_rounds, memory_order_relaxed);
      atomic_fetch_add_explicit(
        &shared->btf_scalar_run_group_state_step_window_currents,
        (unsigned long)window_currents, memory_order_relaxed);
      atomic_fetch_add_explicit(
        &shared->btf_scalar_run_group_state_step_window_entries,
        (unsigned long)window_entries, memory_order_relaxed);
    }
  }
  if (ready_currents > 0u) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_step_advance_ready_currents,
      (unsigned long)ready_currents, memory_order_relaxed);
  }
  if (rejected_count > 0u) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_step_advance_rejects,
      (unsigned long)rejected_count, memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_rejects,
      (unsigned long)rejected_count, memory_order_relaxed);
  }
  return advanced_currents > 0u || ready_currents > 0u || rejected_count > 0u;
}

static int kls_egraph_refactor_try_advance_btf_scalar_run_group_state_step(
  kls_egraph_refactor_worker *worker,
  UF_long group,
  UF_long member) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || !shared->btf_scalar_run_group_state_step_advance ||
      shared->btf_scalar_run_group_wake_live == NULL ||
      shared->btf_scalar_run_group_state_next == NULL ||
      group >= solver->refactor_btf_scalar_run_group_multi_count ||
      member >= shared->btf_scalar_run_group_wake_live_count ||
      member >= shared->btf_scalar_run_group_state_next_count ||
      member >= solver->refactor_btf_scalar_run_group_multi_current_total ||
      solver->refactor_btf_scalar_run_group_dep0 == NULL ||
      solver->refactor_btf_scalar_run_group_current_rows == NULL) {
    return 0;
  }

  const UF_long dep0 = solver->refactor_btf_scalar_run_group_dep0[group];
  const UF_long rows =
    solver->refactor_btf_scalar_run_group_current_rows[member];
  if (rows == 0u || dep0 > solver->n || rows > solver->n - dep0) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_step_advance_rejects, 1ul,
      memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_rejects, 1ul,
      memory_order_relaxed);
    return 0;
  }

  UF_long total_rows = 0u;
  UF_long total_entries = 0u;
  int ready = 0;
  int rejected = 0;
  for (;;) {
    unsigned state = atomic_load_explicit(
      &shared->btf_scalar_run_group_wake_live[member],
      memory_order_acquire);
    if (state == KLS_BTF_SCALAR_RUN_GROUP_WAKE_READY ||
        state == KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED ||
        state == KLS_BTF_SCALAR_RUN_GROUP_WAKE_CONSUMED) {
      break;
    }
    if (state != KLS_BTF_SCALAR_RUN_GROUP_WAKE_ARMED) {
      break;
    }
    unsigned expected = KLS_BTF_SCALAR_RUN_GROUP_WAKE_ARMED;
    if (!atomic_compare_exchange_weak_explicit(
          &shared->btf_scalar_run_group_wake_live[member], &expected,
          KLS_BTF_SCALAR_RUN_GROUP_WAKE_PREPARING, memory_order_acq_rel,
          memory_order_acquire)) {
      continue;
    }

    for (;;) {
      const UF_long next = shared->btf_scalar_run_group_state_next[member];
      if (next > rows) {
        rejected = 1;
        break;
      }
      if (next == rows) {
        ready = 1;
        break;
      }
      const UF_long dep = dep0 + next;
      if (!kls_egraph_refactor_dependency_done_now(shared, dep)) {
        break;
      }
      UF_long advanced_rows = 0u;
      UF_long advanced_entries = 0u;
      if (!kls_egraph_advance_btf_scalar_run_group_state_window(
            worker, group, member, next, 1u, &advanced_rows,
            &advanced_entries) ||
          advanced_rows == 0u) {
        rejected = 1;
        break;
      }
      shared->btf_scalar_run_group_state_next[member] =
        next + advanced_rows;
      total_rows =
        advanced_rows > UF_long_max - total_rows
          ? UF_long_max : total_rows + advanced_rows;
      total_entries =
        advanced_entries > UF_long_max - total_entries
          ? UF_long_max : total_entries + advanced_entries;
    }

    if (rejected) {
      atomic_store_explicit(&shared->btf_scalar_run_group_wake_live[member],
                            KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED,
                            memory_order_release);
      break;
    }
    if (ready) {
      atomic_store_explicit(&shared->btf_scalar_run_group_wake_live[member],
                            KLS_BTF_SCALAR_RUN_GROUP_WAKE_READY,
                            memory_order_release);
      break;
    }
    atomic_store_explicit(&shared->btf_scalar_run_group_wake_live[member],
                          KLS_BTF_SCALAR_RUN_GROUP_WAKE_ARMED,
                          memory_order_release);

    const UF_long next = shared->btf_scalar_run_group_state_next[member];
    if (next >= rows ||
        kls_egraph_refactor_dependency_done_now(shared, dep0 + next)) {
      continue;
    }
    break;
  }

  if (total_rows > 0u) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_step_advance_currents, 1ul,
      memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_step_advance_rows,
      (unsigned long)total_rows, memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_step_advance_entries,
      (unsigned long)total_entries, memory_order_relaxed);
  }
  if (ready) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_step_advance_ready_currents, 1ul,
      memory_order_relaxed);
  }
  if (rejected) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_step_advance_rejects, 1ul,
      memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_rejects, 1ul,
      memory_order_relaxed);
  }
  return total_rows > 0u || ready || rejected;
}

static int kls_egraph_refactor_process_btf_scalar_run_group_state_steps(
  kls_egraph_refactor_worker *worker,
  UF_long producer_col) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || !shared->btf_scalar_run_group_state_step_advance ||
      producer_col >= solver->n ||
      solver->refactor_btf_scalar_run_group_step_ptr == NULL ||
      solver->refactor_btf_scalar_run_group_step_groups == NULL ||
      solver->refactor_btf_scalar_run_group_step_member_ptr == NULL ||
      solver->refactor_btf_scalar_run_group_step_members == NULL) {
    return 0;
  }

  UF_long step_begin = 0u;
  UF_long step_end = 0u;
  if (!kls_refactor_btf_scalar_run_group_step_range_for_dep(
        solver, producer_col, &step_begin, &step_end)) {
    return 0;
  }
  if (step_begin >= step_end ||
      step_end > solver->refactor_btf_scalar_run_group_step_count) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_state_step_advance_triggers, 1ul,
    memory_order_relaxed);
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_state_step_advance_steps,
    (unsigned long)(step_end - step_begin), memory_order_relaxed);

  const int producer_batch_status =
    kls_egraph_refactor_try_advance_btf_scalar_run_group_state_producer_batch(
      worker, producer_col, step_begin, step_end);
  if (producer_batch_status < 0) {
    return -1;
  }

  for (UF_long step = step_begin; step < step_end; ++step) {
    const UF_long group =
      solver->refactor_btf_scalar_run_group_step_groups[step];
    const UF_long member_begin =
      solver->refactor_btf_scalar_run_group_step_member_ptr[step];
    const UF_long member_end =
      solver->refactor_btf_scalar_run_group_step_member_ptr[step + 1u];
    if (group >= solver->refactor_btf_scalar_run_group_multi_count ||
        member_begin > member_end ||
        member_end > solver->refactor_btf_scalar_run_group_step_member_total) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    for (UF_long p = member_begin; p < member_end; ++p) {
      const UF_long member =
        solver->refactor_btf_scalar_run_group_step_members[p];
      if (member >= solver->refactor_btf_scalar_run_group_multi_current_total) {
        kls_egraph_refactor_record_invalid(shared);
        return -1;
      }
      (void)kls_egraph_refactor_try_advance_btf_scalar_run_group_state_step(
        worker, group, member);
    }
  }
  return 0;
}

static void kls_egraph_record_btf_scalar_run_group_state_exec_reject(
  kls_egraph_refactor_shared *shared) {
  if (shared == NULL) {
    return;
  }
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_state_exec_rejects, 1ul,
    memory_order_relaxed);
}

static void
kls_egraph_record_btf_scalar_run_group_state_exec_dispatch_bypass(
  kls_egraph_refactor_worker *worker,
  UF_long current) {
  if (worker == NULL || worker->shared == NULL ||
      !worker->shared->btf_scalar_run_group_state_exec) {
    return;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || current >= solver->n ||
      shared->btf_scalar_run_group_wake_live == NULL ||
      solver->refactor_btf_scalar_run_group_state_current_best_member ==
        NULL ||
      solver->refactor_btf_scalar_run_group_currents == NULL) {
    return;
  }
  const UF_long member =
    solver->refactor_btf_scalar_run_group_state_current_best_member[current];
  if (member == KLS_KLU_EMPTY ||
      member >= shared->btf_scalar_run_group_wake_live_count ||
      member >= solver->refactor_btf_scalar_run_group_multi_current_total ||
      solver->refactor_btf_scalar_run_group_currents[member] != current) {
    return;
  }
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_state_exec_dispatch_bypass_currents, 1ul,
    memory_order_relaxed);
  if (atomic_load_explicit(&shared->btf_scalar_run_group_wake_live[member],
                           memory_order_acquire) ==
      KLS_BTF_SCALAR_RUN_GROUP_WAKE_READY) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_exec_dispatch_bypass_ready_currents,
      1ul, memory_order_relaxed);
  }
}

static int
kls_egraph_refactor_try_publish_terminal_btf_scalar_run_group_state(
  kls_egraph_refactor_worker *worker,
  UF_long current,
  UF_long local_k,
  UF_long ucol_len,
  const UF_long *ui,
  const int32_t *ui32,
  double *ux,
  int record_u_value,
  UF_long member) {
  if (worker == NULL || worker->shared == NULL || ux == NULL ||
      (ui == NULL && ui32 == NULL && ucol_len > 0u)) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || current >= solver->n || current < local_k ||
      solver->symbolic == NULL || solver->symbolic->Q == NULL ||
      solver->numeric == NULL || solver->numeric->Udiag == NULL ||
      solver->numeric->Llen == NULL ||
      solver->refactor_l_values == NULL ||
      shared->btf_scalar_run_group_state_values == NULL ||
      shared->btf_scalar_run_group_state_u_values == NULL ||
      solver->refactor_btf_scalar_run_group_state_ptr == NULL ||
      solver->refactor_btf_scalar_run_group_state_rows == NULL) {
    return 0;
  }

  const UF_long k1 = current - local_k;
  const UF_long lcol_len = solver->numeric->Llen[current];
  const UF_long *li =
    solver->refactor_l_indices != NULL ? solver->refactor_l_indices[current]
                                       : NULL;
  const int32_t *li32 =
    solver->refactor_l_indices32 != NULL
      ? solver->refactor_l_indices32[current] : NULL;
  double *lx = solver->refactor_l_values[current];
  if (lcol_len > 0u && (lx == NULL || (li == NULL && li32 == NULL))) {
    return 0;
  }
  const UF_long state_begin =
    solver->refactor_btf_scalar_run_group_state_ptr[member];
  const UF_long state_end =
    solver->refactor_btf_scalar_run_group_state_ptr[member + 1u];
  UF_long range_state_begin = 0u;
  UF_long state_count = 0u;
  UF_long value_begin = 0u;
  if (!kls_btf_scalar_run_group_state_value_range(
        shared, solver, member, &range_state_begin, &state_count,
        &value_begin) ||
      range_state_begin != state_begin ||
      state_end - state_begin != state_count) {
    return 0;
  }
  const UF_long *state_rows =
    solver->refactor_btf_scalar_run_group_state_rows + state_begin;

  UF_long pivot_pos = 0u;
  if (!kls_btf_scalar_run_group_state_position(
        solver, member, local_k, &pivot_pos)) {
    return 0;
  }
  const double *state_values = shared->btf_scalar_run_group_state_values;
  const double ukk = state_values[value_begin + (pivot_pos - state_begin)];
  if (ukk == 0.0) {
    kls_egraph_refactor_record_singular(
      shared, current, solver->symbolic->Q[current]);
    if (solver->common.halt_if_singular) {
      return -1;
    }
  }

  UF_long rejected_row = KLS_KLU_EMPTY;
  UF_long rejected_local_row = KLS_KLU_EMPTY;
  double rejected_multiplier_abs = -1.0;
  double rejected_pivot_abs = fabs(ukk);
  double rejected_candidate_abs = -1.0;
  if (solver->refactor_l_indices_sorted) {
    UF_long state_pos = 0u;
    for (UF_long p = 0u; p < lcol_len; ++p) {
      const UF_long row = li32 != NULL ? (UF_long)li32[p] : li[p];
      while (state_pos < state_count && state_rows[state_pos] < row) {
        state_pos++;
      }
      if (state_pos >= state_count || state_rows[state_pos] != row) {
        return 0;
      }
      if (!shared->check_pivots) {
        continue;
      }
      const double value = state_values[value_begin + state_pos];
      const double candidate_abs = fabs(value);
      const double multiplier_abs = fabs(value / ukk);
      if (isfinite(multiplier_abs) &&
          multiplier_abs * solver->common.tol <= 1.0 + 1.0e-12) {
        continue;
      }
      if (rejected_local_row == KLS_KLU_EMPTY ||
          (!isnan(candidate_abs) &&
           (isnan(rejected_candidate_abs) ||
            candidate_abs > rejected_candidate_abs))) {
        rejected_local_row = row;
        rejected_row = k1 + row;
        rejected_candidate_abs = candidate_abs;
        rejected_multiplier_abs = multiplier_abs;
      }
    }
  } else {
    for (UF_long p = 0u; p < lcol_len; ++p) {
      const UF_long row = li32 != NULL ? (UF_long)li32[p] : li[p];
      UF_long row_pos = 0u;
      if (!kls_btf_scalar_run_group_state_position(
            solver, member, row, &row_pos)) {
        return 0;
      }
      if (!shared->check_pivots) {
        continue;
      }
      const double value = state_values[value_begin + (row_pos - state_begin)];
      const double candidate_abs = fabs(value);
      const double multiplier_abs = fabs(value / ukk);
      if (isfinite(multiplier_abs) &&
          multiplier_abs * solver->common.tol <= 1.0 + 1.0e-12) {
        continue;
      }
      if (rejected_local_row == KLS_KLU_EMPTY ||
          (!isnan(candidate_abs) &&
           (isnan(rejected_candidate_abs) ||
            candidate_abs > rejected_candidate_abs))) {
        rejected_local_row = row;
        rejected_row = k1 + row;
        rejected_candidate_abs = candidate_abs;
        rejected_multiplier_abs = multiplier_abs;
      }
    }
  }
  if (rejected_local_row != KLS_KLU_EMPTY) {
    kls_egraph_refactor_record_reject(
      shared, current, solver->symbolic->Q[current], rejected_row,
      rejected_multiplier_abs, rejected_pivot_abs, rejected_candidate_abs);
    return -1;
  }

  for (UF_long up = 0u; up < ucol_len; ++up) {
    const UF_long dep_local = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
    UF_long dep_pos = 0u;
    if (!kls_btf_scalar_run_group_state_position(
          solver, member, dep_local, &dep_pos)) {
      return 0;
    }
    const double ujk =
      shared->btf_scalar_run_group_state_u_values[
        value_begin + (dep_pos - state_begin)];
    ux[up] = ujk;
    if (record_u_value) {
      kls_egraph_record_u_supernode_value(shared, k1 + dep_local, current,
                                          ujk);
    }
  }
  ((double *)solver->numeric->Udiag)[current] = ukk;
  if (record_u_value) {
    kls_egraph_record_u_supernode_value(shared, current, current, ukk);
  }

  if (solver->refactor_l_indices_sorted) {
    UF_long state_pos = 0u;
    for (UF_long p = 0u; p < lcol_len; ++p) {
      const UF_long row = li32 != NULL ? (UF_long)li32[p] : li[p];
      while (state_pos < state_count && state_rows[state_pos] < row) {
        state_pos++;
      }
      lx[p] = state_values[value_begin + state_pos] / ukk;
    }
  } else {
    for (UF_long p = 0u; p < lcol_len; ++p) {
      const UF_long row = li32 != NULL ? (UF_long)li32[p] : li[p];
      UF_long row_pos = 0u;
      (void)kls_btf_scalar_run_group_state_position(
        solver, member, row, &row_pos);
      lx[p] = state_values[value_begin + (row_pos - state_begin)] / ukk;
    }
  }
  if (solver->refactor_l_sorted_values != NULL &&
      solver->refactor_l_sorted_pos32 != NULL) {
    double *sorted_values = solver->refactor_l_sorted_values[current];
    const int32_t *sorted_pos = solver->refactor_l_sorted_pos32[current];
    if (sorted_values != NULL && sorted_pos != NULL) {
      for (UF_long p = 0u; p < lcol_len; ++p) {
        sorted_values[p] = lx[(UF_long)sorted_pos[p]];
      }
    }
  }
  return 1;
}

static int kls_egraph_refactor_try_restore_btf_scalar_run_group_state(
  kls_egraph_refactor_worker *worker,
  UF_long current,
  UF_long block_size,
  UF_long local_k,
  UF_long ucol_len,
  const UF_long *ui,
  const int32_t *ui32,
  double *ux,
  double *x,
  int record_u_value,
  UF_long *up_out) {
  if (up_out != NULL) {
    *up_out = 0u;
  }
  if (worker == NULL || worker->shared == NULL || up_out == NULL ||
      !worker->shared->btf_scalar_run_group_state_exec) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || current >= solver->n || local_k >= block_size ||
      (ui == NULL && ui32 == NULL && ucol_len > 0u) || ux == NULL ||
      x == NULL || shared->btf_scalar_run_group_wake_live == NULL ||
      shared->btf_scalar_run_group_state_values == NULL ||
      shared->btf_scalar_run_group_state_u_values == NULL ||
      solver->refactor_btf_scalar_run_group_state_ptr == NULL ||
      solver->refactor_btf_scalar_run_group_state_rows == NULL ||
      solver->refactor_btf_scalar_run_group_state_current_best_member ==
        NULL ||
      solver->refactor_btf_scalar_run_group_currents == NULL ||
      solver->refactor_btf_scalar_run_group_current_up == NULL ||
      solver->refactor_btf_scalar_run_group_current_rows == NULL) {
    return 0;
  }
  const UF_long best_member =
    solver->refactor_btf_scalar_run_group_state_current_best_member[current];
  if (best_member == KLS_KLU_EMPTY ||
      best_member >= shared->btf_scalar_run_group_wake_live_count ||
      best_member >= solver->refactor_btf_scalar_run_group_multi_current_total ||
      solver->refactor_btf_scalar_run_group_currents[best_member] !=
        current) {
    return 0;
  }

  const UF_long current_up =
    solver->refactor_btf_scalar_run_group_current_up[best_member];
  const UF_long rows =
    solver->refactor_btf_scalar_run_group_current_rows[best_member];
  if (rows == 0u || current_up > ucol_len || rows > ucol_len - current_up) {
    return 0;
  }
  const UF_long best_skip = current_up + rows;
  if (best_skip == 0u) {
    return 0;
  }

  const unsigned state = atomic_load_explicit(
    &shared->btf_scalar_run_group_wake_live[best_member],
    memory_order_acquire);
  if (state != KLS_BTF_SCALAR_RUN_GROUP_WAKE_READY) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_exec_not_ready_currents, 1ul,
      memory_order_relaxed);
    return 0;
  }

  unsigned expected = KLS_BTF_SCALAR_RUN_GROUP_WAKE_READY;
  if (!atomic_compare_exchange_strong_explicit(
        &shared->btf_scalar_run_group_wake_live[best_member], &expected,
        KLS_BTF_SCALAR_RUN_GROUP_WAKE_CONSUMED, memory_order_acq_rel,
        memory_order_acquire)) {
    return 0;
  }

  const UF_long state_begin =
    solver->refactor_btf_scalar_run_group_state_ptr[best_member];
  const UF_long state_end =
    solver->refactor_btf_scalar_run_group_state_ptr[best_member + 1u];
  UF_long range_state_begin = 0u;
  UF_long state_rows = 0u;
  UF_long value_begin = 0u;
  if (!kls_btf_scalar_run_group_state_value_range(
        shared, solver, best_member, &range_state_begin, &state_rows,
        &value_begin) ||
      range_state_begin != state_begin ||
      state_end - state_begin != state_rows) {
    kls_egraph_record_btf_scalar_run_group_state_exec_reject(shared);
    return 0;
  }
  for (UF_long p = state_begin; p < state_end; ++p) {
    if (solver->refactor_btf_scalar_run_group_state_rows[p] >= block_size) {
      kls_egraph_record_btf_scalar_run_group_state_exec_reject(shared);
      return 0;
    }
  }
  for (UF_long up = 0u; up < best_skip; ++up) {
    const UF_long dep_local = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
    if (dep_local >= local_k) {
      kls_egraph_record_btf_scalar_run_group_state_exec_reject(shared);
      return 0;
    }
    UF_long dep_pos = 0u;
    if (!kls_btf_scalar_run_group_state_position(
          solver, best_member, dep_local, &dep_pos)) {
      kls_egraph_record_btf_scalar_run_group_state_exec_reject(shared);
      return 0;
    }
  }

  const UF_long remaining_deps = ucol_len - best_skip;
  UF_long remaining_entries = 0u;
  if (remaining_deps == 0u) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_exec_terminal_currents, 1ul,
      memory_order_relaxed);
    const int terminal_status =
      kls_egraph_refactor_try_publish_terminal_btf_scalar_run_group_state(
        worker, current, local_k, ucol_len, ui, ui32, ux, record_u_value,
        best_member);
    if (terminal_status < 0) {
      return -1;
    }
    if (terminal_status > 0) {
      atomic_fetch_add_explicit(
        &shared->btf_scalar_run_group_state_exec_currents, 1ul,
        memory_order_relaxed);
      atomic_fetch_add_explicit(
        &shared->btf_scalar_run_group_state_exec_skipped_deps,
        (unsigned long)best_skip, memory_order_relaxed);
      *up_out = best_skip;
      return 2;
    }
  } else if (solver->numeric != NULL && solver->numeric->Llen != NULL &&
             current >= local_k) {
    const UF_long k1 = current - local_k;
    for (UF_long p = best_skip; p < ucol_len; ++p) {
      const UF_long dep_local = ui32 != NULL ? (UF_long)ui32[p] : ui[p];
      if (dep_local > UF_long_max - k1 || k1 + dep_local >= solver->n) {
        remaining_entries = UF_long_max;
        break;
      }
      const UF_long lcol_len = solver->numeric->Llen[k1 + dep_local];
      remaining_entries =
        lcol_len > UF_long_max - remaining_entries
          ? UF_long_max : remaining_entries + lcol_len;
    }
  }

  for (UF_long p = state_begin; p < state_end; ++p) {
    const UF_long row = solver->refactor_btf_scalar_run_group_state_rows[p];
    x[row] =
      shared->btf_scalar_run_group_state_values[value_begin + (p - state_begin)];
  }
  for (UF_long up = 0u; up < best_skip; ++up) {
    const UF_long dep_local = ui32 != NULL ? (UF_long)ui32[up] : ui[up];
    UF_long dep_pos = 0u;
    (void)kls_btf_scalar_run_group_state_position(
      solver, best_member, dep_local, &dep_pos);
    const double ujk =
      shared->btf_scalar_run_group_state_u_values[
        value_begin + (dep_pos - state_begin)];
    ux[up] = ujk;
    if (record_u_value) {
      kls_egraph_record_u_supernode_value(shared, current - local_k + dep_local,
                                          current, ujk);
    }
  }
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_state_exec_currents, 1ul,
    memory_order_relaxed);
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_state_exec_skipped_deps,
    (unsigned long)best_skip, memory_order_relaxed);
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_state_exec_restored_rows,
    (unsigned long)state_rows, memory_order_relaxed);
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_state_exec_remaining_deps,
    (unsigned long)remaining_deps, memory_order_relaxed);
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_state_exec_remaining_entries,
    (unsigned long)remaining_entries, memory_order_relaxed);
  *up_out = best_skip;
  return 1;
}

static int kls_egraph_refactor_try_claim_btf_scalar_group_column(
  kls_egraph_refactor_shared *shared,
  UF_long col) {
  if (shared == NULL || shared->solver == NULL ||
      shared->pipeline_claimed == NULL ||
      shared->pipeline_done == NULL ||
      shared->pipeline_generation == 0u ||
      shared->pipeline_claim_generation == 0u ||
      shared->pipeline_lease_generation == 0u ||
      col >= shared->solver->n) {
    return 0;
  }
  if (atomic_load_explicit(&shared->pipeline_done[col],
                           memory_order_acquire) ==
      shared->pipeline_generation) {
    return 0;
  }

  for (;;) {
    unsigned int owner =
      atomic_load_explicit(&shared->pipeline_claimed[col],
                           memory_order_acquire);
    if (owner == shared->pipeline_claim_generation ||
        owner == shared->pipeline_lease_generation) {
      return 0;
    }
    if (atomic_compare_exchange_weak_explicit(
          &shared->pipeline_claimed[col], &owner,
          shared->pipeline_claim_generation,
          memory_order_acq_rel, memory_order_acquire)) {
      return 1;
    }
  }
}

static int
kls_egraph_refactor_try_publish_terminal_btf_scalar_run_group_wake(
  kls_egraph_refactor_worker *worker,
  UF_long producer_col,
  UF_long group,
  UF_long member) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || !shared->btf_scalar_run_group_state_exec ||
      shared->pipeline_ready_queue || producer_col >= solver->n ||
      !kls_egraph_kernel_is_btf_unscaled(shared->kernel) ||
      shared->supernode_numeric_updates ||
      shared->supernode_consumer_plan_group_l_exec ||
      shared->u_supernode_ragged_l_updates ||
      shared->u_supernode_values ||
      shared->btf_scalar_run_group_wake_live == NULL ||
      member >= shared->btf_scalar_run_group_wake_live_count ||
      group >= solver->refactor_btf_scalar_run_group_multi_count ||
      member >= solver->refactor_btf_scalar_run_group_multi_current_total ||
      solver->numeric == NULL || solver->numeric->Ulen == NULL ||
      solver->refactor_btf_scalar_run_group_dep0 == NULL ||
      solver->refactor_btf_scalar_run_group_currents == NULL ||
      solver->refactor_btf_scalar_run_group_current_up == NULL ||
      solver->refactor_btf_scalar_run_group_current_rows == NULL ||
      solver->refactor_u_values == NULL ||
      (solver->refactor_u_indices == NULL &&
       solver->refactor_u_indices32 == NULL)) {
    return 0;
  }

  const UF_long current =
    solver->refactor_btf_scalar_run_group_currents[member];
  const UF_long current_up =
    solver->refactor_btf_scalar_run_group_current_up[member];
  const UF_long rows =
    solver->refactor_btf_scalar_run_group_current_rows[member];
  if (current == producer_col || current >= solver->n || rows == 0u) {
    return 0;
  }
  const UF_long ulen = solver->numeric->Ulen[current];
  if (current_up > ulen || rows > ulen - current_up ||
      current_up + rows != ulen) {
    return 0;
  }

  UF_long k1 = 0u;
  UF_long k2 = 0u;
  UF_long block_size = 0u;
  UF_long local_k = 0u;
  if (!kls_egraph_btf_scalar_run_group_state_block_info(
        solver, current, &k1, &k2, &block_size, &local_k) ||
      producer_col < k1 || producer_col >= current || current >= k2 ||
      local_k >= block_size) {
    return 0;
  }
  const UF_long dep0 = solver->refactor_btf_scalar_run_group_dep0[group];
  if (dep0 < k1 || dep0 >= current) {
    return 0;
  }
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_state_exec_wake_terminal_candidates, 1ul,
    memory_order_relaxed);

  UF_long pipeline_pos = KLS_KLU_EMPTY;
  const int has_pipeline_pos =
    kls_egraph_refactor_pipeline_position_for_column(
      shared, current, &pipeline_pos);
  if (!has_pipeline_pos) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_exec_wake_terminal_nonpipeline_currents,
      1ul, memory_order_relaxed);
  }
  if (!kls_egraph_refactor_column_dependencies_done(shared, current)) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_exec_wake_terminal_dependency_misses,
      1ul, memory_order_relaxed);
    return 0;
  }
  if (!kls_egraph_refactor_try_claim_btf_scalar_group_column(
        shared, current)) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_exec_wake_terminal_claim_misses,
      1ul, memory_order_relaxed);
    return 0;
  }

  const int32_t *ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[current] : NULL;
  const UF_long *ui =
    ui32 == NULL && solver->refactor_u_indices != NULL
      ? solver->refactor_u_indices[current] : NULL;
  double *ux = solver->refactor_u_values[current];
  if ((ui32 == NULL && ui == NULL && ulen > 0u) || ux == NULL) {
    if (!kls_egraph_refactor_dispatch_column(worker, current, 1)) {
      if (!kls_egraph_refactor_should_stop(shared)) {
        kls_egraph_refactor_record_invalid(shared);
      }
      return -1;
    }
    kls_egraph_refactor_mark_done(shared, current);
    const int followup_status =
      has_pipeline_pos
        ? kls_egraph_refactor_after_pipeline_column_done(worker, current)
        : kls_egraph_refactor_try_claim_btf_scalar_run_group_currents(
            worker, current);
    if (followup_status < 0) {
      return -1;
    }
    return 1;
  }

  const int terminal_status =
    kls_egraph_refactor_try_publish_terminal_btf_scalar_run_group_state(
      worker, current, local_k, ulen, ui, ui32, ux, 0, member);
  if (terminal_status < 0) {
    return -1;
  }
  if (terminal_status == 0) {
    if (!kls_egraph_refactor_dispatch_column(worker, current, 1)) {
      if (!kls_egraph_refactor_should_stop(shared)) {
        kls_egraph_refactor_record_invalid(shared);
      }
      return -1;
    }
    kls_egraph_refactor_mark_done(shared, current);
    const int followup_status =
      has_pipeline_pos
        ? kls_egraph_refactor_after_pipeline_column_done(worker, current)
        : kls_egraph_refactor_try_claim_btf_scalar_run_group_currents(
            worker, current);
    if (followup_status < 0) {
      return -1;
    }
    return 1;
  }

  atomic_store_explicit(&shared->btf_scalar_run_group_wake_live[member],
                        KLS_BTF_SCALAR_RUN_GROUP_WAKE_CONSUMED,
                        memory_order_release);
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_state_exec_terminal_currents, 1ul,
    memory_order_relaxed);
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_state_exec_wake_terminal_currents, 1ul,
    memory_order_relaxed);
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_state_exec_currents, 1ul,
    memory_order_relaxed);
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_state_exec_skipped_deps,
    (unsigned long)ulen, memory_order_relaxed);
  kls_egraph_refactor_mark_done(shared, current);
  const int followup_status =
    has_pipeline_pos
      ? kls_egraph_refactor_after_pipeline_column_done(worker, current)
      : kls_egraph_refactor_try_claim_btf_scalar_run_group_currents(
          worker, current);
  if (followup_status < 0) {
    return -1;
  }
  return 1;
}

static int kls_egraph_refactor_process_btf_scalar_run_group_wakes(
  kls_egraph_refactor_worker *worker,
  UF_long producer_col) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || !shared->btf_scalar_run_group_wake_stats ||
      shared->btf_scalar_run_group_wake_live == NULL ||
      shared->btf_scalar_run_group_wake_live_count == 0u ||
      producer_col >= solver->n ||
      solver->refactor_btf_scalar_run_group_wake_ptr == NULL ||
      solver->refactor_btf_scalar_run_group_wake_groups == NULL ||
      solver->refactor_btf_scalar_run_group_wake_members == NULL ||
      solver->refactor_btf_scalar_run_group_dep0 == NULL ||
      solver->refactor_btf_scalar_run_group_currents == NULL ||
      solver->refactor_btf_scalar_run_group_current_up == NULL ||
      solver->refactor_btf_scalar_run_group_current_rows == NULL) {
    return 0;
  }

  UF_long wake_begin = 0u;
  UF_long wake_end = 0u;
  if (!kls_refactor_btf_scalar_run_group_wake_range_for_dep(
        solver, producer_col, &wake_begin, &wake_end)) {
    return 0;
  }
  UF_long ready_currents = 0u;
  UF_long ready_rows = 0u;
  UF_long ready_entries = 0u;
  UF_long state_advanced_currents = 0u;
  UF_long state_advanced_rows = 0u;
  UF_long state_advanced_entries = 0u;
  UF_long state_rejects = 0u;
  UF_long state_exec_owned_ready_currents = 0u;
  UF_long state_exec_late_ready_currents = 0u;
  UF_long state_advance_batch_groups = 0u;
  UF_long state_advance_batch_currents = 0u;
  UF_long state_advance_batch_unique_entries = 0u;
  UF_long state_advance_batch_duplicate_entries = 0u;
  UF_long state_advance_batch_max_currents = 0u;
  const int collect_state_advance_batches =
    shared->btf_scalar_run_group_state_advance_batch_stats;
  for (UF_long wake = wake_begin; wake < wake_end; ++wake) {
    const UF_long begin =
      solver->refactor_btf_scalar_run_group_wake_ptr[wake];
    const UF_long end =
      solver->refactor_btf_scalar_run_group_wake_ptr[wake + 1u];
    if (begin > end ||
        end > solver->refactor_btf_scalar_run_group_multi_current_total) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    UF_long active_batch_group = KLS_KLU_EMPTY;
    UF_long active_batch_currents = 0u;
    UF_long active_batch_unique_entries = 0u;
    UF_long active_batch_duplicate_entries = 0u;
    for (UF_long p = begin; p < end; ++p) {
      const UF_long group =
        solver->refactor_btf_scalar_run_group_wake_groups[p];
      const UF_long member =
        solver->refactor_btf_scalar_run_group_wake_members[p];
      if (group >= solver->refactor_btf_scalar_run_group_multi_count ||
          member >= shared->btf_scalar_run_group_wake_live_count ||
          member >= solver->refactor_btf_scalar_run_group_multi_current_total) {
        kls_egraph_refactor_record_invalid(shared);
        return -1;
      }
      const UF_long dep0 = solver->refactor_btf_scalar_run_group_dep0[group];
      const UF_long current =
        solver->refactor_btf_scalar_run_group_currents[member];
      const UF_long current_up =
        solver->refactor_btf_scalar_run_group_current_up[member];
      const UF_long current_rows =
        solver->refactor_btf_scalar_run_group_current_rows[member];
      const unsigned wake_state = atomic_load_explicit(
        &shared->btf_scalar_run_group_wake_live[member],
        memory_order_acquire);
      if (wake_state != KLS_BTF_SCALAR_RUN_GROUP_WAKE_ARMED) {
        if (shared->btf_scalar_run_group_state_step_advance &&
            wake_state == KLS_BTF_SCALAR_RUN_GROUP_WAKE_READY) {
          if (shared->btf_scalar_run_group_state_exec) {
            int state_exec_observed = 0;
            if (kls_egraph_refactor_dependency_done_now(shared, current)) {
              state_exec_late_ready_currents++;
              state_exec_observed = 1;
            } else if (kls_egraph_refactor_column_owned_now(shared,
                                                            current)) {
              state_exec_owned_ready_currents++;
              state_exec_observed = 1;
            }
            if (!state_exec_observed) {
              const int terminal_publish_status =
                kls_egraph_refactor_try_publish_terminal_btf_scalar_run_group_wake(
                  worker, producer_col, group, member);
              if (terminal_publish_status < 0) {
                return -1;
              }
            }
          }
          ready_currents++;
          if (current_rows > UF_long_max - ready_rows) {
            ready_rows = UF_long_max;
          } else {
            ready_rows += current_rows;
          }
          const UF_long entries =
            kls_btf_scalar_run_l_entries(solver, dep0, current_rows);
          if (entries > UF_long_max - ready_entries) {
            ready_entries = UF_long_max;
          } else {
            ready_entries += entries;
          }
        } else if (collect_state_advance_batches) {
          kls_accumulate_btf_scalar_run_group_state_advance_batch(
            active_batch_currents, active_batch_unique_entries,
            active_batch_duplicate_entries, &state_advance_batch_groups,
            &state_advance_batch_currents,
            &state_advance_batch_unique_entries,
            &state_advance_batch_duplicate_entries,
            &state_advance_batch_max_currents);
          active_batch_currents = 0u;
          active_batch_unique_entries = 0u;
          active_batch_duplicate_entries = 0u;
        }
        continue;
      }
      const int ready =
        kls_egraph_refactor_btf_scalar_run_group_readiness(
          shared, current, current_up, dep0, current_rows);
      if ((ready & KLS_BTF_SCALAR_RUN_GROUP_RUN_READY) == 0) {
        if (collect_state_advance_batches) {
          kls_accumulate_btf_scalar_run_group_state_advance_batch(
            active_batch_currents, active_batch_unique_entries,
            active_batch_duplicate_entries, &state_advance_batch_groups,
            &state_advance_batch_currents,
            &state_advance_batch_unique_entries,
            &state_advance_batch_duplicate_entries,
            &state_advance_batch_max_currents);
          active_batch_currents = 0u;
          active_batch_unique_entries = 0u;
          active_batch_duplicate_entries = 0u;
        }
        continue;
      }
      if (shared->btf_scalar_run_group_state_step_advance) {
        (void)kls_egraph_refactor_try_advance_btf_scalar_run_group_state_step(
          worker, group, member);
        if (atomic_load_explicit(
              &shared->btf_scalar_run_group_wake_live[member],
              memory_order_acquire) != KLS_BTF_SCALAR_RUN_GROUP_WAKE_READY) {
          if (collect_state_advance_batches) {
            kls_accumulate_btf_scalar_run_group_state_advance_batch(
              active_batch_currents, active_batch_unique_entries,
              active_batch_duplicate_entries, &state_advance_batch_groups,
              &state_advance_batch_currents,
              &state_advance_batch_unique_entries,
              &state_advance_batch_duplicate_entries,
              &state_advance_batch_max_currents);
            active_batch_currents = 0u;
            active_batch_unique_entries = 0u;
            active_batch_duplicate_entries = 0u;
          }
          continue;
        }
        if (shared->btf_scalar_run_group_state_exec) {
          int state_exec_observed = 0;
          if (kls_egraph_refactor_dependency_done_now(shared, current)) {
            state_exec_late_ready_currents++;
            state_exec_observed = 1;
          } else if (kls_egraph_refactor_column_owned_now(shared, current)) {
            state_exec_owned_ready_currents++;
            state_exec_observed = 1;
          }
          if (!state_exec_observed) {
            const int terminal_publish_status =
              kls_egraph_refactor_try_publish_terminal_btf_scalar_run_group_wake(
                worker, producer_col, group, member);
            if (terminal_publish_status < 0) {
              return -1;
            }
          }
        }
      } else {
        unsigned expected = KLS_BTF_SCALAR_RUN_GROUP_WAKE_ARMED;
        const unsigned next_state =
          shared->btf_scalar_run_group_state_stats
            ? KLS_BTF_SCALAR_RUN_GROUP_WAKE_PREPARING
            : KLS_BTF_SCALAR_RUN_GROUP_WAKE_READY;
        if (!atomic_compare_exchange_strong_explicit(
              &shared->btf_scalar_run_group_wake_live[member], &expected,
              next_state, memory_order_acq_rel, memory_order_acquire)) {
          if (collect_state_advance_batches) {
            kls_accumulate_btf_scalar_run_group_state_advance_batch(
              active_batch_currents, active_batch_unique_entries,
              active_batch_duplicate_entries, &state_advance_batch_groups,
              &state_advance_batch_currents,
              &state_advance_batch_unique_entries,
              &state_advance_batch_duplicate_entries,
              &state_advance_batch_max_currents);
            active_batch_currents = 0u;
            active_batch_unique_entries = 0u;
            active_batch_duplicate_entries = 0u;
          }
          continue;
        }
        if (shared->btf_scalar_run_group_state_stats) {
          UF_long advanced_rows = 0u;
          UF_long advanced_entries = 0u;
          if (kls_egraph_advance_btf_scalar_run_group_state(
                worker, group, member, &advanced_rows, &advanced_entries)) {
            if (collect_state_advance_batches) {
              kls_note_btf_scalar_run_group_state_advance_batch_member(
                group, advanced_entries, &active_batch_group,
                &active_batch_currents, &active_batch_unique_entries,
                &active_batch_duplicate_entries, &state_advance_batch_groups,
                &state_advance_batch_currents,
                &state_advance_batch_unique_entries,
                &state_advance_batch_duplicate_entries,
                &state_advance_batch_max_currents);
            }
            atomic_store_explicit(
              &shared->btf_scalar_run_group_wake_live[member],
              KLS_BTF_SCALAR_RUN_GROUP_WAKE_READY, memory_order_release);
            if (shared->btf_scalar_run_group_state_exec) {
              int state_exec_observed = 0;
              if (kls_egraph_refactor_dependency_done_now(shared, current)) {
                state_exec_late_ready_currents++;
                state_exec_observed = 1;
              } else if (kls_egraph_refactor_column_owned_now(shared,
                                                              current)) {
                state_exec_owned_ready_currents++;
                state_exec_observed = 1;
              }
              if (!state_exec_observed) {
                const int terminal_publish_status =
                  kls_egraph_refactor_try_publish_terminal_btf_scalar_run_group_wake(
                    worker, producer_col, group, member);
                if (terminal_publish_status < 0) {
                  return -1;
                }
              }
            }
            state_advanced_currents++;
            state_advanced_rows =
              advanced_rows > UF_long_max - state_advanced_rows
                ? UF_long_max : state_advanced_rows + advanced_rows;
            state_advanced_entries =
              advanced_entries > UF_long_max - state_advanced_entries
                ? UF_long_max : state_advanced_entries + advanced_entries;
          } else {
            if (collect_state_advance_batches) {
              kls_accumulate_btf_scalar_run_group_state_advance_batch(
                active_batch_currents, active_batch_unique_entries,
                active_batch_duplicate_entries, &state_advance_batch_groups,
                &state_advance_batch_currents,
                &state_advance_batch_unique_entries,
                &state_advance_batch_duplicate_entries,
                &state_advance_batch_max_currents);
              active_batch_currents = 0u;
              active_batch_unique_entries = 0u;
              active_batch_duplicate_entries = 0u;
            }
            atomic_store_explicit(
              &shared->btf_scalar_run_group_wake_live[member],
              KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED, memory_order_release);
            state_rejects++;
            continue;
          }
        }
      }
      ready_currents++;
      if (current_rows > UF_long_max - ready_rows) {
        ready_rows = UF_long_max;
      } else {
        ready_rows += current_rows;
      }
      const UF_long entries =
        kls_btf_scalar_run_l_entries(solver, dep0, current_rows);
      if (entries > UF_long_max - ready_entries) {
        ready_entries = UF_long_max;
      } else {
        ready_entries += entries;
      }
    }
    if (collect_state_advance_batches) {
      kls_accumulate_btf_scalar_run_group_state_advance_batch(
        active_batch_currents, active_batch_unique_entries,
        active_batch_duplicate_entries, &state_advance_batch_groups,
        &state_advance_batch_currents, &state_advance_batch_unique_entries,
        &state_advance_batch_duplicate_entries,
        &state_advance_batch_max_currents);
    }
  }
  if (ready_currents > 0u) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_wake_ready_currents,
      (unsigned long)ready_currents, memory_order_relaxed);
    atomic_fetch_add_explicit(&shared->btf_scalar_run_group_wake_ready_rows,
                              (unsigned long)ready_rows,
                              memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_wake_ready_entries,
      (unsigned long)ready_entries, memory_order_relaxed);
  }
  if (state_advanced_currents > 0u) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_advanced_currents,
      (unsigned long)state_advanced_currents, memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_advanced_rows,
      (unsigned long)state_advanced_rows, memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_advanced_entries,
      (unsigned long)state_advanced_entries, memory_order_relaxed);
  }
  if (state_advance_batch_groups > 0u) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_advance_batch_groups,
      (unsigned long)state_advance_batch_groups, memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_advance_batch_currents,
      (unsigned long)state_advance_batch_currents, memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_advance_batch_unique_entries,
      (unsigned long)state_advance_batch_unique_entries,
      memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_advance_batch_duplicate_entries,
      (unsigned long)state_advance_batch_duplicate_entries,
      memory_order_relaxed);
    kls_atomic_update_max_ulong(
      &shared->btf_scalar_run_group_state_advance_batch_max_currents,
      state_advance_batch_max_currents);
  }
  if (state_rejects > 0u) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_rejects,
      (unsigned long)state_rejects, memory_order_relaxed);
  }
  if (state_exec_owned_ready_currents > 0u) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_exec_owned_ready_currents,
      (unsigned long)state_exec_owned_ready_currents, memory_order_relaxed);
  }
  if (state_exec_late_ready_currents > 0u) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_state_exec_late_ready_currents,
      (unsigned long)state_exec_late_ready_currents, memory_order_relaxed);
  }
  return 0;
}

static int kls_egraph_refactor_try_claim_btf_scalar_run_group_currents(
  kls_egraph_refactor_worker *worker,
  UF_long producer_col) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL ||
      (!shared->btf_scalar_run_group_claims &&
       !shared->btf_scalar_run_group_prefix_stats &&
       !shared->btf_scalar_run_group_wake_stats &&
       !shared->btf_scalar_run_group_state_step_advance) ||
      shared->pipeline_ready_queue ||
      producer_col >= solver->n ||
      solver->refactor_btf_scalar_run_group_multi_count == 0u ||
      solver->refactor_btf_scalar_run_group_ptr == NULL ||
      solver->refactor_btf_scalar_run_group_dep0 == NULL ||
      solver->refactor_btf_scalar_run_group_currents == NULL ||
      solver->refactor_btf_scalar_run_group_current_up == NULL ||
      solver->refactor_btf_scalar_run_group_current_rows == NULL) {
    return 0;
  }

  const int step_status =
    kls_egraph_refactor_process_btf_scalar_run_group_state_steps(
      worker, producer_col);
  if (step_status < 0) {
    return -1;
  }

  const int wake_status =
    kls_egraph_refactor_process_btf_scalar_run_group_wakes(
      worker, producer_col);
  if (wake_status < 0) {
    return -1;
  }

  UF_long group_begin = 0u;
  UF_long group_end = 0u;
  if (!kls_refactor_btf_scalar_run_group_range_for_dep0(
        solver, producer_col, &group_begin, &group_end)) {
    return 0;
  }
  if (group_begin >= group_end) {
    return 0;
  }

  UF_long candidate_total = 0u;
  for (UF_long group = group_begin; group < group_end; ++group) {
    const UF_long begin = solver->refactor_btf_scalar_run_group_ptr[group];
    const UF_long end = solver->refactor_btf_scalar_run_group_ptr[group + 1u];
    if (begin > end) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    if (end - begin > UF_long_max - candidate_total) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    candidate_total += end - begin;
  }
  if (candidate_total == 0u) {
    return 0;
  }
  if (shared->btf_scalar_run_group_claims &&
      candidate_total > (UF_long)(SIZE_MAX / (2u * sizeof(UF_long)))) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_claim_surface_triggers, 1ul,
    memory_order_relaxed);
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_claim_surface_groups,
    (unsigned long)(group_end - group_begin), memory_order_relaxed);
  atomic_fetch_add_explicit(
    &shared->btf_scalar_run_group_claim_surface_currents,
    (unsigned long)candidate_total, memory_order_relaxed);

  UF_long *claimed = NULL;
  if (shared->btf_scalar_run_group_claims) {
    claimed =
      (UF_long *)malloc((size_t)(2u * candidate_total) * sizeof(*claimed));
  }
  if (shared->btf_scalar_run_group_claims && claimed == NULL) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }

  UF_long claim_count = 0u;
  UF_long claimed_groups = 0u;
  UF_long prefix_ready_currents = 0u;
  UF_long prefix_ready_rows = 0u;
  UF_long prefix_ready_entries = 0u;
  UF_long run_ready_currents = 0u;
  UF_long run_ready_rows = 0u;
  UF_long run_ready_entries = 0u;
  for (UF_long group = group_begin; group < group_end; ++group) {
    const UF_long begin = solver->refactor_btf_scalar_run_group_ptr[group];
    const UF_long end = solver->refactor_btf_scalar_run_group_ptr[group + 1u];
    int group_claimed = 0;
    for (UF_long pos = begin; pos < end; ++pos) {
      const UF_long candidate =
        solver->refactor_btf_scalar_run_group_currents[pos];
      const UF_long current_up =
        solver->refactor_btf_scalar_run_group_current_up[pos];
      const UF_long current_rows =
        solver->refactor_btf_scalar_run_group_current_rows[pos];
      int ready = 0;
      if (shared->btf_scalar_run_group_prefix_stats ||
          shared->btf_scalar_run_group_wake_stats) {
        ready =
          kls_egraph_refactor_btf_scalar_run_group_readiness(
            shared, candidate, current_up, producer_col, current_rows);
      }
      if (shared->btf_scalar_run_group_prefix_stats) {
        if ((ready & KLS_BTF_SCALAR_RUN_GROUP_PREFIX_READY) != 0) {
          prefix_ready_currents++;
          if (current_rows > UF_long_max - prefix_ready_rows) {
            prefix_ready_rows = UF_long_max;
          } else {
            prefix_ready_rows += current_rows;
          }
          const UF_long entries =
            kls_btf_scalar_run_l_entries(solver, producer_col, current_rows);
          if (entries > UF_long_max - prefix_ready_entries) {
            prefix_ready_entries = UF_long_max;
          } else {
            prefix_ready_entries += entries;
          }
        }
        if ((ready & KLS_BTF_SCALAR_RUN_GROUP_RUN_READY) != 0) {
          run_ready_currents++;
          if (current_rows > UF_long_max - run_ready_rows) {
            run_ready_rows = UF_long_max;
          } else {
            run_ready_rows += current_rows;
          }
          const UF_long entries =
            kls_btf_scalar_run_l_entries(solver, producer_col, current_rows);
          if (entries > UF_long_max - run_ready_entries) {
            run_ready_entries = UF_long_max;
          } else {
            run_ready_entries += entries;
          }
        }
      }
      if (shared->btf_scalar_run_group_wake_stats &&
          (ready & KLS_BTF_SCALAR_RUN_GROUP_PREFIX_READY) != 0) {
        if (pos >= shared->btf_scalar_run_group_wake_live_count ||
            shared->btf_scalar_run_group_wake_live == NULL) {
          free(claimed);
          kls_egraph_refactor_record_invalid(shared);
          return -1;
        }
        if (shared->btf_scalar_run_group_state_exec &&
            (solver->refactor_btf_scalar_run_group_state_current_best_member ==
               NULL ||
             candidate >= solver->n ||
             solver->refactor_btf_scalar_run_group_state_current_best_member[
               candidate] != pos)) {
          continue;
        }
        unsigned expected = KLS_BTF_SCALAR_RUN_GROUP_WAKE_EMPTY;
        const unsigned armed_state =
          shared->btf_scalar_run_group_state_stats
            ? KLS_BTF_SCALAR_RUN_GROUP_WAKE_PREPARING
            : KLS_BTF_SCALAR_RUN_GROUP_WAKE_ARMED;
        if (atomic_compare_exchange_strong_explicit(
              &shared->btf_scalar_run_group_wake_live[pos], &expected,
              armed_state, memory_order_acq_rel, memory_order_acquire)) {
          int arm_ok = 1;
          UF_long state_rows = 0u;
          UF_long prefix_deps = 0u;
          if (shared->btf_scalar_run_group_state_stats) {
            arm_ok =
              kls_egraph_materialize_btf_scalar_run_group_state(
                worker, pos, &state_rows, &prefix_deps);
            if (arm_ok &&
                shared->btf_scalar_run_group_state_step_advance &&
                shared->btf_scalar_run_group_state_next != NULL &&
                pos < shared->btf_scalar_run_group_state_next_count) {
              shared->btf_scalar_run_group_state_next[pos] = 0u;
            }
            atomic_store_explicit(
              &shared->btf_scalar_run_group_wake_live[pos],
              arm_ok ? KLS_BTF_SCALAR_RUN_GROUP_WAKE_ARMED
                     : KLS_BTF_SCALAR_RUN_GROUP_WAKE_REJECTED,
              memory_order_release);
            if (arm_ok) {
              atomic_fetch_add_explicit(
                &shared
                   ->btf_scalar_run_group_state_materialized_currents,
                1ul, memory_order_relaxed);
              atomic_fetch_add_explicit(
                &shared->btf_scalar_run_group_state_materialized_rows,
                (unsigned long)state_rows, memory_order_relaxed);
              atomic_fetch_add_explicit(
                &shared
                   ->btf_scalar_run_group_state_materialized_prefix_deps,
                (unsigned long)prefix_deps, memory_order_relaxed);
            } else {
              atomic_fetch_add_explicit(
                &shared->btf_scalar_run_group_state_rejects, 1ul,
                memory_order_relaxed);
            }
          }
          if (!arm_ok) {
            continue;
          }
          atomic_fetch_add_explicit(
            &shared->btf_scalar_run_group_wake_armed_currents, 1ul,
            memory_order_relaxed);
          atomic_fetch_add_explicit(
            &shared->btf_scalar_run_group_wake_armed_rows,
            (unsigned long)current_rows, memory_order_relaxed);
          const UF_long entries =
            kls_btf_scalar_run_l_entries(solver, producer_col, current_rows);
          atomic_fetch_add_explicit(
            &shared->btf_scalar_run_group_wake_armed_entries,
            (unsigned long)entries, memory_order_relaxed);
          if (shared->btf_scalar_run_group_state_step_advance) {
            (void)kls_egraph_refactor_try_advance_btf_scalar_run_group_state_step(
              worker, group, pos);
          }
        }
      }
      if (!shared->btf_scalar_run_group_claims) {
        continue;
      }
      UF_long candidate_pos = KLS_KLU_EMPTY;
      if (candidate == producer_col || candidate >= solver->n ||
          !kls_egraph_refactor_pipeline_position_for_column(
            shared, candidate, &candidate_pos) ||
          !kls_egraph_refactor_column_dependencies_done(shared, candidate) ||
          !kls_egraph_refactor_try_claim_btf_scalar_group_column(
            shared, candidate)) {
        continue;
      }
      claimed[2u * claim_count] = candidate_pos;
      claimed[2u * claim_count + 1u] = candidate;
      claim_count++;
      group_claimed = 1;
    }
    if (group_claimed) {
      claimed_groups++;
    }
  }
  if (prefix_ready_currents > 0u) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_prefix_ready_currents,
      (unsigned long)prefix_ready_currents, memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_prefix_ready_rows,
      (unsigned long)prefix_ready_rows, memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_prefix_ready_entries,
      (unsigned long)prefix_ready_entries, memory_order_relaxed);
  }
  if (run_ready_currents > 0u) {
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_run_ready_currents,
      (unsigned long)run_ready_currents, memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_run_ready_rows,
      (unsigned long)run_ready_rows, memory_order_relaxed);
    atomic_fetch_add_explicit(
      &shared->btf_scalar_run_group_run_ready_entries,
      (unsigned long)run_ready_entries, memory_order_relaxed);
  }

  if (claim_count == 0u) {
    free(claimed);
    return 0;
  }
  atomic_fetch_add_explicit(&shared->btf_scalar_run_group_claim_triggers,
                            1ul, memory_order_relaxed);
  atomic_fetch_add_explicit(&shared->btf_scalar_run_group_claim_groups,
                            (unsigned long)claimed_groups,
                            memory_order_relaxed);
  atomic_fetch_add_explicit(&shared->btf_scalar_run_group_claim_currents,
                            (unsigned long)claim_count,
                            memory_order_relaxed);
  kls_sort_claimed_columns_by_position(claimed, claim_count);

  int processed = 0;
  for (UF_long i = 0u; i < claim_count; ++i) {
    const UF_long col = claimed[2u * i + 1u];
    if (kls_egraph_refactor_should_stop(shared)) {
      free(claimed);
      return -1;
    }
    if (!kls_egraph_refactor_dispatch_column(worker, col, 1)) {
      free(claimed);
      if (!kls_egraph_refactor_should_stop(shared)) {
        kls_egraph_refactor_record_invalid(shared);
      }
      return -1;
    }
    kls_egraph_refactor_mark_done(shared, col);
    processed = 1;
    if (kls_egraph_refactor_after_pipeline_column_done(worker, col) < 0) {
      free(claimed);
      return -1;
    }
  }

  free(claimed);
  return processed;
}

static int kls_egraph_refactor_enqueue_algorithm5_payoff_column(
  kls_egraph_refactor_shared *shared,
  UF_long col,
  int preclaimed) {
  if (shared == NULL || shared->solver == NULL ||
      !shared->supernode_algorithm5_payoff_queue ||
      shared->algorithm5_payoff_queue_cols == NULL ||
      shared->algorithm5_payoff_queue_slots == NULL ||
      shared->algorithm5_payoff_queue_flags == NULL ||
      shared->algorithm5_payoff_queue_capacity == 0u ||
      shared->pipeline_generation == 0u ||
      col >= shared->solver->n) {
    return 0;
  }
  if (shared->pipeline_done != NULL &&
      atomic_load_explicit(&shared->pipeline_done[col], memory_order_acquire) ==
        shared->pipeline_generation) {
    return 1;
  }
  const unsigned long pos =
    atomic_fetch_add_explicit(&shared->algorithm5_payoff_queue_tail, 1ul,
                              memory_order_acq_rel);
  if ((UF_long)pos >= shared->algorithm5_payoff_queue_capacity) {
    kls_egraph_refactor_record_invalid(shared);
    return 0;
  }
  shared->algorithm5_payoff_queue_cols[pos] = col;
  shared->algorithm5_payoff_queue_flags[pos] =
    preclaimed ? KLS_ALGORITHM5_PAYOFF_QUEUE_PRECLAIMED : 0u;
  atomic_store_explicit(&shared->algorithm5_payoff_queue_slots[pos],
                        shared->pipeline_generation, memory_order_release);
  return 1;
}

static int kls_egraph_refactor_try_pop_algorithm5_payoff_column(
  kls_egraph_refactor_shared *shared,
  UF_long *col_out,
  unsigned char *flags_out) {
  if (col_out != NULL) {
    *col_out = 0u;
  }
  if (flags_out != NULL) {
    *flags_out = 0u;
  }
  if (shared == NULL || !shared->supernode_algorithm5_payoff_queue ||
      shared->algorithm5_payoff_queue_cols == NULL ||
      shared->algorithm5_payoff_queue_slots == NULL ||
      shared->algorithm5_payoff_queue_flags == NULL ||
      shared->algorithm5_payoff_queue_capacity == 0u ||
      shared->pipeline_generation == 0u) {
    return 0;
  }
  for (;;) {
    const unsigned long head =
      atomic_load_explicit(&shared->algorithm5_payoff_queue_head,
                           memory_order_acquire);
    const unsigned long tail =
      atomic_load_explicit(&shared->algorithm5_payoff_queue_tail,
                           memory_order_acquire);
    if (head >= tail) {
      return 0;
    }
    unsigned long expected = head;
    if (atomic_compare_exchange_weak_explicit(
          &shared->algorithm5_payoff_queue_head, &expected, head + 1ul,
          memory_order_acq_rel, memory_order_acquire)) {
      if ((UF_long)head >= shared->algorithm5_payoff_queue_capacity) {
        kls_egraph_refactor_record_invalid(shared);
        return -1;
      }
      unsigned spin = 0u;
      while (atomic_load_explicit(
               &shared->algorithm5_payoff_queue_slots[head],
               memory_order_acquire) != shared->pipeline_generation) {
                 kls_cpu_relax();
        if (kls_egraph_refactor_should_stop(shared)) {
          return -1;
        }
        kls_egraph_pipeline_pause(&spin);
      }
      if (col_out != NULL) {
        *col_out = shared->algorithm5_payoff_queue_cols[head];
      }
      if (flags_out != NULL) {
        *flags_out = shared->algorithm5_payoff_queue_flags[head];
      }
      return 1;
    }
  }
}

static int kls_egraph_refactor_try_enter_algorithm5_payoff_queue(
  kls_egraph_refactor_shared *shared) {
  if (shared == NULL || !shared->supernode_algorithm5_payoff_queue ||
      shared->thread_count <= 1) {
    return 0;
  }
  const unsigned long max_active =
    (unsigned long)(shared->thread_count / 2 > 0
                      ? shared->thread_count / 2 : 1);
  for (;;) {
    unsigned long active =
      atomic_load_explicit(&shared->algorithm5_payoff_queue_active,
                           memory_order_acquire);
    if (active >= max_active) {
      return 0;
    }
    if (atomic_compare_exchange_weak_explicit(
          &shared->algorithm5_payoff_queue_active, &active, active + 1ul,
          memory_order_acq_rel, memory_order_acquire)) {
      return 1;
    }
  }
}

static void kls_egraph_refactor_leave_algorithm5_payoff_queue(
  kls_egraph_refactor_shared *shared) {
  if (shared == NULL || !shared->supernode_algorithm5_payoff_queue) {
    return;
  }
  atomic_fetch_sub_explicit(&shared->algorithm5_payoff_queue_active, 1ul,
                            memory_order_acq_rel);
}

static int kls_egraph_refactor_try_enqueue_algorithm5_payoff_group_currents(
  kls_egraph_refactor_worker *worker,
  UF_long current_col) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || !shared->supernode_algorithm5_payoff_queue ||
      shared->pipeline_ready_queue ||
      current_col >= solver->n ||
      solver->refactor_supernode_algorithm5_payoff_group_count == 0u ||
      solver->refactor_supernode_algorithm5_payoff_group_prefix_end == NULL ||
      solver->refactor_supernode_algorithm5_payoff_trigger_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_trigger_groups == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_currents == NULL) {
    return 0;
  }

  const UF_long trigger_begin =
    solver->refactor_supernode_algorithm5_payoff_trigger_ptr[current_col];
  const UF_long trigger_end =
    solver->refactor_supernode_algorithm5_payoff_trigger_ptr[current_col + 1u];
  if (trigger_begin > trigger_end ||
      trigger_end > solver->refactor_supernode_algorithm5_payoff_group_count) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }

  int enqueued = 0;
  UF_long prefetched = 0u;
  UF_long prefetch_limit = 0u;
  if (shared->supernode_algorithm5_payoff_queue_prefetch &&
      shared->thread_count > 0) {
    const UF_long threads = (UF_long)shared->thread_count;
    prefetch_limit = threads <= UF_long_max / 8u ? 8u * threads
                                                 : UF_long_max;
  }
  for (UF_long trigger_pos = trigger_begin; trigger_pos < trigger_end;
       ++trigger_pos) {
    const UF_long group =
      solver->refactor_supernode_algorithm5_payoff_trigger_groups[trigger_pos];
    if (group >= solver->refactor_supernode_algorithm5_payoff_group_count ||
        solver->refactor_supernode_algorithm5_payoff_group_prefix_end[group] !=
          current_col + 1u) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    const UF_long current_begin =
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group];
    const UF_long current_end =
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group + 1u];
    if (current_begin > current_end ||
        current_end >
          solver->refactor_supernode_algorithm5_payoff_group_current_total) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    if (current_end - current_begin <= 1u) {
      continue;
    }
    for (UF_long current_pos = current_begin; current_pos < current_end;
         ++current_pos) {
      const UF_long candidate =
        solver->refactor_supernode_algorithm5_payoff_group_currents[
          current_pos];
      if (candidate == current_col || candidate >= solver->n ||
          !kls_egraph_refactor_pipeline_position_for_column(
            shared, candidate, NULL)) {
        continue;
      }
      const int deps_done =
        kls_egraph_refactor_column_dependencies_done(shared, candidate);
      const int prefix_prefetch =
        !deps_done && prefetch_limit > 0u && prefetched < prefetch_limit;
      if (!deps_done && !prefix_prefetch) {
        continue;
      }
      if (prefix_prefetch) {
        if (!kls_egraph_refactor_enqueue_algorithm5_payoff_column(
              shared, candidate, 0)) {
          return -1;
        }
        prefetched++;
        enqueued = 1;
        continue;
      }
      if (!kls_egraph_refactor_try_claim_shape_column(shared, candidate)) {
        continue;
      }
      if (!kls_egraph_refactor_enqueue_algorithm5_payoff_column(
            shared, candidate, 1)) {
        return -1;
      }
      enqueued = 1;
    }
  }
  return enqueued;
}

static int kls_egraph_refactor_try_process_algorithm5_payoff_queue(
  kls_egraph_refactor_worker *worker) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  if (!shared->supernode_algorithm5_payoff_queue ||
      !kls_egraph_refactor_try_enter_algorithm5_payoff_queue(shared)) {
    return 0;
  }

  UF_long col = 0u;
  unsigned char queue_flags = 0u;
  const int popped =
    kls_egraph_refactor_try_pop_algorithm5_payoff_column(
      shared, &col, &queue_flags);
  if (popped <= 0) {
    kls_egraph_refactor_leave_algorithm5_payoff_queue(shared);
    return popped;
  }
  if (shared->solver == NULL || col >= shared->solver->n) {
    kls_egraph_refactor_leave_algorithm5_payoff_queue(shared);
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }
  const int preclaimed =
    (queue_flags & KLS_ALGORITHM5_PAYOFF_QUEUE_PRECLAIMED) != 0u;
  if (preclaimed) {
    if (shared->pipeline_done == NULL || shared->pipeline_generation == 0u) {
      kls_egraph_refactor_leave_algorithm5_payoff_queue(shared);
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    if (atomic_load_explicit(&shared->pipeline_done[col],
                             memory_order_acquire) ==
        shared->pipeline_generation) {
      kls_egraph_refactor_leave_algorithm5_payoff_queue(shared);
      return 0;
    }
    if (!kls_egraph_refactor_column_dependencies_done(shared, col)) {
      kls_egraph_refactor_leave_algorithm5_payoff_queue(shared);
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
  } else {
    if (!kls_egraph_refactor_column_dependencies_done(shared, col)) {
      kls_egraph_refactor_leave_algorithm5_payoff_queue(shared);
      return 0;
    }
    if (!kls_egraph_refactor_try_claim_shape_column(shared, col)) {
      kls_egraph_refactor_leave_algorithm5_payoff_queue(shared);
      return 0;
    }
  }
  if (kls_egraph_refactor_should_stop(shared)) {
    kls_egraph_refactor_leave_algorithm5_payoff_queue(shared);
    return -1;
  }
  if (!kls_egraph_refactor_dispatch_column(worker, col, 1)) {
    kls_egraph_refactor_leave_algorithm5_payoff_queue(shared);
    if (!kls_egraph_refactor_should_stop(shared)) {
      kls_egraph_refactor_record_invalid(shared);
    }
    return -1;
  }
  kls_egraph_refactor_mark_done(shared, col);
  const int enqueue_status =
    kls_egraph_refactor_try_enqueue_algorithm5_payoff_group_currents(
      worker, col);
  kls_egraph_refactor_leave_algorithm5_payoff_queue(shared);
  if (enqueue_status < 0) {
    return -1;
  }
  return 1;
}

static int kls_egraph_refactor_prepare_algorithm5_payoff_prefix_run(
  kls_egraph_refactor_worker *worker,
  UF_long run,
  UF_long current_slot) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || solver->symbolic == NULL ||
      solver->symbolic->R == NULL || solver->numeric == NULL ||
      solver->numeric->Ulen == NULL || solver->numeric->Llen == NULL ||
      solver->refactor_col_ptr == NULL || solver->refactor_row_idx == NULL ||
      solver->refactor_input_pos == NULL ||
      solver->refactor_u_indices == NULL || solver->refactor_u_values == NULL ||
      solver->refactor_l_indices == NULL || solver->refactor_l_values == NULL ||
      (solver->symbolic->nblocks != 1u &&
       solver->refactor_block_start == NULL) ||
      solver->refactor_u_supernode_col_id == NULL ||
      solver->refactor_u_supernode_start == NULL ||
      solver->refactor_u_supernode_local_start == NULL ||
      solver->refactor_u_supernode_width == NULL ||
      solver->refactor_u_supernode_dense_begin == NULL ||
      solver->refactor_u_supernode_l_valid == NULL ||
      solver->refactor_u_supernode_l_row_begin == NULL ||
      solver->refactor_u_supernode_l_row_ptr == NULL ||
      solver->refactor_u_supernode_l_cols == NULL ||
      solver->refactor_u_supernode_l_dense_values == NULL ||
      solver->refactor_supernode_consumer_plan_current == NULL ||
      solver->refactor_supernode_consumer_plan_dep == NULL ||
      solver->refactor_supernode_consumer_plan_panel_start == NULL ||
      solver->refactor_supernode_consumer_plan_panel_offset == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_group == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_current_pos == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_deps == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_slot_ptr ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_slots == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_prefix_rows == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_target_entries == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_target_slot_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_target_slots == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_workspace_rows == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_pattern_width == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_target_cols == NULL ||
      !shared->supernode_algorithm5_payoff_workspace ||
      shared->algorithm5_payoff_workspace_values == NULL ||
      shared->algorithm5_payoff_target_values == NULL ||
      shared->algorithm5_payoff_current_flags == NULL ||
      current_slot >= shared->algorithm5_payoff_current_count ||
      run >= solver->refactor_supernode_consumer_plan_run_count) {
    return 0;
  }

  const UF_long current =
    solver->refactor_supernode_consumer_plan_current[run];
  const UF_long dep = solver->refactor_supernode_consumer_plan_dep[run];
  const UF_long panel_start =
    solver->refactor_supernode_consumer_plan_panel_start[run];
  const UF_long panel_offset =
    solver->refactor_supernode_consumer_plan_panel_offset[run];
  const UF_long prefix_rows =
    solver->refactor_supernode_algorithm5_payoff_run_prefix_rows[run];
  const UF_long advance_deps =
    solver->refactor_supernode_algorithm5_payoff_run_advance_deps[run];
  if (current >= solver->n || dep >= current || prefix_rows == 0u ||
      panel_start >= solver->n || dep != panel_start + panel_offset ||
      solver->refactor_supernode_algorithm5_payoff_run_current_pos[run] !=
        current_slot) {
    return 0;
  }

  UF_long block = KLS_KLU_EMPTY;
  if (solver->symbolic->nblocks == 1u) {
    block = 0u;
  } else if (solver->refactor_col_block != NULL) {
    block = solver->refactor_col_block[current];
  } else {
    block = kls_block_for_pivot(solver, current);
  }
  if (block == KLS_KLU_EMPTY || block >= solver->symbolic->nblocks) {
    return 0;
  }
  const UF_long k1 = solver->symbolic->R[block];
  const UF_long k2 = solver->symbolic->R[block + 1u];
  if (k2 <= k1 || current < k1 || current >= k2 || dep < k1 ||
      dep >= k2) {
    return 0;
  }
  const UF_long block_size = k2 - k1;
  const UF_long local_k = current - k1;
  const UF_long dep_local = dep - k1;
  if (dep_local >= local_k || prefix_rows > local_k - dep_local ||
      block_size > (UF_long)(SIZE_MAX / sizeof(double))) {
    return 0;
  }

  const UF_long ulen = solver->numeric->Ulen[current];
  UF_long *ui = solver->refactor_u_indices[current];
  const int32_t *ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[current] : NULL;
  if (ui == NULL || advance_deps > ulen ||
      prefix_rows > ulen - advance_deps) {
    return 0;
  }
  for (UF_long p = 0u; p < advance_deps; ++p) {
    const UF_long j = ui32 != NULL ? (UF_long)ui32[p] : ui[p];
    if (j >= local_k || j > UF_long_max - k1 ||
        !kls_egraph_refactor_dependency_done_now(shared, k1 + j)) {
      return 0;
    }
  }
  for (UF_long local = 0u; local < prefix_rows; ++local) {
    const UF_long p = advance_deps + local;
    const UF_long j = ui32 != NULL ? (UF_long)ui32[p] : ui[p];
    if (j != dep_local + local || j > UF_long_max - k1 ||
        !kls_egraph_refactor_dependency_done_now(shared, k1 + j)) {
      return 0;
    }
  }

  const UF_long group =
    solver->refactor_supernode_algorithm5_payoff_run_group[run];
  if (group == KLS_KLU_EMPTY ||
      group >= solver->refactor_supernode_algorithm5_payoff_group_count) {
    return 0;
  }
  const UF_long current_begin =
    solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group];
  const UF_long current_end =
    solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group + 1u];
  if (current_begin > current_end || current_slot < current_begin ||
      current_slot >= current_end ||
      current_end >
        solver->refactor_supernode_algorithm5_payoff_group_current_total) {
    return 0;
  }
  const UF_long group_workspace_begin =
    solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr[
      current_begin];
  const UF_long workspace_begin =
    solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr[
      current_slot];
  const UF_long workspace_end =
    solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr[
      current_slot + 1u];
  const UF_long group_workspace_rows =
    solver->refactor_supernode_algorithm5_payoff_group_workspace_rows[group];
  if (workspace_end < workspace_begin ||
      workspace_begin < group_workspace_begin ||
      prefix_rows > workspace_end - workspace_begin ||
      workspace_end - group_workspace_begin > group_workspace_rows ||
      group_workspace_begin > shared->algorithm5_payoff_workspace_size ||
      group_workspace_rows >
        shared->algorithm5_payoff_workspace_size - group_workspace_begin) {
    return 0;
  }
  double *workspace =
    shared->algorithm5_payoff_workspace_values + workspace_begin;

  const UF_long target_slot_begin =
    solver->refactor_supernode_algorithm5_payoff_run_target_slot_ptr[run];
  const UF_long target_slots =
    solver->refactor_supernode_algorithm5_payoff_run_target_slots[run];
  const UF_long target_entries =
    solver->refactor_supernode_algorithm5_payoff_run_target_entries[run];
  if (target_slot_begin == KLS_KLU_EMPTY ||
      target_slot_begin > shared->algorithm5_payoff_target_size ||
      target_slots >
        shared->algorithm5_payoff_target_size - target_slot_begin ||
      target_slots == 0u) {
    return 0;
  }
  const UF_long *target_cols =
    solver->refactor_supernode_algorithm5_payoff_group_target_cols +
    target_slot_begin;
  double *target_values =
    shared->algorithm5_payoff_target_values + target_slot_begin;

  const UF_long pattern_width =
    solver->refactor_supernode_algorithm5_payoff_group_pattern_width[group];
  if (pattern_width == 0u || panel_offset > pattern_width ||
      prefix_rows > pattern_width - panel_offset) {
    return 0;
  }
  const UF_long panel = solver->refactor_u_supernode_col_id[dep];
  if (panel == KLS_KLU_EMPTY ||
      panel >= solver->refactor_u_supernode_pattern_count ||
      !solver->refactor_u_supernode_l_valid[panel]) {
    return 0;
  }
  const UF_long start = solver->refactor_u_supernode_start[panel];
  const UF_long local_start =
    solver->refactor_u_supernode_local_start[panel];
  const UF_long width = solver->refactor_u_supernode_width[panel];
  if (start != panel_start || width != pattern_width ||
      start > solver->n || width > solver->n - start ||
      local_start > dep_local || dep_local - local_start != panel_offset ||
      local_start > block_size || width > block_size - local_start) {
    return 0;
  }
  const UF_long row_base =
    solver->refactor_u_supernode_l_row_begin[panel] + panel_offset;
  if (row_base + prefix_rows > solver->refactor_u_supernode_pattern_rows) {
    return 0;
  }
  UF_long trailing_entries = 0u;
  for (UF_long local = 0u; local < prefix_rows; ++local) {
    const UF_long begin =
      solver->refactor_u_supernode_l_row_ptr[row_base + local];
    const UF_long end =
      solver->refactor_u_supernode_l_row_ptr[row_base + local + 1u];
    if (end < begin || end > solver->refactor_u_supernode_l_trailing_entries ||
        end - begin > UF_long_max - trailing_entries) {
      return 0;
    }
    trailing_entries += end - begin;
  }
  const UF_long available_end = panel_offset + prefix_rows;
  const UF_long dense_scatter_cols = width - available_end;
  const UF_long dense_entries = prefix_rows * dense_scatter_cols;
  if (target_entries != dense_entries + trailing_entries ||
      dense_scatter_cols > target_slots) {
    return 0;
  }
  const UF_long dense_target_slots = dense_scatter_cols;
  const UF_long trailing_target_slots = target_slots - dense_target_slots;
  for (UF_long slot = 0u; slot < dense_target_slots; ++slot) {
    const UF_long row = local_start + available_end + slot;
    if (row >= block_size || target_cols[slot] != row) {
      return 0;
    }
  }

  double *x = worker->x;
  const UF_long scatter_begin =
    solver->symbolic->nblocks == 1u
      ? solver->refactor_col_ptr[current]
      : solver->refactor_block_start[current];
  const UF_long scatter_end = solver->refactor_col_ptr[current + 1u];
  if (!kls_egraph_scatter_refactor_input(
        solver, shared->values, shared->rs, shared->scale, x, k1, k2,
        scatter_begin, scatter_end)) {
    memset(x, 0, (size_t)block_size * sizeof(*x));
    return 0;
  }

  for (UF_long p = 0u; p < advance_deps; ++p) {
    const UF_long j = ui32 != NULL ? (UF_long)ui32[p] : ui[p];
    const double ujk = x[j];
    x[j] = 0.0;
    if (ujk != 0.0) {
      UF_long *li = solver->refactor_l_indices[k1 + j];
      double *lx = solver->refactor_l_values[k1 + j];
      const UF_long lcol_len = solver->numeric->Llen[k1 + j];
      if ((li == NULL && solver->refactor_l_indices32 == NULL &&
           lcol_len > 0u) ||
          (lx == NULL && lcol_len > 0u)) {
        memset(x, 0, (size_t)block_size * sizeof(*x));
        return 0;
      }
      kls_scatter_subtract_refactor_l(
        solver, x, k1 + j, li, lx, lcol_len, ujk);
    }
  }

  UF_long target_stamp_value = 0u;
  UF_long *target_stamp = NULL;
  UF_long *target_pos = NULL;
  memset(target_values, 0, (size_t)target_slots * sizeof(*target_values));
  if (trailing_target_slots > 0u) {
    if (!kls_egraph_worker_row_target_workspace(worker, block_size)) {
      memset(x, 0, (size_t)block_size * sizeof(*x));
      return 0;
    }
    if (worker->row_target_stamp == UF_long_max) {
      memset(worker->row_target_stamp_workspace, 0,
             (size_t)block_size *
               sizeof(*worker->row_target_stamp_workspace));
      worker->row_target_stamp = 1u;
    } else {
      worker->row_target_stamp++;
      if (worker->row_target_stamp == 0u) {
        worker->row_target_stamp = 1u;
      }
    }
    target_stamp_value = worker->row_target_stamp;
    target_stamp = worker->row_target_stamp_workspace;
    target_pos = worker->row_target_pos_workspace;
    for (UF_long slot = dense_target_slots; slot < target_slots; ++slot) {
      const UF_long row = target_cols[slot];
      if (row >= block_size || target_stamp[row] == target_stamp_value) {
        memset(x, 0, (size_t)block_size * sizeof(*x));
        return 0;
      }
      target_stamp[row] = target_stamp_value;
      target_pos[row] = slot;
    }
  }

  for (UF_long local = 0u; local < prefix_rows; ++local) {
    workspace[local] = x[dep_local + local];
    x[dep_local + local] = 0.0;
  }
  const double *dense_panel =
    solver->refactor_u_supernode_l_dense_values +
    solver->refactor_u_supernode_dense_begin[panel];
  const UF_long *trailing_cols = solver->refactor_u_supernode_l_cols;
  const double *trailing_values = solver->refactor_u_supernode_l_values;
  if (trailing_entries > 0u &&
      (trailing_cols == NULL || trailing_values == NULL)) {
    memset(x, 0, (size_t)block_size * sizeof(*x));
    return 0;
  }
  for (UF_long local = 0u; local < prefix_rows; ++local) {
    const UF_long panel_local = panel_offset + local;
    const double ujk = workspace[local];
    const double *dense_row = dense_panel + panel_local * width;
    for (UF_long target = panel_local + 1u; target < width; ++target) {
      const double update = ujk * dense_row[target];
      if (target < available_end) {
        workspace[target - panel_offset] -= update;
      } else {
        const UF_long row = local_start + target;
        const UF_long slot = target - available_end;
        if (row >= block_size || slot >= dense_target_slots ||
            target_cols[slot] != row) {
          memset(x, 0, (size_t)block_size * sizeof(*x));
          return 0;
        }
        target_values[slot] += update;
      }
    }
    const UF_long row = row_base + local;
    const UF_long begin = solver->refactor_u_supernode_l_row_ptr[row];
    const UF_long end = solver->refactor_u_supernode_l_row_ptr[row + 1u];
    for (UF_long p = begin; p < end; ++p) {
      const UF_long target_row = trailing_cols[p];
      if (trailing_target_slots == 0u || target_row >= block_size ||
          target_stamp[target_row] != target_stamp_value) {
        memset(x, 0, (size_t)block_size * sizeof(*x));
        return 0;
      }
      target_values[target_pos[target_row]] += ujk * trailing_values[p];
    }
  }
  if (solver->refactor_row_idx32 != NULL) {
    const int32_t *rows32 = solver->refactor_row_idx32;
    for (UF_long p = scatter_begin; p < scatter_end; ++p) {
      const UF_long row = (UF_long)rows32[p];
      if (row >= k1 && row < k2) {
        x[row - k1] = 0.0;
      }
    }
  } else {
    const UF_long *rows = solver->refactor_row_idx;
    for (UF_long p = scatter_begin; p < scatter_end; ++p) {
      const UF_long row = rows[p];
      if (row >= k1 && row < k2) {
        x[row - k1] = 0.0;
      }
    }
  }
  const UF_long advance_slot_begin =
    solver->refactor_supernode_algorithm5_payoff_run_advance_slot_ptr[run];
  const UF_long advance_slots =
    solver->refactor_supernode_algorithm5_payoff_run_advance_slots[run];
  if (advance_slot_begin != KLS_KLU_EMPTY &&
      advance_slot_begin <=
        solver->refactor_supernode_algorithm5_payoff_group_advance_slots_total &&
      advance_slots <=
        solver->refactor_supernode_algorithm5_payoff_group_advance_slots_total -
          advance_slot_begin &&
      (advance_slots == 0u ||
       solver->refactor_supernode_algorithm5_payoff_group_advance_cols !=
         NULL)) {
    const UF_long *advance_cols =
      advance_slots > 0u
        ? solver->refactor_supernode_algorithm5_payoff_group_advance_cols +
            advance_slot_begin
        : NULL;
    for (UF_long slot = 0u; slot < advance_slots; ++slot) {
      if (advance_cols[slot] < block_size) {
        x[advance_cols[slot]] = 0.0;
      }
    }
  } else {
    memset(x, 0, (size_t)block_size * sizeof(*x));
  }
  for (UF_long local = 0u; local < prefix_rows; ++local) {
    x[dep_local + local] = 0.0;
  }
  for (UF_long slot = 0u; slot < target_slots; ++slot) {
    if (target_cols[slot] < block_size) {
      x[target_cols[slot]] = 0.0;
    }
  }
  return 1;
}

static int kls_algorithm5_payoff_prepare_state_row_lookup(
  kls_egraph_refactor_worker *worker,
  const kls_algorithm5_payoff_group_prefix_item *item,
  UF_long *stamp_value_out,
  UF_long **stamp_out,
  UF_long **pos_out) {
  if (stamp_value_out != NULL) {
    *stamp_value_out = 0u;
  }
  if (stamp_out != NULL) {
    *stamp_out = NULL;
  }
  if (pos_out != NULL) {
    *pos_out = NULL;
  }
  if (worker == NULL || item == NULL || stamp_value_out == NULL ||
      stamp_out == NULL || pos_out == NULL || item->block_size == 0u ||
      item->state_rows == 0u || item->state_row_idx == NULL ||
      item->state_values == NULL ||
      !kls_egraph_worker_row_target_workspace(worker, item->block_size)) {
    return 0;
  }
  if (worker->row_target_stamp == UF_long_max) {
    memset(worker->row_target_stamp_workspace, 0,
           (size_t)item->block_size *
             sizeof(*worker->row_target_stamp_workspace));
    worker->row_target_stamp = 1u;
  } else {
    worker->row_target_stamp++;
    if (worker->row_target_stamp == 0u) {
      worker->row_target_stamp = 1u;
    }
  }
  const UF_long stamp_value = worker->row_target_stamp;
  UF_long *stamp = worker->row_target_stamp_workspace;
  UF_long *pos = worker->row_target_pos_workspace;
  for (UF_long p = 0u; p < item->state_rows; ++p) {
    const UF_long row = item->state_row_idx[p];
    if (row >= item->block_size || stamp[row] == stamp_value) {
      return 0;
    }
    stamp[row] = stamp_value;
    pos[row] = p;
  }
  *stamp_value_out = stamp_value;
  *stamp_out = stamp;
  *pos_out = pos;
  return 1;
}

static int kls_algorithm5_payoff_state_value_position(
  const kls_algorithm5_payoff_group_prefix_item *item,
  UF_long row,
  UF_long stamp_value,
  const UF_long *stamp,
  const UF_long *pos,
  UF_long *state_pos_out) {
  if (state_pos_out != NULL) {
    *state_pos_out = 0u;
  }
  if (item == NULL || stamp == NULL || pos == NULL || state_pos_out == NULL ||
      row >= item->block_size || stamp[row] != stamp_value ||
      pos[row] >= item->state_rows) {
    return 0;
  }
  *state_pos_out = pos[row];
  return 1;
}

static int kls_algorithm5_payoff_state_value_position_sorted(
  const kls_algorithm5_payoff_group_prefix_item *item,
  UF_long row,
  UF_long *state_pos_out) {
  if (state_pos_out != NULL) {
    *state_pos_out = 0u;
  }
  if (item == NULL || item->state_row_idx == NULL ||
      state_pos_out == NULL || item->state_rows == 0u) {
    return 0;
  }
  UF_long lo = 0u;
  UF_long hi = item->state_rows;
  while (lo < hi) {
    const UF_long mid = lo + (hi - lo) / 2u;
    const UF_long value = item->state_row_idx[mid];
    if (value < row) {
      lo = mid + 1u;
    } else {
      hi = mid;
    }
  }
  if (lo >= item->state_rows || item->state_row_idx[lo] != row) {
    return 0;
  }
  *state_pos_out = lo;
  return 1;
}

static void kls_algorithm5_payoff_free_state_lookup_batch(
  kls_algorithm5_payoff_state_lookup_batch *lookup) {
  if (lookup == NULL) {
    return;
  }
  free(lookup->ptr);
  free(lookup->keys);
  free(lookup->pos);
  lookup->item_count = 0u;
  lookup->ptr = NULL;
  lookup->keys = NULL;
  lookup->pos = NULL;
}

static int kls_algorithm5_payoff_state_lookup_capacity(
  UF_long row_count,
  UF_long *capacity_out) {
  if (capacity_out != NULL) {
    *capacity_out = 0u;
  }
  if (capacity_out == NULL || row_count == 0u ||
      row_count > UF_long_max / 2u) {
    return 0;
  }
  UF_long need = 2u * row_count;
  UF_long capacity = 2u;
  while (capacity < need) {
    if (capacity > UF_long_max / 2u) {
      return 0;
    }
    capacity *= 2u;
  }
  *capacity_out = capacity;
  return 1;
}

static inline UF_long kls_algorithm5_payoff_state_lookup_hash(
  UF_long row) {
  return (UF_long)(((uint64_t)row * UINT64_C(11400714819323198485)));
}

static int kls_algorithm5_payoff_build_state_lookup_batch(
  const kls_algorithm5_payoff_group_prefix_item *items,
  UF_long item_count,
  kls_algorithm5_payoff_state_lookup_batch *lookup) {
  if (lookup != NULL) {
    memset(lookup, 0, sizeof(*lookup));
  }
  if (items == NULL || lookup == NULL || item_count == 0u ||
      item_count > (UF_long)(SIZE_MAX / sizeof(*lookup->ptr)) - 1u) {
    return 0;
  }
  UF_long *ptr =
    (UF_long *)malloc((size_t)(item_count + 1u) * sizeof(*ptr));
  if (ptr == NULL) {
    return -1;
  }
  UF_long total_capacity = 0u;
  for (UF_long i = 0u; i < item_count; ++i) {
    UF_long capacity = 0u;
    if (items[i].state_rows == 0u ||
        !kls_algorithm5_payoff_state_lookup_capacity(items[i].state_rows,
                                                     &capacity) ||
        capacity > UF_long_max - total_capacity) {
      free(ptr);
      return 0;
    }
    ptr[i] = total_capacity;
    total_capacity += capacity;
  }
  ptr[item_count] = total_capacity;
  if (total_capacity == 0u ||
      total_capacity > (UF_long)(SIZE_MAX / sizeof(UF_long))) {
    free(ptr);
    return 0;
  }
  UF_long *keys =
    (UF_long *)malloc((size_t)total_capacity * sizeof(*keys));
  UF_long *pos =
    (UF_long *)malloc((size_t)total_capacity * sizeof(*pos));
  if (keys == NULL || pos == NULL) {
    free(ptr);
    free(keys);
    free(pos);
    return -1;
  }
  for (UF_long p = 0u; p < total_capacity; ++p) {
    keys[p] = KLS_KLU_EMPTY;
    pos[p] = 0u;
  }

  for (UF_long i = 0u; i < item_count; ++i) {
    const kls_algorithm5_payoff_group_prefix_item *item = &items[i];
    if (item->state_row_idx == NULL || item->state_rows == 0u) {
      free(ptr);
      free(keys);
      free(pos);
      return 0;
    }
    const UF_long begin = ptr[i];
    const UF_long capacity = ptr[i + 1u] - begin;
    const UF_long mask = capacity - 1u;
    for (UF_long p = 0u; p < item->state_rows; ++p) {
      const UF_long row = item->state_row_idx[p];
      if (row == KLS_KLU_EMPTY || row >= item->block_size) {
        free(ptr);
        free(keys);
        free(pos);
        return 0;
      }
      UF_long h = begin + (kls_algorithm5_payoff_state_lookup_hash(row) & mask);
      for (;;) {
        if (keys[h] == KLS_KLU_EMPTY) {
          keys[h] = row;
          pos[h] = p;
          break;
        }
        if (keys[h] == row) {
          free(ptr);
          free(keys);
          free(pos);
          return 0;
        }
        h = begin + ((h - begin + 1u) & mask);
      }
    }
  }
  lookup->item_count = item_count;
  lookup->ptr = ptr;
  lookup->keys = keys;
  lookup->pos = pos;
  return 1;
}

static int kls_algorithm5_payoff_state_lookup_batch_position(
  const kls_algorithm5_payoff_state_lookup_batch *lookup,
  UF_long item_index,
  UF_long row,
  UF_long *state_pos_out) {
  if (state_pos_out != NULL) {
    *state_pos_out = 0u;
  }
  if (lookup == NULL || lookup->ptr == NULL || lookup->keys == NULL ||
      lookup->pos == NULL || item_index >= lookup->item_count ||
      state_pos_out == NULL) {
    return 0;
  }
  const UF_long begin = lookup->ptr[item_index];
  const UF_long end = lookup->ptr[item_index + 1u];
  if (end <= begin) {
    return 0;
  }
  const UF_long capacity = end - begin;
  const UF_long mask = capacity - 1u;
  UF_long h = begin + (kls_algorithm5_payoff_state_lookup_hash(row) & mask);
  for (UF_long probes = 0u; probes < capacity; ++probes) {
    const UF_long key = lookup->keys[h];
    if (key == row) {
      *state_pos_out = lookup->pos[h];
      return 1;
    }
    if (key == KLS_KLU_EMPTY) {
      return 0;
    }
    h = begin + ((h - begin + 1u) & mask);
  }
  return 0;
}

static int kls_algorithm5_payoff_group_state_position(
  const kls_algorithm5_payoff_group_prefix_item *items,
  const kls_algorithm5_payoff_state_lookup_batch *lookup,
  UF_long item_index,
  UF_long row,
  UF_long *state_pos_out) {
  if (lookup != NULL && lookup->ptr != NULL) {
    return kls_algorithm5_payoff_state_lookup_batch_position(
      lookup, item_index, row, state_pos_out);
  }
  return kls_algorithm5_payoff_state_value_position_sorted(
    &items[item_index], row, state_pos_out);
}

static int kls_algorithm5_payoff_add_sparse_restore_row(
  const kls_algorithm5_payoff_group_prefix_item *item,
  UF_long row,
  UF_long stamp_value,
  const UF_long *stamp,
  const UF_long *pos,
  unsigned char *needed,
  UF_long *needed_rows,
  UF_long needed_capacity,
  UF_long *needed_count_io) {
  UF_long state_pos = 0u;
  if (needed == NULL || needed_rows == NULL || needed_count_io == NULL ||
      !kls_algorithm5_payoff_state_value_position(
        item, row, stamp_value, stamp, pos, &state_pos)) {
    return 0;
  }
  (void)state_pos;
  if (needed[row] != 0u) {
    return 1;
  }
  if (*needed_count_io >= needed_capacity) {
    return 0;
  }
  needed[row] = 1u;
  needed_rows[*needed_count_io] = row;
  (*needed_count_io)++;
  return 1;
}

static int kls_algorithm5_payoff_add_l_sparse_restore_rows(
  const kls_solver *solver,
  const kls_algorithm5_payoff_group_prefix_item *item,
  UF_long column,
  UF_long stamp_value,
  const UF_long *stamp,
  const UF_long *pos,
  unsigned char *needed,
  UF_long *needed_rows,
  UF_long needed_capacity,
  UF_long *needed_count_io) {
  if (solver == NULL || solver->numeric == NULL ||
      solver->numeric->Llen == NULL || column >= solver->n) {
    return 0;
  }
  const UF_long length = solver->numeric->Llen[column];
  const int32_t *rows32 =
    solver->refactor_l_indices32 != NULL
      ? solver->refactor_l_indices32[column] : NULL;
  const UF_long *rows =
    rows32 == NULL && solver->refactor_l_indices != NULL
      ? solver->refactor_l_indices[column] : NULL;
  if (length > 0u && rows32 == NULL && rows == NULL) {
    return 0;
  }
  for (UF_long p = 0u; p < length; ++p) {
    const UF_long row = rows32 != NULL ? (UF_long)rows32[p] : rows[p];
    if (!kls_algorithm5_payoff_add_sparse_restore_row(
          item, row, stamp_value, stamp, pos, needed, needed_rows,
          needed_capacity, needed_count_io)) {
      return 0;
    }
  }
  return 1;
}

static int kls_algorithm5_payoff_clear_sparse_restore_scatter(
  const kls_solver *solver,
  UF_long k1,
  UF_long current,
  UF_long block_size,
  const unsigned char *needed,
  double *x) {
  if (solver == NULL || solver->refactor_col_ptr == NULL ||
      (solver->refactor_row_idx == NULL && solver->refactor_row_idx32 == NULL) ||
      needed == NULL || x == NULL || current >= solver->n ||
      block_size == 0u || k1 > UF_long_max - block_size) {
    return 0;
  }
  const UF_long k2 = k1 + block_size;
  const UF_long scatter_col_begin = solver->refactor_col_ptr[current];
  const UF_long scatter_end = solver->refactor_col_ptr[current + 1u];
  if (scatter_col_begin > scatter_end || scatter_end > solver->nnz) {
    return 0;
  }
  UF_long scatter_begin = scatter_col_begin;
  if (solver->symbolic != NULL && solver->symbolic->nblocks != 1u) {
    if (solver->refactor_block_start == NULL ||
        solver->refactor_block_start[current] < scatter_col_begin ||
        solver->refactor_block_start[current] > scatter_end) {
      return 0;
    }
    scatter_begin = solver->refactor_block_start[current];
  }
  if (solver->refactor_row_idx32 != NULL) {
    const int32_t *rows32 = solver->refactor_row_idx32;
    for (UF_long p = scatter_begin; p < scatter_end; ++p) {
      const UF_long row = (UF_long)rows32[p];
      if (row >= k1 && row < k2) {
        const UF_long local = row - k1;
        if (needed[local] == 0u) {
          x[local] = 0.0;
        }
      }
    }
  } else {
    const UF_long *rows = solver->refactor_row_idx;
    for (UF_long p = scatter_begin; p < scatter_end; ++p) {
      const UF_long row = rows[p];
      if (row >= k1 && row < k2) {
        const UF_long local = row - k1;
        if (needed[local] == 0u) {
          x[local] = 0.0;
        }
      }
    }
  }
  return 1;
}

static int kls_egraph_refactor_prepare_algorithm5_payoff_group_item(
  kls_egraph_refactor_worker *worker,
  UF_long group,
  UF_long current_slot,
  UF_long run,
  kls_algorithm5_payoff_group_prefix_item *item) {
  if (item != NULL) {
    memset(item, 0, sizeof(*item));
  }
  if (worker == NULL || worker->shared == NULL || item == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  const int direct_prefix =
    shared->supernode_algorithm5_payoff_direct_prefix_prep;
  const int direct_prefix_current_state =
    shared->supernode_algorithm5_payoff_direct_prefix_current_state;
  const int direct_prefix_final_state =
    shared->supernode_algorithm5_payoff_direct_prefix_final_state;
  if (solver == NULL || solver->symbolic == NULL ||
      solver->symbolic->R == NULL || solver->numeric == NULL ||
      solver->numeric->Ulen == NULL || solver->numeric->Llen == NULL ||
      solver->refactor_col_ptr == NULL || solver->refactor_row_idx == NULL ||
      solver->refactor_input_pos == NULL ||
      solver->refactor_u_indices == NULL || solver->refactor_l_indices == NULL ||
      solver->refactor_l_values == NULL ||
      (solver->symbolic->nblocks != 1u &&
       solver->refactor_block_start == NULL) ||
      solver->refactor_u_supernode_col_id == NULL ||
      solver->refactor_u_supernode_start == NULL ||
      solver->refactor_u_supernode_local_start == NULL ||
      solver->refactor_u_supernode_width == NULL ||
      solver->refactor_u_supernode_l_valid == NULL ||
      solver->refactor_u_supernode_l_row_begin == NULL ||
      solver->refactor_u_supernode_l_row_ptr == NULL ||
      solver->refactor_u_supernode_l_cols == NULL ||
      solver->refactor_u_supernode_l_dense_values == NULL ||
      solver->refactor_supernode_consumer_plan_current == NULL ||
      solver->refactor_supernode_consumer_plan_dep == NULL ||
      solver->refactor_supernode_consumer_plan_panel_start == NULL ||
      solver->refactor_supernode_consumer_plan_panel_offset == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_group == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_current_pos == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_deps == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_slot_ptr ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_slots == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_prefix_rows == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_target_entries == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_target_slot_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_target_slots == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_workspace_rows == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_pattern_width == NULL ||
      (!direct_prefix &&
       solver->refactor_supernode_algorithm5_payoff_group_target_cols == NULL) ||
      (direct_prefix_final_state &&
       solver->refactor_supernode_algorithm5_payoff_group_target_cols == NULL) ||
      (direct_prefix_current_state &&
       (solver->refactor_supernode_algorithm5_payoff_current_state_ptr == NULL ||
        solver->refactor_supernode_algorithm5_payoff_current_state_rows == NULL ||
        (shared->algorithm5_payoff_current_state_size > 0u &&
         shared->algorithm5_payoff_current_state_values == NULL))) ||
      !shared->supernode_algorithm5_payoff_workspace ||
      shared->algorithm5_payoff_workspace_values == NULL ||
      (!direct_prefix && shared->algorithm5_payoff_target_values == NULL) ||
      current_slot >= shared->algorithm5_payoff_current_count ||
      run >= solver->refactor_supernode_consumer_plan_run_count ||
      group >= solver->refactor_supernode_algorithm5_payoff_group_count ||
      solver->refactor_supernode_algorithm5_payoff_run_group[run] != group ||
      solver->refactor_supernode_algorithm5_payoff_run_current_pos[run] !=
        current_slot) {
    return 0;
  }

  const UF_long current =
    solver->refactor_supernode_consumer_plan_current[run];
  const UF_long dep = solver->refactor_supernode_consumer_plan_dep[run];
  const UF_long panel_start =
    solver->refactor_supernode_consumer_plan_panel_start[run];
  const UF_long panel_offset =
    solver->refactor_supernode_consumer_plan_panel_offset[run];
  const UF_long prefix_rows =
    solver->refactor_supernode_algorithm5_payoff_run_prefix_rows[run];
  const UF_long advance_deps =
    solver->refactor_supernode_algorithm5_payoff_run_advance_deps[run];
  if (current >= solver->n || dep >= current || prefix_rows == 0u ||
      panel_start >= solver->n || dep != panel_start + panel_offset) {
    return 0;
  }

  UF_long block = KLS_KLU_EMPTY;
  if (solver->symbolic->nblocks == 1u) {
    block = 0u;
  } else if (solver->refactor_col_block != NULL) {
    block = solver->refactor_col_block[current];
  } else {
    block = kls_block_for_pivot(solver, current);
  }
  if (block == KLS_KLU_EMPTY || block >= solver->symbolic->nblocks) {
    return 0;
  }
  const UF_long k1 = solver->symbolic->R[block];
  const UF_long k2 = solver->symbolic->R[block + 1u];
  if (k2 <= k1 || current < k1 || current >= k2 || dep < k1 ||
      dep >= k2) {
    return 0;
  }
  const UF_long block_size = k2 - k1;
  const UF_long local_k = current - k1;
  const UF_long dep_local = dep - k1;
  if (dep_local >= local_k || prefix_rows > local_k - dep_local ||
      block_size > (UF_long)(SIZE_MAX / sizeof(double))) {
    return 0;
  }

  const UF_long ulen = solver->numeric->Ulen[current];
  UF_long *ui = solver->refactor_u_indices[current];
  const int32_t *ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[current] : NULL;
  if (ui == NULL || advance_deps > ulen ||
      prefix_rows > ulen - advance_deps) {
    return 0;
  }
  for (UF_long p = 0u; p < advance_deps; ++p) {
    const UF_long j = ui32 != NULL ? (UF_long)ui32[p] : ui[p];
    if (j >= local_k || j > UF_long_max - k1 ||
        !kls_egraph_refactor_dependency_done_now(shared, k1 + j)) {
      return 0;
    }
  }
  for (UF_long local = 0u; local < prefix_rows; ++local) {
    const UF_long p = advance_deps + local;
    const UF_long j = ui32 != NULL ? (UF_long)ui32[p] : ui[p];
    if (j != dep_local + local || j > UF_long_max - k1 ||
        !kls_egraph_refactor_dependency_done_now(shared, k1 + j)) {
      return 0;
    }
  }

  const UF_long current_begin =
    solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group];
  const UF_long current_end =
    solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group + 1u];
  if (current_begin > current_end || current_slot < current_begin ||
      current_slot >= current_end ||
      current_end >
        solver->refactor_supernode_algorithm5_payoff_group_current_total) {
    return 0;
  }
  const UF_long group_workspace_begin =
    solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr[
      current_begin];
  const UF_long workspace_begin =
    solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr[
      current_slot];
  const UF_long workspace_end =
    solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr[
      current_slot + 1u];
  const UF_long group_workspace_rows =
    solver->refactor_supernode_algorithm5_payoff_group_workspace_rows[group];
  if (workspace_end < workspace_begin ||
      workspace_begin < group_workspace_begin ||
      prefix_rows > workspace_end - workspace_begin ||
      workspace_end - group_workspace_begin > group_workspace_rows ||
      group_workspace_begin > shared->algorithm5_payoff_workspace_size ||
      group_workspace_rows >
        shared->algorithm5_payoff_workspace_size - group_workspace_begin) {
    return 0;
  }
  double *workspace =
    shared->algorithm5_payoff_workspace_values + workspace_begin;

  const int advance_slot_seed =
    shared->supernode_algorithm5_payoff_direct_prefix_advance_seed;
  const int advance_u_seed =
    advance_slot_seed || direct_prefix_current_state;
  const UF_long advance_slot_begin =
    solver->refactor_supernode_algorithm5_payoff_run_advance_slot_ptr[run];
  const UF_long advance_slots =
    solver->refactor_supernode_algorithm5_payoff_run_advance_slots[run];
  const UF_long advance_u_begin =
    solver->refactor_supernode_algorithm5_payoff_run_advance_ptr[run];
  const UF_long *advance_cols = NULL;
  double *advance_values = NULL;
  double *advance_u_values = NULL;
  if (advance_u_seed) {
    if (advance_u_begin == KLS_KLU_EMPTY ||
        advance_u_begin > shared->algorithm5_payoff_advance_u_size ||
        advance_deps >
          shared->algorithm5_payoff_advance_u_size - advance_u_begin ||
        (advance_deps > 0u &&
         shared->algorithm5_payoff_advance_u_values == NULL)) {
      return 0;
    }
    advance_u_values =
      advance_deps > 0u
        ? shared->algorithm5_payoff_advance_u_values + advance_u_begin
        : NULL;
  }
  if (advance_slot_seed) {
    if (advance_slot_begin == KLS_KLU_EMPTY ||
        advance_slot_begin > shared->algorithm5_payoff_advance_size ||
        advance_slots >
          shared->algorithm5_payoff_advance_size - advance_slot_begin ||
        (advance_slots > 0u &&
         (shared->algorithm5_payoff_advance_values == NULL ||
          solver->refactor_supernode_algorithm5_payoff_group_advance_cols ==
            NULL))) {
      return 0;
    }
    advance_cols =
      advance_slots > 0u
        ? solver->refactor_supernode_algorithm5_payoff_group_advance_cols +
            advance_slot_begin
        : NULL;
    advance_values =
      advance_slots > 0u
        ? shared->algorithm5_payoff_advance_values + advance_slot_begin
        : NULL;
  }

  const UF_long target_slot_begin =
    solver->refactor_supernode_algorithm5_payoff_run_target_slot_ptr[run];
  const UF_long target_slots =
    solver->refactor_supernode_algorithm5_payoff_run_target_slots[run];
  const UF_long target_entries =
    solver->refactor_supernode_algorithm5_payoff_run_target_entries[run];
  const UF_long *target_cols = NULL;
  double *target_values = NULL;
  if (!direct_prefix || (direct_prefix_final_state && target_slots > 0u)) {
    if (target_slot_begin == KLS_KLU_EMPTY ||
        (!direct_prefix &&
         (target_slot_begin > shared->algorithm5_payoff_target_size ||
          target_slots >
            shared->algorithm5_payoff_target_size - target_slot_begin)) ||
        (direct_prefix_final_state &&
         (target_slot_begin >
            solver->refactor_supernode_algorithm5_payoff_group_target_slots_total ||
          target_slots >
            solver->refactor_supernode_algorithm5_payoff_group_target_slots_total -
              target_slot_begin)) ||
        (!direct_prefix && target_slots == 0u)) {
      return 0;
    }
    target_cols =
      solver->refactor_supernode_algorithm5_payoff_group_target_cols +
      target_slot_begin;
    if (!direct_prefix) {
      target_values =
        shared->algorithm5_payoff_target_values + target_slot_begin;
    }
  }

  const UF_long pattern_width =
    solver->refactor_supernode_algorithm5_payoff_group_pattern_width[group];
  if (pattern_width == 0u || panel_offset > pattern_width ||
      prefix_rows > pattern_width - panel_offset) {
    return 0;
  }
  const UF_long panel = solver->refactor_u_supernode_col_id[dep];
  if (panel == KLS_KLU_EMPTY ||
      panel >= solver->refactor_u_supernode_pattern_count ||
      !solver->refactor_u_supernode_l_valid[panel]) {
    return 0;
  }
  const UF_long start = solver->refactor_u_supernode_start[panel];
  const UF_long local_start =
    solver->refactor_u_supernode_local_start[panel];
  const UF_long width = solver->refactor_u_supernode_width[panel];
  if (start != panel_start || width != pattern_width ||
      start > solver->n || width > solver->n - start ||
      local_start > dep_local || dep_local - local_start != panel_offset ||
      local_start > block_size || width > block_size - local_start) {
    return 0;
  }
  const UF_long row_base =
    solver->refactor_u_supernode_l_row_begin[panel] + panel_offset;
  if (row_base + prefix_rows > solver->refactor_u_supernode_pattern_rows) {
    return 0;
  }
  UF_long trailing_entries = 0u;
  for (UF_long local = 0u; local < prefix_rows; ++local) {
    const UF_long begin =
      solver->refactor_u_supernode_l_row_ptr[row_base + local];
    const UF_long end =
      solver->refactor_u_supernode_l_row_ptr[row_base + local + 1u];
    if (end < begin || end > solver->refactor_u_supernode_l_trailing_entries ||
        end - begin > UF_long_max - trailing_entries) {
      return 0;
    }
    trailing_entries += end - begin;
  }
  const UF_long available_end = panel_offset + prefix_rows;
  const UF_long dense_scatter_cols = width - available_end;
  const UF_long dense_entries = prefix_rows * dense_scatter_cols;
  if (target_entries != dense_entries + trailing_entries ||
      ((!direct_prefix || direct_prefix_final_state) &&
       dense_scatter_cols > target_slots)) {
    return 0;
  }
  if (!direct_prefix || direct_prefix_final_state) {
    for (UF_long slot = 0u; slot < dense_scatter_cols; ++slot) {
      const UF_long row = local_start + available_end + slot;
      if (row >= block_size || target_cols[slot] != row) {
        return 0;
      }
    }
  }

  double *x = worker->x;
  const UF_long scatter_begin =
    solver->symbolic->nblocks == 1u
      ? solver->refactor_col_ptr[current]
      : solver->refactor_block_start[current];
  const UF_long scatter_end = solver->refactor_col_ptr[current + 1u];
  if (!kls_egraph_scatter_refactor_input(
        solver, shared->values, shared->rs, shared->scale, x, k1, k2,
        scatter_begin, scatter_end)) {
    memset(x, 0, (size_t)block_size * sizeof(*x));
    return 0;
  }
  for (UF_long p = 0u; p < advance_deps; ++p) {
    const UF_long j = ui32 != NULL ? (UF_long)ui32[p] : ui[p];
    const double ujk = x[j];
    x[j] = 0.0;
    if (advance_u_values != NULL) {
      advance_u_values[p] = ujk;
    }
    if (ujk != 0.0) {
      UF_long *li = solver->refactor_l_indices[k1 + j];
      double *lx = solver->refactor_l_values[k1 + j];
      const UF_long lcol_len = solver->numeric->Llen[k1 + j];
      if ((li == NULL && solver->refactor_l_indices32 == NULL &&
           lcol_len > 0u) ||
          (lx == NULL && lcol_len > 0u)) {
        memset(x, 0, (size_t)block_size * sizeof(*x));
        return 0;
      }
      kls_scatter_subtract_refactor_l(
        solver, x, k1 + j, li, lx, lcol_len, ujk);
    }
  }
  if (advance_values != NULL) {
    for (UF_long slot = 0u; slot < advance_slots; ++slot) {
      const UF_long row = advance_cols[slot];
      if (row >= block_size) {
        memset(x, 0, (size_t)block_size * sizeof(*x));
        return 0;
      }
      advance_values[slot] = x[row];
    }
  }

  if (direct_prefix_current_state) {
    if (current_slot + 1u >
          solver->refactor_supernode_algorithm5_payoff_group_current_total) {
      memset(x, 0, (size_t)block_size * sizeof(*x));
      return 0;
    }
    const UF_long state_begin =
      solver->refactor_supernode_algorithm5_payoff_current_state_ptr[
        current_slot];
    const UF_long state_end =
      solver->refactor_supernode_algorithm5_payoff_current_state_ptr[
        current_slot + 1u];
    if (state_end < state_begin ||
        state_end > shared->algorithm5_payoff_current_state_size ||
        (state_end > state_begin &&
         shared->algorithm5_payoff_current_state_values == NULL)) {
      memset(x, 0, (size_t)block_size * sizeof(*x));
      return 0;
    }
    const UF_long state_rows = state_end - state_begin;
    const UF_long *state_row_idx =
      solver->refactor_supernode_algorithm5_payoff_current_state_rows +
      state_begin;
    double *state_values =
      state_rows > 0u
        ? shared->algorithm5_payoff_current_state_values + state_begin
        : NULL;
    for (UF_long p = 0u; p < state_rows; ++p) {
      const UF_long row = state_row_idx[p];
      if (row >= block_size) {
        memset(x, 0, (size_t)block_size * sizeof(*x));
        return 0;
      }
      state_values[p] = x[row];
    }
    item->state_rows = state_rows;
    item->state_row_idx = state_row_idx;
    item->state_values = state_values;
  }

  for (UF_long local = 0u; local < prefix_rows; ++local) {
    workspace[local] = x[dep_local + local];
    x[dep_local + local] = 0.0;
  }
  if (!direct_prefix) {
    memset(target_values, 0, (size_t)target_slots * sizeof(*target_values));
  }

  if (solver->refactor_row_idx32 != NULL) {
    const int32_t *rows32 = solver->refactor_row_idx32;
    for (UF_long p = scatter_begin; p < scatter_end; ++p) {
      const UF_long row = (UF_long)rows32[p];
      if (row >= k1 && row < k2) {
        x[row - k1] = 0.0;
      }
    }
  } else {
    const UF_long *rows = solver->refactor_row_idx;
    for (UF_long p = scatter_begin; p < scatter_end; ++p) {
      const UF_long row = rows[p];
      if (row >= k1 && row < k2) {
        x[row - k1] = 0.0;
      }
    }
  }
  if (advance_slot_begin != KLS_KLU_EMPTY &&
      advance_slot_begin <=
        solver->refactor_supernode_algorithm5_payoff_group_advance_slots_total &&
      advance_slots <=
        solver->refactor_supernode_algorithm5_payoff_group_advance_slots_total -
          advance_slot_begin &&
      (advance_slots == 0u ||
       solver->refactor_supernode_algorithm5_payoff_group_advance_cols !=
         NULL)) {
    const UF_long *advance_cols =
      advance_slots > 0u
        ? solver->refactor_supernode_algorithm5_payoff_group_advance_cols +
            advance_slot_begin
        : NULL;
    for (UF_long slot = 0u; slot < advance_slots; ++slot) {
      if (advance_cols[slot] < block_size) {
        x[advance_cols[slot]] = 0.0;
      }
    }
  } else {
    memset(x, 0, (size_t)block_size * sizeof(*x));
  }
  for (UF_long local = 0u; local < prefix_rows; ++local) {
    x[dep_local + local] = 0.0;
  }
  if (!direct_prefix) {
    for (UF_long slot = 0u; slot < target_slots; ++slot) {
      if (target_cols[slot] < block_size) {
        x[target_cols[slot]] = 0.0;
      }
    }
  }

  item->current_slot = current_slot;
  item->run = run;
  item->current = current;
  item->k1 = k1;
  item->block_size = block_size;
  item->dep_local = dep_local;
  item->panel = panel;
  item->panel_offset = panel_offset;
  item->prefix_rows = prefix_rows;
  item->available_end = available_end;
  item->row_base = row_base;
  item->dense_target_slots = dense_scatter_cols;
  item->trailing_target_slots =
    direct_prefix ? 0u : target_slots - dense_scatter_cols;
  item->target_slots = target_slots;
  item->target_entries = target_entries;
  item->trailing_entries = trailing_entries;
  item->advance_deps = advance_deps;
  item->advance_slots = advance_slots;
  item->local_start = local_start;
  item->width = width;
  item->workspace = workspace;
  item->advance_cols = advance_cols;
  item->advance_values = advance_values;
  item->advance_u_values = advance_u_values;
  item->target_cols = target_cols;
  item->target_values = target_values;
  return 1;
}

static int
kls_egraph_refactor_prepare_algorithm5_payoff_group_item_shape(
  kls_egraph_refactor_worker *worker,
  UF_long group,
  UF_long current_slot,
  UF_long run,
  kls_algorithm5_payoff_group_prefix_item *item) {
  if (item != NULL) {
    memset(item, 0, sizeof(*item));
  }
  if (worker == NULL || worker->shared == NULL || item == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  const int direct_prefix =
    shared->supernode_algorithm5_payoff_direct_prefix_prep;
  const int direct_prefix_current_state =
    shared->supernode_algorithm5_payoff_direct_prefix_current_state;
  const int direct_prefix_final_state =
    shared->supernode_algorithm5_payoff_direct_prefix_final_state;
  if (solver == NULL || solver->symbolic == NULL ||
      solver->symbolic->R == NULL || solver->numeric == NULL ||
      solver->numeric->Ulen == NULL || solver->numeric->Llen == NULL ||
      solver->refactor_col_ptr == NULL || solver->refactor_row_idx == NULL ||
      solver->refactor_input_pos == NULL ||
      (solver->refactor_u_indices == NULL &&
       solver->refactor_u_indices32 == NULL) ||
      (solver->refactor_l_indices == NULL &&
       solver->refactor_l_indices32 == NULL) ||
      solver->refactor_l_values == NULL ||
      (solver->symbolic->nblocks != 1u &&
       solver->refactor_block_start == NULL) ||
      solver->refactor_u_supernode_col_id == NULL ||
      solver->refactor_u_supernode_start == NULL ||
      solver->refactor_u_supernode_local_start == NULL ||
      solver->refactor_u_supernode_width == NULL ||
      solver->refactor_u_supernode_l_valid == NULL ||
      solver->refactor_u_supernode_l_row_begin == NULL ||
      solver->refactor_u_supernode_l_row_ptr == NULL ||
      solver->refactor_u_supernode_l_cols == NULL ||
      solver->refactor_u_supernode_l_dense_values == NULL ||
      solver->refactor_supernode_consumer_plan_current == NULL ||
      solver->refactor_supernode_consumer_plan_dep == NULL ||
      solver->refactor_supernode_consumer_plan_panel_start == NULL ||
      solver->refactor_supernode_consumer_plan_panel_offset == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_group == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_current_pos == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_deps == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_slot_ptr ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_slots == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_prefix_rows == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_target_entries == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_target_slot_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_target_slots == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_workspace_rows == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_pattern_width == NULL ||
      (direct_prefix_final_state &&
       solver->refactor_supernode_algorithm5_payoff_group_target_cols == NULL) ||
      solver->refactor_supernode_algorithm5_payoff_current_state_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_current_state_rows == NULL ||
      (shared->algorithm5_payoff_current_state_size > 0u &&
       shared->algorithm5_payoff_current_state_values == NULL) ||
      !shared->supernode_algorithm5_payoff_group_advance_prep ||
      !shared->supernode_algorithm5_payoff_workspace ||
      !direct_prefix || !direct_prefix_current_state ||
      shared->algorithm5_payoff_workspace_values == NULL ||
      current_slot >= shared->algorithm5_payoff_current_count ||
      run >= solver->refactor_supernode_consumer_plan_run_count ||
      group >= solver->refactor_supernode_algorithm5_payoff_group_count ||
      solver->refactor_supernode_algorithm5_payoff_run_group[run] != group ||
      solver->refactor_supernode_algorithm5_payoff_run_current_pos[run] !=
        current_slot) {
    return 0;
  }

  const UF_long current =
    solver->refactor_supernode_consumer_plan_current[run];
  const UF_long dep = solver->refactor_supernode_consumer_plan_dep[run];
  const UF_long panel_start =
    solver->refactor_supernode_consumer_plan_panel_start[run];
  const UF_long panel_offset =
    solver->refactor_supernode_consumer_plan_panel_offset[run];
  const UF_long prefix_rows =
    solver->refactor_supernode_algorithm5_payoff_run_prefix_rows[run];
  const UF_long advance_deps =
    solver->refactor_supernode_algorithm5_payoff_run_advance_deps[run];
  if (current >= solver->n || dep >= current || prefix_rows == 0u ||
      panel_start >= solver->n || dep != panel_start + panel_offset) {
    return 0;
  }

  UF_long block = KLS_KLU_EMPTY;
  if (solver->symbolic->nblocks == 1u) {
    block = 0u;
  } else if (solver->refactor_col_block != NULL) {
    block = solver->refactor_col_block[current];
  } else {
    block = kls_block_for_pivot(solver, current);
  }
  if (block == KLS_KLU_EMPTY || block >= solver->symbolic->nblocks) {
    return 0;
  }
  const UF_long k1 = solver->symbolic->R[block];
  const UF_long k2 = solver->symbolic->R[block + 1u];
  if (k2 <= k1 || current < k1 || current >= k2 || dep < k1 ||
      dep >= k2) {
    return 0;
  }
  const UF_long block_size = k2 - k1;
  const UF_long local_k = current - k1;
  const UF_long dep_local = dep - k1;
  if (dep_local >= local_k || prefix_rows > local_k - dep_local ||
      block_size > (UF_long)(SIZE_MAX / sizeof(double))) {
    return 0;
  }

  const UF_long ulen = solver->numeric->Ulen[current];
  const int32_t *ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[current] : NULL;
  const UF_long *ui =
    ui32 == NULL && solver->refactor_u_indices != NULL
      ? solver->refactor_u_indices[current] : NULL;
  if ((ulen > 0u && ui32 == NULL && ui == NULL) ||
      advance_deps > ulen || prefix_rows > ulen - advance_deps) {
    return 0;
  }
  for (UF_long p = 0u; p < advance_deps; ++p) {
    const UF_long j = kls_algorithm5_payoff_u_index_at(ui, ui32, p);
    if (j >= local_k || j > UF_long_max - k1 ||
        !kls_egraph_refactor_dependency_done_now(shared, k1 + j)) {
      return 0;
    }
  }
  for (UF_long local = 0u; local < prefix_rows; ++local) {
    const UF_long p = advance_deps + local;
    const UF_long j = kls_algorithm5_payoff_u_index_at(ui, ui32, p);
    if (j != dep_local + local || j > UF_long_max - k1 ||
        !kls_egraph_refactor_dependency_done_now(shared, k1 + j)) {
      return 0;
    }
  }

  const UF_long current_begin =
    solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group];
  const UF_long current_end =
    solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group + 1u];
  if (current_begin > current_end || current_slot < current_begin ||
      current_slot >= current_end ||
      current_end >
        solver->refactor_supernode_algorithm5_payoff_group_current_total) {
    return 0;
  }
  const UF_long group_workspace_begin =
    solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr[
      current_begin];
  const UF_long workspace_begin =
    solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr[
      current_slot];
  const UF_long workspace_end =
    solver->refactor_supernode_algorithm5_payoff_group_current_workspace_ptr[
      current_slot + 1u];
  const UF_long group_workspace_rows =
    solver->refactor_supernode_algorithm5_payoff_group_workspace_rows[group];
  if (workspace_end < workspace_begin ||
      workspace_begin < group_workspace_begin ||
      prefix_rows > workspace_end - workspace_begin ||
      workspace_end - group_workspace_begin > group_workspace_rows ||
      group_workspace_begin > shared->algorithm5_payoff_workspace_size ||
      group_workspace_rows >
        shared->algorithm5_payoff_workspace_size - group_workspace_begin) {
    return 0;
  }
  double *workspace =
    shared->algorithm5_payoff_workspace_values + workspace_begin;

  const int advance_slot_seed =
    shared->supernode_algorithm5_payoff_direct_prefix_advance_seed;
  const UF_long advance_slot_begin =
    solver->refactor_supernode_algorithm5_payoff_run_advance_slot_ptr[run];
  const UF_long advance_slots =
    solver->refactor_supernode_algorithm5_payoff_run_advance_slots[run];
  const UF_long advance_u_begin =
    solver->refactor_supernode_algorithm5_payoff_run_advance_ptr[run];
  const UF_long *advance_cols = NULL;
  double *advance_values = NULL;
  double *advance_u_values = NULL;
  if (advance_u_begin == KLS_KLU_EMPTY ||
      advance_u_begin > shared->algorithm5_payoff_advance_u_size ||
      advance_deps >
        shared->algorithm5_payoff_advance_u_size - advance_u_begin ||
      (advance_deps > 0u &&
       shared->algorithm5_payoff_advance_u_values == NULL)) {
    return 0;
  }
  advance_u_values =
    advance_deps > 0u
      ? shared->algorithm5_payoff_advance_u_values + advance_u_begin
      : NULL;
  if (advance_slot_seed) {
    if (advance_slot_begin == KLS_KLU_EMPTY ||
        advance_slot_begin > shared->algorithm5_payoff_advance_size ||
        advance_slots >
          shared->algorithm5_payoff_advance_size - advance_slot_begin ||
        (advance_slots > 0u &&
         (shared->algorithm5_payoff_advance_values == NULL ||
          solver->refactor_supernode_algorithm5_payoff_group_advance_cols ==
            NULL))) {
      return 0;
    }
    advance_cols =
      advance_slots > 0u
        ? solver->refactor_supernode_algorithm5_payoff_group_advance_cols +
            advance_slot_begin
        : NULL;
    advance_values =
      advance_slots > 0u
        ? shared->algorithm5_payoff_advance_values + advance_slot_begin
        : NULL;
  }

  const UF_long target_slot_begin =
    solver->refactor_supernode_algorithm5_payoff_run_target_slot_ptr[run];
  const UF_long target_slots =
    solver->refactor_supernode_algorithm5_payoff_run_target_slots[run];
  const UF_long target_entries =
    solver->refactor_supernode_algorithm5_payoff_run_target_entries[run];
  const UF_long *target_cols = NULL;
  if (direct_prefix_final_state && target_slots > 0u) {
    if (target_slot_begin == KLS_KLU_EMPTY ||
        target_slot_begin >
          solver->refactor_supernode_algorithm5_payoff_group_target_slots_total ||
        target_slots >
          solver->refactor_supernode_algorithm5_payoff_group_target_slots_total -
            target_slot_begin) {
      return 0;
    }
    target_cols =
      solver->refactor_supernode_algorithm5_payoff_group_target_cols +
      target_slot_begin;
  }

  const UF_long pattern_width =
    solver->refactor_supernode_algorithm5_payoff_group_pattern_width[group];
  if (pattern_width == 0u || panel_offset > pattern_width ||
      prefix_rows > pattern_width - panel_offset) {
    return 0;
  }
  const UF_long panel = solver->refactor_u_supernode_col_id[dep];
  if (panel == KLS_KLU_EMPTY ||
      panel >= solver->refactor_u_supernode_pattern_count ||
      !solver->refactor_u_supernode_l_valid[panel]) {
    return 0;
  }
  const UF_long start = solver->refactor_u_supernode_start[panel];
  const UF_long local_start =
    solver->refactor_u_supernode_local_start[panel];
  const UF_long width = solver->refactor_u_supernode_width[panel];
  if (start != panel_start || width != pattern_width ||
      start > solver->n || width > solver->n - start ||
      local_start > dep_local || dep_local - local_start != panel_offset ||
      local_start > block_size || width > block_size - local_start) {
    return 0;
  }
  const UF_long row_base =
    solver->refactor_u_supernode_l_row_begin[panel] + panel_offset;
  if (row_base + prefix_rows > solver->refactor_u_supernode_pattern_rows) {
    return 0;
  }
  UF_long trailing_entries = 0u;
  for (UF_long local = 0u; local < prefix_rows; ++local) {
    const UF_long begin =
      solver->refactor_u_supernode_l_row_ptr[row_base + local];
    const UF_long end =
      solver->refactor_u_supernode_l_row_ptr[row_base + local + 1u];
    if (end < begin || end > solver->refactor_u_supernode_l_trailing_entries ||
        end - begin > UF_long_max - trailing_entries) {
      return 0;
    }
    trailing_entries += end - begin;
  }
  const UF_long available_end = panel_offset + prefix_rows;
  const UF_long dense_scatter_cols = width - available_end;
  const UF_long dense_entries = prefix_rows * dense_scatter_cols;
  if (target_entries != dense_entries + trailing_entries ||
      (direct_prefix_final_state && dense_scatter_cols > target_slots)) {
    return 0;
  }
  if (direct_prefix_final_state) {
    for (UF_long slot = 0u; slot < dense_scatter_cols; ++slot) {
      const UF_long row = local_start + available_end + slot;
      if (row >= block_size || target_cols == NULL ||
          target_cols[slot] != row) {
        return 0;
      }
    }
  }

  if (current_slot + 1u >
        solver->refactor_supernode_algorithm5_payoff_group_current_total) {
    return 0;
  }
  const UF_long state_begin =
    solver->refactor_supernode_algorithm5_payoff_current_state_ptr[
      current_slot];
  const UF_long state_end =
    solver->refactor_supernode_algorithm5_payoff_current_state_ptr[
      current_slot + 1u];
  if (state_end < state_begin ||
      state_end > shared->algorithm5_payoff_current_state_size ||
      state_end == state_begin ||
      shared->algorithm5_payoff_current_state_values == NULL) {
    return 0;
  }
  const UF_long state_rows = state_end - state_begin;
  const UF_long *state_row_idx =
    solver->refactor_supernode_algorithm5_payoff_current_state_rows +
    state_begin;
  double *state_values =
    shared->algorithm5_payoff_current_state_values + state_begin;
  UF_long last_row = 0u;
  for (UF_long p = 0u; p < state_rows; ++p) {
    const UF_long row = state_row_idx[p];
    if (row >= block_size || (p > 0u && row <= last_row)) {
      return 0;
    }
    last_row = row;
  }

  item->current_slot = current_slot;
  item->run = run;
  item->current = current;
  item->k1 = k1;
  item->block_size = block_size;
  item->dep_local = dep_local;
  item->panel = panel;
  item->panel_offset = panel_offset;
  item->prefix_rows = prefix_rows;
  item->available_end = available_end;
  item->row_base = row_base;
  item->dense_target_slots = dense_scatter_cols;
  item->trailing_target_slots = 0u;
  item->target_slots = target_slots;
  item->target_entries = target_entries;
  item->trailing_entries = trailing_entries;
  item->advance_deps = advance_deps;
  item->advance_slots = advance_slots;
  item->state_rows = state_rows;
  item->local_start = local_start;
  item->width = width;
  item->workspace = workspace;
  item->advance_cols = advance_cols;
  item->advance_values = advance_values;
  item->advance_u_values = advance_u_values;
  item->target_cols = target_cols;
  item->target_values = NULL;
  item->state_row_idx = state_row_idx;
  item->state_values = state_values;
  return 1;
}

static int
kls_egraph_refactor_seed_algorithm5_payoff_group_item_state(
  kls_egraph_refactor_worker *worker,
  const kls_algorithm5_payoff_group_prefix_item *item) {
  if (worker == NULL || worker->shared == NULL || item == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || solver->symbolic == NULL ||
      item->current >= solver->n || item->block_size == 0u ||
      item->state_rows == 0u || item->state_row_idx == NULL ||
      item->state_values == NULL ||
      item->k1 > UF_long_max - item->block_size ||
      solver->refactor_col_ptr == NULL ||
      solver->refactor_input_pos == NULL ||
      (solver->refactor_row_idx == NULL &&
       solver->refactor_row_idx32 == NULL) ||
      (solver->symbolic != NULL && solver->symbolic->nblocks != 1u &&
       solver->refactor_block_start == NULL)) {
    return 0;
  }
  double *x = worker->x;
  if (x == NULL) {
    return 0;
  }
  for (UF_long p = 0u; p < item->state_rows; ++p) {
    const UF_long row = item->state_row_idx[p];
    if (row >= item->block_size) {
      return 0;
    }
    x[row] = 0.0;
  }

  const UF_long scatter_begin =
    solver->symbolic != NULL && solver->symbolic->nblocks == 1u
      ? solver->refactor_col_ptr[item->current]
      : solver->refactor_block_start[item->current];
  const UF_long scatter_end = solver->refactor_col_ptr[item->current + 1u];
  if (scatter_begin > scatter_end ||
      !kls_egraph_scatter_refactor_input(
        solver, shared->values, shared->rs, shared->scale, x, item->k1,
        item->k1 + item->block_size, scatter_begin, scatter_end)) {
    memset(x, 0, (size_t)item->block_size * sizeof(*x));
    return 0;
  }

  for (UF_long p = 0u; p < item->state_rows; ++p) {
    const UF_long row = item->state_row_idx[p];
    item->state_values[p] = x[row];
    x[row] = 0.0;
  }
  if (solver->refactor_row_idx32 != NULL) {
    const int32_t *rows32 = solver->refactor_row_idx32;
    for (UF_long p = scatter_begin; p < scatter_end; ++p) {
      const UF_long row = (UF_long)rows32[p];
      if (row >= item->k1 && row < item->k1 + item->block_size) {
        x[row - item->k1] = 0.0;
      }
    }
  } else {
    const UF_long *rows = solver->refactor_row_idx;
    for (UF_long p = scatter_begin; p < scatter_end; ++p) {
      const UF_long row = rows[p];
      if (row >= item->k1 && row < item->k1 + item->block_size) {
        x[row - item->k1] = 0.0;
      }
    }
  }
  kls_egraph_record_algorithm5_payoff_current_state_seed(
    shared, item->advance_deps, item->state_rows);
  return 1;
}

static int
kls_egraph_refactor_group_advance_prep_fail(
  kls_egraph_refactor_shared *shared,
  int mutated) {
  if (mutated) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }
  return 0;
}

static int
kls_egraph_refactor_advance_algorithm5_payoff_prepared_prefix_group(
  kls_egraph_refactor_worker *worker,
  kls_algorithm5_payoff_group_prefix_item *items,
  UF_long item_count) {
  if (worker == NULL || worker->shared == NULL || items == NULL ||
      item_count == 0u ||
      item_count > (UF_long)(SIZE_MAX / sizeof(UF_long))) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  const int use_position_plan =
    shared->supernode_algorithm5_payoff_group_advance_pos &&
    solver != NULL &&
    solver->refactor_supernode_algorithm5_payoff_run_advance_ptr != NULL &&
    solver->refactor_supernode_algorithm5_payoff_advance_pos_ptr != NULL &&
    solver->refactor_supernode_algorithm5_payoff_advance_pos != NULL;
  if (solver == NULL ||
      !shared->supernode_algorithm5_payoff_group_advance_prep ||
      solver->numeric == NULL || solver->numeric->Ulen == NULL ||
      solver->numeric->Llen == NULL ||
      (solver->refactor_u_indices == NULL &&
       solver->refactor_u_indices32 == NULL) ||
      (solver->refactor_l_indices == NULL &&
       solver->refactor_l_indices32 == NULL) ||
      solver->refactor_l_values == NULL) {
    return 0;
  }

  kls_algorithm5_payoff_state_lookup_batch lookup;
  memset(&lookup, 0, sizeof(lookup));
  UF_long *next_up = (UF_long *)malloc((size_t)item_count * sizeof(*next_up));
  if (next_up == NULL) {
    return -1;
  }
#define KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(value) \
  do { \
    kls_algorithm5_payoff_free_state_lookup_batch(&lookup); \
    free(next_up); \
    return (value); \
  } while (0)
  UF_long remaining = 0u;
  for (UF_long i = 0u; i < item_count; ++i) {
    kls_algorithm5_payoff_group_prefix_item *item = &items[i];
    next_up[i] = 0u;
    if (item->current >= solver->n || item->k1 > item->current ||
        item->block_size == 0u || item->state_rows == 0u ||
        item->state_row_idx == NULL || item->state_values == NULL ||
        item->workspace == NULL ||
        (item->advance_deps > 0u && item->advance_u_values == NULL) ||
        item->advance_deps > solver->numeric->Ulen[item->current] ||
        item->prefix_rows >
          solver->numeric->Ulen[item->current] - item->advance_deps ||
        item->advance_deps > UF_long_max - remaining) {
      KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(0);
    }
    remaining += item->advance_deps;
  }
  if (shared->supernode_algorithm5_payoff_group_advance_prep_hash) {
    const int lookup_status =
      kls_algorithm5_payoff_build_state_lookup_batch(
        items, item_count, &lookup);
    if (lookup_status <= 0) {
      KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(lookup_status < 0 ? -1 : 0);
    }
  }

  int mutated = 0;
  UF_long update_entries = 0u;
  while (remaining > 0u) {
    if (kls_egraph_refactor_should_stop(shared)) {
      KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(-1);
    }
    UF_long selected_dep = KLS_KLU_EMPTY;
    for (UF_long i = 0u; i < item_count; ++i) {
      kls_algorithm5_payoff_group_prefix_item *item = &items[i];
      if (next_up[i] >= item->advance_deps) {
        continue;
      }
      const int32_t *ui32 =
        solver->refactor_u_indices32 != NULL
          ? solver->refactor_u_indices32[item->current] : NULL;
      const UF_long *ui =
        ui32 == NULL && solver->refactor_u_indices != NULL
          ? solver->refactor_u_indices[item->current] : NULL;
      const UF_long ulen = solver->numeric->Ulen[item->current];
      const UF_long current_local = item->current - item->k1;
      if ((ulen > 0u && ui32 == NULL && ui == NULL) ||
          current_local >= item->block_size) {
        KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
          kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
      }
      const UF_long dep_local =
        kls_algorithm5_payoff_u_index_at(ui, ui32, next_up[i]);
      if (dep_local >= current_local ||
          dep_local > UF_long_max - item->k1) {
        KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
          kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
      }
      const UF_long dep_global = item->k1 + dep_local;
      if (dep_global >= item->current || dep_global >= solver->n ||
          !kls_egraph_refactor_dependency_done_now(shared, dep_global)) {
        KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
          kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
      }
      selected_dep = dep_global;
      break;
    }
    if (selected_dep == KLS_KLU_EMPTY) {
      KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
        kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
    }

    const UF_long lcol_len = solver->numeric->Llen[selected_dep];
    const int32_t *rows32 =
      solver->refactor_l_indices32 != NULL
        ? solver->refactor_l_indices32[selected_dep] : NULL;
    const UF_long *rows =
      rows32 == NULL && solver->refactor_l_indices != NULL
        ? solver->refactor_l_indices[selected_dep] : NULL;
    const double *lx = solver->refactor_l_values[selected_dep];
    if (lcol_len > 0u && (lx == NULL || (rows32 == NULL && rows == NULL))) {
      KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
        kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
    }

    UF_long candidate_count = 0u;
    for (UF_long i = 0u; i < item_count; ++i) {
      kls_algorithm5_payoff_group_prefix_item *item = &items[i];
      if (next_up[i] >= item->advance_deps) {
        continue;
      }
      const int32_t *ui32 =
        solver->refactor_u_indices32 != NULL
          ? solver->refactor_u_indices32[item->current] : NULL;
      const UF_long *ui =
        ui32 == NULL && solver->refactor_u_indices != NULL
          ? solver->refactor_u_indices[item->current] : NULL;
      if (solver->numeric->Ulen[item->current] > 0u &&
          ui32 == NULL && ui == NULL) {
        KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
          kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
      }
      const UF_long dep_local =
        kls_algorithm5_payoff_u_index_at(ui, ui32, next_up[i]);
      if (dep_local > UF_long_max - item->k1) {
        KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
          kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
      }
      if (item->k1 + dep_local == selected_dep) {
        candidate_count++;
      }
    }
    if (candidate_count == 0u) {
      KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
        kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
    }
    if (!use_position_plan &&
        lcol_len > 0u && candidate_count > UF_long_max / lcol_len) {
      KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
        kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
    }
    const UF_long position_count =
      use_position_plan ? 0u : candidate_count * lcol_len;
    if ((!use_position_plan && candidate_count > UF_long_max / 2u) ||
        (use_position_plan && candidate_count > UF_long_max / 3u)) {
      KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
        kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
    }
    const UF_long index_count =
      use_position_plan ? 3u * candidate_count : 2u * candidate_count;
    if (index_count > UF_long_max - position_count) {
      KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
        kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
    }
    const UF_long workspace_count = index_count + position_count;
    UF_long *workspace =
      kls_egraph_worker_index_workspace(worker, workspace_count);
    if (workspace == NULL) {
      KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(-1);
    }
    UF_long *candidate_indices = workspace;
    UF_long *dep_positions = workspace + candidate_count;
    UF_long *row_positions = dep_positions + candidate_count;
    UF_long *position_begins = use_position_plan ? row_positions : NULL;
    const UF_long position_stride = candidate_count;

    UF_long valid_count = 0u;
    for (UF_long i = 0u; i < item_count; ++i) {
      kls_algorithm5_payoff_group_prefix_item *item = &items[i];
      if (next_up[i] >= item->advance_deps) {
        continue;
      }
      const int32_t *ui32 =
        solver->refactor_u_indices32 != NULL
          ? solver->refactor_u_indices32[item->current] : NULL;
      const UF_long *ui =
        ui32 == NULL && solver->refactor_u_indices != NULL
          ? solver->refactor_u_indices[item->current] : NULL;
      const UF_long dep_local =
        kls_algorithm5_payoff_u_index_at(ui, ui32, next_up[i]);
      if (dep_local > UF_long_max - item->k1 ||
          item->k1 + dep_local != selected_dep) {
        continue;
      }
      if (use_position_plan) {
        const UF_long advance_begin =
          solver->refactor_supernode_algorithm5_payoff_run_advance_ptr[
            item->run];
        if (advance_begin == KLS_KLU_EMPTY ||
            next_up[i] >
              solver->refactor_supernode_algorithm5_payoff_group_advance_deps_total ||
            advance_begin >
              solver->refactor_supernode_algorithm5_payoff_group_advance_deps_total -
                next_up[i]) {
          KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
            kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
        }
        const UF_long occurrence = advance_begin + next_up[i];
        if (occurrence >=
              solver->refactor_supernode_algorithm5_payoff_group_advance_deps_total) {
          KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
            kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
        }
        const UF_long pos_begin =
          solver->refactor_supernode_algorithm5_payoff_advance_pos_ptr[
            occurrence];
        const UF_long pos_end =
          solver->refactor_supernode_algorithm5_payoff_advance_pos_ptr[
            occurrence + 1u];
        if (lcol_len == UF_long_max ||
            pos_end <= pos_begin || pos_end - pos_begin != lcol_len + 1u ||
            pos_end >
              solver->refactor_supernode_algorithm5_payoff_advance_pos_entries_total) {
          KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
            kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
        }
        candidate_indices[valid_count] = i;
        dep_positions[valid_count] =
          solver->refactor_supernode_algorithm5_payoff_advance_pos[pos_begin];
        position_begins[valid_count] = pos_begin + 1u;
      } else {
        UF_long dep_pos = 0u;
        if (!kls_algorithm5_payoff_group_state_position(
              items, &lookup, i, dep_local, &dep_pos)) {
          KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
            kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
        }
        for (UF_long q = 0u; q < lcol_len; ++q) {
          const UF_long row = rows32 != NULL ? (UF_long)rows32[q] : rows[q];
          UF_long row_pos = 0u;
          if (row >= item->block_size ||
              !kls_algorithm5_payoff_group_state_position(
                items, &lookup, i, row, &row_pos)) {
            KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
              kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
          }
          row_positions[q * position_stride + valid_count] = row_pos;
        }
        candidate_indices[valid_count] = i;
        dep_positions[valid_count] = dep_pos;
      }
      valid_count++;
    }
    if (valid_count != candidate_count) {
      KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
        kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
    }

    for (UF_long v = 0u; v < valid_count; ++v) {
      kls_algorithm5_payoff_group_prefix_item *item =
        &items[candidate_indices[v]];
      const UF_long up = next_up[candidate_indices[v]];
      const double ujk = item->state_values[dep_positions[v]];
      item->state_values[dep_positions[v]] = 0.0;
      item->advance_u_values[up] = ujk;
      next_up[candidate_indices[v]] = up + 1u;
      remaining--;
      mutated = 1;
      update_entries =
        lcol_len + 1u > UF_long_max - update_entries
          ? UF_long_max : update_entries + lcol_len + 1u;
    }

    for (UF_long q = 0u; q < lcol_len; ++q) {
      const double lvalue = lx[q];
      for (UF_long v = 0u; v < valid_count; ++v) {
        kls_algorithm5_payoff_group_prefix_item *item =
          &items[candidate_indices[v]];
        const UF_long up = next_up[candidate_indices[v]] - 1u;
        const double ujk = item->advance_u_values[up];
        if (ujk == 0.0) {
          continue;
        }
        const UF_long row_pos =
          use_position_plan
            ? solver->refactor_supernode_algorithm5_payoff_advance_pos[
                position_begins[v] + q]
            : row_positions[q * position_stride + v];
        item->state_values[row_pos] -= ujk * lvalue;
      }
    }
  }

  for (UF_long i = 0u; i < item_count; ++i) {
    kls_algorithm5_payoff_group_prefix_item *item = &items[i];
    if (item->advance_values != NULL) {
      if (item->advance_cols == NULL) {
        KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
          kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
      }
      for (UF_long slot = 0u; slot < item->advance_slots; ++slot) {
        UF_long pos = 0u;
        if (item->advance_cols[slot] >= item->block_size ||
            !kls_algorithm5_payoff_group_state_position(
              items, &lookup, i, item->advance_cols[slot], &pos)) {
          KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
            kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
        }
        item->advance_values[slot] = item->state_values[pos];
      }
    }
    for (UF_long local = 0u; local < item->prefix_rows; ++local) {
      UF_long pos = 0u;
      const UF_long row = item->dep_local + local;
      if (row >= item->block_size ||
          !kls_algorithm5_payoff_group_state_position(
            items, &lookup, i, row, &pos)) {
        KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(
          kls_egraph_refactor_group_advance_prep_fail(shared, mutated));
      }
      item->workspace[local] = item->state_values[pos];
    }
  }
  if (mutated) {
    kls_egraph_record_algorithm5_payoff_suffix_advance(
      shared, 0u, update_entries, 0);
  }
  KLS_ALGORITHM5_GROUP_ADVANCE_RETURN(1);
#undef KLS_ALGORITHM5_GROUP_ADVANCE_RETURN
}

static int kls_egraph_refactor_apply_algorithm5_payoff_group_prefix_items(
  kls_egraph_refactor_worker *worker,
  const kls_algorithm5_payoff_group_prefix_item *items,
  UF_long item_count) {
  if (worker == NULL || worker->shared == NULL || items == NULL ||
      item_count == 0u) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  const int direct_prefix =
    shared->supernode_algorithm5_payoff_direct_prefix_prep;
  const int direct_prefix_final_state =
    shared->supernode_algorithm5_payoff_direct_prefix_final_state;
  if (solver == NULL ||
      solver->refactor_u_supernode_l_dense_values == NULL ||
      solver->refactor_u_supernode_dense_begin == NULL ||
      solver->refactor_u_supernode_l_row_ptr == NULL ||
      solver->refactor_u_supernode_l_cols == NULL ||
      solver->refactor_u_supernode_l_values == NULL) {
    return 0;
  }
  const UF_long panel = items[0].panel;
  if (panel >= solver->refactor_u_supernode_pattern_count) {
    return 0;
  }
  const UF_long width = items[0].width;
  const double *dense_panel =
    solver->refactor_u_supernode_l_dense_values +
    solver->refactor_u_supernode_dense_begin[panel];
  const UF_long *trailing_cols = solver->refactor_u_supernode_l_cols;
  const double *trailing_values = solver->refactor_u_supernode_l_values;
  UF_long max_prefix_rows = 0u;
  for (UF_long i = 0u; i < item_count; ++i) {
    if (items[i].panel != panel || items[i].width != width ||
        items[i].workspace == NULL ||
        (direct_prefix_final_state &&
         (items[i].state_rows == 0u || items[i].state_row_idx == NULL ||
          items[i].state_values == NULL ||
          (items[i].target_slots > 0u && items[i].target_cols == NULL))) ||
        (!direct_prefix &&
         (items[i].target_cols == NULL || items[i].target_values == NULL))) {
      return 0;
    }
    if (items[i].prefix_rows > max_prefix_rows) {
      max_prefix_rows = items[i].prefix_rows;
    }
  }

  if (direct_prefix_final_state) {
    if (trailing_values == NULL) {
      return 0;
    }
    for (UF_long i = 0u; i < item_count; ++i) {
      const kls_algorithm5_payoff_group_prefix_item *item = &items[i];
      UF_long state_stamp_value = 0u;
      UF_long *state_stamp = NULL;
      UF_long *state_pos = NULL;
      if (!kls_algorithm5_payoff_prepare_state_row_lookup(
            worker, item, &state_stamp_value, &state_stamp, &state_pos)) {
        return 0;
      }
      for (UF_long local = 0u; local < item->prefix_rows; ++local) {
        const UF_long panel_local = item->panel_offset + local;
        const double ujk = item->workspace[local];
        const double *dense_row = dense_panel + panel_local * width;
        UF_long prefix_state_pos = 0u;
        if (!kls_algorithm5_payoff_state_value_position(
              item, item->dep_local + local, state_stamp_value, state_stamp,
              state_pos, &prefix_state_pos)) {
          return 0;
        }
        item->state_values[prefix_state_pos] = 0.0;
        for (UF_long target = panel_local + 1u; target < width; ++target) {
          const double update = ujk * dense_row[target];
          if (target < item->available_end) {
            item->workspace[target - item->panel_offset] -= update;
          } else {
            const UF_long row = item->local_start + target;
            const UF_long slot = target - item->available_end;
            UF_long target_state_pos = 0u;
            if (row >= item->block_size || slot >= item->dense_target_slots ||
                item->target_cols == NULL || item->target_cols[slot] != row ||
                !kls_algorithm5_payoff_state_value_position(
                  item, row, state_stamp_value, state_stamp, state_pos,
                  &target_state_pos)) {
              return 0;
            }
            item->state_values[target_state_pos] -= update;
          }
        }
        const UF_long row = item->row_base + local;
        const UF_long begin = solver->refactor_u_supernode_l_row_ptr[row];
        const UF_long end =
          solver->refactor_u_supernode_l_row_ptr[row + 1u];
        if (end < begin ||
            end > solver->refactor_u_supernode_l_trailing_entries) {
          return 0;
        }
        for (UF_long p = begin; p < end; ++p) {
          const UF_long target_row = trailing_cols[p];
          UF_long target_state_pos = 0u;
          if (target_row >= item->block_size ||
              !kls_algorithm5_payoff_state_value_position(
                item, target_row, state_stamp_value, state_stamp, state_pos,
                &target_state_pos)) {
            return 0;
          }
          item->state_values[target_state_pos] -= ujk * trailing_values[p];
        }
      }
    }
    return 1;
  }

  for (UF_long local = 0u; local < max_prefix_rows; ++local) {
    for (UF_long i = 0u; i < item_count; ++i) {
      const kls_algorithm5_payoff_group_prefix_item *item = &items[i];
      if (local >= item->prefix_rows) {
        continue;
      }
      const UF_long panel_local = item->panel_offset + local;
      const double ujk = item->workspace[local];
      const double *dense_row = dense_panel + panel_local * width;
      for (UF_long target = panel_local + 1u; target < width; ++target) {
        const double update = ujk * dense_row[target];
        if (target < item->available_end) {
          item->workspace[target - item->panel_offset] -= update;
        } else if (!direct_prefix) {
          const UF_long row = item->local_start + target;
          const UF_long slot = target - item->available_end;
          if (row >= item->block_size || slot >= item->dense_target_slots ||
              item->target_cols[slot] != row) {
            return 0;
          }
          item->target_values[slot] += update;
        }
      }
    }
  }

  if (direct_prefix) {
    return 1;
  }

  for (UF_long i = 0u; i < item_count; ++i) {
    const kls_algorithm5_payoff_group_prefix_item *item = &items[i];
    if (item->trailing_entries == 0u) {
      continue;
    }
    if (item->trailing_target_slots == 0u ||
        !kls_egraph_worker_row_target_workspace(worker, item->block_size)) {
      return 0;
    }
    if (worker->row_target_stamp == UF_long_max) {
      memset(worker->row_target_stamp_workspace, 0,
             (size_t)item->block_size *
               sizeof(*worker->row_target_stamp_workspace));
      worker->row_target_stamp = 1u;
    } else {
      worker->row_target_stamp++;
      if (worker->row_target_stamp == 0u) {
        worker->row_target_stamp = 1u;
      }
    }
    const UF_long target_stamp_value = worker->row_target_stamp;
    UF_long *target_stamp = worker->row_target_stamp_workspace;
    UF_long *target_pos = worker->row_target_pos_workspace;
    for (UF_long slot = item->dense_target_slots; slot < item->target_slots;
         ++slot) {
      const UF_long row = item->target_cols[slot];
      if (row >= item->block_size ||
          target_stamp[row] == target_stamp_value) {
        return 0;
      }
      target_stamp[row] = target_stamp_value;
      target_pos[row] = slot;
    }
    for (UF_long local = 0u; local < item->prefix_rows; ++local) {
      const double ujk = item->workspace[local];
      const UF_long row = item->row_base + local;
      const UF_long begin = solver->refactor_u_supernode_l_row_ptr[row];
      const UF_long end = solver->refactor_u_supernode_l_row_ptr[row + 1u];
      if (end < begin ||
          end > solver->refactor_u_supernode_l_trailing_entries) {
        return 0;
      }
      for (UF_long p = begin; p < end; ++p) {
        const UF_long target_row = trailing_cols[p];
        if (target_row >= item->block_size ||
            target_stamp[target_row] != target_stamp_value) {
          return 0;
        }
        item->target_values[target_pos[target_row]] +=
          ujk * trailing_values[p];
      }
    }
  }
  return 1;
}

static int
kls_egraph_refactor_advance_algorithm5_payoff_prepared_suffix(
  kls_egraph_refactor_worker *worker,
  const kls_algorithm5_payoff_group_prefix_item *item,
  UF_long *next_up_out,
  int *finished_out) {
  if (next_up_out != NULL) {
    *next_up_out =
      item != NULL ? item->advance_deps + item->prefix_rows : 0u;
  }
  if (finished_out != NULL) {
    *finished_out = 0;
  }
  if (worker == NULL || worker->shared == NULL || item == NULL ||
      next_up_out == NULL || finished_out == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL ||
      !shared->supernode_algorithm5_payoff_suffix_group_advance ||
      shared->pipeline_ready_queue || item->current >= solver->n ||
      item->k1 > item->current || item->block_size == 0u ||
      item->state_rows == 0u || item->state_row_idx == NULL ||
      item->state_values == NULL ||
      solver->numeric == NULL || solver->numeric->Ulen == NULL ||
      solver->numeric->Llen == NULL ||
      solver->refactor_u_values == NULL || solver->refactor_l_values == NULL ||
      (solver->refactor_u_indices == NULL &&
       solver->refactor_u_indices32 == NULL) ||
      (solver->refactor_l_indices == NULL &&
       solver->refactor_l_indices32 == NULL)) {
    return 0;
  }

  const UF_long current_local = item->current - item->k1;
  if (current_local >= item->block_size) {
    return 0;
  }
  const UF_long ulen = solver->numeric->Ulen[item->current];
  if (item->advance_deps > ulen ||
      item->prefix_rows > ulen - item->advance_deps) {
    return 0;
  }
  UF_long up = item->advance_deps + item->prefix_rows;
  *next_up_out = up;
  if (up == ulen) {
    *finished_out = 1;
    return 0;
  }

  const int32_t *ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[item->current] : NULL;
  const UF_long *ui =
    ui32 == NULL && solver->refactor_u_indices != NULL
      ? solver->refactor_u_indices[item->current] : NULL;
  double *ux = solver->refactor_u_values[item->current];
  if ((ulen > 0u && ui32 == NULL && ui == NULL) ||
      (ulen > 0u && ux == NULL)) {
    return 0;
  }

  UF_long state_stamp_value = 0u;
  UF_long *state_stamp = NULL;
  UF_long *state_pos = NULL;
  if (!kls_algorithm5_payoff_prepare_state_row_lookup(
        worker, item, &state_stamp_value, &state_stamp, &state_pos)) {
    return 0;
  }

  const UF_long start_up = up;
  UF_long update_entries = 0u;
  while (up < ulen) {
    const UF_long dep_local =
      kls_algorithm5_payoff_u_index_at(ui, ui32, up);
    if (dep_local >= current_local ||
        dep_local > UF_long_max - item->k1) {
      break;
    }
    const UF_long dep_global = item->k1 + dep_local;
    if (dep_global >= item->current || dep_global >= solver->n ||
        !kls_egraph_refactor_dependency_done_now(shared, dep_global)) {
      break;
    }

    UF_long dep_pos = 0u;
    if (!kls_algorithm5_payoff_state_value_position(
          item, dep_local, state_stamp_value, state_stamp, state_pos,
          &dep_pos)) {
      break;
    }

    const UF_long lcol_len = solver->numeric->Llen[dep_global];
    const int32_t *rows32 =
      solver->refactor_l_indices32 != NULL
        ? solver->refactor_l_indices32[dep_global] : NULL;
    const UF_long *rows =
      rows32 == NULL && solver->refactor_l_indices != NULL
        ? solver->refactor_l_indices[dep_global] : NULL;
    const double *lx = solver->refactor_l_values[dep_global];
    if (lcol_len > 0u && (lx == NULL ||
                          (rows32 == NULL && rows == NULL))) {
      break;
    }
    int shape_ok = 1;
    for (UF_long q = 0u; q < lcol_len; ++q) {
      const UF_long row = rows32 != NULL ? (UF_long)rows32[q] : rows[q];
      UF_long row_pos = 0u;
      if (row >= item->block_size ||
          !kls_algorithm5_payoff_state_value_position(
            item, row, state_stamp_value, state_stamp, state_pos, &row_pos)) {
        shape_ok = 0;
        break;
      }
    }
    if (!shape_ok) {
      break;
    }

    const double ujk = item->state_values[dep_pos];
    item->state_values[dep_pos] = 0.0;
    ux[up] = ujk;
    if (shared->u_supernode_values) {
      kls_egraph_record_u_supernode_value(
        shared, dep_global, item->current, ujk);
    }
    if (ujk != 0.0) {
      for (UF_long q = 0u; q < lcol_len; ++q) {
        const UF_long row = rows32 != NULL ? (UF_long)rows32[q] : rows[q];
        UF_long row_pos = 0u;
        (void)kls_algorithm5_payoff_state_value_position(
          item, row, state_stamp_value, state_stamp, state_pos, &row_pos);
        item->state_values[row_pos] -= ujk * lx[q];
      }
    }
    update_entries =
      lcol_len + 1u > UF_long_max - update_entries
        ? UF_long_max : update_entries + lcol_len + 1u;
    up++;
  }

  *next_up_out = up;
  *finished_out = up == ulen;
  if (up == start_up) {
    return 0;
  }
  kls_egraph_record_algorithm5_payoff_suffix_advance(
    shared, up - start_up, update_entries, *finished_out);
  return 1;
}

static int kls_egraph_refactor_prepare_algorithm5_payoff_group_prefix_batch(
  kls_egraph_refactor_worker *worker,
  UF_long group,
  UF_long trigger_col) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL ||
      !shared->supernode_algorithm5_payoff_group_prefix_prep ||
      trigger_col >= solver->n ||
      group >= solver->refactor_supernode_algorithm5_payoff_group_count ||
      solver->refactor_supernode_algorithm5_payoff_group_prefix_end == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_currents == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_runs ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_ptr == NULL ||
      shared->algorithm5_payoff_current_flags == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_prefix_end[group] !=
        trigger_col + 1u) {
    return 0;
  }
  const UF_long current_begin =
    solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group];
  const UF_long current_end =
    solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group + 1u];
  if (current_begin > current_end ||
      current_end >
        solver->refactor_supernode_algorithm5_payoff_group_current_total ||
      current_end - current_begin <= 1u) {
    return 0;
  }
  const UF_long current_count = current_end - current_begin;
  if (current_count >
      (UF_long)(SIZE_MAX /
                sizeof(kls_algorithm5_payoff_group_prefix_item))) {
    return 0;
  }
  kls_algorithm5_payoff_group_prefix_item *items =
    (kls_algorithm5_payoff_group_prefix_item *)
      kls_egraph_worker_object_workspace(
        worker, current_count, sizeof(*items));
  if (items == NULL) {
    return 0;
  }

  UF_long claimed_count = 0u;
  for (UF_long current_slot = current_begin; current_slot < current_end;
       ++current_slot) {
    const UF_long candidate =
      solver->refactor_supernode_algorithm5_payoff_group_currents[
        current_slot];
    if (candidate == trigger_col || candidate >= solver->n ||
        (shared->pipeline_done != NULL &&
         shared->pipeline_generation != 0u &&
         atomic_load_explicit(&shared->pipeline_done[candidate],
                              memory_order_acquire) ==
           shared->pipeline_generation)) {
      continue;
    }
    const UF_long run_begin =
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
        current_slot];
    const UF_long run_end =
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
        current_slot + 1u];
    if (run_begin > run_end ||
        run_end >
          solver->refactor_supernode_algorithm5_payoff_group_ptr[
            solver->refactor_supernode_algorithm5_payoff_group_count] ||
        run_end - run_begin != 1u) {
      continue;
    }
    if (!kls_algorithm5_payoff_current_state_try_begin(
          shared->algorithm5_payoff_current_flags, current_slot)) {
      continue;
    }
    const UF_long run =
      solver->refactor_supernode_algorithm5_payoff_group_current_runs[
        run_begin];
    int prepared = 0;
    if (shared->supernode_algorithm5_payoff_group_advance_prep) {
      prepared =
        kls_egraph_refactor_prepare_algorithm5_payoff_group_item_shape(
          worker, group, current_slot, run, &items[claimed_count]) &&
        kls_egraph_refactor_seed_algorithm5_payoff_group_item_state(
          worker, &items[claimed_count]);
    } else {
      prepared =
        kls_egraph_refactor_prepare_algorithm5_payoff_group_item(
          worker, group, current_slot, run, &items[claimed_count]);
    }
    if (prepared) {
      claimed_count++;
    } else {
      kls_algorithm5_payoff_current_up_store(
        shared->algorithm5_payoff_current_up, current_slot, 0u);
      kls_algorithm5_payoff_current_state_store(
        shared->algorithm5_payoff_current_flags, current_slot,
        KLS_ALGORITHM5_PAYOFF_CURRENT_EMPTY);
    }
  }
  if (claimed_count == 0u) {
    return 0;
  }
  int ok = 1;
  if (shared->supernode_algorithm5_payoff_group_advance_prep) {
    const int advance_status =
      kls_egraph_refactor_advance_algorithm5_payoff_prepared_prefix_group(
        worker, items, claimed_count);
    if (advance_status <= 0) {
      for (UF_long i = 0u; i < claimed_count; ++i) {
        kls_algorithm5_payoff_current_up_store(
          shared->algorithm5_payoff_current_up, items[i].current_slot, 0u);
        kls_algorithm5_payoff_current_state_store(
          shared->algorithm5_payoff_current_flags, items[i].current_slot,
          KLS_ALGORITHM5_PAYOFF_CURRENT_EMPTY);
      }
      return advance_status < 0 ? -1 : 0;
    }
  }
  ok = kls_egraph_refactor_apply_algorithm5_payoff_group_prefix_items(
    worker, items, claimed_count);
  kls_algorithm5_payoff_group_complete_item *claims = NULL;
  if (ok && claimed_count <=
              (UF_long)(SIZE_MAX /
                        sizeof(kls_algorithm5_payoff_group_complete_item))) {
    claims = (kls_algorithm5_payoff_group_complete_item *)
      malloc((size_t)claimed_count * sizeof(*claims));
  }
  UF_long claim_count = 0u;
  for (UF_long i = 0u; i < claimed_count; ++i) {
    UF_long next_up =
      ok ? items[i].advance_deps + items[i].prefix_rows : 0u;
    int finished = 0;
    if (ok && claims != NULL) {
      (void)kls_egraph_refactor_advance_algorithm5_payoff_prepared_suffix(
        worker, &items[i], &next_up, &finished);
    }
    kls_algorithm5_payoff_current_up_store(
      shared->algorithm5_payoff_current_up, items[i].current_slot, next_up);
    kls_algorithm5_payoff_current_state_store(
      shared->algorithm5_payoff_current_flags, items[i].current_slot,
      ok ? KLS_ALGORITHM5_PAYOFF_CURRENT_READY
         : KLS_ALGORITHM5_PAYOFF_CURRENT_EMPTY);
    if (!ok || !finished || claims == NULL) {
      continue;
    }
    UF_long candidate_pos = KLS_KLU_EMPTY;
    if (!kls_egraph_refactor_pipeline_position_for_column(
          shared, items[i].current, &candidate_pos) ||
        !kls_egraph_refactor_column_dependencies_done(shared, items[i].current) ||
        !kls_egraph_refactor_try_claim_shape_column(shared, items[i].current)) {
      continue;
    }
    claims[claim_count].pos = candidate_pos;
    claims[claim_count].col = items[i].current;
    claims[claim_count].current_slot = items[i].current_slot;
    claims[claim_count].run = items[i].run;
    claim_count++;
  }
  if (!ok) {
    free(claims);
    return 0;
  }
  if (claim_count > 0u) {
    kls_sort_algorithm5_payoff_group_complete_items(claims, claim_count);
    for (UF_long i = 0u; i < claim_count; ++i) {
      const UF_long col = claims[i].col;
      const UF_long current_slot = claims[i].current_slot;
      if (kls_egraph_refactor_should_stop(shared)) {
        free(claims);
        return -1;
      }
      const int complete_status =
        kls_egraph_refactor_try_dispatch_algorithm5_payoff_complete_btf(
          worker, col, 1);
      if (complete_status < 0) {
        free(claims);
        return -1;
      }
      if (complete_status == 0 &&
          !kls_egraph_refactor_dispatch_column(worker, col, 1)) {
        free(claims);
        if (!kls_egraph_refactor_should_stop(shared)) {
          kls_egraph_refactor_record_invalid(shared);
        }
        return -1;
      }
      if (complete_status == 0) {
        kls_algorithm5_payoff_current_up_store(
          shared->algorithm5_payoff_current_up, current_slot, 0u);
        kls_algorithm5_payoff_current_state_store(
          shared->algorithm5_payoff_current_flags, current_slot,
          KLS_ALGORITHM5_PAYOFF_CURRENT_EMPTY);
      }
      kls_egraph_refactor_mark_done(shared, col);
      if (kls_egraph_refactor_after_pipeline_column_done(worker, col) < 0) {
        free(claims);
        return -1;
      }
    }
  }
  free(claims);
  return 1;
}

static void kls_sort_algorithm5_payoff_group_complete_items(
  kls_algorithm5_payoff_group_complete_item *items,
  UF_long count) {
  if (items == NULL) {
    return;
  }
  for (UF_long i = 1u; i < count; ++i) {
    const kls_algorithm5_payoff_group_complete_item item = items[i];
    UF_long j = i;
    while (j > 0u && items[j - 1u].pos > item.pos) {
      items[j] = items[j - 1u];
      j--;
    }
    items[j] = item;
  }
}

static int kls_egraph_refactor_try_dispatch_algorithm5_payoff_complete_btf(
  kls_egraph_refactor_worker *worker,
  UF_long col,
  int dependencies_proven_done) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || solver->symbolic == NULL ||
      solver->numeric == NULL ||
      !kls_egraph_kernel_is_btf_unscaled(shared->kernel) ||
      !shared->supernode_algorithm5_payoff_group_complete ||
      !shared->supernode_algorithm5_payoff_direct_prefix_complete ||
      !shared->supernode_algorithm5_payoff_direct_prefix_final_state ||
      shared->check_pivots || col >= solver->n ||
      solver->symbolic->R == NULL || solver->refactor_col_block == NULL ||
      solver->numeric->Offp == NULL || solver->numeric->Offx == NULL ||
      solver->numeric->Udiag == NULL || solver->numeric->Ulen == NULL ||
      solver->numeric->Llen == NULL ||
      solver->refactor_lu_pointer_count != solver->n ||
      solver->refactor_l_indices == NULL ||
      solver->refactor_l_values == NULL ||
      solver->refactor_u_indices == NULL ||
      solver->refactor_u_values == NULL ||
      solver->refactor_block_start == NULL) {
    return 0;
  }

  const UF_long block = solver->refactor_col_block[col];
  if (block == KLS_KLU_EMPTY || block >= solver->symbolic->nblocks ||
      block + 1u > solver->symbolic->nblocks) {
    return 0;
  }
  const UF_long k1 = solver->symbolic->R[block];
  const UF_long k2 = solver->symbolic->R[block + 1u];
  if (k2 <= k1 || col < k1 || col >= k2) {
    return 0;
  }
  const UF_long nk = k2 - k1;
  const UF_long local_k = col - k1;
  if (nk <= 1u || local_k >= nk) {
    return 0;
  }

  UF_long poff = solver->numeric->Offp[col];
  const UF_long poff_end = solver->numeric->Offp[col + 1u];
  double *offx = (double *)solver->numeric->Offx;
  if (!kls_egraph_copy_unscaled_offblock_input(
        solver, shared->values, offx, &poff, poff_end,
        solver->refactor_col_ptr[col], solver->refactor_block_start[col])) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }

  const UF_long ucol_len = solver->numeric->Ulen[col];
  const UF_long *ui =
    solver->refactor_u_indices != NULL ? solver->refactor_u_indices[col] : NULL;
  const int32_t *ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[col] : NULL;
  double *ux =
    solver->refactor_u_values != NULL ? solver->refactor_u_values[col] : NULL;
  if (ucol_len > 0u && ui == NULL && ui32 == NULL) {
    return 0;
  }
  if (ux == NULL && ucol_len > 0u) {
    return 0;
  }

  return
    kls_egraph_refactor_try_complete_algorithm5_payoff_direct_prefix_final_state_btf(
      worker, k1, col, local_k, nk, ucol_len, ui, ui32, ux,
      (double *)solver->numeric->Udiag, solver->refactor_l_indices,
      solver->refactor_l_values, solver->numeric->Llen + k1,
      dependencies_proven_done ? 0 : 1, shared->supernode_numeric_updates,
      shared->supernode_consumer_plan_group_l_values,
      shared->u_supernode_ragged_l_updates, shared->u_supernode_values);
}

static int kls_egraph_refactor_try_complete_algorithm5_payoff_group(
  kls_egraph_refactor_worker *worker,
  UF_long group,
  UF_long trigger_col) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL ||
      !shared->supernode_algorithm5_payoff_group_complete ||
      shared->pipeline_ready_queue ||
      !kls_egraph_kernel_is_btf_unscaled(shared->kernel) ||
      trigger_col >= solver->n ||
      group >= solver->refactor_supernode_algorithm5_payoff_group_count ||
      solver->refactor_supernode_algorithm5_payoff_group_prefix_end == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_currents == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_runs ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_ptr == NULL ||
      shared->algorithm5_payoff_current_flags == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_prefix_end[group] !=
        trigger_col + 1u) {
    return 0;
  }

  const UF_long current_begin =
    solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group];
  const UF_long current_end =
    solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group + 1u];
  if (current_begin > current_end ||
      current_end >
        solver->refactor_supernode_algorithm5_payoff_group_current_total ||
      current_end - current_begin <= 1u) {
    return 0;
  }
  const UF_long current_count = current_end - current_begin;
  if (current_count >
        (UF_long)(SIZE_MAX / sizeof(kls_algorithm5_payoff_group_prefix_item)) ||
      current_count >
        (UF_long)(SIZE_MAX /
                  sizeof(kls_algorithm5_payoff_group_complete_item))) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }

  kls_algorithm5_payoff_group_complete_item *claims =
    (kls_algorithm5_payoff_group_complete_item *)
      malloc((size_t)current_count * sizeof(*claims));
  if (claims == NULL) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }

  UF_long claim_count = 0u;
  for (UF_long current_slot = current_begin; current_slot < current_end;
       ++current_slot) {
    const UF_long candidate =
      solver->refactor_supernode_algorithm5_payoff_group_currents[
        current_slot];
    UF_long candidate_pos = KLS_KLU_EMPTY;
    if (candidate == trigger_col || candidate >= solver->n ||
        !kls_egraph_refactor_pipeline_position_for_column(
          shared, candidate, &candidate_pos) ||
        !kls_egraph_refactor_column_dependencies_done(shared, candidate)) {
      continue;
    }
    const UF_long run_begin =
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
        current_slot];
    const UF_long run_end =
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
        current_slot + 1u];
    if (run_begin > run_end ||
        run_end >
          solver->refactor_supernode_algorithm5_payoff_group_ptr[
            solver->refactor_supernode_algorithm5_payoff_group_count] ||
        run_end - run_begin != 1u) {
      continue;
    }
    if (!kls_egraph_refactor_try_claim_shape_column(shared, candidate)) {
      continue;
    }
    claims[claim_count].pos = candidate_pos;
    claims[claim_count].col = candidate;
    claims[claim_count].current_slot = current_slot;
    claims[claim_count].run =
      solver->refactor_supernode_algorithm5_payoff_group_current_runs[
        run_begin];
    claim_count++;
  }

  if (claim_count == 0u) {
    free(claims);
    return 0;
  }

  kls_algorithm5_payoff_group_prefix_item *items =
    (kls_algorithm5_payoff_group_prefix_item *)
      kls_egraph_worker_object_workspace(
        worker, claim_count, sizeof(*items));
  if (items == NULL) {
    free(claims);
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }

  UF_long prepared_count = 0u;
  for (UF_long i = 0u; i < claim_count; ++i) {
    const UF_long current_slot = claims[i].current_slot;
    if (!kls_algorithm5_payoff_current_state_try_begin(
          shared->algorithm5_payoff_current_flags, current_slot)) {
      continue;
    }
    int prepared = 0;
    if (shared->supernode_algorithm5_payoff_group_advance_prep) {
      prepared =
        kls_egraph_refactor_prepare_algorithm5_payoff_group_item_shape(
          worker, group, current_slot, claims[i].run,
          &items[prepared_count]) &&
        kls_egraph_refactor_seed_algorithm5_payoff_group_item_state(
          worker, &items[prepared_count]);
    } else {
      prepared =
        kls_egraph_refactor_prepare_algorithm5_payoff_group_item(
          worker, group, current_slot, claims[i].run,
          &items[prepared_count]);
    }
    if (prepared) {
      prepared_count++;
    } else {
      kls_algorithm5_payoff_current_up_store(
        shared->algorithm5_payoff_current_up, current_slot, 0u);
      kls_algorithm5_payoff_current_state_store(
        shared->algorithm5_payoff_current_flags, current_slot,
        KLS_ALGORITHM5_PAYOFF_CURRENT_EMPTY);
    }
  }

  if (prepared_count > 0u) {
    int ok = 1;
    if (shared->supernode_algorithm5_payoff_group_advance_prep) {
      const int advance_status =
        kls_egraph_refactor_advance_algorithm5_payoff_prepared_prefix_group(
          worker, items, prepared_count);
      if (advance_status <= 0) {
        for (UF_long i = 0u; i < prepared_count; ++i) {
          kls_algorithm5_payoff_current_up_store(
            shared->algorithm5_payoff_current_up, items[i].current_slot, 0u);
          kls_algorithm5_payoff_current_state_store(
            shared->algorithm5_payoff_current_flags, items[i].current_slot,
            KLS_ALGORITHM5_PAYOFF_CURRENT_EMPTY);
        }
        free(claims);
        return advance_status < 0 ? -1 : 0;
      }
    }
    ok = kls_egraph_refactor_apply_algorithm5_payoff_group_prefix_items(
      worker, items, prepared_count);
    for (UF_long i = 0u; i < prepared_count; ++i) {
      const UF_long next_up =
        ok ? items[i].advance_deps + items[i].prefix_rows : 0u;
      kls_algorithm5_payoff_current_up_store(
        shared->algorithm5_payoff_current_up, items[i].current_slot, next_up);
      kls_algorithm5_payoff_current_state_store(
        shared->algorithm5_payoff_current_flags, items[i].current_slot,
        ok ? KLS_ALGORITHM5_PAYOFF_CURRENT_READY
           : KLS_ALGORITHM5_PAYOFF_CURRENT_EMPTY);
    }
  }

  kls_sort_algorithm5_payoff_group_complete_items(claims, claim_count);
  int processed = 0;
  for (UF_long i = 0u; i < claim_count; ++i) {
    const UF_long col = claims[i].col;
    if (kls_egraph_refactor_should_stop(shared)) {
      free(claims);
      return -1;
    }
    const int complete_status =
      kls_egraph_refactor_try_dispatch_algorithm5_payoff_complete_btf(
        worker, col, 1);
    if (complete_status < 0) {
      free(claims);
      return -1;
    }
    if (complete_status == 0 &&
        !kls_egraph_refactor_dispatch_column(worker, col, 1)) {
      free(claims);
      if (!kls_egraph_refactor_should_stop(shared)) {
        kls_egraph_refactor_record_invalid(shared);
      }
      return -1;
    }
    kls_egraph_refactor_mark_done(shared, col);
    processed = 1;
    if (kls_egraph_refactor_after_pipeline_column_done(worker, col) < 0) {
      free(claims);
      return -1;
    }
  }
  free(claims);
  return processed;
}

static int kls_egraph_refactor_advance_algorithm5_payoff_current_suffix(
  kls_egraph_refactor_worker *worker,
  UF_long current_slot,
  int *finished_out) {
  if (finished_out != NULL) {
    *finished_out = 0;
  }
  if (worker == NULL || worker->shared == NULL || finished_out == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || solver->symbolic == NULL ||
      solver->symbolic->R == NULL || solver->numeric == NULL ||
      solver->numeric->Ulen == NULL || solver->numeric->Llen == NULL ||
      (!shared->supernode_algorithm5_payoff_suffix_advance &&
       !shared->supernode_algorithm5_payoff_suffix_producer_advance) ||
      shared->algorithm5_payoff_current_up == NULL ||
      shared->algorithm5_payoff_current_state_values == NULL ||
      solver->refactor_supernode_algorithm5_payoff_current_state_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_current_state_rows == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_deps == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_prefix_rows == NULL ||
      solver->refactor_u_values == NULL || solver->refactor_l_values == NULL ||
      (solver->refactor_u_indices == NULL &&
       solver->refactor_u_indices32 == NULL) ||
      (solver->refactor_l_indices == NULL &&
       solver->refactor_l_indices32 == NULL)) {
    return 0;
  }

  UF_long current = KLS_KLU_EMPTY;
  UF_long run = KLS_KLU_EMPTY;
  if (!kls_algorithm5_payoff_current_slot_single_run(
        solver, current_slot, &current, &run)) {
    return 0;
  }

  UF_long block = KLS_KLU_EMPTY;
  if (solver->symbolic->nblocks == 1u) {
    block = 0u;
  } else if (solver->refactor_col_block != NULL) {
    block = solver->refactor_col_block[current];
  } else {
    block = kls_block_for_pivot(solver, current);
  }
  if (block == KLS_KLU_EMPTY || block >= solver->symbolic->nblocks) {
    return 0;
  }
  const UF_long k1 = solver->symbolic->R[block];
  const UF_long k2 = solver->symbolic->R[block + 1u];
  if (k2 <= k1 || current < k1 || current >= k2) {
    return 0;
  }
  const UF_long block_size = k2 - k1;
  const UF_long current_local = current - k1;
  const UF_long ulen = solver->numeric->Ulen[current];
  const UF_long advance_deps =
    solver->refactor_supernode_algorithm5_payoff_run_advance_deps[run];
  const UF_long prefix_rows =
    solver->refactor_supernode_algorithm5_payoff_run_prefix_rows[run];
  if (advance_deps > ulen || prefix_rows > ulen - advance_deps) {
    return 0;
  }
  const UF_long prefix_end = advance_deps + prefix_rows;
  UF_long up =
    kls_algorithm5_payoff_current_up_load(
      shared->algorithm5_payoff_current_up, current_slot);
  if (up < prefix_end) {
    up = prefix_end;
  }
  if (up > ulen) {
    return 0;
  }
  if (up == ulen) {
    *finished_out = 1;
    return 0;
  }

  const int32_t *ui32 =
    solver->refactor_u_indices32 != NULL
      ? solver->refactor_u_indices32[current] : NULL;
  const UF_long *ui =
    ui32 == NULL && solver->refactor_u_indices != NULL
      ? solver->refactor_u_indices[current] : NULL;
  double *ux = solver->refactor_u_values[current];
  if ((ulen > 0u && ui32 == NULL && ui == NULL) ||
      (ulen > 0u && ux == NULL)) {
    return 0;
  }

  const UF_long state_begin =
    solver->refactor_supernode_algorithm5_payoff_current_state_ptr[
      current_slot];
  const UF_long state_end =
    solver->refactor_supernode_algorithm5_payoff_current_state_ptr[
      current_slot + 1u];
  if (state_end < state_begin ||
      state_end > shared->algorithm5_payoff_current_state_size ||
      state_end == state_begin) {
    return 0;
  }
  kls_algorithm5_payoff_group_prefix_item state_item;
  memset(&state_item, 0, sizeof(state_item));
  state_item.current = current;
  state_item.k1 = k1;
  state_item.block_size = block_size;
  state_item.state_rows = state_end - state_begin;
  state_item.state_row_idx =
    solver->refactor_supernode_algorithm5_payoff_current_state_rows +
    state_begin;
  state_item.state_values =
    shared->algorithm5_payoff_current_state_values + state_begin;

  UF_long state_stamp_value = 0u;
  UF_long *state_stamp = NULL;
  UF_long *state_pos = NULL;
  if (!kls_algorithm5_payoff_prepare_state_row_lookup(
        worker, &state_item, &state_stamp_value, &state_stamp, &state_pos)) {
    return 0;
  }

  const UF_long start_up = up;
  UF_long update_entries = 0u;
  while (up < ulen) {
    if (kls_egraph_refactor_should_stop(shared)) {
      return -1;
    }
    const UF_long dep_local =
      kls_algorithm5_payoff_u_index_at(ui, ui32, up);
    if (dep_local >= current_local || dep_local > UF_long_max - k1) {
      return 0;
    }
    const UF_long dep_global = k1 + dep_local;
    if (dep_global >= current || dep_global >= solver->n ||
        !kls_egraph_refactor_dependency_done_now(shared, dep_global)) {
      break;
    }
    UF_long dep_pos = 0u;
    if (!kls_algorithm5_payoff_state_value_position(
          &state_item, dep_local, state_stamp_value, state_stamp, state_pos,
          &dep_pos)) {
      return 0;
    }
    const UF_long lcol_len = solver->numeric->Llen[dep_global];
    const int32_t *rows32 =
      solver->refactor_l_indices32 != NULL
        ? solver->refactor_l_indices32[dep_global] : NULL;
    const UF_long *rows =
      rows32 == NULL && solver->refactor_l_indices != NULL
        ? solver->refactor_l_indices[dep_global] : NULL;
    const double *lx = solver->refactor_l_values[dep_global];
    if (lcol_len > 0u && (lx == NULL ||
                          (rows32 == NULL && rows == NULL))) {
      return 0;
    }
    for (UF_long q = 0u; q < lcol_len; ++q) {
      const UF_long row = rows32 != NULL ? (UF_long)rows32[q] : rows[q];
      UF_long row_pos = 0u;
      if (!kls_algorithm5_payoff_state_value_position(
            &state_item, row, state_stamp_value, state_stamp, state_pos,
            &row_pos)) {
        return 0;
      }
    }

    const double ujk = state_item.state_values[dep_pos];
    state_item.state_values[dep_pos] = 0.0;
    ux[up] = ujk;
    if (shared->u_supernode_values) {
      kls_egraph_record_u_supernode_value(shared, dep_global, current, ujk);
    }
    if (ujk != 0.0) {
      for (UF_long q = 0u; q < lcol_len; ++q) {
        const UF_long row = rows32 != NULL ? (UF_long)rows32[q] : rows[q];
        UF_long row_pos = 0u;
        (void)kls_algorithm5_payoff_state_value_position(
          &state_item, row, state_stamp_value, state_stamp, state_pos,
          &row_pos);
        state_item.state_values[row_pos] -= ujk * lx[q];
      }
    }
    update_entries =
      lcol_len + 1u > UF_long_max - update_entries
        ? UF_long_max : update_entries + lcol_len + 1u;
    up++;
  }

  if (up == start_up) {
    if (up == ulen) {
      *finished_out = 1;
    }
    return 0;
  }
  kls_algorithm5_payoff_current_up_store(
    shared->algorithm5_payoff_current_up, current_slot, up);
  *finished_out = up == ulen;
  kls_egraph_record_algorithm5_payoff_suffix_advance(
    shared, up - start_up, update_entries, *finished_out);
  return 1;
}

static void kls_algorithm5_payoff_release_suffix_batch_items(
  kls_egraph_refactor_shared *shared,
  const kls_algorithm5_payoff_suffix_batch_item *items,
  UF_long item_count) {
  if (shared == NULL || items == NULL ||
      shared->algorithm5_payoff_current_flags == NULL) {
    return;
  }
  for (UF_long i = 0u; i < item_count; ++i) {
    kls_algorithm5_payoff_current_state_store(
      shared->algorithm5_payoff_current_flags,
      items[i].state_item.current_slot, KLS_ALGORITHM5_PAYOFF_CURRENT_READY);
  }
}

static int
kls_egraph_refactor_advance_algorithm5_payoff_suffix_group_window(
  kls_egraph_refactor_worker *worker,
  kls_algorithm5_payoff_suffix_batch_item *items,
  UF_long item_count,
  UF_long *advanced_deps_io,
  UF_long *update_entries_io) {
  if (worker == NULL || worker->shared == NULL || items == NULL ||
      item_count == 0u || advanced_deps_io == NULL ||
      update_entries_io == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL ||
      !shared->supernode_algorithm5_payoff_suffix_group_window ||
      solver->numeric == NULL || solver->numeric->Llen == NULL ||
      solver->refactor_u_values == NULL || solver->refactor_l_values == NULL ||
      (solver->refactor_u_indices == NULL &&
       solver->refactor_u_indices32 == NULL) ||
      (solver->refactor_l_indices == NULL &&
       solver->refactor_l_indices32 == NULL)) {
    return 0;
  }

  unsigned char *blocked =
    kls_egraph_worker_byte_workspace(worker, item_count);
  if (blocked == NULL) {
    return 0;
  }
  memset(blocked, 0, (size_t)item_count * sizeof(*blocked));

  const UF_long min_window_fanout = 2u; /* Only shared producers amortize. */
  int advanced = 0;
  for (;;) {
    UF_long selected_dep = KLS_KLU_EMPTY;
    for (UF_long i = 0u; i < item_count; ++i) {
      if (blocked[i]) {
        continue;
      }
      kls_algorithm5_payoff_suffix_batch_item *batch = &items[i];
      if (batch->next_up >= batch->ulen) {
        continue;
      }
      const UF_long current_local =
        batch->state_item.current - batch->state_item.k1;
      const int32_t *ui32 =
        solver->refactor_u_indices32 != NULL
          ? solver->refactor_u_indices32[batch->state_item.current] : NULL;
      const UF_long *ui =
        ui32 == NULL && solver->refactor_u_indices != NULL
          ? solver->refactor_u_indices[batch->state_item.current] : NULL;
      if ((batch->ulen > 0u && ui32 == NULL && ui == NULL) ||
          current_local >= batch->state_item.block_size) {
        blocked[i] = 1u;
        continue;
      }
      const UF_long dep_local =
        kls_algorithm5_payoff_u_index_at(ui, ui32, batch->next_up);
      if (dep_local >= current_local ||
          dep_local > UF_long_max - batch->state_item.k1) {
        blocked[i] = 1u;
        continue;
      }
      const UF_long dep_global = batch->state_item.k1 + dep_local;
      if (dep_global >= batch->state_item.current ||
          dep_global >= solver->n) {
        blocked[i] = 1u;
        continue;
      }
      if (!kls_egraph_refactor_dependency_done_now(shared, dep_global)) {
        continue;
      }
      selected_dep = dep_global;
      break;
    }
    if (selected_dep == KLS_KLU_EMPTY) {
      break;
    }

    const UF_long lcol_len = solver->numeric->Llen[selected_dep];
    const int32_t *rows32 =
      solver->refactor_l_indices32 != NULL
        ? solver->refactor_l_indices32[selected_dep] : NULL;
    const UF_long *rows =
      rows32 == NULL && solver->refactor_l_indices != NULL
        ? solver->refactor_l_indices[selected_dep] : NULL;
    const double *lx = solver->refactor_l_values[selected_dep];
    if (lcol_len > 0u && (lx == NULL || (rows32 == NULL && rows == NULL))) {
      break;
    }

    UF_long candidate_count = 0u;
    for (UF_long i = 0u; i < item_count; ++i) {
      if (blocked[i]) {
        continue;
      }
      kls_algorithm5_payoff_suffix_batch_item *batch = &items[i];
      if (batch->next_up >= batch->ulen) {
        continue;
      }
      const int32_t *ui32 =
        solver->refactor_u_indices32 != NULL
          ? solver->refactor_u_indices32[batch->state_item.current] : NULL;
      const UF_long *ui =
        ui32 == NULL && solver->refactor_u_indices != NULL
          ? solver->refactor_u_indices[batch->state_item.current] : NULL;
      if (batch->ulen > 0u && ui32 == NULL && ui == NULL) {
        blocked[i] = 1u;
        continue;
      }
      const UF_long dep_local =
        kls_algorithm5_payoff_u_index_at(ui, ui32, batch->next_up);
      if (dep_local > UF_long_max - batch->state_item.k1) {
        blocked[i] = 1u;
        continue;
      }
      if (batch->state_item.k1 + dep_local == selected_dep) {
        candidate_count++;
      }
    }
    if (candidate_count == 0u) {
      break;
    }
    if (candidate_count < min_window_fanout) {
      for (UF_long i = 0u; i < item_count; ++i) {
        if (blocked[i]) {
          continue;
        }
        kls_algorithm5_payoff_suffix_batch_item *batch = &items[i];
        if (batch->next_up >= batch->ulen) {
          continue;
        }
        const int32_t *ui32 =
          solver->refactor_u_indices32 != NULL
            ? solver->refactor_u_indices32[batch->state_item.current] : NULL;
        const UF_long *ui =
          ui32 == NULL && solver->refactor_u_indices != NULL
            ? solver->refactor_u_indices[batch->state_item.current] : NULL;
        if (batch->ulen > 0u && ui32 == NULL && ui == NULL) {
          blocked[i] = 1u;
          continue;
        }
        const UF_long dep_local =
          kls_algorithm5_payoff_u_index_at(ui, ui32, batch->next_up);
        if (dep_local > UF_long_max - batch->state_item.k1) {
          blocked[i] = 1u;
          continue;
        }
        if (batch->state_item.k1 + dep_local == selected_dep) {
          blocked[i] = 1u;
        }
      }
      continue;
    }
    if (lcol_len > 0u && candidate_count > UF_long_max / lcol_len) {
      return -1;
    }
    const UF_long position_count = candidate_count * lcol_len;
    if (candidate_count > UF_long_max - position_count) {
      return -1;
    }
    UF_long *workspace =
      kls_egraph_worker_index_workspace(
        worker, candidate_count + position_count);
    if (workspace == NULL) {
      return -1;
    }
    UF_long *candidate_indices = workspace;
    UF_long *row_positions = workspace + candidate_count;
    const UF_long position_stride = candidate_count;

    UF_long valid_count = 0u;
    for (UF_long i = 0u; i < item_count; ++i) {
      if (blocked[i]) {
        continue;
      }
      kls_algorithm5_payoff_suffix_batch_item *batch = &items[i];
      if (batch->next_up >= batch->ulen) {
        continue;
      }
      const int32_t *ui32 =
        solver->refactor_u_indices32 != NULL
          ? solver->refactor_u_indices32[batch->state_item.current] : NULL;
      const UF_long *ui =
        ui32 == NULL && solver->refactor_u_indices != NULL
          ? solver->refactor_u_indices[batch->state_item.current] : NULL;
      if (batch->ulen > 0u && ui32 == NULL && ui == NULL) {
        blocked[i] = 1u;
        continue;
      }
      const UF_long dep_local =
        kls_algorithm5_payoff_u_index_at(ui, ui32, batch->next_up);
      if (dep_local > UF_long_max - batch->state_item.k1 ||
          batch->state_item.k1 + dep_local != selected_dep) {
        continue;
      }

      UF_long dep_pos = 0u;
      int ok =
        kls_algorithm5_payoff_state_value_position_sorted(
          &batch->state_item, dep_local, &dep_pos);
      for (UF_long q = 0u; ok && q < lcol_len; ++q) {
        const UF_long row = rows32 != NULL ? (UF_long)rows32[q] : rows[q];
        UF_long row_pos = 0u;
        if (row >= batch->state_item.block_size ||
            !kls_algorithm5_payoff_state_value_position_sorted(
              &batch->state_item, row, &row_pos)) {
          ok = 0;
          break;
        }
        row_positions[q * position_stride + valid_count] = row_pos;
      }
      if (!ok) {
        blocked[i] = 1u;
        continue;
      }
      batch->dep_pos = dep_pos;
      candidate_indices[valid_count++] = i;
    }
    if (valid_count == 0u) {
      continue;
    }
    if (valid_count < min_window_fanout) {
      for (UF_long v = 0u; v < valid_count; ++v) {
        blocked[candidate_indices[v]] = 1u;
      }
      continue;
    }

    for (UF_long v = 0u; v < valid_count; ++v) {
      kls_algorithm5_payoff_suffix_batch_item *batch =
        &items[candidate_indices[v]];
      batch->ujk = batch->state_item.state_values[batch->dep_pos];
      batch->state_item.state_values[batch->dep_pos] = 0.0;
      batch->ux[batch->next_up] = batch->ujk;
      if (shared->u_supernode_values) {
        kls_egraph_record_u_supernode_value(
          shared, selected_dep, batch->state_item.current, batch->ujk);
      }
      batch->next_up++;
      *advanced_deps_io =
        *advanced_deps_io == UF_long_max
          ? UF_long_max : *advanced_deps_io + 1u;
      *update_entries_io =
        lcol_len + 1u > UF_long_max - *update_entries_io
          ? UF_long_max : *update_entries_io + lcol_len + 1u;
    }

    for (UF_long q = 0u; q < lcol_len; ++q) {
      if (kls_egraph_refactor_should_stop(shared)) {
        return -1;
      }
      const double lvalue = lx[q];
      for (UF_long v = 0u; v < valid_count; ++v) {
        kls_algorithm5_payoff_suffix_batch_item *batch =
          &items[candidate_indices[v]];
        if (batch->ujk == 0.0) {
          continue;
        }
        const UF_long row_pos = row_positions[q * position_stride + v];
        batch->state_item.state_values[row_pos] -= batch->ujk * lvalue;
      }
    }
    advanced = 1;
  }

  return advanced;
}

static int
kls_egraph_refactor_try_advance_algorithm5_payoff_suffix_group_batch(
  kls_egraph_refactor_worker *worker,
  UF_long trigger_col,
  UF_long trigger_begin,
  UF_long trigger_end,
  UF_long entry_count,
  UF_long lcol_len,
  const int32_t *rows32,
  const UF_long *rows,
  const double *lx) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL ||
      trigger_begin > trigger_end ||
      shared->algorithm5_payoff_suffix_group_trigger_entries == NULL ||
      solver->symbolic == NULL || solver->symbolic->R == NULL ||
      solver->numeric == NULL || solver->numeric->Ulen == NULL ||
      solver->numeric->Llen == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_suffix_cols == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_suffix_run_ptr ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_suffix_runs == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_suffix_up == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_current_pos == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_deps == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_prefix_rows == NULL ||
      solver->refactor_supernode_algorithm5_payoff_current_state_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_current_state_rows == NULL ||
      solver->refactor_u_values == NULL ||
      (solver->refactor_u_indices == NULL &&
       solver->refactor_u_indices32 == NULL)) {
    return 0;
  }

  UF_long max_refs = 0u;
  for (UF_long pos = trigger_begin; pos < trigger_end; ++pos) {
    const UF_long entry =
      shared->algorithm5_payoff_suffix_group_trigger_entries[pos];
    if (entry >= entry_count ||
        solver->refactor_supernode_algorithm5_payoff_group_suffix_cols[
          entry] != trigger_col) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    const UF_long run_begin =
      solver->refactor_supernode_algorithm5_payoff_group_suffix_run_ptr[
        entry];
    const UF_long run_end =
      solver->refactor_supernode_algorithm5_payoff_group_suffix_run_ptr[
        entry + 1u];
    if (run_begin > run_end ||
        run_end >
          solver->refactor_supernode_algorithm5_payoff_group_suffix_deps_total ||
        run_end - run_begin > UF_long_max - max_refs) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    max_refs += run_end - run_begin;
  }
  if (max_refs == 0u) {
    return 0;
  }

  kls_algorithm5_payoff_suffix_batch_item *items =
    (kls_algorithm5_payoff_suffix_batch_item *)
      kls_egraph_worker_object_workspace(worker, max_refs, sizeof(*items));
  if (items == NULL) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }

  UF_long item_count = 0u;
  for (UF_long pos = trigger_begin; pos < trigger_end; ++pos) {
    const UF_long entry =
      shared->algorithm5_payoff_suffix_group_trigger_entries[pos];
    const UF_long run_begin =
      solver->refactor_supernode_algorithm5_payoff_group_suffix_run_ptr[
        entry];
    const UF_long run_end =
      solver->refactor_supernode_algorithm5_payoff_group_suffix_run_ptr[
        entry + 1u];
    for (UF_long ref = run_begin; ref < run_end; ++ref) {
      const UF_long run =
        solver->refactor_supernode_algorithm5_payoff_group_suffix_runs[ref];
      const UF_long target_up =
        solver->refactor_supernode_algorithm5_payoff_group_suffix_up[ref];
      if (run >= solver->refactor_supernode_consumer_plan_run_count) {
        kls_algorithm5_payoff_release_suffix_batch_items(
          shared, items, item_count);
        kls_egraph_refactor_record_invalid(shared);
        return -1;
      }
      const UF_long current_slot =
        solver->refactor_supernode_algorithm5_payoff_run_current_pos[run];
      if (current_slot >= shared->algorithm5_payoff_current_count ||
          current_slot >=
            solver->refactor_supernode_algorithm5_payoff_group_current_total) {
        kls_algorithm5_payoff_release_suffix_batch_items(
          shared, items, item_count);
        kls_egraph_refactor_record_invalid(shared);
        return -1;
      }
      UF_long current = KLS_KLU_EMPTY;
      UF_long slot_run = KLS_KLU_EMPTY;
      if (!kls_algorithm5_payoff_current_slot_single_run(
            solver, current_slot, &current, &slot_run) ||
          slot_run != run || current >= solver->n) {
        continue;
      }

      UF_long block = KLS_KLU_EMPTY;
      if (solver->symbolic->nblocks == 1u) {
        block = 0u;
      } else if (solver->refactor_col_block != NULL) {
        block = solver->refactor_col_block[current];
      } else {
        block = kls_block_for_pivot(solver, current);
      }
      if (block == KLS_KLU_EMPTY || block >= solver->symbolic->nblocks) {
        continue;
      }
      const UF_long k1 = solver->symbolic->R[block];
      const UF_long k2 = solver->symbolic->R[block + 1u];
      if (k2 <= k1 || current < k1 || current >= k2 ||
          trigger_col < k1 || trigger_col >= current) {
        continue;
      }
      const UF_long block_size = k2 - k1;
      const UF_long current_local = current - k1;
      const UF_long dep_local = trigger_col - k1;
      const UF_long ulen = solver->numeric->Ulen[current];
      const UF_long advance_deps =
        solver->refactor_supernode_algorithm5_payoff_run_advance_deps[run];
      const UF_long prefix_rows =
        solver->refactor_supernode_algorithm5_payoff_run_prefix_rows[run];
      if (advance_deps > ulen || prefix_rows > ulen - advance_deps ||
          target_up >= ulen) {
        continue;
      }
      const UF_long prefix_end = advance_deps + prefix_rows;
      UF_long current_up =
        kls_algorithm5_payoff_current_up_load(
          shared->algorithm5_payoff_current_up, current_slot);
      if (current_up < prefix_end) {
        current_up = prefix_end;
      }
      if (current_up != target_up) {
        continue;
      }

      const int32_t *ui32 =
        solver->refactor_u_indices32 != NULL
          ? solver->refactor_u_indices32[current] : NULL;
      const UF_long *ui =
        ui32 == NULL && solver->refactor_u_indices != NULL
          ? solver->refactor_u_indices[current] : NULL;
      double *ux = solver->refactor_u_values[current];
      if ((ulen > 0u && ui32 == NULL && ui == NULL) ||
          ux == NULL ||
          kls_algorithm5_payoff_u_index_at(ui, ui32, target_up) !=
            dep_local) {
        continue;
      }

      if (!kls_algorithm5_payoff_current_state_try_advance(
            shared->algorithm5_payoff_current_flags, current_slot)) {
        continue;
      }

      int ok = 1;
      const UF_long state_begin =
        solver->refactor_supernode_algorithm5_payoff_current_state_ptr[
          current_slot];
      const UF_long state_end =
        solver->refactor_supernode_algorithm5_payoff_current_state_ptr[
          current_slot + 1u];
      if (state_end < state_begin ||
          state_end > shared->algorithm5_payoff_current_state_size ||
          state_end == state_begin ||
          item_count >= max_refs) {
        ok = 0;
      }

      kls_algorithm5_payoff_suffix_batch_item *batch =
        ok ? &items[item_count] : NULL;
      if (ok) {
        memset(batch, 0, sizeof(*batch));
        batch->state_item.current_slot = current_slot;
        batch->state_item.run = run;
        batch->state_item.current = current;
        batch->state_item.k1 = k1;
        batch->state_item.block_size = block_size;
        batch->state_item.advance_deps = advance_deps;
        batch->state_item.prefix_rows = prefix_rows;
        batch->state_item.state_rows = state_end - state_begin;
        batch->state_item.state_row_idx =
          solver->refactor_supernode_algorithm5_payoff_current_state_rows +
          state_begin;
        batch->state_item.state_values =
          shared->algorithm5_payoff_current_state_values + state_begin;
        batch->target_up = target_up;
        batch->next_up = target_up;
        batch->ulen = ulen;
        batch->ux = ux;
      }

      UF_long dep_pos = 0u;
      if (ok &&
          !kls_algorithm5_payoff_state_value_position_sorted(
            &batch->state_item, dep_local, &dep_pos)) {
        ok = 0;
      }
      if (!ok) {
        kls_algorithm5_payoff_current_state_store(
          shared->algorithm5_payoff_current_flags, current_slot,
          KLS_ALGORITHM5_PAYOFF_CURRENT_READY);
        continue;
      }

      batch->dep_pos = dep_pos;
      (void)current_local;
      item_count++;
    }
  }

  if (item_count == 0u) {
    return 0;
  }

  UF_long *row_positions = NULL;
  const UF_long position_stride = item_count;
  if (lcol_len > 0u) {
    if (item_count > UF_long_max / lcol_len) {
      kls_algorithm5_payoff_release_suffix_batch_items(
        shared, items, item_count);
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    const UF_long position_count = item_count * lcol_len;
    row_positions = kls_egraph_worker_index_workspace(worker, position_count);
    if (row_positions == NULL) {
      kls_algorithm5_payoff_release_suffix_batch_items(
        shared, items, item_count);
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
  }

  UF_long valid_count = 0u;
  for (UF_long i = 0u; i < item_count; ++i) {
    kls_algorithm5_payoff_suffix_batch_item *batch = &items[i];
    int ok = 1;
    for (UF_long q = 0u; q < lcol_len; ++q) {
      const UF_long row = rows32 != NULL ? (UF_long)rows32[q] : rows[q];
      UF_long row_pos = 0u;
      if (row >= batch->state_item.block_size ||
          !kls_algorithm5_payoff_state_value_position_sorted(
            &batch->state_item, row, &row_pos)) {
        ok = 0;
        break;
      }
      row_positions[q * position_stride + valid_count] = row_pos;
    }
    if (!ok) {
      kls_algorithm5_payoff_current_state_store(
        shared->algorithm5_payoff_current_flags,
        batch->state_item.current_slot, KLS_ALGORITHM5_PAYOFF_CURRENT_READY);
      continue;
    }
    if (valid_count != i) {
      items[valid_count] = items[i];
    }
    valid_count++;
  }
  item_count = valid_count;
  if (item_count == 0u) {
    return 0;
  }

  UF_long advanced_deps = 0u;
  UF_long update_entries = 0u;
  for (UF_long i = 0u; i < item_count; ++i) {
    kls_algorithm5_payoff_suffix_batch_item *batch = &items[i];
    batch->ujk = batch->state_item.state_values[batch->dep_pos];
    batch->state_item.state_values[batch->dep_pos] = 0.0;
    batch->ux[batch->next_up] = batch->ujk;
    if (shared->u_supernode_values) {
      kls_egraph_record_u_supernode_value(
        shared, trigger_col, batch->state_item.current, batch->ujk);
    }
    batch->next_up++;
    advanced_deps =
      advanced_deps == UF_long_max ? UF_long_max : advanced_deps + 1u;
    update_entries =
      lcol_len + 1u > UF_long_max - update_entries
        ? UF_long_max : update_entries + lcol_len + 1u;
  }

  for (UF_long q = 0u; q < lcol_len; ++q) {
    if (kls_egraph_refactor_should_stop(shared)) {
      kls_algorithm5_payoff_release_suffix_batch_items(
        shared, items, item_count);
      return -1;
    }
    const double lvalue = lx[q];
    for (UF_long i = 0u; i < item_count; ++i) {
      kls_algorithm5_payoff_suffix_batch_item *batch = &items[i];
      if (batch->ujk == 0.0) {
        continue;
      }
      const UF_long row_pos = row_positions[q * position_stride + i];
      batch->state_item.state_values[row_pos] -= batch->ujk * lvalue;
    }
  }

  if (shared->supernode_algorithm5_payoff_suffix_group_window) {
    const int window_status =
      kls_egraph_refactor_advance_algorithm5_payoff_suffix_group_window(
        worker, items, item_count, &advanced_deps, &update_entries);
    if (window_status < 0) {
      kls_algorithm5_payoff_release_suffix_batch_items(
        shared, items, item_count);
      return -1;
    }
  }

  for (UF_long i = 0u; i < item_count; ++i) {
    kls_algorithm5_payoff_suffix_batch_item *batch = &items[i];
    kls_algorithm5_payoff_current_up_store(
      shared->algorithm5_payoff_current_up, batch->state_item.current_slot,
      batch->next_up);
    kls_algorithm5_payoff_current_state_store(
      shared->algorithm5_payoff_current_flags, batch->state_item.current_slot,
      KLS_ALGORITHM5_PAYOFF_CURRENT_READY);
  }

  if (advanced_deps > 0u) {
    kls_egraph_record_algorithm5_payoff_suffix_advance(
      shared, advanced_deps, update_entries, 0);
  }
  return 1;
}

static int
kls_egraph_refactor_try_advance_algorithm5_payoff_suffix_group_triggers(
