  const double *lx = solver->refactor_l_values[trigger_col];
  if (lcol_len > 0u && (lx == NULL || (rows32 == NULL && rows == NULL))) {
    return 0;
  }

  return kls_egraph_refactor_try_advance_algorithm5_payoff_suffix_group_batch(
