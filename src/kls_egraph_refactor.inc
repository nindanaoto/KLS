  }
  const kls_egraph_refactor_kernel selected_kernel =
    kls_egraph_refactor_kernel_for(solver, (int)common->scale);
  const int btf_scalar_run_group_state_runtime_requested =
    btf_scalar_run_group_state_exec_requested ||
