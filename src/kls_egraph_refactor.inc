}

static int
kls_egraph_refactor_try_advance_algorithm5_payoff_suffix_producer_triggers(
  kls_egraph_refactor_worker *worker,
  UF_long trigger_col) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL ||
      !shared->supernode_algorithm5_payoff_suffix_producer_advance ||
      shared->pipeline_ready_queue || trigger_col >= solver->n ||
      shared->algorithm5_payoff_suffix_producer_trigger_ptr == NULL ||
      shared->algorithm5_payoff_suffix_producer_trigger_entries == NULL ||
      shared->algorithm5_payoff_current_flags == NULL ||
      shared->algorithm5_payoff_current_up == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_suffix_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_suffix_cols == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_suffix_run_ptr ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_suffix_runs == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_suffix_up == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_current_pos == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_advance_deps == NULL ||
      solver->refactor_supernode_algorithm5_payoff_run_prefix_rows == NULL) {
    return 0;
  }

  const UF_long trigger_begin =
    shared->algorithm5_payoff_suffix_producer_trigger_ptr[trigger_col];
  const UF_long trigger_end =
    shared->algorithm5_payoff_suffix_producer_trigger_ptr[trigger_col + 1u];
  if (trigger_begin > trigger_end) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }
  if (trigger_begin == trigger_end) {
    return 0;
  }

  const UF_long entry_count =
    solver->refactor_supernode_algorithm5_payoff_group_suffix_ptr[
      solver->refactor_supernode_algorithm5_payoff_group_count];
  int advanced = 0;
  for (UF_long pos = trigger_begin; pos < trigger_end; ++pos) {
    const UF_long entry =
      shared->algorithm5_payoff_suffix_producer_trigger_entries[pos];
    if (entry >= entry_count ||
        solver->refactor_supernode_algorithm5_payoff_group_suffix_cols[
          entry] != trigger_col) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    const UF_long run_begin =
      solver->refactor_supernode_algorithm5_payoff_group_suffix_run_ptr[
        entry];
    const UF_long run_end =
      solver->refactor_supernode_algorithm5_payoff_group_suffix_run_ptr[
        entry + 1u];
    if (run_begin > run_end ||
        run_end >
          solver->refactor_supernode_algorithm5_payoff_group_suffix_deps_total) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    for (UF_long ref = run_begin; ref < run_end; ++ref) {
      const UF_long run =
        solver->refactor_supernode_algorithm5_payoff_group_suffix_runs[ref];
      const UF_long target_up =
        solver->refactor_supernode_algorithm5_payoff_group_suffix_up[ref];
      if (run >= solver->refactor_supernode_consumer_plan_run_count) {
        kls_egraph_refactor_record_invalid(shared);
        return -1;
      }
      const UF_long current_slot =
        solver->refactor_supernode_algorithm5_payoff_run_current_pos[run];
      if (current_slot >= shared->algorithm5_payoff_current_count ||
          current_slot >=
            solver->refactor_supernode_algorithm5_payoff_group_current_total) {
        kls_egraph_refactor_record_invalid(shared);
        return -1;
      }
      UF_long current = KLS_KLU_EMPTY;
      UF_long slot_run = KLS_KLU_EMPTY;
      if (!kls_algorithm5_payoff_current_slot_single_run(
            solver, current_slot, &current, &slot_run) ||
          slot_run != run || current >= solver->n ||
          solver->numeric == NULL || solver->numeric->Ulen == NULL ||
          target_up >= solver->numeric->Ulen[current]) {
        continue;
      }
      UF_long current_up =
        kls_algorithm5_payoff_current_up_load(
          shared->algorithm5_payoff_current_up, current_slot);
      const UF_long advance_deps =
        solver->refactor_supernode_algorithm5_payoff_run_advance_deps[run];
      const UF_long prefix_rows =
        solver->refactor_supernode_algorithm5_payoff_run_prefix_rows[run];
      if (prefix_rows > UF_long_max - advance_deps) {
        kls_egraph_refactor_record_invalid(shared);
        return -1;
      }
      const UF_long prefix_end = advance_deps + prefix_rows;
      if (current_up < prefix_end) {
        current_up = prefix_end;
      }
      if (current_up > target_up) {
        continue;
      }
      if (!kls_algorithm5_payoff_current_state_try_advance(
            shared->algorithm5_payoff_current_flags, current_slot)) {
        continue;
      }
      int finished = 0;
      const int advance_status =
        kls_egraph_refactor_advance_algorithm5_payoff_current_suffix(
          worker, current_slot, &finished);
      kls_algorithm5_payoff_current_state_store(
        shared->algorithm5_payoff_current_flags, current_slot,
        KLS_ALGORITHM5_PAYOFF_CURRENT_READY);
      if (advance_status < 0) {
        return -1;
      }
      if (advance_status > 0) {
        advanced = 1;
      }
      (void)finished;
    }
  }

  return advanced;
}

static int
kls_egraph_refactor_try_advance_algorithm5_payoff_suffix_triggers(
  kls_egraph_refactor_worker *worker,
  UF_long trigger_col) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || !shared->supernode_algorithm5_payoff_suffix_advance ||
      shared->pipeline_ready_queue || trigger_col >= solver->n ||
      shared->algorithm5_payoff_suffix_trigger_ptr == NULL ||
      shared->algorithm5_payoff_suffix_trigger_slots == NULL ||
      shared->algorithm5_payoff_current_flags == NULL ||
      shared->algorithm5_payoff_current_up == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_currents == NULL) {
    return 0;
  }

  const UF_long trigger_begin =
    shared->algorithm5_payoff_suffix_trigger_ptr[trigger_col];
  const UF_long trigger_end =
    shared->algorithm5_payoff_suffix_trigger_ptr[trigger_col + 1u];
  if (trigger_begin > trigger_end) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }
  if (trigger_begin == trigger_end) {
    return 0;
  }
  const UF_long trigger_count = trigger_end - trigger_begin;
  if (trigger_count >
      (UF_long)(SIZE_MAX /
                sizeof(kls_algorithm5_payoff_group_complete_item))) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }

  kls_algorithm5_payoff_group_complete_item *claims =
    (kls_algorithm5_payoff_group_complete_item *)
      malloc((size_t)trigger_count * sizeof(*claims));
  if (claims == NULL) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }

  int advanced = 0;
  UF_long claim_count = 0u;
  for (UF_long pos = trigger_begin; pos < trigger_end; ++pos) {
    const UF_long current_slot =
      shared->algorithm5_payoff_suffix_trigger_slots[pos];
    if (current_slot >= shared->algorithm5_payoff_current_count ||
        current_slot >=
          solver->refactor_supernode_algorithm5_payoff_group_current_total) {
      free(claims);
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    if (!kls_algorithm5_payoff_current_state_try_advance(
          shared->algorithm5_payoff_current_flags, current_slot)) {
      continue;
    }
    int finished = 0;
    const int advance_status =
      kls_egraph_refactor_advance_algorithm5_payoff_current_suffix(
        worker, current_slot, &finished);
    kls_algorithm5_payoff_current_state_store(
      shared->algorithm5_payoff_current_flags, current_slot,
      KLS_ALGORITHM5_PAYOFF_CURRENT_READY);
    if (advance_status < 0) {
      free(claims);
      return -1;
    }
    if (advance_status > 0) {
      advanced = 1;
    }
    if (!finished) {
      continue;
    }
    const UF_long candidate =
      solver->refactor_supernode_algorithm5_payoff_group_currents[
        current_slot];
    UF_long candidate_pos = KLS_KLU_EMPTY;
    if (candidate >= solver->n ||
        !kls_egraph_refactor_pipeline_position_for_column(
          shared, candidate, &candidate_pos) ||
        !kls_egraph_refactor_column_dependencies_done(shared, candidate) ||
        !kls_egraph_refactor_try_claim_shape_column(shared, candidate)) {
      continue;
    }
    claims[claim_count].pos = candidate_pos;
    claims[claim_count].col = candidate;
    claims[claim_count].current_slot = current_slot;
    claims[claim_count].run = KLS_KLU_EMPTY;
    claim_count++;
  }

  if (claim_count == 0u) {
    free(claims);
    return advanced;
  }
  kls_sort_algorithm5_payoff_group_complete_items(claims, claim_count);

  int processed = advanced;
  for (UF_long i = 0u; i < claim_count; ++i) {
    const UF_long col = claims[i].col;
    const UF_long current_slot = claims[i].current_slot;
    if (kls_egraph_refactor_should_stop(shared)) {
      free(claims);
      return -1;
    }
    const int complete_status =
      kls_egraph_refactor_try_dispatch_algorithm5_payoff_complete_btf(
        worker, col, 1);
    if (complete_status < 0) {
      free(claims);
      return -1;
    }
    if (complete_status == 0 &&
        !kls_egraph_refactor_dispatch_column(worker, col, 1)) {
      free(claims);
      if (!kls_egraph_refactor_should_stop(shared)) {
        kls_egraph_refactor_record_invalid(shared);
      }
      return -1;
    }
    if (complete_status == 0) {
      kls_algorithm5_payoff_current_up_store(
        shared->algorithm5_payoff_current_up, current_slot, 0u);
      kls_algorithm5_payoff_current_state_store(
        shared->algorithm5_payoff_current_flags, current_slot,
        KLS_ALGORITHM5_PAYOFF_CURRENT_EMPTY);
    }
    kls_egraph_refactor_mark_done(shared, col);
    processed = 1;
    if (kls_egraph_refactor_after_pipeline_column_done(worker, col) < 0) {
      free(claims);
      return -1;
    }
  }

  free(claims);
  return processed;
}

static int
kls_egraph_refactor_try_complete_algorithm5_payoff_final_triggers(
  kls_egraph_refactor_worker *worker,
  UF_long trigger_col) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL ||
      !shared->supernode_algorithm5_payoff_group_complete ||
      shared->pipeline_ready_queue || trigger_col >= solver->n ||
      shared->algorithm5_payoff_final_trigger_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_currents == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_total == 0u ||
      shared->algorithm5_payoff_current_flags == NULL) {
    return 0;
  }

  const UF_long trigger_begin =
    shared->algorithm5_payoff_final_trigger_ptr[trigger_col];
  const UF_long trigger_end =
    shared->algorithm5_payoff_final_trigger_ptr[trigger_col + 1u];
  if (trigger_begin > trigger_end) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }
  if (trigger_begin == trigger_end) {
    return 0;
  }
  if (shared->algorithm5_payoff_final_trigger_slots == NULL) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }
  const UF_long trigger_count = trigger_end - trigger_begin;
  if (trigger_count >
      (UF_long)(SIZE_MAX /
                sizeof(kls_algorithm5_payoff_group_complete_item))) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }
  kls_algorithm5_payoff_group_complete_item *claims =
    (kls_algorithm5_payoff_group_complete_item *)
      malloc((size_t)trigger_count * sizeof(*claims));
  if (claims == NULL) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }

  UF_long claim_count = 0u;
  UF_long claim_suffix_deps = 0u;
  for (UF_long pos = trigger_begin; pos < trigger_end; ++pos) {
    const UF_long current_slot =
      shared->algorithm5_payoff_final_trigger_slots[pos];
    if (current_slot >=
          solver->refactor_supernode_algorithm5_payoff_group_current_total ||
        current_slot >= shared->algorithm5_payoff_current_count) {
      free(claims);
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    const UF_long candidate =
      solver->refactor_supernode_algorithm5_payoff_group_currents[
        current_slot];
    UF_long candidate_pos = KLS_KLU_EMPTY;
    if (candidate >= solver->n ||
        !kls_egraph_refactor_pipeline_position_for_column(
          shared, candidate, &candidate_pos) ||
        !kls_egraph_refactor_column_dependencies_done(shared, candidate)) {
      continue;
    }
    unsigned char state =
      kls_algorithm5_payoff_current_state_load(
        shared->algorithm5_payoff_current_flags, current_slot);
    unsigned spin = 0u;
    while (state == KLS_ALGORITHM5_PAYOFF_CURRENT_PREPARING) {
      if (kls_egraph_refactor_should_stop(shared)) {
        free(claims);
        return -1;
      }
      kls_egraph_pipeline_pause(&spin);
      state = kls_algorithm5_payoff_current_state_load(
        shared->algorithm5_payoff_current_flags, current_slot);
    }
    if (state != KLS_ALGORITHM5_PAYOFF_CURRENT_READY) {
      continue;
    }
    if (!kls_egraph_refactor_try_claim_shape_column(shared, candidate)) {
      continue;
    }
    claims[claim_count].pos = candidate_pos;
    claims[claim_count].col = candidate;
    claims[claim_count].current_slot = current_slot;
    claims[claim_count].run = KLS_KLU_EMPTY;
    const UF_long suffix_deps =
      kls_algorithm5_payoff_current_slot_suffix_deps(solver, current_slot);
    claim_suffix_deps =
      suffix_deps > UF_long_max - claim_suffix_deps
        ? UF_long_max : claim_suffix_deps + suffix_deps;
    claim_count++;
  }

  if (claim_count == 0u) {
    free(claims);
    return 0;
  }
  kls_egraph_record_algorithm5_payoff_final_trigger_claims(
    shared, claim_count, claim_suffix_deps);
  kls_sort_algorithm5_payoff_group_complete_items(claims, claim_count);

  int processed = 0;
  for (UF_long i = 0u; i < claim_count; ++i) {
    const UF_long col = claims[i].col;
    if (kls_egraph_refactor_should_stop(shared)) {
      free(claims);
      return -1;
    }
    const int complete_status =
      kls_egraph_refactor_try_dispatch_algorithm5_payoff_complete_btf(
        worker, col, 1);
    if (complete_status < 0) {
      free(claims);
      return -1;
    }
    if (complete_status == 0 &&
        !kls_egraph_refactor_dispatch_column(worker, col, 1)) {
      free(claims);
      if (!kls_egraph_refactor_should_stop(shared)) {
        kls_egraph_refactor_record_invalid(shared);
      }
      return -1;
    }
    kls_egraph_refactor_mark_done(shared, col);
    processed = 1;
    if (kls_egraph_refactor_after_pipeline_column_done(worker, col) < 0) {
      free(claims);
      return -1;
    }
  }

  free(claims);
  return processed;
}

static int kls_egraph_refactor_try_prepare_algorithm5_payoff_group_prefixes(
  kls_egraph_refactor_worker *worker,
  UF_long current_col) {
  if (worker == NULL || worker->shared == NULL) {
    return 0;
  }
  kls_egraph_refactor_shared *shared = worker->shared;
  kls_solver *solver = shared->solver;
  if (solver == NULL || !shared->supernode_algorithm5_payoff_prefix_prep ||
      current_col >= solver->n ||
      solver->refactor_supernode_algorithm5_payoff_trigger_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_trigger_groups == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_prefix_end == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_currents == NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr ==
        NULL ||
      solver->refactor_supernode_algorithm5_payoff_group_current_runs ==
        NULL ||
      shared->algorithm5_payoff_current_flags == NULL) {
    return 0;
  }

  const UF_long trigger_begin =
    solver->refactor_supernode_algorithm5_payoff_trigger_ptr[current_col];
  const UF_long trigger_end =
    solver->refactor_supernode_algorithm5_payoff_trigger_ptr[current_col + 1u];
  if (trigger_begin > trigger_end ||
      trigger_end > solver->refactor_supernode_algorithm5_payoff_group_count) {
    kls_egraph_refactor_record_invalid(shared);
    return -1;
  }

  int prepared = 0;
  for (UF_long trigger_pos = trigger_begin; trigger_pos < trigger_end;
       ++trigger_pos) {
    const UF_long group =
      solver->refactor_supernode_algorithm5_payoff_trigger_groups[trigger_pos];
    if (group >= solver->refactor_supernode_algorithm5_payoff_group_count ||
        solver->refactor_supernode_algorithm5_payoff_group_prefix_end[group] !=
          current_col + 1u) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    const UF_long current_begin =
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group];
    const UF_long current_end =
      solver->refactor_supernode_algorithm5_payoff_group_current_ptr[group + 1u];
    if (current_begin > current_end ||
        current_end >
          solver->refactor_supernode_algorithm5_payoff_group_current_total) {
      kls_egraph_refactor_record_invalid(shared);
      return -1;
    }
    if (current_end - current_begin <= 1u) {
      continue;
    }
    const int complete_status =
      kls_egraph_refactor_try_complete_algorithm5_payoff_group(
        worker, group, current_col);
    if (complete_status < 0) {
      return -1;
    }
    if (complete_status > 0) {
      prepared = 1;
    }
    if (shared->supernode_algorithm5_payoff_group_prefix_prep) {
      const int group_status =
        kls_egraph_refactor_prepare_algorithm5_payoff_group_prefix_batch(
          worker, group, current_col);
      if (group_status < 0) {
        return -1;
      }
      if (group_status > 0) {
        prepared = 1;
      }
      continue;
    }
    for (UF_long current_slot = current_begin; current_slot < current_end;
         ++current_slot) {
      const UF_long candidate =
        solver->refactor_supernode_algorithm5_payoff_group_currents[
          current_slot];
      if (candidate == current_col || candidate >= solver->n ||
          (shared->pipeline_done != NULL &&
           shared->pipeline_generation != 0u &&
           atomic_load_explicit(&shared->pipeline_done[candidate],
                                memory_order_acquire) ==
             shared->pipeline_generation)) {
        continue;
      }
      const UF_long run_begin =
        solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
          current_slot];
      const UF_long run_end =
        solver->refactor_supernode_algorithm5_payoff_group_current_run_ptr[
          current_slot + 1u];
      if (run_begin > run_end ||
          run_end >
            solver->refactor_supernode_algorithm5_payoff_group_ptr[
              solver->refactor_supernode_algorithm5_payoff_group_count] ||
          run_end - run_begin != 1u) {
        continue;
      }
      if (!kls_algorithm5_payoff_current_state_try_begin(
            shared->algorithm5_payoff_current_flags, current_slot)) {
        continue;
      }
      const UF_long run =
        solver->refactor_supernode_algorithm5_payoff_group_current_runs[
          run_begin];
      const int ok =
        kls_egraph_refactor_prepare_algorithm5_payoff_prefix_run(
          worker, run, current_slot);
      kls_algorithm5_payoff_current_state_store(
        shared->algorithm5_payoff_current_flags, current_slot,
        ok ? KLS_ALGORITHM5_PAYOFF_CURRENT_READY
           : KLS_ALGORITHM5_PAYOFF_CURRENT_EMPTY);
      if (ok) {
        prepared = 1;
      }
    }
  }
  return prepared;
}

static int kls_egraph_refactor_after_pipeline_column_done(
  kls_egraph_refactor_worker *worker,
  UF_long col) {
  const int prep_status =
    kls_egraph_refactor_try_prepare_algorithm5_payoff_group_prefixes(
      worker, col);
  if (prep_status < 0) {
    return -1;
  }
  const int suffix_group_advance_status =
    kls_egraph_refactor_try_advance_algorithm5_payoff_suffix_group_triggers(
      worker, col);
  if (suffix_group_advance_status < 0) {
    return -1;
  }
  const int suffix_producer_advance_status =
    kls_egraph_refactor_try_advance_algorithm5_payoff_suffix_producer_triggers(
      worker, col);
  if (suffix_producer_advance_status < 0) {
    return -1;
  }
  const int suffix_advance_status =
    kls_egraph_refactor_try_advance_algorithm5_payoff_suffix_triggers(
      worker, col);
  if (suffix_advance_status < 0) {
    return -1;
  }
  const int final_trigger_status =
    kls_egraph_refactor_try_complete_algorithm5_payoff_final_triggers(
      worker, col);
  if (final_trigger_status < 0) {
    return -1;
  }
  const int enqueue_status =
    kls_egraph_refactor_try_enqueue_algorithm5_payoff_group_currents(
      worker, col);
  if (enqueue_status < 0) {
    return -1;
  }
  if (kls_egraph_refactor_try_claim_algorithm5_payoff_group_currents(worker,
                                                                    col) < 0) {
    return -1;
  }
  if (kls_egraph_refactor_try_claim_shape_group_columns(worker, col) < 0) {
    return -1;
  }
  if (kls_egraph_refactor_try_claim_btf_scalar_run_group_currents(
        worker, col) < 0) {
    return -1;
  }
  return 0;
}

/* CKTSO tail repair can omit independent nodes outside the ETree-descendant
   tail.  Make those omitted columns current before the pivoted tail copies
   them as preserved suffix/gap columns. */
static int kls_refresh_pivot_tail_preserved_block_columns(
  kls_solver *solver,
  double *numeric_values,
  UF_long block,
  UF_long k1,
  UF_long nk,
  const unsigned char *tail_mask) {
  if (solver == NULL || solver->symbolic == NULL || solver->numeric == NULL ||
      numeric_values == NULL || tail_mask == NULL ||
      solver->symbolic->R == NULL ||
      block >= solver->symbolic->nblocks ||
      k1 != solver->symbolic->R[block] ||
      k1 + nk != solver->symbolic->R[block + 1u] ||
      k1 > solver->n || nk > solver->n - k1 ||
      (solver->common.scale > 0 && solver->numeric->Rs == NULL) ||
      (solver->common.scale <= 0 && solver->numeric->Rs != NULL) ||
      solver->numeric->Xwork == NULL ||
      solver->numeric->Ulen == NULL ||
      !kls_build_refactor_map(solver) ||
      !kls_build_refactor_lu_pointer_cache(solver)) {
    return 0;
  }
  if (solver->refactor_lu_pointer_count != solver->n ||
      solver->refactor_u_indices == NULL ||
      (solver->symbolic->nblocks > 1u &&
       (solver->refactor_block_start == NULL ||
        solver->refactor_col_block == NULL ||
        solver->numeric->Offp == NULL ||
        solver->numeric->Offx == NULL))) {
    return 0;
  }

  UF_long refresh_columns = 0;
  for (UF_long k = 0; k < nk; ++k) {
    if (tail_mask[k]) {
      continue;
    }
    const UF_long global_k = k1 + k;
    const UF_long *ui = solver->refactor_u_indices[global_k];
    const UF_long ulen = solver->numeric->Ulen[global_k];
    if (ui == NULL && ulen > 0u) {
      return 0;
    }
    for (UF_long p = 0; p < ulen; ++p) {
      const UF_long dep = ui[p];
      if (dep >= nk || tail_mask[dep]) {
        return 0;
      }
    }
    refresh_columns++;
  }
  if (refresh_columns == 0u) {
    return 1;
  }

  const int scaled = solver->common.scale > 0;
  kls_egraph_refactor_shared shared;
  memset(&shared, 0, sizeof(shared));
  if (pthread_mutex_init(&shared.lock, NULL) != 0) {
    return 0;
  }
  shared.solver = solver;
  shared.values = numeric_values;
  shared.rs = scaled ? solver->numeric->Rs : NULL;
  shared.check_pivots = 0;
  shared.scale = scaled ? (int)solver->common.scale : 0;
  shared.kernel = kls_egraph_refactor_kernel_for(solver, shared.scale);
  shared.thread_count = 1;
  shared.rejected_pivot = KLS_KLU_EMPTY;
  shared.rejected_pivot_col = KLS_KLU_EMPTY;
  shared.rejected_row = KLS_KLU_EMPTY;
  shared.rejected_multiplier_abs = -1.0;
  shared.rejected_pivot_abs = -1.0;
  shared.rejected_candidate_abs = -1.0;
  shared.numerical_rank = UF_long_max;
  shared.singular_col = KLS_KLU_EMPTY;
  shared.snode_run_end = kls_refactor_snode_run_end(solver);
  atomic_init(&shared.stop, 0);

  kls_egraph_refactor_worker worker;
  memset(&worker, 0, sizeof(worker));
  worker.shared = &shared;
  worker.x = (double *)solver->numeric->Xwork;

  int ok = 1;
  for (UF_long k = 0; k < nk; ++k) {
    if (tail_mask[k]) {
      continue;
    }
    memset(worker.x, 0, (size_t)nk * sizeof(*worker.x));
    if (!kls_egraph_refactor_dispatch_column(&worker, k1 + k, 0) ||
        shared.invalid || shared.pivot_rejected || shared.singular) {
      ok = 0;
      break;
    }
  }
  memset(worker.x, 0, (size_t)nk * sizeof(*worker.x));
  free(worker.segment_panel);
  free(worker.supernode_workspace);
  free(worker.index_workspace);
  free(worker.byte_workspace);
  free(worker.object_workspace);
  (void)pthread_mutex_destroy(&shared.lock);
  return ok;
}

static UF_long kls_restore_pivot_tail_plan(
  kls_solver *solver,
  UF_long block,
  UF_long k1,
  UF_long nk,
  UF_long local_reject,
  int refresh_state) {
  if (solver == NULL) {
    return nk;
  }
  const int saved_state = solver->fast_reject_refresh_state;
  solver->fast_reject_refresh_state = refresh_state;
  const UF_long *tail_cols = NULL;
  UF_long tail_count = 0;
  double tail_work = 0.0;
  (void)kls_build_fast_reject_pivoting_tail_plan(
    solver, block, k1, k1 + nk, local_reject, &tail_cols, &tail_count,
    &tail_work);
  solver->fast_reject_refresh_state = saved_state;
  return nk;
}

static UF_long kls_prepare_root_pivot_tail_independent_refresh(
  kls_solver *solver,
  double *numeric_values,
  UF_long block,
  UF_long k1,
  UF_long nk,
  UF_long local_reject) {
  if (solver == NULL || solver->symbolic == NULL || numeric_values == NULL ||
      local_reject != 0u || nk == 0u ||
      block >= solver->symbolic->nblocks ||
      solver->symbolic->R == NULL ||
      k1 != solver->symbolic->R[block] ||
      k1 + nk != solver->symbolic->R[block + 1u] ||
      solver->fast_reject_refresh_state != KLS_FAST_REJECT_REFRESH_PREFIX) {
    return nk;
  }

  const int saved_state = solver->fast_reject_refresh_state;
  solver->fast_reject_refresh_state = KLS_FAST_REJECT_REFRESH_UNKNOWN;
  const UF_long *tail_cols = NULL;
  UF_long tail_count = 0;
  double tail_work = 0.0;
  if (!kls_build_fast_reject_pivoting_tail_plan(
        solver, block, k1, k1 + nk, local_reject, &tail_cols, &tail_count,
        &tail_work)) {
    solver->fast_reject_refresh_state = saved_state;
    return nk;
  }
  solver->fast_reject_refresh_state = saved_state;

  const UF_long restart_end =
    kls_preferred_pivot_tail_restart_end(solver, k1, nk, local_reject);
  if (restart_end >= nk) {
    return nk;
  }
  const size_t nk_size = (size_t)nk;
  if ((UF_long)nk_size != nk) {
    return kls_restore_pivot_tail_plan(
      solver, block, k1, nk, local_reject, saved_state);
  }
  unsigned char *tail_mask =
    (unsigned char *)malloc(nk_size * sizeof(*tail_mask));
  if (tail_mask == NULL) {
    return kls_restore_pivot_tail_plan(
      solver, block, k1, nk, local_reject, saved_state);
  }
  const int mask_ok =
    kls_build_pivot_tail_restart_mask(
      solver, k1, nk, local_reject, restart_end, tail_mask);
  const int refresh_ok =
    mask_ok &&
    kls_refresh_pivot_tail_preserved_block_columns(
      solver, numeric_values, block, k1, nk, tail_mask);
  free(tail_mask);
  if (!refresh_ok) {
    return kls_restore_pivot_tail_plan(
      solver, block, k1, nk, local_reject, saved_state);
  }
  return restart_end;
}

static void kls_egraph_refactor_refresh_missing_prefix(
  kls_egraph_refactor_shared *shared,
  double *x,
  UF_long scratch_size) {
  if (shared == NULL || shared->solver == NULL ||
      shared->pipeline_done == NULL || x == NULL || scratch_size == 0u ||
      shared->pipeline_generation == 0u ||
      shared->rejected_pivot == KLS_KLU_EMPTY) {
    return;
  }
  kls_solver *solver = shared->solver;
  if (shared->rejected_pivot > solver->n) {
    return;
  }

  kls_egraph_refactor_worker worker;
  memset(&worker, 0, sizeof(worker));
  worker.shared = shared;
  worker.x = x;

  UF_long refreshed = 0;
  UF_long rejected_pivot = shared->rejected_pivot;
  for (UF_long col = 0; col < rejected_pivot; ++col) {
    if (atomic_load_explicit(&shared->pipeline_done[col],
                             memory_order_acquire) ==
        shared->pipeline_generation) {
      continue;
    }
    memset(x, 0, (size_t)scratch_size * sizeof(*x));
    if (!kls_egraph_refactor_dispatch_column(&worker, col, 0)) {
      break;
    }
    kls_egraph_refactor_mark_done(shared, col);
    refreshed++;
    if (shared->rejected_pivot != KLS_KLU_EMPTY &&
        shared->rejected_pivot < rejected_pivot) {
      rejected_pivot = shared->rejected_pivot;
    }
  }
  memset(x, 0, (size_t)scratch_size * sizeof(*x));
  free(worker.segment_panel);
  free(worker.supernode_workspace);
  free(worker.index_workspace);
  free(worker.byte_workspace);
  free(worker.object_workspace);

  if (refreshed > 0u) {
    solver->fast_rejected_prefix_refresh_columns += refreshed;
    solver->fast_rejected_prefix_refresh_count++;
    solver->stats.fast_rejected_prefix_refresh_columns =
      (int64_t)solver->fast_rejected_prefix_refresh_columns;
    solver->stats.fast_rejected_prefix_refresh_count =
      (int64_t)solver->fast_rejected_prefix_refresh_count;
  }
}

